<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
      <style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0in"/>
    </style:default-style>
  </office:styles>
  <office:automatic-styles>
    <style:style style:name="PageLayout" style:family="paragraph"/>
    <style:page-layout style:name="A4Portrait">
      <style:page-layout-properties fo:page-width="8.27in" fo:page-height="11.69in" style:print-orientation="portrait" fo:margin-left="0.98in" fo:margin-right="0.84in" fo:margin-top="0.90in" fo:margin-bottom="1.20in"/>
    </style:page-layout>
    <style:style style:name="TopLine" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.13in"/>
    </style:style>
    <style:style style:name="DocTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.08in" fo:margin-bottom="0.10in"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.06in" fo:margin-bottom="0.02in">
        <style:tab-stops>
          <style:tab-stop style:position="6.45in" style:type="right"/>
        </style:tab-stops>
      </style:paragraph-properties>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="UnitNext" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.05in"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.03in" fo:margin-bottom="0.18in"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
    <style:style style:name="Grid" style:family="table">
      <style:table-properties style:width="6.45in" table:align="margins" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="1.75in"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="1.18in"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="3.52in"/>
    </style:style>
    <style:style style:name="IncomeHeadRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.37in"/>
    </style:style>
    <style:style style:name="IncomeRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.37in"/>
    </style:style>
    <style:style style:name="ExpenseHeadRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.33in"/>
    </style:style>
    <style:style style:name="ExpenseRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.78in"/>
    </style:style>
    <style:style style:name="TotalRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.38in"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.04in" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="TotalCell" style:family="table-cell">
      <style:table-cell-properties fo:border-left="0.5pt solid #000000" fo:border-right="0.5pt solid #000000" fo:border-bottom="0.5pt solid #000000" fo:border-top="0.75pt double #000000" fo:padding="0.04in" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="CellHead" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Amount" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right"/>
      <style:text-properties fo:font-size="11pt" fo:color="#ff0000"/>
    </style:style>
    <style:style style:name="RedCenter" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="11pt" fo:color="#ff0000"/>
    </style:style>
    <style:style style:name="RedLeft" style:family="paragraph">
      <style:paragraph-properties fo:text-align="left"/>
      <style:text-properties fo:font-size="11pt" fo:color="#ff0000"/>
    </style:style>
    <style:style style:name="CellLeft" style:family="paragraph">
      <style:paragraph-properties fo:text-align="left"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="CellRight" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="DefaultPage" style:page-layout-name="A4Portrait"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="TopLine">様式第３号（第８条関係）</text:p>
      <text:p text:style-name="DocTitle">収支予算書</text:p>
      <text:p text:style-name="Section">1　収入予算<text:tab/>（単位：</text:p>
      <text:p text:style-name="UnitNext">円）</text:p>
      <table:table table:name="IncomeBudget" table:style-name="Grid">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-row table:style-name="IncomeHeadRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellHead">項　目</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellHead">金　額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellHead">内　容</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="IncomeRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText">市補助金</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Amount">200,000</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="IncomeRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText">自己資金</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Amount">100,000</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="IncomeRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText">その他</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="TotalRow">
          <table:table-cell table:style-name="TotalCell"><text:p text:style-name="CellText">合　計</text:p></table:table-cell>
          <table:table-cell table:style-name="TotalCell"><text:p text:style-name="Amount">300,000</text:p></table:table-cell>
          <table:table-cell table:style-name="TotalCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Note">（注）　補助率及び補助上限は、別表第４を参照すること。</text:p>
      <text:p text:style-name="Section">2　支出予算<text:tab/>（単位：</text:p>
      <text:p text:style-name="UnitNext">円）</text:p>
      <table:table table:name="ExpenseBudget" table:style-name="Grid">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-row table:style-name="ExpenseHeadRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellHead">項　目</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellHead">金　額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellHead">内　容</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ExpenseRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RedCenter">システム導入費</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Amount">300,000</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RedLeft">オンラインストレージ導入に係る費用</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ExpenseRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="ExpenseRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="ExpenseRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="ExpenseRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="ExpenseRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="TotalRow">
          <table:table-cell table:style-name="TotalCell"><text:p text:style-name="CellText">合　計</text:p></table:table-cell>
          <table:table-cell table:style-name="TotalCell"><text:p text:style-name="Amount">300,000</text:p></table:table-cell>
          <table:table-cell table:style-name="TotalCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Note">（注）　「項目」は、別表第４の項目名を記入すること。</text:p>
      <text:p text:style-name="PageBreak"/>
    </office:text>
  </office:body>
</office:document>