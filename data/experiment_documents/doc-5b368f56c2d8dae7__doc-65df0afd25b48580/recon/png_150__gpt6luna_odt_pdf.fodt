<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:font-size="10.5pt" fo:line-height="120%" fo:margin-top="0cm" fo:margin-bottom="0.18cm"/>
      <style:text-properties style:font-name="MS Mincho" fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.35cm" fo:margin-bottom="0.55cm"/>
      <style:text-properties style:font-name="MS Mincho" fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:margin-top="0.4cm" fo:margin-bottom="0.18cm"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="center" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="RightRed" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="right" fo:margin-bottom="0cm"/>
      <style:text-properties fo:color="#ff0000"/>
    </style:style>
    <style:style style:name="Red" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:margin-bottom="0cm"/>
      <style:text-properties fo:color="#ff0000"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:margin-left="0.2cm" fo:margin-top="0.08cm" fo:margin-bottom="0.45cm"/>
      <style:text-properties style:font-name="MS Mincho" fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="2cm" fo:margin-right="2cm" fo:margin-top="2cm" fo:margin-bottom="2cm"/>
    </style:page-layout>
    <style:style style:name="BudgetTable" style:family="table">
      <style:table-properties table:align="margins"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties fo:column-width="4.45cm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties fo:column-width="3cm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties fo:column-width="8.9cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellTotal" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:border-top="double 0.75pt #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HeaderRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.95cm"/>
    </style:style>
    <style:style style:name="IncomeRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.95cm"/>
    </style:style>
    <style:style style:name="ExpenseRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.97cm"/>
    </style:style>
    <style:style style:name="TotalRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.95cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Body">様式第３号（第８条関係）</text:p>
      <text:p text:style-name="Title">収支予算書</text:p>
      <text:p text:style-name="Section">１　収入予算　　　　　　　　　　　　　　（単位：<text:line-break/>円）</text:p>
      <table:table table:name="IncomeBudget" table:style-name="BudgetTable">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">項　目</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">金　額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">内　容</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="IncomeRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">市補助金</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightRed">200,000</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="IncomeRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">自己資金</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightRed">100,000</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="IncomeRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">その他</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="TotalRow">
          <table:table-cell table:style-name="CellTotal"><text:p text:style-name="Center">合　計</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTotal"><text:p text:style-name="RightRed">300,000</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTotal"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Note">（注）　補助率及び補助上限は、別表第４を参照すること。</text:p>
      <text:p text:style-name="Section">２　支出予算　　　　　　　　　　　　　　（単位：<text:line-break/>円）</text:p>
      <table:table table:name="ExpenseBudget" table:style-name="BudgetTable">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">項　目</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">金　額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">内　容</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ExpenseRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Red">システム導入費</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightRed">300,000</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Red">オンラインストレージ導入に係る費用</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ExpenseRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ExpenseRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ExpenseRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ExpenseRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ExpenseRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="TotalRow">
          <table:table-cell table:style-name="CellTotal"><text:p text:style-name="Center">合　計</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTotal"><text:p text:style-name="RightRed">300,000</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTotal"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Note">（注）　「項目」は、別表第４の項目名を記入すること。</text:p>
      <text:p text:style-name="PageStart"/>
    </office:text>
  </office:body>
</office:document>