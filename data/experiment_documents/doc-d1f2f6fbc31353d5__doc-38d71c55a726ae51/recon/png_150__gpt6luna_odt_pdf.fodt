<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt" style:font-size-asian="10pt"/>
    </style:default-style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="2.8cm" fo:margin-right="1.9cm" fo:margin-top="3.3cm" fo:margin-bottom="2.8cm"/>
    </style:page-layout>
    <style:style style:name="Base" style:family="paragraph">
      <style:paragraph-properties fo:line-height="115%" fo:margin="0cm"/>
      <style:text-properties fo:font-size="10pt" style:font-size-asian="10pt"/>
    </style:style>
    <style:style style:name="TopLabel" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:margin-left="0cm" fo:margin-bottom="0.08cm"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:text-align="end"/>
    </style:style>
    <style:style style:name="Left" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:text-align="start"/>
    </style:style>
    <style:style style:name="Heading" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.12cm" fo:margin-bottom="0.42cm"/>
      <style:text-properties fo:font-size="12pt" style:font-size-asian="12pt"/>
    </style:style>
    <style:style style:name="HeaderLine" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:margin-top="0.20cm" fo:margin-bottom="0.18cm"/>
    </style:style>
    <style:style style:name="HeaderText" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:margin-top="0.26cm" fo:margin-bottom="0.22cm"/>
    </style:style>
    <style:style style:name="CellPara" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:line-height="115%" fo:margin="0cm"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="paragraph" style:parent-style-name="CellPara">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="CellRight" style:family="paragraph" style:parent-style-name="CellPara">
      <style:paragraph-properties fo:text-align="end"/>
    </style:style>
    <style:style style:name="Remarks" style:family="paragraph" style:parent-style-name="CellPara">
      <style:paragraph-properties fo:line-height="125%" fo:margin-bottom="0.06cm"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="1cm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="3.5cm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="11.7cm"/>
    </style:style>
    <style:style style:name="FormCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding-left="0.18cm" fo:padding-right="0.18cm" fo:padding-top="0.10cm" fo:padding-bottom="0.10cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="RemarksCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.18cm" style:vertical-align="top"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="TopLabel">別記様式第７号</text:p>
      <table:table table:name="ApplicationForm" table:style-name="FormTable">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-row>
          <table:table-cell table:style-name="HeaderCell" table:number-columns-spanned="3">
            <text:p text:style-name="Heading">行政財産使用許可申請書</text:p>
            <text:p text:style-name="CellRight">令和　　年　　月　　日</text:p>
            <text:p text:style-name="HeaderLine">和歌山市長　尾崎太郎　様</text:p>
            <text:p text:style-name="CellRight">申請者　住所　〒　　－</text:p>
            <text:p text:style-name="CellRight">氏名</text:p>
            <text:p text:style-name="HeaderText">次のとおり行政財産の使用許可を受けたいので、関係書類を添えて申請します。</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="2"><text:p text:style-name="CellCenter">施　設　の　名　称</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="CellPara">和歌山駅西口地下広場（わかちか広場）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="2"><text:p text:style-name="CellCenter">所　在　地</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="CellPara">和歌山市美園町５丁目１３番地の２</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="2"><text:p text:style-name="CellCenter">種　　　類</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="CellPara">☑　土　地　　☑　建　物　　□その他(　　　　)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="2"><text:p text:style-name="CellCenter">数　　　量</text:p><text:p text:style-name="CellCenter">（面　積　等）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="CellCenter">２００㎡</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="2"><text:p text:style-name="CellCenter">使　用　目　的　及　び　方　法</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="CellPara"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="2"><text:p text:style-name="CellCenter">使　用　希　望　期　間</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="CellCenter">令和　　年　　月　　日から令和　　年　　月　　日まで</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="2"><text:p text:style-name="CellPara">使用料の減額又は免除の</text:p><text:p text:style-name="CellPara">希望の有無及び希望する</text:p><text:p text:style-name="CellPara">場合は、その理由</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="CellPara"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell" table:number-rows-spanned="2"><text:p text:style-name="CellCenter">使<br/>用<br/>責<br/>任<br/>者</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="CellCenter">住　　　所</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="CellPara"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="CellCenter">氏　　　名</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="CellCenter">（電話番号）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="RemarksCell" table:number-columns-spanned="3">
            <text:p text:style-name="Remarks">備　考</text:p>
            <text:p text:style-name="Remarks"/>
            <text:p text:style-name="Remarks">貸出時間：</text:p>
            <text:p text:style-name="Remarks">イベント時間：</text:p>
            <text:p text:style-name="Remarks">イベントカレンダー掲載可否：する・しない（丸を記入ください）</text:p>
            <text:p text:style-name="Remarks">主催者名：</text:p>
            <text:p text:style-name="Remarks">イベント名：</text:p>
            <text:p text:style-name="Remarks">その他：</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageBreak"/>
    </office:text>
  </office:body>
</office:document>