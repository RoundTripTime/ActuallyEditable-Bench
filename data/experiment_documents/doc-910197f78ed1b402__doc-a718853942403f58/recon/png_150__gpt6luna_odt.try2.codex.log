      <style:paragraph-properties fo:break-before="page" fo:font-size="9pt" fo:margin="0cm" fo:line-height="100%"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:font-size="9pt" fo:margin="0cm" fo:line-height="100%"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Fill" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.04cm" fo:background-color="#FCE8D9" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Narrow" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.02cm" style:vertical-align="middle"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.1cm" fo:margin-bottom="1.1cm" fo:margin-left="1.25cm" fo:margin-right="1.25cm" style:print-orientation="portrait"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">別記第１号様式（第６条関係）</text:p>
      <table:table table:name="申請書表面">
        <table:table-column table:number-columns-repeated="2"/>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">江東区長　殿</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">年　　月　　日</text:p><text:p text:style-name="Body">申請者</text:p><text:p text:style-name="Body">〒　 -　　住所</text:p><text:p text:style-name="Body">フリガナ</text:p><text:p text:style-name="Body">氏名</text:p><text:p text:style-name="Body">日中の連絡先</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p text:style-name="Center">(事業者及び管理組合にあっては、その所在地、名称及び代表者氏名)</text:p><text:p text:style-name="Center">江東区地球温暖化防止設備導入助成金交付申請書</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p text:style-name="Body">下記のとおり、関係書類を添えて、江東区地球温暖化防止設備導入助成金を申請します。</text:p><text:p text:style-name="Center">記</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Fill"><text:p text:style-name="Body"></text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">色付き部分に記入してください。</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">1　施工場所</text:p></table:table-cell><table:table-cell table:style-name="Fill"><text:p text:style-name="Body">□申請者住所と同じ　□その他　江東区</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">2　建物の状況</text:p></table:table-cell><table:table-cell table:style-name="Fill"><text:p text:style-name="Body">□個人住宅</text:p><text:p text:style-name="Body">（戸建住宅。マンションの一住戸を含む。）</text:p><text:p text:style-name="Body">□集合住宅（５住戸以上）　□事業所　□既築　□新築</text:p><text:p text:style-name="Body">□自己所有　□賃貸又は使用貸借　□管理組合　□その他（　　　　　　　　　）</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">3　建物の所有者</text:p></table:table-cell><table:table-cell table:style-name="Fill"><text:p text:style-name="Body">□申請者と同じ　□その他　氏名　　　　　　　　　　　　　　　　住所</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">4　設備の施工予定期間</text:p></table:table-cell><table:table-cell table:style-name="Fill"><text:p text:style-name="Body">着工　　年　　月　　日 ～ 完了　　年　　月　　日</text:p><text:p text:style-name="Body">※着工日前に全ての申請書類の提出が必要です。</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p text:style-name="Body">5　施工する設備の種類　※申請する設備にレ印をお願いします。</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">設備の種類</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">最大出力値、容量、設置数又は施工面積　　助成対象経費　　交付申請額（千円未満切捨て）</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Fill"><text:p text:style-name="Body">□　個　集　事　太陽光発電システム</text:p></table:table-cell><table:table-cell table:style-name="Fill"><text:p text:style-name="Body">kW　　　　　　　　　円　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Fill"><text:p text:style-name="Body">□　個　集　事　蓄　電　池</text:p></table:table-cell><table:table-cell table:style-name="Fill"><text:p text:style-name="Body">kWh　　　　　　　　円　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Fill"><text:p text:style-name="Body">□　個　集　事　エネルギー管理システム機器</text:p></table:table-cell><table:table-cell table:style-name="Fill"><text:p text:style-name="Body">台　　　　　　　　　円　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Fill"><text:p text:style-name="Body">□　個　　　事　ＣＯ₂冷媒ヒートポンプ給湯機</text:p></table:table-cell><table:table-cell table:style-name="Fill"><text:p text:style-name="Body">台　　　　　　　　　円　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Fill"><text:p text:style-name="Body">□　個　　　事　燃料電池装置</text:p></table:table-cell><table:table-cell table:style-name="Fill"><text:p text:style-name="Body">台　　　　　　　　　円　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Fill"><text:p text:style-name="Body">□　個　集　事　高反射率塗装</text:p></table:table-cell><table:table-cell table:style-name="Fill"><text:p text:style-name="Body">m²　　　　　　　　　円　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Fill"><text:p text:style-name="Body">□　個　集　事　高断熱窓</text:p></table:table-cell><table:table-cell table:style-name="Fill"><text:p text:style-name="Body">か所　　　　　　　　円　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Fill"><text:p text:style-name="Body">□　個　　　高断熱ドア</text:p></table:table-cell><table:table-cell table:style-name="Fill"><text:p text:style-name="Body">か所　　　　　　　　円　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Fill"><text:p text:style-name="Body">□　　　集　事　Ｌ　Ｅ　Ｄ　照　明</text:p></table:table-cell><table:table-cell table:style-name="Fill"><text:p text:style-name="Body">個　　　　　　　　　円　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Fill"><text:p text:style-name="Body">□　個　集　　電気自動車等充電設備</text:p></table:table-cell><table:table-cell table:style-name="Fill"><text:p text:style-name="Body">基　　　　　　　　　円　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">※「個」…個人住宅、「集」…集合住宅、「事」…事業所</text:p><text:p text:style-name="Body">建物の種別により、対象設備が異なります。</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">合計額　　　　　　　　　円　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">6　設備概要</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">設備の種類　　　　　　　　　メーカー名　　　　　　　　製品名、型式番号</text:p><text:p text:style-name="Body"></text:p><text:p text:style-name="Body"></text:p><text:p text:style-name="Body"></text:p><text:p text:style-name="Body"></text:p><text:p text:style-name="Body"></text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p text:style-name="Body">7　施工会社名（設置工事の契約事業者及び領収書の発行者）</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">会社名　　　　　　　　　　　　　　　　代表者氏名</text:p></table:table-cell><table:table-cell table:style-name="Fill"><text:p text:style-name="Body"></text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">担当者氏名　　　　　　　　　　　　　　連絡先</text:p></table:table-cell><table:table-cell table:style-name="Fill"><text:p text:style-name="Body"></text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p text:style-name="Center">⇒⇒⇒　裏面もあります。裏面の「８　誓約事項」もご確認の上、ご記入ください。　⇒⇒⇒</text:p><text:p text:style-name="Center">1 ／ 2</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="PageStart">8　誓約事項</text:p>
      <table:table table:name="誓約事項と必要書類">
        <table:table-column table:number-columns-repeated="2"/>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">私は、区に対して、以下の全ての事項について誓約いたします。</text:p><text:p text:style-name="Body">※必ず申請者本人が誓約事項をご確認ください。</text:p><text:p text:style-name="Body">※誓約内容に虚偽がある場合又は誓約に反する場合は、助成金の交付を受けられない場合があります。</text:p></table:table-cell><table:table-cell table:style-name="Fill"><text:p text:style-name="Body">申請者氏名</text:p><text:p text:style-name="Body">(事業者及び管理組合にあっては、名称及び代表者氏名)</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p text:style-name="Body">チェック欄（※レ印をお願いします。）</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Fill"><text:p text:style-name="Center">□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">(1)　本年度及び直近の過去４年度において、同一住宅・事業所の同一設備について、本助成金を受けていません。</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Fill"><text:p text:style-name="Center">□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">(2)　特別区民税・都民税（住民税）、法人都民税（住民税）の滞納はありません。</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Fill"><text:p text:style-name="Center">□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">(3)　江東区暴力団排除条例に規定する暴力団員及び暴力団関係者に該当しません。</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Fill"><text:p text:style-name="Center">□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">(4)　申請対象住宅（分譲の場合は、住戸）・事業所の全ての所有者の同意が得られています。</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Fill"><text:p text:style-name="Center">□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">(5)　本申請に係る工事は、対象住宅・事業所の販売又は譲渡を目的にしておりません。</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Fill"><text:p text:style-name="Center">□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">(6)　区が審査した結果、助成金の全部又は一部が交付対象にならない場合があることを了承します。</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Fill"><text:p text:style-name="Center">□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">(7)　本申請の記載事項について、誤字、脱字等の軽微な訂正については、区役所職員が行うことに同意します。</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Fill"><text:p text:style-name="Center">□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">(8)　助成対象設備が立地上又は構造上危険がないことを施工会社等に確認した上で申請します。</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Fill"><text:p text:style-name="Center">□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">(9)　申請者、手続代理人、施工会社等の間で生じる問題に関して、区が関与しないことを了承します。</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Fill"><text:p text:style-name="Center">□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">(10)　助成事業の適切な実施の確認のため、区が現地調査等を行う場合、協力することを了承します。</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p text:style-name="Body">環境に配慮した行動の促進のため、以下の全ての取組の実行に努めます。（※レ印をお願いします。）</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Fill"><text:p text:style-name="Center">□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">(11)　江東区環境検定（受検料無料のオンライン検定）、江東区環境学習情報館（えこっくる江東）の講座等の環境学習に関する取組への参加に努めます。</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Fill"><text:p text:style-name="Center">□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">(12)　清掃活動及び５Ｒ（リフューズ、リデュース、リユース、リペア、リサイクル）の取組に努めます。</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Fill"><text:p text:style-name="Center">□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">(13)　省エネ及び環境に配慮したライフスタイルを心がけます。</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="Body">________________________________________________________________________________________</text:p>
      <text:p text:style-name="Body">申請必要書類チェックリスト　※必ず「事業案内」（パンフレット）をご確認のうえ、書類をご用意ください。</text:p>
      <table:table table:name="申請必要書類チェックリスト">
        <table:table-column table:number-columns-repeated="2"/>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">交付申請書（第１号様式）</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">助成対象設備経費内訳書（第２号様式）〈設備毎に作成〉</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">申請者本人確認書類の写し</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">見積書または契約書の写し</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">当該設備が助成要件を満たすことがわかる書類</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">平面図等</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">工事着工前のカラー写真</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">【代理人が手続きをする場合】委任状</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">【新築・建替えの場合】新築工事請負契約書の写し</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">【高反射率塗装の場合】施工面積の算出表</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">【集合住宅※（法人（個人事業者を含む））・事業所の場合】商業登記簿謄本の写しまたは直近の確定申告書の写し</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">【集合住宅※（個人・法人（個人事業者を含む））・事業所の場合】不動産登記簿謄本の写し</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">【集合住宅※の場合（管理組合）】①管理規約、②対象設備導入の決議書、③現在理事長名のわかる決議書</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="Body">※１棟のうち独立した住戸が５戸以上ある建物の申請者が該当。集合住宅の１戸に居住しており、個人で工事契約を結ぶ場合には提出不要。</text:p>
