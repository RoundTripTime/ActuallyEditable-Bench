<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:line-height="150%"/>
      <style:text-properties fo:font-size="12pt" style:font-name="serif"/>
    </style:default-style>
    <style:style style:name="P" style:family="paragraph"/>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.8cm" fo:margin-bottom="0.8cm"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
    <style:style style:name="Space" style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%" fo:margin-top="0.35cm" fo:margin-bottom="0.35cm"/>
    </style:style>
    <style:style style:name="Indented" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="1.2cm"/>
    </style:style>
    <style:style style:name="Item" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.45cm" fo:margin-bottom="0.1cm"/>
    </style:style>
    <style:style style:name="Grid" style:family="table">
      <style:table-properties style:width="17cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="Col1_3" style:family="table-column">
      <style:table-column-properties style:column-width="4.5cm"/>
    </style:style>
    <style:style style:name="Col2_3" style:family="table-column">
      <style:table-column-properties style:column-width="5cm"/>
    </style:style>
    <style:style style:name="Col3_3" style:family="table-column">
      <style:table-column-properties style:column-width="7.5cm"/>
    </style:style>
    <style:style style:name="Col1_5" style:family="table-column">
      <style:table-column-properties style:column-width="3.2cm"/>
    </style:style>
    <style:style style:name="Col2_5" style:family="table-column">
      <style:table-column-properties style:column-width="3.45cm"/>
    </style:style>
    <style:style style:name="Col3_5" style:family="table-column">
      <style:table-column-properties style:column-width="3.45cm"/>
    </style:style>
    <style:style style:name="Col4_5" style:family="table-column">
      <style:table-column-properties style:column-width="3.45cm"/>
    </style:style>
    <style:style style:name="Col5_5" style:family="table-column">
      <style:table-column-properties style:column-width="3.45cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="2.2cm" fo:margin-bottom="2cm" fo:margin-left="2.8cm" fo:margin-right="2.8cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Right">区第　　号</text:p>
      <text:p text:style-name="Right">令和　　年　　月　　日</text:p>
      <text:p text:style-name="Space"/>
      <text:p>おおい町長　中塚　寛　様</text:p>
      <text:p text:style-name="Right">申請者　　区長　　　　印</text:p>
      <text:p text:style-name="Space"/>
      <text:p text:style-name="Title">令和　　年度サル被害緊急対策事業補助金交付申請書</text:p>
      <text:p>　令和　　年度においてサル被害緊急対策事業補助金の交付を受けたいので、おおい町補</text:p>
      <text:p>助金等交付規則第３条の規定により関係書類を添えて申請します。</text:p>
      <text:p text:style-name="Center">記</text:p>
      <text:p text:style-name="Item">１　補助事業等の名称</text:p>
      <text:p text:style-name="Indented">サル被害緊急対策事業</text:p>
      <text:p text:style-name="Item">２　補助事業等の目的及び内容</text:p>
      <text:p text:style-name="Indented">区内のサル追い払い活動を行うことにより、農作物の被害軽減及び農地の保全を図</text:p>
      <text:p text:style-name="Indented">ることを目的とする。</text:p>
      <text:p text:style-name="Item">３　補助事業等の完了の予定期日及び実施計画</text:p>
      <text:p text:style-name="Indented">別紙実施計画書のとおり</text:p>
      <text:p text:style-name="Item">４　交付申請額</text:p>
      <text:p text:style-name="Indented">金　　　　　円</text:p>
      <text:p text:style-name="Item">５　交付申請額の算出方法</text:p>
      <text:p text:style-name="Indented">定額（サル追い払い隊設立事業　　　　円、サル追い払い資機材整備事業</text:p>
      <text:p>　　　　　円、</text:p>
      <text:p text:style-name="Indented">サル追い払い活動支援事業　　　　円）</text:p>
      <text:p text:style-name="Item">６　補助事業等の経費の配分及び経費の使用方法</text:p>
      <text:p text:style-name="Indented">別紙収支予算書のとおり</text:p>
      <text:p text:style-name="Item">７　添付書類</text:p>
      <text:p text:style-name="Indented">実施計画書</text:p>
      <text:p text:style-name="Indented">収支予算書</text:p>

      <text:p text:style-name="PageStart"/>
      <text:p/>

      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="Title">令和　　年度 サル被害緊急対策事業 実施計画書</text:p>
      <table:table table:name="実施計画書" table:style-name="Grid">
        <table:table-column table:style-name="Col1_3"/>
        <table:table-column table:style-name="Col2_3"/>
        <table:table-column table:style-name="Col3_3"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">項目</text:p><text:p text:style-name="Center">時期</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">事業及び会議</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">説明</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="Title">令和　　年度 サル被害緊急対策事業収支予算書</text:p>
      <text:p>【収入】　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　単位：円</text:p>
      <table:table table:name="収入" table:style-name="Grid">
        <table:table-column table:style-name="Col1_5"/>
        <table:table-column table:style-name="Col2_5"/>
        <table:table-column table:style-name="Col3_5"/>
        <table:table-column table:style-name="Col4_5"/>
        <table:table-column table:style-name="Col5_5"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">項目</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">本年度予算額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">前年度予算額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">比較増減</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">備考</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">補助金</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">一般財源</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">合　計</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Space"/>
      <text:p>【支出】　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　単位：円</text:p>
      <table:table table:name="支出" table:style-name="Grid">
        <table:table-column table:style-name="Col1_5"/>
        <table:table-column table:style-name="Col2_5"/>
        <table:table-column table:style-name="Col3_5"/>
        <table:table-column table:style-name="Col4_5"/>
        <table:table-column table:style-name="Col5_5"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">項目</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">本年度予算額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">前年度予算額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">比較増減</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">備考</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">サル追い払い隊</text:p><text:p text:style-name="Center">設立事業</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">サル追い払い資</text:p><text:p text:style-name="Center">機材整備事業</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">サル追い払い活</text:p><text:p text:style-name="Center">動支援事業</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">合　計</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Space"/>
      <text:p>上記のとおり相違ありません。</text:p>
      <text:p text:style-name="Space"/>
      <text:p>令和　　年　　月　　日</text:p>
      <text:p text:style-name="Space"/>
      <text:p text:style-name="Right">区長　　　　　　印</text:p>
    </office:text>
  </office:body>
</office:document>