<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="10.5pt"/>
    </style:default-style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="2cm" fo:margin-right="2cm" fo:margin-top="2cm" fo:margin-bottom="2cm" style:print-orientation="portrait"/>
    </style:page-layout>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Centered" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="CenteredTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0.8cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="RightAligned" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Spaced" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.2cm" fo:margin-bottom="0.2cm"/>
    </style:style>
    <style:style style:name="Indented" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="1.1cm" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="TableCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="PlanCol1" style:family="table-column">
      <style:table-column-properties style:column-width="4.45cm"/>
    </style:style>
    <style:style style:name="PlanCol2" style:family="table-column">
      <style:table-column-properties style:column-width="4.2cm"/>
    </style:style>
    <style:style style:name="PlanCol3" style:family="table-column">
      <style:table-column-properties style:column-width="6.7cm"/>
    </style:style>
    <style:style style:name="BudgetCol1" style:family="table-column">
      <style:table-column-properties style:column-width="3.1cm"/>
    </style:style>
    <style:style style:name="BudgetCol2" style:family="table-column">
      <style:table-column-properties style:column-width="2.5cm"/>
    </style:style>
    <style:style style:name="BudgetCol3" style:family="table-column">
      <style:table-column-properties style:column-width="2.5cm"/>
    </style:style>
    <style:style style:name="BudgetCol4" style:family="table-column">
      <style:table-column-properties style:column-width="2.5cm"/>
    </style:style>
    <style:style style:name="BudgetCol5" style:family="table-column">
      <style:table-column-properties style:column-width="4.75cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="RightAligned">区第　　　号</text:p>
      <text:p text:style-name="RightAligned">令和　　年　　月　　日</text:p>
      <text:p text:style-name="Spaced">おおい町長　中塚　寛　様</text:p>
      <text:p text:style-name="RightAligned">申請者　　　区長　　　㊞</text:p>
      <text:p text:style-name="CenteredTitle">令和　　年度サル被害緊急対策事業補助金交付申請書</text:p>
      <text:p>令和　　年度においてサル被害緊急対策事業補助金の交付を受けたいので、おおい町補</text:p>
      <text:p>助金等交付規則第３条の規定により関係書類を添えて申請します。</text:p>
      <text:p text:style-name="Centered">記</text:p>
      <text:p text:style-name="Spaced">１　補助事業等の名称</text:p>
      <text:p text:style-name="Indented">サル被害緊急対策事業</text:p>
      <text:p text:style-name="Spaced">２　補助事業等の目的及び内容</text:p>
      <text:p text:style-name="Indented">区内のサル追い払い活動を行うことにより、農作物の被害軽減及び農地の保全を図</text:p>
      <text:p text:style-name="Indented">ることを目的とする。</text:p>
      <text:p text:style-name="Spaced">３　補助事業等の完了の予定期日及び実施計画</text:p>
      <text:p text:style-name="Indented">別紙実施計画書のとおり</text:p>
      <text:p text:style-name="Spaced">４　交付申請額</text:p>
      <text:p text:style-name="Indented">金　　　　　円</text:p>
      <text:p text:style-name="Spaced">５　交付申請額の算出方法</text:p>
      <text:p text:style-name="Indented">定額（サル追い払い隊設立事業　　　　　円、サル追い払い資機材整備事業</text:p>
      <text:p>円、</text:p>
      <text:p text:style-name="Indented">サル追い払い活動支援事業　　　　　円）</text:p>
      <text:p text:style-name="Spaced">６　補助事業等の経費の配分及び経費の使用方法</text:p>
      <text:p text:style-name="Indented">別紙収支予算書のとおり</text:p>
      <text:p text:style-name="Spaced">７　添付書類</text:p>
      <text:p text:style-name="Indented">実施計画書</text:p>
      <text:p text:style-name="Indented">収支予算書</text:p>

      <text:p text:style-name="PageStart"/>
      <text:p/>

      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="CenteredTitle">令和　　年度　サル被害緊急対策事業　実施計画書</text:p>
      <table:table table:name="実施計画書">
        <table:table-column table:style-name="PlanCol1"/>
        <table:table-column table:style-name="PlanCol2"/>
        <table:table-column table:style-name="PlanCol3"/>
        <table:table-row>
          <table:table-cell table:style-name="TableCell">
            <text:p text:style-name="CellCenter">項目</text:p>
            <text:p/>
            <text:p/>
            <text:p text:style-name="CellCenter">時期</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="TableCell">
            <text:p text:style-name="CellCenter">事業及び会議</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="TableCell">
            <text:p text:style-name="CellCenter">説明</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="CenteredTitle">令和　　年度　サル被害緊急対策事業収支予算書</text:p>
      <text:p>【収入】<text:tab/>　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　単位：円</text:p>
      <table:table table:name="収入">
        <table:table-column table:style-name="BudgetCol1"/>
        <table:table-column table:style-name="BudgetCol2"/>
        <table:table-column table:style-name="BudgetCol3"/>
        <table:table-column table:style-name="BudgetCol4"/>
        <table:table-column table:style-name="BudgetCol5"/>
        <table:table-row>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="CellCenter">項目</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="CellCenter">本年度予算額</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="CellCenter">前年度予算額</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="CellCenter">比較増減</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="CellCenter">備考</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="CellCenter">補助金</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="CellCenter">一般財源</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="CellCenter">合　計</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p/>
      <text:p>【支出】<text:tab/>　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　単位：円</text:p>
      <table:table table:name="支出">
        <table:table-column table:style-name="BudgetCol1"/>
        <table:table-column table:style-name="BudgetCol2"/>
        <table:table-column table:style-name="BudgetCol3"/>
        <table:table-column table:style-name="BudgetCol4"/>
        <table:table-column table:style-name="BudgetCol5"/>
        <table:table-row>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="CellCenter">項目</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="CellCenter">本年度予算額</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="CellCenter">前年度予算額</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="CellCenter">比較増減</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="CellCenter">備考</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="CellCenter">サル追い払い隊</text:p><text:p text:style-name="CellCenter">設立事業</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="CellCenter">サル追い払い資</text:p><text:p text:style-name="CellCenter">機材整備事業</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="CellCenter">サル追い払い活</text:p><text:p text:style-name="CellCenter">動支援事業</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="CellCenter">合　計</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Spaced">上記のとおり相違ありません。</text:p>
      <text:p text:style-name="Spaced">令和　　年　　月　　日</text:p>
      <text:p text:style-name="RightAligned">区長　　　　　　㊞</text:p>
    </office:text>
  </office:body>
</office:document>