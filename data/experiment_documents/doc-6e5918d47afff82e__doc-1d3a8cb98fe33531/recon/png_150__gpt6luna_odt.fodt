<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:font-size="12pt" fo:line-height="1.45" fo:margin-top="0cm" fo:margin-bottom="0.15cm"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:font-size="20pt" fo:text-align="center" fo:margin-top="0.7cm" fo:margin-bottom="1.7cm"/>
    </style:style>
    <style:style style:name="NextTitle" style:family="paragraph" style:parent-style-name="Title">
      <style:paragraph-properties fo:break-before="page" fo:font-size="20pt" fo:text-align="center" fo:margin-top="0.7cm" fo:margin-bottom="1.7cm"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:margin-top="0.7cm" fo:margin-bottom="0.15cm"/>
    </style:style>
    <style:style style:name="Gap" style:family="paragraph">
