<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:font-face-decls>
    <style:font-face style:name="Arial" svg:font-family="Arial" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"/>
  </office:font-face-decls>
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm"/>
      <style:text-properties fo:font-family="Arial" style:font-name="Arial" fo:font-size="11pt"/>
    </style:default-style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:line-height="1pt" fo:margin="0cm"/>
      <style:text-properties fo:font-size="1pt"/>
    </style:style>
    <style:style style:name="SectionHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.75cm" fo:margin-bottom="0.25cm"/>
      <style:text-properties fo:font-size="15pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="SubItem" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.25cm" fo:margin-top="0.18cm" fo:margin-bottom="0.42cm"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="CenteredCellText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin="0cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="BadgeText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin="0cm"/>
      <style:text-properties fo:font-size="15pt" fo:font-weight="bold" fo:color="#ffffff"/>
    </style:style>
    <style:style style:name="TitleText" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.25cm" fo:margin="0cm"/>
      <style:text-properties fo:font-size="16pt" fo:font-weight="bold"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-left="2.03cm" fo:margin-right="2.03cm" fo:margin-top="2.5cm" fo:margin-bottom="2cm"/>
    </style:page-layout>
    <style:style style:name="HeaderTable" style:family="table">
      <style:table-properties style:width="16.94cm"/>
    </style:style>
    <style:style style:name="HeaderColBadge" style:family="table-column">
      <style:table-column-properties style:column-width="2cm"/>
    </style:style>
    <style:style style:name="HeaderColTitle" style:family="table-column">
      <style:table-column-properties style:column-width="14.94cm"/>
    </style:style>
    <style:style style:name="HeaderRow" style:family="table-row">
      <style:table-row-properties style:row-height="1cm"/>
    </style:style>
    <style:style style:name="BadgeCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #555555" fo:background-color="#1b3552" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="TitleCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #555555" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="InfoTable" style:family="table">
      <style:table-properties style:width="16.94cm"/>
    </style:style>
    <style:style style:name="InfoCol1" style:family="table-column">
      <style:table-column-properties style:column-width="2.73cm"/>
    </style:style>
    <style:style style:name="InfoCol2" style:family="table-column">
      <style:table-column-properties style:column-width="6.24cm"/>
    </style:style>
    <style:style style:name="InfoCol3" style:family="table-column">
      <style:table-column-properties style:column-width="3.25cm"/>
    </style:style>
    <style:style style:name="InfoCol4" style:family="table-column">
      <style:table-column-properties style:column-width="4.72cm"/>
    </style:style>
    <style:style style:name="InfoRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.72cm"/>
    </style:style>
    <style:style style:name="InfoCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #555555" fo:padding="0.12cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="ResponseTable" style:family="table">
      <style:table-properties style:width="16.94cm"/>
    </style:style>
    <style:style style:name="ResponseColumn" style:family="table-column">
      <style:table-column-properties style:column-width="16.94cm"/>
    </style:style>
    <style:style style:name="ResponseRow" style:family="table-row">
      <style:table-row-properties style:row-height="5.8cm"/>
    </style:style>
    <style:style style:name="ResponseCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #555555" fo:padding="0.15cm" style:vertical-align="top"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="DefaultPage" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart"/>
      <table:table table:name="Title" table:style-name="HeaderTable">
        <table:table-column table:style-name="HeaderColBadge"/>
        <table:table-column table:style-name="HeaderColTitle"/>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="BadgeCell">
            <text:p text:style-name="BadgeText">참고1□</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="TitleCell">
            <text:p text:style-name="TitleText">폭염중대경보 발령 시 작업중지 이행계획서</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="SectionHeading">□ 현장 개요</text:p>
      <table:table table:name="현장 개요" table:style-name="InfoTable">
        <table:table-column table:style-name="InfoCol1"/>
        <table:table-column table:style-name="InfoCol2"/>
        <table:table-column table:style-name="InfoCol3"/>
        <table:table-column table:style-name="InfoCol4"/>
        <table:table-row table:style-name="InfoRow">
          <table:table-cell table:style-name="InfoCell">
            <text:p text:style-name="CenteredCellText">현 장 명</text:p>
            <text:p text:style-name="CenteredCellText">(건설업체명)</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InfoCell"/>
          <table:table-cell table:style-name="InfoCell">
            <text:p text:style-name="CenteredCellText">현장소장</text:p>
            <text:p text:style-name="CenteredCellText">안전·보건관리자</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InfoCell"/>
        </table:table-row>
        <table:table-row table:style-name="InfoRow">
          <table:table-cell table:style-name="InfoCell">
            <text:p text:style-name="CenteredCellText">소 재 지</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InfoCell"/>
          <table:table-cell table:style-name="InfoCell">
            <text:p text:style-name="CenteredCellText">공사기간</text:p>
            <text:p text:style-name="CenteredCellText">공정률</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InfoCell"/>
        </table:table-row>
        <table:table-row table:style-name="InfoRow">
          <table:table-cell table:style-name="InfoCell">
            <text:p text:style-name="CenteredCellText">공사금액</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InfoCell"/>
          <table:table-cell table:style-name="InfoCell">
            <text:p text:style-name="CenteredCellText">전 화 번 호</text:p>
            <text:p text:style-name="CenteredCellText">(팩 스 번 호)</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InfoCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="SectionHeading">□ 폭염 대응 체계(조직) 현황 및 역할</text:p>
      <text:p text:style-name="SubItem">○ (폭염 대응 체계)</text:p>
      <text:p text:style-name="SubItem">○ (담당자별 역할)</text:p>
      <text:p text:style-name="SectionHeading">□ 폭염중대경보 발령 당일 작업현황(’ . . .( : ))</text:p>
      <text:p text:style-name="SubItem">○ (옥내작업)</text:p>
      <text:p text:style-name="SubItem">○ (옥외작업)</text:p>
      <text:p text:style-name="SectionHeading">□ 폭염중대경보 발령 시 작업중지 이행 계획</text:p>
      <table:table table:name="작업중지 이행 계획" table:style-name="ResponseTable">
        <table:table-column table:style-name="ResponseColumn"/>
        <table:table-row table:style-name="ResponseRow">
          <table:table-cell table:style-name="ResponseCell"/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>