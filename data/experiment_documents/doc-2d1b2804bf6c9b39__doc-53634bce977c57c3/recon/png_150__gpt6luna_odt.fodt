<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.55cm" fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-size="18pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Subsection" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.25cm" fo:margin-top="0.35cm" fo:margin-bottom="0.25cm"/>
      <style:text-properties fo:font-size="15pt"/>
    </style:style>
    <style:style style:name="TitleLabel" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#1F3B59" fo:border="0.5pt solid #555555" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="TitleCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #555555" fo:padding-left="0.25cm" fo:padding-right="0.15cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="TitleLabelP" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="18pt" fo:font-weight="bold" fo:color="#FFFFFF"/>
    </style:style>
    <style:style style:name="TitleP" style:family="paragraph">
      <style:text-properties fo:font-size="20pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="FieldLabel" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #666666" fo:padding="0.16cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="FieldInput" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #666666" fo:padding="0.16cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="FieldLabelP" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="13pt"/>
    </style:style>
    <style:style style:name="FieldText" style:family="paragraph">
      <style:text-properties fo:font-size="13pt"/>
    </style:style>
    <style:style style:name="BoxCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #666666" fo:padding-top="5.5cm" fo:padding-left="0.12cm" fo:padding-right="0.12cm" fo:padding-bottom="0.12cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-left="2cm" fo:margin-right="2cm" fo:margin-top="2.4cm" fo:margin-bottom="2.4cm"/>
    </style:page-layout>
    <style:style style:name="TitleTable" style:family="table">
      <style:table-properties style:width="17cm" table:align="margins" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="TitleCol1" style:family="table-column">
      <style:table-column-properties style:column-width="2.25cm"/>
    </style:style>
    <style:style style:name="TitleCol2" style:family="table-column">
      <style:table-column-properties style:column-width="14.75cm"/>
    </style:style>
    <style:style style:name="FieldTable" style:family="table">
      <style:table-properties style:width="17cm" table:align="margins" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="FieldCol1" style:family="table-column">
      <style:table-column-properties style:column-width="2.75cm"/>
    </style:style>
    <style:style style:name="FieldCol2" style:family="table-column">
      <style:table-column-properties style:column-width="6.25cm"/>
    </style:style>
    <style:style style:name="FieldCol3" style:family="table-column">
      <style:table-column-properties style:column-width="3.25cm"/>
    </style:style>
    <style:style style:name="FieldCol4" style:family="table-column">
      <style:table-column-properties style:column-width="4.75cm"/>
    </style:style>
    <style:style style:name="BoxTable" style:family="table">
      <style:table-properties style:width="17cm" table:align="margins" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="BoxCol" style:family="table-column">
      <style:table-column-properties style:column-width="17cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="DefaultPage" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <table:table table:name="Title" table:style-name="TitleTable">
        <table:table-column table:style-name="TitleCol1"/>
        <table:table-column table:style-name="TitleCol2"/>
        <table:table-row>
          <table:table-cell table:style-name="TitleLabel">
            <text:p text:style-name="TitleLabelP">참고1□</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="TitleCell">
            <text:p text:style-name="TitleP">폭염중대경보 발령 시 작업중지 이행계획서</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Section">□ 현장 개요</text:p>
      <table:table table:name="현장 개요" table:style-name="FieldTable">
        <table:table-column table:style-name="FieldCol1"/>
        <table:table-column table:style-name="FieldCol2"/>
        <table:table-column table:style-name="FieldCol3"/>
        <table:table-column table:style-name="FieldCol4"/>
        <table:table-row>
          <table:table-cell table:style-name="FieldLabel">
            <text:p text:style-name="FieldLabelP">현 장 명</text:p>
            <text:p text:style-name="FieldLabelP">(건설업체명)</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FieldInput"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FieldLabel">
            <text:p text:style-name="FieldLabelP">현장소장</text:p>
            <text:p text:style-name="FieldLabelP">안전·보건관리자</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FieldInput"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FieldLabel">
            <text:p text:style-name="FieldLabelP">소 재 지</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FieldInput"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FieldLabel">
            <text:p text:style-name="FieldLabelP">공사기간</text:p>
            <text:p text:style-name="FieldLabelP">공정률</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FieldInput"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FieldLabel">
            <text:p text:style-name="FieldLabelP">공사금액</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FieldInput"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FieldLabel">
            <text:p text:style-name="FieldLabelP">전 화 번 호</text:p>
            <text:p text:style-name="FieldLabelP">(팩 스 번 호)</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FieldInput"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Section">□ 폭염 대응 체계(조직) 현황 및 역할</text:p>
      <text:p text:style-name="Subsection">○ (폭염 대응 체계)</text:p>
      <text:p text:style-name="Subsection">○ (담당자별 역할)</text:p>
      <text:p text:style-name="Section">□ 폭염중대경보 발령 당일 작업현황(’ . . .( : ))</text:p>
      <text:p text:style-name="Subsection">○ (옥내작업)</text:p>
      <text:p text:style-name="Subsection">○ (옥외작업)</text:p>
      <text:p text:style-name="Section">□ 폭염중대경보 발령 시 작업중지 이행 계획</text:p>
      <table:table table:name="작업중지 이행 계획" table:style-name="BoxTable">
        <table:table-column table:style-name="BoxCol"/>
        <table:table-row>
          <table:table-cell table:style-name="BoxCell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>