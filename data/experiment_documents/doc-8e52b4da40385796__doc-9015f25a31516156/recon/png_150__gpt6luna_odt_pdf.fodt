<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:xml="http://www.w3.org/XML/1998/namespace" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0cm" fo:margin-right="0cm" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="0.61cm"/>
      <style:text-properties fo:font-family="MS Mincho" fo:font-size="12pt" fo:language="ja" fo:country="JP"/>
    </style:default-style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="3cm" fo:margin-bottom="2cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
    </style:page-layout>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-bottom="0.38cm" fo:line-height="0.61cm"/>
    </style:style>
    <style:style style:name="CenterHeading" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-bottom="0.38cm" fo:line-height="0.61cm"/>
    </style:style>
    <style:style style:name="RightDate" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-bottom="0.38cm" fo:line-height="0.61cm"/>
    </style:style>
    <style:style style:name="FormLine" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0cm" fo:line-height="0.61cm"/>
    </style:style>
    <style:style style:name="BodyLine" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0cm" fo:line-height="0.61cm"/>
    </style:style>
    <style:style style:name="SectionHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.38cm" fo:margin-bottom="0.38cm" fo:line-height="0.61cm"/>
    </style:style>
    <style:style style:name="ListLine" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.38cm" fo:margin-bottom="0cm" fo:line-height="0.61cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">別記第２号様式（第６条関係）</text:p>
      <text:p text:style-name="CenterHeading">誓　　約　　書</text:p>
      <text:p text:style-name="RightDate">年　　　月　　　日</text:p>
      <text:p text:style-name="FormLine">　浦幌町長　　　　　　　　　　　　様</text:p>
      <text:p text:style-name="FormLine">申請者　住　　所　十勝郡浦幌町字 </text:p>
      <text:p text:style-name="FormLine">　　　　氏　　名</text:p>
      <text:p text:style-name="FormLine">　　　　電話番号</text:p>
      <text:p text:style-name="BodyLine">　浦幌町防災士資格取得費用補助金交付要綱（以下「要綱」という。）の規定に基づき補</text:p>
      <text:p text:style-name="BodyLine">助金の交付申請をするにあたり、要綱第３条の補助対象者の条件を確認し、資格取得後は、</text:p>
      <text:p text:style-name="BodyLine">町内の自主防災組織等で積極的に活動します。また、次に掲げる情報を町内の自主防災組</text:p>
      <text:p text:style-name="BodyLine">織及び行政区に提供することについて、同意します。</text:p>
      <text:p text:style-name="SectionHeading">自主防災組織及び行政区へ提供する情報の内容</text:p>
      <text:p text:style-name="ListLine">１　住　　所</text:p>
      <text:p text:style-name="FormLine">２　氏　　名</text:p>
      <text:p text:style-name="FormLine">３　電話番号</text:p>
    </office:text>
  </office:body>
</office:document>