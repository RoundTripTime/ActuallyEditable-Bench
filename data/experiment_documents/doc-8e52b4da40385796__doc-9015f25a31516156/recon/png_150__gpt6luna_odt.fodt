<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:text-properties fo:font-size="12pt"/>
    </style:default-style>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:line-height="150%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="FormTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-bottom="8mm"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="DateRight" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-bottom="7mm"/>
    </style:style>
    <style:style style:name="BodyText" style:family="paragraph">
      <style:paragraph-properties fo:line-height="150%" fo:margin-top="8mm" fo:margin-bottom="7mm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="SectionHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="7mm" fo:margin-bottom="6mm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" fo:margin-left="20mm" fo:margin-right="20mm" fo:margin-top="25mm" fo:margin-bottom="20mm"/>
    </style:page-layout>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-bottom="8mm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="NoBorderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Col55" style:family="table-column">
      <style:table-column-properties style:column-width="55mm"/>
    </style:style>
    <style:style style:name="Col115" style:family="table-column">
      <style:table-column-properties style:column-width="115mm"/>
    </style:style>
    <style:style style:name="Col70" style:family="table-column">
      <style:table-column-properties style:column-width="70mm"/>
    </style:style>
    <style:style style:name="Col22" style:family="table-column">
      <style:table-column-properties style:column-width="22mm"/>
    </style:style>
    <style:style style:name="Col28" style:family="table-column">
      <style:table-column-properties style:column-width="28mm"/>
    </style:style>
    <style:style style:name="Col50" style:family="table-column">
      <style:table-column-properties style:column-width="50mm"/>
    </style:style>
    <style:style style:name="Col8" style:family="table-column">
      <style:table-column-properties style:column-width="8mm"/>
    </style:style>
    <style:style style:name="Col30" style:family="table-column">
      <style:table-column-properties style:column-width="30mm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">別記第２号様式（第６条関係）</text:p>
      <text:p text:style-name="FormTitle">誓　約　書</text:p>
      <text:p text:style-name="DateRight">年　　　月　　　日</text:p>
      <table:table table:name="MayorLine">
        <table:table-column table:style-name="Col55"/>
        <table:table-column table:style-name="Col115"/>
        <table:table-row>
          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="P">浦幌町長</text:p></table:table-cell>
          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="P">様</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <table:table table:name="ApplicantFields">
        <table:table-column table:style-name="Col70"/>
        <table:table-column table:style-name="Col22"/>
        <table:table-column table:style-name="Col28"/>
        <table:table-column table:style-name="Col50"/>
        <table:table-row>
          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="P"/></table:table-cell>
          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="P">申請者</text:p></table:table-cell>
          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="P">住　所</text:p></table:table-cell>
          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="P">十勝郡浦幌町字</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="P"/></table:table-cell>
          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="P"/></table:table-cell>
          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="P">氏　名</text:p></table:table-cell>
          <table:table-cell table:style-name="NoBorderCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="P"/></table:table-cell>
          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="P"/></table:table-cell>
          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="P">電話番号</text:p></table:table-cell>
          <table:table-cell table:style-name="NoBorderCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="BodyText">浦幌町防災士資格取得費用補助金交付要綱（以下「要綱」という。）の規定に基づき補<text:line-break/>助金の交付申請をするにあたり、要綱第３条の補助対象者の条件を確認し、資格取得後は、<text:line-break/>町内の自主防災組織等で積極的に活動します。また、次に掲げる情報を町内の自主防災組<text:line-break/>織及び行政区に提供することについて、同意します。</text:p>
      <text:p text:style-name="SectionHeading">自主防災組織及び行政区へ提供する情報の内容</text:p>
      <table:table table:name="ProvidedInformation">
        <table:table-column table:style-name="Col8"/>
        <table:table-column table:style-name="Col30"/>
        <table:table-row>
          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="P">１</text:p></table:table-cell>
          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="P">住　所</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="P">２</text:p></table:table-cell>
          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="P">氏　名</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="P">３</text:p></table:table-cell>
          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="P">電話番号</text:p></table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>