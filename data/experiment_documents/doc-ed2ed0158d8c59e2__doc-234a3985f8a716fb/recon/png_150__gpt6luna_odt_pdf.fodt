<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:font-size="10pt" fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt" style:font-name="Batang"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:font-size="10pt" fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt" style:font-name="Batang"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="30mm" fo:margin-bottom="0mm"/>
    </style:style>
    <style:style style:name="FormLabel" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0mm" fo:margin-bottom="0mm"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="1mm" fo:margin-bottom="10mm"/>
      <style:text-properties fo:font-size="15pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0mm" fo:margin-bottom="1mm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.35pt solid #000000" fo:padding="1mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CenteredCell" style:family="table-cell" style:parent-style-name="Cell">
      <style:table-cell-properties fo:border="0.35pt solid #000000" fo:padding="1mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellPara" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="center" fo:line-height="110%" fo:margin-top="0mm" fo:margin-bottom="0mm"/>
    </style:style>
    <style:style style:name="LeftCellPara" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="center" fo:line-height="125%" fo:margin-top="0mm" fo:margin-bottom="0mm"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="22mm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="38mm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="22mm"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties style:column-width="36mm"/>
    </style:style>
    <style:style style:name="Col5" style:family="table-column">
      <style:table-column-properties style:column-width="18mm"/>
    </style:style>
    <style:style style:name="Col6" style:family="table-column">
      <style:table-column-properties style:column-width="38mm"/>
    </style:style>
    <style:style style:name="MainCol1" style:family="table-column">
      <style:table-column-properties style:column-width="59mm"/>
    </style:style>
    <style:style style:name="MainCol2" style:family="table-column">
      <style:table-column-properties style:column-width="38mm"/>
    </style:style>
    <style:style style:name="MainCol3" style:family="table-column">
      <style:table-column-properties style:column-width="66mm"/>
    </style:style>
    <style:style style:name="MainCol4" style:family="table-column">
      <style:table-column-properties style:column-width="50mm"/>
    </style:style>
    <style:style style:name="TopTable" style:family="table">
      <style:table-properties table:align="margins"/>
    </style:style>
    <style:style style:name="MainTable" style:family="table">
      <style:table-properties table:align="margins"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" fo:margin-top="15mm" fo:margin-bottom="15mm" fo:margin-left="18mm" fo:margin-right="18mm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">[별지 제1호 서식]</text:p>
      <text:p text:style-name="Title">학습경험 학점인정 신청서</text:p>
      <text:p text:style-name="Section">1. 신청인</text:p>
      <table:table table:name="Applicant" table:style-name="TopTable">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-column table:style-name="Col5"/>
        <table:table-column table:style-name="Col6"/>
        <table:table-row>
          <table:table-cell table:style-name="CenteredCell"><text:p text:style-name="CellPara">대학</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="CenteredCell"><text:p text:style-name="CellPara">학과</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="CenteredCell"><text:p text:style-name="CellPara">학번</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CenteredCell"><text:p text:style-name="CellPara">학년</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="CenteredCell"><text:p text:style-name="CellPara">성명</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="CenteredCell"><text:p text:style-name="CellPara">연락처</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body"><text:s text:c="3"/></text:p>
      <text:p text:style-name="Section">2. 신청 대상 및 학점</text:p>
      <table:table table:name="CreditApplication" table:style-name="MainTable">
        <table:table-column table:style-name="MainCol1"/>
        <table:table-column table:style-name="MainCol2"/>
        <table:table-column table:style-name="MainCol3"/>
        <table:table-column table:style-name="MainCol4"/>
        <table:table-row>
          <table:table-cell table:style-name="CenteredCell"><text:p text:style-name="CellPara">인정 대상</text:p></table:table-cell>
          <table:table-cell table:style-name="CenteredCell"><text:p text:style-name="CellPara">신청 여부</text:p><text:p text:style-name="CellPara">(해당 사항 체크)</text:p></table:table-cell>
          <table:table-cell table:style-name="CenteredCell"><text:p text:style-name="CellPara">신청학점</text:p><text:p text:style-name="CellPara">(신청학점 기재 / 최대학점)</text:p></table:table-cell>
          <table:table-cell table:style-name="CenteredCell"><text:p text:style-name="CellPara">이수 구분</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CenteredCell" table:number-rows-spanned="2"><text:p text:style-name="LeftCellPara">국내·외 타 대학 및 기관학습·연구·실습</text:p><text:p text:style-name="LeftCellPara">*대학 간 학점교류 포함</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2"/>
          <table:table-cell table:style-name="CenteredCell"><text:p text:style-name="CellPara">2023학번 이전</text:p><text:p text:style-name="CellPara">( 학점 / 26학점)</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CenteredCell"><text:p text:style-name="CellPara">2024학번 이후</text:p><text:p text:style-name="CellPara">( 학점 / 24학점)</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CenteredCell"><text:p text:style-name="LeftCellPara">지정된 외부 기관 온라인 교육</text:p><text:p text:style-name="LeftCellPara">(K-MOOC)</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="CenteredCell"><text:p text:style-name="CellPara">( 학점 / 4학점)</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CenteredCell"><text:p text:style-name="LeftCellPara">대학이 승인한 특별교육</text:p><text:p text:style-name="LeftCellPara">프로그램</text:p><text:p text:style-name="LeftCellPara">* APICS 프로그램 등 포함</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="CenteredCell"><text:p text:style-name="CellPara">( 학점 / 3학점)</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body"><text:s text:c="2"/>위 본인은 추계예술대학교 학습경험 학점인정에 관한 규정에 따라 학습경험 학점인정을 신청합니다.</text:p>
      <text:p text:style-name="Body">제출한 증빙자료는 모두 사실이며, 만약 사실과 다르면 학습경험 학점인정 취소 등을 포함한 모든 불이익을</text:p>
      <text:p text:style-name="Body">감수할 것을 서약합니다.</text:p>
      <text:p text:style-name="Body"><text:s text:c="3"/>붙임<text:s text:c="2"/>인정대상별 증빙자료 각 1부.</text:p>
      <text:p text:style-name="Body"><text:s text:c="26"/>20<text:s text:c="4"/>년<text:s text:c="4"/>월<text:s text:c="4"/>일</text:p>
      <text:p text:style-name="Body"><text:s text:c="12"/>신청인 성명<text:s text:c="20"/>(서명 또는 날인)</text:p>
      <text:p text:style-name="Body"><text:s text:c="2"/>추계예술대학교 총장 귀하</text:p>
    </office:text>
  </office:body>
</office:document>