<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:font-face-decls>
    <style:font-face style:name="Noto Sans CJK KR" svg:font-family="Noto Sans CJK KR"/>
  </office:font-face-decls>
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:font-size="10pt" fo:line-height="120%"/>
      <style:text-properties style:font-name="Noto Sans CJK KR" fo:font-family="Noto Sans CJK KR" fo:font-size="10pt"/>
    </style:default-style>
    <style:style style:name="Base" style:family="paragraph" style:master-page-name="Standard">
      <style:paragraph-properties fo:font-size="10pt" fo:line-height="120%"/>
      <style:text-properties style:font-name="Noto Sans CJK KR" fo:font-family="Noto Sans CJK KR" fo:font-size="10pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" fo:margin-top="33mm" fo:margin-bottom="25mm" fo:margin-left="18mm" fo:margin-right="18mm"/>
    </style:page-layout>
    <style:style style:name="PageStart" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:break-before="page" fo:margin-bottom="2mm"/>
    </style:style>
    <style:style style:name="Lead" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:margin-bottom="2mm"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0mm" fo:margin-bottom="10mm"/>
      <style:text-properties fo:font-size="18pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="1mm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Cell" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:text-align="center" fo:margin="0mm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="CellLeft" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:text-align="left" fo:margin="0mm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="CellSmall" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:text-align="center" fo:margin="0mm" fo:line-height="115%"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="TableOne" style:family="table">
      <style:table-properties style:width="176mm" table:align="margins"/>
    </style:style>
    <style:style style:name="TableTwo" style:family="table">
      <style:table-properties style:width="176mm" table:align="margins"/>
    </style:style>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="22mm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="38mm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="24mm"/>
    </style:style>
    <style:style style:name="ColD" style:family="table-column">
      <style:table-column-properties style:column-width="37mm"/>
    </style:style>
    <style:style style:name="ColE" style:family="table-column">
      <style:table-column-properties style:column-width="20mm"/>
    </style:style>
    <style:style style:name="ColF" style:family="table-column">
      <style:table-column-properties style:column-width="35mm"/>
    </style:style>
    <style:style style:name="T2ColA" style:family="table-column">
      <style:table-column-properties style:column-width="50mm"/>
    </style:style>
    <style:style style:name="T2ColB" style:family="table-column">
      <style:table-column-properties style:column-width="33mm"/>
    </style:style>
    <style:style style:name="T2ColC" style:family="table-column">
      <style:table-column-properties style:column-width="55mm"/>
    </style:style>
    <style:style style:name="T2ColD" style:family="table-column">
      <style:table-column-properties style:column-width="38mm"/>
    </style:style>
    <style:style style:name="Row" style:family="table-row">
      <style:table-row-properties style:min-row-height="8mm"/>
    </style:style>
    <style:style style:name="HeaderRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="11mm"/>
    </style:style>
    <style:style style:name="MainRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="13mm"/>
    </style:style>
    <style:style style:name="SpecialRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="14mm"/>
    </style:style>
    <style:style style:name="CellBox" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="1mm" style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">[별지 제1호 서식]</text:p>
      <text:p text:style-name="Title">학습경험 학점인정 신청서</text:p>
      <text:p text:style-name="Section">1. 신청인</text:p>
      <table:table table:name="Applicant" table:style-name="TableOne">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColD"/>
        <table:table-column table:style-name="ColE"/>
        <table:table-column table:style-name="ColF"/>
        <table:table-row table:style-name="Row">
          <table:table-cell table:style-name="CellBox"><text:p text:style-name="Cell">대학</text:p></table:table-cell>
          <table:table-cell table:style-name="CellBox"/>
          <table:table-cell table:style-name="CellBox"><text:p text:style-name="Cell">학과</text:p></table:table-cell>
          <table:table-cell table:style-name="CellBox"/>
          <table:table-cell table:style-name="CellBox"><text:p text:style-name="Cell">학번</text:p></table:table-cell>
          <table:table-cell table:style-name="CellBox"/>
        </table:table-row>
        <table:table-row table:style-name="Row">
          <table:table-cell table:style-name="CellBox"><text:p text:style-name="Cell">학년</text:p></table:table-cell>
          <table:table-cell table:style-name="CellBox"/>
          <table:table-cell table:style-name="CellBox"><text:p text:style-name="Cell">성명</text:p></table:table-cell>
          <table:table-cell table:style-name="CellBox"/>
          <table:table-cell table:style-name="CellBox"><text:p text:style-name="Cell">연락처</text:p></table:table-cell>
          <table:table-cell table:style-name="CellBox"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Lead"><text:s text:c="1"/></text:p>
      <text:p text:style-name="Section">2. 신청 대상 및 학점</text:p>
      <table:table table:name="CreditRequest" table:style-name="TableTwo">
        <table:table-column table:style-name="T2ColA"/>
        <table:table-column table:style-name="T2ColB"/>
        <table:table-column table:style-name="T2ColC"/>
        <table:table-column table:style-name="T2ColD"/>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="CellBox"><text:p text:style-name="Cell">인정 대상</text:p></table:table-cell>
          <table:table-cell table:style-name="CellBox">
            <text:p text:style-name="Cell">신청 여부</text:p>
            <text:p text:style-name="Cell">(해당 사항 체크)</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="CellBox">
            <text:p text:style-name="Cell">신청학점</text:p>
            <text:p text:style-name="Cell">(신청학점 기재 / 최대학점)</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="CellBox"><text:p text:style-name="Cell">이수 구분</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="MainRow">
          <table:table-cell table:style-name="CellBox" table:number-rows-spanned="2">
            <text:p text:style-name="Cell">국내·외 타 대학 및 기관학습·</text:p>
            <text:p text:style-name="Cell">연구·실습</text:p>
            <text:p text:style-name="Cell">*대학 간 학점교류 포함</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="CellBox" table:number-rows-spanned="2"/>
          <table:table-cell table:style-name="CellBox">
            <text:p text:style-name="Cell">2023학번 이전</text:p>
            <text:p text:style-name="Cell">( <text:s text:c="1"/>학점 / 26학점)</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="CellBox" table:number-rows-spanned="2"/>
        </table:table-row>
        <table:table-row table:style-name="MainRow">
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellBox">
            <text:p text:style-name="Cell">2024학번 이후</text:p>
            <text:p text:style-name="Cell">( <text:s text:c="1"/>학점 / 24학점)</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="Row">
          <table:table-cell table:style-name="CellBox">
            <text:p text:style-name="Cell">지정된 외부 기관 온라인 교육</text:p>
            <text:p text:style-name="Cell">(K-MOOC)</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="CellBox"/>
          <table:table-cell table:style-name="CellBox"><text:p text:style-name="Cell">( <text:s text:c="1"/>학점 / 4학점)</text:p></table:table-cell>
          <table:table-cell table:style-name="CellBox"/>
        </table:table-row>
        <table:table-row table:style-name="SpecialRow">
          <table:table-cell table:style-name="CellBox">
            <text:p text:style-name="Cell">대학이 승인한 특별 교육</text:p>
            <text:p text:style-name="Cell">프로그램</text:p>
            <text:p text:style-name="Cell">*ABICS 프로그램 등 포함</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="CellBox"/>
          <table:table-cell table:style-name="CellBox"><text:p text:style-name="Cell">( <text:s text:c="1"/>학점 / 3학점)</text:p></table:table-cell>
          <table:table-cell table:style-name="CellBox"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Lead"><text:s text:c="1"/></text:p>
      <text:p text:style-name="CellLeft">위 본인은 추계예술대학교 학습경험 학점인정에 관한 규정에 따라 학습경험 학점인정을 신청합니다.</text:p>
      <text:p text:style-name="CellLeft">제출한 증빙자료는 모두 사실이며, 만약 사실과 다르면 학습경험 학점인정 취소 등을 포함한 모든 불이익을</text:p>
      <text:p text:style-name="CellLeft">감수할 것을 서약합니다.</text:p>
      <text:p text:style-name="Lead"><text:s text:c="1"/></text:p>
      <text:p text:style-name="CellLeft">붙임  인정대상별 증빙자료 각 1부.</text:p>
      <text:p text:style-name="Lead"><text:s text:c="1"/></text:p>
      <text:p text:style-name="Cell">20<text:s text:c="4"/>년<text:s text:c="4"/>월<text:s text:c="4"/>일</text:p>
      <text:p text:style-name="Lead"><text:s text:c="1"/></text:p>
      <text:p text:style-name="Cell">신청인 성명<text:s text:c="6"/>(서명 또는 날인)</text:p>
      <text:p text:style-name="Lead"><text:s text:c="1"/></text:p>
      <text:p text:style-name="CellLeft"><text:span text:style-name="Bold">추계예술대학교 총장 귀하</text:span></text:p>
    </office:text>
  </office:body>
</office:document>