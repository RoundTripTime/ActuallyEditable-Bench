<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.2cm" fo:margin-bottom="1.0cm"/>
      <style:text-properties fo:font-size="19pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.7cm" fo:margin-bottom="0.1cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="SmallCenter" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="BoldCenter" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="11pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="17cm" table:align="left" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="C1" style:family="table-column">
      <style:table-column-properties style:column-width="2.2cm"/>
    </style:style>
    <style:style style:name="C2" style:family="table-column">
      <style:table-column-properties style:column-width="4.1cm"/>
    </style:style>
    <style:style style:name="C3" style:family="table-column">
      <style:table-column-properties style:column-width="2.2cm"/>
    </style:style>
    <style:style style:name="C4" style:family="table-column">
      <style:table-column-properties style:column-width="4.1cm"/>
    </style:style>
    <style:style style:name="C5" style:family="table-column">
      <style:table-column-properties style:column-width="2.2cm"/>
    </style:style>
    <style:style style:name="C6" style:family="table-column">
      <style:table-column-properties style:column-width="2.2cm"/>
    </style:style>
    <style:style style:name="D1" style:family="table-column">
      <style:table-column-properties style:column-width="4.8cm"/>
    </style:style>
    <style:style style:name="D2" style:family="table-column">
      <style:table-column-properties style:column-width="3.2cm"/>
    </style:style>
    <style:style style:name="D3" style:family="table-column">
      <style:table-column-properties style:column-width="5.7cm"/>
    </style:style>
    <style:style style:name="D4" style:family="table-column">
      <style:table-column-properties style:column-width="3.3cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="ShortRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.95cm"/>
    </style:style>
    <style:style style:name="HeaderRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.15cm"/>
    </style:style>
    <style:style style:name="CategoryRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.35cm"/>
    </style:style>
    <style:style style:name="LongRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.45cm"/>
    </style:style>
    <style:style style:name="PageLayout" style:family="paragraph"/>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PL1">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-top="2.8cm" fo:margin-bottom="2cm" fo:margin-left="1.8cm" fo:margin-right="1.8cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PL1"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="P">[별지 제1호 서식]</text:p>
      <text:p text:style-name="Title">학습경험 학점인정 신청서</text:p>
      <text:p text:style-name="Section">1. 신청인</text:p>
      <table:table table:name="신청인" table:style-name="FormTable">
        <table:table-column table:style-name="C1"/>
        <table:table-column table:style-name="C2"/>
        <table:table-column table:style-name="C3"/>
        <table:table-column table:style-name="C4"/>
        <table:table-column table:style-name="C5"/>
        <table:table-column table:style-name="C6"/>
        <table:table-row table:style-name="ShortRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">대학</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">학과</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">학번</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="ShortRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">학년</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">성명</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">연락처</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Section">2. 신청 대상 및 학점</text:p>
      <table:table table:name="신청 대상 및 학점" table:style-name="FormTable">
        <table:table-column table:style-name="D1"/>
        <table:table-column table:style-name="D2"/>
        <table:table-column table:style-name="D3"/>
        <table:table-column table:style-name="D4"/>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">인정 대상</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">신청 여부</text:p><text:p text:style-name="Center">(해당 사항 체크)</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">신청학점</text:p><text:p text:style-name="Center">(신청학점 기재 / 최대학점)</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">이수 구분</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="CategoryRow">
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2"><text:p text:style-name="Center">국내·외 타 대학 및 기관학습·연구·실습</text:p><text:p text:style-name="Center">*대학 간 학점교류 포함</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">2023학번 이전</text:p><text:p text:style-name="Center">(　　학점 / 26학점)</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2"/>
        </table:table-row>
        <table:table-row table:style-name="CategoryRow">
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">2024학번 이후</text:p><text:p text:style-name="Center">(　　학점 / 24학점)</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="LongRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">지정된 외부 기관 온라인 교육</text:p><text:p text:style-name="Center">(K-MOOC)</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">(　　학점 / 4학점)</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="LongRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">대학이 승인한 특별 교육 프로그램</text:p><text:p text:style-name="Center">* ABICS 프로그램 등 포함</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">(　　학점 / 3학점)</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="P">　위 본인은 추계예술대학교 학습경험 학점인정에 관한 규정에 따라 학습경험 학점인정을 신청합니다.</text:p>
      <text:p text:style-name="P">제출한 증빙자료는 모두 사실이며, 만약 사실과 다르면 학습경험 학점인정 취소 등을 포함한 모든 불이익을</text:p>
      <text:p text:style-name="P">감수할 것을 서약합니다.</text:p>
      <text:p text:style-name="P"/>
      <text:p text:style-name="P">붙임　인정대상별 증빙자료 각 1부.</text:p>
      <text:p text:style-name="P"/>
      <text:p text:style-name="Center">20　　년　　월　　일</text:p>
      <text:p text:style-name="P"/>
      <text:p text:style-name="Center">신청인 성명　　　　　　　　　(서명 또는 날인)</text:p>
      <text:p text:style-name="P"/>
      <text:p text:style-name="BoldCenter">추계예술대학교 총장 귀하</text:p>
    </office:text>
  </office:body>
</office:document>