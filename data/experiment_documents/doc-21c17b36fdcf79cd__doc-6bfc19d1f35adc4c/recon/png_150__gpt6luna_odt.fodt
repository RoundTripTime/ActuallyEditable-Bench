<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.08cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:text-align="center" fo:margin-top="1.35cm" fo:margin-bottom="1.1cm"/>
      <style:text-properties fo:font-size="17pt"/>
    </style:style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.08cm" fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0cm" fo:margin-bottom="0.25cm"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.4cm" fo:margin-bottom="0.1cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Cell" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="Footer" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="2.1cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="8.5pt"/>
    </style:style>
    <style:style style:name="InputCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" fo:background-color="#fffde0" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="GridCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="PlainCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties table:align="center" style:width="16.35cm"/>
    </style:style>
    <style:style style:name="SmallTable" style:family="table">
      <style:table-properties table:align="right" style:width="12.1cm"/>
    </style:style>
    <style:style style:name="ColLabel" style:family="table-column">
      <style:table-column-properties style:column-width="2.1cm"/>
    </style:style>
    <style:style style:name="ColNarrow" style:family="table-column">
      <style:table-column-properties style:column-width="0.95cm"/>
    </style:style>
    <style:style style:name="ColSigLabel" style:family="table-column">
      <style:table-column-properties style:column-width="4.1cm"/>
    </style:style>
    <style:style style:name="ColSigInput" style:family="table-column">
      <style:table-column-properties style:column-width="6.6cm"/>
    </style:style>
    <style:style style:name="ColExpense1" style:family="table-column">
      <style:table-column-properties style:column-width="2.0cm"/>
    </style:style>
    <style:style style:name="ColExpense2" style:family="table-column">
      <style:table-column-properties style:column-width="2.3cm"/>
    </style:style>
    <style:style style:name="ColExpense3" style:family="table-column">
      <style:table-column-properties style:column-width="3.65cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout" style:page-usage="all">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-top="1.7cm" fo:margin-bottom="1.5cm" fo:margin-left="2.4cm" fo:margin-right="2.4cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="DefaultPage" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">ふるさと教室実施報告および補助金交付申請書</text:p>
      <text:p text:style-name="Right">令 和　年　月　日</text:p>
      <text:p text:style-name="Body">飯綱町青少年育成町民会議会長　様</text:p>
      <table:table table:name="署名欄" table:style-name="SmallTable">
        <table:table-column table:style-name="ColSigLabel"/>
        <table:table-column table:style-name="ColSigInput"/>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="Cell">子ども会・育成会名</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="Cell">代表者</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="Cell">㊞</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body">下記のとおりふるさと教室事業実施しましたので、補助金の交付を申請します。</text:p>
      <text:p text:style-name="Section">1.　実施した事業の概要</text:p>
      <table:table table:name="事業概要" table:style-name="FormTable">
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="Cell">実施内容</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="15" table:style-name="InputCell"/>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="Cell">実施期日</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="GridCell"><text:p text:style-name="CellCenter">令和</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="InputCell"/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">年</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">月</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">日</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">～</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="GridCell"><text:p text:style-name="CellCenter">令和</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="InputCell"/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">年</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">月</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="Cell">実施場所</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="15" table:style-name="InputCell"/>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="Cell">共催団体</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="15" table:style-name="InputCell"/>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:number-rows-spanned="2" table:style-name="GridCell"><text:p text:style-name="Cell">参　加　者</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="GridCell"><text:p text:style-name="CellCenter">子ども</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="GridCell"><text:p text:style-name="CellCenter">保護者</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="GridCell"><text:p text:style-name="CellCenter">育成会</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="GridCell"><text:p text:style-name="CellCenter">高齢者</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="7" table:style-name="GridCell"><text:p text:style-name="CellCenter">その他</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="InputCell"/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">人</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">人</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">人</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">人</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="InputCell"/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">人</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">（</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">）</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Section">2.　事業に伴う経費</text:p>
      <table:table table:name="事業経費" table:style-name="FormTable">
        <table:table-column table:style-name="ColExpense1"/>
        <table:table-column table:style-name="ColExpense2"/>
        <table:table-column table:style-name="ColExpense3"/>
        <table:table-column table:style-name="ColExpense1"/>
        <table:table-column table:style-name="ColExpense2"/>
        <table:table-column table:style-name="ColExpense3"/>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">区　分</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">金　額</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">説　明</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">区　分</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">金　額</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">説　明</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="Cell">講師謝礼</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
          <table:table-cell table:style-name="InputCell"/>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="InputCell"/>
          <table:table-cell table:style-name="InputCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="Cell">材　料　費</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
          <table:table-cell table:style-name="InputCell"/>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="InputCell"/>
          <table:table-cell table:style-name="InputCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="Cell">食　糧　費</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
          <table:table-cell table:style-name="InputCell"/>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="InputCell"/>
          <table:table-cell table:style-name="InputCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Right">※ 経費の合計金額　　円</text:p>
      <text:p text:style-name="Right">■　上 限 額　＝　6,000　円</text:p>
      <text:p text:style-name="Section">3.　補助金交付申請額</text:p>
      <text:p text:style-name="Body">　　　　　　　　　　　　　　　円　　事業に伴う経費の合計金額と</text:p>
      <text:p text:style-name="Body">　　　　　　　　　　　　　　　　　　 6,000円(上限額)との少ない方の額</text:p>
      <text:p text:style-name="Section">4.　添付書類</text:p>
      <text:p text:style-name="Body">　　① 領収書(写)　　②開催通知等事業の実施がわかるもの</text:p>
      <text:p text:style-name="Body">　　③ 写真３枚程度（子どもと講師(高齢者)の活動の様子・作成したもの）</text:p>
      <text:p text:style-name="Footer">ふるさと教室事業補助金実施報告および交付申請書 230310</text:p>
    </office:text>
  </office:body>
</office:document>