<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:default-style>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="Centered" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="BreakPage" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="Table" style:family="table">
      <style:table-properties style:width="17cm" table:align="left" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ColLabel" style:family="table-column">
      <style:table-column-properties style:column-width="7.4cm"/>
    </style:style>
    <style:style style:name="ColAmount" style:family="table-column">
      <style:table-column-properties style:column-width="9.6cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center" fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="CellRight" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="right" fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="CellDotted" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:border-bottom="0.5pt dotted #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="AccountTable" style:family="table">
      <style:table-properties style:width="17cm" table:align="left" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="AccCol1" style:family="table-column">
      <style:table-column-properties style:column-width="4cm"/>
    </style:style>
    <style:style style:name="AccCol2" style:family="table-column">
      <style:table-column-properties style:column-width="4cm"/>
    </style:style>
    <style:style style:name="AccCol3" style:family="table-column">
      <style:table-column-properties style:column-width="2.9cm"/>
    </style:style>
    <style:style style:name="AccColN" style:family="table-column">
      <style:table-column-properties style:column-width="0.87cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="P">別記第１号様式（第６条関係）</text:p>
      <text:p text:style-name="Centered">浦幌町防災士資格取得費用補助金交付申請書</text:p>
      <text:p text:style-name="Right">年　　　月　　　日</text:p>
      <text:p text:style-name="P">　浦幌町長　　　　　　　　様</text:p>
      <text:p text:style-name="P">申請者　住　　所　十勝郡浦幌町字</text:p>
      <text:p text:style-name="P">　　　　氏　　名</text:p>
      <text:p text:style-name="P">　　　　電話番号</text:p>
      <text:p text:style-name="P">　浦幌町防災士資格取得費用補助金の交付を受けたいので、浦幌町防災士資格取得費用補<text:line-break/>助金交付要綱第６条の規定により、「３　同意事項」に同意のうえ、関係書類を添えて申<text:line-break/>請します。</text:p>
      <text:p text:style-name="Centered">記</text:p>
      <text:p text:style-name="P">１　補助金申請額　　　　　　　　　　　　　　　　　　　　　　円</text:p>
      <text:p text:style-name="P">　　内訳</text:p>
      <table:table table:name="Breakdown" table:style-name="Table">
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColAmount"/>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter"><text:p>防災士研修講座受講料</text:p></table:table-cell>
          <table:table-cell table:style-name="CellRight"><text:p>円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter"><text:p>防災資格取得試験受験料</text:p></table:table-cell>
          <table:table-cell table:style-name="CellRight"><text:p>円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter"><text:p>防災士認証登録料</text:p></table:table-cell>
          <table:table-cell table:style-name="CellRight"><text:p>円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter"><text:p>旅　　　費</text:p></table:table-cell>
          <table:table-cell table:style-name="CellRight"><text:p>円</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="P">２　防災士研修講座</text:p>
      <table:table table:name="Training" table:style-name="Table">
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColAmount"/>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter"><text:p>受　講　コ　ー　ス</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter"><text:p>研　修　機　関　名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter"><text:p>受　講　期　間</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>年　　月　　日～　　　　年　　月　　日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter"><text:p>受　講　会　場</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="P">３　同意事項</text:p>
      <table:table table:name="Consent" table:style-name="Table">
        <table:table-column table:style-name="ColAmount"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>　申請者及び同一世帯に属する者全員の町税等の納入状況及び住民登録状況等につ<text:line-break/>いて、調査、確認することに同意します。</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="P">４　振込口座（以下のいずれかにチェックし、必要に応じ口座番号等を記入してくださ<text:line-break/>い。）</text:p>
      <text:p text:style-name="P">□　役場に登録済みの口座を希望</text:p>
      <text:p text:style-name="P">□　その他の口座を希望（以下に口座番号等を記入してください。）</text:p>
      <table:table table:name="BankAccount" table:style-name="AccountTable">
        <table:table-column table:style-name="AccCol1"/>
        <table:table-column table:style-name="AccCol2"/>
        <table:table-column table:style-name="AccCol3"/>
        <table:table-column table:style-name="AccColN"/>
        <table:table-column table:style-name="AccColN"/>
        <table:table-column table:style-name="AccColN"/>
        <table:table-column table:style-name="AccColN"/>
        <table:table-column table:style-name="AccColN"/>
        <table:table-column table:style-name="AccColN"/>
        <table:table-column table:style-name="AccColN"/>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter"><text:p>金融機関名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p/></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellCenter" table:number-columns-spanned="3"><text:p>支店名</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter"><text:p>預金種別</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>普通・当座</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>口座番号</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellDotted"><text:p>フリガナ</text:p></table:table-cell>
          <table:table-cell table:style-name="CellDotted" table:number-columns-spanned="9"><text:p/></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter"><text:p>口座名義人</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="9"><text:p/></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="BreakPage">５　添付書類　　誓約書（第２号様式）</text:p>
    </office:text>
  </office:body>
</office:document>