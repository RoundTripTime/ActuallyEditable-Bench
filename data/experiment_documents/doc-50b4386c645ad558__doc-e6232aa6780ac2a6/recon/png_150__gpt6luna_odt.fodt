<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
 xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
 office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
 <office:styles>
  <style:style style:name="P" style:family="paragraph">
   <style:paragraph-properties fo:margin-top="0.04in" fo:margin-bottom="0.04in"/>
   <style:text-properties fo:font-size="10pt" style:font-size-asian="10pt"/>
  </style:style>
  <style:style style:name="Title" style:family="paragraph">
   <style:paragraph-properties fo:text-align="center" fo:margin-bottom="0.16in"/>
   <style:text-properties fo:font-size="18pt" style:font-size-asian="18pt" fo:font-weight="bold"/>
  </style:style>
  <style:style style:name="PageStart" style:family="paragraph">
   <style:paragraph-properties fo:break-before="page" fo:margin-top="0in" fo:margin-bottom="0.06in"/>
   <style:text-properties fo:font-size="10pt" style:font-size-asian="10pt"/>
  </style:style>
  <style:style style:name="Small" style:family="paragraph">
   <style:paragraph-properties fo:margin-top="0.02in" fo:margin-bottom="0.02in"/>
   <style:text-properties fo:font-size="8pt" style:font-size-asian="8pt"/>
  </style:style>
  <style:style style:name="Center" style:family="paragraph">
   <style:paragraph-properties fo:text-align="center" fo:margin-top="0.02in" fo:margin-bottom="0.02in"/>
   <style:text-properties fo:font-size="10pt" style:font-size-asian="10pt"/>
  </style:style>
  <style:style style:name="T" style:family="table">
   <style:table-properties table:align="center" style:width="7.1in" table:border-model="collapsing"/>
  </style:style>
  <style:style style:name="C" style:family="table-cell">
   <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0.04in" style:vertical-align="middle"/>
   <style:text-properties fo:font-size="9pt" style:font-size-asian="9pt"/>
  </style:style>
  <style:style style:name="Label" style:family="table-cell">
   <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0.05in" fo:background-color="#D9D9D9" style:vertical-align="middle"/>
   <style:text-properties fo:font-size="9pt" style:font-size-asian="9pt"/>
  </style:style>
  <style:style style:name="Box" style:family="table-cell">
   <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0.02in" style:vertical-align="middle"/>
  </style:style>
  <style:style style:name="Shade" style:family="table-cell">
   <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0.03in" fo:background-color="#D9D9D9" style:vertical-align="middle"/>
  </style:style>
  <style:style style:name="Col" style:family="table-column">
   <style:table-column-properties style:column-width="0.44375in"/>
  </style:style>
  <style:style style:name="WideCol" style:family="table-column">
   <style:table-column-properties style:column-width="1.0in"/>
  </style:style>
 </office:styles>
 <office:automatic-styles>
  <style:page-layout style:name="PageLayout">
   <style:page-layout-properties fo:page-width="8.27in" fo:page-height="11.69in" fo:margin-top="0.55in" fo:margin-bottom="0.55in" fo:margin-left="0.55in" fo:margin-right="0.55in" style:print-orientation="portrait"/>
  </style:page-layout>
 </office:automatic-styles>
 <office:master-styles>
  <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
 </office:master-styles>
 <office:body>
  <office:text>
   <text:p text:style-name="PageStart"/>
   <text:p text:style-name="Title">寄附申出書</text:p>
   <text:p text:style-name="P">世田谷区長あて</text:p>
   <text:p text:style-name="P">以下のとおり、寄附いたします。</text:p>
   <text:p text:style-name="P">寄附申出日　　　　年　　　月　　　日</text:p>
   <text:p text:style-name="P">１．　寄附者</text:p>
   <table:table table:name="寄附者" table:style-name="T">
    <table:table-column table:style-name="WideCol"/>
    <table:table-column table:style-name="Col" table:number-columns-repeated="8"/>
    <table:table-row>
     <table:table-cell table:style-name="Label"><text:p>フリガナ※</text:p></table:table-cell>
     <table:table-cell table:style-name="C" table:number-columns-spanned="8"><text:p/></table:table-cell>
     <table:covered-table-cell table:number-columns-repeated="7"/>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Label"><text:p>漢字氏名</text:p></table:table-cell>
     <table:table-cell table:style-name="C" table:number-columns-spanned="8"><text:p/></table:table-cell>
     <table:covered-table-cell table:number-columns-repeated="7"/>
    </table:table-row>
   </table:table>
   <table:table table:name="郵便番号" table:style-name="T">
    <table:table-column table:style-name="WideCol"/>
    <table:table-column table:style-name="Col" table:number-columns-repeated="8"/>
    <table:table-row>
     <table:table-cell table:style-name="Label"><text:p>郵便番号</text:p></table:table-cell>
     <table:table-cell table:style-name="Box"><text:p/></table:table-cell>
     <table:table-cell table:style-name="Box"><text:p/></table:table-cell>
     <table:table-cell table:style-name="Box"><text:p/></table:table-cell>
     <table:table-cell table:style-name="Box"><text:p>―</text:p></table:table-cell>
     <table:table-cell table:style-name="Box"><text:p/></table:table-cell>
     <table:table-cell table:style-name="Box"><text:p/></table:table-cell>
     <table:table-cell table:style-name="Box"><text:p/></table:table-cell>
     <table:table-cell table:style-name="Box"><text:p/></table:table-cell>
     <table:table-cell table:style-name="Shade" table:number-columns-spanned="1"><text:p/></table:table-cell>
    </table:table-row>
   </table:table>
   <table:table table:name="住所" table:style-name="T">
    <table:table-column table:style-name="WideCol"/>
    <table:table-column table:style-name="Col" table:number-columns-repeated="8"/>
    <table:table-row>
     <table:table-cell table:style-name="Label"><text:p>住所</text:p></table:table-cell>
     <table:table-cell table:style-name="C" table:number-columns-spanned="8"><text:p text:style-name="Center">都　道</text:p><text:p text:style-name="Center">府　県</text:p></table:table-cell>
     <table:covered-table-cell table:number-columns-repeated="7"/>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Label"><text:p/></table:table-cell>
     <table:table-cell table:style-name="C" table:number-columns-spanned="8"><text:p/></table:table-cell>
     <table:covered-table-cell table:number-columns-repeated="7"/>
    </table:table-row>
   </table:table>
   <table:table table:name="電話番号" table:style-name="T">
    <table:table-column table:style-name="WideCol"/>
    <table:table-column table:style-name="Col" table:number-columns-repeated="13"/>
    <table:table-row>
     <table:table-cell table:style-name="Label"><text:p>電話番号</text:p><text:p>(ハイフンあり)</text:p></table:table-cell>
     <table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="Small">※住所に建物名や方書がある場合は、そちらもご記入ください。</text:p>
   <text:p text:style-name="P">２．　寄附金支払い方法（いずれかに✔をつけてください）</text:p>
   <text:p text:style-name="P">　□　郵便振替　　　　　　　　　□　銀行振込　　　　　　　　　　　　□現金持参</text:p>
   <text:p text:style-name="Small">　（ふるさと納税サポート室から用紙をお送りします）　　　（以下振込先口座へお振込ください）</text:p>
   <text:p text:style-name="P">　　　　　　　　　　　　　　　世田谷区寄附金受入口座（セタガヤクキフキンウケイレコウザ）</text:p>
   <text:p text:style-name="P">　　　　　　　　　　　　　　　みずほ銀行　世田谷支店　普通　1516694</text:p>
   <text:p text:style-name="P">３．　氏名・寄附金額の区広報紙やホームページ等での公表の可否（いずれかに✔をつけてください）</text:p>
   <text:p text:style-name="P">　□　氏名・金額ともに可　　□　氏名のみ可　　□　金額のみ可　　□　氏名・金額ともに不可</text:p>
   <text:p text:style-name="P">４．　ワンストップ特例申請書の要否※</text:p>
   <text:p text:style-name="P">　□　必要　　　　　　　　　□　不要　　　　　※確定申告をされる方や法人・団体の方は“不要”をお選びください。</text:p>
   <text:p text:style-name="Center">アンケートにご協力お願いします</text:p>
   <text:p text:style-name="P">●世田谷区へのご寄附のきっかけを教えてください（✔を入れてください）</text:p>
   <text:p text:style-name="P">　□　ふるさとまたはゆかりのある自治体だから　　□　寄附金の使い道に共感したから</text:p>
   <text:p text:style-name="P">　□　節税対策になるから　　□　返礼品が魅力的だったから　　□　その他（　　　　　　　　　）</text:p>
   <text:p text:style-name="P">●世田谷区のふるさと納税の取組みを何でお知りになりましたか（✔を入れてください）</text:p>
   <text:p text:style-name="P">　□　区のホームページ　　□　区のおしらせ　　□　ポータルサイト（ふるさとチョイス、さとふる等）</text:p>
   <text:p text:style-name="P">　□　ちらし・ポスター　　□　テレビや新聞、雑誌　　□　家族・知人などの紹介　　□　その他</text:p>
   <text:p text:style-name="P">●あなたの年代を教えてください（✔をいれてください）</text:p>
   <text:p text:style-name="PageStart">□　20 代以下　 □　30 代　 □　40 代　 □　50 代　 □　60 代　 □　70 代　 □　80 代以上　 □　無回答</text:p>
   <text:p text:style-name="Center">ありがとうございました</text:p>
   <text:p text:style-name="P">５－１．希望使途及び寄附金額</text:p>
   <text:p text:style-name="P">（ご希望の使い道（P2～P3）に金額をご記入ください（複数選択可）。</text:p>
   <table:table table:name="使途希望及び金額" table:style-name="T">
    <table:table-column table:style-name="Col" table:number-columns-repeated="16"/>
    <table:table-row><table:table-cell table:style-name="Shade" table:number-columns-spanned="16"><text:p>【医療・福祉】</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="15"/></table:table-row>
    <table:table-row><table:table-cell table:style-name="Label" table:number-columns-spanned="8"><text:p>地域保健福祉等推進基金【福祉のために】</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/><table:table-cell table:style-name="Label" table:number-columns-spanned="8"><text:p>医療的ケア児の笑顔を支える基金</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/></table:table-row>
    <table:table-row><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p>円</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p>円</text:p></table:table-cell></table:table-row>
    <table:table-row><table:table-cell table:style-name="Label" table:number-columns-spanned="8"><text:p>地域保健福祉等推進基金【市民活動のために】</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/><table:table-cell table:style-name="Label" table:number-columns-spanned="8"><text:p>児童養護施設退所者等奨学・自立支援基金</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/></table:table-row>
    <table:table-row><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p>円</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p>円</text:p></table:table-cell></table:table-row>
    <table:table-row><table:table-cell table:style-name="Label" table:number-columns-spanned="8"><text:p>犯罪被害者等支援基金</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/><table:table-cell table:style-name="Label" table:number-columns-spanned="8"><text:p>せたがや　動物とともにいきるまちプロジェクト</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/></table:table-row>
    <table:table-row><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p>円</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p>円</text:p></table:table-cell></table:table-row>
    <table:table-row><table:table-cell table:style-name="Shade" table:number-columns-spanned="16"><text:p>【子ども・子育て】</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="15"/></table:table-row>
    <table:table-row><table:table-cell table:style-name="Label" table:number-columns-spanned="8"><text:p>子ども・若者基金【外遊びの場と機会の充実のために】</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/><table:table-cell table:style-name="Label" table:number-columns-spanned="8"><text:p>児童館の整備のために（奥沢地区児童館）</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/></table:table-row>
    <table:table-row><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p>円</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p/></table:table-cell><table:table-cell table:style-name="Box"><text:p>円</text:p></table:table-cell></table:table-row>
    <table:table-row><table:table-cell table:style-name="Label" table:number-columns-spanned="8"><text:p>子ども・若者基金【子どもの学びの支援のために】</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/><table:table-cell table:style-name="Label" table:number-columns-spanned="8"><text:p>児童館の整備のために（九品仏地区児童館・保育園複合施設）</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/></table:table-row>
