<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="1mm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:default-style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0mm" fo:margin-bottom="0mm"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-bottom="4mm"/>
      <style:text-properties fo:font-size="18pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
    <style:style style:name="GridTable" style:family="table">
      <style:table-properties style:width="100%" table:align="center"/>
    </style:style>
    <style:style style:name="GridCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="1mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="ShadeCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="1mm" fo:background-color="#d9d9d9" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="InputCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="1mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="ThinCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.5mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="C1" style:family="table-column">
      <style:table-column-properties style:column-width="25mm"/>
    </style:style>
    <style:style style:name="C2" style:family="table-column">
      <style:table-column-properties style:column-width="12mm"/>
    </style:style>
    <style:style style:name="C3" style:family="table-column">
      <style:table-column-properties style:column-width="20mm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PL1">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" fo:print-orientation="portrait" fo:margin-top="12mm" fo:margin-bottom="12mm" fo:margin-left="14mm" fo:margin-right="14mm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PL1"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="Title">寄附申出書</text:p>
      <text:p>世田谷区長あて</text:p>
      <text:p>　以下のとおり、寄附いたします。<text:s text:c="20"/>寄附申出日　　　年　　　月　　　日</text:p>
      <text:p>　　１．　　　寄附者</text:p>
      <table:table table:style-name="GridTable">
        <table:table-column table:style-name="C1"/>
        <table:table-column table:number-columns-repeated="12" table:style-name="C2"/>
        <table:table-row>
          <table:table-cell table:style-name="ShadeCell"><text:p>フリガナ※</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="12" table:style-name="InputCell"><text:p/></table:table-cell>
          <table:covered-table-cell table:number-columns-repeated="11"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ShadeCell"><text:p>漢字氏名</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="12" table:style-name="InputCell"><text:p/></table:table-cell>
          <table:covered-table-cell table:number-columns-repeated="11"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ShadeCell"><text:p>郵便番号</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p/></table:table-cell><table:table-cell table:style-name="InputCell"><text:p/></table:table-cell><table:table-cell table:style-name="InputCell"><text:p/></table:table-cell><table:table-cell table:style-name="InputCell"><text:p>―</text:p></table:table-cell><table:table-cell table:style-name="InputCell"><text:p/></table:table-cell><table:table-cell table:style-name="InputCell"><text:p/></table:table-cell><table:table-cell table:style-name="InputCell"><text:p/></table:table-cell><table:table-cell table:style-name="InputCell"><text:p/></table:table-cell>
          <table:table-cell table:number-columns-spanned="4" table:style-name="ShadeCell"><text:p/></table:table-cell><table:covered-table-cell table:number-columns-repeated="3"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ShadeCell"><text:p>住所</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="12" table:style-name="InputCell"><text:p>　　　　　　　　　　　都　道</text:p><text:p>　　　　　　　　　　　府　県</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="11"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ShadeCell"><text:p/></table:table-cell><table:table-cell table:number-columns-spanned="12" table:style-name="InputCell"><text:p/></table:table-cell><table:covered-table-cell table:number-columns-repeated="11"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ShadeCell"><text:p>電話番号</text:p><text:p>(ハイフンあり)</text:p></table:table-cell>
          <table:table-cell table:number-columns-repeated="12" table:style-name="InputCell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p>※住所に建物名や方書がある場合は、そちらもご記入ください。</text:p>
      <text:p>　２．　　　寄附金支払い方法（いずれかに✔をつけてください）</text:p>
      <text:p>　　　　　□　郵便振替　　　　　　　　　□　銀行振込　　　　　　　　　　　□現金持参</text:p>
      <text:p>　　　　　　　（ふるさと納税サポート室から　　　　（以下振込先口座へお振込ください）</text:p>
      <text:p>　　　　　　　用紙をお送りします）</text:p>
      <table:table table:style-name="GridTable">
        <table:table-column table:style-name="C3"/>
        <table:table-column table:number-columns-repeated="6" table:style-name="C3"/>
        <table:table-row><table:table-cell table:number-columns-spanned="7" table:style-name="InputCell"><text:p>世田谷区寄附金受入口座（セタガヤクキフキンウケイレコウザ）</text:p><text:p>みずほ銀行　世田谷支店　普通　1516694</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="6"/></table:table-row>
      </table:table>
      <text:p>　３．　　　氏名・寄附金額の区広報紙やホームページ等での公表の可否（いずれかに✔をつけてください）</text:p>
      <text:p>　　　□　氏名・金額ともに可　　□　氏名のみ可　　□　金額のみ可　　□　氏名・金額ともに不可</text:p>
      <text:p>　４．　　　ワンストップ特例申請書の要否※</text:p>
      <text:p>　　　□　必要　　　　　　　　　□　不要　　　　　　　　　※確定申告をされる方や法人・団体の方は</text:p>
      <text:p>　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　“不要”をお選びください。</text:p>
      <text:p text:style-name="Center">アンケートにご協力お願いします</text:p>
      <text:p>●世田谷区へのご寄附のきっかけを教えてください（✔を入れてください）</text:p>
      <text:p>　□　ふるさとまたはゆかりのある自治体だから　　□　寄附金の使い道に共感したから</text:p>
      <text:p>　□　節税対策になるから　　□　返礼品が魅力的だったから　　□　その他（　　　　　　　　　　　　）</text:p>
      <text:p>●世田谷区のふるさと納税の取組みを何でお知りになりましたか（✔を入れてください）</text:p>
      <text:p>　□　区のホームページ　　□　区のおしらせ　　□　ポータルサイト（ふるさとチョイス、さとふる等）</text:p>
      <text:p>　□　ちらし・ポスター　　□　テレビや新聞、雑誌　　□　家族・知人などの紹介　　□　その他</text:p>
      <text:p>●あなたの年代を教えてください（✔をいれてください）</text:p>
      <text:p text:style-name="Center">1</text:p>

      <text:p text:style-name="PageStart"/>
      <text:p>□　20代以下　□　30代　□　40代　□　50代　□　60代　□　70代　□　80代以上　□　無回答</text:p>
      <text:p text:style-name="Center">ありがとうございました</text:p>
      <text:p>５－１．希望使途及び寄附金額</text:p>
      <text:p>（ご希望の使い道（P2～P3）に金額をご記入ください（複数選択可））。</text:p>
      <text:p>【医療・福祉】</text:p>
      <table:table table:style-name="GridTable">
        <table:table-column table:number-columns-repeated="18" table:style-name="C2"/>
        <table:table-row><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>地域保健福祉等推進基金【福祉のために】</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>医療的ケア児の笑顔を支える基金</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-cell><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>地域保健福祉等推進基金【市民活動のために】</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>児童養護施設退所者等奨学・自立支援基金</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-cell><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>犯罪被害者等支援等基金</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>せたがや　動物とともにいきるまちプロジェクト</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-cell><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p/></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p/></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/></table:table-row>
      </table:table>
      <text:p>【子ども・子育て】</text:p>
      <table:table table:style-name="GridTable">
        <table:table-column table:number-columns-repeated="18" table:style-name="C2"/>
        <table:table-row><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>子ども・若者基金【外遊びの場と機会の充実のために】</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>児童館の整備のために（奥沢地区児童館）</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-cell><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>子ども・若者基金【子どもの学びの支援のために】</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>児童館の整備のために（九品仏地区児童館・保育園複合施設）</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-cell><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>子ども・若者基金【子どもを育む地域活動支援のために】</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>船橋児童館　陶芸活動再開応援プロジェクト</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-cell><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>子ども・若者基金【多様な子ども・若者の活動を支えるために】</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>喜多見児童館　陶芸窯応援プロジェクト</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-cell><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>子ども・若者基金【子ども・子育て支援のために】</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p/></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-cell><table:table-cell table:number-columns-repeated="8" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-row>
      </table:table>
      <text:p>【文化・国際・教育・スポーツ】</text:p>
      <table:table table:style-name="GridTable"><table:table-column table:number-columns-repeated="18" table:style-name="C2"/>
        <table:table-row><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>世田谷遊びと学びの教育基金</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>国際平和交流基金</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-cell><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>文化振興基金</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>スポーツ推進基金</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-cell><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-row>
      </table:table>
      <text:p text:style-name="Center">2</text:p>

      <text:p text:style-name="PageStart"/>
      <text:p>【みどり・環境】</text:p>
      <table:table table:style-name="GridTable"><table:table-column table:number-columns-repeated="18" table:style-name="C2"/>
        <table:table-row><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>みどりのトラスト基金【みどりを守るために】</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>みどりのトラスト基金【寄附ベンチ】</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-cell><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>みどりのトラスト基金【羽根木公園の梅林を守るために】</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>みどりのトラスト基金【世田谷の樹林地を育もう！】</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-cell><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>等々力渓谷などの崖線樹林地保全</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p/></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-cell><table:table-cell table:number-columns-repeated="8" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-row>
      </table:table>
      <text:p>【その他】</text:p>
      <table:table table:style-name="GridTable"><table:table-column table:number-columns-repeated="18" table:style-name="C2"/>
        <table:table-row><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>災害対策基金</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>交通不便地域解消プロジェクト</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-cell><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>世田谷区本庁舎等整備プロジェクト</text:p><text:p>※個人の方は３万円以上、法人・団体の方は１０万円以上</text:p><text:p>の寄附をいただいた方に「区民会館エントランスホールレリーフ裏</text:p><text:p>銘板」への氏名等掲出希望確認のご案内を送付いたします。</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>旧玉電・江ノ電車両　再塗装プロジェクト</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-cell><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>気候危機対策基金</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/><table:table-cell table:number-columns-spanned="8" table:style-name="ShadeCell"><text:p>区政全般のために</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-cell><table:table-cell table:number-columns-repeated="7" table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>円</text:p></table:table-row>
      </table:table>
      <text:p text:style-name="Center">3</text:p>

      <text:p text:style-name="PageStart"/>
      <text:p>５－２．　区立小・中学校への寄附を希望される方へ</text:p>
      <text:p>　区立小・中学校の施設整備（改築等）事業への寄附を希望される方は、こちらに金額をご記入ください。</text:p>
      <text:p>　①　学校を指定される方は、希望する学校を選択してください。</text:p>
      <text:p>　②　学校を指定されない方は、「義務教育施設整備基金」を選択してください。</text:p>
      <text:p>【学校指定寄附：小学校】　　　　　　　　　　　　　　　　　　　　【学校指定寄附：中学校】</text:p>
      <text:p>※こちらの使い道については、返礼品をお贈りすることはできません。　　※こちらの使い道については、返礼品をお贈りすることはできません。</text:p>
