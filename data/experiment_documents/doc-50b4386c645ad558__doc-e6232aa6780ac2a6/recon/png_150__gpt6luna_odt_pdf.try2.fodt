<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.06cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt" style:font-name="Meiryo"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-bottom="0.2cm"/>
      <style:text-properties fo:font-size="18pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0.15cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Shade" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" fo:background-color="#D9D9D9" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Input" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle" fo:min-height="0.65cm"/>
    </style:style>
    <style:style style:name="NoBorder" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.4cm" fo:margin-bottom="1.2cm" fo:margin-left="1.5cm" fo:margin-right="1.5cm"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="18cm" table:align="center"/>
    </style:style>
    <style:style style:name="WideTable" style:family="table">
      <style:table-properties style:width="18cm" table:align="center"/>
    </style:style>
    <style:style style:name="ColWide" style:family="table-column">
      <style:table-column-properties style:column-width="3cm"/>
    </style:style>
    <style:style style:name="ColNarrow" style:family="table-column">
      <style:table-column-properties style:column-width="0.65cm"/>
    </style:style>
    <style:style style:name="ColHalf" style:family="table-column">
      <style:table-column-properties style:column-width="2.25cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">寄附申出書</text:p>
      <text:p>世田谷区長あて　　　　　　　　　　　　　　　　区ＨＰダウンロード用</text:p>
      <text:p>以下のとおり、寄附いたします。　　　　　　　　　寄附申出日　　　　年　　　　月　　　　日</text:p>
      <text:p>　　１．　　　寄附者</text:p>
      <table:table table:name="寄附者欄" table:style-name="FormTable">
        <table:table-column table:style-name="ColWide"/>
        <table:table-column table:style-name="ColWide"/>
        <table:table-row>
          <table:table-cell table:style-name="Shade"><text:p>フリガナ※</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Shade"><text:p>漢字氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Shade"><text:p>郵便番号</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p>□　□　□　―　□　□　□　□　　　</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Shade"><text:p>住所</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p>　　　　　　　　　都　道　府　県　　　　　　　　　</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Shade"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Shade"><text:p>電話番号<br/>(ハイフンあり)</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p>□　□　□　□　□　□　□　□　□　□　□　□　□</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p>※住所に建物名や方書がある場合は、そちらもご記入ください。</text:p>
      <text:p>　　２．　　　寄附金支払い方法（いずれかに✔をつけてください）</text:p>
      <text:p>□　郵便振替　　　　　　　　　□　銀行振込　　　　　　　　　　　　　□現金持参</text:p>
      <text:p>　（ふるさと納税サポート室から　　（以下振込先口座へお振込ください）</text:p>
      <text:p>　用紙をお送りします）</text:p>
      <text:p>　　　　　　　　　　　　　　　　　世田谷区寄附金受入口座（セタガヤクキフキンウケイレコウザ）</text:p>
      <text:p>　　　　　　　　　　　　　　　　　みずほ銀行　世田谷支店　普通　1516694</text:p>
      <text:p>　　３．　　　氏名・寄附金額の区広報紙やホームページ等での公表の可否（いずれかに✔をつけてください）</text:p>
      <text:p>□　氏名・金額ともに可　　□　氏名のみ可　　□　金額のみ可　　□　氏名・金額ともに不可</text:p>
      <text:p>　　４．　　　ワンストップ特例申請書の要否※</text:p>
      <text:p>□　必要　　　　　　　　　□　不要　　　　　　　　　※確定申告をされる方や法人・団体の方は</text:p>
      <text:p>　　　　　　　　　　　　　　　　　　　　　　　　　　“不要”をお選びください。</text:p>
      <text:p>　　　　　　　　　　　　　アンケートにご協力お願いします</text:p>
      <text:p>●世田谷区へのご寄附のきっかけを教えてください（✔を入れてください）</text:p>
      <text:p>□　ふるさとまたはゆかりのある自治体だから　□　寄附金の使い道に共感したから</text:p>
      <text:p>□　節税対策になるから　　□　返礼品が魅力的だったから　　□　その他（　　　　　　　　　）</text:p>
      <text:p>●世田谷区のふるさと納税の取組みを何でお知りになりましたか（✔を入れてください）</text:p>
      <text:p>□　区のホームページ　　□　区のおしらせ　　□　ポータルサイト（ふるさとチョイス、さとふる等）</text:p>
      <text:p>□　ちらし・ポスター　　□　テレビや新聞、雑誌　　□　家族・知人などの紹介　　□　その他</text:p>
      <text:p>●あなたの年代を教えてください（✔をいれてください）</text:p>
      <text:p text:style-name="Center">1</text:p>
      <text:p text:style-name="Small">２ページ以降もご記入ください</text:p>

      <text:p text:style-name="PageStart">□　20代以下　□　30代　□　40代　□　50代　□　60代　□　70代　□　80代以上　□　無回答</text:p>
      <text:p text:style-name="Center">ありがとうございました</text:p>
      <text:p>５－１．希望使途及び寄附金額</text:p>
      <text:p>（ご希望の使い道（P2～P3）に金額をご記入ください（複数選択可））。</text:p>
      <text:p>【医療・福祉】</text:p>
      <table:table table:name="医療福祉" table:style-name="WideTable">
        <table:table-column table:style-name="ColHalf"/><table:table-column table:style-name="ColHalf"/>
        <table:table-column table:style-name="ColHalf"/><table:table-column table:style-name="ColHalf"/>
        <table:table-column table:style-name="ColHalf"/><table:table-column table:style-name="ColHalf"/>
        <table:table-column table:style-name="ColHalf"/><table:table-column table:style-name="ColHalf"/>
        <table:table-row><table:table-cell table:number-columns-spanned="8" table:style-name="Shade"><text:p>地域保健福祉等推進基金【福祉のために】</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="7" table:style-name="Input"><text:p/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="8" table:style-name="Shade"><text:p>地域保健福祉等推進基金【市民活動のために】</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="7" table:style-name="Input"><text:p/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="8" table:style-name="Shade"><text:p>犯罪被害者等支援基金</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="7" table:style-name="Input"><text:p/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="8" table:style-name="Shade"><text:p>医療的ケア児の笑顔を支える基金</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="7" table:style-name="Input"><text:p/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="8" table:style-name="Shade"><text:p>児童養護施設退所者等奨学・自立支援基金</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="7" table:style-name="Input"><text:p/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>円</text:p></table:table-cell></table:row>
        <table:table-row><table:table-cell table:number-columns-spanned="8" table:style-name="Shade"><text:p>せたがや　動物とともにいきるまちプロジェクト</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="7" table:style-name="Input"><text:p/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>円</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p>【子ども・子育て】</text:p>
      <text:p>子ども・若者基金【外遊びの場と機会の充実のために】　　　円</text:p>
      <text:p>子ども・若者基金【子どもの学びの支援のために】　　　　円</text:p>
      <text:p>子ども・若者基金【子どもを育む地域活動支援のために】　円</text:p>
      <text:p>子ども・若者基金【多様な子ども・若者の活動を支えるために】　円</text:p>
      <text:p>子ども・若者基金【子ども・子育て支援のために】　　　　円</text:p>
      <text:p>児童館の整備のために（奥沢地区児童館）　　　　　　　　円</text:p>
      <text:p>児童館の整備のために（九品仏地区児童館・保育園複合施設）　円</text:p>
      <text:p>船橋児童館　陶芸活動再開応援プロジェクト　　　　　　　円</text:p>
      <text:p>喜多見児童館　陶芸窯応援プロジェクト　　　　　　　　　円</text:p>
      <text:p>【文化・国際・教育・スポーツ】</text:p>
      <text:p>世田谷遊びと学びの教育基金　　　　　　　　　　　　　　円</text:p>
      <text:p>文化振興基金　　　　　　　　　　　　　　　　　　　　　円</text:p>
      <text:p>国際平和交流基金　　　　　　　　　　　　　　　　　　　円</text:p>
      <text:p>スポーツ推進基金　　　　　　　　　　　　　　　　　　　円</text:p>
      <text:p text:style-name="Center">2</text:p>

      <text:p text:style-name="PageStart">【みどり・環境】</text:p>
      <text:p>みどりのトラスト基金【みどりを守るために】　　　　　　円</text:p>
      <text:p>みどりのトラスト基金【羽根木公園の梅林を守るために】　円</text:p>
      <text:p>等々力渓谷などの崖線樹林地保全　　　　　　　　　　　円</text:p>
      <text:p>みどりのトラスト基金【寄附ベンチ】　　　　　　　　　　円</text:p>
      <text:p>みどりのトラスト基金【世田谷の樹林地を育もう！】　　　円</text:p>
      <text:p>【その他】</text:p>
      <text:p>災害対策基金　　　　　　　　　　　　　　　　　　　　　円</text:p>
      <text:p>世田谷区本庁舎等整備プロジェクト</text:p>
      <text:p>※個人の方は３万円以上、法人・団体の方は１０万円以上</text:p>
      <text:p>の寄附をいただいた方に「区民会館エントランスホールルーフ裏</text:p>
      <text:p>銘板」への氏名等掲出希望確認のご案内を送付いたします。　円</text:p>
      <text:p>気候危機対策基金　　　　　　　　　　　　　　　　　　　円</text:p>
      <text:p>交通不便地域解消プロジェクト　　　　　　　　　　　　円</text:p>
      <text:p>旧玉電・江ノ電車両　再塗装プロジェクト　　　　　　　円</text:p>
      <text:p>区政全般のために　　　　　　　　　　　　　　　　　　　円</text:p>
      <text:p text:style-name="Center">3</text:p>

      <text:p text:style-name="PageStart">５－２．　区立小・中学校への寄附を希望される方へ</text:p>
      <text:p>区立小・中学校の施設整備（改築等）事業への寄附を希望される方は、こちらに金額をご記入ください。</text:p>
      <text:p>①　学校を指定される方は、希望する学校を選択してください。</text:p>
      <text:p>②　学校を指定されない方は、「義務教育施設整備基金」を選択してください。</text:p>
      <text:p>【学校指定寄附：小学校】　　　　　　　　　　　　【学校指定寄附：中学校】</text:p>
      <text:p>※こちらの使い道については、返礼品をお贈りすることはできません。　※こちらの使い道については、返礼品をお贈りすることはできません。</text:p>
      <table:table table:name="学校指定寄附" table:style-name="WideTable">
        <table:table-column table:style-name="ColHalf"/><table:table-column table:style-name="ColHalf"/>
        <table:table-column table:style-name="ColHalf"/><table:table-column table:style-name="ColHalf"/>
        <table:table-column table:style-name="ColHalf"/><table:table-column table:style-name="ColHalf"/>
        <table:table-column table:style-name="ColHalf"/><table:table-column table:style-name="ColHalf"/>
        <table:table-row><table:table-cell table:number-columns-spanned="8" table:style-name="Shade"><text:p>砧小学校</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="7" table:style-name="Input"><text:p/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="8" table:style-name="Shade"><text:p>八幡小学校</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="7" table:style-name="Input"><text:p/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="8" table:style-name="Shade"><text:p>深沢小学校</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
