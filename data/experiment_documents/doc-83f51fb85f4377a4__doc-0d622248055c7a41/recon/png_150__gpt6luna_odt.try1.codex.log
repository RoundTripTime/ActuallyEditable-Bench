      <table:table table:name="TitleBox" table:style-name="TitleTable">
        <table:table-column table:style-name="TitleColumn"/>
        <table:table-row>
          <table:table-cell table:style-name="TitleCell">
            <text:p text:style-name="Title">행정정보 공동이용 사전동의서</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageStart"/>
      <table:table table:name="FormFrame" table:style-name="OuterTable">
        <table:table-column table:style-name="OuterColumn"/>
