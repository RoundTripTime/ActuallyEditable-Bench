<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.04cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="9pt" style:font-name="Noto Sans CJK JP"/>
    </style:default-style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.1cm" fo:margin-bottom="1.1cm" fo:margin-left="1.5cm" fo:margin-right="1.5cm"/>
    </style:page-layout>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.1cm" fo:margin-bottom="0.15cm"/>
      <style:text-properties fo:font-size="15pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Heading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.15cm" fo:margin-bottom="0.05cm"/>
      <style:text-properties fo:font-size="10pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:text-properties fo:font-size="7pt"/>
    </style:style>
    <style:style style:name="Table" style:family="table">
      <style:table-properties style:width="18cm" table:align="margins"/>
    </style:style>
    <style:style style:name="Col" style:family="table-column">
      <style:table-column-properties style:column-width="3cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Green" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" fo:background-color="#ccffcc" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Blank" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Narrow" style:family="table">
      <style:table-properties style:width="4.3cm" table:align="left"/>
    </style:style>
    <style:style style:name="NarrowCol" style:family="table-column">
      <style:table-column-properties style:column-width="1.4cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageBreak"/>
      <table:table table:name="Date" table:style-name="Table">
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-row><table:table-cell table:style-name="Green"><text:p>申請年月日</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>年　　　　月　　　　日</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p>障がい福祉サービス等</text:p>
      <text:p>障がい児通所給付費</text:p>
      <text:p>地域相談支援給付費</text:p>
      <text:p>計画相談支援給付費</text:p>
      <text:p>障がい児相談支援給付費</text:p>
      <text:p text:style-name="Title">支給申請書</text:p>
      <text:p text:style-name="Center">（施設入所・療養介護・グループホーム用）</text:p>
      <text:p text:style-name="Title">（　　年　月末更新用）</text:p>
      <text:p text:style-name="Right">障がい支援区分更新用</text:p>
      <text:p>福山市長　様</text:p>
      <text:p>次のとおり申請します。また、申請する障がい福祉サービス等の給付要件の確認のため、福山市が保有する私に係る介護保険資格・給付情報、介護保険認定情報及び介護予防・生活支援サービス事業に係る基本チェックリスト、加入医療保険情報及び生活保護受給情報の目的外利用に同意します。（同意しない場合はこの文を削除してください。）</text:p>
      <text:p text:style-name="Heading">１　申請者（利用者が18歳以上の場合は本人の名前を、18歳未満の場合は保護者名を記入してください。）</text:p>
      <table:table table:name="Applicant" table:style-name="Table">
        <table:table-column table:style-name="Col"/><table:table-column table:style-name="Col"/><table:table-column table:style-name="Col"/><table:table-column table:style-name="Col"/>
        <table:table-row><table:table-cell table:style-name="Green"><text:p>ふ　り　が　な</text:p></table:table-cell><table:table-cell table:style-name="Blank"/><table:table-cell table:style-name="Green"><text:p>個人番号（マイナンバー）</text:p></table:table-cell><table:table-cell table:style-name="Blank"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Green"><text:p>名　　前</text:p></table:table-cell><table:table-cell table:style-name="Blank"/><table:table-cell table:style-name="Green"><text:p>生年月日</text:p></table:table-cell><table:table-cell table:style-name="Blank"><text:p>年　　　月　　　日（　　　）歳</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Green"><text:p>住　　所</text:p></table:table-cell><table:table-cell table:style-name="Blank"><text:p>〒　　　　－</text:p></table:table-cell><table:table-cell table:style-name="Blank"><text:p>電話番号</text:p></table:table-cell><table:table-cell table:style-name="Blank"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Green"><text:p>受給者証番号</text:p></table:table-cell><table:table-cell table:style-name="Green"><text:p>障がい福祉サービス等</text:p></table:table-cell><table:table-cell table:style-name="Green"><text:p>障がい児通所給付費</text:p></table:table-cell><table:table-cell table:style-name="Green"><text:p>地域相談支援給付費</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="Heading">２　申請するサービスの種類（サービスに✓印をし、必要事項を記入してください。）</text:p>
      <table:table table:name="Services" table:style-name="Table">
        <table:table-column table:style-name="Col"/><table:table-column table:style-name="Col"/><table:table-column table:style-name="Col"/>
        <table:table-row><table:table-cell table:style-name="Green"><text:p>サービス等の利用に係る更新について</text:p></table:table-cell><table:table-cell table:style-name="Green"/><table:table-cell table:style-name="Green"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Green"><text:p>・施設入所支援を利用中の方</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>□引き続きサービスの利用を希望します。</text:p><text:p>□サービスの更新を希望しないため、取り下げします。</text:p></table:table-cell><table:table-cell table:style-name="Blank"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Green"><text:p>・共同生活援助（グループホーム）を利用中の方</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>□共同生活援助（介護サービス包括型）サービスの利用を希望します。</text:p><text:p>□外部サービス利用型共同生活援助サービスの利用を希望します。</text:p><text:p>□受託居宅介護サービスの利用を希望します。</text:p><text:p>受託居宅介護サービスの支給量　　　時間/月</text:p><text:p>□サービスの更新を希望しないため、取り下げします。</text:p></table:table-cell><table:table-cell table:style-name="Blank"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Green"><text:p>・療養介護を利用中の方</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>□引き続きサービスの利用を希望します。</text:p><text:p>□サービスの更新を希望しないため、取り下げします。</text:p></table:table-cell><table:table-cell table:style-name="Blank"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>※　施設入所支援・共同生活援助・療養介護以外の利用中のサービスについても同様に更新・取り下げします。</text:p><text:p>※　サービスの変更を希望する場合は、下記の欄をご利用ください。</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>・サービスの追加、支給量の変更、取り下げを希望される方</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Green"><text:p>追加</text:p></table:table-cell><table:table-cell table:style-name="Green"><text:p>変更</text:p></table:table-cell><table:table-cell table:style-name="Green"><text:p>取消</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>□　サービス名（例：就労移行支援など）　支給量（○時間／月）</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>□</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="Right">（裏面につづく）</text:p>
      <text:p text:style-name="Heading">３　手帳等の所持状況等（利用者の所持している手帳等に✓印をしてください。）</text:p>
      <text:p text:style-name="Small">□身体障がい者手帳（帳障がい、人工透析受療中）　□療育手帳　□精神障がい者保健福祉手帳</text:p>
      <text:p text:style-name="Small">障がい支援区分：［　級　］　有効期限　　年　月　日</text:p>
      <text:p text:style-name="PageBreak"/>
      <table:table table:name="Certification" table:style-name="Narrow">
        <table:table-column table:style-name="NarrowCol"/><table:table-column table:style-name="NarrowCol"/><table:table-column table:style-name="NarrowCol"/>
        <table:table-row><table:table-cell table:style-name="Green"><text:p>□自立支援医療（精神通院）</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>□診断書</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>□特別児童扶養手当</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>□難病等（□特定疾患医療受給者証　□診断書）</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>有効期限　　年　月　日</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>受給者番号</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>□身体障がい者手帳</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>□障がい者手帳</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>□精神障がい者保健福祉手帳</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p>※　療養介護を申請する場合は、加入保険について記入してください。</text:p>
      <text:p text:style-name="Heading">４　当該障がい者又は児童の置かれている環境（※本人の配偶者と世帯員は名前の下側に個人番号（マイナンバー）を御記入ください。）</text:p>
      <table:table table:name="Household" table:style-name="Table">
        <table:table-column table:style-name="Col"/><table:table-column table:style-name="Col"/><table:table-column table:style-name="Col"/><table:table-column table:style-name="Col"/>
        <table:table-row><table:table-cell table:style-name="Green"><text:p>世帯の状況</text:p></table:table-cell><table:table-cell table:style-name="Green"><text:p>名　前</text:p></table:table-cell><table:table-cell table:style-name="Green"><text:p>世帯員の名前</text:p></table:table-cell><table:table-cell table:style-name="Green"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Green"><text:p>本人</text:p></table:table-cell><table:table-cell table:style-name="Blank"/><table:table-cell table:style-name="Blank"/><table:table-cell table:style-name="Blank"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Green"><text:p>保護者</text:p></table:table-cell><table:table-cell table:style-name="Blank"/><table:table-cell table:style-name="Blank"/><table:table-cell table:style-name="Blank"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Green"><text:p>本人の配偶者</text:p></table:table-cell><table:table-cell table:style-name="Blank"/><table:table-cell table:style-name="Blank"/><table:table-cell table:style-name="Blank"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Green"><text:p>世帯員</text:p></table:table-cell><table:table-cell table:style-name="Blank"/><table:table-cell table:style-name="Blank"/><table:table-cell table:style-name="Blank"/></table:table-row>
      </table:table>
      <text:p text:style-name="Heading">５　主治医（介護給付又は共同生活援助に係るものであって、入浴、排せつ又は食事等の介護の提供を受けることを希望する場合に記入してください。）</text:p>
      <table:table table:name="Doctor" table:style-name="Table">
        <table:table-column table:style-name="Col"/><table:table-column table:style-name="Col"/><table:table-column table:style-name="Col"/><table:table-column table:style-name="Col"/>
        <table:table-row><table:table-cell table:style-name="Green"><text:p>医療機関名</text:p></table:table-cell><table:table-cell table:style-name="Blank"/><table:table-cell table:style-name="Green"><text:p>診療科名</text:p></table:table-cell><table:table-cell table:style-name="Blank"><text:p>科　主治医の名前　　医師</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Green"><text:p>所在地</text:p></table:table-cell><table:table-cell table:style-name="Blank"><text:p>〒　　　　－</text:p></table:table-cell><table:table-cell table:style-name="Green"><text:p>電話番号</text:p></table:table-cell><table:table-cell table:style-name="Blank"/></table:table-row>
      </table:table>
      <text:p text:style-name="PageBreak"/>
      <text:p text:style-name="Heading">６　認定調査に係る連絡票（介護給付又は訓練等給付を申請する場合に記入してください。）</text:p>
      <table:table table:name="Contact" table:style-name="Table">
        <table:table-column table:style-name="Col"/><table:table-column table:style-name="Col"/><table:table-column table:style-name="Col"/><table:table-column table:style-name="Col"/>
        <table:table-row><table:table-cell table:style-name="Green"><text:p>調査実施場所の希望</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>□住民票の所在地</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>□住民票の所在地以外（右欄へ記入してください）　病院・施設名等</text:p></table:table-cell><table:table-cell table:style-name="Blank"><text:p>住所（所在地）</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Green"><text:p>日程調整をする人</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>ふりがな</text:p><text:p>名　前</text:p></table:table-cell><table:table-cell table:style-name="Blank"/><table:table-cell table:style-name="Cell"><text:p>申請者との関係</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Green"/><table:table-cell table:style-name="Cell"><text:p>電話番号</text:p></table:table-cell><table:table-cell table:style-name="Blank"/><table:table-cell table:style-name="Cell"><text:p>できるだけ日中に連絡がとれる番号を記入してください。</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Green"/><table:table-cell table:style-name="Cell"><text:p>備　考</text:p></table:table-cell><table:table-cell table:style-name="Blank"/><table:table-cell table:style-name="Cell"><text:p>連絡のとれる時間帯などを記入してください。</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p>※　負担上限月額等認定申請書を添付すること。</text:p>
      <text:p>セルフプラン又はケアプランで支給決定を希望される場合、セルフプラン又はケアプランの添付が必要です。</text:p>
      <text:p text:style-name="Heading">７　申請書提出者（✓印をしてください。申請者本人以外の者が提出する場合は、名前等を記入してください。）</text:p>
      <table:table table:name="Submitter" table:style-name="Table">
        <table:table-column table:style-name="Col"/><table:table-column table:style-name="Col"/><table:table-column table:style-name="Col"/><table:table-column table:style-name="Col"/>
        <table:table-row><table:table-cell table:style-name="Green"><text:p>申請書提出者</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>□申請者本人</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>申請者本人以外</text:p></table:table-cell><table:table-cell table:style-name="Blank"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Green"/><table:table-cell table:style-name="Cell"><text:p>ふりがな</text:p><text:p>名　前</text:p></table:table-cell><table:table-cell table:style-name="Blank"/><table:table-cell table:style-name="Cell"><text:p>申請者との関係</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Green"/><table:table-cell table:style-name="Cell"><text:p>住　所</text:p></table:table-cell><table:table-cell table:style-name="Blank"><text:p>□申請者と同じ　〒　　　　－</text:p></table:table-cell><table:table-cell table:style-name="Blank"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Green"/><table:table-cell table:style-name="Cell"><text:p>電話番号</text:p></table:table-cell><table:table-cell table:style-name="Blank"><text:p>□申請者と同じ</text:p></table:table-cell><table:table-cell table:style-name="Blank"/></table:table-row>
      </table:table>
      <text:p text:style-name="Right">【　計画相談についての説明　　□　済　】</text:p>
      <text:p>申請書提出者が「申請者本人」でない場合は、その方の名前、住所、電話番号、申請者との関係をご記入ください。住所、電話番号が申請者と同じ場合は、☑の記入のみで結構です。</text:p>
    </office:text>
  </office:body>
</office:document>