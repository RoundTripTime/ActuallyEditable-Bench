<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%" fo:margin-top="0in" fo:margin-bottom="0.08in"/>
      <style:text-properties fo:font-size="11pt" fo:color="#252723"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0.18in"/>
      <style:text-properties fo:font-size="28pt" fo:color="#252723"/>
    </style:style>
    <style:style style:name="SectionHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.12in" fo:margin-bottom="0.12in" fo:keep-with-next="always"/>
      <style:text-properties fo:font-size="15pt" fo:color="#915039"/>
    </style:style>
    <style:style style:name="ProjectHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0.18in" fo:keep-with-next="always"/>
      <style:text-properties fo:font-size="15pt" fo:color="#915039"/>
    </style:style>
    <style:style style:name="QuestionHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.35in" fo:margin-bottom="0.09in" fo:keep-with-next="always"/>
      <style:text-properties fo:font-size="12.5pt" fo:font-weight="bold" fo:color="#252723"/>
    </style:style>
    <style:style style:name="Intro" style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%" fo:margin-top="0in" fo:margin-bottom="0.12in"/>
      <style:text-properties fo:font-size="11pt" fo:color="#252723"/>
    </style:style>
    <style:style style:name="Response" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.08in" fo:margin-bottom="0in"/>
      <style:text-properties fo:font-size="11pt" fo:color="#252723"/>
    </style:style>
    <style:style style:name="Bullet" style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%" fo:margin-left="0.5in" fo:text-indent="-0.25in" fo:margin-top="0in" fo:margin-bottom="0.08in"/>
      <style:text-properties fo:font-size="11pt" fo:color="#252723"/>
    </style:style>
    <style:style style:name="Footer" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0in"/>
      <style:text-properties fo:font-size="11pt" fo:color="#252723"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="8.5in" fo:page-height="11in" fo:print-orientation="portrait" fo:margin-left="0.7in" fo:margin-right="0.7in" fo:margin-top="0.65in" fo:margin-bottom="0.6in"/>
    </style:page-layout>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page"/>
      <style:text-properties fo:font-size="15pt" fo:color="#915039"/>
    </style:style>
    <style:style style:name="PageStartQuestion" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0in" fo:margin-bottom="0.09in" fo:keep-with-next="always"/>
      <style:text-properties fo:font-size="12.5pt" fo:font-weight="bold" fo:color="#252723"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout">
      <style:footer>
        <text:p text:style-name="Footer">OpenLintel • Planning resource • <text:page-number text:select-page="current">1</text:page-number></text:p>
      </style:footer>
    </style:master-page>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">Interior design client questionnaire</text:p>
      <text:p text:style-name="Body">Blank editable template</text:p>
      <text:p text:style-name="Body">OpenLintel • Educational planning resource • September 27, 2026</text:p>
      <text:p text:style-name="Intro">Illustrative teaching extension of The Window Room; not a client record, supplier quote, site survey, or construction-ready document. Pending professional review.</text:p>
      <text:p text:style-name="SectionHeading">How to use</text:p>
      <text:p text:style-name="Intro">Send the blank questionnaire before discovery, then review it together. Invite short answers and allow “not sure yet”; a missing answer is a follow-up task, not permission to assume. Store completed forms in your own secure project system, not on this website. Keep original answers and the agreed interpretation distinguishable; confirm who consolidates feedback.</text:p>
      <text:p text:style-name="Bullet">•  Send the questions with a short explanation of how answers will be used.</text:p>
      <text:p text:style-name="Bullet">•  Discuss conflicting priorities in discovery; record questions rather than resolving them silently.</text:p>
      <text:p text:style-name="Bullet">•  Transfer agreed needs into the brief and assign follow-up information to an owner.</text:p>
      <text:p text:style-name="SectionHeading">Review before use</text:p>
      <text:p text:style-name="Bullet">•  Do not treat an inspiration image as a specification.</text:p>
      <text:p text:style-name="Bullet">•  Do not convert an aspirational budget or date into a commitment.</text:p>
      <text:p text:style-name="Bullet">•  Do not collect unnecessary sensitive household information.</text:p>
      <text:p text:style-name="Intro">Replace illustrative information with verified project records. No approval, legal agreement, or construction readiness is represented. Keep completed client documents in your own secure system.</text:p>

      <text:p text:style-name="PageStart">Your project</text:p>
      <text:p text:style-name="QuestionHeading">Project and contact</text:p>
      <text:p text:style-name="Intro">Record the project reference, preferred contact channel, and property location in your private copy. Ask only for contact information you need.</text:p>
      <text:p text:style-name="Response">[Enter your project information here. Leave unknowns explicit.]</text:p>

      <text:p text:style-name="QuestionHeading">Who uses the room?</text:p>
      <text:p text:style-name="Intro">Ask about routines, visitors, pets, changing household needs, and any access requirements the client wants to share.</text:p>
      <text:p text:style-name="Response">[Enter your project information here. Leave unknowns explicit.]</text:p>

      <text:p text:style-name="QuestionHeading">What works today?</text:p>
      <text:p text:style-name="Intro">Identify existing qualities worth keeping before discussing replacements.</text:p>
      <text:p text:style-name="Response">[Enter your project information here. Leave unknowns explicit.]</text:p>

      <text:p text:style-name="QuestionHeading">What is difficult today?</text:p>
      <text:p text:style-name="Intro">Ask for specific moments: where belongings collect, when light is uncomfortable, or how activities compete.</text:p>
      <text:p text:style-name="Response">[Enter your project information here. Leave unknowns explicit.]</text:p>

      <text:p text:style-name="QuestionHeading">What should it feel like?</text:p>
      <text:p text:style-name="Intro">Request a few references and ask what the client likes about each: light, material, layout, or atmosphere. Do not assume they want every object shown.</text:p>
      <text:p text:style-name="Response">[Enter your project information here. Leave unknowns explicit.]</text:p>

      <text:p text:style-name="QuestionHeading">What must stay?</text:p>
      <text:p text:style-name="Intro">List retained objects and fixed conditions. Confirm dimensions and condition separately at survey.</text:p>
      <text:p text:style-name="Response">[Enter your project information here. Leave unknowns explicit.]</text:p>

      <text:p text:style-name="QuestionHeading">Budget and timing</text:p>
      <text:p text:style-name="Intro">Distinguish an overall allowance from design fees, purchasing, and installation. Record target dates and their reasons without promising feasibility.</text:p>
      <text:p text:style-name="Response">[Enter your project information here. Leave unknowns explicit.]</text:p>

      <text:p text:style-name="PageStartQuestion">Who decides, and what happens next?</text:p>
      <text:p text:style-name="Intro">Identify who consolidates feedback and how decisions will be recorded. Agree the next meeting and outstanding information.</text:p>
      <text:p text:style-name="Response">[Enter your project information here. Leave unknowns explicit.]</text:p>
    </office:text>
  </office:body>
</office:document>