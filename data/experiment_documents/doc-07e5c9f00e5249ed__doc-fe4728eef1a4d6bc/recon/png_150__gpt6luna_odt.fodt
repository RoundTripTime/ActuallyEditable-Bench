<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%" fo:margin-top="0in" fo:margin-bottom="0in"/>
      <style:text-properties fo:font-size="10pt" style:font-name="Batang"/>
    </style:default-style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0in" fo:margin-bottom="0.02in"/>
      <style:text-properties fo:font-size="10pt" style:font-name="Batang"/>
    </style:style>
    <style:style style:name="SmallHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0.02in"/>
      <style:text-properties fo:font-size="10pt" fo:font-weight="bold" style:font-name="Batang"/>
    </style:style>
    <style:style style:name="SectionHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.04in" fo:margin-bottom="0.04in"/>
      <style:text-properties fo:font-size="14pt" fo:font-weight="bold" style:font-name="Batang"/>
    </style:style>
    <style:style style:name="FormTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="22pt" fo:font-weight="bold" style:font-name="Batang"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="10pt" style:font-name="Batang"/>
    </style:style>
    <style:style style:name="CellLabel" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="10pt" fo:font-weight="bold" style:font-name="Batang"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="12pt" fo:font-style="italic" fo:color="#0000FF" style:font-name="Batang"/>
    </style:style>
    <style:style style:name="RightText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right"/>
      <style:text-properties fo:font-size="11pt" style:font-name="Batang"/>
    </style:style>
    <style:style style:name="FooterAddress" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.08in"/>
      <style:text-properties fo:font-size="17pt" style:font-name="Batang"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.04in" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="LabelCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.04in" fo:background-color="#E2EED6" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="TableLayout" style:family="table">
      <style:table-properties table:align="margins" style:width="6.9in"/>
    </style:style>
    <style:style style:name="ColTitle" style:family="table-column">
      <style:table-column-properties style:column-width="5.55in"/>
    </style:style>
    <style:style style:name="ColShort" style:family="table-column">
      <style:table-column-properties style:column-width="1.35in"/>
    </style:style>
    <style:style style:name="ColRole" style:family="table-column">
      <style:table-column-properties style:column-width="0.62in"/>
    </style:style>
    <style:style style:name="ColLabel" style:family="table-column">
      <style:table-column-properties style:column-width="0.96in"/>
    </style:style>
    <style:style style:name="ColValue" style:family="table-column">
      <style:table-column-properties style:column-width="1.31in"/>
    </style:style>
    <style:style style:name="ColDept" style:family="table-column">
      <style:table-column-properties style:column-width="0.77in"/>
    </style:style>
    <style:style style:name="ColWide" style:family="table-column">
      <style:table-column-properties style:column-width="3.24in"/>
    </style:style>
    <style:style style:name="ColOpsLabel" style:family="table-column">
      <style:table-column-properties style:column-width="1.27in"/>
    </style:style>
    <style:style style:name="ColOpsWide" style:family="table-column">
      <style:table-column-properties style:column-width="5.63in"/>
    </style:style>
    <style:style style:name="ColContentLabel" style:family="table-column">
      <style:table-column-properties style:column-width="0.82in"/>
    </style:style>
    <style:style style:name="ColContentWide" style:family="table-column">
      <style:table-column-properties style:column-width="6.08in"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="8.27in" fo:page-height="11.69in" style:print-orientation="portrait" fo:margin-left="0.68in" fo:margin-right="0.68in" fo:margin-top="0.48in" fo:margin-bottom="0.48in"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">[별지 제8호서식]</text:p>
      <table:table table:name="FormHeader" table:style-name="TableLayout">
        <table:table-column table:style-name="ColTitle"/>
        <table:table-column table:style-name="ColShort"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2">
            <text:p text:style-name="FormTitle">개척학기제 제안 과제 신청서</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p>(        ) 학년도</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell">
            <text:p>(        ) 학기</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="SectionHeading">1. 제안사항</text:p>
      <table:table table:name="Proposal" table:style-name="TableLayout">
        <table:table-column table:style-name="ColRole"/>
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColValue"/>
        <table:table-column table:style-name="ColDept"/>
        <table:table-column table:style-name="ColWide"/>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell" table:number-columns-spanned="2"><text:p text:style-name="CellLabel">과제명</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell" table:number-rows-spanned="2"><text:p text:style-name="CellLabel">제안자</text:p></table:table-cell>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CellLabel">성명</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CellLabel">소속/직위</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CellLabel">연락처</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3">
            <text:p>- 연락처(사무실) :</text:p>
            <text:p>- 이메일 :</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell" table:number-rows-spanned="2"><text:p text:style-name="CellLabel">지도교수</text:p></table:table-cell>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CellLabel">성명</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CellLabel">소속/직위</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CellLabel">연락처</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3">
            <text:p>- 연락처(사무실) :</text:p>
            <text:p>- 이메일 :</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>

      <text:p text:style-name="SectionHeading">2. 운영</text:p>
      <table:table table:name="Operation" table:style-name="TableLayout">
        <table:table-column table:style-name="ColOpsLabel"/>
        <table:table-column table:style-name="ColOpsWide"/>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CellLabel">인원(최소/최대)</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CellLabel">외부 연계</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CellLabel">이수학점</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CellLabel">요구역량</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>

      <text:p text:style-name="SectionHeading">3. 내용</text:p>
      <table:table table:name="Content" table:style-name="TableLayout">
        <table:table-column table:style-name="ColContentLabel"/>
        <table:table-column table:style-name="ColContentWide"/>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CellLabel">제안 배경</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Note">※ 개척학기제 신청사유</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CellLabel">과제 목표</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Note">※ 필요 시 사진 또는 도표 삽입 가능</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CellLabel">과제 내용 및<br/>주요 활동</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Note">※ 필요 시 사진 또는 도표 삽입 가능</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CellLabel">예상 결과물</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Note">※ 필요 시 사진 또는 도표 삽입 가능</text:p></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="Center">년　 월　 일</text:p>
      <text:p text:style-name="RightText">제안자:　　　(인)</text:p>
      <text:p text:style-name="FooterAddress">경상국립대학교총장 귀하</text:p>
    </office:text>
  </office:body>
</office:document>