<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:font-size="10pt" fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Noto Sans CJK KR" fo:font-size="10pt"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.08cm" fo:margin-bottom="0.08cm"/>
    </style:style>
    <style:style style:name="FormLabel" style:family="paragraph">
      <style:paragraph-properties fo:font-size="10pt" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:font-size="14pt" fo:margin-top="0.16cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-size="14pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="TitleCell" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.02cm" fo:margin-bottom="0.02cm"/>
      <style:text-properties fo:font-size="23pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="CenteredBold" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="CellText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:color="#0000FF" fo:font-size="11pt" fo:font-style="italic"/>
    </style:style>
    <style:style style:name="DateLine" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.16cm" fo:margin-bottom="0.06cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Signature" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.12cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="18pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-left="1.6cm" fo:margin-right="1.6cm" fo:margin-top="1.3cm" fo:margin-bottom="1.3cm"/>
    </style:page-layout>
    <style:style style:name="HeaderTable" style:family="table">
      <style:table-properties style:width="17.8cm" table:align="center"/>
    </style:style>
    <style:style style:name="ProposalTable" style:family="table">
      <style:table-properties style:width="17.8cm" table:align="center"/>
    </style:style>
    <style:style style:name="OperationsTable" style:family="table">
      <style:table-properties style:width="17.8cm" table:align="center"/>
    </style:style>
    <style:style style:name="ContentTable" style:family="table">
      <style:table-properties style:width="17.8cm" table:align="center"/>
    </style:style>
    <style:style style:name="ColHeaderLeft" style:family="table-column">
      <style:table-column-properties style:column-width="14.7cm"/>
    </style:style>
    <style:style style:name="ColHeaderRight" style:family="table-column">
      <style:table-column-properties style:column-width="3.1cm"/>
    </style:style>
    <style:style style:name="ColProposal1" style:family="table-column">
      <style:table-column-properties style:column-width="1.5cm"/>
    </style:style>
    <style:style style:name="ColProposal2" style:family="table-column">
      <style:table-column-properties style:column-width="2.3cm"/>
    </style:style>
    <style:style style:name="ColProposal3" style:family="table-column">
      <style:table-column-properties style:column-width="3cm"/>
    </style:style>
    <style:style style:name="ColProposal4" style:family="table-column">
      <style:table-column-properties style:column-width="1.6cm"/>
    </style:style>
    <style:style style:name="ColProposal5" style:family="table-column">
      <style:table-column-properties style:column-width="9.4cm"/>
    </style:style>
    <style:style style:name="ColOpsLabel" style:family="table-column">
      <style:table-column-properties style:column-width="3.2cm"/>
    </style:style>
    <style:style style:name="ColOpsData" style:family="table-column">
      <style:table-column-properties style:column-width="14.6cm"/>
    </style:style>
    <style:style style:name="ColContentLabel" style:family="table-column">
      <style:table-column-properties style:column-width="2cm"/>
    </style:style>
    <style:style style:name="ColContentData" style:family="table-column">
      <style:table-column-properties style:column-width="15.8cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="LabelCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" fo:background-color="#DFEED1" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #666666" fo:padding="0.06cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="DataArea" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.14cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="RowProposal" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.72cm"/>
    </style:style>
    <style:style style:name="RowOperations" style:family="table-row">
      <style:table-row-properties style:min-row-height="1cm"/>
    </style:style>
    <style:style style:name="RowReason" style:family="table-row">
      <style:table-row-properties style:min-row-height="1.55cm"/>
    </style:style>
    <style:style style:name="RowGoal" style:family="table-row">
      <style:table-row-properties style:min-row-height="1.8cm"/>
    </style:style>
    <style:style style:name="RowActivities" style:family="table-row">
      <style:table-row-properties style:min-row-height="4.2cm"/>
    </style:style>
    <style:style style:name="RowResult" style:family="table-row">
      <style:table-row-properties style:min-row-height="1.6cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Body">[별지 제8호서식]</text:p>
      <table:table table:name="Header" table:style-name="HeaderTable">
        <table:table-column table:style-name="ColHeaderLeft"/>
        <table:table-column table:style-name="ColHeaderRight"/>
        <table:table-row>
          <table:table-cell table:style-name="HeaderCell" table:number-rows-spanned="2">
            <text:p text:style-name="TitleCell">개척학기제 제안 과제 신청서</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="HeaderCell">
            <text:p text:style-name="CellText">(          ) 학년도</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="HeaderCell">
            <text:p text:style-name="CellText">(          ) 학기</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Section">1. 제안사항</text:p>
      <table:table table:name="Proposal" table:style-name="ProposalTable">
        <table:table-column table:style-name="ColProposal1"/>
        <table:table-column table:style-name="ColProposal2"/>
        <table:table-column table:style-name="ColProposal3"/>
        <table:table-column table:style-name="ColProposal4"/>
        <table:table-column table:style-name="ColProposal5"/>
        <table:table-row table:style-name="RowProposal">
          <table:table-cell table:style-name="LabelCell" table:number-columns-spanned="2"><text:p text:style-name="CenteredBold">과제명</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowProposal">
          <table:table-cell table:style-name="LabelCell" table:number-rows-spanned="2"><text:p text:style-name="CenteredBold">제안자</text:p></table:table-cell>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CenteredBold">성명</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CenteredBold">소속/직위</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="RowProposal">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CenteredBold">연락처</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3">
            <text:p text:style-name="CellText">- 연락처(사무실) :</text:p>
            <text:p text:style-name="CellText">- 이메일 :</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowProposal">
          <table:table-cell table:style-name="LabelCell" table:number-rows-spanned="2"><text:p text:style-name="CenteredBold">지도교수</text:p></table:table-cell>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CenteredBold">성명</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CenteredBold">소속/직위</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="RowProposal">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CenteredBold">연락처</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3">
            <text:p text:style-name="CellText">- 연락처(사무실) :</text:p>
            <text:p text:style-name="CellText">- 이메일 :</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Section">2. 운영</text:p>
      <table:table table:name="Operations" table:style-name="OperationsTable">
        <table:table-column table:style-name="ColOpsLabel"/>
        <table:table-column table:style-name="ColOpsData"/>
        <table:table-row table:style-name="RowOperations">
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CenteredBold">인원(최소/최대)</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="RowOperations">
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CenteredBold">외부 연계</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="RowOperations">
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CenteredBold">이수학점</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="RowOperations">
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CenteredBold">요구역량</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Section">3. 내용</text:p>
      <table:table table:name="Content" table:style-name="ContentTable">
        <table:table-column table:style-name="ColContentLabel"/>
        <table:table-column table:style-name="ColContentData"/>
        <table:table-row table:style-name="RowReason">
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CenteredBold">제안 배경</text:p></table:table-cell>
          <table:table-cell table:style-name="DataArea"><text:p text:style-name="Note">※ 개척학기제 신청사유</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowGoal">
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CenteredBold">과제 목표</text:p></table:table-cell>
          <table:table-cell table:style-name="DataArea"><text:p text:style-name="Note">※ 필요 시 사진 또는 도표 삽입 가능</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowActivities">
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CenteredBold">과제 내용 및<br/>주요 활동</text:p></table:table-cell>
          <table:table-cell table:style-name="DataArea"><text:p text:style-name="Note">※ 필요 시 사진 또는 도표 삽입 가능</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowResult">
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CenteredBold">예상 결과물</text:p></table:table-cell>
          <table:table-cell table:style-name="DataArea"><text:p text:style-name="Note">※ 필요 시 사진 또는 도표 삽입 가능</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="DateLine">년　 월　 일</text:p>
      <text:p text:style-name="Signature">제안자:　　　　　 (인)</text:p>
      <text:p text:style-name="Recipient">경상국립대학교총장 귀하</text:p>
    </office:text>
  </office:body>
</office:document>