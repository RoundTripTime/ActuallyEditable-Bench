          <table:table-cell table:style-name="cell"><text:p>資産所在地</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="cell"><text:p>代　替</text:p><text:p>償却資産</text:p></table:table-cell>
          <table:table-cell table:style-name="cell"/>
          <table:table-cell table:style-name="cell"/>
