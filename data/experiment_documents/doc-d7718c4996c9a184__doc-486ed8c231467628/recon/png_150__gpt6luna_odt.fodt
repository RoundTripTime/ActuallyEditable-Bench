<?xml version='1.0' encoding='UTF-8'?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="11pt" style:font-name="Noto Serif CJK KR"/>
    </style:default-style>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:line-height="120%"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="120%"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-size="20pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="SubTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="18pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
    <style:style style:name="BodyText" style:family="paragraph">
      <style:paragraph-properties fo:line-height="180%" fo:margin-top="0.15cm" fo:margin-bottom="0.15cm"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties table:align="margins"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="2.6cm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="3.8cm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="1.4cm"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties style:column-width="3.0cm"/>
    </style:style>
    <style:style style:name="Col5" style:family="table-column">
      <style:table-column-properties style:column-width="2.2cm"/>
    </style:style>
    <style:style style:name="Col6" style:family="table-column">
      <style:table-column-properties style:column-width="4.0cm"/>
    </style:style>
    <style:style style:name="Grid4a" style:family="table-column">
      <style:table-column-properties style:column-width="2.0cm"/>
    </style:style>
    <style:style style:name="Grid4b" style:family="table-column">
      <style:table-column-properties style:column-width="3.3cm"/>
    </style:style>
    <style:style style:name="Grid4c" style:family="table-column">
      <style:table-column-properties style:column-width="7.0cm"/>
    </style:style>
    <style:style style:name="Grid4d" style:family="table-column">
      <style:table-column-properties style:column-width="2.7cm"/>
    </style:style>
    <style:style style:name="Grid3a" style:family="table-column">
      <style:table-column-properties style:column-width="4.0cm"/>
    </style:style>
    <style:style style:name="Grid3b" style:family="table-column">
      <style:table-column-properties style:column-width="9.0cm"/>
    </style:style>
    <style:style style:name="Grid3c" style:family="table-column">
      <style:table-column-properties style:column-width="4.0cm"/>
    </style:style>
    <style:style style:name="Grid4x" style:family="table-column">
      <style:table-column-properties style:column-width="3.2cm"/>
    </style:style>
    <style:style style:name="Grid4y" style:family="table-column">
      <style:table-column-properties style:column-width="3.8cm"/>
    </style:style>
    <style:style style:name="Grid4z" style:family="table-column">
      <style:table-column-properties style:column-width="3.4cm"/>
    </style:style>
  <style:style style:name="c2_PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
    <style:style style:name="c2_Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.2cm" fo:margin-bottom="0.6cm" fo:line-height="150%"/>
      <style:text-properties fo:font-family="sans-serif" fo:font-size="22pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="c2_ConsentTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.2cm" fo:margin-bottom="2.0cm" fo:line-height="150%"/>
      <style:text-properties fo:font-family="sans-serif" fo:font-size="22pt"/>
    </style:style>
    <style:style style:name="c2_Body" style:family="paragraph">
      <style:paragraph-properties fo:line-height="150%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="13pt"/>
    </style:style>
    <style:style style:name="c2_Indented" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.65cm" fo:line-height="150%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="13pt"/>
    </style:style>
    <style:style style:name="c2_ConsentBody" style:family="paragraph">
      <style:paragraph-properties fo:line-height="180%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="c2_CenterLine" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="180%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="c2_SmallSpacer" style:family="paragraph">
      <style:paragraph-properties fo:line-height="180%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="c2_FormTable" style:family="table">
      <style:table-properties style:width="17cm" table:align="center"/>
    </style:style>
    <style:style style:name="c2_FormColumn" style:family="table-column">
      <style:table-column-properties style:column-width="8.5cm"/>
    </style:style>
    <style:style style:name="c2_FormCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="c2_LeftFormCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0cm" fo:padding-left="2.0cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="c2_RightFormCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0cm" fo:padding-left="2.0cm" style:vertical-align="middle"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="A4">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.8cm" fo:margin-bottom="1.8cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
    </style:page-layout>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:border="0.5pt solid #000000" fo:padding="0.08cm"/>
    </style:style>
    <style:style style:name="CellTop" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="top" fo:border="0.5pt solid #000000" fo:padding="0.1cm"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:border="0.5pt solid #000000" fo:padding="0.08cm"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="115%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="LeftSmall" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:line-height="120%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="LargeCell" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="145%"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
  <style:style style:name="merge_pb" style:family="paragraph"><style:paragraph-properties fo:break-before="page"/></style:style><style:page-layout style:name="c2_PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.8cm" fo:margin-bottom="1.8cm" fo:margin-left="1.7cm" fo:margin-right="1.7cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="A4"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">문화예술회관 사용허가 신청서</text:p>
      <table:table table:name="신청서" table:style-name="FormTable">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-column table:style-name="Col5"/>
        <table:table-column table:style-name="Col6"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">단체명</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">대표자<br/>성 명</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">등록번호<br/>또는<br/>생년월일</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">단체의<br/>소재지 또는<br/>대표자 주소<br/>(도로명주소)</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p/></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:number-rows-spanned="2" table:style-name="Cell"><text:p text:style-name="Center">연락처</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">사무실</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">휴대폰</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">전시·<br/>공연행사의</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="5" table:style-name="Cell"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">전시·<br/>공연행사의</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="5" table:style-name="Cell"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">사용기간 및<br/>시간</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="CellTop">
            <text:p text:style-name="LeftSmall">년　월　일　시부터</text:p>
            <text:p text:style-name="LeftSmall">년　월　일　시까지</text:p>
            <text:p text:style-name="LeftSmall">(총　일　회 공연)</text:p>
            <text:p text:style-name="LeftSmall">공연시작시간 :　(　)분소요</text:p>
          </table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">출연 및<br/>참석예정<br/><br/>인원수</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:number-rows-spanned="2" table:style-name="Cell"><text:p text:style-name="Center">사용시설 및<br/>설비</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">기본시설</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="4" table:style-name="Cell"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">부속시설</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="4" table:style-name="Cell"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">입장료</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="5" table:style-name="Cell"><text:p text:style-name="Center">무료(초대), 유료(전석 :　　　원, 기타 :　　　　　　)</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">비 고</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="5" table:style-name="CellTop">
            <text:p text:style-name="LeftSmall">첨부 : 1. 행사계획서 1부</text:p>
            <text:p text:style-name="LeftSmall">　　　2. 기타 필요한 서류 1부</text:p>
            <text:p text:style-name="LeftSmall">　　　　(포스터 · 리플릿 · 소책자 · 입장권 견본 등)</text:p>
          </table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="BodyText">「울산광역시 문화예술회관 운영 조례」 제5조 및 같은 조례 시행규칙 제3조제1항에 따라 위와 같이 사용 허가를 신청합니다.</text:p>
      <text:p text:style-name="Center">년　월　일</text:p>
      <text:p text:style-name="Center">신청자 주소 :</text:p>
      <text:p text:style-name="Center">성　명 :　　　(서명 또는 인)</text:p>
      <text:p text:style-name="P"><text:span>울산광역시문화예술회관장 귀하</text:span></text:p>

      <text:p text:style-name="PageBreak"/>
      <text:p text:style-name="PageBreak"/>
      <text:p text:style-name="Title">공연·전시 계획서</text:p>
      <text:p text:style-name="BodyText">1. 제　명 :</text:p>
      <text:p text:style-name="BodyText">2. 현장 티켓 판매 : 여 / 부</text:p>
      <text:p text:style-name="BodyText">3. 공연 관람등급 :</text:p>
      <text:p text:style-name="BodyText">4. 공연·전시개요 :</text:p>
      <text:p text:style-name="BodyText">5. 공연·전시내용 및 해설 :</text:p>
      <table:table table:name="공연전시프로그램" table:style-name="FormTable">
        <table:table-column table:style-name="Grid4a"/>
        <table:table-column table:style-name="Grid4b"/>
        <table:table-column table:style-name="Grid4c"/>
        <table:table-column table:style-name="Grid4d"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">순 서</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">소요시간</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">공연·전시 프로그램</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">해　설</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:number-rows-repeated="1">
          <table:table-cell table:style-name="CellTop"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellTop"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellTop"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellTop"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="PageBreak"/>
      <text:p text:style-name="PageBreak"/>
      <text:p text:style-name="Title">공연·전시자의 공연경력서</text:p>
      <table:table table:name="공연경력서" table:style-name="FormTable">
        <table:table-column table:style-name="Grid3a"/>
        <table:table-column table:style-name="Grid3b"/>
        <table:table-column table:style-name="Grid3c"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">년　월　일</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">공연·전시 경력</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">비　고</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellTop"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellTop"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellTop"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="PageBreak"/>
      <text:p text:style-name="PageBreak"/>
      <text:p text:style-name="Title">출연자 및 진행요원 명단</text:p>
      <table:table table:name="출연자명단" table:style-name="FormTable">
        <table:table-column table:style-name="Grid4x"/>
        <table:table-column table:style-name="Grid4y"/>
        <table:table-column table:style-name="Grid4z"/>
        <table:table-column table:style-name="Grid4c"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">출연,진행자</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">배역,담당</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">연　령</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">주요경력사항</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellTop"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellTop"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellTop"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellTop"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:number-columns-spanned="4" table:style-name="Cell"><text:p text:style-name="LeftSmall">총인원 :　　　명(출연자 :　　　명,　진행자 :　　　명)</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>

      <text:p text:style-name="PageBreak"/>
      <text:p text:style-name="PageBreak"/>
      <text:p text:style-name="Title">대관 준수사항 이행각서</text:p>
      <table:table table:name="이행각서" table:style-name="FormTable">
        <table:table-column table:style-name="Grid4x"/>
        <table:table-column table:style-name="Grid4y"/>
        <table:table-column table:style-name="Grid4z"/>
        <table:table-column table:style-name="Grid4c"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">단 체 명</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">소 재 지<br/>(연 락 처)</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">대 표 자 명</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">공 연 장 소</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">공 연 명</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">공 연 일 시</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">총 사 업 비</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="Cell"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="BodyText">상기 본인(단체)은 귀 회관의 공연장을 사용함에 있어　“울산광역시 문화예술회관 대관 준수사항”을 반드시 이행할 것이며, 만약 미이행 및 관련 서식을 허위작성 하였을 경우 대관취소 및 향후 사용 제한 등 대관과 관련한 불이익을 받아도 이의를 제기하지 않겠습니다.</text:p>
      <text:p text:style-name="Center">년　월　일</text:p>
      <text:p text:style-name="Center">단 체 명 :　　　대표자 :　　　(서명 또는 인)</text:p>
      <text:p text:style-name="P">울산광역시 문화예술회관장 귀하</text:p>
    <text:p text:style-name="merge_pb"/><text:p text:style-name="c2_PageStart"/>
      <text:p text:style-name="c2_Title">【울산광역시 문화예술회관 대관 준수사항】</text:p>
      <text:p text:style-name="c2_Body">1. 사용자는 사용기간 중에 회관의 시설 또는 설비에 대하여 선량한 관리자로서 주의</text:p>
      <text:p text:style-name="c2_Indented">의무를 다하여야 합니다.</text:p>
      <text:p text:style-name="c2_Body">2. 사용자는 회관의 시설 또는 설비를 망실·훼손하였을 때에는 이를 변상하여야 합니다.</text:p>
      <text:p text:style-name="c2_Body">3. 사용자가 회관 사용기간 중에 특별한 설비를 하고자 할 때에는 미리 관장의</text:p>
      <text:p text:style-name="c2_Indented">승인을 받아 사용자 부담으로 필요한 설비를 설치할 수 있습니다.</text:p>
      <text:p text:style-name="c2_Indented">⇒ 관장의 승인 없이 설치한 설비는 임의 철거함.</text:p>
      <text:p text:style-name="c2_Body">4. 위 3번의 규정에 의하여 설치한 설비는 사용기간 만료와 동시에 이를</text:p>
      <text:p text:style-name="c2_Indented">철거하고 원상 복구하여야 합니다.</text:p>
      <text:p text:style-name="c2_Body">5. 사용자가 위 4번의 규정에 의한 의무를 이행하지 아니할 때에는 관장이 원상</text:p>
      <text:p text:style-name="c2_Indented">복구하고 그 비용을 사용자로부터 징수합니다. 이 경우 철거에 따른 설비의 파손</text:p>
      <text:p text:style-name="c2_Indented">등에 대하여는 관장은 책임을 지지 아니하며, 철거일로부터 7일 이내에 철거된</text:p>
      <text:p text:style-name="c2_Indented">설비를 사용자가 인수하지 않을 때에는 관장이 임의로 처분할 수 있습니다.</text:p>
      <text:p text:style-name="c2_Body">6. 무대 특수효과(화약류, 폭죽 등) 사용을 자제하여 주시기 바랍니다.</text:p>
      <text:p text:style-name="c2_Body">7. 공연장 및 전시장내 모든 공간은 금연구역으로 지정되어 있습니다</text:p>
      <text:p text:style-name="c2_Body">8. 공연장·전시장 및 연습실·회의실 내에는 음식물을 절대로 반입할 수 없습니다.</text:p>
      <text:p text:style-name="c2_Indented">다만, 도시락 등 간단한 음식은 휴게실을 이용하되 이용 후 분리수거 등</text:p>
      <text:p text:style-name="c2_Indented">뒷정리를 깨끗이 하여야 합니다. 또한 공연장(로비)에 화환은 반입할 수</text:p>
      <text:p text:style-name="c2_Indented">없으며 꽃다발을 비롯한 기타물품은 물품보관소에 보관하여 주시기</text:p>
      <text:p text:style-name="c2_Indented">바랍니다. 공연장 외부에 설치한 화환 및 물품은 공연이 끝남과 동시에</text:p>
      <text:p text:style-name="c2_Indented">반드시 철거하여야 합니다.(※사업장용 쓰레기 종량제봉투 100L 준비)</text:p>
      <text:p text:style-name="c2_Body">9. 공연 외의 부대행사는 불가하며 부득이한 경우 관장의 허가를 득하여야 합니다.</text:p>
      <text:p text:style-name="c2_Body">10. 종교(기도, 설교 등)와 관련된 프로그램은 진행할 수 없습니다.</text:p>
      <text:p text:style-name="c2_Body">11. 공연장내에서 일반상품 판매행위를 할 수 없습니다.</text:p>

      <text:p text:style-name="c2_PageStart"/>
      <text:p text:style-name="c2_ConsentTitle">개인정보 수입·이용 동의서</text:p>
      <text:p text:style-name="c2_ConsentBody">개인정보보호법 제22조 및 시행령 제17조에 따라 본인(법인)은 울산광역시</text:p>
      <text:p text:style-name="c2_ConsentBody">문화예술회관의 사용허가 신청에 필요한 개인정보를 아래와 같이 제공하는 데</text:p>
      <text:p text:style-name="c2_ConsentBody">동의합니다.</text:p>
      <text:p text:style-name="c2_CenterLine">- 아 래 -</text:p>
      <text:p text:style-name="c2_ConsentBody">1. 개인정보 수집·이용 목적 : 문화예술회관 (공연장, 전시장, 연습실, 회의실) 대관</text:p>
      <text:p text:style-name="c2_ConsentBody">2. 수입하려는 개인정보 항목 : 등록(법인, 사업자) 번호, 생년월일, 성명, 연락처, 주소</text:p>
      <text:p text:style-name="c2_ConsentBody">3. 개인정보 보유 및 이용 기간 : 10년</text:p>
      <text:p text:style-name="c2_ConsentBody">4. 동의 거부 권리 및 거부 시 불이익의 내용</text:p>
      <text:p text:style-name="c2_ConsentBody">   : 귀하는 위의 개인정보 수집·이용에 대한 동의를 거부할 권리가 있습니다.</text:p>
      <text:p text:style-name="c2_ConsentBody">     다만, 거부 시 대관 신청이 불가합니다.</text:p>
      <text:p text:style-name="c2_SmallSpacer"><text:s text:c="2"/></text:p>
      <text:p text:style-name="c2_ConsentBody">위와 같이 개인정보를 수집·이용하는데 동의하십니까? ( □ 동의함  □ 동의하지 않음 )</text:p>
      <text:p text:style-name="c2_SmallSpacer"><text:s text:c="5"/></text:p>
      <table:table table:name="ConsentSignature" table:style-name="c2_FormTable">
        <table:table-column table:style-name="c2_FormColumn"/>
        <table:table-column table:style-name="c2_FormColumn"/>
        <table:table-row>
          <table:table-cell table:style-name="c2_FormCell" table:number-columns-spanned="2">
            <text:p text:style-name="c2_CenterLine">년   월   일</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="c2_FormCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="c2_LeftFormCell">
            <text:p text:style-name="c2_ConsentBody">성명(법인명) :</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="c2_RightFormCell">
            <text:p text:style-name="c2_ConsentBody">(인 또는 서명)</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="c2_PageStart"/>
    </office:text>
  </office:body>
</office:document>