      <text:p text:style-name="ProjectLabel">工事名</text:p>
      <text:p text:style-name="ProjectLine"/>
      <text:p text:style-name="Intro">上記建設工事に係る現場代理人等を次のとおり定めたので通知します。</text:p>
      <table:table table:name="技術者一覧" table:style-name="MainTable">
        <table:table-column table:style-name="TableColumn" table:number-columns-repeated="3"/>
        <table:table-row>
          <table:table-cell table:style-name="TableHeaderCell">
            <text:p>区　　分</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="TableHeaderCell">
            <text:p>氏　　名</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="TableHeaderCell">
            <text:p>備　　考</text:p>
          </table:table-cell>
