<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Normal" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Calibri" fo:font-size="10pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Bold" style:family="text">
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="1.4cm" fo:margin-right="1.8cm" fo:margin-top="1.6cm" fo:margin-bottom="1.3cm"/>
    </style:page-layout>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="Normal">
      <style:paragraph-properties fo:break-before="page" fo:margin-bottom="0.35cm" fo:padding-bottom="0.2cm" fo:border-bottom="0.04cm solid #4F81BD"/>
      <style:text-properties fo:font-family="Calibri" fo:font-size="26pt" fo:color="#17365D"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph" style:parent-style-name="Normal">
      <style:paragraph-properties fo:margin-top="0.15cm" fo:margin-bottom="0.2cm"/>
      <style:text-properties fo:font-family="Calibri" fo:font-size="10pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Key" style:family="paragraph" style:parent-style-name="Normal">
      <style:paragraph-properties fo:margin-left="0.2cm" fo:margin-right="0.1cm"/>
      <style:text-properties fo:font-family="Calibri" fo:font-size="10pt" fo:font-weight="bold" fo:color="#366092"/>
    </style:style>
    <style:style style:name="Field" style:family="paragraph" style:parent-style-name="Normal">
      <style:paragraph-properties fo:margin-left="0.1cm"/>
      <style:text-properties fo:font-family="Calibri" fo:font-size="10pt" fo:color="#366092"/>
    </style:style>
    <style:style style:name="TableHead" style:family="paragraph" style:parent-style-name="Normal">
      <style:paragraph-properties fo:margin-left="0.2cm" fo:margin-right="0.1cm"/>
      <style:text-properties fo:font-family="Calibri" fo:font-size="9pt" fo:font-weight="bold" fo:color="#366092"/>
    </style:style>
    <style:style style:name="Total" style:family="paragraph" style:parent-style-name="Normal">
      <style:paragraph-properties fo:margin-left="0.2cm" fo:margin-top="0.12cm"/>
      <style:text-properties fo:font-family="Calibri" fo:font-size="10pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph" style:parent-style-name="Normal">
      <style:paragraph-properties fo:margin-left="0.2cm" fo:margin-top="0.12cm"/>
      <style:text-properties fo:font-family="Calibri" fo:font-size="10pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Footer" style:family="paragraph" style:parent-style-name="Normal">
      <style:paragraph-properties fo:margin-left="0.2cm" fo:margin-top="9.4cm"/>
      <style:text-properties fo:font-family="Calibri" fo:font-size="8pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="InfoColumn1" style:family="table-column">
      <style:table-column-properties style:column-width="9cm"/>
    </style:style>
    <style:style style:name="InfoColumn2" style:family="table-column">
      <style:table-column-properties style:column-width="8.8cm"/>
    </style:style>
    <style:style style:name="ItemColumn1" style:family="table-column">
      <style:table-column-properties style:column-width="7.1cm"/>
    </style:style>
    <style:style style:name="ItemColumn2" style:family="table-column">
      <style:table-column-properties style:column-width="2.8cm"/>
    </style:style>
    <style:style style:name="ItemColumn3" style:family="table-column">
      <style:table-column-properties style:column-width="3.75cm"/>
    </style:style>
    <style:style style:name="ItemColumn4" style:family="table-column">
      <style:table-column-properties style:column-width="4.15cm"/>
    </style:style>
    <style:style style:name="InfoRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.62cm"/>
    </style:style>
    <style:style style:name="ItemRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.65cm"/>
    </style:style>
    <style:style style:name="SpacerRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.58cm"/>
    </style:style>
    <style:style style:name="CellPlain" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.05cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellStripe" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#D3E0F0" fo:padding="0.05cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellRule" style:family="table-cell">
      <style:table-cell-properties fo:border-top="0.04cm solid #4F81BD" fo:border-bottom="0.04cm solid #4F81BD" fo:padding="0.05cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="ItemBlank" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#D3E0F0" fo:padding="0.03cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:border-top="0.04cm solid #4F81BD" fo:border-bottom="0.04cm solid #4F81BD" fo:padding="0.05cm" style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="MasterPage" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">Hotel bill</text:p>
      <text:p text:style-name="Subtitle">BLANK TEMPLATE | Currency: INR</text:p>
      <table:table table:name="BillingDetails">
        <table:table-column table:style-name="InfoColumn1"/>
        <table:table-column table:style-name="InfoColumn2"/>
        <table:table-row table:style-name="InfoRow">
          <table:table-cell table:style-name="CellRule"><text:p text:style-name="Key">Property</text:p></table:table-cell>
          <table:table-cell table:style-name="CellRule"><text:p text:style-name="Field">______________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InfoRow">
          <table:table-cell table:style-name="CellStripe"><text:p text:style-name="Key">Guest</text:p></table:table-cell>
          <table:table-cell table:style-name="CellStripe"><text:p text:style-name="Field">______________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InfoRow">
          <table:table-cell table:style-name="CellPlain"><text:p text:style-name="Key">Invoice / date</text:p></table:table-cell>
          <table:table-cell table:style-name="CellPlain"><text:p text:style-name="Field">______________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InfoRow">
          <table:table-cell table:style-name="CellStripe"><text:p text:style-name="Key">Room</text:p></table:table-cell>
          <table:table-cell table:style-name="CellStripe"><text:p text:style-name="Field">______________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InfoRow">
          <table:table-cell table:style-name="CellPlain"><text:p text:style-name="Key">Check-in</text:p></table:table-cell>
          <table:table-cell table:style-name="CellPlain"><text:p text:style-name="Field">______________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InfoRow">
          <table:table-cell table:style-name="CellStripe"><text:p text:style-name="Key">Check-out</text:p></table:table-cell>
          <table:table-cell table:style-name="CellStripe"><text:p text:style-name="Field">______________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InfoRow">
          <table:table-cell table:style-name="CellPlain"><text:p text:style-name="Key">Payment reference</text:p></table:table-cell>
          <table:table-cell table:style-name="CellPlain"><text:p text:style-name="Field">______________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InfoRow">
          <table:table-cell table:style-name="CellStripe"><text:p text:style-name="Key">Billing basis</text:p></table:table-cell>
          <table:table-cell table:style-name="CellStripe"><text:p text:style-name="Field">______________________________________</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p/>
      <table:table table:name="Charges">
        <table:table-column table:style-name="ItemColumn1"/>
        <table:table-column table:style-name="ItemColumn2"/>
        <table:table-column table:style-name="ItemColumn3"/>
        <table:table-column table:style-name="ItemColumn4"/>
        <table:table-row>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="TableHead">Room / service</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="TableHead">Quantity</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="TableHead">Rate (INR)</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="TableHead">Amount (INR)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ItemRow">
          <table:table-cell table:style-name="ItemBlank"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemBlank"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemBlank"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemBlank"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="SpacerRow">
          <table:table-cell table:style-name="CellPlain"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellPlain"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellPlain"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellPlain"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ItemRow">
          <table:table-cell table:style-name="ItemBlank"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemBlank"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemBlank"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemBlank"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="SpacerRow">
          <table:table-cell table:style-name="CellPlain"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellPlain"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellPlain"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellPlain"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ItemRow">
          <table:table-cell table:style-name="ItemBlank"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemBlank"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemBlank"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemBlank"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="SpacerRow">
          <table:table-cell table:style-name="CellPlain"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellPlain"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellPlain"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellPlain"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ItemRow">
          <table:table-cell table:style-name="ItemBlank"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemBlank"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemBlank"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemBlank"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Total"><text:span text:style-name="Bold">Subtotal:</text:span> INR __________</text:p>
      <text:p text:style-name="Total"><text:span text:style-name="Bold">Advance received (deduct):</text:span> INR __________</text:p>
      <text:p text:style-name="Total"><text:span text:style-name="Bold">Balance due:</text:span> INR __________</text:p>
      <text:p text:style-name="Note">Nights are entered manually from the agreed stay. The example does not calculate tax.</text:p>
      <text:p text:style-name="Note">Confirm actual charges and payments before issuing a bill.</text:p>
      <text:p text:style-name="Note">Word amounts are manual. Check line amounts and totals after every edit.</text:p>
      <text:p text:style-name="Footer">OnlineBiller | Original English resource | Blank template</text:p>
    </office:text>
  </office:body>
</office:document>