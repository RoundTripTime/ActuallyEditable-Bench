<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="120%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#000000"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.18cm" fo:line-height="120%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="28pt" fo:color="#18385F"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.40cm" fo:margin-bottom="0.18cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="BlueBold" style:family="text">
      <style:text-properties fo:font-weight="bold" fo:color="#37649A"/>
    </style:style>
    <style:style style:name="Bold" style:family="text">
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="InfoLabel" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:font-weight="bold" fo:color="#37649A"/>
    </style:style>
    <style:style style:name="InfoValue" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:color="#37649A"/>
    </style:style>
    <style:style style:name="TableHead" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:font-weight="bold" fo:color="#37649A"/>
    </style:style>
    <style:style style:name="LineText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.04cm" fo:margin-bottom="0.18cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.08cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Footer" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="9pt" fo:color="#000000"/>
    </style:style>
  </office:styles>

  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="1.4cm" fo:margin-right="1.4cm" fo:margin-top="1.5cm" fo:margin-bottom="1.4cm"/>
      <style:footer-style>
        <style:header-footer-properties fo:min-height="0.5cm" fo:margin-left="0cm" fo:margin-right="0cm" fo:margin-top="0.3cm"/>
      </style:footer-style>
    </style:page-layout>
    <style:style style:name="InfoTable" style:family="table">
      <style:table-properties table:align="margins" style:width="18.2cm"/>
    </style:style>
    <style:style style:name="InfoCol1" style:family="table-column">
      <style:table-column-properties style:column-width="9.0cm"/>
    </style:style>
    <style:style style:name="InfoCol2" style:family="table-column">
      <style:table-column-properties style:column-width="9.2cm"/>
    </style:style>
    <style:style style:name="ItemsTable" style:family="table">
      <style:table-properties table:align="margins" style:width="18.2cm"/>
    </style:style>
    <style:style style:name="ItemCol1" style:family="table-column">
      <style:table-column-properties style:column-width="7.0cm"/>
    </style:style>
    <style:style style:name="ItemCol2" style:family="table-column">
      <style:table-column-properties style:column-width="2.8cm"/>
    </style:style>
    <style:style style:name="ItemCol3" style:family="table-column">
      <style:table-column-properties style:column-width="4.0cm"/>
    </style:style>
    <style:style style:name="ItemCol4" style:family="table-column">
      <style:table-column-properties style:column-width="4.4cm"/>
    </style:style>
    <style:style style:name="InfoCell" style:family="table-cell">
      <style:table-cell-properties fo:padding-left="0.20cm" fo:padding-right="0.20cm" fo:padding-top="0.07cm" fo:padding-bottom="0.07cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="InfoStripe" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#D4E0F0" fo:padding-left="0.20cm" fo:padding-right="0.20cm" fo:padding-top="0.07cm" fo:padding-bottom="0.07cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="InfoTop" style:family="table-cell">
      <style:table-cell-properties fo:border-top="0.04cm solid #5B8AC6" fo:padding-left="0.20cm" fo:padding-right="0.20cm" fo:padding-top="0.07cm" fo:padding-bottom="0.07cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="InfoTopStripe" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#D4E0F0" fo:border-top="0.04cm solid #5B8AC6" fo:padding-left="0.20cm" fo:padding-right="0.20cm" fo:padding-top="0.07cm" fo:padding-bottom="0.07cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="InfoBottom" style:family="table-cell">
      <style:table-cell-properties fo:border-bottom="0.04cm solid #5B8AC6" fo:padding-left="0.20cm" fo:padding-right="0.20cm" fo:padding-top="0.07cm" fo:padding-bottom="0.07cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="InfoBottomStripe" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#D4E0F0" fo:border-bottom="0.04cm solid #5B8AC6" fo:padding-left="0.20cm" fo:padding-right="0.20cm" fo:padding-top="0.07cm" fo:padding-bottom="0.07cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HeadCell" style:family="table-cell">
      <style:table-cell-properties fo:border-top="0.04cm solid #5B8AC6" fo:border-bottom="0.04cm solid #5B8AC6" fo:padding-left="0.20cm" fo:padding-right="0.12cm" fo:padding-top="0.04cm" fo:padding-bottom="0.10cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="BandCell" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#D4E0F0" fo:padding-left="0.20cm" fo:padding-right="0.12cm" fo:padding-top="0.24cm" fo:padding-bottom="0.24cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="SpacerCell" style:family="table-cell">
      <style:table-cell-properties fo:padding-left="0cm" fo:padding-right="0cm" fo:padding-top="0.20cm" fo:padding-bottom="0.20cm" style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>

  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout">
      <style:footer>
        <text:p text:style-name="Footer">OnlineBiller | Original English resource | Blank template</text:p>
      </style:footer>
    </style:master-page>
  </office:master-styles>

  <office:body>
    <office:text>
      <text:p text:style-name="Title">Hotel bill</text:p>
      <text:p text:style-name="Subtitle">BLANK TEMPLATE | Currency: INR</text:p>

      <table:table table:name="Bill details" table:style-name="InfoTable">
        <table:table-column table:style-name="InfoCol1"/>
        <table:table-column table:style-name="InfoCol2"/>
        <table:table-row>
          <table:table-cell table:style-name="InfoTop"><text:p text:style-name="InfoLabel">Property</text:p></table:table-cell>
          <table:table-cell table:style-name="InfoTop"><text:p text:style-name="InfoValue">__________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="InfoStripe"><text:p text:style-name="InfoLabel">Guest</text:p></table:table-cell>
          <table:table-cell table:style-name="InfoStripe"><text:p text:style-name="InfoValue">__________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="InfoCell"><text:p text:style-name="InfoLabel">Invoice / date</text:p></table:table-cell>
          <table:table-cell table:style-name="InfoCell"><text:p text:style-name="InfoValue">__________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="InfoStripe"><text:p text:style-name="InfoLabel">Room</text:p></table:table-cell>
          <table:table-cell table:style-name="InfoStripe"><text:p text:style-name="InfoValue">__________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="InfoCell"><text:p text:style-name="InfoLabel">Check-in</text:p></table:table-cell>
          <table:table-cell table:style-name="InfoCell"><text:p text:style-name="InfoValue">__________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="InfoStripe"><text:p text:style-name="InfoLabel">Check-out</text:p></table:table-cell>
          <table:table-cell table:style-name="InfoStripe"><text:p text:style-name="InfoValue">__________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="InfoCell"><text:p text:style-name="InfoLabel">Payment reference</text:p></table:table-cell>
          <table:table-cell table:style-name="InfoCell"><text:p text:style-name="InfoValue">__________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="InfoBottomStripe"><text:p text:style-name="InfoLabel">Billing basis</text:p></table:table-cell>
          <table:table-cell table:style-name="InfoBottomStripe"><text:p text:style-name="InfoValue">__________________________________________</text:p></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="Subtitle"/>
      <table:table table:name="Room and service charges" table:style-name="ItemsTable">
        <table:table-column table:style-name="ItemCol1"/>
        <table:table-column table:style-name="ItemCol2"/>
        <table:table-column table:style-name="ItemCol3"/>
        <table:table-column table:style-name="ItemCol4"/>
        <table:table-row>
          <table:table-cell table:style-name="HeadCell"><text:p text:style-name="TableHead">Room / service</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p text:style-name="TableHead">Quantity</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p text:style-name="TableHead">Rate (INR)</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p text:style-name="TableHead">Amount (INR)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BandCell"/>
          <table:table-cell table:style-name="BandCell"/>
          <table:table-cell table:style-name="BandCell"/>
          <table:table-cell table:style-name="BandCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="SpacerCell"/>
          <table:table-cell table:style-name="SpacerCell"/>
          <table:table-cell table:style-name="SpacerCell"/>
          <table:table-cell table:style-name="SpacerCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BandCell"/>
          <table:table-cell table:style-name="BandCell"/>
          <table:table-cell table:style-name="BandCell"/>
          <table:table-cell table:style-name="BandCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="SpacerCell"/>
          <table:table-cell table:style-name="SpacerCell"/>
          <table:table-cell table:style-name="SpacerCell"/>
          <table:table-cell table:style-name="SpacerCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BandCell"/>
          <table:table-cell table:style-name="BandCell"/>
          <table:table-cell table:style-name="BandCell"/>
          <table:table-cell table:style-name="BandCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="SpacerCell"/>
          <table:table-cell table:style-name="SpacerCell"/>
          <table:table-cell table:style-name="SpacerCell"/>
          <table:table-cell table:style-name="SpacerCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BandCell"/>
          <table:table-cell table:style-name="BandCell"/>
          <table:table-cell table:style-name="BandCell"/>
          <table:table-cell table:style-name="BandCell"/>
        </table:table-row>
      </table:table>

      <text:p text:style-name="LineText"><text:span text:style-name="Bold">Subtotal:</text:span> INR __________</text:p>
      <text:p text:style-name="LineText"><text:span text:style-name="Bold">Advance received (deduct):</text:span> INR __________</text:p>
      <text:p text:style-name="LineText"><text:span text:style-name="Bold">Balance due:</text:span> INR __________</text:p>
      <text:p text:style-name="Note">Nights are entered manually from the agreed stay. The example does not calculate tax.</text:p>
      <text:p text:style-name="Note">Confirm actual charges and payments before issuing a bill.</text:p>
      <text:p text:style-name="Note">Word amounts are manual. Check line amounts and totals after every edit.</text:p>
    </office:text>
  </office:body>
</office:document>