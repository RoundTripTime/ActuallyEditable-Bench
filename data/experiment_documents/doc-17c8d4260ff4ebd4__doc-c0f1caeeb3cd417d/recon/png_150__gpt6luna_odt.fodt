<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:default-style>
    <style:style style:name="Table" style:family="table">
      <style:table-properties style:width="153mm" table:align="left" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ContentColumn" style:family="table-column">
      <style:table-column-properties style:column-width="117mm"/>
    </style:style>
    <style:style style:name="ResultColumn" style:family="table-column">
      <style:table-column-properties style:column-width="36mm"/>
    </style:style>
    <style:style style:name="HeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="1.5mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="InputCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="10mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right"/>
    </style:style>
    <style:style style:name="FormLabel" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="7mm"/>
    </style:style>
    <style:style style:name="MainTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="2mm" fo:margin-bottom="3mm"/>
    </style:style>
    <style:style style:name="Intro" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="2mm" fo:margin-bottom="8mm"/>
    </style:style>
    <style:style style:name="BlockDate" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="87mm" fo:margin-top="0mm" fo:margin-bottom="2mm"/>
    </style:style>
    <style:style style:name="BlockName" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="87mm" fo:margin-bottom="1mm"/>
    </style:style>
    <style:style style:name="BlockRep" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="87mm" fo:margin-bottom="1mm"/>
    </style:style>
    <style:style style:name="GroupSpace" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="8mm" fo:margin-bottom="0mm"/>
    </style:style>
    <style:style style:name="Signer" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="9mm" fo:margin-bottom="8mm"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="3mm"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" style:print-orientation="portrait" fo:margin-left="25mm" fo:margin-right="25mm" fo:margin-top="25mm" fo:margin-bottom="20mm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="FormLabel">様式第４号（第２条関係）</text:p>
      <text:p text:style-name="MainTitle">協　議　書</text:p>
      <text:p>霧島市長　殿</text:p>
      <text:p text:style-name="Intro">____________地区の伐採については、次のとおり協議しました。</text:p>

      <text:p text:style-name="BlockDate">協　議　日　　　　年　　月　　日</text:p>
      <text:p text:style-name="BlockName">団　体　名</text:p>
      <text:p text:style-name="BlockRep">代表者名　　　　　　　　　　　　　　　　　　　　　　印</text:p>
      <table:table table:name="協議欄1" table:style-name="Table">
        <table:table-column table:style-name="ContentColumn"/>
        <table:table-column table:style-name="ResultColumn"/>
        <table:table-row>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="Center">協　議　内　容</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="Center">協　議　結　果</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="InputCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="Center">承認　・　否認</text:p></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="GroupSpace"/>
      <text:p text:style-name="BlockDate">協　議　日　　　　年　　月　　日</text:p>
      <text:p text:style-name="BlockName">団　体　名</text:p>
      <text:p text:style-name="BlockRep">代表者名　　　　　　　　　　　　　　　　　　　　　　印</text:p>
      <table:table table:name="協議欄2" table:style-name="Table">
        <table:table-column table:style-name="ContentColumn"/>
        <table:table-column table:style-name="ResultColumn"/>
        <table:table-row>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="Center">協　議　内　容</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="Center">協　議　結　果</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="InputCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="Center">承認　・　否認</text:p></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="GroupSpace"/>
      <text:p text:style-name="BlockDate">協　議　日　　　　年　　月　　日</text:p>
      <text:p text:style-name="BlockName">団　体　名</text:p>
      <text:p text:style-name="BlockRep">代表者名　　　　　　　　　　　　　　　　　　　　　　印</text:p>
      <table:table table:name="協議欄3" table:style-name="Table">
        <table:table-column table:style-name="ContentColumn"/>
        <table:table-column table:style-name="ResultColumn"/>
        <table:table-row>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="Center">協　議　内　容</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="Center">協　議　結　果</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="InputCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="Center">承認　・　否認</text:p></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="Signer">協　議　者　　　　　　　　　　　　　　　　　　　　印</text:p>
      <text:p text:style-name="Note">※この協議書は、団体及び代表者に責任を問うものではありません。</text:p>
      <text:p text:style-name="PageBreak"/>
    </office:text>
  </office:body>
</office:document>