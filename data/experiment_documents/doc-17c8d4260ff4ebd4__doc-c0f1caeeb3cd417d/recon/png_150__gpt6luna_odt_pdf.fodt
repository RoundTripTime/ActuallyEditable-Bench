<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:default-style>
    <style:style style:name="Standard" style:family="paragraph"/>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="A4Layout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="2.5cm" fo:margin-right="2.5cm" fo:margin-top="2.5cm" fo:margin-bottom="2.5cm"/>
    </style:page-layout>
    <style:style style:name="TopMeta" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.12cm"/>
    </style:style>
    <style:style style:name="MainTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.15cm" fo:margin-bottom="0.4cm"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="Intro" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.15cm" fo:margin-bottom="0.8cm"/>
    </style:style>
    <style:style style:name="RightLine" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-bottom="0.15cm"/>
    </style:style>
    <style:style style:name="TableHeading" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="TableBody" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="TableBodyCenter" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Signature" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0.55cm" fo:margin-bottom="0.8cm"/>
      <style:text-properties style:text-underline-style="solid"/>
    </style:style>
    <style:style style:name="Footnote" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.2cm"/>
    </style:style>
    <style:style style:name="NewPage" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
    <style:style style:name="ColMain" style:family="table-column">
      <style:table-column-properties style:column-width="11.7cm"/>
    </style:style>
    <style:style style:name="ColResult" style:family="table-column">
      <style:table-column-properties style:column-width="3.65cm"/>
    </style:style>
    <style:style style:name="Grid" style:family="table">
      <style:table-properties style:width="15.35cm" table:align="left" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="GridCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.05cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="GridHeadCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.05cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HeadRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.75cm"/>
    </style:style>
    <style:style style:name="InputRow" style:family="table-row">
      <style:table-row-properties style:row-height="2.3cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="A4Layout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="TopMeta">様式第４号（第２条関係）</text:p>
      <text:p text:style-name="MainTitle">協<text:s/>議<text:s/>書</text:p>
      <text:p text:style-name="TopMeta">霧島市長<text:s/>殿</text:p>
      <text:p text:style-name="Intro"><text:span text:style-name="Signature">　　</text:span>地区の伐採については、次のとおり協議しました。</text:p>

      <text:p text:style-name="RightLine">協<text:s/>議<text:s/>日<text:s c="6"/>年<text:s c="3"/>月<text:s c="3"/>日</text:p>
      <text:p text:style-name="RightLine"><text:s c="9"/>団<text:s/>体<text:s/>名</text:p>
      <text:p text:style-name="RightLine">代表者名<text:s c="13"/>印</text:p>
      <table:table table:name="協議欄1" table:style-name="Grid">
        <table:table-column table:style-name="ColMain"/>
        <table:table-column table:style-name="ColResult"/>
        <table:table-row table:style-name="HeadRow">
          <table:table-cell table:style-name="GridHeadCell"><text:p text:style-name="TableHeading">協<text:s/>議<text:s/>内<text:s/>容</text:p></table:table-cell>
          <table:table-cell table:style-name="GridHeadCell"><text:p text:style-name="TableHeading">協<text:s/>議<text:s/>結<text:s/>果</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableBodyCenter">承認<text:s c="3"/>・<text:s c="3"/>否認</text:p></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="RightLine">協<text:s/>議<text:s/>日<text:s c="6"/>年<text:s c="3"/>月<text:s c="3"/>日</text:p>
      <text:p text:style-name="RightLine"><text:s c="9"/>団<text:s/>体<text:s/>名</text:p>
      <text:p text:style-name="RightLine">代表者名<text:s c="13"/>印</text:p>
      <table:table table:name="協議欄2" table:style-name="Grid">
        <table:table-column table:style-name="ColMain"/>
        <table:table-column table:style-name="ColResult"/>
        <table:table-row table:style-name="HeadRow">
          <table:table-cell table:style-name="GridHeadCell"><text:p text:style-name="TableHeading">協<text:s/>議<text:s/>内<text:s/>容</text:p></table:table-cell>
          <table:table-cell table:style-name="GridHeadCell"><text:p text:style-name="TableHeading">協<text:s/>議<text:s/>結<text:s/>果</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableBodyCenter">承認<text:s c="3"/>・<text:s c="3"/>否認</text:p></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="RightLine">協<text:s/>議<text:s/>日<text:s c="6"/>年<text:s c="3"/>月<text:s c="3"/>日</text:p>
      <text:p text:style-name="RightLine"><text:s c="9"/>団<text:s/>体<text:s/>名</text:p>
      <text:p text:style-name="RightLine">代表者名<text:s c="13"/>印</text:p>
      <table:table table:name="協議欄3" table:style-name="Grid">
        <table:table-column table:style-name="ColMain"/>
        <table:table-column table:style-name="ColResult"/>
        <table:table-row table:style-name="HeadRow">
          <table:table-cell table:style-name="GridHeadCell"><text:p text:style-name="TableHeading">協<text:s/>議<text:s/>内<text:s/>容</text:p></table:table-cell>
          <table:table-cell table:style-name="GridHeadCell"><text:p text:style-name="TableHeading">協<text:s/>議<text:s/>結<text:s/>果</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableBodyCenter">承認<text:s c="3"/>・<text:s c="3"/>否認</text:p></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="Signature">協<text:s/>議<text:s/>者<text:s c="26"/>印</text:p>
      <text:p text:style-name="Footnote">※この協議書は、団体及び代表者に責任を問うものではありません。</text:p>
      <text:p text:style-name="NewPage"/>
    </office:text>
  </office:body>
</office:document>