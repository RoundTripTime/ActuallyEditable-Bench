<?xml version="1.0" encoding="UTF-8"?>
<office:document
    xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
    xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
    xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
    office:mimetype="application/vnd.oasis.opendocument.text"
    office:version="1.4">

  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#252723"/>
    </style:default-style>

    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%" fo:margin-bottom="12pt"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="28pt" fo:color="#252723"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="7pt"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="7pt"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="3pt" fo:margin-bottom="8pt"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="15pt" fo:color="#915039"/>
    </style:style>
    <style:style style:name="Bullet" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="18pt" fo:margin-bottom="5pt"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="ReviewBullet" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="18pt" fo:margin-bottom="5pt"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Disclaimer" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="7pt" fo:margin-bottom="0pt"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Footer" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="180pt"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt"/>
    </style:style>

    <style:style style:name="ProjectTitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="18pt"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="15pt" fo:color="#915039"/>
    </style:style>
    <style:style style:name="ProjectHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0pt" fo:margin-bottom="7pt"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="12.5pt" fo:font-weight="bold" fo:color="#252723"/>
    </style:style>
    <style:style style:name="ProjectBody" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="8pt"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="ProjectPrompt" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="34pt"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="ProjectStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-bottom="18pt"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="15pt" fo:color="#915039"/>
    </style:style>
    <style:style style:name="LastProjectPrompt" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="10pt"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="PageTwoFooter" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0pt"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt"/>
    </style:style>
  </office:styles>

  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="8.5in" fo:page-height="11in" fo:margin-left="0.7in" fo:margin-right="0.7in" fo:margin-top="0.7in" fo:margin-bottom="0.7in" style:print-orientation="portrait"/>
    </style:page-layout>
  </office:automatic-styles>

  <office:master-styles>
    <style:master-page style:name="DefaultPage" style:page-layout-name="PageLayout"/>
  </office:master-styles>

  <office:body>
    <office:text>
      <text:p text:style-name="Title">Interior design presentation templates (PPTX and DOCX)</text:p>
      <text:p text:style-name="Subtitle">Blank editable template</text:p>
      <text:p text:style-name="Body">OpenLintel • Educational planning resource • September 27, 2026</text:p>
      <text:p text:style-name="Body">Illustrative teaching extension of The Window Room: not a client record, supplier quote, site survey, or construction-ready document. Pending professional review.</text:p>

      <text:p text:style-name="Section">How to use</text:p>
      <text:p text:style-name="Body">Download the blank PPTX and replace its editable text, palette swatches, diagram shapes and image placeholders. The worked PPTX and PDF preview show the illustrative Window Room. The companion DOCX is a planning storyboard. You can also import the PPTX into Google Slides; check fonts, image crops and line breaks again after adding your own material. After presenting, write a separate decision record; do not treat slide comments or image selection as blanket approval.</text:p>
      <text:p text:style-name="Bullet">•　Write the decision request before arranging images.</text:p>
      <text:p text:style-name="Bullet">•　Use consistent references and comparable views for alternatives.</text:p>
      <text:p text:style-name="Bullet">•　Record feedback against the relevant decision rather than relying on presentation notes alone.</text:p>

      <text:p text:style-name="Section">Review before use</text:p>
      <text:p text:style-name="ReviewBullet">•　Do not request blanket approval of a mixed-status package.</text:p>
      <text:p text:style-name="ReviewBullet">•　Do not hide unresolved cost or dimensional questions behind polished visuals.</text:p>
      <text:p text:style-name="ReviewBullet">•　Do not label concept imagery as completed client work.</text:p>
      <text:p text:style-name="Disclaimer">Replace illustrative information with verified project records. No approval, legal agreement, or construction readiness is represented. Keep completed client documents in your own secure system.</text:p>
      <text:p text:style-name="Footer">OpenLintel • Planning resource • 1</text:p>

      <text:p text:style-name="ProjectStart">Your project</text:p>
      <text:p text:style-name="ProjectHeading">Opening: purpose of the review</text:p>
      <text:p text:style-name="ProjectBody">Explain what the client is being asked to decide today and what is not yet ready for approval.</text:p>
      <text:p text:style-name="ProjectPrompt">[Enter your project information here. Leave unknowns explicit.]</text:p>

      <text:p text:style-name="ProjectHeading">Brief recap</text:p>
      <text:p text:style-name="ProjectBody">Show the essential needs and retained conditions before proposing a solution.</text:p>
      <text:p text:style-name="ProjectPrompt">[Enter your project information here. Leave unknowns explicit.]</text:p>

      <text:p text:style-name="ProjectHeading">Existing information</text:p>
      <text:p text:style-name="ProjectBody">Place a plan or survey image with its source and status clearly labeled.</text:p>
      <text:p text:style-name="ProjectPrompt">[Enter your project information here. Leave unknowns explicit.]</text:p>

      <text:p text:style-name="ProjectHeading">Selected direction</text:p>
      <text:p text:style-name="ProjectBody">Place the concept image and explain how the proposal responds to the brief.</text:p>
      <text:p text:style-name="ProjectPrompt">[Enter your project information here. Leave unknowns explicit.]</text:p>

      <text:p text:style-name="ProjectHeading">Alternative and tradeoff</text:p>
      <text:p text:style-name="ProjectBody">Compare a specific decision on equal terms; do not change multiple constraints invisibly.</text:p>
      <text:p text:style-name="ProjectPrompt">[Enter your project information here. Leave unknowns explicit.]</text:p>

      <text:p text:style-name="ProjectHeading">Layout and references</text:p>
      <text:p text:style-name="ProjectBody">Show a readable plan and identify the items discussed. Label the drawing’s status.</text:p>
      <text:p text:style-name="ProjectPrompt">[Enter your project information here. Leave unknowns explicit.]</text:p>

      <text:p text:style-name="ProjectHeading">Materials and open questions</text:p>
      <text:p text:style-name="ProjectBody">Separate the proposed visual palette from verified product selections.</text:p>
      <text:p text:style-name="ProjectPrompt">[Enter your project information here. Leave unknowns explicit.]</text:p>

      <text:p text:style-name="ProjectHeading">Decision and next steps</text:p>
      <text:p text:style-name="ProjectBody">List the requested decision, person responsible, and information needed for the next review.</text:p>
      <text:p text:style-name="LastProjectPrompt">[Enter your project information here. Leave unknowns explicit.]</text:p>
      <text:p text:style-name="PageTwoFooter">OpenLintel • Planning resource • 2</text:p>
    </office:text>
  </office:body>
</office:document>