          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">避難設備</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">消火活動上必要な施設</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
