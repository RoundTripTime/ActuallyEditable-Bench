      <text:p text:style-name="Title">別紙</text:p>
      <table:table table:name="Form1" table:style-name="FormTable">
        <table:table-column table:style-name="Column1"/>
        <table:table-column table:style-name="Column2"/>
        <table:table-column table:style-name="Column3"/>
        <table:table-column table:style-name="Column4"/>
        <table:table-column table:style-name="Column5"/>
        <table:table-row table:style-name="Row1">
          <table:table-cell table:style-name="CellOuter" table:number-rows-spanned="7"><text:p text:style-name="VerticalText">死</text:p><text:p text:style-name="VerticalText">亡</text:p><text:p text:style-name="VerticalText">者</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText">本籍</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="Row2">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText">住所</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="Row3">
          <table:covered-table-cell/>
