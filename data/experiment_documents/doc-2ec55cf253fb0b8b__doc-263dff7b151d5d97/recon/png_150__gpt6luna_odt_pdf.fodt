          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="Row4">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText">性別</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">男・女・不詳</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">続柄</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellRight">（死亡者から見た申請者との続柄）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="Row5">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText">死亡年月日</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="CellCenter">年　月　日・不詳</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="Row6">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText">埋葬又は火葬の年月日</text:p></table:table-cell>
