<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin="0mm" fo:line-height="normal"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin="0mm" fo:margin-bottom="5mm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Label" style:family="paragraph">
      <style:paragraph-properties fo:text-align="justify" fo:margin="0mm" fo:line-height="normal"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Centered" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin="0mm" fo:line-height="normal"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end" fo:margin="0mm" fo:line-height="normal"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" fo:margin-top="18mm" fo:margin-bottom="18mm" fo:margin-left="15mm" fo:margin-right="15mm"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="180mm" table:align="margins" table:border-model="collapsing" style:margin-bottom="2mm" style:may-break-between-rows="false"/>
    </style:style>
    <style:style style:name="C1" style:family="table-column">
      <style:table-column-properties style:column-width="8mm"/>
    </style:style>
    <style:style style:name="C2" style:family="table-column">
      <style:table-column-properties style:column-width="38mm"/>
    </style:style>
    <style:style style:name="C3" style:family="table-column">
      <style:table-column-properties style:column-width="31mm"/>
    </style:style>
    <style:style style:name="C4" style:family="table-column">
      <style:table-column-properties style:column-width="16mm"/>
    </style:style>
    <style:style style:name="C5" style:family="table-column">
      <style:table-column-properties style:column-width="87mm"/>
    </style:style>
    <style:style style:name="RowNormal" style:family="table-row">
      <style:table-row-properties style:row-height="7.3mm"/>
    </style:style>
    <style:style style:name="RowLast" style:family="table-row">
      <style:table-row-properties style:row-height="11.2mm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.6pt solid #000000" fo:padding="0.8mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="VerticalCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.6pt solid #000000" fo:padding="0.4mm" style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">別紙</text:p>
      <table:table table:name="Form1" table:style-name="FormTable">
        <table:table-column table:style-name="C1"/>
        <table:table-column table:style-name="C2"/>
        <table:table-column table:style-name="C3"/>
        <table:table-column table:style-name="C4"/>
        <table:table-column table:style-name="C5"/>
        <table:table-row table:style-name="RowNormal">
          <table:table-cell table:style-name="VerticalCell" table:number-rows-spanned="7"><text:p text:style-name="Centered">死<text:line-break/>亡<text:line-break/>者</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Label">本籍</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"/>
        </table:table-row>
        <table:table-row table:style-name="RowNormal">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Label">住所</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"/>
        </table:table-row>
        <table:table-row table:style-name="RowNormal">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Label">氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"/>
        </table:table-row>
        <table:table-row table:style-name="RowNormal">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Label">性別</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">男・女・不詳</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">続柄</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">(死亡者から見た申請者との続柄)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowNormal">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Label">死亡年月日</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Centered">年　月　日・不詳</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowNormal">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Label">埋葬又は火葬の年月日</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Centered">年　月　日・不詳</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowLast">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Label">埋葬又は火葬の場所</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Right">（名称：　　　　）</text:p></table:table-cell>
        </table:table-row>
