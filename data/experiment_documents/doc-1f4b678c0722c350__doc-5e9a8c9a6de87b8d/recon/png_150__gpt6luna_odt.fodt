    </style:style>
    <style:style style:name="PageBreakPortrait" style:family="paragraph" style:master-page-name="Portrait">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
    <style:style style:name="PageBreakLandscape" style:family="paragraph" style:master-page-name="Landscape">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
    <style:style style:name="Bold" style:family="text">
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Table" style:family="table">
      <style:table-properties table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="3.25in"/>
    </style:style>
    <style:style style:name="ColWide" style:family="table-column">
      <style:table-column-properties style:column-width="1.90in"/>
    </style:style>
    <style:style style:name="ColNarrow" style:family="table-column">
      <style:table-column-properties style:column-width="1.78in"/>
    </style:style>
    <style:style style:name="HeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#d9d9d9" fo:border="0.5pt solid #222222" fo:padding="0.08in" style:vertical-align="top"/>
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="PromptCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #222222" fo:padding="0.10in" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="BlankCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #222222" fo:padding="0.10in" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="CategoryCell" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#d9d9d9" fo:border="0.5pt solid #222222" fo:padding="0.08in" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="DataCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #222222" fo:padding="0.06in" style:vertical-align="top"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PagePortrait">
      <style:page-layout-properties fo:page-width="8.5in" fo:page-height="11in" style:print-orientation="portrait" fo:margin="0.7in"/>
    </style:page-layout>
    <style:page-layout style:name="PageLandscape">
      <style:page-layout-properties fo:page-width="11in" fo:page-height="8.5in" style:print-orientation="landscape" fo:margin="0.65in"/>
    </style:page-layout>
    <style:style style:name="PortraitBreak" style:family="paragraph" style:master-page-name="Portrait">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
    <style:style style:name="LandscapeBreak" style:family="paragraph" style:master-page-name="Landscape">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
    <style:style style:name="AssessmentTable" style:family="table">
      <style:table-properties table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="WideTable" style:family="table">
      <style:table-properties table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="AssessCol" style:family="table-column">
      <style:table-column-properties style:column-width="3.25in"/>
    </style:style>
    <style:style style:name="WideCol1" style:family="table-column">
      <style:table-column-properties style:column-width="1.80in"/>
    </style:style>
    <style:style style:name="WideCol" style:family="table-column">
