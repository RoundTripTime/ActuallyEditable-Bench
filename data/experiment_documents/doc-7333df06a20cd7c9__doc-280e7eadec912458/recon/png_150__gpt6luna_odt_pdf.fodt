<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:font-size="10pt" fo:line-height="115%"/>
      <style:text-properties fo:font-family="serif" style:font-name="serif"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="1.2cm" fo:margin-bottom="0.8cm"/>
      <style:text-properties fo:font-family="serif" style:font-name="serif" fo:font-size="20pt"/>
    </style:style>
    <style:style style:name="Label" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin="0cm"/>
      <style:text-properties fo:font-family="serif" style:font-name="serif" fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm"/>
      <style:text-properties fo:font-family="serif" style:font-name="serif" fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="NoteTitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.7cm"/>
      <style:text-properties fo:font-family="serif" style:font-name="serif" fo:font-size="13pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="1.4cm" fo:margin-right="1.2cm" fo:margin-top="0cm" fo:margin-bottom="0.25cm" fo:line-height="150%"/>
      <style:text-properties fo:font-family="serif" style:font-name="serif" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="NoteBold" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="1.2cm" fo:margin-right="1cm" fo:margin-top="0.5cm" fo:margin-bottom="0.6cm" fo:line-height="150%"/>
      <style:text-properties fo:font-family="serif" style:font-name="serif" fo:font-size="11pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="PageTwo" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin="0cm"/>
    </style:style>
    <style:style style:name="Grid" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="GridHeavy" style:family="table-cell">
      <style:table-cell-properties fo:border="1.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Col" style:family="table-column">
      <style:table-column-properties style:column-width="2.25cm"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties table:align="margins" style:width="27cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="29.7cm" fo:page-height="21cm" style:print-orientation="landscape" fo:margin-left="1.2cm" fo:margin-right="1.2cm" fo:margin-top="1.1cm" fo:margin-bottom="1.1cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">前　歴　報　告　書</text:p>
      <table:table table:name="履歴報告書" table:style-name="FormTable">
        <table:table-column table:style-name="Col" table:number-columns-repeated="12"/>
        <table:table-row>
          <table:table-cell table:number-columns-spanned="6"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="2"><text:p text:style-name="Label">長期組合員番号</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Grid"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Grid"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Grid"><text:p/></table:table-cell>
