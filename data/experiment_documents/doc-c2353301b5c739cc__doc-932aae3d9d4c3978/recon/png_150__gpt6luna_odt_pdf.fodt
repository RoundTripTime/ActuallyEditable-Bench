<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt" fo:font-family="sans-serif"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0.1cm"/>
      <style:text-properties fo:font-size="20pt" fo:font-weight="bold" fo:font-family="sans-serif"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt" fo:font-family="sans-serif"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt" fo:font-family="sans-serif"/>
    </style:style>
    <style:style style:name="Big" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.12cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-size="15pt" fo:font-weight="bold" fo:font-family="sans-serif"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="1pt"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="middle"/>
      <style:text-properties fo:font-size="9pt" fo:font-family="sans-serif"/>
    </style:style>
    <style:style style:name="CellSmall" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.04cm" style:vertical-align="middle"/>
      <style:text-properties fo:font-size="8pt" fo:font-family="sans-serif"/>
    </style:style>
    <style:style style:name="Shade" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.05cm" style:vertical-align="middle" fo:background-color="#d9d9d9"/>
      <style:text-properties fo:font-size="9pt" fo:font-weight="bold" fo:font-family="sans-serif"/>
    </style:style>
    <style:style style:name="Col" style:family="table-column">
      <style:table-column-properties style:column-width="1cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="Page">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1cm" fo:margin-bottom="1cm" fo:margin-left="1.5cm" fo:margin-right="1.5cm"/>
    </style:page-layout>
    <style:style style:name="C1" style:family="table-column"><style:table-column-properties style:column-width="0.9cm"/></style:style>
    <style:style style:name="C2" style:family="table-column"><style:table-column-properties style:column-width="2.5cm"/></style:style>
    <style:style style:name="C3" style:family="table-column"><style:table-column-properties style:column-width="6.4cm"/></style:style>
    <style:style style:name="C4" style:family="table-column"><style:table-column-properties style:column-width="1.8cm"/></style:style>
    <style:style style:name="C5" style:family="table-column"><style:table-column-properties style:column-width="5.5cm"/></style:style>
    <style:style style:name="D1" style:family="table-column"><style:table-column-properties style:column-width="0.9cm"/></style:style>
    <style:style style:name="D2" style:family="table-column"><style:table-column-properties style:column-width="3cm"/></style:style>
    <style:style style:name="D3" style:family="table-column"><style:table-column-properties style:column-width="4cm"/></style:style>
    <style:style style:name="D4" style:family="table-column"><style:table-column-properties style:column-width="4cm"/></style:style>
    <style:style style:name="D5" style:family="table-column"><style:table-column-properties style:column-width="4cm"/></style:style>
    <style:style style:name="D6" style:family="table-column"><style:table-column-properties style:column-width="4cm"/></style:style>
    <style:style style:name="D7" style:family="table-column"><style:table-column-properties style:column-width="4cm"/></style:style>
    <style:style style:name="D8" style:family="table-column"><style:table-column-properties style:column-width="4cm"/></style:style>
    <style:style style:name="E1" style:family="table-column"><style:table-column-properties style:column-width="0.9cm"/></style:style>
    <style:style style:name="E2" style:family="table-column"><style:table-column-properties style:column-width="1.2cm"/></style:style>
    <style:style style:name="E3" style:family="table-column"><style:table-column-properties style:column-width="2.8cm"/></style:style>
    <style:style style:name="E4" style:family="table-column"><style:table-column-properties style:column-width="2.8cm"/></style:style>
    <style:style style:name="E5" style:family="table-column"><style:table-column-properties style:column-width="2.8cm"/></style:style>
    <style:style style:name="E6" style:family="table-column"><style:table-column-properties style:column-width="2.8cm"/></style:style>
    <style:style style:name="E7" style:family="table-column"><style:table-column-properties style:column-width="2.8cm"/></style:style>
    <style:style style:name="E8" style:family="table-column"><style:table-column-properties style:column-width="2.8cm"/></style:style>
    <style:style style:name="E9" style:family="table-column"><style:table-column-properties style:column-width="2.8cm"/></style:style>
    <style:style style:name="E10" style:family="table-column"><style:table-column-properties style:column-width="2.8cm"/></style:style>
    <style:style style:name="E11" style:family="table-column"><style:table-column-properties style:column-width="2.8cm"/></style:style>
    <style:style style:name="E12" style:family="table-column"><style:table-column-properties style:column-width="2.8cm"/></style:style>
    <style:style style:name="E13" style:family="table-column"><style:table-column-properties style:column-width="2.8cm"/></style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="Page"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Right">別記様式第２５号その１</text:p>
      <text:p text:style-name="Title">税証明書交付請求書</text:p>
      <text:p text:style-name="P">毛呂山町長　あて</text:p>
      <text:p text:style-name="Right">年　　月　　日</text:p>
      <table:table table:name="請求者と証明対象者">
        <table:table-column table:style-name="C1"/>
        <table:table-column table:style-name="C2"/>
        <table:table-column table:style-name="C3"/>
        <table:table-column table:style-name="C4"/>
        <table:table-column table:style-name="C5"/>
        <table:table-row>
          <table:table-cell table:style-name="Shade" table:number-rows-spanned="4"><text:p text:style-name="Center">①</text:p><text:p text:style-name="Center">窓口に来た人</text:p><text:p text:style-name="Center">（請求者）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">現住所</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"/>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">フリガナ</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"/>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">氏　名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">生年月日</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">年　　月　　日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">証明してほしい人との関係</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>□ 本　人　　□ 同一世帯の親族</text:p><text:p>□ 代理人　　□ 他（　　　　　　　　　）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">電　話</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Shade" table:number-rows-spanned="3"><text:p text:style-name="Center">②</text:p><text:p text:style-name="Center">証明してほしい人</text:p><text:p text:style-name="Center">（証明対象者）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">住　所</text:p><text:p text:style-name="Center">（１月１日時点）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p>□①と同じ</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">フリガナ</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="1"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">生年月日</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">年　　月　　日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">氏　名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>□①と同じ</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="P">※請求者の身分証明書等を提示してください。</text:p>
      <text:p text:style-name="P">※請求者が本人、同一世帯の親族以外の場合は、委任状が必要です。</text:p>
      <text:p text:style-name="P">（継続検査用納税証明書および営業証明書「法人用・車庫証明用」は除く。）</text:p>
      <text:p text:style-name="Big">③ 必要な証明書等に〇をつけて、「年度」、「通数」等を記入してください。</text:p>
      <table:table table:name="住民税">
        <table:table-column table:style-name="E1"/><table:table-column table:style-name="E2"/><table:table-column table:style-name="E3"/><table:table-column table:style-name="E4"/><table:table-column table:style-name="E5"/><table:table-column table:style-name="E6"/><table:table-column table:style-name="E7"/><table:table-column table:style-name="E8"/><table:table-column table:style-name="E9"/><table:table-column table:style-name="E10"/><table:table-column table:style-name="E11"/><table:table-column table:style-name="E12"/><table:table-column table:style-name="E13"/>
        <table:table-row>
          <table:table-cell table:style-name="Shade" table:number-rows-spanned="3"><text:p text:style-name="Center">住民税</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">1</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="7"><text:p>所得（非）課税証明書</text:p><text:p>※課税決定前の請求・発行の場合は、【所得証明】となります。</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Right">年度（　　年分所得）</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">2</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="7"><text:p>住民税申告書の写し</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Right">通</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">3</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="7"><text:p>営業証明書（法人用・車庫証明用・開業届出済の個人事業用）</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Right">通</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <table:table table:name="固定資産税">
        <table:table-column table:style-name="E1"/><table:table-column table:style-name="E2"/><table:table-column table:style-name="E3"/><table:table-column table:style-name="E4"/><table:table-column table:style-name="E5"/><table:table-column table:style-name="E6"/><table:table-column table:style-name="E7"/><table:table-column table:style-name="E8"/><table:table-column table:style-name="E9"/><table:table-column table:style-name="E10"/><table:table-column table:style-name="E11"/><table:table-column table:style-name="E12"/><table:table-column table:style-name="E13"/>
        <table:table-row>
          <table:table-cell table:style-name="Shade" table:number-rows-spanned="8"><text:p text:style-name="Center">固定資産税</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">1</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p>評価証明書（ 全部 ・ 一部 ）</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4" table:number-rows-spanned="4"><text:p>※名寄せの閲覧・コピー（公印なし）</text:p><text:p>については別の申請書をご使用ください。</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Right">年度</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">2</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p>公課証明書（ 全部 ・ 一部 ）</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Right">通</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">3</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p>資産証明書（ 全部 ・ 一部 ）</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Right">通</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">4</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p>名寄証明書</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Shade" table:number-columns-spanned="12"><text:p text:style-name="Center">不動産の所在地（評価、公課、資産証明で一部に〇をした場合のみ記入）</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">物件区分</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">大字</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">番地</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">物件区分</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">大字</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">番地</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="6"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>土地・家屋</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"><text:p>土地・家屋</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell" table:number-columns-spanned="6"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>土地・家屋</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"><text:p>土地・家屋</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell" table:number-columns-spanned="6"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
      </table:table>
      <table:table table:name="納税証明書">
        <table:table-column table:style-name="E1"/><table:table-column table:style-name="E2"/><table:table-column table:style-name="E3"/><table:table-column table:style-name="E4"/><table:table-column table:style-name="E5"/><table:table-column table:style-name="E6"/><table:table-column table:style-name="E7"/><table:table-column table:style-name="E8"/><table:table-column table:style-name="E9"/><table:table-column table:style-name="E10"/><table:table-column table:style-name="E11"/><table:table-column table:style-name="E12"/><table:table-column table:style-name="E13"/>
        <table:table-row>
          <table:table-cell table:style-name="Shade" table:number-rows-spanned="4"><text:p text:style-name="Center">納税証明書</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">1</text:p><text:p text:style-name="Center">※必要な税目に〇を</text:p><text:p text:style-name="Center">つけてください。</text:p></table:table-cell>
