<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:font-size="9pt" fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="20pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:line-height="0pt" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Bold" style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="NarrowCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.02cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="SectionCell" style:family="table-cell">
      <style:table-cell-properties fo:border="1.2pt solid #000000" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="GrayCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.04cm" fo:background-color="#D9D9D9" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="GridTable" style:family="table">
      <style:table-properties style:width="19cm" table:align="left"/>
    </style:style>
    <style:style style:name="Col" style:family="table-column">
      <style:table-column-properties style:column-width="1.58cm"/>
    </style:style>
    <style:style style:name="Tiny" style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-top="0.8cm" fo:margin-bottom="0.8cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Tiny">別記様式第２５号その１</text:p>
      <text:p text:style-name="Title">税証明書交付請求書</text:p>
      <text:p text:style-name="Body">毛呂山町長　あて　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　年　　　月　　　日</text:p>
      <table:table table:name="Applicant" table:style-name="GridTable">
        <table:table-column table:style-name="Col" table:number-columns-repeated="12"/>
        <table:table-row>
          <table:table-cell table:style-name="SectionCell" table:number-rows-spanned="4"><text:p text:style-name="Center">①</text:p><text:p text:style-name="Center">窓口に</text:p><text:p text:style-name="Center">来た人</text:p><text:p text:style-name="Center">（請求者）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">現住所</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="9"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">フリガナ</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">生年月日</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">年　　　月　　　日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">氏　名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Tiny">証明してほしい人との関係</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p>□ 本　人　　 □ 同一世帯の親族</text:p><text:p>□ 代理人　　 □ 他（　　　　　　　　　）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="1"><text:p text:style-name="Center">電話</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="SectionCell" table:number-rows-spanned="3"><text:p text:style-name="Center">②</text:p><text:p text:style-name="Center">証明して</text:p><text:p text:style-name="Center">ほしい人</text:p><text:p text:style-name="Center">（証明対象者）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">住　所</text:p><text:p text:style-name="Tiny">（１月１日時点）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="9"><text:p>□①と同じ</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">フリガナ</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">生年月日</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">年　　　月　　　日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">氏　名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p>□①と同じ</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Tiny">※請求者の身分証明書等を提示してください。</text:p>
      <text:p text:style-name="Tiny">※請求者が本人、同一世帯の親族以外の場合は、委任状が必要です。</text:p>
      <text:p text:style-name="Tiny">（継続検査用納税証明書および営業証明書［法人用・車庫証明用］は除く。）</text:p>
      <text:p text:style-name="Bold">③ 必要な証明書等に○をつけて、「年度」、「通数」等を記入してください。</text:p>
      <table:table table:name="ResidentTax" table:style-name="GridTable">
        <table:table-column table:style-name="Col" table:number-columns-repeated="12"/>
        <table:table-row>
          <table:table-cell table:style-name="GrayCell" table:number-rows-spanned="3"><text:p text:style-name="Center">住</text:p><text:p text:style-name="Center">民</text:p><text:p text:style-name="Center">税</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">１</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="6"><text:p>所得（非）課税証明書</text:p><text:p text:style-name="Tiny">※課税決定前の請求・発行の場合は、【所得証明】となります。</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Center">年度（　　　年分所得）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">２</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="7"><text:p>住民税申告書の写し</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Center">通</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">３</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="7"><text:p>営業証明書（法人用・車庫証明用・開業届出済の個人事業用）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Center">通</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <table:table table:name="FixedAssetTax" table:style-name="GridTable">
        <table:table-column table:style-name="Col" table:number-columns-repeated="12"/>
        <table:table-row>
          <table:table-cell table:style-name="GrayCell" table:number-rows-spanned="6"><text:p text:style-name="Center">固</text:p><text:p text:style-name="Center">定</text:p><text:p text:style-name="Center">資</text:p><text:p text:style-name="Center">産</text:p><text:p text:style-name="Center">税</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">１</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p>評価証明書（ 全部 ・ 一部 ）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4" table:number-rows-spanned="4"><text:p text:style-name="Tiny">※名寄せの閲覧・コピー（公印なし）</text:p><text:p text:style-name="Tiny">については別の申請書をご使用くだ</text:p><text:p text:style-name="Tiny">さい。</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">年度</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">２</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p>公課証明書（ 全部 ・ 一部 ）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">通</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">３</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p>資産証明書（ 全部 ・ 一部 ）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">４</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p>名寄証明書</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GrayCell" table:number-columns-spanned="11"><text:p text:style-name="Center">不動産の所在地（評価、公課、資産証明で一部に○をした場合のみ記入）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">物件区分</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">大字</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">番地</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">物件区分</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="1"><text:p text:style-name="Center">大字</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">番地</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">土地・家屋</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">土地・家屋</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="1"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">土地・家屋</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">土地・家屋</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="1"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
        </table:table-row>
      </table:table>
      <table:table table:name="TaxCertificates" table:style-name="GridTable">
        <table:table-column table:style-name="Col" table:number-columns-repeated="12"/>
        <table:table-row>
          <table:table-cell table:style-name="GrayCell" table:number-rows-spanned="3"><text:p text:style-name="Center">納</text:p><text:p text:style-name="Center">税</text:p><text:p text:style-name="Center">証</text:p><text:p text:style-name="Center">明</text:p><text:p text:style-name="Center">書</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">１</text:p><text:p text:style-name="Tiny">※必要な税目に○を</text:p><text:p text:style-name="Tiny">　つけてください。</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="8"><text:p>個人の町税　　全ての税目　・ 町県民税　・ 固定資産税</text:p><text:p>その他の税（　　　　　　　　　　　　　　　　）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">年度</text:p><text:p text:style-name="Center">通</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">２</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="8"><text:p>法人町民税　（事業年度：　　　年　月　日～　　　年　月　日）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">通</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">３</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="8"><text:p>軽自動車税　（継続検査用）　※ナンバーを記入してください。</text:p><text:p>所沢・川越　　［　　　］　　－</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">年度</text:p><text:p text:style-name="Center">通</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <table:table table:name="OfficeUse" table:style-name="GridTable">
        <table:table-column table:style-name="Col" table:number-columns-repeated="12"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Tiny">町職員</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">交付番号</text:p><text:p>No</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Center">住　・　固　・　納</text:p><text:p text:style-name="Center">通　　　数</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">取扱者</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Center">本人確認</text:p><text:p text:style-name="Tiny">免・マ・在・保・診・会・</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageBreak"/>
      <table:table table:name="Continuation" table:style-name="GridTable">
        <table:table-column table:style-name="Col" table:number-columns-repeated="12"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">確認欄</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">手　数　料</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p>銀</text:p><text:p>他（　　　　　　　　　）</text:p></table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>