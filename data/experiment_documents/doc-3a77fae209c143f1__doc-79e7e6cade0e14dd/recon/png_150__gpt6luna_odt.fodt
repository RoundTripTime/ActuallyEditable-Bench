<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.08cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="LeftTop" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.8cm" fo:margin-bottom="0.15cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="CenterLine" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.05cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.05cm" fo:margin-bottom="0.6cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.05cm" fo:margin-bottom="1.1cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="RightLine" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0.35cm" fo:margin-bottom="0.2cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Applicant" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0.15cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="ApplicationText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.45cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="TableGap" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.3cm" fo:margin-bottom="0.3cm"/>
    </style:style>
    <style:style style:name="PageTwoStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0.08cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="CellText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="CellMiddle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="3cm" fo:margin-right="3cm"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="15cm" table:align="left" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="3cm"/>
    </style:style>
    <style:style style:name="Col225" style:family="table-column">
      <style:table-column-properties style:column-width="2.25cm"/>
    </style:style>
    <style:style style:name="Col75" style:family="table-column">
      <style:table-column-properties style:column-width="7.5cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.15cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="RowHead" style:family="table-row">
      <style:table-row-properties style:row-height="0.95cm"/>
    </style:style>
    <style:style style:name="RowNames" style:family="table-row">
      <style:table-row-properties style:row-height="1.2cm"/>
    </style:style>
    <style:style style:name="RowBlank" style:family="table-row">
      <style:table-row-properties style:row-height="5.6cm"/>
    </style:style>
    <style:style style:name="RowRange" style:family="table-row">
      <style:table-row-properties style:row-height="2.4cm"/>
    </style:style>
    <style:style style:name="RowEquip" style:family="table-row">
      <style:table-row-properties style:row-height="0.95cm"/>
    </style:style>
    <style:style style:name="RowLabel" style:family="table-row">
      <style:table-row-properties style:row-height="1.35cm"/>
    </style:style>
    <style:style style:name="RowBigBlank" style:family="table-row">
      <style:table-row-properties style:row-height="6cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="LeftTop">様式第１号（第４条関係）</text:p>
      <text:p text:style-name="CenterLine">（表）</text:p>
      <text:p text:style-name="Title">指定給水装置工事事業者指定申請書</text:p>
      <text:p text:style-name="Recipient">つくばみらい市長　　　　様</text:p>
      <text:p text:style-name="RightLine">年　　　月　　　日</text:p>
      <text:p text:style-name="Applicant">申請者　氏名又は名称　　　　　　　　　㊞</text:p>
      <text:p text:style-name="Applicant">住　所</text:p>
      <text:p text:style-name="Applicant">代表者氏名</text:p>
      <text:p text:style-name="Applicant">電　話　番　号</text:p>
      <text:p text:style-name="ApplicationText">水道法第16条の2第1項の規定による指定給水装置工事事業者の指定を受けたいので、</text:p>
      <text:p text:style-name="Body">同法第25条の2第1項の規定に基づき次のとおり申請します。</text:p>
      <table:table table:name="表面の申請欄" table:style-name="FormTable">
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col225"/>
        <table:table-column table:style-name="Col225"/>
        <table:table-column table:style-name="Col225"/>
        <table:table-column table:style-name="Col225"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-row table:style-name="RowHead">
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="6">
            <text:p text:style-name="CellCenter">役員（業務を執行する社員、取締役又はこれらに準ずる者）の氏名</text:p>
          </table:table-cell>
          <table:covered-table-cell table:number-columns-repeated="5"/>
        </table:table-row>
        <table:table-row table:style-name="RowNames">
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3">
            <text:p text:style-name="CellCenter">フ　リ　ガ　ナ</text:p>
            <text:p text:style-name="CellCenter">氏　名</text:p>
          </table:table-cell>
          <table:covered-table-cell table:number-columns-repeated="2"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3">
            <text:p text:style-name="CellCenter">フ　リ　ガ　ナ</text:p>
            <text:p text:style-name="CellCenter">氏　名</text:p>
          </table:table-cell>
          <table:covered-table-cell table:number-columns-repeated="2"/>
        </table:table-row>
        <table:table-row table:style-name="RowBlank">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="RowRange">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellCenter">事　業　の　範　囲</text:p>
          </table:table-cell>
          <table:covered-table-cell table:number-columns-repeated="5"/>
        </table:table-row>
        <table:table-row table:style-name="RowEquip">
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2">
            <text:p text:style-name="CellCenter">機械器具の名称、性能及び数</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4">
            <text:p text:style-name="CellText">別紙のとおり</text:p>
          </table:table-cell>
          <table:covered-table-cell table:number-columns-repeated="3"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageTwoStart">（裏）</text:p>
      <table:table table:name="裏面の事業所欄1" table:style-name="FormTable">
        <table:table-column table:style-name="Col75" table:number-columns-repeated="2"/>
        <table:table-row table:style-name="RowLabel">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellText">当該給水区域で給水装置工事の事業を行う事業所の名称</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="RowLabel">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellText">上　記　事　業　所　の　所　在　地</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="RowLabel">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellText">上記事業所で選任されることとなる給水装置工事主任技術者の氏名</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellCenter">給水装置工事主任技術者免状の交付番号</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowBigBlank">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="TableGap"/>
      <table:table table:name="裏面の事業所欄2" table:style-name="FormTable">
        <table:table-column table:style-name="Col75" table:number-columns-repeated="2"/>
        <table:table-row table:style-name="RowLabel">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellText">当該給水区域で給水装置工事の事業を行う事業所の名称</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="RowLabel">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellText">上　記　事　業　所　の　所　在　地</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="RowLabel">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellText">上記事業所で選任されることとなる給水装置工事主任技術者の氏名</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellCenter">給水装置工事主任技術者免状の交付番号</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowBigBlank">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>