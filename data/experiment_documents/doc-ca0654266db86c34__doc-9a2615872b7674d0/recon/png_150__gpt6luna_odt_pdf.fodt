<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0in" fo:margin-right="0in" fo:margin-top="0in" fo:margin-bottom="0in"/>
      <style:text-properties style:font-name="MS Mincho" style:font-name-asian="MS Mincho" fo:font-size="11pt"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0in" fo:margin-right="0in" fo:margin-top="0in" fo:margin-bottom="0in"/>
      <style:text-properties style:font-name="MS Mincho" style:font-name-asian="MS Mincho" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="DateLine" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end" fo:margin-top="1.05in" fo:margin-bottom="0in"/>
    </style:style>
    <style:style style:name="Mayor" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.75in" fo:margin-bottom="0in"/>
    </style:style>
    <style:style style:name="CenterField" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.62in" fo:margin-bottom="0in"/>
    </style:style>
    <style:style style:name="ShortGapField" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.28in" fo:margin-bottom="0in"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.78in" fo:margin-bottom="0.3in"/>
      <style:text-properties style:font-name="MS Mincho" style:font-name-asian="MS Mincho" fo:font-size="16pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Intro" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.12in" fo:margin-bottom="0in"/>
    </style:style>
    <style:style style:name="RecordMark" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.72in" fo:margin-bottom="0.14in"/>
    </style:style>
    <style:style style:name="PageBreakSpacer" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0.78in" fo:margin-bottom="0in" fo:line-height="0.01in"/>
    </style:style>
    <style:style style:name="LocationTable" style:family="table">
      <style:table-properties style:width="6.33in" table:align="left"/>
    </style:style>
    <style:style style:name="MainTable" style:family="table">
      <style:table-properties style:width="6.33in" table:align="left"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="8.27in" fo:page-height="11.69in" fo:print-orientation="portrait" fo:margin-left="1.22in" fo:margin-right="0.72in" fo:margin-top="0.7in" fo:margin-bottom="0.7in"/>
    </style:page-layout>
    <style:style style:name="LocationColLabel" style:family="table-column">
      <style:table-column-properties style:column-width="1.35in"/>
    </style:style>
    <style:style style:name="LocationColInput" style:family="table-column">
      <style:table-column-properties style:column-width="4.98in"/>
    </style:style>
    <style:style style:name="MainColLabel" style:family="table-column">
      <style:table-column-properties style:column-width="1.35in"/>
    </style:style>
    <style:style style:name="MainColInput" style:family="table-column">
      <style:table-column-properties style:column-width="4.98in"/>
    </style:style>
    <style:style style:name="BorderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06in" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="LabelCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06in" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties style:font-name="MS Mincho" style:font-name-asian="MS Mincho" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="InputCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06in" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="start"/>
      <style:text-properties style:font-name="MS Mincho" style:font-name-asian="MS Mincho" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="RowShort" style:family="table-row">
      <style:table-row-properties style:row-height="0.55in" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RowPeriod" style:family="table-row">
      <style:table-row-properties style:row-height="1.62in" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RowMethod" style:family="table-row">
      <style:table-row-properties style:row-height="0.58in" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RowContact" style:family="table-row">
      <style:table-row-properties style:row-height="0.99in" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RowAttachments" style:family="table-row">
      <style:table-row-properties style:row-height="1.08in" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="Page2CellText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0in"/>
      <style:text-properties style:font-name="MS Mincho" style:font-name-asian="MS Mincho" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Page2Label" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0in" fo:margin-bottom="0in"/>
      <style:text-properties style:font-name="MS Mincho" style:font-name-asian="MS Mincho" fo:font-size="11pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="DateLine">令和　　年　　月　　日</text:p>
      <text:p text:style-name="Mayor">相馬市長</text:p>
      <text:p text:style-name="CenterField">住　　所</text:p>
      <text:p text:style-name="CenterField">氏　　名</text:p>
      <text:p text:style-name="CenterField">担　当　者</text:p>
      <text:p text:style-name="ShortGapField">電話番号</text:p>
      <text:p text:style-name="Title">道　路　使　用　届</text:p>
      <text:p text:style-name="Intro">下記のとおり道路の使用をしたいので、届出いたします。</text:p>
      <text:p text:style-name="RecordMark">記</text:p>
      <table:table table:name="道路の場所" table:style-name="LocationTable">
        <table:table-column table:style-name="LocationColLabel"/>
        <table:table-column table:style-name="LocationColInput"/>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="LabelCell">
            <text:p>道路の場所</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageBreakSpacer"/>
      <table:table table:name="道路使用届記入欄" table:style-name="MainTable">
        <table:table-column table:style-name="MainColLabel"/>
        <table:table-column table:style-name="MainColInput"/>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="LabelCell">
            <text:p>(路　線　名)</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="LabelCell">
            <text:p>使　用　目　的</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
        </table:table-row>
        <table:table-row table:style-name="RowPeriod">
          <table:table-cell table:style-name="LabelCell">
            <text:p>使　用　期　間</text:p>
            <text:p>(時　間)</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InputCell">
            <text:p>令和　　年　　月　　日</text:p>
            <text:p>令和　　年　　月　　日</text:p>
            <text:p>(　　　　日間)</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowMethod">
          <table:table-cell table:style-name="LabelCell">
            <text:p>実　施　方　法</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
        </table:table-row>
        <table:table-row table:style-name="RowContact">
          <table:table-cell table:style-name="LabelCell">
            <text:p>現場責任者及び</text:p>
            <text:p>連絡先</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
        </table:table-row>
        <table:table-row table:style-name="RowAttachments">
          <table:table-cell table:style-name="LabelCell">
            <text:p>添　付　書　類</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InputCell">
            <text:p>①位置図　②交通規制図　③作業形態図　④現地写真</text:p>
            <text:p>⑤緊急連絡網</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="LabelCell">
            <text:p>そ　の　他</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>