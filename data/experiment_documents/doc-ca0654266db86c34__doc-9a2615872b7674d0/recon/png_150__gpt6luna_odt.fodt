<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Default" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="17.5cm" table:align="center"/>
    </style:style>
    <style:style style:name="FormColumnLabel" style:family="table-column">
      <style:table-column-properties style:column-width="3.2cm"/>
    </style:style>
    <style:style style:name="FormColumnInput" style:family="table-column">
      <style:table-column-properties style:column-width="14.3cm"/>
    </style:style>
    <style:style style:name="FormCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.18cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="LabelCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.18cm" style:vertical-align="middle"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="2cm" fo:margin-right="2cm" style:print-orientation="portrait"/>
    </style:page-layout>
    <style:style style:name="DateLine" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end" fo:margin-top="2.2cm" fo:margin-bottom="2.5cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-left="0.3cm" fo:margin-top="0cm" fo:margin-bottom="2.1cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="ApplicantField" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="1cm" fo:margin-bottom="1.4cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="1.2cm" fo:margin-bottom="0.7cm"/>
      <style:text-properties fo:font-size="19pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Intro" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-left="0.3cm" fo:margin-top="0.3cm" fo:margin-bottom="2.1cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="RecordMark" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="BreakPage" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="CenteredLabel" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="TableText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="DateLine">令和　　年　　月　　日</text:p>
      <text:p text:style-name="Recipient">相馬市長</text:p>
      <text:p text:style-name="ApplicantField">住　　所</text:p>
      <text:p text:style-name="ApplicantField">氏　　名</text:p>
      <text:p text:style-name="ApplicantField">担 当 者</text:p>
      <text:p text:style-name="ApplicantField">電話番号</text:p>
      <text:p text:style-name="Title">道　路　使　用　届</text:p>
      <text:p text:style-name="Intro">下記のとおり道路の使用をしたいので、届出いたします。</text:p>
      <text:p text:style-name="RecordMark">記</text:p>
      <table:table table:name="道路の場所" table:style-name="FormTable">
        <table:table-column table:style-name="FormColumnLabel"/>
        <table:table-column table:style-name="FormColumnInput"/>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="CenteredLabel">道路の場所</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="BreakPage"/>
      <table:table table:name="道路使用届" table:style-name="FormTable">
        <table:table-column table:style-name="FormColumnLabel"/>
        <table:table-column table:style-name="FormColumnInput"/>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="CenteredLabel">（路　線　名）</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="CenteredLabel">使　用　目　的</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="CenteredLabel">使　用　期　間</text:p>
            <text:p text:style-name="CenteredLabel">（時　間）</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="TableText">令和　　年　　月　　日</text:p>
            <text:p text:style-name="TableText">令和　　年　　月　　日</text:p>
            <text:p text:style-name="TableText">　　　　　　　（　　　　日間）</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="CenteredLabel">実　施　方　法</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="CenteredLabel">現場責任者及び</text:p>
            <text:p text:style-name="CenteredLabel">連絡先</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="CenteredLabel">添　付　書　類</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="TableText">①位置図　②交通規制図　③作業形態図　④現地写真</text:p>
            <text:p text:style-name="TableText">⑤緊急連絡網</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="CenteredLabel">そ　　の　　他</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>