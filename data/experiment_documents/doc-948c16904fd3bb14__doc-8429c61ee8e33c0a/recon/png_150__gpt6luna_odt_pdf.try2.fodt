<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties style:font-name="Mincho" style:font-name-asian="MS Mincho" fo:font-size="11pt" style:font-size-asian="11pt"/>
    </style:default-style>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties style:font-name="Mincho" style:font-name-asian="MS Mincho" fo:font-size="11pt" style:font-size-asian="11pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.2cm" fo:margin-bottom="1.3cm"/>
      <style:text-properties style:font-name="Mincho" style:font-name-asian="MS Mincho" fo:font-size="16pt" style:font-size-asian="16pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Centered" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0.15cm"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.45cm" fo:margin-bottom="0.05cm"/>
      <style:text-properties fo:font-size="12pt" style:font-size-asian="12pt"/>
    </style:style>
    <style:style style:name="NewPage" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="1pt" style:font-size-asian="1pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
    </style:page-layout-properties>
    <style:style style:name="GridTable" style:family="table">
      <style:table-properties style:width="100%" table:align="center"/>
    </style:style>
    <style:style style:name="GridColumn" style:family="table-column">
      <style:table-column-properties style:rel-column-width="1*"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt" style:font-size-asian="10pt"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt" style:font-size-asian="10pt"/>
    </style:style>
    <style:style style:name="SmallCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.04cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="8pt" style:font-size-asian="8pt"/>
    </style:style>
    <style:style style:name="NoBorderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="PersonTable" style:family="table">
      <style:table-properties style:width="94%" table:align="center"/>
    </style:style>
    <style:style style:name="LandTable" style:family="table">
      <style:table-properties style:width="100%" table:align="center"/>
    </style:style>
    <style:style style:name="PersonColA" style:family="table-column">
      <style:table-column-properties style:column-width="2.8cm"/>
    </style:style>
    <style:style style:name="PersonColB" style:family="table-column">
      <style:table-column-properties style:column-width="2.3cm"/>
    </style:style>
    <style:style style:name="PersonColC" style:family="table-column">
      <style:table-column-properties style:column-width="12.2cm"/>
    </style:style>
    <style:style style:name="LandCol1" style:family="table-column"><style:table-column-properties style:column-width="1.8cm"/></style:style>
    <style:style style:name="LandCol2" style:family="table-column"><style:table-column-properties style:column-width="2cm"/></style:style>
    <style:style style:name="LandCol3" style:family="table-column"><style:table-column-properties style:column-width="1.7cm"/></style:style>
    <style:style style:name="LandCol4" style:family="table-column"><style:table-column-properties style:column-width="1.5cm"/></style:style>
    <style:style style:name="LandCol5" style:family="table-column"><style:table-column-properties style:column-width="1.5cm"/></style:style>
    <style:style style:name="LandCol6" style:family="table-column"><style:table-column-properties style:column-width="2cm"/></style:style>
    <style:style style:name="LandCol7" style:family="table-column"><style:table-column-properties style:column-width="2cm"/></style:style>
    <style:style style:name="LandCol8" style:family="table-column"><style:table-column-properties style:column-width="2cm"/></style:style>
    <style:style style:name="LandCol9" style:family="table-column"><style:table-column-properties style:column-width="3cm"/></style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">農地法第１８条第６項の規定による通知書</text:p>
      <text:p text:style-name="P">大宜味村農業委員会会長　殿</text:p>
      <text:p text:style-name="P">　　　　　　　　　　　　　　　　　　　　　　　　　令和　　年　　月　　日</text:p>
      <table:table table:name="通知者情報" table:style-name="PersonTable">
        <table:table-column table:style-name="PersonColA"/>
        <table:table-column table:style-name="PersonColB"/>
        <table:table-column table:style-name="PersonColC"/>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-rows-spanned="3"><text:p>所有者</text:p><text:p>（貸人）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>印　　　　　　　　　　　　　　　　　　　　　　　　　○</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>住所</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>連絡先</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-rows-spanned="3"><text:p>耕作者</text:p><text:p>（借人）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>印　　　　　　　　　　　　　　　　　　　　　　　　　○</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>住所</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>連絡先</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="P">下記の農地について貸借の解約をしたので、農地法第１８条第６項の規定によ</text:p>
      <text:p text:style-name="P">り通知します。</text:p>
      <text:p text:style-name="Centered">記</text:p>
      <text:p text:style-name="Section">１．土地の所在・地番・地目・面積及び利用権の内容</text:p>
      <table:table table:name="土地情報" table:style-name="LandTable">
        <table:table-column table:style-name="LandCol1"/>
        <table:table-column table:style-name="LandCol2"/>
        <table:table-column table:style-name="LandCol3"/>
        <table:table-column table:style-name="LandCol4"/>
        <table:table-column table:style-name="LandCol5"/>
        <table:table-column table:style-name="LandCol6"/>
        <table:table-column table:style-name="LandCol7"/>
        <table:table-column table:style-name="LandCol8"/>
        <table:table-column table:style-name="LandCol9"/>
        <table:table-row>
          <table:table-cell table:style-name="SmallCell" table:number-columns-spanned="5"><text:p>土地</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="SmallCell" table:number-columns-spanned="3"><text:p>利　　　　用　　　　権</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="SmallCell" table:number-rows-spanned="2"><text:p>当事者の法律関係</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="SmallCell"><text:p>大　字</text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCell"><text:p>小　字</text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCell"><text:p>地　番</text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCell"><text:p>地　目</text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCell"><text:p>面　積（ｍ²）</text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCell"><text:p>種　類</text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCell"><text:p>始　期</text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCell"><text:p>終　期</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="P">１．解約の理由　：</text:p>
      <text:p text:style-name="P">２．合意解約の合意が成立した日　　　　　　　　　　　　　　　令和　　年　　月　　日</text:p>
      <text:p text:style-name="P">３．合意による解約をした日　　　　　　　　　　　　　　　　令和　　年　　月　　日</text:p>
      <text:p text:style-name="P">４．土地の引渡の時期　　　　　　　　　　　　　　　　　　　令和　　年　　月　　日</text:p>
      <text:p text:style-name="P">５．その他参考となるべき事項　：　無し</text:p>
      <text:p text:style-name="P"> </text:p>
      <text:p text:style-name="P">※添付書類：合意解約書の写し、農地利用集積計画の写し</text:p>
      <text:p text:style-name="NewPage"/>
      <text:p text:style-name="Title">合意解約書</text:p>
      <text:p text:style-name="P">下記表示の農地は　　　　　　　　の所有であり　　　　　　　　はこれを耕作目的で貸借し農地として供してきたが、この度合意により解約が成立しました。</text:p>
      <text:p text:style-name="P">当事者間とも異議なく承諾し土地の引き渡しを行なう、この解約について紛争等は一切ありません。</text:p>
      <text:p text:style-name="Centered">記</text:p>
      <text:p text:style-name="Section">１．土地の所在・地番・地目・面積及び利用権の内容</text:p>
      <table:table table:name="土地情報_合意解約書1" table:style-name="LandTable">
        <table:table-column table:style-name="LandCol1"/><table:table-column table:style-name="LandCol2"/><table:table-column table:style-name="LandCol3"/><table:table-column table:style-name="LandCol4"/><table:table-column table:style-name="LandCol5"/><table:table-column table:style-name="LandCol6"/><table:table-column table:style-name="LandCol7"/><table:table-column table:style-name="LandCol8"/><table:table-column table:style-name="LandCol9"/>
        <table:table-row>
          <table:table-cell table:style-name="SmallCell" table:number-columns-spanned="5"><text:p>土地</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="SmallCell" table:number-columns-spanned="3"><text:p>利　　　　用　　　　権</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="SmallCell" table:number-rows-spanned="2"><text:p>当事者の法律関係</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="SmallCell"><text:p>大　字</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"><text:p>小　字</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"><text:p>地　番</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"><text:p>地　目</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"><text:p>面　積（ｍ²）</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"><text:p>種　類</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"><text:p>始　期</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"><text:p>終　期</text:p></table:table-cell><table:covered-table-cell/>
        </table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell" table:number-rows-spanned="3"><text:p>農業経営基盤強化促進法</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:covered-table-cell/></table:table-row>
      </table:table>
      <text:p text:style-name="Section">２．所有者および耕作者</text:p>
      <table:table table:name="当事者情報1" table:style-name="PersonTable">
        <table:table-column table:style-name="PersonColA"/><table:table-column table:style-name="PersonColB"/><table:table-column table:style-name="PersonColC"/>
        <table:table-row><table:table-cell table:style-name="CellCenter" table:number-rows-spanned="3"><text:p>所有者</text:p><text:p>（貸人）</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>氏名</text:p></table:table-cell><table:table-cell table:style-name="CellCenter"><text:p>印　　　　　　　　　　　　　　　　　　　　　　　　　○</text:p></table:table-cell></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>住所</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>連絡先</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="CellCenter" table:number-rows-spanned="3"><text:p>耕作者</text:p><text:p>（借人）</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>氏名</text:p></table:table-cell><table:table-cell table:style-name="CellCenter"><text:p>印　　　　　　　　　　　　　　　　　　　　　　　　　○</text:p></table:table-cell></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>住所</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>連絡先</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="P">　　　　　　　　　　　　　　　　　　　　　　　　　令和　　年　　月　　日</text:p>
      <text:p text:style-name="P">なお、後日の証として本書を２部作成し、賃貸人、賃借人各１部を保持し、その写しを。</text:p>
      <text:p text:style-name="P">農業委員会に提出する。</text:p>
      <text:p text:style-name="NewPage"/>
      <text:p text:style-name="Title">合意解約書</text:p>
      <text:p text:style-name="P">下記表示の農地は　　　　　　　　の所有であり　　　　　　　　はこれを耕作目的で貸借し農地として供してきたが、この度合意により解約が成立しました。</text:p>
      <text:p text:style-name="P">当事者間とも異議なく承諾し土地の引き渡しを行なう、この解約について紛争等は一切ありません。</text:p>
      <text:p text:style-name="Centered">記</text:p>
      <text:p text:style-name="Section">１．土地の所在・地番・地目・面積及び利用権の内容</text:p>
      <table:table table:name="土地情報_合意解約書2" table:style-name="LandTable">
        <table:table-column table:style-name="LandCol1"/><table:table-column table:style-name="LandCol2"/><table:table-column table:style-name="LandCol3"/><table:table-column table:style-name="LandCol4"/><table:table-column table:style-name="LandCol5"/><table:table-column table:style-name="LandCol6"/><table:table-column table:style-name="LandCol7"/><table:table-column table:style-name="LandCol8"/><table:table-column table:style-name="LandCol9"/>
        <table:table-row>
          <table:table-cell table:style-name="SmallCell" table:number-columns-spanned="5"><text:p>土地</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
