  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">農地法第１８条第６項の規定による通知書</text:p>
      <text:p text:style-name="Body">大宜味村農業委員会会長　殿</text:p>
      <text:p text:style-name="Right">令和　　年　　月　　日</text:p>
      <text:p text:style-name="Body"/>
      <table:table table:name="通知当事者" table:style-name="Grid">
        <table:table-column table:style-name="C1"/>
        <table:table-column table:style-name="C2"/>
        <table:table-column table:style-name="C3"/>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-rows-spanned="3"><text:p>所有者</text:p><text:p>（貸人）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>印　　　　　　　　　　　　　　　　　　　　　　　　○</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>住所</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>連絡先</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-rows-spanned="3"><text:p>耕作者</text:p><text:p>（借人）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>印　　　　　　　　　　　　　　　　　　　　　　　　○</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>住所</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>連絡先</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Body">下記の農地について貸借の解約をしたので、農地法第１８条第６項の規定に</text:p>
      <text:p text:style-name="Body">より通知します。</text:p>
      <text:p text:style-name="Center">記</text:p>
      <text:p text:style-name="SectionTitle">１．土地の所在・地番・地目・面積及び利用権の内容</text:p>
      <table:table table:name="通知土地" table:style-name="LandGrid">
        <table:table-column table:style-name="L1"/>
        <table:table-column table:style-name="L2"/>
        <table:table-column table:style-name="L3"/>
        <table:table-column table:style-name="L4"/>
        <table:table-column table:style-name="L5"/>
        <table:table-column table:style-name="L6"/>
        <table:table-column table:style-name="L7"/>
        <table:table-column table:style-name="L8"/>
        <table:table-column table:style-name="L9"/>
        <table:table-row>
          <table:table-cell table:style-name="CellSmallCenter" table:number-columns-spanned="5"><text:p>土　地</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellSmallCenter" table:number-columns-spanned="3"><text:p>利　　　　　用　　　　　権</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellSmall" table:number-rows-spanned="2"><text:p>当事者の法律関係</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellSmallCenter"><text:p>大　字</text:p></table:table-cell>
          <table:table-cell table:style-name="CellSmallCenter"><text:p>小　字</text:p></table:table-cell>
          <table:table-cell table:style-name="CellSmallCenter"><text:p>地　番</text:p></table:table-cell>
          <table:table-cell table:style-name="CellSmallCenter"><text:p>地　目</text:p></table:table-cell>
          <table:table-cell table:style-name="CellSmallCenter"><text:p>面　積（㎡）</text:p></table:table-cell>
          <table:table-cell table:style-name="CellSmallCenter"><text:p>種　類</text:p></table:table-cell>
          <table:table-cell table:style-name="CellSmallCenter"><text:p>始　期</text:p></table:table-cell>
          <table:table-cell table:style-name="CellSmallCenter"><text:p>終　期</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall" table:number-rows-spanned="3"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Body">１．解約の理由　：</text:p>
      <text:p text:style-name="Body">２．合意解約の合意が成立した日　　　　　　　　　　　　　　　令和　　年　　月　　日</text:p>
      <text:p text:style-name="Body">３．合意による解約をした日　　　　　　　　　　　　　　　　令和　　年　　月　　日</text:p>
      <text:p text:style-name="Body">４．土地の引渡の時期　　　　　　　　　　　　　　　　　　　令和　　年　　月　　日</text:p>
      <text:p text:style-name="Body">５．その他参考となるべき事項　：　無し</text:p>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Body">※添付書類：合意解約書の写し、農地利用集積計画の写し</text:p>

      <text:p text:style-name="PageStart">合意解約書</text:p>
      <text:p text:style-name="Body">下記表示の農地は　　　　の所有であり　　　　はこれを耕作目</text:p>
      <text:p text:style-name="Body">的で貸借し農地として供してきたが、この度合意により解約が成立しました。</text:p>
      <text:p text:style-name="Body">当事者間とも異議なく承諾し土地の引き渡しを行ない、この解約について</text:p>
      <text:p text:style-name="Body">紛争等は一切ありません。</text:p>
      <text:p text:style-name="Center">記</text:p>
      <text:p text:style-name="SectionTitle">１．土地の所在・地番・地目・面積及び利用権の内容</text:p>
      <table:table table:name="合意土地1" table:style-name="LandGrid">
        <table:table-column table:style-name="L1"/><table:table-column table:style-name="L2"/><table:table-column table:style-name="L3"/><table:table-column table:style-name="L4"/><table:table-column table:style-name="L5"/><table:table-column table:style-name="L6"/><table:table-column table:style-name="L7"/><table:table-column table:style-name="L8"/><table:table-column table:style-name="L9"/>
        <table:table-row>
          <table:table-cell table:style-name="CellSmallCenter" table:number-columns-spanned="5"><text:p>土　地</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="CellSmallCenter" table:number-columns-spanned="3"><text:p>利　　　　　用　　　　　権</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="CellSmall" table:number-rows-spanned="2"><text:p>当事者の法律関係</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellSmallCenter"><text:p>大　字</text:p></table:table-cell><table:table-cell table:style-name="CellSmallCenter"><text:p>小　字</text:p></table:table-cell><table:table-cell table:style-name="CellSmallCenter"><text:p>地　番</text:p></table:table-cell><table:table-cell table:style-name="CellSmallCenter"><text:p>地　目</text:p></table:table-cell><table:table-cell table:style-name="CellSmallCenter"><text:p>面　積（㎡）</text:p></table:table-cell><table:table-cell table:style-name="CellSmallCenter"><text:p>種　類</text:p></table:table-cell><table:table-cell table:style-name="CellSmallCenter"><text:p>始　期</text:p></table:table-cell><table:table-cell table:style-name="CellSmallCenter"><text:p>終　期</text:p></table:table-cell><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellSmall" table:number-rows-spanned="3"><text:p>農業経営基盤強化促進法</text:p></table:table-cell>
        </table:table-row>
        <table:table-row><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:table-cell table:style-name="CellSmall"><text:p/></table:table-cell><table:covered-table-cell/></table:table-row>
      </table:table>
      <text:p text:style-name="SectionTitle">２．所有者および耕作者</text:p>
      <table:table table:name="合意当事者1" table:style-name="Grid">
        <table:table-column table:style-name="C1"/><table:table-column table:style-name="C2"/><table:table-column table:style-name="C3"/>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-rows-spanned="3"><text:p>所有者</text:p><text:p>（貸人）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>氏名</text:p></table:table-cell><table:table-cell table:style-name="CellCenter"><text:p>印　　　　　　　　　　　　　　　　　　　　　　　　○</text:p></table:table-cell>
        </table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>住所</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>連絡先</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-rows-spanned="3"><text:p>耕作者</text:p><text:p>（借人）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>氏名</text:p></table:table-cell><table:table-cell table:style-name="CellCenter"><text:p>印　　　　　　　　　　　　　　　　　　　　　　　　○</text:p></table:table-cell>
        </table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>住所</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>連絡先</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="Body">令和　　年　　月　　日</text:p>
      <text:p text:style-name="Body">なお、後日の証として本書を２部作成し、賃貸人、賃借人各１部を保持し、その写しを。</text:p>
      <text:p text:style-name="Body">農業委員会に提出する。</text:p>

      <text:p text:style-name="PageStart">合意解約書</text:p>
      <text:p text:style-name="Body">下記表示の農地は　　　　の所有であり　　　　はこれを耕作目</text:p>
      <text:p text:style-name="Body">的で貸借し農地として供してきたが、この度合意により解約が成立しました。</text:p>
      <text:p text:style-name="Body">当事者間とも異議なく承諾し土地の引き渡しを行ない、この解約について</text:p>
      <text:p text:style-name="Body">紛争等は一切ありません。</text:p>
      <text:p text:style-name="Center">記</text:p>
      <text:p text:style-name="SectionTitle">１．土地の所在・地番・地目・面積及び利用権の内容</text:p>
      <table:table table:name="合意土地2" table:style-name="LandGrid">
        <table:table-column table:style-name="L1"/><table:table-column table:style-name="L2"/><table:table-column table:style-name="L3"/><table:table-column table:style-name="L4"/><table:table-column table:style-name="L5"/><table:table-column table:style-name="L6"/><table:table-column table:style-name="L7"/><table:table-column table:style-name="L8"/><table:table-column table:style-name="L9"/>
        <table:table-row>
          <table:table-cell table:style-name="CellSmallCenter" table:number-columns-spanned="5"><text:p>土　地</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="CellSmallCenter" table:number-columns-spanned="3"><text:p>利　　　　　用　　　　　権</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
