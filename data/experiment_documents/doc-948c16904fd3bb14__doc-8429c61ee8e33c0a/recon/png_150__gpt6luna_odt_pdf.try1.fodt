        <table:table-row><table:table-cell table:style-name="Cell"><text:p>大　字</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>小　字</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>地　番</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>地　目</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>面　積<br/>(　㎡)</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>種　類</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>始　期</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>終　期</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
