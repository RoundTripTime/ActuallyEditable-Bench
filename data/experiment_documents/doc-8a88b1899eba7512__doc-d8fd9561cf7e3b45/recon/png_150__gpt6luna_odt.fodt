<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Start" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-bottom="0.45cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:color="#29443E"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.05cm" fo:margin-bottom="0.25cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="30pt" fo:color="#29443E"/>
    </style:style>
    <style:style style:name="Tagline" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.45cm" fo:line-height="110%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="12pt" fo:color="#29443E"/>
    </style:style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.06cm" fo:line-height="110%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="12pt" fo:color="#29443E"/>
    </style:style>
    <style:style style:name="Gap" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.34cm" fo:margin-bottom="0.06cm" fo:line-height="110%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="12pt" fo:color="#29443E"/>
    </style:style>
    <style:style style:name="CellText" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="110%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11.5pt" fo:color="#29443E"/>
    </style:style>
    <style:style style:name="Heading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.48cm" fo:margin-bottom="0.22cm" fo:line-height="110%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="12pt" fo:font-weight="bold" fo:color="#29443E"/>
    </style:style>
    <style:style style:name="Bullet" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.16cm" fo:margin-bottom="0.08cm" fo:line-height="110%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11.5pt" fo:color="#29443E"/>
    </style:style>
    <style:style style:name="FooterText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="2.25cm" fo:margin-bottom="0cm" fo:line-height="110%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:color="#29443E"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout" style:page-usage="all">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="1.7cm" fo:margin-right="1.7cm" fo:margin-top="1.6cm" fo:margin-bottom="1.4cm"/>
    </style:page-layout>
    <style:style style:name="InvoiceTable" style:family="table">
      <style:table-properties style:width="17.6cm" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="InvoiceColumn" style:family="table-column">
      <style:table-column-properties style:column-width="4.4cm"/>
    </style:style>
    <style:style style:name="InvoiceCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #222222" fo:padding="0.18cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="InvoiceHeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #222222" fo:padding="0.18cm" fo:background-color="#E8EEE8" style:vertical-align="middle"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11.5pt" fo:color="#29443E"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Start">OSTRO / WORKING TEMPLATES</text:p>
      <text:p text:style-name="Title">Agency invoice</text:p>
      <text:p text:style-name="Tagline">Editable template · replace every bracketed field before use</text:p>
      <text:p text:style-name="Body">From: [your billing name and address]</text:p>
      <text:p text:style-name="Body">Bill to: [client billing name and address]</text:p>
      <text:p text:style-name="Body">Business / tax identifiers: [add where required]</text:p>
      <text:p text:style-name="Gap">Invoice: [unique reference]</text:p>
      <text:p text:style-name="Body">Issued: [date]</text:p>
      <text:p text:style-name="Body">Due: [agreed due date]</text:p>
      <text:p text:style-name="Body">Currency: [currency code]</text:p>
      <table:table table:name="Invoice" table:style-name="InvoiceTable">
        <table:table-column table:style-name="InvoiceColumn"/>
        <table:table-column table:style-name="InvoiceColumn"/>
        <table:table-column table:style-name="InvoiceColumn"/>
        <table:table-column table:style-name="InvoiceColumn"/>
        <table:table-row>
          <table:table-cell table:style-name="InvoiceHeaderCell"><text:p text:style-name="CellText">Description</text:p></table:table-cell>
          <table:table-cell table:style-name="InvoiceHeaderCell"><text:p text:style-name="CellText">Quantity</text:p></table:table-cell>
          <table:table-cell table:style-name="InvoiceHeaderCell"><text:p text:style-name="CellText">Unit price</text:p></table:table-cell>
          <table:table-cell table:style-name="InvoiceHeaderCell"><text:p text:style-name="CellText">Line total</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="InvoiceCell"><text:p text:style-name="CellText">Campaign creative and<text:line-break/>design</text:p></table:table-cell>
          <table:table-cell table:style-name="InvoiceCell"><text:p text:style-name="CellText">[quantity]</text:p></table:table-cell>
          <table:table-cell table:style-name="InvoiceCell"><text:p text:style-name="CellText">[price]</text:p></table:table-cell>
          <table:table-cell table:style-name="InvoiceCell"><text:p text:style-name="CellText">[amount]</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="InvoiceCell"><text:p text:style-name="CellText">Landing-page copywriting</text:p></table:table-cell>
          <table:table-cell table:style-name="InvoiceCell"><text:p text:style-name="CellText">[quantity]</text:p></table:table-cell>
          <table:table-cell table:style-name="InvoiceCell"><text:p text:style-name="CellText">[price]</text:p></table:table-cell>
          <table:table-cell table:style-name="InvoiceCell"><text:p text:style-name="CellText">[amount]</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="InvoiceCell"><text:p text:style-name="CellText">Approved external<text:line-break/>illustration cost</text:p></table:table-cell>
          <table:table-cell table:style-name="InvoiceCell"><text:p text:style-name="CellText">[quantity]</text:p></table:table-cell>
          <table:table-cell table:style-name="InvoiceCell"><text:p text:style-name="CellText">[price]</text:p></table:table-cell>
          <table:table-cell table:style-name="InvoiceCell"><text:p text:style-name="CellText">[amount]</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body">Subtotal: [amount]</text:p>
      <text:p text:style-name="Body">Discount, if agreed: [amount]</text:p>
      <text:p text:style-name="Body">Tax, if applicable: [rate and amount]</text:p>
      <text:p text:style-name="Body">Total: [amount]</text:p>
      <text:p text:style-name="Body">Paid: [amount]</text:p>
      <text:p text:style-name="Body">Balance due: [amount]</text:p>
      <text:p text:style-name="Heading">Payment instructions</text:p>
      <text:p text:style-name="Body">[Enter the exact receiving instructions and payment reference for your agreed route.]</text:p>
      <text:p text:style-name="Heading">Notes and terms</text:p>
      <text:p text:style-name="Body">[Add your agreed payment terms and any invoice notes.]</text:p>
      <text:p text:style-name="Heading">Editing guidance — remove before sending</text:p>
      <text:p text:style-name="Body">Word totals are entered manually. Check all arithmetic, applicable tax details and the agreed payment terms.<text:line-break/>For automatic calculations, use the Ostro invoice generator.</text:p>
      <text:p text:style-name="Heading">Before sending — remove this checklist</text:p>
      <text:p text:style-name="Bullet">• Check each workstream against the approved quote.</text:p>
      <text:p text:style-name="Bullet">• Avoid double-counting costs already included in a project fee.</text:p>
      <text:p text:style-name="Bullet">• Include the billing contact and any required supplier reference.</text:p>
      <text:p text:style-name="Body">Template and example: https://tryostro.com/templates/agency-invoice/</text:p>
      <text:p text:style-name="FooterText">Ostro templates · 1</text:p>
    </office:text>
  </office:body>
</office:document>