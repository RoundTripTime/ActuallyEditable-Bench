<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.08cm" fo:line-height="120%"/>
      <style:text-properties style:font-name="Liberation Sans" fo:font-size="11pt" fo:color="#243d36"/>
    </style:default-style>
    <style:style style:name="Brand" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.55cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.25cm"/>
      <style:text-properties fo:font-size="28pt"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.6cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Billing" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.45cm"/>
    </style:style>
    <style:style style:name="Metadata" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.38cm"/>
    </style:style>
    <style:style style:name="SectionHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.28cm" fo:margin-bottom="0.22cm"/>
      <style:text-properties fo:font-size="12.5pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Tight" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="120%"/>
    </style:style>
    <style:style style:name="TableHeader" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#eaf0e8" fo:border="0.5pt solid #222222" fo:padding="0.18cm" style:vertical-align="middle"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="TableCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #222222" fo:padding="0.18cm" style:vertical-align="top"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="DescriptionColumn" style:family="table-column">
      <style:table-column-properties style:column-width="4.4cm"/>
    </style:style>
    <style:style style:name="QuantityColumn" style:family="table-column">
      <style:table-column-properties style:column-width="4.4cm"/>
    </style:style>
    <style:style style:name="PriceColumn" style:family="table-column">
      <style:table-column-properties style:column-width="4.4cm"/>
    </style:style>
    <style:style style:name="TotalColumn" style:family="table-column">
      <style:table-column-properties style:column-width="4.44cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-left="1.68cm" fo:margin-right="1.68cm" fo:margin-top="1.68cm" fo:margin-bottom="1.68cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout">
      <style:footer>
        <text:p text:style-name="Tight">Ostro templates · 1</text:p>
      </style:footer>
    </style:master-page>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Brand">OSTRO / WORKING TEMPLATES</text:p>
      <text:p text:style-name="Title">Agency invoice</text:p>
      <text:p text:style-name="Subtitle">Editable template · replace every bracketed field before use</text:p>
      <text:p text:style-name="Billing">From: [your billing name and address]<text:line-break/>Bill to: [client billing name and address]<text:line-break/>Business / tax identifiers: [add where required]</text:p>
      <text:p text:style-name="Metadata">Invoice: [unique reference]<text:line-break/>Issued: [date]<text:line-break/>Due: [agreed due date]<text:line-break/>Currency: [currency code]</text:p>
      <table:table table:name="InvoiceItems">
        <table:table-column table:style-name="DescriptionColumn"/>
        <table:table-column table:style-name="QuantityColumn"/>
        <table:table-column table:style-name="PriceColumn"/>
        <table:table-column table:style-name="TotalColumn"/>
        <table:table-row>
          <table:table-cell table:style-name="TableHeader"><text:p text:style-name="Tight">Description</text:p></table:table-cell>
          <table:table-cell table:style-name="TableHeader"><text:p text:style-name="Tight">Quantity</text:p></table:table-cell>
          <table:table-cell table:style-name="TableHeader"><text:p text:style-name="Tight">Unit price</text:p></table:table-cell>
          <table:table-cell table:style-name="TableHeader"><text:p text:style-name="Tight">Line total</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="Tight">Campaign creative and design</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="Tight">[quantity]</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="Tight">[price]</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="Tight">[amount]</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="Tight">Landing-page copywriting</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="Tight">[quantity]</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="Tight">[price]</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="Tight">[amount]</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="Tight">Approved external illustration cost</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="Tight">[quantity]</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="Tight">[price]</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="Tight">[amount]</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Tight">Subtotal: [amount]<text:line-break/>Discount, if agreed: [amount]<text:line-break/>Tax, if applicable: [rate and amount]<text:line-break/>Total: [amount]<text:line-break/>Paid: [amount]<text:line-break/>Balance due: [amount]</text:p>
      <text:p text:style-name="SectionHeading">Payment instructions</text:p>
      <text:p>[Enter the exact receiving instructions and payment reference for your agreed route.]</text:p>
      <text:p text:style-name="SectionHeading">Notes and terms</text:p>
      <text:p>[Add your agreed payment terms and any invoice notes.]</text:p>
      <text:p text:style-name="SectionHeading">Editing guidance — remove before sending</text:p>
      <text:p>Word totals are entered manually. Check all arithmetic, applicable tax details and the agreed payment terms. For automatic calculations, use the Ostro invoice generator.</text:p>
      <text:p text:style-name="SectionHeading">Before sending — remove this checklist</text:p>
      <text:p>• Check each workstream against the approved quote.</text:p>
      <text:p>• Avoid double-counting costs already included in a project fee.</text:p>
      <text:p>• Include the billing contact and any required supplier reference.</text:p>
      <text:p>Template and example: https://tryostro.com/templates/agency-invoice/</text:p>
    </office:text>
  </office:body>
</office:document>