<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
 xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
 office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
 <office:styles>
  <style:default-style style:family="paragraph">
   <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
   <style:text-properties fo:font-size="12pt"/>
  </style:default-style>
  <style:style style:name="Standard" style:family="paragraph">
   <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
   <style:text-properties fo:font-size="12pt"/>
  </style:style>
 </office:styles>
 <office:automatic-styles>
  <style:page-layout style:name="PageLayout">
   <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
  </style:page-layout>
  <style:style style:name="TitleLine" style:family="paragraph">
   <style:paragraph-properties fo:text-align="end" fo:line-height="120%" fo:margin-bottom="0.1cm"/>
   <style:text-properties fo:font-size="20pt"/>
  </style:style>
  <style:style style:name="DateLine" style:family="paragraph">
   <style:paragraph-properties fo:text-align="end" fo:line-height="100%" fo:margin-bottom="0.1cm"/>
   <style:text-properties fo:font-size="12pt"/>
  </style:style>
  <style:style style:name="TableStyle" style:family="table">
   <style:table-properties style:width="15.83cm" table:align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
  </style:style>
  <style:style style:name="TopCol1" style:family="table-column">
   <style:table-column-properties style:column-width="10.1cm"/>
  </style:style>
  <style:style style:name="TopCol2" style:family="table-column">
   <style:table-column-properties style:column-width="1.57cm"/>
  </style:style>
  <style:style style:name="TopCol3" style:family="table-column">
   <style:table-column-properties style:column-width="4.16cm"/>
  </style:style>
  <style:style style:name="Col1" style:family="table-column">
   <style:table-column-properties style:column-width="2.2cm"/>
  </style:style>
  <style:style style:name="Col2" style:family="table-column">
   <style:table-column-properties style:column-width="1.25cm"/>
  </style:style>
  <style:style style:name="Col3" style:family="table-column">
   <style:table-column-properties style:column-width="1.57cm"/>
  </style:style>
  <style:style style:name="Col4" style:family="table-column">
   <style:table-column-properties style:column-width="1.25cm"/>
  </style:style>
  <style:style style:name="Col5" style:family="table-column">
   <style:table-column-properties style:column-width="5.08cm"/>
  </style:style>
  <style:style style:name="Col6" style:family="table-column">
   <style:table-column-properties style:column-width="2.86cm"/>
  </style:style>
  <style:style style:name="Col7" style:family="table-column">
   <style:table-column-properties style:column-width="1.62cm"/>
  </style:style>
  <style:style style:name="Cell" style:family="table-cell">
   <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.04cm" style:vertical-align="middle"/>
  </style:style>
  <style:style style:name="HeaderCell" style:family="table-cell">
   <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.04cm" style:vertical-align="middle"/>
  </style:style>
  <style:style style:name="RowTop" style:family="table-row">
   <style:table-row-properties style:min-row-height="1.55cm"/>
  </style:style>
  <style:style style:name="RowCaption" style:family="table-row">
   <style:table-row-properties style:min-row-height="1.55cm"/>
  </style:style>
  <style:style style:name="RowHead" style:family="table-row">
   <style:table-row-properties style:min-row-height="3.2cm"/>
  </style:style>
  <style:style style:name="RowInput" style:family="table-row">
   <style:table-row-properties style:min-row-height="2.7cm"/>
  </style:style>
  <style:style style:name="RowSign" style:family="table-row">
   <style:table-row-properties style:min-row-height="2.7cm"/>
  </style:style>
  <style:style style:name="PLeft" style:family="paragraph">
   <style:paragraph-properties fo:text-align="start" fo:line-height="110%"/>
   <style:text-properties fo:font-size="12pt"/>
  </style:style>
  <style:style style:name="PCenter" style:family="paragraph">
   <style:paragraph-properties fo:text-align="center" fo:line-height="110%"/>
   <style:text-properties fo:font-size="12pt"/>
  </style:style>
  <style:style style:name="PHeader" style:family="paragraph">
   <style:paragraph-properties fo:text-align="center" fo:line-height="125%"/>
   <style:text-properties fo:font-size="12pt"/>
  </style:style>
 </office:automatic-styles>
 <office:master-styles>
  <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
 </office:master-styles>
 <office:body>
  <office:text>
   <text:p text:style-name="TitleLine">___________________合作社清算人就任報告書</text:p>
   <text:p text:style-name="DateLine">年 月 日</text:p>
   <table:table table:name="CompanyAndRegistration" table:style-name="TableStyle">
    <table:table-column table:style-name="TopCol1"/>
    <table:table-column table:style-name="TopCol2"/>
    <table:table-column table:style-name="TopCol3"/>
    <table:table-row table:style-name="RowTop">
     <table:table-cell table:style-name="Cell"><text:p text:style-name="PLeft">社名：</text:p></table:table-cell>
     <table:table-cell table:style-name="Cell"><text:p text:style-name="PHeader">登記證<text:line-break/>字號</text:p></table:table-cell>
     <table:table-cell table:style-name="Cell"/>
    </table:table-row>
   </table:table>
   <table:table table:name="OfficialNumber" table:style-name="TableStyle">
    <table:table-column table:style-name="Col1"/>
    <table:table-column table:style-name="Col2"/>
    <table:table-column table:style-name="Col3"/>
    <table:table-column table:style-name="Col4"/>
    <table:table-column table:style-name="Col5"/>
    <table:table-column table:style-name="Col6"/>
    <table:table-column table:style-name="Col7"/>
    <table:table-row table:style-name="RowCaption">
     <table:table-cell table:style-name="Cell" table:number-columns-spanned="7"><text:p text:style-name="PHeader">本社奉令或陳准解散之公文字號</text:p></table:table-cell>
     <table:covered-table-cell table:style-name="Cell"/>
     <table:covered-table-cell table:style-name="Cell"/>
     <table:covered-table-cell table:style-name="Cell"/>
     <table:covered-table-cell table:style-name="Cell"/>
     <table:covered-table-cell table:style-name="Cell"/>
     <table:covered-table-cell table:style-name="Cell"/>
    </table:table-row>
   </table:table>
   <table:table table:name="LiquidatorDetails" table:style-name="TableStyle">
    <table:table-column table:style-name="Col1"/>
    <table:table-column table:style-name="Col2"/>
    <table:table-column table:style-name="Col3"/>
    <table:table-column table:style-name="Col4"/>
    <table:table-column table:style-name="Col5"/>
    <table:table-column table:style-name="Col6"/>
    <table:table-column table:style-name="Col7"/>
    <table:table-row table:style-name="RowHead">
     <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="PHeader">姓　名</text:p></table:table-cell>
     <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="PHeader">出 生<text:line-break/>年<text:line-break/>月<text:line-break/>日</text:p></table:table-cell>
     <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="PHeader">出生地</text:p></table:table-cell>
     <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="PHeader">職業</text:p></table:table-cell>
     <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="PHeader">住　　址</text:p></table:table-cell>
     <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="PHeader">產 生 方 式</text:p></table:table-cell>
     <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="PHeader">是 員<text:line-break/>否 或<text:line-break/>本 職<text:line-break/>社 員</text:p></table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="RowInput">
     <table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/>
    </table:table-row>
    <table:table-row table:style-name="RowInput">
     <table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/>
    </table:table-row>
    <table:table-row table:style-name="RowInput">
     <table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/>
    </table:table-row>
    <table:table-row table:style-name="RowInput">
     <table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/>
    </table:table-row>
    <table:table-row table:style-name="RowInput">
     <table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/>
    </table:table-row>
   </table:table>
   <table:table table:name="LiquidatorSignature" table:style-name="TableStyle">
    <table:table-column table:style-name="Col1"/>
    <table:table-column table:style-name="Col2"/>
    <table:table-column table:style-name="Col3"/>
    <table:table-column table:style-name="Col4"/>
    <table:table-column table:style-name="Col5"/>
    <table:table-column table:style-name="Col6"/>
    <table:table-column table:style-name="Col7"/>
    <table:table-row table:style-name="RowSign">
     <table:table-cell table:style-name="Cell" table:number-columns-spanned="7"><text:p text:style-name="PLeft">合作社清算人：</text:p></table:table-cell>
     <table:covered-table-cell table:style-name="Cell"/>
     <table:covered-table-cell table:style-name="Cell"/>
     <table:covered-table-cell table:style-name="Cell"/>
     <table:covered-table-cell table:style-name="Cell"/>
     <table:covered-table-cell table:style-name="Cell"/>
     <table:covered-table-cell table:style-name="Cell"/>
    </table:table-row>
   </table:table>
  </office:text>
 </office:body>
</office:document>