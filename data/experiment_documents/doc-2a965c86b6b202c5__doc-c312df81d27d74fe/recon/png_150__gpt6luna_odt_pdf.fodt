<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:default-style>
    <style:style style:name="Standard" style:family="paragraph"/>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="2.4cm" fo:margin-bottom="2.4cm" fo:margin-left="2.45cm" fo:margin-right="2.45cm"/>
    </style:page-layout>
    <style:style style:name="TitleLine" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="DateLine" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Gap" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="6pt"/>
    </style:style>
    <style:style style:name="CellText" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="FooterText" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="2.22cm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="1.27cm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="1.59cm"/>
    </style:style>
    <style:style style:name="ColD" style:family="table-column">
      <style:table-column-properties style:column-width="1.27cm"/>
    </style:style>
    <style:style style:name="ColE" style:family="table-column">
      <style:table-column-properties style:column-width="5.08cm"/>
    </style:style>
    <style:style style:name="ColF" style:family="table-column">
      <style:table-column-properties style:column-width="2.87cm"/>
    </style:style>
    <style:style style:name="ColG" style:family="table-column">
      <style:table-column-properties style:column-width="1.62cm"/>
    </style:style>
    <style:style style:name="TopColA" style:family="table-column">
      <style:table-column-properties style:column-width="10.16cm"/>
    </style:style>
    <style:style style:name="TopColB" style:family="table-column">
      <style:table-column-properties style:column-width="1.59cm"/>
    </style:style>
    <style:style style:name="TopColC" style:family="table-column">
      <style:table-column-properties style:column-width="4.17cm"/>
    </style:style>
    <style:style style:name="FormCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.02cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.02cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="RowTop" style:family="table-row">
      <style:table-row-properties style:row-height="1.12cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RowNotice" style:family="table-row">
      <style:table-row-properties style:row-height="1.14cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RowHeader" style:family="table-row">
      <style:table-row-properties style:row-height="2.31cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RowEntry" style:family="table-row">
      <style:table-row-properties style:row-height="1.94cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RowFooter" style:family="table-row">
      <style:table-row-properties style:row-height="1.96cm" style:use-optimal-row-height="false"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="DefaultPage" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="TitleLine">_____________________________合作社清算人就任報告書</text:p>
      <text:p text:style-name="DateLine">年 月 日</text:p>
      <text:p text:style-name="Gap"/>
      <table:table table:name="基本資料">
        <table:table-column table:style-name="TopColA"/>
        <table:table-column table:style-name="TopColB"/>
        <table:table-column table:style-name="TopColC"/>
        <table:table-row table:style-name="RowTop">
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellText">社名：</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellCenter">登 記 證</text:p>
            <text:p text:style-name="CellCenter">字 號</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="RowNotice">
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="3">
            <text:p text:style-name="CellText">本社奉令或陳准解散之公文字號</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <table:table table:name="清算人資料">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColD"/>
        <table:table-column table:style-name="ColE"/>
        <table:table-column table:style-name="ColF"/>
        <table:table-column table:style-name="ColG"/>
        <table:table-row table:style-name="RowHeader">
          <table:table-cell table:style-name="HeaderCell">
            <text:p text:style-name="CellCenter">姓　名</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="HeaderCell">
            <text:p text:style-name="CellCenter">出 生</text:p>
            <text:p text:style-name="CellCenter">年</text:p>
            <text:p text:style-name="CellCenter">月</text:p>
            <text:p text:style-name="CellCenter">日</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="HeaderCell">
            <text:p text:style-name="CellCenter">出 生 地</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="HeaderCell">
            <text:p text:style-name="CellCenter">職　業</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="HeaderCell">
            <text:p text:style-name="CellCenter">住　址</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="HeaderCell">
            <text:p text:style-name="CellCenter">產 生 方 式</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="HeaderCell">
            <text:p text:style-name="CellCenter">是</text:p>
            <text:p text:style-name="CellCenter">否</text:p>
            <text:p text:style-name="CellCenter">本</text:p>
            <text:p text:style-name="CellCenter">社</text:p>
            <text:p text:style-name="CellCenter">社</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowEntry">
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="RowEntry">
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="RowEntry">
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="RowEntry">
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="RowEntry">
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="RowFooter">
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="7">
            <text:p text:style-name="FooterText">合作社清算人：</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>