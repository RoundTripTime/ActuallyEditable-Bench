<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
                 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
                 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
                 xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
                 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
                 office:mimetype="application/vnd.oasis.opendocument.text"
                 office:version="1.4">
  <office:styles>
    <style:style style:name="BaseText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm"
                                    fo:margin-top="2.5cm" fo:margin-bottom="2cm"
                                    fo:margin-left="2.2cm" fo:margin-right="2.2cm"/>
    </style:page-layout>
    <style:style style:name="PageStart" style:family="paragraph" style:parent-style-name="BaseText">
      <style:paragraph-properties fo:break-before="page" fo:margin-left="0.3cm" fo:margin-bottom="0.9cm"/>
    </style:style>
    <style:style style:name="TitleLine" style:family="paragraph" style:parent-style-name="BaseText">
      <style:paragraph-properties fo:text-align="center" fo:line-height="0.53cm" fo:margin-bottom="0.1cm"/>
    </style:style>
    <style:style style:name="TitleSecond" style:family="paragraph" style:parent-style-name="BaseText">
      <style:paragraph-properties fo:text-align="center" fo:line-height="0.53cm" fo:margin-bottom="2.2cm"/>
    </style:style>
    <style:style style:name="ClubLabel" style:family="paragraph" style:parent-style-name="BaseText">
      <style:paragraph-properties fo:text-align="end" fo:margin-left="11cm" fo:margin-right="0.25cm"
                                  fo:border-bottom="0.5pt solid #000000" fo:margin-bottom="0.65cm"/>
      <style:text-properties fo:font-size="14pt" fo:font-weight="bold" style:text-underline-style="solid"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="16.6cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="3.34cm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="5.5cm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="2.39cm"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties style:column-width="5.37cm"/>
    </style:style>
    <style:style style:name="HeaderRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.28cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="InputRow" style:family="table-row">
      <style:table-row-properties style:row-height="6.4cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="HeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="InputCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="HeaderText" style:family="paragraph" style:parent-style-name="BaseText">
      <style:paragraph-properties fo:text-align="center" fo:line-height="0.53cm"/>
    </style:style>
    <style:style style:name="FooterText" style:family="paragraph" style:parent-style-name="BaseText">
      <style:paragraph-properties fo:margin-left="0.3cm" fo:margin-top="1.6cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">別紙</text:p>
      <text:p text:style-name="TitleLine">令和　　年度東郷町高齢者花壇管理事業</text:p>
      <text:p text:style-name="TitleSecond">（花いっぱい活動事業）計画書</text:p>
      <text:p text:style-name="ClubLabel">老人クラブ</text:p>
      <table:table table:name="花壇管理事業計画" table:style-name="FormTable">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="HeaderCell">
            <text:p text:style-name="HeaderText">実　施　日</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="HeaderCell">
            <text:p text:style-name="HeaderText">実　施　場　所</text:p>
            <text:p text:style-name="HeaderText">（花壇設置場所）</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="HeaderCell">
            <text:p text:style-name="HeaderText">面　積</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="HeaderCell">
            <text:p text:style-name="HeaderText">事　業　内　容</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="InputCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="FooterText">　　※　花壇設置場所一覧表を参考に記入してください。</text:p>
    </office:text>
  </office:body>
</office:document>