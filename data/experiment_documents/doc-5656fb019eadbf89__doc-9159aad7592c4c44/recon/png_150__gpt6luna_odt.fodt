<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:text-properties fo:font-size="11pt"/>
      <style:paragraph-properties fo:margin="0in" fo:line-height="100%"/>
    </style:default-style>
  </office:styles>
  <office:automatic-styles>
    <style:style style:name="Appendix" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.40in"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="Title1" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.48in"/>
      <style:text-properties fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="Title2" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.08in"/>
      <style:text-properties fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="Club" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0.78in" fo:margin-bottom="0.35in"/>
      <style:text-properties fo:font-size="15pt" fo:font-weight="bold" style:text-underline-style="solid"/>
    </style:style>
    <style:style style:name="HeaderCell" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin="0in" fo:line-height="100%"/>
      <style:text-properties fo:font-size="13pt"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.62in" fo:margin-left="0.34in"/>
      <style:text-properties fo:font-size="13pt"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="6.53in" table:align="left" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="1.31in"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="2.17in"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="0.94in"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties style:column-width="2.11in"/>
    </style:style>
    <style:style style:name="HeaderRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.50in" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="InputRow" style:family="table-row">
      <style:table-row-properties style:row-height="2.00in" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:border="0.5pt solid #000000" fo:padding="0.03in"/>
    </style:style>
    <style:style style:name="PageLayout" style:family="paragraph">
      <style:paragraph-properties fo:margin="0in"/>
    </style:style>
    <style:page-layout style:name="PageLayout1">
      <style:page-layout-properties fo:page-width="8.27in" fo:page-height="11.69in" fo:margin="0.87in"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout1"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Appendix">別紙</text:p>
      <text:p text:style-name="Title1">令和　　年度東郷町高齢者花壇管理事業</text:p>
      <text:p text:style-name="Title2">（花いっぱい活動事業）計画書</text:p>
      <text:p text:style-name="Club">老人クラブ</text:p>
      <table:table table:name="計画書" table:style-name="FormTable">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="HeaderCell">実　施　日</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="HeaderCell">実　施　場　所</text:p>
            <text:p text:style-name="HeaderCell">（花壇設置場所）</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="HeaderCell">面　積</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="HeaderCell">事　業　内　容</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Note">※　花壇設置場所一覧表を参考に記入してください。</text:p>
    </office:text>
  </office:body>
</office:document>