<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties style:font-name="serif" fo:font-size="10pt" style:font-name-asian="Noto Serif CJK JP" style:font-size-asian="10pt"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0.8cm" fo:break-before="page"/>
      <style:text-properties fo:font-size="16pt" style:font-size-asian="16pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Left" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.5cm" fo:margin-bottom="1.5cm" fo:margin-left="1.9cm" fo:margin-right="1.9cm"/>
    </style:page-layout>
    <style:style style:name="Master" style:family="table">
      <style:table-properties/>
    </style:style>
    <style:style style:name="ColTop1" style:family="table-column">
      <style:table-column-properties style:column-width="4.4cm"/>
    </style:style>
    <style:style style:name="ColTop2" style:family="table-column">
      <style:table-column-properties style:column-width="0.85cm"/>
    </style:style>
    <style:style style:name="ColTop3" style:family="table-column">
      <style:table-column-properties style:column-width="3.6cm"/>
    </style:style>
    <style:style style:name="ColTop4" style:family="table-column">
      <style:table-column-properties style:column-width="8.35cm"/>
    </style:style>
    <style:style style:name="ColLower1" style:family="table-column">
      <style:table-column-properties style:column-width="4.4cm"/>
    </style:style>
    <style:style style:name="ColLower2" style:family="table-column">
      <style:table-column-properties style:column-width="4.15cm"/>
    </style:style>
    <style:style style:name="ColLower3" style:family="table-column">
      <style:table-column-properties style:column-width="1.5cm"/>
    </style:style>
    <style:style style:name="ColLower4" style:family="table-column">
      <style:table-column-properties style:column-width="2.75cm"/>
    </style:style>
    <style:style style:name="ColLower5" style:family="table-column">
      <style:table-column-properties style:column-width="4.4cm"/>
    </style:style>
    <style:style style:name="ColLast1" style:family="table-column">
      <style:table-column-properties style:column-width="4.4cm"/>
    </style:style>
    <style:style style:name="ColLast2" style:family="table-column">
      <style:table-column-properties style:column-width="12.8cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellTight" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.03cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="100%"/>
      <style:text-properties fo:font-size="9pt" style:font-size-asian="9pt"/>
    </style:style>
    <style:style style:name="Field" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end"/>
    </style:style>
    <style:style style:name="IntroCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.35cm 0.45cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">市民税県民税・森林環境税　特別徴収納期特例承認申請書</text:p>
      <table:table table:name="申請者">
        <table:table-column table:style-name="ColTop1"/>
        <table:table-column table:style-name="ColTop2"/>
        <table:table-column table:style-name="ColTop3"/>
        <table:table-column table:style-name="ColTop4"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="6">
            <text:p text:style-name="Center">年　　月　　日</text:p>
            <text:p text:style-name="Center"><text:line-break/>丸亀市長　宛</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="4">
            <text:p text:style-name="Small">申</text:p>
            <text:p text:style-name="Small">請</text:p>
            <text:p text:style-name="Small">者</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="Center">特別徴収義務者</text:p>
            <text:p text:style-name="Center">指　定　番　号</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">法　人　番　号</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">氏名又は名称</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">住　所　又　は</text:p><text:p text:style-name="Center">事務所の所在地</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">担　当　者</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">電　話　番　号</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="IntroCell" table:number-columns-spanned="4">
            <text:p>地方税法第321条の5の2及び丸亀市市税条例第51条の2に規定する市民税県民税・</text:p>
            <text:p>森林環境税の特別徴収税額の納期の特例について承認を受けたいので、同法施行令第48</text:p>
            <text:p>条の9の10及び同条例第51条の3の規定により、次のとおり申請します。</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <table:table table:name="特例を受けようとする税額">
        <table:table-column table:style-name="ColLower1"/>
        <table:table-column table:style-name="ColLower2"/>
        <table:table-column table:style-name="ColLower3"/>
        <table:table-column table:style-name="ColLower4"/>
        <table:table-column table:style-name="ColLower5"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">特例の適用を受けよ</text:p><text:p text:style-name="Center">うとする税額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Center">年　　月　以後の特別徴収税額</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="6"><text:p>給与（月別）を受け</text:p><text:p>る者の人数、常雇・</text:p><text:p>臨時の別及び給与額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">申請日の属する</text:p><text:p text:style-name="Center">月前６か月間</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">常・</text:p><text:p text:style-name="Center">臨</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">人数</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">給与額（合計）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Field">年　　　月</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Center">常</text:p><text:p text:style-name="Center">臨</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Field">人</text:p><text:p text:style-name="Field">人</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Field">円</text:p><text:p text:style-name="Field">円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Field">年　　　月</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Center">常</text:p><text:p text:style-name="Center">臨</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Field">人</text:p><text:p text:style-name="Field">人</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Field">円</text:p><text:p text:style-name="Field">円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Field">年　　　月</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Center">常</text:p><text:p text:style-name="Center">臨</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Field">人</text:p><text:p text:style-name="Field">人</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Field">円</text:p><text:p text:style-name="Field">円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Field">年　　　月</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Center">常</text:p><text:p text:style-name="Center">臨</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Field">人</text:p><text:p text:style-name="Field">人</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Field">円</text:p><text:p text:style-name="Field">円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Field">年　　　月</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Center">常</text:p><text:p text:style-name="Center">臨</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Field">人</text:p><text:p text:style-name="Field">人</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Field">円</text:p><text:p text:style-name="Field">円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Field">年　　　月</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Center">常</text:p><text:p text:style-name="Center">臨</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Field">人</text:p><text:p text:style-name="Field">人</text:p></table:cell>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Field">円</text:p><text:p text:style-name="Field">円</text:p></table:cell>
        </table:table-row>
      </table:table>
      <table:table table:name="確認事項">
        <table:table-column table:style-name="ColLast1"/>
        <table:table-column table:style-name="ColLast2"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>丸亀市における徴収</text:p><text:p>金の滞納の有無</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>やむを得ず滞納して</text:p><text:p>いる場合はその理由</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>過去１年間の同承認</text:p><text:p>申請の取消の有無</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>