<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%" fo:orphans="1" fo:widows="1"/>
      <style:text-properties style:font-name="Noto Serif CJK JP" fo:font-size="11pt" style:font-name-asian="Noto Serif CJK JP" style:font-size-asian="11pt"/>
    </style:default-style>
    <style:style style:name="P" style:family="paragraph"/>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.3cm" fo:margin-bottom="0.7cm"/>
      <style:text-properties fo:font-size="12pt" style:font-size-asian="12pt"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="1.8cm" fo:margin-bottom="1.8cm" fo:margin-left="2.8cm" fo:margin-right="2.8cm"/>
    </style:page-layout>
    <style:style style:name="MainTable" style:family="table">
      <style:table-properties style:width="15.4cm" table:align="margins"/>
    </style:style>
    <style:style style:name="ConsentTable" style:family="table">
      <style:table-properties style:width="15.4cm" table:align="margins"/>
    </style:style>
    <style:style style:name="SingleTable" style:family="table">
      <style:table-properties style:width="15.4cm" table:align="margins"/>
    </style:style>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="2.8cm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="2.8cm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="4.9cm"/>
    </style:style>
    <style:style style:name="ColD" style:family="table-column">
      <style:table-column-properties style:column-width="4.9cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #333333" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #333333" fo:padding="0.08cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="CellTop" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #333333" fo:padding="0.12cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="ConsentCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #333333" fo:padding="0.18cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="ShortRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.85cm" style:use-optimal-row-height="true"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="P">別　記</text:p>
      <text:p text:style-name="P">　様式第１号（第６条関係）</text:p>
      <text:p text:style-name="Right">年　　　月　　　日</text:p>
      <text:p text:style-name="P">　守山市長　あて</text:p>
      <text:p text:style-name="Right">（〒　　　　　ー　　　　　）</text:p>
      <text:p text:style-name="Right">申請者　住所</text:p>
      <text:p text:style-name="Right">　　　　　名前</text:p>
      <text:p text:style-name="Right">　　　　　電話番号</text:p>
      <text:p text:style-name="Title">守山市フリースクール等利用児童生徒支援助成金交付申請書</text:p>
      <text:p text:style-name="P">　　　年度において、標記の助成金の交付を受けたいので、守山市フリースクール</text:p>
      <text:p text:style-name="P">等利用児童生徒支援助成金交付要綱第６条第１項の規定により、下記のとおり申請し</text:p>
      <text:p text:style-name="P">ます。</text:p>
      <text:p text:style-name="Center">記</text:p>
      <table:table table:name="Application" table:style-name="MainTable">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColD"/>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-rows-spanned="3"><text:p>児童生徒</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>（ふりがな）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellCenter"><text:p>氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellCenter"><text:p>在籍校名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Right">学校　第　　　学年　　　組</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-columns-spanned="2"><text:p>利用フリースクール等の名称</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-columns-spanned="2"><text:p>利用期間</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>年　　　月　　日から　　年　　月　　日まで（週　　日）</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-columns-spanned="2"><text:p>助成対象区分等</text:p><text:p>（該当する□にチェックをいれてくださ</text:p><text:p>い）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>□生活保護の受給者（助成割合　10/10）</text:p><text:p>□就学援助の受給者（助成割合　3/4）</text:p><text:p>□上記以外の者　　　（助成割合　1/2）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-columns-spanned="2"><text:p>フリースクール等の授業料</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>月額・日額　　　　　　　　　円</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-columns-spanned="2"><text:p>１月あたりの助成対象経費</text:p><text:p>（見込み）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Right">円（上限40,000円）</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-columns-spanned="2"><text:p>１月あたりの助成額</text:p><text:p>（見込み）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>申請額：助成対象経費×助成割合</text:p><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="P">（注）助成対象経費は授業料に限る。</text:p>
      <text:p text:style-name="P">○承諾書（必須）</text:p>
      <table:table table:name="ConsentPage1" table:style-name="ConsentTable">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColD"/>
        <table:table-row>
          <table:table-cell table:style-name="ConsentCell" table:number-columns-spanned="4">
            <text:p>・標記の助成金に係る交付資格の認否決定に伴い、私および私の世帯に属する者に</text:p>
            <text:p>関する所得状況等の確認をするために、関係各課へ照会することおよび住民基本</text:p>
            <text:p>台帳、課税台帳等を閲覧することを承諾します。</text:p>
            <text:p>・助成対象者として認定した場合、申請内容について利用するフリースクール等に</text:p>
            <text:p>情報提供することを承諾します。</text:p>
            <text:p>・フリースクール等での児童生徒に関する情報について、市教育委員会、在籍学校</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageStart"/>
      <table:table table:name="ConsentPage2" table:style-name="SingleTable">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColD"/>
        <table:table-row>
          <table:table-cell table:style-name="ConsentCell" table:number-columns-spanned="4">
            <text:p>および当該フリースクール等が情報共有することを承諾します。</text:p>
            <text:p>年　　　月　　　日</text:p>
            <text:p>　　　　　　　　保護者名</text:p>
            <text:p>　　　　　　　　生年月日　　　　　　　年　　　月　　　日</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>