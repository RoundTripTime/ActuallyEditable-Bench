<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:default-style>
    <style:style style:name="Centered" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="6mm" fo:margin-bottom="7mm"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" fo:margin-top="14mm" fo:margin-bottom="14mm" fo:margin-left="14mm" fo:margin-right="14mm"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="182mm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ConsentTable" style:family="table">
      <style:table-properties style:width="182mm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="54mm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="40mm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="88mm"/>
    </style:style>
    <style:style style:name="ColAll" style:family="table-column">
      <style:table-column-properties style:column-width="182mm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="1mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="ConsentCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="2mm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="NoBorderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0mm" style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p>別　記</text:p>
      <text:p>様式第１号（第６条関係）</text:p>
      <text:p style:style-name="Right">年　　　月　　　日</text:p>
      <text:p>守山市長　あて</text:p>
      <table:table table:name="Applicant" table:style-name="FormTable">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-row>
          <table:table-cell table:number-columns-spanned="3" table:style-name="NoBorderCell"><text:p style:style-name="Right">（〒　　　　－　　　）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:number-columns-spanned="3" table:style-name="NoBorderCell"><text:p style:style-name="Right">申請者　住　　所</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:number-columns-spanned="3" table:style-name="NoBorderCell"><text:p style:style-name="Right">　　　　名　　前</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:number-columns-spanned="3" table:style-name="NoBorderCell"><text:p style:style-name="Right">　　　　電話番号</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p style:style-name="Title">守山市フリースクール等利用児童生徒支援助成金交付申請書</text:p>
      <text:p>　　　　年度において、標記の助成金の交付を受けたいので、守山市フリースクール</text:p>
      <text:p>等利用児童生徒支援助成金交付要綱第６条第１項の規定により、下記のとおり申請し</text:p>
      <text:p>ます。</text:p>
      <text:p style:style-name="Centered">記</text:p>
      <table:table table:name="ApplicationDetails" table:style-name="FormTable">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-row>
          <table:table-cell table:number-rows-spanned="2" table:style-name="Cell"><text:p style:style-name="Centered">児童生徒</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p style:style-name="Centered">（ふりがな）</text:p><text:p style:style-name="Centered">氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p style:style-name="Centered">在籍校名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p style:style-name="Right">学校　第　　学年　　組</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p style:style-name="Centered">利用フリースクール等の名称</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p/></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p style:style-name="Centered">利用期間</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p style:style-name="Centered">年　　月　日から　　年　月　日まで（週　日）</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p style:style-name="Centered">助成対象区分等</text:p><text:p style:style-name="Centered">（該当する□にチェックをいれてください）</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell">
            <text:p>□生活保護の受給者（助成割合　10/10）</text:p>
            <text:p>□就学援助の受給者（助成割合　３/４）</text:p>
            <text:p>□上記以外の者　　（助成割合　１/２）</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p style:style-name="Centered">フリースクール等の授業料</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p style:style-name="Centered">月額・日額　　　　　　　　円</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p style:style-name="Centered">１月あたりの助成対象経費</text:p><text:p style:style-name="Centered">（見込み）</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p style:style-name="Right">円（上限 40,000 円）</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p style:style-name="Centered">１月あたりの助成額</text:p><text:p style:style-name="Centered">（見込み）</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p>申請額：助成対象経費×助成割合</text:p><text:p style:style-name="Right">円</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p>（注）助成対象経費は授業料に限る。</text:p>
      <text:p>〇承諾書（必須）</text:p>
      <table:table table:name="ConsentPageOne" table:style-name="ConsentTable">
        <table:table-column table:style-name="ColAll"/>
        <table:table-row>
          <table:table-cell table:style-name="ConsentCell">
            <text:p>・標記の助成金に係る交付資格の認否決定に伴い、私および私の世帯に属する者に関する所得状況等の確認をするために、関係各課へ照会することおよび住民基本台帳、課税台帳等を閲覧することを承諾します。</text:p>
            <text:p>・助成対象者として認定した場合、申請内容について利用するフリースクール等に情報提供することを承諾します。</text:p>
            <text:p>・フリースクール等での児童生徒に関する情報について、市教育委員会、在籍学校</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p style:style-name="PageBreak"/>
      <table:table table:name="ConsentPageTwo" table:style-name="ConsentTable">
        <table:table-column table:style-name="ColAll"/>
        <table:table-row>
          <table:table-cell table:style-name="ConsentCell">
            <text:p>および当該フリースクール等が情報共有することを承諾します。</text:p>
            <text:p>　　　　年　　月　　日</text:p>
            <text:p>　　　　　　　保護者名</text:p>
            <text:p>　　　　　　　生年月日　　　　　　　　年　　月　　日</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>