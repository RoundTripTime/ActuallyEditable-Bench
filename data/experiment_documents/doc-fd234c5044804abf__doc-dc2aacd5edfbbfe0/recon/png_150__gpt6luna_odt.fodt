<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.12cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.25cm" fo:margin-bottom="0.8cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="19pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="9.5pt"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0cm" fo:margin-bottom="0.15cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="TableText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="TableCenter" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0.2cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="GridCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="SlashCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle" style:diagonal-bl-tr="0.5pt solid #000000"/>
    </style:style>
    <style:style style:name="TotalCell" style:family="table-cell">
      <style:table-cell-properties fo:border="1.2pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.8cm" fo:margin-bottom="1.7cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
    </style:page-layout>
    <style:style style:name="InfoA" style:family="table-column">
      <style:table-column-properties style:column-width="2cm"/>
    </style:style>
    <style:style style:name="InfoB" style:family="table-column">
      <style:table-column-properties style:column-width="5.8cm"/>
    </style:style>
    <style:style style:name="InfoC" style:family="table-column">
      <style:table-column-properties style:column-width="2cm"/>
    </style:style>
    <style:style style:name="InfoD" style:family="table-column">
      <style:table-column-properties style:column-width="7.2cm"/>
    </style:style>
    <style:style style:name="ItemCol" style:family="table-column">
      <style:table-column-properties style:column-width="5cm"/>
    </style:style>
    <style:style style:name="AmountCol" style:family="table-column">
      <style:table-column-properties style:column-width="3.1cm"/>
    </style:style>
    <style:style style:name="CountCol" style:family="table-column">
      <style:table-column-properties style:column-width="1.5cm"/>
    </style:style>
    <style:style style:name="SumCol" style:family="table-column">
      <style:table-column-properties style:column-width="3.5cm"/>
    </style:style>
    <style:style style:name="DeliveryCol" style:family="table-column">
      <style:table-column-properties style:column-width="3.9cm"/>
    </style:style>
    <style:style style:name="LowerLabelCol" style:family="table-column">
      <style:table-column-properties style:column-width="4.3cm"/>
    </style:style>
    <style:style style:name="LowerInputCol" style:family="table-column">
      <style:table-column-properties style:column-width="12.7cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">令和　　年　ふるさと納税寄附申出書</text:p>
      <text:p text:style-name="Right">令和　　年　　月　　日</text:p>
      <text:p text:style-name="Body">大　熊　町　長　あて</text:p>
      <table:table table:name="申出者情報">
        <table:table-column table:style-name="InfoA"/>
        <table:table-column table:style-name="InfoB"/>
        <table:table-column table:style-name="InfoC"/>
        <table:table-column table:style-name="InfoD"/>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">ご　住　所</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="GridCell"><text:p text:style-name="TableText">〒</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:number-rows-spanned="2" table:style-name="GridCell"><text:p text:style-name="TableCenter">（ふりがな<br/>お　名　前<br/>な）</text:p></table:table-cell>
          <table:table-cell table:number-rows-spanned="2" table:style-name="GridCell"><text:p text:style-name="TableText"/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">電話番号</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">mail</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText"/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body">次のとおり寄附をしたいので申し出ます。</text:p>
      <table:table table:name="寄附申込品目">
        <table:table-column table:style-name="ItemCol"/>
        <table:table-column table:style-name="AmountCol"/>
        <table:table-column table:style-name="CountCol"/>
        <table:table-column table:style-name="SumCol"/>
        <table:table-column table:style-name="DeliveryCol"/>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">返礼品の有無</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">寄　附　金　額</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">申込<br/>口数</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">合　計　金　額</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">配達希望<br/>（※１）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">□返礼品を希望しない</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">　　　　　　　　　円</text:p></table:table-cell>
          <table:table-cell table:style-name="SlashCell"><text:p text:style-name="TableText"/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">　　　　　　　　　円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">□おおくまベリー２トレー</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">１口　10,000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">　口</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">　　　　　　　　　円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">　月　　日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">□おおくまベリー４トレー</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">１口　20,000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">　口</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">　　　　　　　　　円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">　月</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">□おおくまベリー６トレー</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">１口　25,000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">　口</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">　　　　　　　　　円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">　月</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">□飲む蒟蒻ゼリーセット</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">１口　10,000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">　口</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">　　　　　　　　　円</text:p></table:table-cell>
          <table:table-cell table:style-name="SlashCell"><text:p text:style-name="TableText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">□セミドライフルーツセット</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">１口　15,000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">　口</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">　　　　　　　　　円</text:p></table:table-cell>
          <table:table-cell table:style-name="SlashCell"><text:p text:style-name="TableText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">□ミニトマト　1kg</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">１口　15,000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">　口</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">　　　　　　　　　円</text:p></table:table-cell>
          <table:table-cell table:style-name="SlashCell"><text:p text:style-name="TableText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">□日本酒（帰忘郷）１本</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">１口　15,000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">　口</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">　　　　　　　　　円</text:p></table:table-cell>
          <table:table-cell table:style-name="SlashCell"><text:p text:style-name="TableText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">□日本酒（帰忘郷）２本</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">１口　25,000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">　口</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">　　　　　　　　　円</text:p></table:table-cell>
          <table:table-cell table:style-name="SlashCell"><text:p text:style-name="TableText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">□甘酒（帰忘郷）８本セット</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">１口　15,000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">　口</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">　　　　　　　　　円</text:p></table:table-cell>
          <table:table-cell table:style-name="SlashCell"><text:p text:style-name="TableText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">□ストロベリーシープ 280 g</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">１口　20,000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">　口</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">　　　　　　　　　円</text:p></table:table-cell>
          <table:table-cell table:style-name="SlashCell"><text:p text:style-name="TableText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:number-columns-spanned="3" table:style-name="TotalCell"><text:p text:style-name="TableCenter">寄　附　総　額</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="TotalCell"><text:p text:style-name="TableText">　　　　　　　　　円</text:p></table:table-cell>
          <table:table-cell table:style-name="TotalCell"><text:p text:style-name="TableText"/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body">（※1）配達希望につきましては、商品ごとに異なりますので、公式HPをご確認ください。</text:p>
      <text:p text:style-name="Body">「寄附金の使途の希望」、「寄附の方法」については該当する□欄を黒く（■）塗りつぶしてください。</text:p>
      <table:table table:name="寄附方法等">
        <table:table-column table:style-name="LowerLabelCol"/>
        <table:table-column table:style-name="LowerInputCol"/>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">寄附金の使途の希望</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">　□　町に任せる</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">寄附の方法</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell">
            <text:p text:style-name="TableText">　□　現金書留払い</text:p>
            <text:p text:style-name="TableText">　□　町役場へ直接持参</text:p>
            <text:p text:style-name="TableText">　□　口座振込（手数料は自己負担となります）</text:p>
            <text:p text:style-name="TableText">　□　郵便振替（手数料がかからない専用の払込票を送付いたします）</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">ワンストップ特例<br/>（利用する場合のみ）</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell">
            <text:p text:style-name="TableText">　□　利用する</text:p>
            <text:p text:style-name="TableText">　　　利用するにチェックした方は、必ず下記もご記入ください。</text:p>
            <text:p text:style-name="TableText">　　　性　別　　□　男性　　　□　女性</text:p>
            <text:p text:style-name="TableText">　　　生年月日（　昭和・平成　　　年　　　月　　　日　）</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableCenter">備考</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText"/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageStart">お問い合わせ先　　〒979-1306　福島県双葉郡大熊町大字大川原字南平 1717</text:p>
      <text:p text:style-name="Body">　　　　　　　　　大熊町役場　総務課　財政係　（TEL：0240-23-7582　FAX：0240-23-7845）</text:p>
    </office:text>
  </office:body>
</office:document>