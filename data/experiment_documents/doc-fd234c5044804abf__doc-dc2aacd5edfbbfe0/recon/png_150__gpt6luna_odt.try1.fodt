<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="10pt"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.7cm" fo:margin-bottom="1.1cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="18pt"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Page2Start" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0.3cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-left="1.4cm" fo:margin-right="1.4cm" fo:margin-top="1.3cm" fo:margin-bottom="1.3cm"/>
    </style:page-layout>
    <style:style style:name="TableBase" style:family="table">
      <style:table-properties style:width="18.2cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellTop" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="CellDiag" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle" style:diagonal-bl-tr="0.5pt solid #000000"/>
    </style:style>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="2cm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="7cm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="2cm"/>
    </style:style>
    <style:style style:name="ColD" style:family="table-column">
      <style:table-column-properties style:column-width="7.2cm"/>
    </style:style>
    <style:style style:name="Item1" style:family="table-column">
      <style:table-column-properties style:column-width="5.3cm"/>
    </style:style>
    <style:style style:name="Item2" style:family="table-column">
      <style:table-column-properties style:column-width="3.2cm"/>
    </style:style>
    <style:style style:name="Item3" style:family="table-column">
      <style:table-column-properties style:column-width="1.6cm"/>
    </style:style>
    <style:style style:name="Item4" style:family="table-column">
      <style:table-column-properties style:column-width="3.8cm"/>
    </style:style>
    <style:style style:name="Item5" style:family="table-column">
      <style:table-column-properties style:column-width="4.3cm"/>
    </style:style>
    <style:style style:name="Note1" style:family="table-column">
      <style:table-column-properties style:column-width="4.5cm"/>
    </style:style>
    <style:style style:name="Note2" style:family="table-column">
      <style:table-column-properties style:column-width="13.7cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="DefaultPage" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">令和　　年　ふるさと納税寄附申出書</text:p>
      <text:p text:style-name="Right">令和　　年　　月　　日</text:p>
      <text:p>大　熊　町　長　あて</text:p>
      <table:table table:name="Applicant" table:style-name="TableBase">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColD"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>ご　住　所</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p>〒</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2"><text:p>（ふりがな<text:line-break/>お　名　前<text:line-break/>な）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>電話番号</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>mail</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p/>
      <text:p>次のとおり寄附をしたいので申し出ます。</text:p>
      <table:table table:name="DonationChoices" table:style-name="TableBase">
        <table:table-column table:style-name="Item1"/>
        <table:table-column table:style-name="Item2"/>
        <table:table-column table:style-name="Item3"/>
        <table:table-column table:style-name="Item4"/>
        <table:table-column table:style-name="Item5"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">返礼品の有無</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">寄　附　金　額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">申込<text:line-break/>口数</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">合　計　金　額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">配達希望<text:line-break">（※１）</text:line-break></text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>□返礼品を希望しない</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:table-cell table:style-name="CellDiag"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>□おおくまベリー２トレー</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>１口　10，000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">月</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>□おおくまベリー４トレー</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>１口　20，000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">月</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>□おおくまベリー６トレー</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>１口　25，000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">月</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>□飲む蒟蒻ゼリーセット</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>１口　10，000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:table-cell table:style-name="CellDiag"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>□セミドライフルーツセット</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>１口　15，000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:table-cell table:style-name="CellDiag"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>□ミニトマト　1kg</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>１口　15，000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:table-cell table:style-name="CellDiag"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>□日本酒（帰忘郷）１本</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>１口　15，000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:table-cell table:style-name="CellDiag"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>□日本酒（帰忘郷）２本</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>１口　25，000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:table-cell table:style-name="CellDiag"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>□甘酒（帰忘郷）８本セット</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>１口　15，000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:table-cell table:style-name="CellDiag"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>□ストロベリーシープ280 ｇ</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>１口　20，000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:table-cell table:style-name="CellDiag"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Center">寄　附　総　額</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p>（※1）配達希望につきましては、商品ごとに異なりますので、公式HPをご確認ください。</text:p>
      <text:p/>
      <text:p>「寄附金の使途の希望」、「寄附の方法」については該当する□欄を黒く（■）塗りつぶしてください。</text:p>
      <table:table table:name="AdditionalInformation" table:style-name="TableBase">
        <table:table-column table:style-name="Note1"/>
        <table:table-column table:style-name="Note2"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">寄附金の使途の希望</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>　□　町に任せる</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">寄附の方法</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>　□　現金書留払い<text:line-break/>　□　町役場へ直接持参<text:line-break/>　□　口座振込（手数料は自己負担となります）<text:line-break/>　□　郵便振替（手数料がかからない専用の払込票を送付いたします）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">ワンストップ特例<text:line-break/>（利用する場合のみ）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>　□　利用する<text:line-break/>　　　利用するにチェックした方は、必ず下記もご記入ください。<text:line-break/>　　　性　　別　　□　男性　　　□　女性<text:line-break/>　　　生年月日（　昭和・平成　　年　　月　　日　）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">備考</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Page2Start">お問い合わせ先　　〒979-1306　福島県双葉郡大熊町大字大川原字南平 1717<text:line-break/>　　　　　　　　　大熊町役場　総務課　財政係　（TEL：0240-23-7582　FAX：0240-23-7845）</text:p>
    </office:text>
  </office:body>
</office:document>