<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:font-face-decls>
    <style:font-face style:name="Serif" style:font-family="serif"/>
  </office:font-face-decls>
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:text-properties fo:font-family="Serif" fo:font-size="10pt" style:font-family-asian="Serif" style:font-size-asian="10pt" style:language-asian="ja" style:country-asian="JP"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.3cm" fo:margin-bottom="1.1cm"/>
      <style:text-properties fo:font-size="19pt" style:font-size-asian="19pt"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-bottom="0.25cm"/>
    </style:style>
    <style:style style:name="To" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.05cm"/>
    </style:style>
    <style:style style:name="Lead" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.55cm" fo:margin-bottom="0.05cm"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.08cm" fo:margin-bottom="0.55cm"/>
      <style:text-properties fo:font-size="9pt" style:font-size-asian="9pt"/>
    </style:style>
    <style:style style:name="TableText" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:padding="0.03cm" style:vertical-align="middle"/>
      <style:text-properties fo:font-size="9pt" style:font-size-asian="9pt"/>
    </style:style>
    <style:style style:name="CenterText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin="0cm" fo:padding="0.03cm" style:vertical-align="middle"/>
      <style:text-properties fo:font-size="9pt" style:font-size-asian="9pt"/>
    </style:style>
    <style:style style:name="SmallText" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:padding="0.02cm" style:vertical-align="middle"/>
      <style:text-properties fo:font-size="8.5pt" style:font-size-asian="8.5pt"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0.15cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="1.7cm" fo:margin-bottom="1.7cm" fo:margin-left="1.9cm" fo:margin-right="1.9cm"/>
    </style:page-layout>
    <style:style style:name="Grid" style:family="table">
      <style:table-properties style:width="17.2cm" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="TallCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="SlashCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.04cm" style:vertical-align="middle" style:diagonal-tl-br="0.5pt solid #000000"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="1.95cm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="6.05cm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="2cm"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties style:column-width="7.2cm"/>
    </style:style>
    <style:style style:name="Prod1" style:family="table-column">
      <style:table-column-properties style:column-width="5cm"/>
    </style:style>
    <style:style style:name="Prod2" style:family="table-column">
      <style:table-column-properties style:column-width="3.5cm"/>
    </style:style>
    <style:style style:name="Prod3" style:family="table-column">
      <style:table-column-properties style:column-width="1.4cm"/>
    </style:style>
    <style:style style:name="Prod4" style:family="table-column">
      <style:table-column-properties style:column-width="3.9cm"/>
    </style:style>
    <style:style style:name="Prod5" style:family="table-column">
      <style:table-column-properties style:column-width="3.4cm"/>
    </style:style>
    <style:style style:name="DetailLeft" style:family="table-column">
      <style:table-column-properties style:column-width="4.3cm"/>
    </style:style>
    <style:style style:name="DetailRight" style:family="table-column">
      <style:table-column-properties style:column-width="12.9cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">令和　　年　ふるさと納税寄附申出書</text:p>
      <text:p text:style-name="Right">令和　　年　　月　　日</text:p>
      <text:p text:style-name="To">大　熊　町　長　あて</text:p>

      <table:table table:name="連絡先" table:style-name="Grid">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CenterText">ご　住　所</text:p>
          </table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="Cell">
            <text:p text:style-name="TableText">〒</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:number-rows-spanned="2" table:style-name="Cell">
            <text:p text:style-name="CenterText">（ふりがな</text:p>
            <text:p text:style-name="CenterText">お　名　前</text:p>
            <text:p text:style-name="CenterText">な）</text:p>
          </table:table-cell>
          <table:table-cell table:number-rows-spanned="2" table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CenterText">電話番号</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CenterText">mail</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>

      <text:p text:style-name="Lead">次のとおり寄附をしたいので申し出ます。</text:p>
      <table:table table:name="返礼品と寄附金額" table:style-name="Grid">
        <table:table-column table:style-name="Prod1"/>
        <table:table-column table:style-name="Prod2"/>
        <table:table-column table:style-name="Prod3"/>
        <table:table-column table:style-name="Prod4"/>
        <table:table-column table:style-name="Prod5"/>
        <table:table-row>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="CenterText">返礼品の有無</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="CenterText">寄　附　金　額</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="CenterText">申込</text:p><text:p text:style-name="CenterText">口数</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="CenterText">合　計　金　額</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="CenterText">配達希望</text:p><text:p text:style-name="CenterText">（※１）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="SmallText">□返礼品を希望しない</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">　　　　　　　　　円</text:p></table:table-cell>
          <table:table-cell table:style-name="SlashCell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">　　　　　　　　　円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="SmallText">□おおくまベリー２トレー</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">１口　10，000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">　口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">　　　　　　　　　円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">　月</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="SmallText">□おおくまベリー４トレー</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">１口　20，000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">　口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">　　　　　　　　　円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">　月</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="SmallText">□おおくまベリー６トレー</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">１口　25，000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">　口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">　　　　　　　　　円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">　月</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="SmallText">□飲む蒟蒻ゼリーセット</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">１口　10，000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">　口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">　　　　　　　　　円</text:p></table:table-cell>
          <table:table-cell table:style-name="SlashCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="SmallText">□セミドライフルーツセット</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">１口　15，000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">　口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">　　　　　　　　　円</text:p></table:table-cell>
          <table:table-cell table:style-name="SlashCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="SmallText">□ミニトマト　1kg</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">１口　15，000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">　口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">　　　　　　　　　円</text:p></table:table-cell>
          <table:table-cell table:style-name="SlashCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="SmallText">□日本酒（帰忘郷）１本</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">１口　15，000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">　口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">　　　　　　　　　円</text:p></table:table-cell>
          <table:table-cell table:style-name="SlashCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="SmallText">□日本酒（帰忘郷）２本</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">１口　25，000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">　口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">　　　　　　　　　円</text:p></table:table-cell>
          <table:table-cell table:style-name="SlashCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="SmallText">□甘酒（帰忘郷）８本セット</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">１口　15，000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">　口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">　　　　　　　　　円</text:p></table:table-cell>
          <table:table-cell table:style-name="SlashCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="SmallText">□ストロベリーシロップ280 g</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">１口　20，000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">　口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">　　　　　　　　　円</text:p></table:table-cell>
          <table:table-cell table:style-name="SlashCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:number-columns-spanned="3" table:style-name="HeaderCell"><text:p text:style-name="CenterText">寄　附　総　額</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">　　　　　　　　　円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>

      <text:p text:style-name="Note">（※1）配達希望につきましては、商品ごとに異なりますので、公式HPをご確認ください。</text:p>
      <text:p text:style-name="SmallText">「寄附金の使途の希望」、「寄附の方法」については該当する□欄を黒く（■）塗りつぶしてください。</text:p>
      <table:table table:name="寄附方法等" table:style-name="Grid">
        <table:table-column table:style-name="DetailLeft"/>
        <table:table-column table:style-name="DetailRight"/>
        <table:table-row>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="CenterText">寄附金の使途の希望</text:p></table:table-cell>
          <table:table-cell table:style-name="TallCell"><text:p text:style-name="TableText">　□　町に任せる</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="CenterText">寄附の方法</text:p></table:table-cell>
          <table:table-cell table:style-name="TallCell">
            <text:p text:style-name="TableText">　□　現金書留払い</text:p>
            <text:p text:style-name="TableText">　□　町役場へ直接持参</text:p>
            <text:p text:style-name="TableText">　□　口座振込（手数料は自己負担となります）</text:p>
            <text:p text:style-name="TableText">　□　郵便振替（手数料がかからない専用の払込票を送付いたします）</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="CenterText">ワンストップ特例</text:p><text:p text:style-name="CenterText">（利用する場合のみ）</text:p></table:table-cell>
          <table:table-cell table:style-name="TallCell">
            <text:p text:style-name="TableText">　□　利用する</text:p>
            <text:p text:style-name="TableText">　　利用するにチェックした方は、必ず下記もご記入ください。</text:p>
            <text:p text:style-name="TableText">　　　　　性　　別　　□　男性　　　□　女性</text:p>
            <text:p text:style-name="TableText">　　　　　生年月日（　昭和・平成　　　年　　　月　　　日　）</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="CenterText">備考</text:p></table:table-cell>
          <table:table-cell table:style-name="TallCell"/>
        </table:table-row>
      </table:table>

      <text:p text:style-name="PageStart">お問い合わせ先　　〒979-1306　福島県双葉郡大熊町大字大川原字南平1717</text:p>
      <text:p>　　　　　　　　　大熊町役場　総務課　財政係　（TEL：0240-23-7582　FAX：0240-23-7845）</text:p>
    </office:text>
  </office:body>
</office:document>