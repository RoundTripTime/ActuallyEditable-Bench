          <table:table-cell table:style-name="ApprovalCell"><text:p style:style-name="Center">※受理結果</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ApprovalCell" table:number-rows-spanned="3"><text:p/></table:table-cell>
