      <text:p text:style-name="Head">６　申請書提出者</text:p>
      <table:table table:name="Submitter" table:style-name="T">
        <table:table-column table:style-name="W6"/><table:table-column table:style-name="W1"/><table:table-column table:style-name="W2"/><table:table-column table:style-name="W8"/><table:table-column table:style-name="W4"/>
        <table:table-row><table:table-cell table:style-name="G" table:number-rows-spanned="4"><text:p text:style-name="Center">申</text:p><text:p text:style-name="Center">請</text:p><text:p text:style-name="Center">書</text:p><text:p text:style-name="Center">提</text:p><text:p text:style-name="Center">出</text:p><text:p text:style-name="Center">者</text:p></table:table-cell><table:table-cell table:style-name="C" table:number-columns-spanned="4"><text:p>□申請者本人</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
