          <table:table-cell table:style-name="Grid"><text:p text:style-name="Center">建物</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="4"><text:p text:style-name="Center">交換前</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="2"><text:p text:style-name="Center">交換後</text:p></table:table-cell><table:covered-table-cell/>
