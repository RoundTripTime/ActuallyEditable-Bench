      <style:page-layout-properties fo:page-width="29.7cm" fo:page-height="21cm" style:print-orientation="landscape" fo:margin-top="1.9cm" fo:margin-bottom="1.9cm" fo:margin-left="2.45cm" fo:margin-right="2.45cm"/>
