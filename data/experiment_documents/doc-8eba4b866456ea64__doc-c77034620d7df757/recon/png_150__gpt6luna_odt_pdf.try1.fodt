  <office:body>
    <office:text>
      <text:p text:style-name="Header">S0700000208</text:p>
      <table:table table:name="Page1" table:style-name="Table">
        <table:table-column table:style-name="Col" table:number-columns-repeated="10"/>
        <table:table-row>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="10"><text:p text:style-name="Center">土地</text:p><text:p text:style-name="Center">所有權交換移轉契約書</text:p><text:p text:style-name="Center">建築改良物</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Grid"><text:p>下列</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid"><text:p>土地</text:p><text:p>建物</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="8"><text:p>經所有權人雙方同意所有權交換移轉，特訂立本契約：</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
