        <table:table-row>
          <table:table-cell table:style-name="Grid"><text:p>(15)</text:p><text:p>申請登記以外之約定事項</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid"><text:p>1.他項權利情形及處理方法：</text:p><text:p/><text:p>2.交換權利差額及補償情形：</text:p><text:p/><text:p>3.</text:p><text:p/><text:p>4.</text:p><text:p/><text:p>5.</text:p></table:table-cell>
