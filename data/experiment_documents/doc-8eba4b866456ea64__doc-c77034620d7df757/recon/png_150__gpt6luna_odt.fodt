  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="Landscape"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="Body" fo:text-align="right">S0700000208</text:p>
      <text:p text:style-name="Title">土　地</text:p>
      <text:p text:style-name="Title">所有權交換移轉契約書</text:p>
      <text:p text:style-name="Title">建築改良物</text:p>
      <text:p text:style-name="Body">土地　　建物　　下列　　經所有權人雙方同意所有權交換移轉，特訂立本契約：</text:p>
      <table:table table:name="Page1" table:style-name="PageTable">
        <table:table-column table:style-name="Col" table:number-columns-repeated="8"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Center">土地</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Center">建物</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">交換前</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">交換後</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">交換前</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">交換後</text:p></table:table-cell><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">土地坐落</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">鄉鎮市區</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">段</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">小段</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（1）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（2）地號</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（3）面積</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（平方公尺）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">標示</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（4）所有權人姓名</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（5）權利範圍</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（6）權利價值</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">建號</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">鄉鎮市區</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">街路</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">段巷弄</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">號樓</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（7）建號</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（8）建物標牌</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（9）段、小段、地號</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（10）面積</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">層</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">層</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">共計</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（平方公尺）</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（11）用途</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">附屬建物面積</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（12）所有權人姓名</text:p></table:table-cell></table:table-row>
      </table:table>

      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="Body" fo:text-align="right">S0700000208</text:p>
      <table:table table:name="Page2" table:style-name="PageTable">
        <table:table-column table:style-name="Col" table:number-columns-repeated="8"/>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（4）所有權人姓名</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（5）權利範圍</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（6）權利價值</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">示</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（13）權利範圍</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（14）權利價值</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">層</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">層</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">共　計</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（平方）</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（11）用途</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">附屬建物</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">面積</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（平方公尺）</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（12）所有權人姓名</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（13）權利範圍</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（14）權利價值</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="Body" fo:text-align="right">S0700000208</text:p>
      <table:table table:name="Page3" table:style-name="PageTable">
        <table:table-column table:style-name="Col" table:number-columns-repeated="8"/>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（15）申請登記以外之約定事項</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p>1.他項權利情形及處理方法：</text:p><text:p/><text:p>2.交換權利差額及補償情形：</text:p><text:p/><text:p>3.</text:p><text:p/><text:p>4.</text:p><text:p/><text:p>5.</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（16）簽名或簽證</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="3"/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">訂</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（17）</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（18）</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（19）</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Center">（20）住所</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（21）</text:p></table:table-cell></table:table-row>
      </table:table>

      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="Body" fo:text-align="right">S0700000208</text:p>
      <table:table table:name="Page4" table:style-name="PageTable">
        <table:table-column table:style-name="Col" table:number-columns-repeated="8"/>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">立</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">姓名或名稱</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">出生年月日</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">統一編號</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">縣市</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">鄉鎮市區</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">村里鄰</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">街路段巷弄號樓　蓋章</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-rows-spanned="5"><text:p text:style-name="Center">契約人</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
