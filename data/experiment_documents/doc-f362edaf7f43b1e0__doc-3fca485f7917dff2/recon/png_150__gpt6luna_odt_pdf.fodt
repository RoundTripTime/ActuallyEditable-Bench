<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt" style:font-name="Noto Serif CJK KR"/>
    </style:default-style>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt" style:font-name="Noto Serif CJK KR"/>
    </style:style>
    <style:style style:name="PC" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="PL" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:text-align="start"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="PC">
      <style:text-properties fo:font-size="16pt" fo:font-weight="bold" style:font-name="Noto Sans CJK KR"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #999999" fo:padding="0.05cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HeadCell" style:family="table-cell" style:parent-style-name="Cell">
      <style:table-cell-properties fo:border="0.5pt solid #999999" fo:padding="0.05cm" style:vertical-align="middle" fo:background-color="#D4E6FA"/>
    </style:style>
    <style:style style:name="CenterCell" style:family="table-cell" style:parent-style-name="Cell">
      <style:table-cell-properties fo:border="0.5pt solid #999999" fo:padding="0.05cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="LeftCell" style:family="table-cell" style:parent-style-name="Cell">
      <style:table-cell-properties fo:border="0.5pt solid #999999" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="TitleCell" style:family="table-cell" style:parent-style-name="HeadCell">
      <style:table-cell-properties fo:border="0.5pt solid #999999" fo:padding="0.08cm" style:vertical-align="middle" fo:background-color="#D4E6FA"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
    </style:page-layout>
    <style:style style:name="Col1" style:family="table-column"><style:table-column-properties style:column-width="0.9cm"/></style:style>
    <style:style style:name="Col2" style:family="table-column"><style:table-column-properties style:column-width="2cm"/></style:style>
    <style:style style:name="ColN" style:family="table-column"><style:table-column-properties style:column-width="1.72cm"/></style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <table:table table:name="Form">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="ColN" table:number-columns-repeated="8"/>
        <table:table-row>
          <table:table-cell table:style-name="TitleCell" table:number-columns-spanned="10"><text:p text:style-name="Title">통계기반정책실질평가 요청서</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="PC">법 령 명</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="LeftCell" table:number-columns-spanned="8"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="PC">정 책 명</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="LeftCell" table:number-columns-spanned="8"><text:p text:style-name="PL">도입·변경되는 정책이 복수일 경우 각각 기재</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="PC">관련 법령</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="LeftCell" table:number-columns-spanned="8"><text:p text:style-name="PL">제·개정되는 정책과 관련된 타 법령 기재</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="PC">국정과제</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="LeftCell" table:number-columns-spanned="8"><text:p text:style-name="PL">제·개정되는 정책과 관련된 국정과제 명(번호) 기재</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2" table:number-rows-spanned="3"><text:p text:style-name="PC">구 분</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="PC">제 정</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="PC">개 정</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="PC">법률</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="PC">대통령령</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="PC">총리령</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="PC">부령</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="PC">법률</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="PC">대통령령</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="PC">총리령</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="PC">부령</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2" table:number-rows-spanned="4"><text:p text:style-name="PC">법령(정책)<text:line-break/>소관기관</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="8"><text:p text:style-name="PC">기관명</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2" table:number-rows-spanned="2"><text:p text:style-name="PC">총괄부서<text:line-break/>(검토부서)</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="PC">부서명</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="LeftCell" table:number-columns-spanned="3"/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="PC">담당자 직·성명</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="LeftCell" table:number-columns-spanned="3"/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2" table:number-rows-spanned="2"><text:p text:style-name="PC">사업부서<text:line-break/>(집행부서)</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="PC">부서명</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="LeftCell" table:number-columns-spanned="3"/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="PC">담당자 직·성명</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="LeftCell" table:number-columns-spanned="3"/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2" table:number-rows-spanned="2"><text:p text:style-name="PC">입법일정(예정)</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2"><text:p text:style-name="PC">관계기관</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="7"><text:p text:style-name="PC">20  .  .  .부터 20  .  .  .까지(  일간)</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="PC">입법예고기간</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="7"><text:p text:style-name="PC">20  .  .  .부터 20  .  .  .까지(  일간)</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2" table:number-rows-spanned="2"><text:p text:style-name="PC">첨부자료</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="PC">법령자료</text:p></table:table-cell>
          <table:table-cell table:style-name="LeftCell" table:number-columns-spanned="7"><text:p text:style-name="PL">법령안 전문 및 제·개정내용, 신·구조문 대비표, 법령안 설명자료</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="PC">정책자료</text:p></table:table-cell>
          <table:table-cell table:style-name="LeftCell" table:number-columns-spanned="7"><text:p text:style-name="PL">정책 관련 참고자료, 관련 통계(승인통계, 행정자료, 내부 보유자료 등)</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="PC">실질평가에 대한<text:line-break/>소관기관 의견</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="LeftCell" table:number-columns-spanned="8"><text:p text:style-name="PL">◦ 정책에 필요한 통계지표 구비, 통계개발·개선계획 필요성 여부를 기재</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="3"><text:p text:style-name="PC">정<text:line-break/>책<text:line-break/>1</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="1"><text:p text:style-name="PC">도입<text:line-break/>/변경되는<text:line-break/>정책의<text:line-break/>주요내용</text:p></table:table-cell>
          <table:table-cell table:style-name="LeftCell" table:number-columns-spanned="8"><text:p text:style-name="PL">▪ 정책명</text:p><text:p text:style-name="PL">▪ □□ □□ □□□</text:p><text:p text:style-name="PL">▪ 정책의 주요내용</text:p><text:p text:style-name="PL">  - 도입근거</text:p><text:p text:style-name="PL">  - 추진방향</text:p><text:p text:style-name="PL">  - 세부내용(현행/변경)</text:p><text:p text:style-name="PL">▪ 기대효과</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p text:style-name="PC">집행/평가<text:line-break/>단계별<text:line-break/>통계지표</text:p></table:table-cell>
          <table:table-cell table:style-name="LeftCell" table:number-columns-spanned="8"><text:p text:style-name="PL">▪ 통계지표</text:p><text:p text:style-name="PL">  - 지표구분(집행/평가 지표)</text:p><text:p text:style-name="PL">  - 유용성</text:p><text:p text:style-name="PL">  - 정보출처</text:p><text:p text:style-name="PL">  - 작성방식</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p text:style-name="PC">통계개발·<text:line-break/>개선계획</text:p></table:table-cell>
          <table:table-cell table:style-name="LeftCell" table:number-columns-spanned="8"><text:p text:style-name="PL">▪ 통계지표명</text:p><text:p text:style-name="PL">▪ 통계작성 및 자료수집방법: □ 조사  □ 보고  □ 가공</text:p><text:p text:style-name="PL">▪ 통계작성 목적</text:p><text:p text:style-name="PL">▪ 법적근거</text:p><text:p text:style-name="PL">▪ 통계작성 대상</text:p><text:p text:style-name="PL">▪ 통계작성 사항</text:p><text:p text:style-name="PL">▪ 통계작성 주기</text:p><text:p text:style-name="PL">▪ 통계작성 체계</text:p><text:p text:style-name="PL">▪ 추진일정(계획수립, 조사시기, 공표시기 등)</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="PC">2</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="PC">:</text:p></table:table-cell>
          <table:table-cell table:style-name="LeftCell" table:number-columns-spanned="8"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageBreak"/>
      <table:table table:name="Author">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="ColN" table:number-columns-repeated="8"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="1" table:number-rows-spanned="2"><text:p text:style-name="PC">작성자</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="PC">기관명</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="PC">부서명</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="PC">직위(직급)</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="PC">성 명</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="PC">전화번호</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="LeftCell" table:number-columns-spanned="2"/><table:covered-table-cell/>
          <table:table-cell table:style-name="LeftCell" table:number-columns-spanned="2"/><table:covered-table-cell/>
          <table:table-cell table:style-name="LeftCell" table:number-columns-spanned="2"/><table:covered-table-cell/>
          <table:table-cell table:style-name="LeftCell" table:number-columns-spanned="2"/><table:covered-table-cell/>
          <table:table-cell table:style-name="LeftCell"/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
