<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:default-style>
    <style:style style:name="FormCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #999999" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="FormColumn" style:family="table-column">
      <style:table-column-properties style:column-width="2.31cm"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="18.48cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="Centered" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="16pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="1.26cm" fo:margin-right="1.26cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <table:table table:name="Form" table:style-name="FormTable">
        <table:table-column table:style-name="FormColumn" table:number-columns-repeated="8"/>
        <table:table-row>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="8"><text:p text:style-name="Title">통계기반정책실질평가 요청서</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">법 령 명</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="7"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">정 책 명</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="7"><text:p>도입·변경되는 정책이 복수일 경우 각각 기재</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">관련 법령</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="7"><text:p>제·개정되는 정책과 관련된 타 법령 기재</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">국정과제</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="7"><text:p>제·개정되는 정책과 관련된 국정과제 명(번호) 기재</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell" table:number-rows-spanned="3"><text:p text:style-name="Centered">구 분</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="3"><text:p text:style-name="Centered">제 정</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="4"><text:p text:style-name="Centered">개 정</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">법률</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">대통령령</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">총리령</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">부령</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">법률</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">대통령령</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">총리령</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">부령</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell><table:table-cell table:style-name="FormCell"><text:p/></table:table-cell><table:table-cell table:style-name="FormCell"><text:p/></table:table-cell><table:table-cell table:style-name="FormCell"><text:p/></table:table-cell><table:table-cell table:style-name="FormCell"><text:p/></table:table-cell><table:table-cell table:style-name="FormCell"><text:p/></table:table-cell><table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell" table:number-rows-spanned="3"><text:p text:style-name="Centered">법령(정책) 소관기관</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">기관명</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="6"><text:p/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="FormCell" table:number-rows-spanned="2"><text:p text:style-name="Centered">총괄부서<br/>(검토부서)</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="2"><text:p text:style-name="Centered">부서명</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="4"><text:p/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="2"><text:p text:style-name="Centered">담당자 직·성명</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="4"><text:p/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell" table:number-rows-spanned="2"><text:p text:style-name="Centered">입법일정(예정)</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">관계기관</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="6"><text:p text:style-name="Centered">20 . . .부터 20 . . .까지( 일간)</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">입법예고기간</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="6"><text:p text:style-name="Centered">20 . . .부터 20 . . .까지( 일간)</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell" table:number-rows-spanned="2"><text:p text:style-name="Centered">첨부자료</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">법령자료</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="6"><text:p>법령안 전문 및 제·개정내용, 신·구조문 대비표, 법령안 설명자료</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">정책자료</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="6"><text:p>정책 관련 참고자료, 관련 통계(승인통계, 행정자료, 내부 보유자료 등)</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="2"><text:p text:style-name="Centered">실질평가에 대한<br/>소관기관 의견</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="6"><text:p>ㅇ 정책에 필요한 통계지표 구비, 통계개발·개선계획 필요성 여부를 기재</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell" table:number-rows-spanned="3"><text:p text:style-name="Centered">정책 1</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">도입<br/>/변경되는<br/>정책의<br/>주요내용</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="6"><text:p>▪ 정책명</text:p><text:p>▪ □□ □□ □□□</text:p><text:p>▪ 정책의 주요내용</text:p><text:p>- 도입근거</text:p><text:p>- 추진방향</text:p><text:p>- 세부내용(현행/변경)</text:p><text:p>▪ 기대효과</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">집행/평가<br/>단계별<br/>통계지표</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="6"><text:p>▪ 통계지표</text:p><text:p>- 지표구분(집행/평가 지표)</text:p><text:p>- 유용성</text:p><text:p>- 정보출처</text:p><text:p>- 작성방식</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">통계개발·<br/>개선계획</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="6"><text:p>▪ 통계지표명</text:p><text:p>▪ 통계작성 및 자료수집방법: □ 조사  □ 보고  □ 가공</text:p><text:p>▪ 통계작성 목적</text:p><text:p>▪ 법적근거</text:p><text:p>▪ 통계작성 대상</text:p><text:p>▪ 통계작성 사항</text:p><text:p>▪ 통계작성 주기</text:p><text:p>▪ 통계작성 체계</text:p><text:p>▪ 추진일정(계획수립, 조사시기, 공표시기 등)</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">2</text:p></table:cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">:</text:p></table:cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="6"><text:p/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageBreak"/>
      <table:table table:name="Author" table:style-name="FormTable">
        <table:table-column table:style-name="FormColumn" table:number-columns-repeated="6"/>
        <table:table-row>
          <table:table-cell table:style-name="FormCell" table:number-rows-spanned="2"><text:p text:style-name="Centered">작성자</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">기관명</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">부서명</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">직위(직급)</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">성 명</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">전화번호</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>