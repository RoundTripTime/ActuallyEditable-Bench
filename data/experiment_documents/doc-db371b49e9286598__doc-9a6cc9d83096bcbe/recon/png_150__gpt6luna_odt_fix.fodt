          <table:table-cell table:style-name="c2_GridCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="c2_GridCell"><text:p>研究分担者</text:p></table:table-cell>
          <table:table-cell table:style-name="c2_GridCell"/>
