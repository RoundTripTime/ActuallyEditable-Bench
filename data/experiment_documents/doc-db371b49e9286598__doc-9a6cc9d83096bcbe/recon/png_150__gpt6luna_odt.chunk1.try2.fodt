        <table:table-row><table:table-cell table:style-name="Cell" table:number-rows-spanned="3"><text:p>所属研究機関</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>（フリガナ）</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
