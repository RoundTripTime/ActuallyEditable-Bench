  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">様式Ａ（１）</text:p>
      <text:p text:style-name="BodyText">（元号）＿年度　厚生労働科学研究費<br/>厚生労働行政推進調査事業費補助金（　　　研究事業）研究計画書（新規申請用）</text:p>
      <text:p text:style-name="BodyText">（元号）＿年＿＿月＿＿日</text:p>
      <text:p text:style-name="BodyText">厚生労働大臣<br/>（国立医薬品食品衛生研究所長）　殿<br/>（国立保健医療科学院長）</text:p>
      <table:table table:name="ApplicationForm" table:style-name="Tbl">
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-rows-spanned="2"><text:p>研究課題名</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>（日本語表記）</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/><table:covered-table-cell/><table:table-row/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>（英語表記）</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>公募番号</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="3"/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>研究種目等</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p>□　基礎研究</text:p><text:p>□　応用研究</text:p><text:p>□　開発研究</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>当該年度の研究事業予定期間</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p>年　　　月　　　日　～　　年　　　月　　　日</text:p><text:p>（　　）年計画の１年目</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
