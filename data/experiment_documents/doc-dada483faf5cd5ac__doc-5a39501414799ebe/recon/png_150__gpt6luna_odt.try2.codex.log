        <table:table-row><table:table-cell table:style-name="Cell"><text:p>④のうち熱回収を行う量</text:p><text:p>⑤</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
