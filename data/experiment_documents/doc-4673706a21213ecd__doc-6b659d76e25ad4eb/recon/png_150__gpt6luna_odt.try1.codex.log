        </table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p>주소</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>등급</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>선임일</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>경력수첩　발급번호</text:p></table:table-cell><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell" table:number-rows-spanned="3"><text:p text:style-name="Centered">해임</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>성명</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p>생년월일</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
