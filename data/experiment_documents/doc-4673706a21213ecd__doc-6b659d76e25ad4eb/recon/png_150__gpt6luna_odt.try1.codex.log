          <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">건축물</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>연면적</text:p><text:p text:style-name="Centered">㎡</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>용도</text:p></table:table-cell><table:covered-table-cell/>
