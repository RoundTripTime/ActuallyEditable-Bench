<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles/>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="1.5cm" fo:margin-right="1.5cm" fo:margin-top="1.5cm" fo:margin-bottom="1.5cm" style:print-orientation="portrait"/>
    </style:page-layout>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0cm" fo:margin-right="0cm" fo:margin-top="1cm" fo:margin-bottom="0cm" fo:text-align="center" fo:line-height="100%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Applicant" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="10cm" fo:margin-top="0.5cm" fo:margin-bottom="0cm" fo:line-height="6mm"/>
    </style:style>
    <style:style style:name="Section1" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="2.14cm" fo:margin-top="0.7cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Section2" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="1.5cm" fo:margin-top="3.6cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Section2FirstSub" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="1.5cm" fo:margin-top="0.2cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Section2Sub" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="1.5cm" fo:margin-top="3.1cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="PageTwoStart" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="1.5cm" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:break-before="page"/>
    </style:style>
    <style:style style:name="Section3" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="1.5cm" fo:margin-top="2.7cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Section4" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="1.5cm" fo:margin-top="2.5cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="FinanceLead" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="1.5cm" fo:margin-top="0.15cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="FinanceTable" style:family="table">
      <style:table-properties style:width="13.8cm" table:align="left" fo:margin-left="0.37cm" fo:margin-top="0cm" fo:margin-bottom="0cm" table:border-model="separating"/>
    </style:style>
    <style:style style:name="FinanceCol1" style:family="table-column">
      <style:table-column-properties style:column-width="4cm"/>
    </style:style>
    <style:style style:name="FinanceCol2" style:family="table-column">
      <style:table-column-properties style:column-width="1.6cm"/>
    </style:style>
    <style:style style:name="FinanceCol3" style:family="table-column">
      <style:table-column-properties style:column-width="4cm"/>
    </style:style>
    <style:style style:name="FinanceCol4" style:family="table-column">
      <style:table-column-properties style:column-width="1.6cm"/>
    </style:style>
    <style:style style:name="FinanceCol5" style:family="table-column">
      <style:table-column-properties style:column-width="2.6cm"/>
    </style:style>
    <style:style style:name="BareCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="UnderlinedCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:border-bottom="0.6pt solid #000000" fo:padding="0cm" style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="DefaultPage" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">事　業　計　画　書（概要書）</text:p>
      <text:p text:style-name="Applicant">申請者（転用事業者）</text:p>
      <text:p text:style-name="Applicant">住所</text:p>
      <text:p text:style-name="Applicant">氏名</text:p>
      <text:p text:style-name="Section1">１．転用行為の利用目的・必要性</text:p>
      <text:p text:style-name="Section2">２．土地利用計画</text:p>
      <text:p text:style-name="Section2FirstSub">（面積の妥当性）</text:p>
      <text:p text:style-name="Section2Sub">（進入路）</text:p>
      <text:p text:style-name="Section2Sub">（取水・排水計画）</text:p>
      <text:p text:style-name="Section2Sub">（造成計画）</text:p>
      <text:p text:style-name="PageTwoStart">（周辺農地等への影響・防除策）</text:p>
      <text:p text:style-name="Section3">３．転用事業の実施予定時期</text:p>
      <text:p text:style-name="Section4">４．資金計画（概算）</text:p>
      <text:p text:style-name="FinanceLead">必要経費</text:p>
      <table:table table:name="FundingPlan" table:style-name="FinanceTable">
        <table:table-column table:style-name="FinanceCol1"/>
        <table:table-column table:style-name="FinanceCol2"/>
        <table:table-column table:style-name="FinanceCol3"/>
        <table:table-column table:style-name="FinanceCol4"/>
        <table:table-column table:style-name="FinanceCol5"/>
        <table:table-row>
          <table:table-cell table:style-name="BareCell"><text:p text:style-name="Body">建築工事費</text:p></table:table-cell>
          <table:table-cell table:style-name="BareCell"/>
          <table:table-cell table:style-name="BareCell"><text:p text:style-name="Body">円、その他経費</text:p></table:table-cell>
          <table:table-cell table:style-name="BareCell"/>
          <table:table-cell table:style-name="BareCell"><text:p text:style-name="Body">万円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BareCell"><text:p text:style-name="Body">計</text:p></table:table-cell>
          <table:table-cell table:style-name="UnderlinedCell"/>
          <table:table-cell table:style-name="BareCell"/>
          <table:table-cell table:style-name="BareCell"/>
          <table:table-cell table:style-name="BareCell"><text:p text:style-name="Body">万円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BareCell"><text:p text:style-name="Body">資金内容</text:p></table:table-cell>
          <table:table-cell table:style-name="BareCell"/>
          <table:table-cell table:style-name="BareCell"/>
          <table:table-cell table:style-name="BareCell"/>
          <table:table-cell table:style-name="BareCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BareCell"><text:p text:style-name="Body">自己資金</text:p></table:table-cell>
          <table:table-cell table:style-name="BareCell"/>
          <table:table-cell table:style-name="BareCell"/>
          <table:table-cell table:style-name="BareCell"/>
          <table:table-cell table:style-name="BareCell"><text:p text:style-name="Body">万円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BareCell"/>
          <table:table-cell table:style-name="BareCell"/>
          <table:table-cell table:style-name="BareCell"/>
          <table:table-cell table:style-name="BareCell"><text:p text:style-name="Body">計</text:p></table:table-cell>
          <table:table-cell table:style-name="UnderlinedCell"><text:p text:style-name="Body">万円</text:p></table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>