<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:font-size="12pt" fo:line-height="1.4"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.5cm" fo:margin-bottom="1.3cm"/>
      <style:text-properties fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="Applicant" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="9cm" fo:line-height="1.6"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="2.2cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="SectionGap" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="2.2cm" fo:margin-bottom="4.1cm"/>
    </style:style>
    <style:style style:name="LargeGap" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="2.2cm" fo:margin-bottom="5.1cm"/>
    </style:style>
    <style:style style:name="MediumGap" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="2.2cm" fo:margin-bottom="3.4cm"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0.8cm"/>
    </style:style>
    <style:style style:name="Subsection" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="2.4cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Budget" style:family="table">
      <style:table-properties style:width="14cm" table:align="left"/>
    </style:style>
    <style:style style:name="BudgetColumnA" style:family="table-column">
      <style:table-column-properties style:column-width="3.2cm"/>
    </style:style>
    <style:style style:name="BudgetColumnB" style:family="table-column">
      <style:table-column-properties style:column-width="3.2cm"/>
    </style:style>
    <style:style style:name="BudgetColumnC" style:family="table-column">
      <style:table-column-properties style:column-width="2.2cm"/>
    </style:style>
    <style:style style:name="BudgetColumnD" style:family="table-column">
      <style:table-column-properties style:column-width="3.2cm"/>
    </style:style>
    <style:style style:name="BudgetColumnE" style:family="table-column">
      <style:table-column-properties style:column-width="2.2cm"/>
    </style:style>
    <style:style style:name="BudgetCell" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:padding="0.08cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="BudgetUnderline" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:padding="0.08cm" fo:border-bottom="0.5pt solid #000000"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="2cm" fo:margin-right="2cm" style:print-orientation="portrait"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="Title">事　業　計　画　書（概要書）</text:p>
      <text:p text:style-name="Applicant">申請者（転用事業者）</text:p>
      <text:p text:style-name="Applicant">住所</text:p>
      <text:p text:style-name="Applicant">氏名</text:p>
      <text:p text:style-name="Section" fo:dummy=""/>
      <text:p text:style-name="Section">１．転用行為の利用目的・必要性</text:p>
      <text:p text:style-name="LargeGap"/>
      <text:p text:style-name="Section">２．土地利用計画</text:p>
      <text:p text:style-name="Subsection">（面積の妥当性）</text:p>
      <text:p text:style-name="LargeGap"/>
      <text:p text:style-name="Subsection">（進入路）</text:p>
      <text:p text:style-name="LargeGap"/>
      <text:p text:style-name="Subsection">（取水・排水計画）</text:p>
      <text:p text:style-name="LargeGap"/>
      <text:p text:style-name="Subsection">（造成計画）</text:p>
      <text:p text:style-name="LargeGap"/>
      <text:p text:style-name="PageStart">（周辺農地等への影響・防除策）</text:p>
      <text:p text:style-name="MediumGap"/>
      <text:p text:style-name="Section">３．転用事業の実施予定時期</text:p>
      <text:p text:style-name="MediumGap"/>
      <text:p text:style-name="Section">４．資金計画（概算）</text:p>
      <text:p text:style-name="Section">必要経費</text:p>
      <table:table table:name="資金計画" table:style-name="Budget">
        <table:table-columns>
          <table:table-column table:style-name="BudgetColumnA"/>
          <table:table-column table:style-name="BudgetColumnB"/>
          <table:table-column table:style-name="BudgetColumnC"/>
          <table:table-column table:style-name="BudgetColumnD"/>
          <table:table-column table:style-name="BudgetColumnE"/>
        </table:table-columns>
        <table:table-rows>
          <table:table-row>
            <table:table-cell table:number-columns-spanned="5" table:style-name="BudgetCell"><text:p>必要経費</text:p></table:table-cell>
            <table:covered-table-cell/>
            <table:covered-table-cell/>
            <table:covered-table-cell/>
            <table:covered-table-cell/>
          </table:table-row>
          <table:table-row>
            <table:table-cell table:style-name="BudgetCell"><text:p>建築工事費</text:p></table:table-cell>
            <table:table-cell table:style-name="BudgetCell"><text:p/></table:table-cell>
            <table:table-cell table:style-name="BudgetCell"><text:p>円、その他経費</text:p></table:table-cell>
            <table:table-cell table:style-name="BudgetCell"><text:p/></table:table-cell>
            <table:table-cell table:style-name="BudgetCell"><text:p>万円</text:p></table:table-cell>
          </table:table-row>
          <table:table-row>
            <table:table-cell table:style-name="BudgetCell"><text:p>計</text:p></table:table-cell>
            <table:table-cell table:style-name="BudgetUnderline"><text:p/></table:table-cell>
            <table:table-cell table:style-name="BudgetCell"><text:p>万円</text:p></table:table-cell>
            <table:table-cell table:style-name="BudgetCell"><text:p/></table:table-cell>
            <table:table-cell table:style-name="BudgetCell"><text:p/></table:table-cell>
          </table:table-row>
          <table:table-row>
            <table:table-cell table:number-columns-spanned="5" table:style-name="BudgetCell"><text:p>資金内容</text:p></table:table-cell>
            <table:covered-table-cell/>
            <table:covered-table-cell/>
            <table:covered-table-cell/>
            <table:covered-table-cell/>
          </table:table-row>
          <table:table-row>
            <table:table-cell table:style-name="BudgetCell"><text:p>自己資金</text:p></table:table-cell>
            <table:table-cell table:style-name="BudgetCell"><text:p/></table:table-cell>
            <table:table-cell table:style-name="BudgetCell"><text:p>万円</text:p></table:table-cell>
            <table:table-cell table:style-name="BudgetCell"><text:p/></table:table-cell>
            <table:table-cell table:style-name="BudgetCell"><text:p/></table:table-cell>
          </table:table-row>
          <table:table-row>
            <table:table-cell table:number-columns-spanned="3" table:style-name="BudgetCell"><text:p/></table:table-cell>
            <table:covered-table-cell/>
            <table:covered-table-cell/>
            <table:table-cell table:style-name="BudgetCell"><text:p>計</text:p></table:table-cell>
            <table:table-cell table:style-name="BudgetUnderline"><text:p/></table:table-cell>
            <table:table-cell table:style-name="BudgetCell"><text:p>万円</text:p></table:table-cell>
          </table:table-row>
        </table:table-rows>
      </table:table>
    </office:text>
  </office:body>
</office:document>