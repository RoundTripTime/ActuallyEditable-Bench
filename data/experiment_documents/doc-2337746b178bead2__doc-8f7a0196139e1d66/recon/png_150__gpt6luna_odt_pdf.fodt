<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:color="#000000"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.2cm" fo:margin-right="0cm" fo:margin-top="0.7cm" fo:margin-bottom="0.25cm" fo:padding-bottom="0.18cm" fo:border-bottom="0.6pt solid #4F81BD"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="26pt" fo:color="#17365D"/>
    </style:style>
    <style:style style:name="Intro" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.2cm" fo:margin-top="0.35cm" fo:margin-bottom="0.2cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="FormLabel" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.2cm" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:font-weight="bold" fo:color="#366092"/>
    </style:style>
    <style:style style:name="FormEntry" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0cm" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:color="#366092"/>
    </style:style>
    <style:style style:name="GridHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.2cm" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="9pt" fo:font-weight="bold" fo:color="#366092"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.2cm" fo:margin-top="0.2cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="FooterText" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.2cm" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="8pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="100%" table:align="margins" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="PaymentTable" style:family="table">
      <style:table-properties style:width="100%" table:align="margins" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="HalfColumn" style:family="table-column">
      <style:table-column-properties style:column-width="9.08cm"/>
    </style:style>
    <style:style style:name="PurposeColumn" style:family="table-column">
      <style:table-column-properties style:column-width="6.77cm"/>
    </style:style>
    <style:style style:name="MethodColumn" style:family="table-column">
      <style:table-column-properties style:column-width="3.21cm"/>
    </style:style>
    <style:style style:name="ReferenceColumn" style:family="table-column">
      <style:table-column-properties style:column-width="4.28cm"/>
    </style:style>
    <style:style style:name="ReceivedColumn" style:family="table-column">
      <style:table-column-properties style:column-width="3.57cm"/>
    </style:style>
    <style:style style:name="PlainCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.08cm 0.2cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="BandCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.08cm 0.2cm" fo:background-color="#D3DFEF" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="TopRuleCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.05cm 0.2cm" fo:border-top="0.8pt solid #4F81BD" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.05cm 0.2cm" fo:border-top="0.8pt solid #4F81BD" fo:border-bottom="0.8pt solid #4F81BD" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="DataBandCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.08cm 0.2cm" fo:background-color="#D3DFEF" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="SpacerCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0cm" fo:border="none" style:vertical-align="middle"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="1.41cm" fo:margin-right="1.41cm" fo:margin-top="1.41cm" fo:margin-bottom="1.41cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout">
      <style:footer>
        <text:p text:style-name="FooterText">OnlineBiller | Original English resource | Blank template</text:p>
      </style:footer>
    </style:master-page>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">Money Receipt — partial payment</text:p>
      <text:p text:style-name="Intro">BLANK TEMPLATE | Currency: INR</text:p>
      <table:table table:name="ReceiptDetails" table:style-name="FormTable">
        <table:table-column table:style-name="HalfColumn"/>
        <table:table-column table:style-name="HalfColumn"/>
        <table:table-row>
          <table:table-cell table:style-name="TopRuleCell"><text:p text:style-name="FormLabel">Recipient</text:p></table:table-cell>
          <table:table-cell table:style-name="TopRuleCell"><text:p text:style-name="FormEntry">________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BandCell"><text:p text:style-name="FormLabel">Received from</text:p></table:table-cell>
          <table:table-cell table:style-name="BandCell"><text:p text:style-name="FormEntry">________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="FormLabel">Receipt / date</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="FormEntry">________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BandCell"><text:p text:style-name="FormLabel">Underlying reference</text:p></table:table-cell>
          <table:table-cell table:style-name="BandCell"><text:p text:style-name="FormEntry">________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="FormLabel">Agreed total (context)</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="FormEntry">________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BandCell"><text:p text:style-name="FormLabel">Amount in words</text:p></table:table-cell>
          <table:table-cell table:style-name="BandCell"><text:p text:style-name="FormEntry">________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="FormLabel">Remaining balance (context)</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="FormEntry">________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BandCell"><text:p text:style-name="FormLabel">Acknowledged by</text:p></table:table-cell>
          <table:table-cell table:style-name="BandCell"><text:p text:style-name="FormEntry">________________________________</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p/>
      <table:table table:name="PaymentDetails" table:style-name="PaymentTable">
        <table:table-column table:style-name="PurposeColumn"/>
        <table:table-column table:style-name="MethodColumn"/>
        <table:table-column table:style-name="ReferenceColumn"/>
        <table:table-column table:style-name="ReceivedColumn"/>
        <table:table-row>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="GridHeading">Purpose</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="GridHeading">Method</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="GridHeading">Payment reference</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="GridHeading">Received (INR)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="DataBandCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="DataBandCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="DataBandCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="DataBandCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="SpacerCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="SpacerCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="SpacerCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="SpacerCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="DataBandCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="DataBandCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="DataBandCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="DataBandCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="SpacerCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="SpacerCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="SpacerCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="SpacerCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="DataBandCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="DataBandCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="DataBandCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="DataBandCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="SpacerCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="SpacerCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="SpacerCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="SpacerCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="DataBandCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="DataBandCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="DataBandCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="DataBandCell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Note">Ordinary incoming-payment acknowledgment. Verify receipt of funds independently.</text:p>
      <text:p text:style-name="Note">The agreed total and remaining balance are manual context, not an automated ledger.</text:p>
      <text:p text:style-name="Note">Word amounts are manual. Check line amounts and totals after every edit.</text:p>
    </office:text>
  </office:body>
</office:document>