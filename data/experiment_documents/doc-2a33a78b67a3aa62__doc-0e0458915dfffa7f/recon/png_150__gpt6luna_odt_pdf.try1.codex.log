        <table:table-row><table:table-cell table:style-name="Cell"><text:p>Would you like your information to be shared publicly on the government’s website or media outlets?</text:p></table:table-cell><table:table-cell table:style-name="CellCenter"><text:p>Yes ・ No</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>Would you like your information shared with relatives/roommates/friends who inquire about your safety?</text:p></table:table-cell><table:table-cell table:style-name="CellCenter"><text:p>Yes ・ No</text:p></table:table-cell></table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeaderCell"><text:p>Damage to Residence?</text:p><text:p>*Circle those that apply.</text:p></table:table-cell>
