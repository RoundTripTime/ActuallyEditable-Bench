<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="2.1cm" fo:margin-bottom="0.9cm" fo:break-before="page"/>
      <style:text-properties fo:font-size="18pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.55cm" fo:margin-bottom="0.9cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.75cm" fo:margin-top="0.1cm" fo:margin-bottom="0.6cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Closing" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="2.7cm" fo:margin-bottom="0.55cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="DateLine" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.2cm" fo:margin-bottom="0.65cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="ApplicantLine" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.2cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="2.8cm" fo:margin-right="2.8cm" fo:margin-top="1.5cm" fo:margin-bottom="1.5cm"/>
    </style:page-layout>
    <style:style style:name="TableColumn1" style:family="table-column">
      <style:table-column-properties style:column-width="3.5cm"/>
    </style:style>
    <style:style style:name="TableColumn2" style:family="table-column">
      <style:table-column-properties style:column-width="1.8cm"/>
    </style:style>
    <style:style style:name="TableColumn3" style:family="table-column">
      <style:table-column-properties style:column-width="2cm"/>
    </style:style>
    <style:style style:name="TableColumn4" style:family="table-column">
      <style:table-column-properties style:column-width="2.1cm"/>
    </style:style>
    <style:style style:name="TableColumn5" style:family="table-column">
      <style:table-column-properties style:column-width="3.1cm"/>
    </style:style>
    <style:style style:name="TableColumn6" style:family="table-column">
      <style:table-column-properties style:column-width="2.9cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="TableHeader" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="TableInput" style:family="paragraph">
      <style:paragraph-properties fo:line-height="0.65cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">営農計画書</text:p>
      <text:p text:style-name="Section">1　取得農地の利用計画</text:p>
      <text:p text:style-name="Section">2　現在所有（耕作）地の利用状況</text:p>
      <table:table table:name="LandUse">
        <table:table-column table:style-name="TableColumn1"/>
        <table:table-column table:style-name="TableColumn2"/>
        <table:table-column table:style-name="TableColumn3"/>
        <table:table-column table:style-name="TableColumn4"/>
        <table:table-column table:style-name="TableColumn5"/>
        <table:table-column table:style-name="TableColumn6"/>
        <table:table-row>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="TableHeader">農地の所在</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="TableHeader">地番</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="TableHeader">現況地目</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="TableHeader">面積（㎡）</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="TableHeader">栽培状況</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="TableHeader">権利設定</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableInput"/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Section">3　労務状況（耕作従事者・従事日数）</text:p>
      <text:p text:style-name="Section">4　耕作地への通勤距離・時間</text:p>
      <text:p text:style-name="Body">通勤距離：約　　ｋｍ、通勤時間：　　分</text:p>
      <text:p text:style-name="Section">5　兼務の場合の他業務との両立方法</text:p>
      <text:p text:style-name="Section">6　農業機械の整備状況</text:p>
      <text:p text:style-name="Closing">以上の営農計画に基づき農業経営を行います。</text:p>
      <text:p text:style-name="DateLine">令和　　年　　月　　日</text:p>
      <text:p text:style-name="ApplicantLine">申請者　氏名　　　　　　　　　　　　　　印</text:p>
    </office:text>
  </office:body>
</office:document>