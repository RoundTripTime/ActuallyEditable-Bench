<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:font-size="12pt" fo:line-height="150%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="1.35cm" fo:break-before="page" fo:line-height="150%"/>
      <style:text-properties fo:font-size="18pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.5cm" fo:margin-top="0cm" fo:margin-bottom="1.55cm" fo:line-height="150%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="SectionTight" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.5cm" fo:margin-top="0cm" fo:margin-bottom="0.35cm" fo:line-height="150%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Indented" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="1.25cm" fo:margin-top="0cm" fo:margin-bottom="1.45cm" fo:line-height="150%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="AfterTable" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.5cm" fo:margin-top="0.65cm" fo:margin-bottom="1.55cm" fo:line-height="150%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="FormLine" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="1.25cm" fo:margin-top="0cm" fo:margin-bottom="1.15cm" fo:line-height="150%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Signature" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="7.1cm" fo:margin-bottom="0.65cm" fo:line-height="150%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="SignatureLine" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0.65cm" fo:line-height="150%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="2.8cm" fo:margin-right="2.8cm"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties fo:width="15.4cm" fo:margin-left="0cm" fo:margin-right="0cm" style:may-break-between-rows="false"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="3.5cm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="1.8cm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="2cm"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties style:column-width="2.1cm"/>
    </style:style>
    <style:style style:name="Col5" style:family="table-column">
      <style:table-column-properties style:column-width="3cm"/>
    </style:style>
    <style:style style:name="Col6" style:family="table-column">
      <style:table-column-properties style:column-width="3cm"/>
    </style:style>
    <style:style style:name="HeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center" fo:line-height="130%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="BlankCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:line-height="130%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">営 農 計 画 書</text:p>
      <text:p text:style-name="Section">１　取得農地の利用計画</text:p>
      <text:p text:style-name="Section">２　現在所有（耕作）地の利用状況</text:p>
      <table:table table:name="LandUse" table:style-name="FormTable">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-column table:style-name="Col5"/>
        <table:table-column table:style-name="Col6"/>
        <table:table-row>
          <table:table-cell table:style-name="HeaderCell"><text:p>農地の所在</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p>地番</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p>現況地目</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p>面積(㎡）</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p>栽培状況</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p>権利設定</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BlankCell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="AfterTable">３　労務状況（耕作従事者・従事日数）</text:p>
      <text:p text:style-name="SectionTight">４　耕作地への通勤距離・時間</text:p>
      <text:p text:style-name="Indented">　　通勤距離：約　　ｋｍ、通勤時間：　　分</text:p>
      <text:p text:style-name="Section">５　兼務の場合の他業務との両立方法</text:p>
      <text:p text:style-name="Section">６　農業機械の整備状況</text:p>
      <text:p text:style-name="Signature">以上の営農計画に基づき農業経営を行います。</text:p>
      <text:p text:style-name="SignatureLine">令和　　年　　月　　日</text:p>
      <text:p text:style-name="SignatureLine">申請者　氏名　　　　　　　　　　　　印</text:p>
    </office:text>
  </office:body>
</office:document>