<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:color="#000000"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Heading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="20pt"/>
    </style:style>
    <style:style style:name="Break" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="1pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="8pt"/>
    </style:style>
    <style:style style:name="Label" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="ReminderText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.08cm" fo:margin-bottom="0.08cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:font-weight="bold"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="29.7cm" fo:page-height="21cm" style:print-orientation="landscape" fo:margin-top="1.5cm" fo:margin-bottom="1.3cm" fo:margin-left="1.7cm" fo:margin-right="1.7cm"/>
    </style:page-layout>
    <style:style style:name="NoBorderTable" style:family="table">
      <style:table-properties style:width="26.3cm" table:align="margins"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="26.3cm" table:align="margins"/>
    </style:style>
    <style:style style:name="NarrowTable" style:family="table">
      <style:table-properties style:width="26.3cm" table:align="margins"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="1cm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="4cm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="2.5cm"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties style:column-width="7.9cm"/>
    </style:style>
    <style:style style:name="Col5" style:family="table-column">
      <style:table-column-properties style:column-width="7.9cm"/>
    </style:style>
    <style:style style:name="Col6" style:family="table-column">
      <style:table-column-properties style:column-width="1.5cm"/>
    </style:style>
    <style:style style:name="Col7" style:family="table-column">
      <style:table-column-properties style:column-width="1.5cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.12cm" fo:border="0.02cm solid #777777" fo:vertical-align="middle"/>
    </style:style>
    <style:style style:name="LabelCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.12cm" fo:border="0.02cm solid #777777" fo:background-color="#F0F0F0" fo:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.1cm" fo:border="0.02cm solid #777777" fo:background-color="#F0F0F0" fo:vertical-align="middle"/>
    </style:style>
    <style:style style:name="PinkCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.1cm" fo:border="0.02cm solid #777777" fo:background-color="#F9DEDE" fo:vertical-align="middle"/>
    </style:style>
    <style:style style:name="ReminderCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.2cm" fo:border="0.08cm solid #B0002D" fo:vertical-align="middle"/>
    </style:style>
    <style:style style:name="DataRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="1.28cm"/>
    </style:style>
    <style:style style:name="SmallRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.65cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <table:table table:name="PageOneHeading" table:style-name="NoBorderTable">
        <table:table-column style:column-width="20cm"/>
        <table:table-column style:column-width="6.3cm"/>
        <table:table-row>
          <table:table-cell>
            <text:p style-name="Body">Prifysgol <text:span> BANGOR </text:span>University</text:p>
            <text:p style-name="Heading">RISK ASSESSMENT FORM</text:p>
          </table:table-cell>
          <table:table-cell>
            <text:p style-name="Right">PRIFYSGOL</text:p>
            <text:p style-name="Right">BANGOR</text:p>
            <text:p style-name="Right">UNIVERSITY</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>

      <table:table table:name="RiskAssessmentDetails" table:style-name="FormTable">
        <table:table-column style:column-width="5.2cm"/>
        <table:table-column style:column-width="9.9cm"/>
        <table:table-column style:column-width="3.3cm"/>
        <table:table-column style:column-width="2.7cm"/>
        <table:table-column style:column-width="3.1cm"/>
        <table:table-column style:column-width="2.1cm"/>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p style-name="Label">Risk Assessment (RA) Title</text:p>
            <text:p><text:span>Remember to complete Footer details</text:span></text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="LabelCell">
            <text:p style-name="Label">Date RA Created</text:p>
            <text:p style-name="Label">and/or Reviewed</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="LabelCell">
            <text:p style-name="Label">Version</text:p>
            <text:p style-name="Label">Number</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>

      <table:table table:name="SummaryOfActivity" table:style-name="FormTable">
        <table:table-column style:column-width="26.3cm"/>
        <table:table-row table:style-name="SmallRow">
          <table:table-cell table:style-name="HeaderCell">
            <text:p style-name="Label">Summary of Activity RA Covers</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>

      <table:table table:name="PeopleAndLocation" table:style-name="FormTable">
        <table:table-column style:column-width="5.2cm"/>
        <table:table-column style:column-width="8.2cm"/>
        <table:table-column style:column-width="4cm"/>
        <table:table-column style:column-width="8.9cm"/>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p style-name="Label">Location(s) RA Covers</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="LabelCell"><text:p style-name="Label">Person(s) RA Covers</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p style-name="Label">College / Service</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="LabelCell"><text:p style-name="Label">School / Section</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p style-name="Label">RA Assessor(s)</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="LabelCell"><text:p style-name="Label">Contact Details</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>

      <table:table table:name="ReviewDates" table:style-name="FormTable">
        <table:table-column style:column-width="5.2cm"/>
        <table:table-column style:column-width="8.2cm"/>
        <table:table-column style:column-width="4cm"/>
        <table:table-column style:column-width="8.9cm"/>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p style-name="Label">Actions to be Reviewed By</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="LabelCell"><text:p style-name="Label">Next RA Review Date</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>

      <table:table table:name="PageOneReminder" table:style-name="FormTable">
        <table:table-column style:column-width="26.3cm"/>
        <table:table-row>
          <table:table-cell table:style-name="ReminderCell">
            <text:p style-name="ReminderText">NOTE: Arrangements must be in place to communicate new and / or revised Risk Assessments to relevant persons.</text:p>
            <text:p style-name="ReminderText">Older versions must be removed from use (e.g. Folders, Website, My Bangor, Blackboard, Notice Boards) and filed for future reference/archive.</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>

      <table:table table:name="PageOneFooter" table:style-name="NoBorderTable">
        <table:table-column style:column-width="8.5cm"/>
        <table:table-column style:column-width="5.2cm"/>
        <table:table-column style:column-width="12.6cm"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell">
            <text:p>RA Title</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p>Version Number</text:p>
          </table:table-cell>
          <table:table-cell>
            <text:p style-name="Right">Page 1 of 2</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>

      <text:p style-name="Break"/>
      <table:table table:name="RiskAssessmentHazards" table:style-name="NarrowTable">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-column table:style-name="Col5"/>
        <table:table-column table:style-name="Col6"/>
        <table:table-column table:style-name="Col7"/>
        <table:table-row table:style-name="SmallRow">
          <table:table-cell table:style-name="HeaderCell"><text:p style-name="Center"><text:span>Ref</text:span></text:p><text:p style-name="Center"><text:span>No</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p style-name="Center">What are the</text:p><text:p style-name="Center">Hazards?</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p style-name="Center">Who/What</text:p><text:p style-name="Center">is at Risk?</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p style-name="Center">Existing</text:p><text:p style-name="Center">Controls</text:p></table:table-cell>
          <table:table-cell table:style-name="PinkCell"><text:p style-name="Center">Further</text:p><text:p style-name="Center">Controls</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p style-name="Center">Action</text:p><text:p style-name="Center">By</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p style-name="Center">Action</text:p><text:p style-name="Center">Complete</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="SmallRow">
          <table:table-cell table:number-columns-spanned="6" table:style-name="HeaderCell"/>
          <table:covered-table-cell table:style-name="HeaderCell"/>
          <table:table-cell table:style-name="HeaderCell"><text:p style-name="Center"><text:span>As Applicable</text:span></text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="Cell"><text:p style-name="Label">1.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p>•</text:p><text:p>•</text:p></table:table-cell>
          <table:table-cell table:style-name="PinkCell"><text:p>a.</text:p><text:p>b.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="Cell"><text:p style-name="Label">2.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p>•</text:p><text:p>•</text:p></table:table-cell>
          <table:table-cell table:style-name="PinkCell"><text:p>a.</text:p><text:p>b.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="Cell"><text:p style-name="Label">3.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p>•</text:p><text:p>•</text:p></table:table-cell>
          <table:table-cell table:style-name="PinkCell"><text:p>a.</text:p><text:p>b.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="Cell"><text:p style-name="Label">4.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p>•</text:p><text:p>•</text:p></table:table-cell>
          <table:table-cell table:style-name="PinkCell"><text:p>a.</text:p><text:p>b.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="Cell"><text:p style-name="Label">5.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p>•</text:p><text:p>•</text:p></table:table-cell>
          <table:table-cell table:style-name="PinkCell"><text:p>a.</text:p><text:p>b.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="Cell"><text:p style-name="Label">6.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p>•</text:p><text:p>•</text:p></table:table-cell>
          <table:table-cell table:style-name="PinkCell"><text:p>a.</text:p><text:p>b.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="Cell"><text:p style-name="Label">7.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p>•</text:p><text:p>•</text:p></table:table-cell>
          <table:table-cell table:style-name="PinkCell"><text:p>a.</text:p><text:p>b.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="Cell"><text:p style-name="Label">8.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p>•</text:p><text:p>•</text:p></table:table-cell>
          <table:table-cell table:style-name="PinkCell"><text:p>a.</text:p><text:p>b.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="Cell"><text:p style-name="Label">9.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p>•</text:p><text:p>•</text:p></table:table-cell>
          <table:table-cell table:style-name="PinkCell"><text:p>a.</text:p><text:p>b.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="Cell"><text:p style-name="Label">10.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p>•</text:p></table:table-cell>
          <table:table-cell table:style-name="PinkCell"><text:p>a.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>

      <table:table table:name="PageTwoReminder" table:style-name="FormTable">
        <table:table-column style:column-width="26.3cm"/>
        <table:table-row>
          <table:table-cell table:style-name="ReminderCell">
            <text:p style-name="ReminderText">REMEMBER: Arrangements must be in place to communicate new and / or revised Risk Assessments to relevant persons.</text:p>
            <text:p style-name="ReminderText">Older versions must be removed from use (e.g. Folders, Website, My Bangor, Blackboard, Notice Boards) and filed for future reference/archive.</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>

      <table:table table:name="PageTwoFooter" table:style-name="NoBorderTable">
        <table:table-column style:column-width="8.5cm"/>
        <table:table-column style:column-width="5.2cm"/>
        <table:table-column style:column-width="12.6cm"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>RA Title</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>Version Number</text:p></table:table-cell>
          <table:table-cell><text:p style-name="Right">Page 2 of 2</text:p></table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>