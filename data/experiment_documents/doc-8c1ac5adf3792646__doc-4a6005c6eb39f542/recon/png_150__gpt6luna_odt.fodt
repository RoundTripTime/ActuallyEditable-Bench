<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin="0in" fo:padding="0in"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:margin="0in" fo:text-align="center"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Bold" style:family="text">
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="RedText" style:family="text">
      <style:text-properties fo:color="#cc0000" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin="0in"/>
      <style:text-properties fo:font-size="1pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="LandscapePage">
      <style:page-layout-properties fo:page-width="11.69in" fo:page-height="8.27in" style:print-orientation="landscape" fo:margin="0.4in"/>
    </style:page-layout>
    <style:style style:name="TitleP" style:family="paragraph">
      <style:paragraph-properties fo:margin="0in 0in 0.18in 0in"/>
      <style:text-properties fo:font-size="22pt"/>
    </style:style>
    <style:style style:name="BrandP" style:family="paragraph">
      <style:paragraph-properties fo:margin="0in"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="SmallP" style:family="paragraph">
      <style:paragraph-properties fo:margin="0in"/>
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
    <style:style style:name="HeaderP" style:family="paragraph">
      <style:paragraph-properties fo:margin="0in" fo:text-align="center"/>
      <style:text-properties fo:font-size="10pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="CellP" style:family="paragraph">
      <style:paragraph-properties fo:margin="0in"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="paragraph">
      <style:paragraph-properties fo:margin="0in" fo:text-align="center"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="FooterP" style:family="paragraph">
      <style:paragraph-properties fo:margin="0in"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="T6" style:family="table">
      <style:table-properties style:width="100%" table:align="margins"/>
    </style:style>
    <style:style style:name="T4" style:family="table">
      <style:table-properties style:width="100%" table:align="margins"/>
    </style:style>
    <style:style style:name="T1" style:family="table">
      <style:table-properties style:width="100%" table:align="margins"/>
    </style:style>
    <style:style style:name="T7" style:family="table">
      <style:table-properties style:width="100%" table:align="margins"/>
    </style:style>
    <style:style style:name="ColTitle" style:family="table-column">
      <style:table-column-properties style:column-width="2.05in"/>
    </style:style>
    <style:style style:name="ColWide" style:family="table-column">
      <style:table-column-properties style:column-width="3.6in"/>
    </style:style>
    <style:style style:name="ColDate" style:family="table-column">
      <style:table-column-properties style:column-width="1.4in"/>
    </style:style>
    <style:style style:name="ColShort" style:family="table-column">
      <style:table-column-properties style:column-width="1.1in"/>
    </style:style>
    <style:style style:name="ColVer" style:family="table-column">
      <style:table-column-properties style:column-width="0.9in"/>
    </style:style>
    <style:style style:name="ColLast" style:family="table-column">
      <style:table-column-properties style:column-width="1.75in"/>
    </style:style>
    <style:style style:name="ColDetail1" style:family="table-column">
      <style:table-column-properties style:column-width="2.05in"/>
    </style:style>
    <style:style style:name="ColDetail2" style:family="table-column">
      <style:table-column-properties style:column-width="3.35in"/>
    </style:style>
    <style:style style:name="ColDetail3" style:family="table-column">
      <style:table-column-properties style:column-width="1.65in"/>
    </style:style>
    <style:style style:name="ColDetail4" style:family="table-column">
      <style:table-column-properties style:column-width="3.75in"/>
    </style:style>
    <style:style style:name="ColAction1" style:family="table-column">
      <style:table-column-properties style:column-width="2.05in"/>
    </style:style>
    <style:style style:name="ColAction2" style:family="table-column">
      <style:table-column-properties style:column-width="3in"/>
    </style:style>
    <style:style style:name="ColAction3" style:family="table-column">
      <style:table-column-properties style:column-width="1.65in"/>
    </style:style>
    <style:style style:name="ColAction4" style:family="table-column">
      <style:table-column-properties style:column-width="4.1in"/>
    </style:style>
    <style:style style:name="ColRef" style:family="table-column">
      <style:table-column-properties style:column-width="0.4in"/>
    </style:style>
    <style:style style:name="ColHaz" style:family="table-column">
      <style:table-column-properties style:column-width="1.5in"/>
    </style:style>
    <style:style style:name="ColRisk" style:family="table-column">
      <style:table-column-properties style:column-width="1in"/>
    </style:style>
    <style:style style:name="ColControls" style:family="table-column">
      <style:table-column-properties style:column-width="3.2in"/>
    </style:style>
    <style:style style:name="ColMore" style:family="table-column">
      <style:table-column-properties style:column-width="3.2in"/>
    </style:style>
    <style:style style:name="ColBy" style:family="table-column">
      <style:table-column-properties style:column-width="0.75in"/>
    </style:style>
    <style:style style:name="ColComplete" style:family="table-column">
      <style:table-column-properties style:column-width="0.75in"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.6pt solid #666666" fo:padding="0.07in" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Label" style:family="table-cell">
      <style:table-cell-properties fo:border="0.6pt solid #666666" fo:padding="0.07in" fo:background-color="#eeeeee" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="SummaryBlank" style:family="table-cell">
      <style:table-cell-properties fo:border="0.6pt solid #999999" fo:padding="0.07in" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="RedBox" style:family="table-cell">
      <style:table-cell-properties fo:border="3pt solid #b00028" fo:padding="0.1in" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="RiskHead" style:family="table-cell">
      <style:table-cell-properties fo:border="0.6pt solid #777777" fo:padding="0.06in" fo:background-color="#eeeeee" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="FurtherHead" style:family="table-cell">
      <style:table-cell-properties fo:border="0.6pt solid #777777" fo:padding="0.06in" fo:background-color="#f8dddd" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="ActionHead" style:family="table-cell">
      <style:table-cell-properties fo:border="0.6pt solid #777777" fo:padding="0.06in" fo:background-color="#eeeeee" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="RiskCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.6pt solid #777777" fo:padding="0.06in" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="FurtherCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.6pt solid #777777" fo:padding="0.06in" fo:background-color="#f8dddd" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="RiskRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.48in"/>
    </style:style>
    <style:style style:name="TallRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.84in"/>
    </style:style>
    <style:style style:name="ShortRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.35in"/>
    </style:style>
    <style:style style:name="SummaryRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.8in"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Master" style:page-layout-name="LandscapePage"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="BrandP">Prifysgol <text:span text:style-name="Bold">BANGOR</text:span> University</text:p>
      <text:p text:style-name="TitleP">RISK ASSESSMENT FORM</text:p>
      <table:table table:name="AssessmentDetails" table:style-name="T6">
        <table:table-column table:style-name="ColTitle"/>
        <table:table-column table:style-name="ColWide"/>
        <table:table-column table:style-name="ColDate"/>
        <table:table-column table:style-name="ColShort"/>
        <table:table-column table:style-name="ColVer"/>
        <table:table-column table:style-name="ColLast"/>
        <table:table-row table:style-name="ShortRow">
          <table:table-cell table:style-name="Label">
            <text:p text:style-name="CellP"><text:span text:style-name="Bold">Risk Assessment (RA) Title</text:span></text:p>
            <text:p text:style-name="SmallP"><text:span text:style-name="RedText">Remember to complete Footer details</text:span></text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Label">
            <text:p text:style-name="CellP"><text:span text:style-name="Bold">Date RA Created</text:span></text:p>
            <text:p text:style-name="CellP"><text:span text:style-name="Bold">and/or Reviewed</text:span></text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Label">
            <text:p text:style-name="CellP"><text:span text:style-name="Bold">Version</text:span></text:p>
            <text:p text:style-name="CellP"><text:span text:style-name="Bold">Number</text:span></text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="P"/>
      <table:table table:name="Summary" table:style-name="T1">
        <table:table-column table:style-name="ColLast"/>
        <table:table-row table:style-name="ShortRow">
          <table:table-cell table:style-name="Label">
            <text:p text:style-name="CellP"><text:span text:style-name="Bold">Summary of Activity RA Covers</text:span></text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="SummaryRow">
          <table:table-cell table:style-name="SummaryBlank"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="P"/>
      <table:table table:name="PeopleAndPlaces" table:style-name="T4">
        <table:table-column table:style-name="ColDetail1"/>
        <table:table-column table:style-name="ColDetail2"/>
        <table:table-column table:style-name="ColDetail3"/>
        <table:table-column table:style-name="ColDetail4"/>
        <table:table-row table:style-name="ShortRow">
          <table:table-cell table:style-name="Label"><text:p text:style-name="CellP"><text:span text:style-name="Bold">Location(s) RA Covers</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Label"><text:p text:style-name="CellP"><text:span text:style-name="Bold">Person(s) RA Covers</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="ShortRow">
          <table:table-cell table:style-name="Label"><text:p text:style-name="CellP"><text:span text:style-name="Bold">College / Service</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Label"><text:p text:style-name="CellP"><text:span text:style-name="Bold">School / Section</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="ShortRow">
          <table:table-cell table:style-name="Label"><text:p text:style-name="CellP"><text:span text:style-name="Bold">RA Assessor(s)</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Label"><text:p text:style-name="CellP"><text:span text:style-name="Bold">Contact Details</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="P"/>
      <table:table table:name="ReviewDates" table:style-name="T4">
        <table:table-column table:style-name="ColAction1"/>
        <table:table-column table:style-name="ColAction2"/>
        <table:table-column table:style-name="ColAction3"/>
        <table:table-column table:style-name="ColAction4"/>
        <table:table-row table:style-name="ShortRow">
          <table:table-cell table:style-name="Label"><text:p text:style-name="CellP"><text:span text:style-name="Bold">Actions to be Reviewed By</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Label"><text:p text:style-name="CellP"><text:span text:style-name="Bold">Next RA Review Date</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="P"/>
      <table:table table:name="Note" table:style-name="T1">
        <table:table-column table:style-name="ColLast"/>
        <table:table-row>
          <table:table-cell table:style-name="RedBox">
            <text:p text:style-name="HeaderP">NOTE: Arrangements must be in place to communicate new and / or revised Risk Assessments to relevant persons.</text:p>
            <text:p text:style-name="HeaderP">Older versions must be removed from use (e.g. Folders, Website, My Bangor, Blackboard, Notice Boards) and filed for future reference/archive.</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="P"/>
      <table:table table:name="FooterPage1" table:style-name="T4">
        <table:table-column table:style-name="ColAction1"/>
        <table:table-column table:style-name="ColAction2"/>
        <table:table-column table:style-name="ColAction3"/>
        <table:table-column table:style-name="ColAction4"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="FooterP">RA Title</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="FooterP">Version Number</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="FooterP">Page 1 of 2</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageBreak"/>
      <text:p text:style-name="BrandP"><text:span text:style-name="Bold">PRIFYSGOL BANGOR UNIVERSITY</text:span></text:p>
      <table:table table:name="RiskAssessment" table:style-name="T7">
        <table:table-column table:style-name="ColRef"/>
        <table:table-column table:style-name="ColHaz"/>
        <table:table-column table:style-name="ColRisk"/>
        <table:table-column table:style-name="ColControls"/>
        <table:table-column table:style-name="ColMore"/>
        <table:table-column table:style-name="ColBy"/>
        <table:table-column table:style-name="ColComplete"/>
        <table:table-row table:style-name="ShortRow">
          <table:table-cell table:style-name="RiskHead"><text:p text:style-name="HeaderP">Ref</text:p><text:p text:style-name="HeaderP">No</text:p></table:table-cell>
          <table:table-cell table:style-name="RiskHead"><text:p text:style-name="HeaderP">What are the</text:p><text:p text:style-name="HeaderP">Hazards?</text:p></table:table-cell>
          <table:table-cell table:style-name="RiskHead"><text:p text:style-name="HeaderP">Who/What</text:p><text:p text:style-name="HeaderP">is at Risk?</text:p></table:table-cell>
          <table:table-cell table:style-name="RiskHead"><text:p text:style-name="HeaderP">Existing</text:p><text:p text:style-name="HeaderP">Controls</text:p></table:table-cell>
          <table:table-cell table:style-name="FurtherHead"><text:p text:style-name="HeaderP">Further</text:p><text:p text:style-name="HeaderP">Controls</text:p></table:table-cell>
          <table:table-cell table:style-name="ActionHead"><text:p text:style-name="HeaderP">Action</text:p><text:p text:style-name="HeaderP">By</text:p></table:table-cell>
          <table:table-cell table:style-name="ActionHead"><text:p text:style-name="HeaderP">Action</text:p><text:p text:style-name="HeaderP">Complete</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ShortRow">
          <table:table-cell table:number-columns-spanned="5" table:style-name="RiskCell"/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="RiskCell"/>
          <table:table-cell table:style-name="ActionHead"><text:p text:style-name="HeaderP">As Applicable</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RiskRow">
          <table:table-cell table:style-name="RiskCell"><text:p text:style-name="CellP"><text:span text:style-name="Bold">1.</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="RiskCell"/>
          <table:table-cell table:style-name="RiskCell"/>
          <table:table-cell table:style-name="RiskCell"><text:p text:style-name="CellP">•</text:p><text:p text:style-name="CellP">•</text:p></table:table-cell>
          <table:table-cell table:style-name="FurtherCell"><text:p text:style-name="CellP">a.</text:p><text:p text:style-name="CellP">b.</text:p></table:table-cell>
          <table:table-cell table:style-name="RiskCell"/>
          <table:table-cell table:style-name="RiskCell"/>
        </table:table-row>
        <table:table-row table:style-name="RiskRow">
          <table:table-cell table:style-name="RiskCell"><text:p text:style-name="CellP"><text:span text:style-name="Bold">2.</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="RiskCell"/>
          <table:table-cell table:style-name="RiskCell"/>
          <table:table-cell table:style-name="RiskCell"><text:p text:style-name="CellP">•</text:p><text:p text:style-name="CellP">•</text:p></table:table-cell>
          <table:table-cell table:style-name="FurtherCell"><text:p text:style-name="CellP">a.</text:p><text:p text:style-name="CellP">b.</text:p></table:table-cell>
          <table:table-cell table:style-name="RiskCell"/>
          <table:table-cell table:style-name="RiskCell"/>
        </table:table-row>
        <table:table-row table:style-name="RiskRow">
          <table:table-cell table:style-name="RiskCell"><text:p text:style-name="CellP"><text:span text:style-name="Bold">3.</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="RiskCell"/>
          <table:table-cell table:style-name="RiskCell"/>
          <table:table-cell table:style-name="RiskCell"><text:p text:style-name="CellP">•</text:p><text:p text:style-name="CellP">•</text:p></table:table-cell>
          <table:table-cell table:style-name="FurtherCell"><text:p text:style-name="CellP">a.</text:p><text:p text:style-name="CellP">b.</text:p></table:table-cell>
          <table:table-cell table:style-name="RiskCell"/>
          <table:table-cell table:style-name="RiskCell"/>
        </table:table-row>
        <table:table-row table:style-name="RiskRow">
          <table:table-cell table:style-name="RiskCell"><text:p text:style-name="CellP"><text:span text:style-name="Bold">4.</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="RiskCell"/>
          <table:table-cell table:style-name="RiskCell"/>
          <table:table-cell table:style-name="RiskCell"><text:p text:style-name="CellP">•</text:p><text:p text:style-name="CellP">•</text:p></table:table-cell>
          <table:table-cell table:style-name="FurtherCell"><text:p text:style-name="CellP">a.</text:p><text:p text:style-name="CellP">b.</text:p></table:table-cell>
          <table:table-cell table:style-name="RiskCell"/>
          <table:table-cell table:style-name="RiskCell"/>
        </table:table-row>
        <table:table-row table:style-name="RiskRow">
          <table:table-cell table:style-name="RiskCell"><text:p text:style-name="CellP"><text:span text:style-name="Bold">5.</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="RiskCell"/>
          <table:table-cell table:style-name="RiskCell"/>
          <table:table-cell table:style-name="RiskCell"><text:p text:style-name="CellP">•</text:p><text:p text:style-name="CellP">•</text:p></table:table-cell>
          <table:table-cell table:style-name="FurtherCell"><text:p text:style-name="CellP">a.</text:p><text:p text:style-name="CellP">b.</text:p></table:table-cell>
          <table:table-cell table:style-name="RiskCell"/>
          <table:table-cell table:style-name="RiskCell"/>
        </table:table-row>
        <table:table-row table:style-name="RiskRow">
          <table:table-cell table:style-name="RiskCell"><text:p text:style-name="CellP"><text:span text:style-name="Bold">6.</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="RiskCell"/>
          <table:table-cell table:style-name="RiskCell"/>
          <table:table-cell table:style-name="RiskCell"><text:p text:style-name="CellP">•</text:p><text:p text:style-name="CellP">•</text:p></table:table-cell>
          <table:table-cell table:style-name="FurtherCell"><text:p text:style-name="CellP">a.</text:p><text:p text:style-name="CellP">b.</text:p></table:table-cell>
          <table:table-cell table:style-name="RiskCell"/>
          <table:table-cell table:style-name="RiskCell"/>
