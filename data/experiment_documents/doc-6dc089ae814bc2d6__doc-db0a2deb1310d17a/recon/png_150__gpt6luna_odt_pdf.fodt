<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="12pt" style:font-size-asian="12pt"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-bottom="0.35cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="14pt" style:font-size-asian="14pt" fo:font-weight="bold" style:font-weight-asian="bold"/>
    </style:style>
    <style:style style:name="SubTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-bottom="0.25cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="14pt" style:font-size-asian="14pt" fo:font-weight="bold" style:font-weight-asian="bold"/>
    </style:style>
    <style:style style:name="NameLine" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.2cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="12pt" style:font-size-asian="12pt"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:line-height="100%"/>
    </style:style>
    <style:style style:name="Footer" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.35cm" fo:line-height="150%"/>
      <style:text-properties fo:font-size="10pt" style:font-size-asian="10pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="1.2cm" fo:margin-bottom="1.2cm" fo:margin-left="1.75cm" fo:margin-right="1.75cm"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table"/>
    <style:style style:name="FormColumn" style:family="table-column">
      <style:table-column-properties style:column-width="4.375cm"/>
    </style:style>
    <style:style style:name="LongRow" style:family="table-row">
      <style:table-row-properties style:row-height="7.5cm"/>
    </style:style>
    <style:style style:name="TopRow" style:family="table-row">
      <style:table-row-properties style:row-height="2.2cm"/>
    </style:style>
    <style:style style:name="ContinuationRow" style:family="table-row">
      <style:table-row-properties style:row-height="5.1cm"/>
    </style:style>
    <style:style style:name="FormCell" style:family="table-cell">
      <style:table-cell-properties fo:border="1.2pt solid #000000" fo:padding="0.2cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="SplitTopCell" style:family="table-cell">
      <style:table-cell-properties fo:border-top="1.2pt solid #000000" fo:border-left="1.2pt solid #000000" fo:border-right="1.2pt solid #000000" fo:padding="0.2cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="SplitBottomCell" style:family="table-cell">
      <style:table-cell-properties fo:border-bottom="1.2pt solid #000000" fo:border-left="1.2pt solid #000000" fo:border-right="1.2pt solid #000000" fo:padding="0.2cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="Number" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="100%" fo:border-bottom="0.5pt solid #888888"/>
      <style:text-properties fo:font-size="13pt" style:font-size-asian="13pt" fo:font-weight="bold" style:font-weight-asian="bold"/>
    </style:style>
    <style:style style:name="Date" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="180%" fo:border-bottom="0.5pt solid #888888"/>
      <style:text-properties fo:font-size="12pt" style:font-size-asian="12pt"/>
    </style:style>
    <style:style style:name="Field" style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%" fo:margin-top="0.75cm"/>
      <style:text-properties fo:font-size="12pt" style:font-size-asian="12pt"/>
    </style:style>
    <style:style style:name="FieldWide" style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%" fo:margin-top="1.55cm"/>
      <style:text-properties fo:font-size="12pt" style:font-size-asian="12pt"/>
    </style:style>
    <style:style style:name="FieldClose" style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%" fo:margin-top="0.6cm"/>
      <style:text-properties fo:font-size="12pt" style:font-size-asian="12pt"/>
    </style:style>
    <style:style style:name="FooterCode" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.4cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt" style:font-size-asian="10pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">新北市政府辦理發展遲緩兒童療育補助（僅供健保課程使用）</text:p>
      <text:p text:style-name="SubTitle">療育紀錄單　____年____月（請務必核章療育單位、療育人員）</text:p>
      <text:p text:style-name="NameLine">兒童姓名：___________　　　　　　　　　　　　　（本紀錄單請自行影印使用）</text:p>
      <table:table table:name="療育紀錄單" table:style-name="FormTable">
        <table:table-column table:style-name="FormColumn" table:number-columns-repeated="4"/>
        <table:table-row table:style-name="LongRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Number">次數1</text:p><text:p text:style-name="Date">____年____月____日</text:p><text:p text:style-name="Field">療育單位：</text:p><text:p text:style-name="FieldWide">療育項目：</text:p><text:p text:style-name="FieldClose">療育人員</text:p><text:p text:style-name="FieldClose">核章處：</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Number">次數2</text:p><text:p text:style-name="Date">____年____月____日</text:p><text:p text:style-name="Field">療育單位：</text:p><text:p text:style-name="FieldWide">療育項目：</text:p><text:p text:style-name="FieldClose">療育人員</text:p><text:p text:style-name="FieldClose">核章處：</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Number">次數3</text:p><text:p text:style-name="Date">____年____月____日</text:p><text:p text:style-name="Field">療育單位：</text:p><text:p text:style-name="FieldWide">療育項目：</text:p><text:p text:style-name="FieldClose">療育人員</text:p><text:p text:style-name="FieldClose">核章處：處：</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Number">次數4</text:p><text:p text:style-name="Date">____年____月____日</text:p><text:p text:style-name="Field">療育單位：</text:p><text:p text:style-name="FieldWide">療育項目：</text:p><text:p text:style-name="FieldClose">療育人員</text:p><text:p text:style-name="FieldClose">核章處：</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="LongRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Number">次數5</text:p><text:p text:style-name="Date">____年____月____日</text:p><text:p text:style-name="Field">療育單位：</text:p><text:p text:style-name="FieldWide">療育項目：</text:p><text:p text:style-name="FieldClose">療育人員</text:p><text:p text:style-name="FieldClose">核章處：</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Number">次數6</text:p><text:p text:style-name="Date">____年____月____日</text:p><text:p text:style-name="Field">療育單位：</text:p><text:p text:style-name="FieldWide">療育項目：</text:p><text:p text:style-name="FieldClose">療育人員</text:p><text:p text:style-name="FieldClose">核章處：</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Number">次數7</text:p><text:p text:style-name="Date">____年____月____日</text:p><text:p text:style-name="Field">療育單位：</text:p><text:p text:style-name="FieldWide">療育項目：</text:p><text:p text:style-name="FieldClose">療育人員</text:p><text:p text:style-name="FieldClose">核章處：：</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Number">次數8</text:p><text:p text:style-name="Date">____年____月____日</text:p><text:p text:style-name="Field">療育單位：</text:p><text:p text:style-name="FieldWide">療育項目：</text:p><text:p text:style-name="FieldClose">療育人員</text:p><text:p text:style-name="FieldClose">核章處：：</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="LongRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Number">次數9</text:p><text:p text:style-name="Date">____年____月____日</text:p><text:p text:style-name="Field">療育單位：</text:p><text:p text:style-name="FieldWide">療育項目：</text:p><text:p text:style-name="FieldClose">療育人員</text:p><text:p text:style-name="FieldClose">核章處：</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Number">次數10</text:p><text:p text:style-name="Date">____年____月____日</text:p><text:p text:style-name="Field">療育單位：</text:p><text:p text:style-name="FieldWide">療育項目：</text:p><text:p text:style-name="FieldClose">療育人員</text:p><text:p text:style-name="FieldClose">核章處：</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Number">次數11</text:p><text:p text:style-name="Date">____年____月____日</text:p><text:p text:style-name="Field">療育單位：</text:p><text:p text:style-name="FieldWide">療育項目：</text:p><text:p text:style-name="FieldClose">療育人員</text:p><text:p text:style-name="FieldClose">核章處：</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Number">次數12</text:p><text:p text:style-name="Date">____年____月____日</text:p><text:p text:style-name="Field">療育單位：</text:p><text:p text:style-name="FieldWide">療育項目：</text:p><text:p text:style-name="FieldClose">療育人員</text:p><text:p text:style-name="FieldClose">核章處：</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="TopRow">
          <table:table-cell table:style-name="SplitTopCell"><text:p text:style-name="Number">次數13</text:p><text:p text:style-name="Date">____年____月____日</text:p></table:table-cell>
          <table:table-cell table:style-name="SplitTopCell"><text:p text:style-name="Number">次數14</text:p><text:p text:style-name="Date">____年____月____日</text:p></table:table-cell>
          <table:table-cell table:style-name="SplitTopCell"><text:p text:style-name="Number">次數15</text:p><text:p text:style-name="Date">____年____月____日</text:p></table:table-cell>
          <table:table-cell table:style-name="SplitTopCell"><text:p text:style-name="Number">次數16</text:p><text:p text:style-name="Date">____年____月____日</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageBreak"/>
      <table:table table:name="紀錄續頁" table:style-name="FormTable">
        <table:table-column table:style-name="FormColumn" table:number-columns-repeated="4"/>
        <table:table-row table:style-name="ContinuationRow">
          <table:table-cell table:style-name="SplitBottomCell"><text:p text:style-name="Field">療育單位：</text:p><text:p text:style-name="FieldWide">療育項目：</text:p><text:p text:style-name="FieldClose">療育人員</text:p><text:p text:style-name="FieldClose">核章處：</text:p></table:table-cell>
          <table:table-cell table:style-name="SplitBottomCell"><text:p text:style-name="Field">療育單位：</text:p><text:p text:style-name="FieldWide">療育項目：</text:p><text:p text:style-name="FieldClose">療育人員</text:p><text:p text:style-name="FieldClose">核章處：</text:p></table:table-cell>
          <table:table-cell table:style-name="SplitBottomCell"><text:p text:style-name="Field">療育單位：</text:p><text:p text:style-name="FieldWide">療育項目：</text:p><text:p text:style-name="FieldClose">療育人員</text:p><text:p text:style-name="FieldClose">核章處：</text:p></table:table-cell>
          <table:table-cell table:style-name="SplitBottomCell"><text:p text:style-name="Field">療育單位：</text:p><text:p text:style-name="FieldWide">療育項目：</text:p><text:p text:style-name="FieldClose">療育人員</text:p><text:p text:style-name="FieldClose">核章處：</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="LongRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Number">次數17</text:p><text:p text:style-name="Date">____年____月____日</text:p><text:p text:style-name="Field">療育單位：</text:p><text:p text:style-name="FieldWide">療育項目：</text:p><text:p text:style-name="FieldClose">療育人員</text:p><text:p text:style-name="FieldClose">核章處：</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Number">次數18</text:p><text:p text:style-name="Date">____年____月____日</text:p><text:p text:style-name="Field">療育單位：</text:p><text:p text:style-name="FieldWide">療育項目：</text:p><text:p text:style-name="FieldClose">療育人員</text:p><text:p text:style-name="FieldClose">核章處：</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Number">次數19</text:p><text:p text:style-name="Date">____年____月____日</text:p><text:p text:style-name="Field">療育單位：</text:p><text:p text:style-name="FieldWide">療育項目：</text:p><text:p text:style-name="FieldClose">療育人員</text:p><text:p text:style-name="FieldClose">核章處：</text:p></table:table-cell>
