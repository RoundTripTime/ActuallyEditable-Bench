<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.3cm" fo:margin-bottom="1.3cm" fo:margin-left="3cm" fo:margin-right="3cm" style:print-orientation="portrait"/>
    </style:page-layout>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Narrow" style:family="table-column">
      <style:table-column-properties style:column-width="0.75cm"/>
    </style:style>
    <style:style style:name="Middle" style:family="table-column">
      <style:table-column-properties style:column-width="6.8cm"/>
    </style:style>
    <style:style style:name="Wide" style:family="table-column">
      <style:table-column-properties style:column-width="5.2cm"/>
    </style:style>
    <style:style style:name="ExpenseNarrow" style:family="table-column">
      <style:table-column-properties style:column-width="0.75cm"/>
    </style:style>
    <style:style style:name="ExpenseLabel" style:family="table-column">
      <style:table-column-properties style:column-width="6.8cm"/>
    </style:style>
    <style:style style:name="ExpenseAmount" style:family="table-column">
      <style:table-column-properties style:column-width="5.2cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Body">別記様式第１号</text:p>
      <text:p text:style-name="Right">年　　　　月　　　　日</text:p>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Body">中標津町長　様</text:p>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Right">住　　所</text:p>
      <text:p text:style-name="Right">氏　　名　　　　　　　　　　　　　印</text:p>
      <text:p text:style-name="Right">生年月日　　　　年　　　月　　　日生</text:p>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Title">中標津町狩猟免許新規取得等補助金交付申請書</text:p>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Body">　　　中標津町狩猟免許新規取得等補助金交付要綱に基づき、下記の金額の補助金を交付され</text:p>
      <text:p text:style-name="Body">るよう同要綱第５条の規定により申請します。</text:p>
      <text:p text:style-name="Center">記</text:p>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Body">１　補助金申請額　　　　　　　　　　　　　　　円</text:p>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Body">２　補助対象経費</text:p>
      <table:table>
        <table:table-column table:style-name="Narrow"/>
        <table:table-column table:style-name="Middle"/>
        <table:table-column table:style-name="Wide"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">所</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">１）　　　　第一種銃猟免許取得</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageBreak"/>
      <table:table>
        <table:table-column table:style-name="ExpenseNarrow"/>
        <table:table-column table:style-name="ExpenseLabel"/>
        <table:table-column table:style-name="ExpenseAmount"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="3"><text:p text:style-name="Center">要</text:p><text:p text:style-name="Center">経</text:p><text:p text:style-name="Center">費</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">費</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">２）　　　　銃砲刀剣類所持許可</text:p><text:p text:style-name="Center">取得費</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">合　　計</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Body">３　添付書類</text:p>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Body">　　（１）　住民票</text:p>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Body">　　（２）　町税に滞納が無いことを証するもの</text:p>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Body">　　（３）　取得した第一種狩猟免状及び銃砲所持許可証の写し</text:p>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Body">　　（４）　経費に要した領収書の写し</text:p>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Body">　　（５）　猟友会に入会したことを証する書面</text:p>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Body">　　（６）　誓約書（別記様式第２号）</text:p>
    </office:text>
  </office:body>
</office:document>