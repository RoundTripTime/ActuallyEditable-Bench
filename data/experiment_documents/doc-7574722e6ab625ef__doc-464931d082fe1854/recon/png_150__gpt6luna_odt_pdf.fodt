<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:line-height="150%"/>
      <style:text-properties fo:font-family="Noto Serif CJK JP" fo:font-size="11pt"/>
    </style:default-style>
    <style:style style:name="P" style:family="paragraph"/>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="1.2cm" fo:margin-bottom="1.4cm"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="1.1cm" fo:margin-bottom="0.5cm"/>
    </style:style>
    <style:style style:name="BodyText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.4cm" fo:margin-bottom="0.4cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000"/>
    </style:style>
    <style:style style:name="NarrowColumn" style:family="table-column">
      <style:table-column-properties style:column-width="0.75cm"/>
    </style:style>
    <style:style style:name="WideColumn" style:family="table-column">
      <style:table-column-properties style:column-width="6.75cm"/>
    </style:style>
    <style:style style:name="AmountColumn" style:family="table-column">
      <style:table-column-properties style:column-width="5.25cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.85cm" fo:margin-bottom="1.85cm" fo:margin-left="3cm" fo:margin-right="5.25cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p style:style-name="P">別記様式第１号</text:p>
      <text:p style:style-name="Right">年　　月　　日</text:p>
      <text:p style:style-name="P" fo:margin-top="2.2cm">中標津町長　様</text:p>
      <text:p style:style-name="Right" fo:margin-top="1.4cm">住所</text:p>
      <text:p style:style-name="Right">氏　　名　　　　㊞</text:p>
      <text:p style:style-name="Right">生年月日　　　年　　月　　日生</text:p>
      <text:p style:style-name="Title">中標津町狩猟免許新規取得等補助金交付申請書</text:p>
      <text:p style:style-name="BodyText">中標津町狩猟免許新規取得等補助金交付要綱に基づき、下記の金額の補助金を交付され<text:line-break/>るよう同要綱第５条の規定により申請します。</text:p>
      <text:p style:style-name="Center" fo:margin-top="1.2cm" fo:margin-bottom="1.8cm">記</text:p>
      <text:p style:style-name="Section">１　補助金申請額　　　　　　　　　　　　　　　　円</text:p>
      <text:p style:style-name="Section">２　補助対象経費</text:p>
      <table:table table:name="ExpensesPage1">
        <table:table-column table:style-name="NarrowColumn"/>
        <table:table-column table:style-name="WideColumn"/>
        <table:table-column table:style-name="AmountColumn"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>所</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>１）　　　　第一種銃猟免許取得</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p style:style-name="Right">円</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <table:table table:name="ExpensesPage2">
        <table:table-column table:style-name="NarrowColumn"/>
        <table:table-column table:style-name="WideColumn"/>
        <table:table-column table:style-name="AmountColumn"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="3"><text:p>要</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p style:style-name="PageStart">費</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>２）　　　　銃砲刀剣類所持許可取得費</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p style:style-name="Right">円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p style:style-name="Center">合　　計</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p style:style-name="Right">円</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p style:style-name="Section">３　添付書類</text:p>
      <text:p style:style-name="BodyText">（１）　住民票</text:p>
      <text:p style:style-name="BodyText">（２）　町税に滞納が無いことを証するもの</text:p>
      <text:p style:style-name="BodyText">（３）　取得した第一種狩猟免状及び銃砲所持許可証の写し</text:p>
      <text:p style:style-name="BodyText">（４）　経費に要した領収書の写し</text:p>
      <text:p style:style-name="BodyText">（５）　猟友会に入会したことを証する書面</text:p>
      <text:p style:style-name="BodyText">（６）　誓約書（別記様式第２号）</text:p>
    </office:text>
  </office:body>
</office:document>