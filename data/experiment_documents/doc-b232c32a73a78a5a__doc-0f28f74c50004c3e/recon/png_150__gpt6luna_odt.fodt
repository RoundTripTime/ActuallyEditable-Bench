<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:font-size="12pt" fo:line-height="150%" fo:margin-top="0cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0.12cm"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="2.1cm" fo:margin-bottom="2.1cm"/>
      <style:text-properties fo:font-size="14pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="2.5cm" fo:margin-bottom="2.5cm" fo:margin-left="2.5cm" fo:margin-right="2.5cm"/>
    </style:page-layout>
    <style:style style:name="Tbl" style:family="table">
      <style:table-properties style:width="16cm" table:align="margins" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ColLabel" style:family="table-column">
      <style:table-column-properties style:column-width="3.1cm"/>
    </style:style>
    <style:style style:name="ColInput" style:family="table-column">
      <style:table-column-properties style:column-width="12.9cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.15cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="BodyCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.18cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellP" style:family="paragraph">
      <style:paragraph-properties fo:line-height="130%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Notes" style:family="paragraph">
      <style:paragraph-properties fo:line-height="150%" fo:margin-top="0.25cm" fo:margin-bottom="0.3cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Master" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="P">様式第１号（第３条関係）</text:p>
      <text:p text:style-name="Title">鳥羽市鳥獣害対策事業補助金交付申請書</text:p>
      <text:p text:style-name="P"><text:s text:c="23"/>令和<text:s text:c="6"/>年<text:s text:c="6"/>月<text:s text:c="6"/>日</text:p>
      <text:p text:style-name="P">鳥羽市長　小竹　篤　様</text:p>
      <text:p text:style-name="P"><text:s text:c="20"/>申請者　住所：</text:p>
      <text:p text:style-name="P"><text:s text:c="31"/>氏　名　：<text:s text:c="23"/>＿＿＿＿＿＿＿＿</text:p>
      <text:p text:style-name="P">印</text:p>
      <text:p text:style-name="P"><text:s text:c="38"/>（本人自署の場合は、押印は不要で</text:p>
      <text:p text:style-name="P">す）</text:p>
      <text:p text:style-name="P"><text:s text:c="31"/>電話　：</text:p>
      <text:p text:style-name="P"><text:s text:c="2"/>鳥羽市鳥獣害対策事業補助金交付要綱第６条の規定により、次のとおり申請しま</text:p>
      <text:p text:style-name="P">す。</text:p>
      <table:table table:name="LocationPart1" table:style-name="Tbl">
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColInput"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellP">設置場所</text:p>
            <text:p text:style-name="CellP">（町字名地</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="BodyCell">
            <text:p text:style-name="CellP">鳥羽市<text:s text:c="12"/>町字<text:s text:c="12"/>番地内</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageBreak"/>
      <table:table table:name="ApplicationDetails" table:style-name="Tbl">
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColInput"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">番）</text:p></table:table-cell>
          <table:table-cell table:style-name="BodyCell"><text:p text:style-name="CellP"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">事業の目的</text:p></table:table-cell>
          <table:table-cell table:style-name="BodyCell"><text:p text:style-name="CellP"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">総事業費</text:p></table:table-cell>
          <table:table-cell table:style-name="BodyCell"><text:p text:style-name="CellP"><text:s text:c="82"/>円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellP">補助金交付</text:p>
            <text:p text:style-name="CellP"><text:s text:c="2"/>申請額</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="BodyCell"><text:p text:style-name="CellP"><text:s text:c="82"/>円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">添付資料</text:p></table:table-cell>
          <table:table-cell table:style-name="BodyCell">
            <text:p text:style-name="CellP">1.　　事業を実施しようとする位置図</text:p>
            <text:p text:style-name="CellP"><text:s text:c="8"/>（縮尺 1/3,000 以上の位置図）</text:p>
            <text:p text:style-name="CellP">2.　　収支予算書</text:p>
            <text:p text:style-name="CellP">3.　　防護柵用資材費の見積書（購入業者等からの）</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">備考</text:p></table:table-cell>
          <table:table-cell table:style-name="BodyCell"><text:p text:style-name="CellP"/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Notes">※氏名が自署でない場合は、記名押印をお願いします。</text:p>
      <text:p text:style-name="Notes">※補助金の対象となる経費は、防護柵用資材の購入に係る経費とし、設置に係る工事費等は含まないものとする。</text:p>
      <text:p text:style-name="Notes">※補助金の額は50,000 円を上限とし、防護柵用資材の購入額の２分の１を乗じた額とする。</text:p>
    </office:text>
  </office:body>
</office:document>