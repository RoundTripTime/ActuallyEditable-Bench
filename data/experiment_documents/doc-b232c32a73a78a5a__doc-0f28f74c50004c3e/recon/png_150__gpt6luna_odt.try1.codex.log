            <text:p text:style-name="CellP">（町字名地</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="BodyCell">
            <text:p text:style-name="CellP">鳥羽市<text:s text:c="12"/>町字<text:s text:c="12"/>番地内</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageBreak"/>
      <table:table table:name="ApplicationDetails" table:style-name="Tbl">
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColInput"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">番）</text:p></table:table-cell>
