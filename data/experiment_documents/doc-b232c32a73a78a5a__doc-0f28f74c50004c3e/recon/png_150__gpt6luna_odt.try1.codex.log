    <office:text>
      <text:p text:style-name="P">様式第１号（第３条関係）</text:p>
      <text:p text:style-name="Title">鳥羽市鳥獣害対策事業補助金交付申請書</text:p>
      <text:p text:style-name="P"><text:s text:c="23"/>令和<text:s text:c="6"/>年<text:s text:c="6"/>月<text:s text:c="6"/>日</text:p>
      <text:p text:style-name="P">鳥羽市長　小竹　篤　様</text:p>
      <text:p text:style-name="P"><text:s text:c="20"/>申請者　住所：</text:p>
      <text:p text:style-name="P"><text:s text:c="31"/>氏　名　：<text:s text:c="23"/>＿＿＿＿＿＿＿＿</text:p>
      <text:p text:style-name="P">印</text:p>
      <text:p text:style-name="P"><text:s text:c="38"/>（本人自署の場合は、押印は不要で</text:p>
      <text:p text:style-name="P">す）</text:p>
      <text:p text:style-name="P"><text:s text:c="31"/>電話　：</text:p>
      <text:p text:style-name="P"><text:s text:c="2"/>鳥羽市鳥獣害対策事業補助金交付要綱第６条の規定により、次のとおり申請しま</text:p>
      <text:p text:style-name="P">す。</text:p>
      <table:table table:name="LocationPart1" table:style-name="Tbl">
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColInput"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell">
