<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
                 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
                 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
                 xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
                 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
                 office:mimetype="application/vnd.oasis.opendocument.text"
                 office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:orphans="2" fo:widows="2"/>
      <style:text-properties style:font-name="MS Mincho" fo:font-size="12pt" style:font-name-asian="MS Mincho" style:font-size-asian="12pt"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties style:font-name="MS Mincho" fo:font-size="12pt" style:font-name-asian="MS Mincho" style:font-size-asian="12pt"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph" style:parent-style-name="Body">
      <style:text-properties fo:font-size="9pt" style:font-size-asian="9pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="right"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
  </office:styles>

  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm"
                                   fo:margin-top="2.5cm" fo:margin-bottom="2.5cm"
                                   fo:margin-left="2.5cm" fo:margin-right="2.5cm"/>
    </style:page-layout>

    <style:style style:name="ApplicantTable" style:family="table">
      <style:table-properties style:width="16cm" table:align="left" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="LeftColumn" style:family="table-column">
      <style:table-column-properties style:column-width="3.1cm"/>
    </style:style>
    <style:style style:name="RightColumn" style:family="table-column">
      <style:table-column-properties style:column-width="12.9cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.15cm" fo:vertical-align="middle"/>
    </style:style>
    <style:style style:name="LabelCell" style:family="table-cell" style:parent-style-name="Cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.15cm" fo:vertical-align="middle"/>
    </style:style>
    <style:style style:name="TablePara" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:margin-top="0.15cm" fo:margin-bottom="0.15cm"/>
    </style:style>
    <style:style style:name="TableCenter" style:family="paragraph" style:parent-style-name="TablePara">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.15cm" fo:margin-bottom="0.15cm"/>
    </style:style>
    <style:style style:name="AttachPara" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:margin-top="0.12cm" fo:margin-bottom="0.12cm" fo:line-height="150%"/>
    </style:style>
  </office:automatic-styles>

  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>

  <office:body>
    <office:text>
      <text:p text:style-name="Body">様式第１号（第３条関係）</text:p>
      <text:p text:style-name="Body"><text:s text:c="3"/></text:p>
      <text:p text:style-name="Title">鳥羽市鳥獣害対策事業補助金交付申請書</text:p>
      <text:p text:style-name="Body"><text:s text:c="3"/></text:p>
      <text:p text:style-name="Right">令和　　年　　月　　日</text:p>
      <text:p text:style-name="Body"><text:s text:c="4"/></text:p>
      <text:p text:style-name="Body">鳥羽市長　小竹　篤　様</text:p>
      <text:p text:style-name="Body"><text:s text:c="3"/></text:p>
      <text:p text:style-name="Body">申請者　住所　：</text:p>
      <text:p text:style-name="Body"><text:s text:c="3"/></text:p>
      <text:p text:style-name="Right">氏　名　：　＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿</text:p>
      <text:p text:style-name="Small">（本人自署の場合は、押印は不要で</text:p>
      <text:p text:style-name="Small">す）</text:p>
      <text:p text:style-name="Body">印</text:p>
      <text:p text:style-name="Right">電話　：</text:p>
      <text:p text:style-name="Body"><text:s text:c="3"/></text:p>
      <text:p text:style-name="Body">鳥羽市鳥獣害対策事業補助金交付要綱第６条の規定により、次のとおり申請しま</text:p>
      <text:p text:style-name="Body">す。</text:p>

      <table:table table:name="設置場所" table:style-name="ApplicantTable">
        <table:table-column table:style-name="LeftColumn"/>
        <table:table-column table:style-name="RightColumn"/>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="TableCenter">設置場所</text:p>
            <text:p text:style-name="TableCenter">（町字名地</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="TablePara">鳥羽市　　町字　　番地内</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="PageBreak"/>
      <table:table table:name="申請内容" table:style-name="ApplicantTable">
        <table:table-column table:style-name="LeftColumn"/>
        <table:table-column table:style-name="RightColumn"/>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="TableCenter">番）</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="TablePara"><text:s/></text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="TableCenter">事業の目的</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="TablePara"><text:s/></text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="TableCenter">総事業費</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="Right">円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="TableCenter">補助金交付</text:p>
            <text:p text:style-name="TableCenter">申請額</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="Right">円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="TableCenter">添付資料</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="AttachPara">1.　　事業を実施しようとする位置図</text:p>
            <text:p text:style-name="AttachPara">　　　（縮尺 1/3,000 以上の位置図）</text:p>
            <text:p text:style-name="AttachPara">2.　　収支予算書</text:p>
            <text:p text:style-name="AttachPara">3.　　防護柵用資材費の見積書（購入業者等からの）</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="TableCenter">備考</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="TablePara"><text:s/></text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="Body"><text:s text:c="2"/>※氏名が自署でない場合は、記名押印をお願いします。</text:p>
      <text:p text:style-name="Body"><text:s text:c="2"/>※補助金の対象となる経費は、防護柵用資材の購入に係る経費とし、設置に係る工</text:p>
      <text:p text:style-name="Body"><text:s text:c="2"/>事費等は含まないものとする。</text:p>
      <text:p text:style-name="Body"><text:s text:c="2"/>※補助金の額は50,000 円を上限とし、防護柵用資材の購入額の２分の１を乗じた額</text:p>
      <text:p text:style-name="Body"><text:s text:c="2"/>とする。</text:p>
    </office:text>
  </office:body>
</office:document>