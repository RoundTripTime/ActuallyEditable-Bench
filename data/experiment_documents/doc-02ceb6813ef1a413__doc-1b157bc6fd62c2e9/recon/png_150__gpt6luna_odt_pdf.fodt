    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout" style:page-usage="all">
      <style:page-layout-properties fo:page-width="29.7cm" fo:page-height="21cm" style:print-orientation="landscape" fo:margin-top="0.8cm" fo:margin-bottom="0.8cm" fo:margin-left="1.5cm" fo:margin-right="1.5cm"/>
    </style:page-layout>
    <style:style style:name="Table" style:family="table">
      <style:table-properties table:align="margins" style:width="26.7cm"/>
    </style:style>
    <style:style style:name="Col" style:family="table-column">
