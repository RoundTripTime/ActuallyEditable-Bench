  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Right">S0700000213</text:p>
      <text:p text:style-name="Title">不動產役權設定契約書</text:p>
      <text:p text:style-name="P">土地　　權利人</text:p>
      <text:p text:style-name="P">下列　　經　　雙方同意設定不動產役權，特訂立本契約：</text:p>
      <text:p text:style-name="P">建物　　義務人</text:p>
      <table:table table:name="供地役權標示">
        <table:table-column table:style-name="Col" table:number-columns-repeated="6"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>供地役不動產標示</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>（１）座落</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>（２）地號</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>（３）面積</text:p><text:p>（平方公尺）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p/>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>鄉鎮市區</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>段</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>小段</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>地號</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>（４）設定權利範圍</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p/>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <table:table table:name="供地役建物標示">
        <table:table-column table:style-name="Col" table:number-columns-repeated="8"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>建物標示</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>（５）建號</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p>（６）門牌</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>（７）建物坐落</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>（８）總面積</text:p><text:p>（平方公尺）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>（９）設定權利範圍</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>建號</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>鄉鎮市區</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>街路</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>段巷弄</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>號樓</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>段、小段、地號</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
