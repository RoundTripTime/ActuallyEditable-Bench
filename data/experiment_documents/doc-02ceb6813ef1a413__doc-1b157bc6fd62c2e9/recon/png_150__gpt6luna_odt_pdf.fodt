          <table:table-cell table:style-name="Cell"><text:p>（１８）使用需役不動產權利關係</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>建號</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>鄉鎮市區</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>街路</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>段巷弄</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>號樓</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>段、小段、地號</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageStart"/>
      <table:table table:name="契約條款">
        <table:table-column table:style-name="Col" table:number-columns-repeated="2"/>
        <table:table-row><table:table-cell table:style-name="LeftCell"><text:p>（１９）權利價值</text:p></table:table-cell><table:table-cell table:style-name="LeftCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="LeftCell"><text:p>（２０）存續期間</text:p></table:table-cell><table:table-cell table:style-name="LeftCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="LeftCell"><text:p>（２１）設定目的</text:p></table:table-cell><table:table-cell table:style-name="LeftCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="LeftCell"><text:p>（２２）地租</text:p></table:table-cell><table:table-cell table:style-name="LeftCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="LeftCell"><text:p>（２３）預付地租情形</text:p></table:table-cell><table:table-cell table:style-name="LeftCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="LeftCell"><text:p>（２４）使用方法</text:p></table:table-cell><table:table-cell table:style-name="LeftCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>（２５）申請登記以外之約定事項</text:p></table:table-cell>
          <table:table-cell table:style-name="LeftCell"><text:p>1.</text:p><text:p>2.</text:p><text:p>3.</text:p><text:p>4.</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>（２６）簽名或簽證</text:p></table:table-cell>
          <table:table-cell table:style-name="LeftCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>訂　（２７）　（２８）　（２９）　（３０）　（３１）　（３２）住所　（３３）</text:p></table:table-cell>
          <table:table-cell table:style-name="LeftCell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageStart"/>
      <table:table table:name="立契約人">
        <table:table-column table:style-name="Col" table:number-columns-repeated="16"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="4"><text:p>立契約人</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>權利人或義務人</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>姓名或名稱</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>權利範圍</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>出生年月日</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>統一編號</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>縣市</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>鄉鎮市區</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>村里</text:p></table:table-cell>
