        <table:table-column table:style-name="Col" table:number-columns-repeated="6"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>需地役不動產標示</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>（１０）座落</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>（１１）地號</text:p></table:table-cell><table:covered-table-cell/>
