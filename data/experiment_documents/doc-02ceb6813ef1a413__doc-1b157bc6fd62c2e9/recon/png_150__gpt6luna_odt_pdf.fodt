          <table:table-cell table:style-name="Cell"><text:p>地號</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>（１３）使用需役不動產權利關係</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageStart"/>
      <table:table table:name="需地役建物標示續頁">
        <table:table-column table:style-name="Col" table:number-columns-repeated="8"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>需地役不動產標示</text:p></table:table-cell>
