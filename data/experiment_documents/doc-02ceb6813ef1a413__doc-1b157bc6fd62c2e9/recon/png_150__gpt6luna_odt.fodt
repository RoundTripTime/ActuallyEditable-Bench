<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="C" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="B" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="T" style:family="table">
      <style:table-properties style:width="26cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Blue" style:family="text">
      <style:text-properties fo:color="#0000FF"/>
    </style:style>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="29.7cm" fo:page-height="21cm" fo:print-orientation="landscape" fo:margin-left="1.8cm" fo:margin-right="1.8cm" fo:margin-top="1.2cm" fo:margin-bottom="1.2cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Master" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p style:style-name="P">S0700000213</text:p>
      <table:table table:name="Page1" table:style-name="T">
        <table:table-column table:number-columns-repeated="6"/>
        <table:table-row>
          <table:table-cell table:style-name="B" table:number-columns-spanned="6"><text:p style:style-name="C">不 動 產 役 權 設 定 契 約 書</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="B" table:number-columns-spanned="6"><text:p style:style-name="P">土地　權利人</text:p><text:p style:style-name="P">下列　經　雙方同意設定不動產役權，特訂立本契約：</text:p><text:p style:style-name="P">建物　義務人</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="B" table:number-rows-spanned="5"><text:p style:style-name="C">供地役不動產標示</text:p></table:table-cell>
          <table:table-cell table:style-name="B" table:number-rows-spanned="5"><text:p style:style-name="C">土地標示</text:p></table:table-cell>
          <table:table-cell table:style-name="B" table:number-columns-spanned="3"><text:p style:style-name="C">（1）坐落</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="B" table:number-rows-spanned="2"><text:p style:style-name="C">（2）地號</text:p></table:table-cell>
          <table:table-cell table:style-name="B"><text:p style:style-name="C">（<text:span text:style-name="Blue">3</text:span>）面積</text:p><text:p style:style-name="C">（平方公尺）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="B"><text:p style:style-name="C">鄉鎮市區</text:p></table:table-cell><table:table-cell table:style-name="B"><text:p style:style-name="C">段</text:p></table:table-cell><table:table-cell table:style-name="B"><text:p style:style-name="C">小段</text:p></table:table-cell>
          <table:covered-table-cell/><table:table-cell table:style-name="B"><text:p style:style-name="C">（<text:span text:style-name="Blue">4</text:span>）設定權利範圍</text:p></table:table-cell>
        </table:table-row>
        <table:table-row><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/></table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="B" table:number-rows-spanned="5"><text:p style:style-name="C">需役不動產標示</text:p></table:table-cell>
          <table:table-cell table:style-name="B" table:number-rows-spanned="5"><text:p style:style-name="C">土地標示</text:p></table:table-cell>
          <table:table-cell table:style-name="B" table:number-columns-spanned="3"><text:p style:style-name="C">（<text:span text:style-name="Blue">10</text:span>）坐落</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="B" table:number-rows-spanned="2"><text:p style:style-name="C">（<text:span text:style-name="Blue">11</text:span>）地號</text:p></table:table-cell>
          <table:table-cell table:style-name="B" table:number-rows-spanned="2"><text:p style:style-name="C">（<text:span text:style-name="Blue">12</text:span>）面積</text:p><text:p style:style-name="C">（平方公尺）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row><table:table-cell table:style-name="B"><text:p style:style-name="C">鄉鎮市區</text:p></table:table-cell><table:table-cell table:style-name="B"><text:p style:style-name="C">段</text:p></table:table-cell><table:table-cell table:style-name="B"><text:p style:style-name="C">小段</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="B" table:number-rows-spanned="2"><text:p style:style-name="C">建物標示</text:p></table:table-cell>
          <table:table-cell table:style-name="B" table:number-rows-spanned="2"><text:p style:style-name="C">（<text:span text:style-name="Blue">5</text:span>）建號</text:p></table:table-cell>
          <table:table-cell table:style-name="B" table:number-columns-spanned="3"><text:p style:style-name="C">（<text:span text:style-name="Blue">6</text:span>）門牌</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="B" table:number-columns-spanned="1"><text:p style:style-name="C">（<text:span text:style-name="Blue">7</text:span>）建物坐落</text:p></table:table-cell>
          <table:table-cell table:style-name="B"><text:p style:style-name="C">（<text:span text:style-name="Blue">8</text:span>）總面積</text:p><text:p style:style-name="C">（平方公尺）</text:p></table:table-cell>
          <table:table-cell table:style-name="B"><text:p style:style-name="C">（<text:span text:style-name="Blue">9</text:span>）設定權利範圍</text:p></table:table-cell>
        </table:table-row>
        <table:table-row><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"><text:p style:style-name="C">鄉鎮市區</text:p></table:table-cell><table:table-cell table:style-name="B"><text:p style:style-name="C">街路　段巷弄　號樓</text:p></table:table-cell><table:table-cell table:style-name="B"><text:p style:style-name="C">段　小段　地號</text:p></table:table-cell><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/></table:table-row>
      </table:table>

      <text:p style:style-name="PageBreak"/>
      <table:table table:name="Page2" table:style-name="T">
        <table:table-column table:number-columns-repeated="6"/>
        <table:table-row><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/></table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="B" table:number-rows-spanned="3"><text:p style:style-name="C">不動產標示</text:p></table:table-cell>
          <table:table-cell table:style-name="B" table:number-rows-spanned="3"><text:p style:style-name="C">建物標示</text:p></table:table-cell>
          <table:table-cell table:style-name="B"><text:p style:style-name="C">（<text:span text:style-name="Blue">14</text:span>）建號</text:p></table:table-cell>
          <table:table-cell table:style-name="B" table:number-columns-spanned="2"><text:p style:style-name="C">（<text:span text:style-name="Blue">15</text:span>）門牌</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="B"><text:p style:style-name="C">（<text:span text:style-name="Blue">16</text:span>）建物坐落</text:p></table:table-cell>
          <table:table-cell table:style-name="B"><text:p style:style-name="C">（<text:span text:style-name="Blue">17</text:span>）總面積</text:p><text:p style:style-name="C">（平方公尺）</text:p></table:table-cell>
          <table:table-cell table:style-name="B"><text:p style:style-name="C">（<text:span text:style-name="Blue">18</text:span>）使用需役不動產權利關係</text:p></table:table-cell>
        </table:table-row>
        <table:table-row><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"><text:p style:style-name="C">鄉鎮市區</text:p></table:table-cell><table:table-cell table:style-name="B"><text:p style:style-name="C">街路　段巷弄　號樓</text:p></table:table-cell><table:table-cell table:style-name="B"><text:p style:style-name="C">段　小段　地號</text:p></table:table-cell><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/></table:table-row>
      </table:table>

      <text:p style:style-name="PageBreak"/>
      <table:table table:name="Page3" table:style-name="T">
        <table:table-column table:number-columns-repeated="8"/>
        <table:table-row>
          <table:table-cell table:style-name="B" table:number-columns-spanned="2"><text:p style:style-name="P">（<text:span text:style-name="Blue">19</text:span>）權利價值</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="B" table:number-columns-spanned="6"><text:p style:style-name="P"/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row><table:table-cell table:style-name="B" table:number-columns-spanned="2"><text:p style:style-name="P">（<text:span text:style-name="Blue">20</text:span>）存續期間</text:p></table:table-cell><table:covered-table-cell/><table:table-cell table:style-name="B" table:number-columns-spanned="6"><text:p style:style-name="P"/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="B" table:number-columns-spanned="2"><text:p style:style-name="P">（<text:span text:style-name="Blue">21</text:span>）設定目的</text:p></table:table-cell><table:covered-table-cell/><table:table-cell table:style-name="B" table:number-columns-spanned="6"><text:p style:style-name="P"/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="B" table:number-columns-spanned="2"><text:p style:style-name="P">（<text:span text:style-name="Blue">22</text:span>）地租</text:p></table:table-cell><table:covered-table-cell/><table:table-cell table:style-name="B" table:number-columns-spanned="6"><text:p style:style-name="P"/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="B" table:number-columns-spanned="2"><text:p style:style-name="P">（<text:span text:style-name="Blue">23</text:span>）預付地租情形</text:p></table:table-cell><table:covered-table-cell/><table:table-cell table:style-name="B" table:number-columns-spanned="6"><text:p style:style-name="P"/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="B" table:number-columns-spanned="2"><text:p style:style-name="P">（<text:span text:style-name="Blue">24</text:span>）使用方法</text:p></table:table-cell><table:covered-table-cell/><table:table-cell table:style-name="B" table:number-columns-spanned="6"><text:p style:style-name="P"/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="B"><text:p style:style-name="C">（<text:span text:style-name="Blue">25</text:span>）申請登記以外之約定事項</text:p></table:table-cell>
          <table:table-cell table:style-name="B" table:number-columns-spanned="4"><text:p style:style-name="P">1.</text:p><text:p style:style-name="P">2.</text:p><text:p style:style-name="P">3.</text:p><text:p style:style-name="P">4.</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="B"><text:p style:style-name="C">（<text:span text:style-name="Blue">26</text:span>）簽名或簽證</text:p></table:table-cell>
          <table:table-cell table:style-name="B" table:number-columns-spanned="2"><text:p style:style-name="P"/></table:table-cell><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="B"><text:p style:style-name="C">立契約人</text:p></table:table-cell>
          <table:table-cell table:style-name="B"><text:p style:style-name="C">權利人或義務人</text:p></table:table-cell>
          <table:table-cell table:style-name="B"><text:p style:style-name="C">姓名或名稱</text:p></table:table-cell>
          <table:table-cell table:style-name="B"><text:p style:style-name="C">權利範圍</text:p></table:table-cell>
          <table:table-cell table:style-name="B"><text:p style:style-name="C">出生年月日</text:p></table:table-cell>
          <table:table-cell table:style-name="B"><text:p style:style-name="C">統一編號</text:p></table:table-cell>
          <table:table-cell table:style-name="B"><text:p style:style-name="C">縣市　鄉鎮市區　村里　鄰　街路　段　巷弄　號　樓</text:p></table:table-cell>
          <table:table-cell table:style-name="B"><text:p style:style-name="C">蓋章</text:p></table:table-cell>
        </table:table-row>
        <table:table-row><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/><table:table-cell table:style-name="B"/></table:table-row>
