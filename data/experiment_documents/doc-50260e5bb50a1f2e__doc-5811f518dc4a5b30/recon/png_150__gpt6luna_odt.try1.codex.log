        <table:table-row>
          <table:table-cell table:style-name="CellCenter"><text:p text:style-name="Center">提供可能期間</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Center">1　 通年　　　　　　2　期間限定（　　月　～　　月）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
