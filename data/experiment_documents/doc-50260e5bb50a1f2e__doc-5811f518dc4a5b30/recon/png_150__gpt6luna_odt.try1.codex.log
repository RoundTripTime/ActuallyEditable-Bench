          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">※配送料　　　　　　　　　円</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter"><text:p text:style-name="Center">配送方法</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Center">1　　常温　　　　　2　　冷蔵　　　　　3　　冷凍</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="LargeRow">
          <table:table-cell table:style-name="BigCell" table:number-columns-spanned="5"><text:p text:style-name="Body">返礼品のＰＲ（120 文字以内）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
