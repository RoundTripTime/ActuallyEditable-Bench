<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="TextBase" style:family="paragraph">
      <style:text-properties fo:font-family="MS Mincho" style:font-family-asian="MS Mincho" fo:font-size="12pt"/>
      <style:paragraph-properties fo:line-height="1.35"/>
    </style:style>
    <style:style style:name="P" style:family="paragraph" style:parent-style-name="TextBase"/>
    <style:style style:name="TopLine" style:family="paragraph" style:parent-style-name="TextBase">
      <style:paragraph-properties fo:margin-bottom="0.6cm"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="TextBase">
      <style:paragraph-properties fo:text-align="center" fo:margin-bottom="0.65cm"/>
    </style:style>
    <style:style style:name="DateLine" style:family="paragraph" style:parent-style-name="TextBase">
      <style:paragraph-properties fo:text-align="right" fo:margin-bottom="0.6cm"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph" style:parent-style-name="TextBase">
      <style:paragraph-properties fo:margin-left="0.9cm" fo:margin-bottom="0.55cm"/>
    </style:style>
    <style:style style:name="Intro" style:family="paragraph" style:parent-style-name="TextBase">
      <style:paragraph-properties fo:margin-left="0.45cm" fo:margin-bottom="0.05cm"/>
    </style:style>
    <style:style style:name="Caption" style:family="paragraph" style:parent-style-name="TextBase">
      <style:paragraph-properties fo:margin-top="0.6cm" fo:margin-bottom="0.05cm"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph" style:parent-style-name="TextBase">
      <style:paragraph-properties fo:margin-left="0.2cm" fo:margin-top="0.1cm" fo:font-size="10pt"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="BreakPage" style:family="paragraph" style:parent-style-name="TextBase">
      <style:paragraph-properties fo:break-before="page" fo:line-height="1pt" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="1pt"/>
    </style:style>
    <style:style style:name="SectionHeading" style:family="paragraph" style:parent-style-name="TextBase">
      <style:paragraph-properties fo:margin-left="0.35cm" fo:margin-top="1.35cm" fo:margin-bottom="0.2cm"/>
    </style:style>
    <style:style style:name="Clause" style:family="paragraph" style:parent-style-name="TextBase">
      <style:paragraph-properties fo:margin-left="0.35cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="17.2cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ImageTable" style:family="table">
      <style:table-properties style:width="17.2cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ColApplicant" style:family="table-column">
      <style:table-column-properties style:column-width="0.8cm"/>
    </style:style>
    <style:style style:name="ColLabel" style:family="table-column">
      <style:table-column-properties style:column-width="2.4cm"/>
    </style:style>
    <style:style style:name="ColData" style:family="table-column">
      <style:table-column-properties style:column-width="4.7cm"/>
    </style:style>
    <style:style style:name="ColSmall" style:family="table-column">
      <style:table-column-properties style:column-width="1.7cm"/>
    </style:style>
    <style:style style:name="ColWide" style:family="table-column">
      <style:table-column-properties style:column-width="7.6cm"/>
    </style:style>
    <style:style style:name="ColItemLabel" style:family="table-column">
      <style:table-column-properties style:column-width="3cm"/>
    </style:style>
    <style:style style:name="ColItemContent" style:family="table-column">
      <style:table-column-properties style:column-width="9.3cm"/>
    </style:style>
    <style:style style:name="ColExpiry" style:family="table-column">
      <style:table-column-properties style:column-width="2.5cm"/>
    </style:style>
    <style:style style:name="ColExpiryValue" style:family="table-column">
      <style:table-column-properties style:column-width="2.4cm"/>
    </style:style>
    <style:style style:name="ColPriceContent" style:family="table-column">
      <style:table-column-properties style:column-width="6.2cm"/>
    </style:style>
    <style:style style:name="ColPriceValue" style:family="table-column">
      <style:table-column-properties style:column-width="2.2cm"/>
    </style:style>
    <style:style style:name="ColShipping" style:family="table-column">
      <style:table-column-properties style:column-width="3.5cm"/>
    </style:style>
    <style:style style:name="ColShippingValue" style:family="table-column">
      <style:table-column-properties style:column-width="2.3cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="table-cell" style:parent-style-name="Cell">
      <style:table-cell-properties style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellTop" style:family="table-cell" style:parent-style-name="Cell">
      <style:table-cell-properties style:vertical-align="top"/>
    </style:style>
    <style:style style:name="RowShort" style:family="table-row">
      <style:table-row-properties style:row-height="0.66cm"/>
    </style:style>
    <style:style style:name="RowApplicant" style:family="table-row">
      <style:table-row-properties style:row-height="0.95cm"/>
    </style:style>
    <style:style style:name="RowContact" style:family="table-row">
      <style:table-row-properties style:row-height="0.68cm"/>
    </style:style>
    <style:style style:name="RowDetails" style:family="table-row">
      <style:table-row-properties style:row-height="2.55cm"/>
    </style:style>
    <style:style style:name="RowPR" style:family="table-row">
      <style:table-row-properties style:row-height="2.9cm"/>
    </style:style>
    <style:style style:name="RowSpecial" style:family="table-row">
      <style:table-row-properties style:row-height="2.2cm"/>
    </style:style>
    <style:style style:name="RowImage" style:family="table-row">
      <style:table-row-properties style:row-height="8.2cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="1.9cm" fo:margin-bottom="1.8cm" fo:margin-left="1.9cm" fo:margin-right="1.9cm"/>
    </style:page-layout-properties>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="TopLine">別記第１号様式（第５条関係）</text:p>
      <text:p text:style-name="Title">北広島市ふるさと納税返礼品登録申請書</text:p>
      <text:p text:style-name="DateLine">年　　月　　日</text:p>
      <text:p text:style-name="Recipient">北広島市長　様</text:p>
      <text:p text:style-name="Intro">北広島市ふるさと納税返礼品登録要領に基づき、下記の品目を返礼品として申請します。</text:p>
      <text:p text:style-name="Intro">また、申請に当たり、裏面の留意事項を承諾し、市税の納付状況について市が確認する<text:line-break/>ことについて同意します。</text:p>
      <table:table table:name="申請者情報" table:style-name="FormTable">
        <table:table-column table:style-name="ColApplicant"/>
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColData"/>
        <table:table-column table:style-name="ColSmall"/>
        <table:table-column table:style-name="ColWide"/>
        <table:table-row table:style-name="RowApplicant">
          <table:table-cell table:style-name="CellCenter" table:number-rows-spanned="3"><text:p>申<text:line-break/>請<text:line-break/>者</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>事業者名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowApplicant">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellCenter"><text:p>所　在　地</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p/></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowApplicant">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellCenter"><text:p>代表者名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p/></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowContact">
          <table:table-cell table:style-name="CellCenter" table:number-rows-spanned="4"><text:p>担<text:line-break/>当<text:line-break/>者</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>氏　名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>部署名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowContact">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellCenter"><text:p>電　話</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>ＦＡＸ</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowContact">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellCenter"><text:p>メール</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p/></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowContact">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellCenter"><text:p>ＵＲＬ</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p/></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Caption">○返礼品の内容（２セット目以降は、下記のみ記載して提出してください。）</text:p>
      <table:table table:name="返礼品内容" table:style-name="FormTable">
        <table:table-column table:style-name="ColItemLabel"/>
        <table:table-column table:style-name="ColItemContent"/>
        <table:table-column table:style-name="ColExpiry"/>
        <table:table-column table:style-name="ColExpiryValue"/>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="CellCenter"><text:p>名　称</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p/></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowDetails">
          <table:table-cell table:style-name="CellCenter"><text:p>返礼品<text:line-break/>内　容</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTop"><text:p><text:span text:style-name="Note">(内訳・量・規格等)</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>消費期限<text:line-break/>※飲食物の<text:line-break/>場合記入</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="CellCenter" table:number-columns-spanned="4"><text:p>提供可能期間　　１　通年　　　　　２　期間限定（　　　月　～　　　月）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="CellCenter" table:number-columns-spanned="4"><text:p>提供可能数　　１　　　個／月　　　２　　　個／年</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <table:table table:name="価格と配送" table:style-name="FormTable">
        <table:table-column table:style-name="ColItemLabel"/>
        <table:table-column table:style-name="ColPriceContent"/>
        <table:table-column table:style-name="ColPriceValue"/>
        <table:table-column table:style-name="ColShipping"/>
        <table:table-column table:style-name="ColShippingValue"/>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="CellCenter"><text:p>価　格</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>返礼品</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>円（税込）</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>※配送料</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="CellCenter" table:number-columns-spanned="5"><text:p>配送方法　　１　常温　　　　　２　冷蔵　　　　　３　冷凍</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowPR">
          <table:table-cell table:style-name="CellTop" table:number-columns-spanned="5"><text:p>返礼品のＰＲ（120 文字以内）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowSpecial">
          <table:table-cell table:style-name="CellTop" table:number-columns-spanned="5"><text:p>特記事項</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Note">※配送料については、返礼品の送付に係る金額として最も高い金額を記入してください。</text:p>
      <text:p text:style-name="BreakPage"/>
      <table:table table:name="イメージ画像欄" table:style-name="ImageTable">
        <table:table-column table:style-name="ColWide"/>
        <table:table-row table:style-name="RowImage">
          <table:table-cell table:style-name="CellTop"><text:p>イメージ画像</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Note">※返礼品の写真については、画像データ（JPG 形式）で提出してください。</text:p>
      <text:p text:style-name="Note">　サイズ横650px×縦400px以上の画像の場合は、HP 等できれいに表示されます。</text:p>
      <text:p text:style-name="SectionHeading">留　意　事　項</text:p>
      <text:p text:style-name="Clause">１　返礼品に関して寄附者から苦情があったときは、真摯に対応してその解決に努めるも<text:line-break/>　　のとし、苦情内容について市に報告すること。</text:p>
      <text:p text:style-name="Clause">２　返礼品の販売中止、内容の変更又は返礼品として提供ができなくなったときは、速や<text:line-break/>　　かに市に報告すること。</text:p>
      <text:p text:style-name="Clause">３　返礼品の提供に係る業務で知り得た情報について、返礼品の発送以外の目的に使用し<text:line-break/>　　ないこと。ただし、寄附者から事業者に改めて商品の申込み等があり、当該申込み等<text:line-break/>　　により把握した情報については、この限りでない。</text:p>
      <text:p text:style-name="Clause">４　北広島市ふるさと納税返礼品登録要領に定める要件に該当しなくなったとき、申請内<text:line-break/>　　容に虚偽若しくは不正があったとき又は市若しくは寄附者に対し損害を与えたときは、<text:line-break/>　　返礼品の登録が取り消されることがあること。</text:p>
    </office:text>
  </office:body>
</office:document>