<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:padding-bottom="0.22cm" fo:border-bottom="0.04cm solid #4A80C2"/>
      <style:text-properties fo:font-size="29pt" fo:color="#1F3F68"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.48cm" fo:margin-bottom="0.20cm"/>
      <style:text-properties fo:font-size="12pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="MetaLabel" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="115%"/>
      <style:text-properties fo:font-size="11pt" fo:font-weight="bold" fo:color="#39679E"/>
    </style:style>
    <style:style style:name="MetaValue" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="115%"/>
      <style:text-properties fo:font-size="11pt" fo:color="#39679E"/>
    </style:style>
    <style:style style:name="ColumnHeader" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="115%"/>
      <style:text-properties fo:font-size="10pt" fo:font-weight="bold" fo:color="#39679E"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.20cm" fo:margin-bottom="0.14cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Footer" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="2.25cm"/>
      <style:text-properties fo:font-size="9pt" fo:color="#000000"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="29.7cm" fo:page-height="21cm" style:print-orientation="landscape" fo:margin-left="1.4cm" fo:margin-right="1.4cm" fo:margin-top="1.4cm" fo:margin-bottom="1.2cm"/>
    </style:page-layout>
    <style:style style:name="MetaTable" style:family="table">
      <style:table-properties style:width="26.9cm" table:align="margins"/>
    </style:style>
    <style:style style:name="MetaLabelCol" style:family="table-column">
      <style:table-column-properties style:column-width="13.3cm"/>
    </style:style>
    <style:style style:name="MetaValueCol" style:family="table-column">
      <style:table-column-properties style:column-width="13.6cm"/>
    </style:style>
    <style:style style:name="MetaCell" style:family="table-cell">
      <style:table-cell-properties fo:padding-top="0.055cm" fo:padding-bottom="0.055cm" fo:padding-left="0.20cm" fo:padding-right="0.15cm" fo:border-top="0.02cm solid #4A80C2" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="MetaCellBlue" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#D3DFEF" fo:padding-top="0.055cm" fo:padding-bottom="0.055cm" fo:padding-left="0.20cm" fo:padding-right="0.15cm" fo:border-top="0.02cm solid #4A80C2" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="MetaBottom" style:family="table-cell">
      <style:table-cell-properties fo:padding-top="0.055cm" fo:padding-bottom="0.055cm" fo:padding-left="0.20cm" fo:padding-right="0.15cm" fo:border-top="0.02cm solid #4A80C2" fo:border-bottom="0.04cm solid #4A80C2" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="MetaBottomBlue" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#D3DFEF" fo:padding-top="0.055cm" fo:padding-bottom="0.055cm" fo:padding-left="0.20cm" fo:padding-right="0.15cm" fo:border-top="0.02cm solid #4A80C2" fo:border-bottom="0.04cm solid #4A80C2" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="ItemsTable" style:family="table">
      <style:table-properties style:width="26.9cm" table:align="margins"/>
    </style:style>
    <style:style style:name="ItemCol1" style:family="table-column">
      <style:table-column-properties style:column-width="7cm"/>
    </style:style>
    <style:style style:name="ItemCol2" style:family="table-column">
      <style:table-column-properties style:column-width="4.3cm"/>
    </style:style>
    <style:style style:name="ItemCol3" style:family="table-column">
      <style:table-column-properties style:column-width="4.1cm"/>
    </style:style>
    <style:style style:name="ItemCol4" style:family="table-column">
      <style:table-column-properties style:column-width="5.3cm"/>
    </style:style>
    <style:style style:name="ItemCol5" style:family="table-column">
      <style:table-column-properties style:column-width="6.2cm"/>
    </style:style>
    <style:style style:name="HeadCell" style:family="table-cell">
      <style:table-cell-properties fo:padding-top="0.08cm" fo:padding-bottom="0.12cm" fo:padding-left="0.20cm" fo:padding-right="0.10cm" fo:border-top="0.04cm solid #4A80C2" fo:border-bottom="0.04cm solid #4A80C2" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="DataCell" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#D3DFEF" fo:padding-top="0.24cm" fo:padding-bottom="0.24cm" fo:padding-left="0.10cm" fo:padding-right="0.10cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="SpacerCell" style:family="table-cell">
      <style:table-cell-properties fo:padding-top="0.17cm" fo:padding-bottom="0.17cm" fo:padding-left="0cm" fo:padding-right="0cm"/>
    </style:style>
    <style:style style:name="NotesRule" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.58cm" fo:padding-top="0.04cm" fo:border-top="0.04cm solid #4A80C2"/>
      <style:text-properties fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="DefaultPage" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">Delivery Challan</text:p>
      <text:p text:style-name="Subtitle">BLANK TEMPLATE | Currency: INR</text:p>
      <table:table table:name="Details" table:style-name="MetaTable">
        <table:table-column table:style-name="MetaLabelCol"/>
        <table:table-column table:style-name="MetaValueCol"/>
        <table:table-row>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="MetaLabel">Consignor / GSTIN</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="MetaValue">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaCellBlue"><text:p text:style-name="MetaLabel">Consignee / GSTIN or UIN</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaCellBlue"><text:p text:style-name="MetaValue">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="MetaLabel">Challan / date</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="MetaValue">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaCellBlue"><text:p text:style-name="MetaLabel">Dispatch / delivery addresses</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaCellBlue"><text:p text:style-name="MetaValue">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="MetaLabel">Purpose / transport</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="MetaValue">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaCellBlue"><text:p text:style-name="MetaLabel">Place of supply</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaCellBlue"><text:p text:style-name="MetaValue">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="MetaLabel">Signature</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="MetaValue">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaBottomBlue"><text:p text:style-name="MetaLabel">Receipt acknowledgment</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaBottomBlue"><text:p text:style-name="MetaValue">________________________________________</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body"/>
      <table:table table:name="LineItems" table:style-name="ItemsTable">
        <table:table-column table:style-name="ItemCol1"/>
        <table:table-column table:style-name="ItemCol2"/>
        <table:table-column table:style-name="ItemCol3"/>
        <table:table-column table:style-name="ItemCol4"/>
        <table:table-column table:style-name="ItemCol5"/>
        <table:table-row>
          <table:table-cell table:style-name="HeadCell"><text:p text:style-name="ColumnHeader">HSN / description</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p text:style-name="ColumnHeader">Quantity / unit</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p text:style-name="ColumnHeader">Taxable value (INR)</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p text:style-name="ColumnHeader">Applicable tax rates</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p text:style-name="ColumnHeader">Component amounts (INR)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="DataCell"/>
          <table:table-cell table:style-name="DataCell"/>
          <table:table-cell table:style-name="DataCell"/>
          <table:table-cell table:style-name="DataCell"/>
          <table:table-cell table:style-name="DataCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="SpacerCell"/>
          <table:table-cell table:style-name="SpacerCell"/>
          <table:table-cell table:style-name="SpacerCell"/>
          <table:table-cell table:style-name="SpacerCell"/>
          <table:table-cell table:style-name="SpacerCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="DataCell"/>
          <table:table-cell table:style-name="DataCell"/>
          <table:table-cell table:style-name="DataCell"/>
          <table:table-cell table:style-name="DataCell"/>
          <table:table-cell table:style-name="DataCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="SpacerCell"/>
          <table:table-cell table:style-name="SpacerCell"/>
          <table:table-cell table:style-name="SpacerCell"/>
          <table:table-cell table:style-name="SpacerCell"/>
          <table:table-cell table:style-name="SpacerCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="DataCell"/>
          <table:table-cell table:style-name="DataCell"/>
          <table:table-cell table:style-name="DataCell"/>
          <table:table-cell table:style-name="DataCell"/>
          <table:table-cell table:style-name="DataCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="SpacerCell"/>
          <table:table-cell table:style-name="SpacerCell"/>
          <table:table-cell table:style-name="SpacerCell"/>
          <table:table-cell table:style-name="SpacerCell"/>
          <table:table-cell table:style-name="SpacerCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="DataCell"/>
          <table:table-cell table:style-name="DataCell"/>
          <table:table-cell table:style-name="DataCell"/>
          <table:table-cell table:style-name="DataCell"/>
          <table:table-cell table:style-name="DataCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="NotesRule">Hypothetical inspection-and-return dispatch, not a sale. Confirm the actual movement and applicable tax treatment.</text:p>
      <text:p text:style-name="Note">For movement that is a supply, enter the applicable component rates and amounts; these manual files do not calculate them.</text:p>
      <text:p text:style-name="Note">Review applicable copy labels and movement authorization separately.</text:p>
      <text:p text:style-name="Note">Word amounts are manual. Check line amounts and totals after every edit.</text:p>
      <text:p text:style-name="Footer">OnlineBiller | Original English resource | Blank template</text:p>
    </office:text>
  </office:body>
</office:document>