<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:color="#000000"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph">
      <style:text-properties fo:font-family="Arial" fo:font-size="26pt" fo:color="#17365D"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.18cm"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.35cm" fo:margin-bottom="0.18cm"/>
    </style:style>
    <style:style style:name="DetailLabel" style:family="paragraph">
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:font-weight="bold" fo:color="#366092"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="ColumnHeading" style:family="paragraph">
      <style:text-properties fo:font-family="Arial" fo:font-size="9pt" fo:font-weight="bold" fo:color="#366092"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.12cm" fo:margin-bottom="0.12cm"/>
    </style:style>
    <style:style style:name="Footer" style:family="paragraph">
      <style:text-properties fo:font-family="Arial" fo:font-size="8pt" fo:color="#000000"/>
      <style:paragraph-properties fo:margin-top="2.2cm" fo:margin-bottom="0cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="29.7cm" fo:page-height="21cm" fo:margin-left="1.4cm" fo:margin-right="1.4cm" fo:margin-top="1.4cm" fo:margin-bottom="1.4cm"/>
    </style:page-layout>
    <style:style style:name="DetailTable" style:family="table">
      <style:table-properties style:width="26.9cm" table:align="margins"/>
    </style:style>
    <style:style style:name="DetailCol1" style:family="table-column">
      <style:table-column-properties style:column-width="13.4cm"/>
    </style:style>
    <style:style style:name="DetailCol2" style:family="table-column">
      <style:table-column-properties style:column-width="13.5cm"/>
    </style:style>
    <style:style style:name="DetailCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="DetailBand" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#D4E0F0" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="DetailTop" style:family="table-cell">
      <style:table-cell-properties fo:border-top="0.04cm solid #4F81BD" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="DetailBandTop" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#D4E0F0" fo:border-top="0.04cm solid #4F81BD" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="DetailBottom" style:family="table-cell">
      <style:table-cell-properties fo:border-bottom="0.04cm solid #4F81BD" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="DetailBandBottom" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#D4E0F0" fo:border-bottom="0.04cm solid #4F81BD" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="ItemsTable" style:family="table">
      <style:table-properties style:width="26.9cm" table:align="margins"/>
    </style:style>
    <style:style style:name="ItemCol1" style:family="table-column">
      <style:table-column-properties style:column-width="6.78cm"/>
    </style:style>
    <style:style style:name="ItemCol2" style:family="table-column">
      <style:table-column-properties style:column-width="4.24cm"/>
    </style:style>
    <style:style style:name="ItemCol3" style:family="table-column">
      <style:table-column-properties style:column-width="4.24cm"/>
    </style:style>
    <style:style style:name="ItemCol4" style:family="table-column">
      <style:table-column-properties style:column-width="5.30cm"/>
    </style:style>
    <style:style style:name="ItemCol5" style:family="table-column">
      <style:table-column-properties style:column-width="6.34cm"/>
    </style:style>
    <style:style style:name="ItemHeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:border-top="0.04cm solid #4F81BD" fo:border-bottom="0.04cm solid #4F81BD" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="ItemCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.12cm 0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="ItemBandCell" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#D4E0F0" fo:padding="0.12cm 0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="ItemBottomCell" style:family="table-cell">
      <style:table-cell-properties fo:border-bottom="0.04cm solid #4F81BD" fo:padding="0.12cm 0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="ItemBandBottomCell" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#D4E0F0" fo:border-bottom="0.04cm solid #4F81BD" fo:padding="0.12cm 0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="ItemSpace" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="0.15cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">
        <text:span text:style-name="Title">Delivery Challan</text:span>
      </text:p>
      <text:p text:style-name="Subtitle">BLANK TEMPLATE | Currency: INR</text:p>
      <table:table table:name="ChallanDetails" table:style-name="DetailTable">
        <table:table-column table:style-name="DetailCol1"/>
        <table:table-column table:style-name="DetailCol2"/>
        <table:table-row>
          <table:table-cell table:style-name="DetailTop"><text:p text:style-name="DetailLabel">Consignor / GSTIN</text:p></table:table-cell>
          <table:table-cell table:style-name="DetailTop"><text:p><text:span>________________________________</text:span></text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="DetailBand"><text:p text:style-name="DetailLabel">Consignee / GSTIN or UIN</text:p></table:table-cell>
          <table:table-cell table:style-name="DetailBand"><text:p>________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="DetailCell"><text:p text:style-name="DetailLabel">Challan / date</text:p></table:table-cell>
          <table:table-cell table:style-name="DetailCell"><text:p>________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="DetailBand"><text:p text:style-name="DetailLabel">Dispatch / delivery addresses</text:p></table:table-cell>
          <table:table-cell table:style-name="DetailBand"><text:p>________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="DetailCell"><text:p text:style-name="DetailLabel">Purpose / transport</text:p></table:table-cell>
          <table:table-cell table:style-name="DetailCell"><text:p>________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="DetailBand"><text:p text:style-name="DetailLabel">Place of supply</text:p></table:table-cell>
          <table:table-cell table:style-name="DetailBand"><text:p>________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="DetailCell"><text:p text:style-name="DetailLabel">Signature</text:p></table:table-cell>
          <table:table-cell table:style-name="DetailCell"><text:p>________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="DetailBandBottom"><text:p text:style-name="DetailLabel">Receipt acknowledgment</text:p></table:table-cell>
          <table:table-cell table:style-name="DetailBandBottom"><text:p>________________________________</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p/>
      <table:table table:name="Items" table:style-name="ItemsTable">
        <table:table-column table:style-name="ItemCol1"/>
        <table:table-column table:style-name="ItemCol2"/>
        <table:table-column table:style-name="ItemCol3"/>
        <table:table-column table:style-name="ItemCol4"/>
        <table:table-column table:style-name="ItemCol5"/>
        <table:table-row>
          <table:table-cell table:style-name="ItemHeaderCell"><text:p text:style-name="ColumnHeading">HSN / description</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHeaderCell"><text:p text:style-name="ColumnHeading">Quantity / unit</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHeaderCell"><text:p text:style-name="ColumnHeading">Taxable value (INR)</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHeaderCell"><text:p text:style-name="ColumnHeading">Applicable tax rates</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHeaderCell"><text:p text:style-name="ColumnHeading">Component amounts (INR)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row><table:table-cell table:style-name="ItemBandCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemBandCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemBandCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemBandCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemBandCell"><text:p style:line-height="0.15cm"/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="ItemCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemCell"><text:p style:line-height="0.15cm"/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="ItemBandCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemBandCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemBandCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemBandCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemBandCell"><text:p style:line-height="0.15cm"/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="ItemCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemCell"><text:p style:line-height="0.15cm"/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="ItemBandCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemBandCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemBandCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemBandCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemBandCell"><text:p style:line-height="0.15cm"/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="ItemCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemCell"><text:p style:line-height="0.15cm"/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="ItemBandCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemBandCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemBandCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemBandCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemBandCell"><text:p style:line-height="0.15cm"/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="ItemBottomCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemBottomCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemBottomCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemBottomCell"><text:p style:line-height="0.15cm"/></table:table-cell><table:table-cell table:style-name="ItemBottomCell"><text:p style:line-height="0.15cm"/></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="Note">Hypothetical inspection-and-return dispatch, not a sale. Confirm the actual movement and applicable tax treatment.</text:p>
      <text:p text:style-name="Note">For movement that is a supply, enter the applicable component rates and amounts; these manual files do not calculate them.</text:p>
      <text:p text:style-name="Note">Review applicable copy labels and movement authorization separately.</text:p>
      <text:p text:style-name="Note">Word amounts are manual. Check line amounts and totals after every edit.</text:p>
      <text:p text:style-name="Footer">OnlineBiller | Original English resource | Blank template</text:p>
    </office:text>
  </office:body>
</office:document>