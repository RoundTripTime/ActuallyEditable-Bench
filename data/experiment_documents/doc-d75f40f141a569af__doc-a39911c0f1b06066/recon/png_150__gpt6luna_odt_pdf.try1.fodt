<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
 xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
 office:mimetype="application/vnd.oasis.opendocument.text"
 office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:color="#000000"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:font-size="26pt" fo:margin-top="0cm" fo:margin-bottom="0.25cm" fo:border-bottom="0.04cm solid #4F81BD" fo:padding-bottom="0.18cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="26pt" fo:color="#17365D"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.18cm" fo:margin-bottom="0.22cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="TableHead" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="9pt" fo:font-weight="bold" fo:color="#366092"/>
    </style:style>
    <style:style style:name="MetaLabel" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:font-weight="bold" fo:color="#366092"/>
    </style:style>
    <style:style style:name="MetaValue" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:color="#366092"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.12cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Footer" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="2.2cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="8pt" fo:color="#000000"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="29.7cm" fo:page-height="21cm" fo:margin-left="1.5cm" fo:margin-right="1.5cm" fo:margin-top="1.5cm" fo:margin-bottom="1.5cm" style:print-orientation="landscape"/>
    </style:page-layout>
    <style:style style:name="MetaTable" style:family="table">
      <style:table-properties style:width="26.7cm" table:align="margins" fo:margin-top="0cm" fo:margin-bottom="0.55cm"/>
    </style:style>
    <style:style style:name="MetaCol1" style:family="table-column">
      <style:table-column-properties style:column-width="13.35cm"/>
    </style:style>
    <style:style style:name="MetaCol2" style:family="table-column">
      <style:table-column-properties style:column-width="13.35cm"/>
    </style:style>
    <style:style style:name="MetaCell" style:family="table-cell">
      <style:table-cell-properties fo:padding-left="0.2cm" fo:padding-right="0.15cm" fo:padding-top="0.05cm" fo:padding-bottom="0.05cm" style:vertical-align="middle" fo:border-top="0.03cm solid #4F81BD"/>
    </style:style>
    <style:style style:name="MetaShade" style:family="table-cell">
      <style:table-cell-properties fo:padding-left="0.2cm" fo:padding-right="0.15cm" fo:padding-top="0.05cm" fo:padding-bottom="0.05cm" style:vertical-align="middle" fo:border-top="0.03cm solid #4F81BD" fo:background-color="#D5E0EF"/>
    </style:style>
    <style:style style:name="ItemTable" style:family="table">
      <style:table-properties style:width="26.7cm" table:align="margins" fo:margin-top="0cm" fo:margin-bottom="0.55cm"/>
    </style:style>
    <style:style style:name="ItemCol1" style:family="table-column">
      <style:table-column-properties style:column-width="6.72cm"/>
    </style:style>
    <style:style style:name="ItemCol2" style:family="table-column">
      <style:table-column-properties style:column-width="4.2cm"/>
    </style:style>
    <style:style style:name="ItemCol3" style:family="table-column">
      <style:table-column-properties style:column-width="4.2cm"/>
    </style:style>
    <style:style style:name="ItemCol4" style:family="table-column">
      <style:table-column-properties style:column-width="5.25cm"/>
    </style:style>
    <style:style style:name="ItemCol5" style:family="table-column">
      <style:table-column-properties style:column-width="6.33cm"/>
    </style:style>
    <style:style style:name="ItemHeadCell" style:family="table-cell">
      <style:table-cell-properties fo:padding-left="0.2cm" fo:padding-right="0.1cm" fo:padding-top="0.05cm" fo:padding-bottom="0.12cm" style:vertical-align="middle" fo:border-top="0.03cm solid #4F81BD" fo:border-bottom="0.03cm solid #4F81BD"/>
    </style:style>
    <style:style style:name="ItemCell" style:family="table-cell">
      <style:table-cell-properties fo:padding-left="0.1cm" fo:padding-right="0.1cm" fo:padding-top="0.1cm" fo:padding-bottom="0.1cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="ItemShade" style:family="table-cell">
      <style:table-cell-properties fo:padding-left="0.1cm" fo:padding-right="0.1cm" fo:padding-top="0.1cm" fo:padding-bottom="0.1cm" style:vertical-align="middle" fo:background-color="#D5E0EF"/>
    </style:style>
    <style:style style:name="ItemRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.62cm"/>
    </style:style>
    <style:style style:name="ItemRowGap" style:family="table-row">
      <style:table-row-properties style:row-height="0.58cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">Delivery Challan</text:p>
      <text:p text:style-name="Subtitle">BLANK TEMPLATE | Currency: INR</text:p>
      <table:table table:name="Details" table:style-name="MetaTable">
        <table:table-column table:style-name="MetaCol1"/>
        <table:table-column table:style-name="MetaCol2"/>
        <table:table-row>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="MetaLabel">Consignor / GSTIN</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="MetaValue">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaShade"><text:p text:style-name="MetaLabel">Consignee / GSTIN or UIN</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaShade"><text:p text:style-name="MetaValue">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="MetaLabel">Challan / date</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="MetaValue">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaShade"><text:p text:style-name="MetaLabel">Dispatch / delivery addresses</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaShade"><text:p text:style-name="MetaValue">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="MetaLabel">Purpose / transport</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="MetaValue">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaShade"><text:p text:style-name="MetaLabel">Place of supply</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaShade"><text:p text:style-name="MetaValue">________________________________________</text:p></table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="MetaLabel">Signature</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="MetaValue">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaShade"><text:p text:style-name="MetaLabel">Receipt acknowledgment</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaShade"><text:p text:style-name="MetaValue">________________________________________</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <table:table table:name="LineItems" table:style-name="ItemTable">
        <table:table-column table:style-name="ItemCol1"/>
        <table:table-column table:style-name="ItemCol2"/>
        <table:table-column table:style-name="ItemCol3"/>
        <table:table-column table:style-name="ItemCol4"/>
        <table:table-column table:style-name="ItemCol5"/>
        <table:table-row>
          <table:table-cell table:style-name="ItemHeadCell"><text:p text:style-name="TableHead">HSN / description</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHeadCell"><text:p text:style-name="TableHead">Quantity / unit</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHeadCell"><text:p text:style-name="TableHead">Taxable value (INR)</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHeadCell"><text:p text:style-name="TableHead">Applicable tax rates</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHeadCell"><text:p text:style-name="TableHead">Component amounts (INR)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ItemRow">
          <table:table-cell table:style-name="ItemShade"/>
          <table:table-cell table:style-name="ItemShade"/>
          <table:table-cell table:style-name="ItemShade"/>
          <table:table-cell table:style-name="ItemShade"/>
          <table:table-cell table:style-name="ItemShade"/>
        </table:table-row>
        <table:table-row table:style-name="ItemRowGap">
          <table:table-cell table:style-name="ItemCell"/>
          <table:table-cell table:style-name="ItemCell"/>
          <table:table-cell table:style-name="ItemCell"/>
          <table:table-cell table:style-name="ItemCell"/>
          <table:table-cell table:style-name="ItemCell"/>
        </table:table-row>
        <table:table-row table:style-name="ItemRow">
          <table:table-cell table:style-name="ItemShade"/>
          <table:table-cell table:style-name="ItemShade"/>
          <table:table-cell table:style-name="ItemShade"/>
          <table:table-cell table:style-name="ItemShade"/>
          <table:table-cell table:style-name="ItemShade"/>
        </table:table-row>
        <table:table-row table:style-name="ItemRowGap">
          <table:table-cell table:style-name="ItemCell"/>
          <table:table-cell table:style-name="ItemCell"/>
          <table:table-cell table:style-name="ItemCell"/>
          <table:table-cell table:style-name="ItemCell"/>
          <table:table-cell table:style-name="ItemCell"/>
        </table:table-row>
        <table:table-row table:style-name="ItemRow">
          <table:table-cell table:style-name="ItemShade"/>
          <table:table-cell table:style-name="ItemShade"/>
          <table:table-cell table:style-name="ItemShade"/>
          <table:table-cell table:style-name="ItemShade"/>
          <table:table-cell table:style-name="ItemShade"/>
        </table:table-row>
        <table:table-row table:style-name="ItemRowGap">
          <table:table-cell table:style-name="ItemCell"/>
          <table:table-cell table:style-name="ItemCell"/>
          <table:table-cell table:style-name="ItemCell"/>
          <table:table-cell table:style-name="ItemCell"/>
          <table:table-cell table:style-name="ItemCell"/>
        </table:table-row>
        <table:table-row table:style-name="ItemRow">
          <table:table-cell table:style-name="ItemShade"/>
          <table:table-cell table:style-name="ItemShade"/>
          <table:table-cell table:style-name="ItemShade"/>
          <table:table-cell table:style-name="ItemShade"/>
          <table:table-cell table:style-name="ItemShade"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Note">Hypothetical inspection-and-return dispatch, not a sale. Confirm the actual movement and applicable tax treatment.</text:p>
      <text:p text:style-name="Note">For movement that is a supply, enter the applicable component rates and amounts; these manual files do not calculate them.</text:p>
      <text:p text:style-name="Note">Review applicable copy labels and movement authorization separately.</text:p>
      <text:p text:style-name="Note">Word amounts are manual. Check line amounts and totals after every edit.</text:p>
      <text:p text:style-name="Footer">OnlineBiller | Original English resource | Blank template</text:p>
    </office:text>
  </office:body>
</office:document>