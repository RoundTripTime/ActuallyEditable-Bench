<?xml version="1.0" encoding="UTF-8"?>
<office:document
    xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
    xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
    xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
    xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
    office:mimetype="application/vnd.oasis.opendocument.text"
    office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:default-style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties
          fo:page-width="21cm"
          fo:page-height="29.7cm"
          fo:margin-left="2.5cm"
          fo:margin-right="2.5cm"
          fo:margin-top="2cm"
          fo:margin-bottom="2cm"
          style:print-orientation="portrait"/>
    </style:page-layout>
    <style:style style:name="Recipient" style:family="paragraph">
      <style:paragraph-properties
          fo:break-before="page"
          fo:margin-left="0.8cm"
          fo:margin-top="0.7cm"
          fo:margin-bottom="2.5cm"/>
    </style:style>
    <style:style style:name="TableStyle" style:family="table">
      <style:table-properties style:width="15.6cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ColNarrow" style:family="table-column">
      <style:table-column-properties style:column-width="0.75cm"/>
    </style:style>
    <style:style style:name="ColLabel" style:family="table-column">
      <style:table-column-properties style:column-width="5.25cm"/>
    </style:style>
    <style:style style:name="ColEntry" style:family="table-column">
      <style:table-column-properties style:column-width="9.6cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties
          fo:border="0.5pt solid #000000"
          fo:padding="0.12cm"
          style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellTop" style:family="table-cell">
      <style:table-cell-properties
          fo:border="0.5pt solid #000000"
          fo:padding="0.12cm"
          style:vertical-align="top"/>
    </style:style>
    <style:style style:name="RowDate" style:family="table-row">
      <style:table-row-properties style:row-height="0.7cm"/>
    </style:style>
    <style:style style:name="RowShort" style:family="table-row">
      <style:table-row-properties style:row-height="0.95cm"/>
    </style:style>
    <style:style style:name="RowBlank" style:family="table-row">
      <style:table-row-properties style:row-height="0.65cm"/>
    </style:style>
    <style:style style:name="RowProperty" style:family="table-row">
      <style:table-row-properties style:row-height="8.65cm"/>
    </style:style>
    <style:style style:name="RowUse" style:family="table-row">
      <style:table-row-properties style:row-height="2.05cm"/>
    </style:style>
    <style:style style:name="RowCertification" style:family="table-row">
      <style:table-row-properties style:row-height="1.95cm"/>
    </style:style>
    <style:style style:name="PZero" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="PDate" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="PTopLabel" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="PSerial" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0.15cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="PStatement" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.8cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="PDateBelow" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="1.9cm" fo:margin-top="1.1cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="PSignature" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-right="1.9cm" fo:margin-top="0.25cm" fo:margin-bottom="0cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Recipient">福山市長　様</text:p>
      <table:table table:name="Form" table:style-name="TableStyle">
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColEntry"/>
        <table:table-row table:style-name="RowDate">
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="PZero"/></table:table-cell>
          <table:covered-table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="PDate">年　　月　　日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="3"><text:p text:style-name="PZero"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="PZero"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="PZero"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:covered-table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="PZero"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="PZero"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:covered-table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="PTopLabel">理　事　長　の　名　前</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="PZero"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowBlank">
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="PZero"/></table:table-cell>
          <table:covered-table-cell table:style-name="Cell"/>
          <table:covered-table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="RowProperty">
          <table:table-cell table:style-name="CellTop" table:number-columns-spanned="3"><text:p text:style-name="PTopLabel">[証明を受けようとする不動産]</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="CellTop"/>
          <table:covered-table-cell table:style-name="CellTop"/>
        </table:table-row>
        <table:table-row table:style-name="RowUse">
          <table:table-cell table:style-name="CellTop" table:number-columns-spanned="3"><text:p text:style-name="PTopLabel">[具体的用途]</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="CellTop"/>
          <table:covered-table-cell table:style-name="CellTop"/>
        </table:table-row>
        <table:table-row table:style-name="RowCertification">
          <table:table-cell table:style-name="CellTop" table:number-columns-spanned="3">
            <text:p text:style-name="PTopLabel">[証明事項]</text:p>
            <text:p text:style-name="PZero">　上記の不動産が、社会福祉法第２条第１項に規定する社会福祉事業の用に供している</text:p>
            <text:p text:style-name="PZero">　こと。</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="CellTop"/>
          <table:covered-table-cell table:style-name="CellTop"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PSerial">福　証　福　総　第　　号</text:p>
      <text:p text:style-name="PStatement">上記のとおり相違ないことを証明します。</text:p>
      <text:p text:style-name="PDateBelow">年　　月　　日</text:p>
      <text:p text:style-name="PSignature">福山市長　枝　広　直　幹</text:p>
    </office:text>
  </office:body>
</office:document>