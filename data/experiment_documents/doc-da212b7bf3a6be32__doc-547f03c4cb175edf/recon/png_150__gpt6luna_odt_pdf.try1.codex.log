  <office:body>
    <office:text>
      <text:p text:style-name="P">様式第37</text:p>
      <text:p text:style-name="Title">特定第一種国内希少野生動植物種に関する特定国内種事業廃止届</text:p>
      <text:p text:style-name="RightDate">年　月　日</text:p>
      <text:p text:style-name="P">○○環境局長　殿</text:p>
      <text:p text:style-name="P">農林水産大臣　殿</text:p>
      <text:p text:style-name="P">届出者</text:p>
      <text:p text:style-name="P">□ 個人の場合</text:p>
      <table:table table:name="個人の場合">
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="ColWide"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>氏　　名</text:p></table:table-cell>
