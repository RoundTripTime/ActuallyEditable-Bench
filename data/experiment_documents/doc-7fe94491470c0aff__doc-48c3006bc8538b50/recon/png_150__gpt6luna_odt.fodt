        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Label"><text:p>만화내용 요약문</text:p></table:table-cell><table:table-cell table:style-name="Label"><text:p>만화 제목</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p/></table:table-cell><table:covered-table-cell/></table:table-row>
