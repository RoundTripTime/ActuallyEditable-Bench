<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:default-style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" fo:margin-left="28.5mm" fo:margin-right="28.5mm" fo:margin-top="35mm" fo:margin-bottom="35mm" style:print-orientation="portrait"/>
    </style:page-layout>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:text-align="center" fo:margin-right="45mm" fo:margin-top="0mm" fo:margin-bottom="2mm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="PhotoCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="2mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="InfoCell" style:family="table-cell">
      <style:table-cell-properties fo:padding-left="3mm" fo:padding-right="0mm" fo:padding-top="1mm" fo:padding-bottom="1mm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="PhotoLabel" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="1.3" fo:margin-top="0mm" fo:margin-bottom="7mm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="PhotoNote" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="1.3" fo:margin-top="0mm" fo:margin-bottom="3mm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="InfoLabel" style:family="paragraph">
      <style:paragraph-properties fo:line-height="5mm" fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="InputLine" style:family="paragraph">
      <style:paragraph-properties fo:line-height="5mm" fo:margin-top="0mm" fo:margin-bottom="1mm" fo:border-bottom="0.5pt solid #000000"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:line-height="5mm" fo:margin-top="1mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="153mm"/>
    </style:style>
    <style:style style:name="PhotoColumn" style:family="table-column">
      <style:table-column-properties style:column-width="108mm"/>
    </style:style>
    <style:style style:name="InfoColumn" style:family="table-column">
      <style:table-column-properties style:column-width="45mm"/>
    </style:style>
    <style:style style:name="FormRow" style:family="table-row">
      <style:table-row-properties style:row-height="68mm" style:use-optimal-row-height="false"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">工事中写真台帳</text:p>
      <table:table table:name="PhotoLedger" table:style-name="FormTable">
        <table:table-column table:style-name="PhotoColumn"/>
        <table:table-column table:style-name="InfoColumn"/>
        <table:table-row table:style-name="FormRow">
          <table:table-cell table:style-name="PhotoCell">
            <text:p text:style-name="PhotoLabel">工事箇所の写真</text:p>
            <text:p text:style-name="PhotoNote">※工事箇所が広範囲にわたる場合は、主要な</text:p>
            <text:p text:style-name="PhotoNote">工事箇所の写真を貼り付けてください。</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InfoCell">
            <text:p text:style-name="InfoLabel">（申請者）</text:p>
            <text:p text:style-name="InputLine"/>
            <text:p text:style-name="InfoLabel">（工事箇所）</text:p>
            <text:p text:style-name="InputLine"/>
            <text:p text:style-name="InputLine"/>
            <text:p text:style-name="InputLine"/>
            <text:p text:style-name="InfoLabel">（工事内容）</text:p>
            <text:p text:style-name="InputLine"/>
            <text:p text:style-name="InputLine"/>
            <text:p text:style-name="InputLine"/>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:table-cell table:style-name="PhotoCell">
            <text:p text:style-name="PhotoLabel">工事箇所の写真</text:p>
            <text:p text:style-name="PhotoNote">※工事箇所が広範囲にわたる場合は、主要な</text:p>
            <text:p text:style-name="PhotoNote">工事箇所の写真を貼り付けてください。</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InfoCell">
            <text:p text:style-name="InfoLabel">（工事箇所）</text:p>
            <text:p text:style-name="InputLine"/>
            <text:p text:style-name="InputLine"/>
            <text:p text:style-name="InputLine"/>
            <text:p text:style-name="InfoLabel">（工事内容）</text:p>
            <text:p text:style-name="InputLine"/>
            <text:p text:style-name="InputLine"/>
            <text:p text:style-name="InputLine"/>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:table-cell table:style-name="PhotoCell">
            <text:p text:style-name="PhotoLabel">工事箇所の写真</text:p>
            <text:p text:style-name="PhotoNote">※工事箇所が広範囲にわたる場合は、主要な</text:p>
            <text:p text:style-name="PhotoNote">工事箇所の写真を貼り付けてください。</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InfoCell">
            <text:p text:style-name="InfoLabel">（工事箇所）</text:p>
            <text:p text:style-name="InputLine"/>
            <text:p text:style-name="InputLine"/>
            <text:p text:style-name="InputLine"/>
            <text:p text:style-name="InfoLabel">（工事内容）</text:p>
            <text:p text:style-name="InputLine"/>
            <text:p text:style-name="InputLine"/>
            <text:p text:style-name="InputLine"/>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Note">※工事箇所が複数にわたる等、状況に応じて必要な部数を作成してください。</text:p>
    </office:text>
  </office:body>
</office:document>