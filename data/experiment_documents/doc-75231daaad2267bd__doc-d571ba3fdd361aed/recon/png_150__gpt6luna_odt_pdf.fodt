<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:text-properties fo:font-size="11pt"/>
      <style:paragraph-properties fo:line-height="0.45cm" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:default-style>
    <style:style style:name="PageTitle" style:family="paragraph" style:master-page-name="Standard">
      <style:paragraph-properties fo:break-before="page" fo:text-align="center" fo:line-height="0.5cm" fo:margin-top="0cm" fo:margin-bottom="0.15cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="PhotoHeading" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="0.5cm" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="PhotoGap" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="0.35cm" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="PhotoNote" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="0.6cm" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="FieldLabel" style:family="paragraph">
      <style:paragraph-properties fo:line-height="0.42cm" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="FieldRuleFirst" style:family="paragraph">
      <style:paragraph-properties fo:line-height="0.42cm" fo:margin-top="0.3cm" fo:margin-bottom="0cm" fo:border-bottom="0.5pt solid #000000"/>
    </style:style>
    <style:style style:name="FieldRule" style:family="paragraph">
      <style:paragraph-properties fo:line-height="0.42cm" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:border-bottom="0.5pt solid #000000"/>
    </style:style>
    <style:style style:name="PhotoCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.12cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="FieldCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.12cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="15.55cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="PhotoColumn" style:family="table-column">
      <style:table-column-properties style:column-width="10.75cm"/>
    </style:style>
    <style:style style:name="FieldColumn" style:family="table-column">
      <style:table-column-properties style:column-width="4.8cm"/>
    </style:style>
    <style:style style:name="FormRow" style:family="table-row">
      <style:table-row-properties style:row-height="6.95cm"/>
    </style:style>
    <style:style style:name="FooterNote" style:family="paragraph">
      <style:paragraph-properties fo:line-height="0.4cm" fo:text-align="left" fo:margin-top="0.1cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="2.7cm" fo:margin-right="2.2cm" fo:margin-top="4.1cm" fo:margin-bottom="3.2cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageTitle">工事中写真台帳</text:p>
      <table:table table:name="PhotoLedger" table:style-name="FormTable">
        <table:table-column table:style-name="PhotoColumn"/>
        <table:table-column table:style-name="FieldColumn"/>
        <table:table-row table:style-name="FormRow">
          <table:table-cell table:style-name="PhotoCell">
            <text:p text:style-name="PhotoHeading">工事箇所の写真</text:p>
            <text:p text:style-name="PhotoGap"/>
            <text:p text:style-name="PhotoNote">※工事箇所が広範囲にわたる場合は、主要な</text:p>
            <text:p text:style-name="PhotoNote">工事箇所の写真を貼り付けてください。</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FieldCell">
            <text:p text:style-name="FieldLabel">（申請者）</text:p>
            <text:p text:style-name="FieldRuleFirst"/>
            <text:p text:style-name="FieldLabel">（工事箇所）</text:p>
            <text:p text:style-name="FieldRuleFirst"/>
            <text:p text:style-name="FieldRule"/>
            <text:p text:style-name="FieldRule"/>
            <text:p text:style-name="FieldLabel">（工事内容）</text:p>
            <text:p text:style-name="FieldRuleFirst"/>
            <text:p text:style-name="FieldRule"/>
            <text:p text:style-name="FieldRule"/>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:table-cell table:style-name="PhotoCell">
            <text:p text:style-name="PhotoHeading">工事箇所の写真</text:p>
            <text:p text:style-name="PhotoGap"/>
            <text:p text:style-name="PhotoNote">※工事箇所が広範囲にわたる場合は、主要な</text:p>
            <text:p text:style-name="PhotoNote">工事箇所の写真を貼り付けてください。</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FieldCell">
            <text:p text:style-name="FieldLabel">（工事箇所）</text:p>
            <text:p text:style-name="FieldRuleFirst"/>
            <text:p text:style-name="FieldRule"/>
            <text:p text:style-name="FieldRule"/>
            <text:p text:style-name="FieldLabel">（工事内容）</text:p>
            <text:p text:style-name="FieldRuleFirst"/>
            <text:p text:style-name="FieldRule"/>
            <text:p text:style-name="FieldRule"/>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:table-cell table:style-name="PhotoCell">
            <text:p text:style-name="PhotoHeading">工事箇所の写真</text:p>
            <text:p text:style-name="PhotoGap"/>
            <text:p text:style-name="PhotoNote">※工事箇所が広範囲にわたる場合は、主要な</text:p>
            <text:p text:style-name="PhotoNote">工事箇所の写真を貼り付けてください。</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FieldCell">
            <text:p text:style-name="FieldLabel">（工事箇所）</text:p>
            <text:p text:style-name="FieldRuleFirst"/>
            <text:p text:style-name="FieldRule"/>
            <text:p text:style-name="FieldRule"/>
            <text:p text:style-name="FieldLabel">（工事内容）</text:p>
            <text:p text:style-name="FieldRuleFirst"/>
            <text:p text:style-name="FieldRule"/>
            <text:p text:style-name="FieldRule"/>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="FooterNote">※工事箇所が複数にわたる等、状況に応じて必要な部数を作成してください。</text:p>
    </office:text>
  </office:body>
</office:document>