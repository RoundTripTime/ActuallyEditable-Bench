          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightText">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightText">円</text:p></table:table-cell>
