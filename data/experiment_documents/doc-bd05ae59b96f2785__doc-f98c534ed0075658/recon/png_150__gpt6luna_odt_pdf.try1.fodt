    </style:style>
    <style:style style:name="MainLine" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.35cm" fo:margin-bottom="0.35cm" fo:line-height="0.55cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="12pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
