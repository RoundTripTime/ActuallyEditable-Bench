<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin="0mm" fo:line-height="5mm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="AppendixLabel" style:family="paragraph">
      <style:paragraph-properties fo:margin="0mm" fo:line-height="5mm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="HeadingLine" style:family="paragraph">
      <style:paragraph-properties fo:margin="0mm" fo:margin-top="1mm" fo:margin-bottom="7mm" fo:line-height="6mm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="TableText" style:family="paragraph">
      <style:paragraph-properties fo:margin="0mm" fo:line-height="5mm" fo:text-align="center"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="LeftTableText" style:family="paragraph">
      <style:paragraph-properties fo:margin="0mm" fo:line-height="5mm" fo:text-align="start"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="CurrencyText" style:family="paragraph">
      <style:paragraph-properties fo:margin="0mm" fo:line-height="5mm" fo:text-align="end"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" fo:margin-left="27mm" fo:margin-right="27mm" fo:margin-top="24mm" fo:margin-bottom="25mm" style:print-orientation="portrait"/>
    </style:page-layout>
    <style:style style:name="BudgetTable" style:family="table">
      <style:table-properties style:width="156mm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="29mm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="34mm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="34mm"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties style:column-width="37mm"/>
    </style:style>
    <style:style style:name="Col5" style:family="table-column">
      <style:table-column-properties style:column-width="22mm"/>
    </style:style>
    <style:style style:name="GridCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.5mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="1mm" style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">別紙２</text:p>
      <text:p text:style-name="HeadingLine">　　　令和　　　　年度　　　　老人クラブ歳入予算書</text:p>
      <table:table table:name="老人クラブ歳入予算書" table:style-name="BudgetTable">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-column table:style-name="Col5"/>
        <table:table-row>
          <table:table-cell table:style-name="HeaderCell" table:number-columns-spanned="5">
            <text:p text:style-name="TableText">老　人　ク　ラ　ブ　歳　入　予　算　書</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="LeftTableText">項　目</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="LeftTableText">本年度予算額</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="LeftTableText">前年度予算額</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="LeftTableText">比較増減額（△）</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="LeftTableText">備　考</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CurrencyText">円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CurrencyText">円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CurrencyText">円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row table:number-rows-repeated="25">
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">計</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CurrencyText">円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CurrencyText">円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CurrencyText">円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>