<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0.06in" fo:line-height="100%"/>
      <style:text-properties fo:font-size="11pt" style:font-size-asian="11pt" fo:font-weight="normal"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.03in" fo:margin-bottom="0.06in" fo:line-height="110%"/>
      <style:text-properties fo:font-size="11pt" style:font-size-asian="11pt"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0in" fo:margin-bottom="0in"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.22in" fo:margin-bottom="0.52in"/>
      <style:text-properties fo:font-size="15pt" style:font-size-asian="15pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.18in" fo:margin-bottom="0.12in"/>
      <style:text-properties fo:font-size="13pt" style:font-size-asian="13pt"/>
    </style:style>
    <style:style style:name="PanelHead" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.03in" fo:margin-bottom="0.03in"/>
      <style:text-properties fo:font-size="12pt" style:font-size-asian="12pt"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.10in" fo:margin-bottom="0.20in"/>
      <style:text-properties fo:font-size="11pt" style:font-size-asian="11pt" fo:font-style="italic"/>
    </style:style>
    <style:style style:name="Centered" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="11pt" style:font-size-asian="11pt"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0in"/>
      <style:text-properties fo:font-size="10pt" style:font-size-asian="10pt"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="7.02in" table:align="center"/>
    </style:style>
    <style:style style:name="ScheduleTable" style:family="table">
      <style:table-properties style:width="7.02in" table:align="center"/>
    </style:style>
    <style:style style:name="DiagramTable" style:family="table">
      <style:table-properties style:width="6.7in" table:align="center"/>
    </style:style>
    <style:style style:name="RoleTable" style:family="table">
      <style:table-properties style:width="6.7in" table:align="center"/>
    </style:style>
    <style:style style:name="ColThird" style:family="table-column">
      <style:table-column-properties style:column-width="2.34in"/>
    </style:style>
    <style:style style:name="ColScheduleLabel" style:family="table-column">
      <style:table-column-properties style:column-width="2.02in"/>
    </style:style>
    <style:style style:name="ColMonth" style:family="table-column">
      <style:table-column-properties style:column-width="0.50in"/>
    </style:style>
    <style:style style:name="ColDiagram" style:family="table-column">
      <style:table-column-properties style:column-width="1.34in"/>
    </style:style>
    <style:style style:name="ColRole1" style:family="table-column">
      <style:table-column-properties style:column-width="1.55in"/>
    </style:style>
    <style:style style:name="ColRole2" style:family="table-column">
      <style:table-column-properties style:column-width="1.02in"/>
    </style:style>
    <style:style style:name="ColRole3" style:family="table-column">
      <style:table-column-properties style:column-width="4.13in"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.8pt solid #000000" fo:padding="0.08in" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="TightCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.8pt solid #000000" fo:padding="0.03in" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="BoxCell" style:family="table-cell">
      <style:table-cell-properties fo:border="1pt solid #000000" fo:padding="0.12in" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="BlankCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.8pt solid #000000" fo:padding="0.08in" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="RowShort" style:family="table-row">
      <style:table-row-properties style:row-height="0.43in" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RowMedium" style:family="table-row">
      <style:table-row-properties style:row-height="0.72in" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RowHistory" style:family="table-row">
      <style:table-row-properties style:row-height="2.20in" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RowLarge" style:family="table-row">
      <style:table-row-properties style:row-height="3.05in" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RowProduct" style:family="table-row">
      <style:table-row-properties style:row-height="1.45in" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RowBullet" style:family="table-row">
      <style:table-row-properties style:row-height="0.72in" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RowMonth" style:family="table-row">
      <style:table-row-properties style:row-height="0.24in" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RowSchedule" style:family="table-row">
      <style:table-row-properties style:row-height="0.27in" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RowChart" style:family="table-row">
      <style:table-row-properties style:row-height="0.48in" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RowRole" style:family="table-row">
      <style:table-row-properties style:row-height="0.34in" style:use-optimal-row-height="false"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="8.27in" fo:page-height="11.69in" fo:margin-top="0.48in" fo:margin-bottom="0.48in" fo:margin-left="0.62in" fo:margin-right="0.62in" style:print-orientation="portrait"/>
    </style:page-layout-properties>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="DefaultPage" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Small">様式１別紙</text:p>
      <text:p text:style-name="Title">大崎町地場産品創出等支援事業補助金　企画提案書</text:p>
      <text:p text:style-name="Section">１．提案者について</text:p>
      <table:table table:name="ProposerBusiness" table:style-name="FormTable">
        <table:table-column table:style-name="ColThird"/>
        <table:table-column table:style-name="ColThird"/>
        <table:table-column table:style-name="ColThird"/>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="PanelHead">①提案者の事業について</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowLarge">
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3">
            <text:p text:style-name="Note">※提案者が通常行っている事業概要をご記入ください。</text:p>
            <text:p text:style-name="Note">（事業概要が記載されているパンフレット等の添付で可）</text:p>
            <text:p text:style-name="Body"> </text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="PanelHead">②提案する商品等の実績について</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowHistory">
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3">
            <text:p text:style-name="Note">※売上実績や表彰歴があれば、ご記入ください。（新規商品等の場合は、記入不要）</text:p>
            <text:p text:style-name="Body"> </text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Section">２．提案内容について</text:p>
      <table:table table:name="ProposalOverview" table:style-name="FormTable">
        <table:table-column table:style-name="ColThird"/>
        <table:table-column table:style-name="ColThird"/>
        <table:table-column table:style-name="ColThird"/>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="PanelHead">①提案する商品等について</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowProduct">
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3">
            <text:p text:style-name="Note">※どのような事業を行うのか事業の全体像やスキーム図、想定する返礼品をご記入下さい。</text:p>
            <text:p text:style-name="Body">【提案する開発商品や生産性増強事業の概要】</text:p>
            <text:p text:style-name="Body"> </text:p>
            <text:p text:style-name="Body">（具体的にどのようなことを行い、どのような効果が得られるか等）</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>

      <text:p text:style-name="PageBreak"/>
      <table:table table:name="ProductDetails" table:style-name="FormTable">
        <table:table-column table:style-name="ColThird"/>
        <table:table-column table:style-name="ColThird"/>
        <table:table-column table:style-name="ColThird"/>
        <table:table-row table:style-name="RowProduct">
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3">
            <text:p text:style-name="Body">【返礼品名】</text:p>
            <text:p text:style-name="Body"> </text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="PanelHead">【商品へのこだわり、開発の目標】</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowBullet">
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Body">・独創性、新規性</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowBullet">
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Body">・市場性、優位性</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowBullet">
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Body">・成長の可能性</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowBullet">
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Body">・経済波及効果</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowBullet">
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Body">・ふるさと納税返礼品としての可能性</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="PanelHead">【商品の価格設定と収益性】</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowBullet">
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Body">・収益性、現実性</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PanelHead">②事業スケジュール</text:p>
      <table:table table:name="ScheduleTop" table:style-name="ScheduleTable">
        <table:table-column table:style-name="ColScheduleLabel"/>
        <table:table-column table:style-name="ColMonth"/>
        <table:table-column table:style-name="ColMonth"/>
        <table:table-column table:style-name="ColMonth"/>
        <table:table-column table:style-name="ColMonth"/>
        <table:table-column table:style-name="ColMonth"/>
        <table:table-column table:style-name="ColMonth"/>
        <table:table-column table:style-name="ColMonth"/>
        <table:table-column table:style-name="ColMonth"/>
        <table:table-column table:style-name="ColMonth"/>
        <table:table-column table:style-name="ColMonth"/>
        <table:table-row table:style-name="RowMonth">
          <table:table-cell table:style-name="TightCell"><text:p text:style-name="Centered">実施項目</text:p></table:table-cell>
          <table:table-cell table:style-name="TightCell"><text:p text:style-name="Centered">月</text:p></table:table-cell>
          <table:table-cell table:style-name="TightCell"><text:p text:style-name="Centered">月</text:p></table:table-cell>
          <table:table-cell table:style-name="TightCell"><text:p text:style-name="Centered">月</text:p></table:table-cell>
          <table:table-cell table:style-name="TightCell"><text:p text:style-name="Centered">月</text:p></table:table-cell>
          <table:table-cell table:style-name="TightCell"><text:p text:style-name="Centered">月</text:p></table:table-cell>
          <table:table-cell table:style-name="TightCell"><text:p text:style-name="Centered">月</text:p></table:table-cell>
          <table:table-cell table:style-name="TightCell"><text:p text:style-name="Centered">月</text:p></table:table-cell>
          <table:table-cell table:style-name="TightCell"><text:p text:style-name="Centered">月</text:p></table:table-cell>
          <table:table-cell table:style-name="TightCell"><text:p text:style-name="Centered">月</text:p></table:table-cell>
          <table:table-cell table:style-name="TightCell"><text:p text:style-name="Centered">月</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowSchedule">
          <table:table-cell table:style-name="TightCell"><text:p text:style-name="Small"> </text:p></table:table-cell>
          <table:table-cell table:style-name="TightCell"><text:p text:style-name="Centered"> </text:p></table:table-cell>
          <table:table-cell table:style-name="TightCell"><text:p text:style-name="Centered"> </text:p></table:table-cell>
          <table:table-cell table:style-name="TightCell"><text:p text:style-name="Centered"> </text:p></table:table-cell>
          <table:table-cell table:style-name="TightCell"><text:p text:style-name="Centered">→</text:p></table:table-cell>
          <table:table-cell table:style-name="TightCell"><text:p text:style-name="Centered"> </text:p></table:table-cell>
          <table:table-cell table:style-name="TightCell"><text:p text:style-name="Centered"> </text:p></table:table-cell>
          <table:table-cell table:style-name="TightCell"><text:p text:style-name="Centered"> </text:p></table:table-cell>
          <table:table-cell table:style-name="TightCell"><text:p text:style-name="Centered"> </text:p></table:table-cell>
          <table:table-cell table:style-name="TightCell"><text:p text:style-name="Centered"> </text:p></table:table-cell>
          <table:table-cell table:style-name="TightCell"><text:p text:style-name="Centered"> </text:p></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="PageBreak"/>
      <table:table table:name="ScheduleContinuation" table:style-name="ScheduleTable">
        <table:table-column table:style-name="ColScheduleLabel"/>
        <table:table-column table:style-name="ColMonth"/>
        <table:table-column table:style-name="ColMonth"/>
        <table:table-column table:style-name="ColMonth"/>
        <table:table-column table:style-name="ColMonth"/>
        <table:table-column table:style-name="ColMonth"/>
        <table:table-column table:style-name="ColMonth"/>
        <table:table-column table:style-name="ColMonth"/>
        <table:table-column table:style-name="ColMonth"/>
        <table:table-column table:style-name="ColMonth"/>
        <table:table-column table:style-name="ColMonth"/>
        <table:table-row table:style-name="RowSchedule">
          <table:table-cell table:style-name="TightCell"><text:p text:style-name="Small"> </text:p></table:table-cell>
          <table:table-cell table:style-name="TightCell"><text:p text:style-name="Centered"> </text:p></table:table-cell>
          <table:table-cell table:style-name="TightCell"><text:p text:style-name="Centered"> </text:p></table:table-cell>
          <table:table-cell table:style-name="TightCell"><text:p text:style-name="Centered"> </text:p></table:table-cell>
