<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:font-size="11pt" fo:line-height="120%"/>
      <style:text-properties fo:font-size="11pt" style:font-name="Noto Sans CJK JP"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.12cm"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0.12cm"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.4cm" fo:margin-bottom="1.2cm"/>
      <style:text-properties fo:font-size="16pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.35cm" fo:margin-bottom="0.25cm"/>
      <style:text-properties fo:font-size="13pt"/>
    </style:style>
    <style:style style:name="Label" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.08cm" fo:margin-bottom="0.08cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Hint" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.2cm" fo:margin-bottom="0.2cm"/>
      <style:text-properties fo:font-size="11pt" fo:font-style="italic"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="A4">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="1.5cm" fo:margin-bottom="1.5cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
    </style:page-layout>
    <style:style style:name="Box" style:family="table">
      <style:table-properties table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ColWide" style:family="table-column">
      <style:table-column-properties fo:column-width="17cm"/>
    </style:style>
    <style:style style:name="ColScheduleLabel" style:family="table-column">
      <style:table-column-properties fo:column-width="6cm"/>
    </style:style>
    <style:style style:name="ColMonth" style:family="table-column">
      <style:table-column-properties fo:column-width="1.1cm"/>
    </style:style>
    <style:style style:name="ColRole1" style:family="table-column">
      <style:table-column-properties fo:column-width="4cm"/>
    </style:style>
    <style:style style:name="ColRole2" style:family="table-column">
      <style:table-column-properties fo:column-width="2.5cm"/>
    </style:style>
    <style:style style:name="ColRole3" style:family="table-column">
      <style:table-column-properties fo:column-width="10.5cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.18cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="CellHead" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.18cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.12cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Tall" style:family="table-row">
      <style:table-row-properties style:min-row-height="6cm"/>
    </style:style>
    <style:style style:name="VeryTall" style:family="table-row">
      <style:table-row-properties style:min-row-height="8cm"/>
    </style:style>
    <style:style style:name="ShortRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.7cm"/>
    </style:style>
    <style:style style:name="ScheduleRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.65cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="A4"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Body">様式１別紙</text:p>
      <text:p text:style-name="Title">大崎町地場産品創出等支援事業補助金　企画提案書</text:p>
      <text:p text:style-name="Section">１．提案者について</text:p>
      <table:table table:name="Proposer" table:style-name="Box">
        <table:table-column table:style-name="ColWide"/>
        <table:table-row>
          <table:table-cell table:style-name="CellHead"><text:p text:style-name="Label">①提案者の事業について</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="VeryTall">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="Hint">※提案者が通常行っている事業概要をご記入ください。</text:p>
            <text:p text:style-name="Hint">(事業概要が記載されているパンフレット等の添付で可)</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellHead"><text:p text:style-name="Label">②提案する商品等の実績について</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="Tall">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="Hint">※売上実績や表彰歴があれば、ご記入ください。（新規商品等の場合は、記入不要）</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Section">２．提案内容について</text:p>
      <table:table table:name="ProductPlan" table:style-name="Box">
        <table:table-column table:style-name="ColWide"/>
        <table:table-row>
          <table:table-cell table:style-name="CellHead"><text:p text:style-name="Label">①提案する商品等について</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="Tall">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="Hint">※どのような事業を行うのか事業の全体像やスキーム図、想定する返礼品をご記入下さい。</text:p>
            <text:p text:style-name="Label">【提案する開発商品や生産性増強事業の概要】</text:p>
            <text:p text:style-name="Body">(具体的にどのようなことを行いどのような効果が得られるか等)</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="PageStart"/>
      <table:table table:name="ProductPlanContinuation" table:style-name="Box">
        <table:table-column table:style-name="ColWide"/>
        <table:table-row table:style-name="VeryTall">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="Label">【返礼品名】</text:p>
            <text:p text:style-name="Body"/>
            <text:p text:style-name="Label">【商品へのこだわり、開発の目標】</text:p>
            <text:p text:style-name="Body">・独創性、新規性</text:p>
            <text:p text:style-name="Body"/>
            <text:p text:style-name="Body">・市場性、優位性</text:p>
            <text:p text:style-name="Body"/>
            <text:p text:style-name="Body">・成長の可能性</text:p>
            <text:p text:style-name="Body"/>
            <text:p text:style-name="Body">・経済波及効果</text:p>
            <text:p text:style-name="Body"/>
            <text:p text:style-name="Body">・ふるさと納税返礼品としての可能性</text:p>
            <text:p text:style-name="Body"/>
            <text:p text:style-name="Label">【商品の価格設定と収益性】</text:p>
            <text:p text:style-name="Body">・収益性、現実性</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellHead"><text:p text:style-name="Label">②事業スケジュール</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="11">
            <table:table table:name="ScheduleTop" table:style-name="Box">
              <table:table-column table:style-name="ColScheduleLabel"/>
              <table:table-column table:style-name="ColMonth" table:number-columns-repeated="10"/>
              <table:table-row table:style-name="ScheduleRow">
                <table:table-cell table:style-name="CellCenter"><text:p>実施項目</text:p></table:table-cell>
                <table:table-cell table:style-name="CellCenter"><text:p>月</text:p></table:table-cell>
                <table:table-cell table:style-name="CellCenter"><text:p>月</text:p></table:table-cell>
                <table:table-cell table:style-name="CellCenter"><text:p>月</text:p></table:table-cell>
                <table:table-cell table:style-name="CellCenter"><text:p>月</text:p></table:table-cell>
                <table:table-cell table:style-name="CellCenter"><text:p>月</text:p></table:table-cell>
                <table:table-cell table:style-name="CellCenter"><text:p>月</text:p></table:table-cell>
                <table:table-cell table:style-name="CellCenter"><text:p>月</text:p></table:table-cell>
                <table:table-cell table:style-name="CellCenter"><text:p>月</text:p></table:table-cell>
                <table:table-cell table:style-name="CellCenter"><text:p>月</text:p></table:table-cell>
                <table:table-cell table:style-name="CellCenter"><text:p>月</text:p></table:table-cell>
              </table:table-row>
              <table:table-row table:style-name="ScheduleRow">
                <table:table-cell table:style-name="Cell"/>
                <table:table-cell table:style-name="Cell"/>
                <table:table-cell table:style-name="Cell"/>
                <table:table-cell table:style-name="Cell"/>
                <table:table-cell table:style-name="CellCenter"><text:p>➜</text:p></table:table-cell>
                <table:table-cell table:style-name="Cell"/>
                <table:table-cell table:style-name="Cell"/>
                <table:table-cell table:style-name="Cell"/>
                <table:table-cell table:style-name="Cell"/>
                <table:table-cell table:style-name="Cell"/>
                <table:table-cell table:style-name="Cell"/>
              </table:table-row>
            </table:table>
          </table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="PageStart"/>
      <table:table table:name="ScheduleContinuation" table:style-name="Box">
        <table:table-column table:style-name="ColScheduleLabel"/>
        <table:table-column table:style-name="ColMonth" table:number-columns-repeated="10"/>
        <table:table-row table:style-name="ScheduleRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="CellCenter"><text:p>➜</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="ScheduleRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="CellCenter"><text:p>➜</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="ScheduleRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="CellCenter"><text:p>⟶</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="ScheduleRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="CellCenter"><text:p>⟶</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="ScheduleRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="CellCenter"><text:p>⟶</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <table:table table:name="Organization" table:style-name="Box">
        <table:table-column table:style-name="ColRole1"/>
        <table:table-column table:style-name="ColRole2"/>
        <table:table-column table:style-name="ColRole3"/>
        <table:table-row>
          <table:table-cell table:style-name="CellHead" table:number-columns-spanned="3"><text:p text:style-name="Label">③事業の運営体制・連携機関などについて　※別添可</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="Tall">
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3">
            <text:p text:style-name="Label">【運営・組織体制】</text:p>
            <text:p text:style-name="Body"/>
            <table:table table:name="OrganizationChart" table:style-name="Box">
              <table:table-column table:style-name="ColRole1"/>
              <table:table-column table:style-name="ColRole2"/>
              <table:table-column table:style-name="ColRole3"/>
              <table:table-row><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
              <table:table-row><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
              <table:table-row><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
            </table:table>
            <text:p text:style-name="Label">【役割等】</text:p>
            <table:table table:name="Roles" table:style-name="Box">
              <table:table-column table:style-name="ColRole1"/>
              <table:table-column table:style-name="ColRole2"/>
              <table:table-column table:style-name="ColRole3"/>
              <table:table-row><table:table-cell table:style-name="CellCenter"><text:p>役職等</text:p></table:table-cell><table:table-cell table:style-name="CellCenter"><text:p>人数</text:p></table:table-cell><table:table-cell table:style-name="CellCenter"><text:p>役割</text:p></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"><text:p>名</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
              <table:table-row><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"><text:p>名</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
              <table:table-row><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"><text:p>名</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
              <table:table-row><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"><text:p>名</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
            </table:table>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellHead" table:number-columns-spanned="3"><text:p text:style-name="Label">④事業に関する法律、規制について</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="Tall">
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p/></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Section">３．収支計画について</text:p>

      <text:p text:style-name="PageStart"/>
      <table:table table:name="Finance" table:style-name="Box">
        <table:table-column table:style-name="ColWide"/>
        <table:table-row>
          <table:table-cell table:style-name="CellHead"><text:p text:style-name="Label">事業の収支計画</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="Tall">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">※別紙「収支計画書（補助対象経費の概算見積書）」のとおり</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body">(注１）必要に応じて記入欄を増やして差し支えありません。</text:p>
    </office:text>
  </office:body>
</office:document>