<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.04in" fo:margin-bottom="0.04in"/>
      <style:text-properties fo:font-size="11pt" style:font-size-asian="11pt" style:font-name-asian="Noto Sans CJK JP"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.16in" fo:margin-bottom="0.48in"/>
      <style:text-properties fo:font-size="14pt" style:font-size-asian="14pt" fo:font-weight="bold" style:font-weight-asian="bold"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.18in" fo:margin-bottom="0.12in"/>
      <style:text-properties fo:font-size="12pt" style:font-size-asian="12pt"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0in" fo:margin-bottom="0in"/>
    </style:style>
    <style:style style:name="Centered" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="TableText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.03in" fo:margin-bottom="0.03in"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.07in" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="ThinCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.035in" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="PlainCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0.025in" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="FixedTable" style:family="table">
      <style:table-properties style:width="6.85in" table:align="margins"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="A4Layout">
      <style:page-layout-properties fo:page-width="8.27in" fo:page-height="11.69in" fo:margin-top="0.58in" fo:margin-bottom="0.58in" fo:margin-left="0.82in" fo:margin-right="0.82in" style:print-orientation="portrait"/>
    </style:page-layout>
    <style:style style:name="ColGutter" style:family="table-column">
      <style:table-column-properties style:column-width="0.30in"/>
    </style:style>
    <style:style style:name="ColMain" style:family="table-column">
      <style:table-column-properties style:column-width="6.55in"/>
    </style:style>
    <style:style style:name="ColWide" style:family="table-column">
      <style:table-column-properties style:column-width="6.85in"/>
    </style:style>
    <style:style style:name="ColTask" style:family="table-column">
      <style:table-column-properties style:column-width="2.05in"/>
    </style:style>
    <style:style style:name="ColMonth" style:family="table-column">
      <style:table-column-properties style:column-width="0.48in"/>
    </style:style>
    <style:style style:name="ColRole1" style:family="table-column">
      <style:table-column-properties style:column-width="1.55in"/>
    </style:style>
    <style:style style:name="ColRole2" style:family="table-column">
      <style:table-column-properties style:column-width="0.95in"/>
    </style:style>
    <style:style style:name="ColRole3" style:family="table-column">
      <style:table-column-properties style:column-width="4.35in"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="A4Layout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p><text:span>様式１別紙</text:span></text:p>
      <text:p text:style-name="Title">大崎町地場産品創出等支援事業補助金　企画提案書</text:p>
      <text:p text:style-name="Section">１．提案者について</text:p>
      <table:table table:name="提案者について" table:style-name="FixedTable">
        <table:table-column table:style-name="ColGutter"/>
        <table:table-column table:style-name="ColMain"/>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell"><text:p>①</text:p></table:table-cell>
          <table:table-cell table:style-name="ThinCell"><text:p text:style-name="TableText">①提案者の事業について</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="TableText"><text:span>※提案者が通常行っている事業概要をご記入ください。</text:span></text:p>
            <text:p text:style-name="TableText"/>
            <text:p text:style-name="TableText"><text:span>（事業概要が記載されているパンフレット等の添付で可）</text:span></text:p>
            <text:p/><text:p/><text:p/><text:p/><text:p/><text:p/>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell"><text:p>②</text:p></table:table-cell>
          <table:table-cell table:style-name="ThinCell"><text:p text:style-name="TableText">②提案する商品等の実績について</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="TableText">※売上実績や表彰歴があれば、ご記入ください。（新規商品等の場合は、記入不要）</text:p>
            <text:p/><text:p/><text:p/><text:p/>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Section">２．提案内容について</text:p>
      <table:table table:name="提案する商品等について" table:style-name="FixedTable">
        <table:table-column table:style-name="ColWide"/>
        <table:table-row><table:table-cell table:style-name="ThinCell"><text:p text:style-name="TableText">①提案する商品等について</text:p></table:table-cell></table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="TableText">※どのような事業を行うのか事業の全体像やスキーム図、想定する返礼品をご記入下さい。</text:p>
            <text:p/><text:p>【提案する開発商品や生産性増強事業の概要】</text:p>
            <text:p/><text:p/><text:p>（具体的にどのようなことを行いどのような効果が得られるか等）</text:p>
            <text:p/><text:p/><text:p/>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageBreak"/>
      <table:table table:name="提案内容の続き" table:style-name="FixedTable">
        <table:table-column table:style-name="ColWide"/>
        <table:table-row><table:table-cell table:style-name="Cell">
          <text:p>【返礼品名】</text:p>
          <text:p/><text:p/><text:p/>
          <text:p>【商品へのこだわり、開発の目標】</text:p>
          <text:p/><text:p>・独創性、新規性</text:p>
          <text:p/><text:p/><text:p>・市場性、優位性</text:p>
          <text:p/><text:p/><text:p>・成長の可能性</text:p>
          <text:p/><text:p/><text:p>・経済波及効果</text:p>
          <text:p/><text:p/><text:p>・ふるさと納税返礼品としての可能性</text:p>
          <text:p/><text:p/><text:p>【商品の価格設定と収益性】</text:p>
          <text:p/><text:p>・収益性、現実性</text:p>
          <text:p/><text:p/>
        </table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="ThinCell"><text:p>②事業スケジュール</text:p></table:table-cell></table:table-row>
      </table:table>
      <table:table table:name="事業スケジュール" table:style-name="FixedTable">
        <table:table-column table:style-name="ColTask"/>
        <table:table-column table:style-name="ColMonth"/><table:table-column table:style-name="ColMonth"/><table:table-column table:style-name="ColMonth"/><table:table-column table:style-name="ColMonth"/><table:table-column table:style-name="ColMonth"/><table:table-column table:style-name="ColMonth"/><table:table-column table:style-name="ColMonth"/><table:table-column table:style-name="ColMonth"/><table:table-column table:style-name="ColMonth"/><table:table-column table:style-name="ColMonth"/>
        <table:table-row>
          <table:table-cell table:style-name="ThinCell"><text:p text:style-name="Centered">実施項目</text:p></table:table-cell>
          <table:table-cell table:style-name="ThinCell"><text:p text:style-name="Centered">月</text:p></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p text:style-name="Centered">月</text:p></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p text:style-name="Centered">月</text:p></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p text:style-name="Centered">月</text:p></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p text:style-name="Centered">月</text:p></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p text:style-name="Centered">月</text:p></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p text:style-name="Centered">月</text:p></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p text:style-name="Centered">月</text:p></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p text:style-name="Centered">月</text:p></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p text:style-name="Centered">月</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>→</text:p></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageBreak"/>
      <table:table table:name="事業スケジュール続き" table:style-name="FixedTable">
        <table:table-column table:style-name="ColTask"/>
        <table:table-column table:style-name="ColMonth"/><table:table-column table:style-name="ColMonth"/><table:table-column table:style-name="ColMonth"/><table:table-column table:style-name="ColMonth"/><table:table-column table:style-name="ColMonth"/><table:table-column table:style-name="ColMonth"/><table:table-column table:style-name="ColMonth"/><table:table-column table:style-name="ColMonth"/><table:table-column table:style-name="ColMonth"/><table:table-column table:style-name="ColMonth"/>
        <table:table-row><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>→</text:p></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>→</text:p></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>→</text:p></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>→</text:p></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p>→</text:p></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell></table:table-row>
      </table:table>
      <table:table table:name="運営体制・連携機関" table:style-name="FixedTable">
        <table:table-column table:style-name="ColWide"/>
        <table:table-row><table:table-cell table:style-name="ThinCell"><text:p>③　③事業の運営体制・連携機関などについて　※別添可</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell">
          <text:p>【運営・組織体制】</text:p>
          <text:p/><text:p/>
          <table:table table:name="組織図">
            <table:table-column table:style-name="ColWide"/>
            <table:table-row><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell></table:table-row>
            <table:table-row><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell></table:table-row>
            <table:table-row><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell></table:table-row>
          </table:table>
          <text:p/><text:p>【役割等】</text:p>
          <table:table table:name="役割等">
            <table:table-column table:style-name="ColRole1"/><table:table-column table:style-name="ColRole2"/><table:table-column table:style-name="ColRole3"/>
            <table:table-row><table:table-cell table:style-name="ThinCell"><text:p text:style-name="Centered">役職等</text:p></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p text:style-name="Centered">人数</text:p></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p text:style-name="Centered">役割</text:p></table:table-cell></table:table-row>
            <table:table-row><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p text:style-name="Centered">名</text:p></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell></table:table-row>
            <table:table-row><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p text:style-name="Centered">名</text:p></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell></table:table-row>
            <table:table-row><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p text:style-name="Centered">名</text:p></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell></table:table-row>
            <table:table-row><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p text:style-name="Centered">名</text:p></table:table-cell><table:table-cell table:style-name="ThinCell"><text:p/></table:table-cell></table:table-row>
          </table:table>
          <text:p/><text:p/><text:p/>
        </table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="ThinCell"><text:p>④　④事業に関する法律、規制について</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p/><text:p/><text:p/></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="Section">３．収支計画について</text:p>
      <text:p text:style-name="PageBreak"/>
      <table:table table:name="事業の収支計画" table:style-name="FixedTable">
        <table:table-column table:style-name="ColWide"/>
        <table:table-row><table:table-cell table:style-name="ThinCell"><text:p>事業の収支計画</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p/><text:p>※別紙「収支計画書（補助対象経費の概算見積書）」のとおり</text:p><text:p/></table:table-cell></table:table-row>
      </table:table>
      <text:p>（注１）必要に応じて記入欄を増やして差し支えありません。</text:p>
    </office:text>
  </office:body>
</office:document>