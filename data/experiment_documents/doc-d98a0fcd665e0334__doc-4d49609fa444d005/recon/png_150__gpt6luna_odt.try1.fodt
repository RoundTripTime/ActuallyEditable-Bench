<?xml version="1.0" encoding="UTF-8"?>
<office:document
    xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
    xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
    xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
    xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
    office:mimetype="application/vnd.oasis.opendocument.text"
    office:version="1.4">

  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.5cm" fo:margin-bottom="1.5cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
    </style:page-layout>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin="0cm" fo:line-height="1pt"/>
      <style:text-properties fo:font-size="1pt"/>
    </style:style>
    <style:style style:name="Normal" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="115%"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="SectionHead" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.25cm" fo:margin-bottom="0.25cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="13pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.5cm" fo:margin-bottom="1.2cm"/>
      <style:text-properties fo:font-size="15pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Bold" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="11pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Italic" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="11pt" fo:font-style="italic"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0.18cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="NoBorderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Table" style:family="table">
      <style:table-properties table:align="left" style:width="17cm"/>
    </style:style>
    <style:style style:name="FullWidthTable" style:family="table">
      <style:table-properties table:align="left" style:width="16.5cm"/>
    </style:style>
    <style:style style:name="ColFull" style:family="table-column">
      <style:table-column-properties style:column-width="17cm"/>
    </style:style>
    <style:style style:name="ColWide" style:family="table-column">
      <style:table-column-properties style:column-width="5.5cm"/>
    </style:style>
    <style:style style:name="ColMid" style:family="table-column">
      <style:table-column-properties style:column-width="2.5cm"/>
    </style:style>
    <style:style style:name="ColNarrow" style:family="table-column">
      <style:table-column-properties style:column-width="0.8cm"/>
    </style:style>
    <style:style style:name="ColMonth" style:family="table-column">
      <style:table-column-properties style:column-width="1.1cm"/>
    </style:style>
    <style:style style:name="ColScheduleFirst" style:family="table-column">
      <style:table-column-properties style:column-width="5.4cm"/>
    </style:style>
    <style:style style:name="ColRole1" style:family="table-column">
      <style:table-column-properties style:column-width="4cm"/>
    </style:style>
    <style:style style:name="ColRole2" style:family="table-column">
      <style:table-column-properties style:column-width="2.5cm"/>
    </style:style>
    <style:style style:name="ColRole3" style:family="table-column">
      <style:table-column-properties style:column-width="10cm"/>
    </style:style>
    <style:style style:name="RowShort" style:family="table-row">
      <style:table-row-properties style:row-height="1.2cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RowMedium" style:family="table-row">
      <style:table-row-properties style:row-height="1.6cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RowLarge" style:family="table-row">
      <style:table-row-properties style:row-height="7cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RowXLarge" style:family="table-row">
      <style:table-row-properties style:row-height="9cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RowBlank" style:family="table-row">
      <style:table-row-properties style:row-height="4.4cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RowSchedule" style:family="table-row">
      <style:table-row-properties style:row-height="0.65cm" style:use-optimal-row-height="false"/>
    </style:style>
  </office:automatic-styles>

  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:default-style>
  </office:styles>

  <office:master-styles>
    <style:master-page style:name="DefaultPage" style:page-layout-name="PageLayout"/>
  </office:master-styles>

  <office:body>
    <office:text>
      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="Bold">様式１別紙</text:p>
      <text:p text:style-name="Title">大崎町地場産品創出等支援事業補助金　企画提案書</text:p>

      <text:p text:style-name="SectionHead">１．提案者について</text:p>
      <table:table table:name="ProposerInformation" table:style-name="Table">
        <table:table-column table:style-name="ColFull"/>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Normal">①提案者の事業について</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowLarge">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="Italic">※提案者が通常行っている事業概要をご記入ください。</text:p>
            <text:p text:style-name="Normal"/>
            <text:p text:style-name="Italic">（事業概要が記載されているパンフレット等の添付で可）</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Normal">②提案する商品等の実績について</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowBlank">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="Italic">※売上実績や表彰歴があれば、ご記入ください。（新規商品等の場合は、記入不要）</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="SectionHead">２．提案内容について</text:p>
      <table:table table:name="ProductProposalIntro" table:style-name="Table">
        <table:table-column table:style-name="ColFull"/>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Normal">①提案する商品等について</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowXLarge">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="Italic">※どのような事業を行うのか事業の全体像やスキーム図、想定する返礼品をご記入下さい。</text:p>
            <text:p text:style-name="Normal"/>
            <text:p text:style-name="Normal">【提案する開発商品や生産性増強事業の概要】</text:p>
            <text:p text:style-name="Normal"/>
            <text:p text:style-name="Normal">（具体的にどのようなことを行いどのような効果が得られるか等）</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="PageStart"/>
      <table:table table:name="ProductProposalDetails" table:style-name="Table">
        <table:table-column table:style-name="ColFull"/>
        <table:table-row table:style-name="RowXLarge">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="Normal">【返礼品名】</text:p>
            <text:p text:style-name="Normal"/>
            <text:p text:style-name="Normal"/>
            <text:p text:style-name="Normal">【商品へのこだわり、開発の目標】</text:p>
            <text:p text:style-name="Normal"/>
            <text:p text:style-name="Normal">・独創性、新規性</text:p>
            <text:p text:style-name="Normal"/>
            <text:p text:style-name="Normal"/>
            <text:p text:style-name="Normal">・市場性、優位性</text:p>
            <text:p text:style-name="Normal"/>
            <text:p text:style-name="Normal"/>
            <text:p text:style-name="Normal">・成長の可能性</text:p>
            <text:p text:style-name="Normal"/>
            <text:p text:style-name="Normal"/>
            <text:p text:style-name="Normal">・経済波及効果</text:p>
            <text:p text:style-name="Normal"/>
            <text:p text:style-name="Normal"/>
            <text:p text:style-name="Normal">・ふるさと納税返礼品としての可能性</text:p>
            <text:p text:style-name="Normal"/>
            <text:p text:style-name="Normal">【商品の価格設定と収益性】</text:p>
            <text:p text:style-name="Normal"/>
            <text:p text:style-name="Normal">・収益性、現実性</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Normal">②事業スケジュール</text:p></table:table-cell>
        </table:table-row>
      </table:table>

      <table:table table:name="SchedulePageOne" table:style-name="FullWidthTable">
        <table:table-column table:style-name="ColScheduleFirst"/>
        <table:table-column table:style-name="ColMonth"/><table:table-column table:style-name="ColMonth"/>
        <table:table-column table:style-name="ColMonth"/><table:table-column table:style-name="ColMonth"/>
        <table:table-column table:style-name="ColMonth"/><table:table-column table:style-name="ColMonth"/>
        <table:table-column table:style-name="ColMonth"/><table:table-column table:style-name="ColMonth"/>
        <table:table-column table:style-name="ColMonth"/><table:table-column table:style-name="ColMonth"/>
        <table:table-row table:style-name="RowSchedule">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">実施項目</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">月</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">月</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">月</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">月</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">月</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">月</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">月</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">月</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">月</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">月</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowSchedule">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">⟶</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="PageStart"/>
      <table:table table:name="ScheduleContinuation" table:style-name="FullWidthTable">
        <table:table-column table:style-name="ColScheduleFirst"/>
        <table:table-column table:style-name="ColMonth"/><table:table-column table:style-name="ColMonth"/>
        <table:table-column table:style-name="ColMonth"/><table:table-column table:style-name="ColMonth"/>
        <table:table-column table:style-name="ColMonth"/><table:table-column table:style-name="ColMonth"/>
        <table:table-column table:style-name="ColMonth"/><table:table-column table:style-name="ColMonth"/>
        <table:table-column table:style-name="ColMonth"/><table:table-column table:style-name="ColMonth"/>
        <table:table-row table:style-name="RowSchedule">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">⟶</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowSchedule">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">⟶</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowSchedule">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">⟶</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowSchedule">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">⟶</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowSchedule">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">⟶</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small"/></table:table-cell>
        </table:table-row>
      </table:table>

      <table:table table:name="OrganizationChart" table:style-name="FullWidthTable">
        <table:table-column table:style-name="ColWide"/>
        <table:table-column table:style-name="ColWide"/>
        <table:table-column table:style-name="ColWide"/>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="Normal"/></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="1"><text:p text:style-name="Normal"/></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Normal"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Normal"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Normal"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Normal"/></table:table-cell>
          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="Normal">│</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Normal"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Normal"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Normal"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Normal"/></table:table-row>
      </table:table>

      <text:p text:style-name="Normal">Ⅱ</text:p>
      <text:p text:style-name="Normal">【役割等】</text:p>
      <table:table table:name="Roles" table:style-name="FullWidthTable">
        <table:table-column table:style-name="ColRole1"/>
        <table:table-column table:style-name="ColRole2"/>
        <table:table-column table:style-name="ColRole3"/>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Normal">役職等</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Normal">人数</text:p></table:table-cell>
