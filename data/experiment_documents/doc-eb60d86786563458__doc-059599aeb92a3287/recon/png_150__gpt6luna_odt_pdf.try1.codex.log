          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellBoldCenter"><text:p>自治会名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>※自治会未加入の方は、「未加入」と記載</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
