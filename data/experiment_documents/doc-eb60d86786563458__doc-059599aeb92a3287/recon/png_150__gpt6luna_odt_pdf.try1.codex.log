        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellBoldCenter"><text:p>代表者</text:p><text:p>電話番号</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter" table:number-columns-spanned="2"><text:p>（　　　　　　　　）</text:p></table:table-cell>
