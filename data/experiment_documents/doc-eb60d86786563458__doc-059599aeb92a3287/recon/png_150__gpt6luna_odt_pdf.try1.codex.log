      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="Center"><text:span text:style-name="BoldCenter">避難者カード（表面）</text:span><text:tab/>【様式－７】</text:p>
      <text:p text:style-name="LargeBold">記入日　　　年　　月　　日　　世帯ごとに記載してください。</text:p>
      <table:table table:name="FrontTop">
