          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="P">처리 기간</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="P">즉시</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="P"> </text:p>
      <table:table table:name="신청인" table:style-name="Wide">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
