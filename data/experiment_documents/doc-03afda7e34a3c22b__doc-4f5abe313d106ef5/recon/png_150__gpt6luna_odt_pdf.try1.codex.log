        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="P">신청 대상</text:p><text:p text:style-name="P">건물ㆍ시설</text:p><text:p text:style-name="P">주소지</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="P">주소　(우　　　　　　　　)</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="NoBorder" table:number-columns-spanned="2"><text:p text:style-name="P">※ 전입신고 통보서비스 신청 시 작성합니다.</text:p></table:table-cell>
