<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:font-face-decls>
    <style:font-face style:name="Noto Sans CJK KR" svg:font-family="Noto Sans CJK KR" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"/>
  </office:font-face-decls>
  <office:styles>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="0mm" fo:line-height="100%"/>
      <style:text-properties style:font-name="Noto Sans CJK KR" fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:text-align="end"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="Center">
      <style:paragraph-properties fo:margin-top="1mm" fo:margin-bottom="1mm"/>
      <style:text-properties fo:font-size="18pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Bold" style:family="paragraph" style:parent-style-name="P">
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:padding="1mm" fo:border="0.5pt solid #777777" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HeaderCell" style:family="table-cell" style:parent-style-name="Cell">
      <style:table-cell-properties fo:padding="1mm" fo:border="0.5pt solid #777777" fo:background-color="#b7b7b7" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="LabelCell" style:family="table-cell" style:parent-style-name="Cell">
      <style:table-cell-properties fo:padding="1mm" fo:border="0.5pt solid #777777" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="NoBorder" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.5mm" fo:border="none" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph" style:parent-style-name="P">
