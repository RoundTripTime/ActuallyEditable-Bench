          <table:table-cell table:style-name="Cell"/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-columns-spanned="2"><text:p text:style-name="CellText">登録内容の変更項目</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellCenter"><text:p text:style-name="CellText">旧ＩＣカードの情報</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p text:style-name="CellText">新ＩＣカードの情報</text:p></table:table-cell>
