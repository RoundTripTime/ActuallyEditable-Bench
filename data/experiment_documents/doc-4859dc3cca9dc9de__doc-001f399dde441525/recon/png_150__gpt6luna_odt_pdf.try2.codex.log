      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="Title">旧ＩＣカード使用届</text:p>
      <text:p text:style-name="Right">年　月　日</text:p>
      <text:p text:style-name="Right">殿</text:p>
      <text:p text:style-name="Right">住所</text:p>
      <text:p text:style-name="Right">商号</text:p>
