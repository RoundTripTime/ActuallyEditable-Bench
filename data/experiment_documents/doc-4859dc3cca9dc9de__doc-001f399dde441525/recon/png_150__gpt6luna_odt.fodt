<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
      <style:paragraph-properties fo:line-height="125%" fo:margin-top="0cm" fo:margin-bottom="0.04cm"/>
    </style:default-style>
    <style:default-style style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:default-style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="2cm" fo:margin-right="2cm" fo:margin-top="1.8cm" fo:margin-bottom="1.7cm"/>
    </style:page-layout>
    <style:style style:name="PageTitle" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:text-align="center" fo:margin-top="0.4cm" fo:margin-bottom="0.55cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="RightText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-bottom="0.03cm"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph">
      <style:paragraph-properties fo:text-align="left" fo:margin-bottom="0.05cm" fo:margin-left="2.7cm"/>
    </style:style>
    <style:style style:name="ContactText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-right="0.1cm" fo:margin-bottom="0.03cm"/>
    </style:style>
    <style:style style:name="BodyCopy" style:family="paragraph">
      <style:paragraph-properties fo:line-height="125%" fo:margin-top="0.3cm" fo:margin-bottom="0cm" fo:margin-left="0.2cm"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="16.8cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ColNarrow" style:family="table-column">
      <style:table-column-properties style:column-width="0.65cm"/>
    </style:style>
    <style:style style:name="ColLabel" style:family="table-column">
      <style:table-column-properties style:column-width="3.2cm"/>
    </style:style>
    <style:style style:name="ColInfo" style:family="table-column">
      <style:table-column-properties style:column-width="6.475cm"/>
    </style:style>
    <style:style style:name="CellBase" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellTall" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.13cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="CellInput" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.18cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="RowShort" style:family="table-row">
      <style:table-row-properties style:row-height="0.82cm"/>
    </style:style>
    <style:style style:name="RowNormal" style:family="table-row">
      <style:table-row-properties style:row-height="0.9cm"/>
    </style:style>
    <style:style style:name="RowTall" style:family="table-row">
      <style:table-row-properties style:row-height="1.1cm"/>
    </style:style>
    <style:style style:name="RowReason" style:family="table-row">
      <style:table-row-properties style:row-height="1.4cm"/>
    </style:style>
    <style:style style:name="NotesRed" style:family="paragraph">
      <style:paragraph-properties fo:line-height="125%" fo:margin-left="0.2cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:color="#FF0000" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Evidence" style:family="paragraph">
      <style:paragraph-properties fo:line-height="125%" fo:margin-left="0.2cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="EvidenceHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.55cm" fo:margin-bottom="0.05cm"/>
      <style:text-properties fo:font-size="11pt" fo:font-weight="bold"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageTitle">旧ＩＣカード使用届</text:p>
      <text:p text:style-name="RightText">年　月　日</text:p>
      <text:p text:style-name="Recipient">殿</text:p>
      <text:p text:style-name="ContactText">住所</text:p>
      <text:p text:style-name="ContactText">商号</text:p>
      <text:p text:style-name="ContactText">代表者（受任者）氏名</text:p>
      <text:p text:style-name="ContactText">担当者氏名</text:p>
      <text:p text:style-name="ContactText">連絡先</text:p>
      <text:p text:style-name="BodyCopy">　このたび、入札参加資格者名簿の登録内容変更に伴いＩＣカードの登録内容を変更することと<text:line-break/>なりました。</text:p>
      <text:p text:style-name="BodyCopy">　現在新ＩＣカード取得の手続き中のため、新ＩＣカード取得までの間、旧ＩＣカードの使用に<text:line-break/>ついて下記のとおり届け出ます。</text:p>
      <table:table table:name="CardInformation" table:style-name="FormTable">
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColInfo"/>
        <table:table-column table:style-name="ColInfo"/>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="CellCenter" table:number-columns-spanned="2"><text:p>認定番号</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellInput" table:number-columns-spanned="2"/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="CellCenter" table:number-columns-spanned="2"><text:p>調達案件番号</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellInput" table:number-columns-spanned="2"/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="CellCenter" table:number-columns-spanned="2"><text:p>調達案件名称</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellInput" table:number-columns-spanned="2"/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="CellCenter" table:number-columns-spanned="2"><text:p>登録内容の変更項目</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellCenter"><text:p>旧ＩＣカードの情報</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>新ＩＣカードの情報</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowNormal">
          <table:table-cell table:style-name="CellBase" table:number-rows-spanned="3"/>
          <table:table-cell table:style-name="CellCenter"><text:p>商　号</text:p></table:table-cell>
          <table:table-cell table:style-name="CellInput"/>
          <table:table-cell table:style-name="CellInput"/>
        </table:table-row>
        <table:table-row table:style-name="RowTall">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellCenter"><text:p>代表者<text:line-break/>（又は受任者）</text:p></table:table-cell>
          <table:table-cell table:style-name="CellInput"/>
          <table:table-cell table:style-name="CellInput"/>
        </table:table-row>
        <table:table-row table:style-name="RowTall">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellCenter"><text:p>本店住所</text:p></table:table-cell>
          <table:table-cell table:style-name="CellInput"/>
          <table:table-cell table:style-name="CellInput"/>
        </table:table-row>
        <table:table-row table:style-name="RowReason">
          <table:table-cell table:style-name="CellCenter" table:number-columns-spanned="2"><text:p>旧ＩＣカードを<text:line-break/>使用する理由</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellInput" table:number-columns-spanned="2"/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="NotesRed">【留意点】</text:p>
      <text:p text:style-name="NotesRed">　※本届出には、以下の根拠書類を添付してください。</text:p>
      <text:p text:style-name="NotesRed">　※提出期限は、参加を希望する案件の資格申請期限日までです。（原則）</text:p>
      <text:p text:style-name="NotesRed">　※資格申請期限日までに根拠書類が提出できない場合は、本届出のみを先に提出し、入札開<text:line-break/>始日前日までに根拠書類を追って提出してください。</text:p>
      <text:p text:style-name="NotesRed">　※入札開始日前日までに根拠書類を提出されない場合は、入札を行っても無効とみなします。</text:p>
      <text:p text:style-name="NotesRed">　※本届出提出後、入札開始日前日までに根拠書類が提出できない場合は、「紙入札承認願」<text:line-break/>を提出し、紙入札への切り替えをお願いします。</text:p>
      <text:p text:style-name="EvidenceHeading">（根拠書類）</text:p>
      <text:p text:style-name="Evidence">　法人代表者・法人住所変更の場合</text:p>
      <text:p text:style-name="Evidence">→　登記事項証明書</text:p>
      <text:p text:style-name="Evidence">　受任者変更の場合</text:p>
      <text:p text:style-name="Evidence">→　ＩＣカードの申し込みの際に、各認証局に提出する書類の写し一式（申請書含む）</text:p>
    </office:text>
  </office:body>
</office:document>