<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
                 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
                 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
                 xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
                 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
                 office:mimetype="application/vnd.oasis.opendocument.text"
                 office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="0mm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="MS Mincho" fo:font-size="11pt"/>
    </style:default-style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="8mm" fo:margin-bottom="5mm"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right"/>
    </style:style>
    <style:style style:name="Intro" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="3mm" fo:text-indent="5mm" fo:line-height="120%"/>
    </style:style>
    <style:style style:name="Notice" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="3mm" fo:line-height="120%"/>
      <style:text-properties fo:color="#FF0000" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Evidence" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="3mm" fo:margin-top="5mm" fo:line-height="130%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="TableStyle" style:family="table">
      <style:table-properties style:width="168mm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ColSpacer" style:family="table-column">
      <style:table-column-properties style:column-width="6mm"/>
    </style:style>
    <style:style style:name="ColLabel" style:family="table-column">
      <style:table-column-properties style:column-width="32mm"/>
    </style:style>
    <style:style style:name="ColOld" style:family="table-column">
      <style:table-column-properties style:column-width="65mm"/>
    </style:style>
    <style:style style:name="ColNew" style:family="table-column">
      <style:table-column-properties style:column-width="65mm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="1mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="1mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="110%"/>
    </style:style>
    <style:style style:name="CellLeft" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="110%"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm"
                                    fo:margin-top="18mm" fo:margin-bottom="18mm"
                                    fo:margin-left="20mm" fo:margin-right="20mm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="Title">旧ＩＣカード使用届</text:p>
      <text:p text:style-name="Right">年　月　日</text:p>
      <text:p text:style-name="Right">殿</text:p>
      <text:p text:style-name="Right">住所</text:p>
      <text:p text:style-name="Right">商号</text:p>
      <text:p text:style-name="Right">代表者（受任者）氏名</text:p>
      <text:p text:style-name="Right">担当者氏名</text:p>
      <text:p text:style-name="Right">連絡先</text:p>
      <text:p text:style-name="Intro">このたび、入札参加資格者名簿の登録内容変更に伴いＩＣカードの登録内容を変更することと<text:line-break/>なりました。</text:p>
      <text:p text:style-name="Intro">現在新ＩＣカード取得の手続き中のため、新ＩＣカード取得までの間、旧ＩＣカードの使用に<text:line-break/>ついて下記のとおり届け出ます。</text:p>
      <table:table table:name="RegistrationChanges" table:style-name="TableStyle">
        <table:table-column table:style-name="ColSpacer"/>
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColOld"/>
        <table:table-column table:style-name="ColNew"/>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-columns-spanned="2"><text:p text:style-name="CellText">認定番号</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-columns-spanned="2"><text:p text:style-name="CellText">調達案件番号</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-columns-spanned="2"><text:p text:style-name="CellText">調達案件名称</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-columns-spanned="2"><text:p text:style-name="CellText">登録内容の変更項目</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellCenter"><text:p text:style-name="CellText">旧ＩＣカードの情報</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p text:style-name="CellText">新ＩＣカードの情報</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="CellCenter"><text:p text:style-name="CellText">商　号</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="CellCenter"><text:p text:style-name="CellText">代表者<text:line-break/>（又は受任者）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="CellCenter"><text:p text:style-name="CellText">本店住所</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-columns-spanned="2"><text:p text:style-name="CellText">旧ＩＣカードを<text:line-break/>使用する理由</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Notice">【留意点】</text:p>
      <text:p text:style-name="Notice">　※本届出には、以下の根拠書類を添付してください。</text:p>
      <text:p text:style-name="Notice">　※提出期限は、参加を希望する案件の資格申請期限日までです。（原則）</text:p>
      <text:p text:style-name="Notice">　※資格申請期限日までに根拠書類が提出できない場合は、本届出のみを先に提出し、入札開始日<text:line-break/>前日までに根拠書類を追って提出してください。</text:p>
      <text:p text:style-name="Notice">　※入札開始日前日までに根拠書類を提出されない場合は、入札を行っても無効とみなします。</text:p>
      <text:p text:style-name="Notice">　※本届出提出後、入札開始日前日までに根拠書類が提出できない場合は、「紙入札承認願」<text:line-break/>を提出し、紙入札への切り替えをお願いします。</text:p>
      <text:p text:style-name="Evidence">（根拠書類）<text:line-break/>法人代表者・法人住所変更の場合<text:line-break/>→　登記事項証明書<text:line-break/>受任者変更の場合<text:line-break/>→　ＩＣカードの申し込みの際に、各認証局に提出する書類の写し一式（申請書含む）</text:p>
    </office:text>
  </office:body>
</office:document>