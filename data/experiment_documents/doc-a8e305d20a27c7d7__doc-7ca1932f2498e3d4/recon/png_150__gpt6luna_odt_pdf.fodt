<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.08cm" fo:line-height="100%"/>
      <style:text-properties style:font-name="Noto Serif CJK JP" fo:font-size="10pt"/>
    </style:default-style>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.08cm" fo:line-height="100%"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:text-align="end"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:break-before="page" fo:margin-bottom="0.08cm"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.55cm" fo:margin-bottom="0.55cm"/>
      <style:text-properties fo:font-size="15pt"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph" style:parent-style-name="P">
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="DashCell" style:family="table-cell">
      <style:table-cell-properties fo:border-left="0.5pt solid #000000" fo:border-right="0.5pt solid #000000" fo:border-top="0.5pt solid #000000" fo:border-bottom="0.5pt dashed #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.7cm" fo:margin-bottom="1.7cm" fo:margin-left="1.8cm" fo:margin-right="1.8cm"/>
    </style:page-layout>
    <style:style style:name="ApplicantTable" style:family="table">
      <style:table-properties/>
    </style:style>
    <style:style style:name="ApplicantCol1" style:family="table-column">
      <style:table-column-properties style:column-width="3.5cm"/>
    </style:style>
    <style:style style:name="ApplicantCol2" style:family="table-column">
      <style:table-column-properties style:column-width="5.2cm"/>
    </style:style>
    <style:style style:name="ApplicantCol3" style:family="table-column">
      <style:table-column-properties style:column-width="5.2cm"/>
    </style:style>
    <style:style style:name="RowShort" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.65cm"/>
    </style:style>
    <style:style style:name="RowName" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.55cm"/>
    </style:style>
    <style:style style:name="RowInput" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.78cm"/>
    </style:style>
    <style:style style:name="WideTable" style:family="table">
      <style:table-properties/>
    </style:style>
    <style:style style:name="WideCol1" style:family="table-column">
      <style:table-column-properties style:column-width="3.8cm"/>
    </style:style>
    <style:style style:name="WideCol2" style:family="table-column">
      <style:table-column-properties style:column-width="5.4cm"/>
    </style:style>
    <style:style style:name="WideCol3" style:family="table-column">
      <style:table-column-properties style:column-width="5.4cm"/>
    </style:style>
    <style:style style:name="WideCol4" style:family="table-column">
      <style:table-column-properties style:column-width="5.4cm"/>
    </style:style>
    <style:style style:name="WideCol5" style:family="table-column">
      <style:table-column-properties style:column-width="5.4cm"/>
    </style:style>
    <style:style style:name="WideCol6" style:family="table-column">
      <style:table-column-properties style:column-width="5.4cm"/>
    </style:style>
    <style:style style:name="WideCol7" style:family="table-column">
      <style:table-column-properties style:column-width="5.4cm"/>
    </style:style>
    <style:style style:name="WideCol8" style:family="table-column">
      <style:table-column-properties style:column-width="5.4cm"/>
    </style:style>
    <style:style style:name="WideCol9" style:family="table-column">
      <style:table-column-properties style:column-width="5.4cm"/>
    </style:style>
    <style:style style:name="WideCol10" style:family="table-column">
      <style:table-column-properties style:column-width="5.4cm"/>
    </style:style>
    <style:style style:name="WideCol11" style:family="table-column">
      <style:table-column-properties style:column-width="5.4cm"/>
    </style:style>
    <style:style style:name="WideCol12" style:family="table-column">
      <style:table-column-properties style:column-width="5.4cm"/>
    </style:style>
    <style:style style:name="WideCol13" style:family="table-column">
      <style:table-column-properties style:column-width="5.4cm"/>
    </style:style>
    <style:style style:name="WideCol14" style:family="table-column">
      <style:table-column-properties style:column-width="5.4cm"/>
    </style:style>
    <style:style style:name="WideCol15" style:family="table-column">
      <style:table-column-properties style:column-width="5.4cm"/>
    </style:style>
    <style:style style:name="WideCol16" style:family="table-column">
      <style:table-column-properties style:column-width="5.4cm"/>
    </style:style>
    <style:style style:name="WideCol17" style:family="table-column">
      <style:table-column-properties style:column-width="5.4cm"/>
    </style:style>
    <style:style style:name="WideCol18" style:family="table-column">
      <style:table-column-properties style:column-width="5.4cm"/>
    </style:style>
    <style:style style:name="OptionRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="1.05cm"/>
    </style:style>
    <style:style style:name="TallOptionRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="1.55cm"/>
    </style:style>
    <style:style style:name="BankLabelCol" style:family="table-column">
      <style:table-column-properties style:column-width="2.8cm"/>
    </style:style>
    <style:style style:name="BankInputCol" style:family="table-column">
      <style:table-column-properties style:column-width="4.5cm"/>
    </style:style>
    <style:style style:name="BankOptionCol" style:family="table-column">
      <style:table-column-properties style:column-width="3.5cm"/>
    </style:style>
    <style:style style:name="BankInputCol2" style:family="table-column">
      <style:table-column-properties style:column-width="4.5cm"/>
    </style:style>
    <style:style style:name="BankBranchCol" style:family="table-column">
      <style:table-column-properties style:column-width="3cm"/>
    </style:style>
    <style:style style:name="styleBankOption" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.25cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">第１号様式（第７条関係）</text:p>
      <text:p text:style-name="Right">令和　　年　　月　　日</text:p>
      <text:p>東京都台東区長　殿</text:p>
      <text:p text:style-name="Right">申請者</text:p>
      <table:table table:style-name="ApplicantTable">
        <table:table-column table:style-name="ApplicantCol1"/>
        <table:table-column table:style-name="ApplicantCol2"/>
        <table:table-column table:style-name="ApplicantCol3"/>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">住所</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>台東区</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowName">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">氏</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">名</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowName">
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2"><text:p text:style-name="Center">フリガナ<br/>氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="DashCell"/>
          <table:table-cell table:style-name="DashCell"/>
        </table:table-row>
        <table:table-row table:style-name="RowInput">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">電話番号</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">メールアドレス<br/>（任意）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Title">防犯機器等購入緊急補助事業補助金交付申請書 兼 請求書(口座振替依頼書)</text:p>
      <text:p>台東区防犯機器等購入緊急補助事業補助金交付要綱第７条第１項の規定に基づき、下記の</text:p>
      <text:p>とおり申請します。なお、交付の決定を受けた場合は、交付決定額を請求します。</text:p>
      <table:table table:style-name="WideTable">
        <table:table-column table:style-name="WideCol1"/>
        <table:table-column table:style-name="WideCol2"/>
        <table:table-column table:style-name="WideCol3"/>
        <table:table-column table:style-name="WideCol4"/>
        <table:table-column table:style-name="WideCol5"/>
        <table:table-column table:style-name="WideCol6"/>
        <table:table-column table:style-name="WideCol7"/>
        <table:table-column table:style-name="WideCol8"/>
        <table:table-column table:style-name="WideCol9"/>
        <table:table-column table:style-name="WideCol10"/>
        <table:table-row table:style-name="TallOptionRow">
          <table:table-cell table:style-name="Cell"><text:p>防犯機器等の種類</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="9">
            <text:p>□ 防犯カメラ（録画機能付き）　　　　　　　　　□ インターホン（録画機能付き）</text:p>
            <text:p>□ センサーライト　　　　　　　　　　　　　　　□ センサーアラーム</text:p>
            <text:p>□ ドアスコープ用カメラ（録画機能付き）</text:p>
            <text:p>□ 防犯性の高い鍵・補助錠　　　　　　　　　　　□ 面格子</text:p>
            <text:p>□ 防犯フィルム　　　　　　　　　　　　　　　　□ 防犯ガラス</text:p>
          </table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="OptionRow">
          <table:table-cell table:style-name="Cell"><text:p>建物の所有区分</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="9">
            <text:p>□ 持　ち　家（□ 戸建て　□ 共同住宅）</text:p>
            <text:p>□ 賃貸物件（□ 戸建て　□ 共同住宅）</text:p>
          </table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p text:style-name="Center">補助対象経費(購入・設置費の合計)</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p>￥　　　　　　　　　　　　　　　　　　　円</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p text:style-name="Center">交付申請額(請求額)</text:p><text:p text:style-name="Small">※千円未満切り捨て※上限６万円、対象経費の3/4</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p>￥　　　　　　　　　　　　　　　,000 円</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p>補助金振込先(※口座名義人は申請者名と同一であることとします)</text:p>
      <table:table table:style-name="WideTable">
        <table:table-column table:style-name="BankLabelCol"/>
        <table:table-column table:style-name="BankInputCol"/>
        <table:table-column table:style-name="BankOptionCol"/>
        <table:table-column table:style-name="BankInputCol2"/>
        <table:table-column table:style-name="BankBranchCol"/>
        <table:table-row table:style-name="RowInput">
          <table:table-cell table:style-name="Cell"><text:p>金融機関名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p>□ 銀　行</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p>□ 本店</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageStart"/>
      <table:table table:style-name="WideTable">
        <table:table-column table:style-name="BankLabelCol"/>
        <table:table-column table:style-name="BankInputCol"/>
        <table:table-column table:style-name="BankOptionCol"/>
        <table:table-column table:style-name="BankInputCol2"/>
        <table:table-column table:style-name="BankBranchCol"/>
        <table:table-row table:style-name="TallOptionRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="styleBankOption">□ 信用金庫</text:p>
            <text:p text:style-name="styleBankOption">□ 信用組合</text:p>
            <text:p>□ （　　　　）</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="styleBankOption">□ 支店</text:p>
            <text:p>□ 出張所</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="Cell"><text:p>種　　別</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>□ 普通　　　□ 当座</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>口座番号</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <table:table table:style-name="WideTable">
        <table:table-column table:style-name="WideCol1"/>
        <table:table-column table:style-name="WideCol2"/>
        <table:table-column table:style-name="WideCol3"/>
        <table:table-column table:style-name="WideCol4"/>
        <table:table-column table:style-name="WideCol5"/>
        <table:table-column table:style-name="WideCol6"/>
        <table:table-column table:style-name="WideCol7"/>
        <table:table-column table:style-name="WideCol8"/>
        <table:table-column table:style-name="WideCol9"/>
        <table:table-column table:style-name="WideCol10"/>
        <table:table-column table:style-name="WideCol11"/>
        <table:table-column table:style-name="WideCol12"/>
        <table:table-column table:style-name="WideCol13"/>
        <table:table-column table:style-name="WideCol14"/>
        <table:table-column table:style-name="WideCol15"/>
        <table:table-column table:style-name="WideCol16"/>
        <table:table-column table:style-name="WideCol17"/>
        <table:table-column table:style-name="WideCol18"/>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>ゆ　う　ち　ょ</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>記号</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p>番号</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <table:table table:style-name="WideTable">
        <table:table-column table:style-name="WideCol1"/>
        <table:table-column table:style-name="WideCol2"/>
        <table:table-column table:style-name="WideCol3"/>
        <table:table-column table:style-name="WideCol4"/>
        <table:table-column table:style-name="WideCol5"/>
        <table:table-row table:style-name="RowInput">
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>口座名義人　※申請者と同一</text:p><text:p>　　　　　　※カタカナで記入</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"/>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>