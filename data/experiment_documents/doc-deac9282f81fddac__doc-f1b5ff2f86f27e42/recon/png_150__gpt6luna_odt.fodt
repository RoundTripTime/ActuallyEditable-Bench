<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
                 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
                 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
                 xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
                 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
                 office:mimetype="application/vnd.oasis.opendocument.text"
                 office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:font-size="10pt" fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt" style:font-name="serif"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="1.3cm" fo:margin-bottom="0.8cm"/>
      <style:text-properties fo:font-size="17pt"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0.4cm"/>
    </style:style>
    <style:style style:name="Address" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.3cm" fo:margin-left="0.5cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Intro" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="1.6cm" fo:margin-bottom="0.6cm" fo:margin-left="0.2cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Heading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.3cm" fo:margin-bottom="0.1cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Foot" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.15cm" fo:margin-left="0.3cm"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Input" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle" fo:background-color="#fffde3"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="SmallCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.04cm" style:vertical-align="middle"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.6cm" fo:margin-bottom="1.5cm" fo:margin-left="2.1cm" fo:margin-right="2.1cm"/>
    </style:page-layout>
    <style:style style:name="P0" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
    <style:style style:name="T16" style:family="table-column">
      <style:table-column-properties style:column-width="1.05cm"/>
    </style:style>
    <style:style style:name="T6" style:family="table-column">
      <style:table-column-properties style:column-width="2.8cm"/>
    </style:style>
    <style:style style:name="T2" style:family="table-column">
      <style:table-column-properties style:column-width="8.4cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="P0"/>
      <text:p text:style-name="Title">環境美化運動実施報告および補助金交付申請書</text:p>
      <text:p text:style-name="Right">令　和　　年　　月　　日</text:p>
      <text:p text:style-name="Address">飯 綱 町 長　様</text:p>
      <table:table table:name="Applicant">
        <table:table-column table:style-name="T2"/>
        <table:table-column table:style-name="T2"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>子ども会･育成会名</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>代表者</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p>　　　　　　　　　　　　　　　㊞</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Intro">下記のとおり環境美化運動事業実施しましたので、補助金の交付を申請します。</text:p>
      <text:p text:style-name="Heading">1．実施した事業の概要</text:p>
      <table:table table:name="事業の概要">
        <table:table-column table:style-name="T16" table:number-columns-repeated="16"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>実施内容</text:p></table:table-cell>
          <table:covered-table-cell/><table:table-cell table:style-name="Input" table:number-columns-spanned="14"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>実 施 期 日</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>令和</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>年</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>月</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>日　～　令和</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>年</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>月</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>実施場所</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Input" table:number-columns-spanned="14"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>参 加 者</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>子ども</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>指導員</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>育成会</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>合 計</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>名</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>協力団体</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Input" table:number-columns-spanned="14"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2" table:number-rows-spanned="2"><text:p>ゴミなどの収 集 量</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>可燃ゴミ</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>空き缶</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>空きビン</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>ペットボトル</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>プラスチック</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>金 属 類</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>そ の 他</text:p></table:table-cell><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p>袋</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p>袋</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p>袋</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p>袋</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p>袋</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p>袋</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p>袋</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Heading">2．事業に伴う経費</text:p>
      <table:table table:name="経費">
        <table:table-column table:style-name="T6" table:number-columns-repeated="6"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">区　分</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">金　額</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="1"><text:p text:style-name="Center">説　明</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">区　分</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">金　額</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">説　明</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>材　料　費</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>食　糧　費</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>備品購入費</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Right">※ 経費の合計金額　　　円</text:p>
      <text:p text:style-name="Right">※ 上限額の計算　150 円 ×　　　人 ＝　　　　円</text:p>
      <text:p text:style-name="Heading">3．補助金交付申請額　　円　　事業に伴う経費の合計金額と参加した子ども１人につき150円(上限額)の金額との少ない方の額</text:p>
      <text:p text:style-name="Heading">4．添付書類</text:p>
      <text:p text:style-name="Foot">① 領収書(写)　　②開催通知等事業の実施がわかるもの</text:p>
      <text:p text:style-name="Foot">③ 写真３枚程度（子どもの作業風景・集積したゴミ等）</text:p>
      <text:p text:style-name="Foot">※ 「協力団体」欄には、育成会以外で一緒に行った団体がある場合に、その団体名を記載すること</text:p>
      <text:p text:style-name="Foot">※ 「ゴミなどの収集量等」欄は、単位を袋としているが重さ(kg)などの単位への変更は自由</text:p>
      <text:p text:style-name="Right">環境美化運動事業補助金実施報告および交付申請書 230310</text:p>
    </office:text>
  </office:body>
</office:document>