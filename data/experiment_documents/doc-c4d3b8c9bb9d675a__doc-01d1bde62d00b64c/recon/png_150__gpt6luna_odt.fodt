<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt" style:font-size-asian="10pt" style:font-family-asian="serif"/>
    </style:style>
    <style:style style:name="Start" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:break-before="page" fo:text-align="center" fo:margin-bottom="0.2cm"/>
      <style:text-properties fo:font-size="18pt" style:font-size-asian="18pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:text-align="right"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="Page">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="2.8cm" fo:margin-bottom="2.3cm" fo:margin-left="2.5cm" fo:margin-right="2.5cm"/>
    </style:page-layout>
    <style:style style:name="Tbl" style:family="table">
      <style:table-properties style:width="16cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="C1" style:family="table-column">
      <style:table-column-properties style:column-width="0.9cm"/>
    </style:style>
    <style:style style:name="C2" style:family="table-column">
      <style:table-column-properties style:column-width="5.2cm"/>
    </style:style>
    <style:style style:name="C3" style:family="table-column">
      <style:table-column-properties style:column-width="2.2cm"/>
    </style:style>
    <style:style style:name="C4" style:family="table-column">
      <style:table-column-properties style:column-width="3.8cm"/>
    </style:style>
    <style:style style:name="C5" style:family="table-column">
      <style:table-column-properties style:column-width="3.9cm"/>
    </style:style>
    <style:style style:name="Plain" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Open" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Top" style:family="table-cell">
      <style:table-cell-properties fo:border-top="0.5pt solid #000000" fo:border-left="0.5pt solid #000000" fo:border-right="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Sides" style:family="table-cell">
      <style:table-cell-properties fo:border-left="0.5pt solid #000000" fo:border-right="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Bottom" style:family="table-cell">
      <style:table-cell-properties fo:border-bottom="0.5pt solid #000000" fo:border-left="0.5pt solid #000000" fo:border-right="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Grid" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Label" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Tall" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.72cm"/>
    </style:style>
    <style:style style:name="Deep" style:family="table-row">
      <style:table-row-properties style:min-row-height="1.15cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="Page"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Start">道　路　占　用　届　出　書</text:p>
      <table:table table:name="届出書" table:style-name="Tbl">
        <table:table-column table:style-name="C1"/>
        <table:table-column table:style-name="C2"/>
        <table:table-column table:style-name="C3"/>
        <table:table-column table:style-name="C4"/>
        <table:table-column table:style-name="C5"/>
        <table:table-row table:style-name="Tall">
          <table:table-cell table:style-name="Top" table:number-columns-spanned="2"><text:p text:style-name="P"/></table:table-cell>
          <table:covered-table-cell table:style-name="Open"/>
          <table:table-cell table:style-name="Top" table:number-columns-spanned="3"><text:p text:style-name="P">届出日：　　年　　月　　日</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
        </table:table-row>
        <table:table-row table:style-name="Tall">
          <table:table-cell table:style-name="Sides" table:number-columns-spanned="2" table:number-rows-spanned="5"><text:p text:style-name="P">高知土木事務所長　様</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="Open"/>
          <table:table-cell table:style-name="Open" table:number-columns-spanned="3"><text:p text:style-name="P">住　所</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
        </table:table-row>
        <table:table-row table:style-name="Tall">
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
          <table:table-cell table:style-name="Open" table:number-columns-spanned="3"><text:p text:style-name="P">氏　名</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
        </table:table-row>
        <table:table-row table:style-name="Tall">
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
          <table:table-cell table:style-name="Open" table:number-columns-spanned="3"><text:p text:style-name="P">担当者（連絡先）</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
        </table:table-row>
        <table:table-row table:style-name="Tall">
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
          <table:table-cell table:style-name="Open" table:number-columns-spanned="3"><text:p text:style-name="P">氏　名</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
        </table:table-row>
        <table:table-row table:style-name="Tall">
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
          <table:table-cell table:style-name="Open" table:number-columns-spanned="3"><text:p text:style-name="P">電　話</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
        </table:table-row>
        <table:table-row table:style-name="Deep">
          <table:table-cell table:style-name="Sides" table:number-columns-spanned="2"><text:p text:style-name="P">道路の占用について、</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="Open"/>
          <table:table-cell table:style-name="Open" table:number-columns-spanned="3">
            <text:p text:style-name="P">工事を完了した</text:p>
            <text:p text:style-name="P">工事を中止した</text:p>
            <text:p text:style-name="P">軽易な事項を変更※した　ので、届け出ます。</text:p>
            <text:p text:style-name="P">（※住所等の変更を含む）</text:p>
            <text:p text:style-name="P">廃　止　し　た</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Sides" table:number-columns-spanned="5"><text:p text:style-name="Right">※該当するものを○で囲むか又は不要な文言を削除すること。</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Bottom" table:number-columns-spanned="5"><text:p text:style-name="Right">※占用許可者（申請者）の交代は、占用許可申請書を提出すること。</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
        </table:table-row>
        <table:table-row table:style-name="Tall">
          <table:table-cell table:style-name="Label" table:number-columns-spanned="2"><text:p text:style-name="P">完了（中止）・変更・廃止した日</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="Open"/>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="3"><text:p text:style-name="Center">年　　月　　日</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
        </table:table-row>
        <table:table-row table:style-name="Deep">
          <table:table-cell table:style-name="Label" table:number-columns-spanned="2"><text:p text:style-name="P">届出内容及び理由等</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="Open"/>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="3">
            <text:p text:style-name="P">※「工事の中止」の場合は理由を、「軽易な事項の変更」「住所</text:p>
            <text:p text:style-name="P">（氏名）の変更」の場合は内容（変更前後の事項、住所等）及</text:p>
            <text:p text:style-name="P">び理由を記入のこと。</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
        </table:table-row>
        <table:table-row table:style-name="Tall">
          <table:table-cell table:style-name="Label" table:number-rows-spanned="6"><text:p text:style-name="P">既</text:p><text:p text:style-name="P">許</text:p><text:p text:style-name="P">可</text:p><text:p text:style-name="P">事</text:p><text:p text:style-name="P">項</text:p></table:table-cell>
          <table:table-cell table:style-name="Label"><text:p text:style-name="P">占用許可番号及び許可年月日</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="3"><text:p text:style-name="Center">高知県指令　　第　　号　・　　年　　月　　日</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
        </table:table-row>
        <table:table-row table:style-name="Tall">
          <table:table-cell table:style-name="Label"><text:p text:style-name="P">占　用　目　的</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="3"><text:p text:style-name="P"/></table:table-cell>
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
        </table:table-row>
        <table:table-row table:style-name="Tall">
          <table:table-cell table:style-name="Label"><text:p text:style-name="P">占用物件の種類及び数量</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="3"><text:p text:style-name="P"/></table:table-cell>
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
        </table:table-row>
        <table:table-row table:style-name="Tall">
          <table:table-cell table:style-name="Label"><text:p text:style-name="P">占用場所及び路線名</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="3"><text:p text:style-name="P"/></table:table-cell>
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
        </table:table-row>
        <table:table-row table:style-name="Tall">
          <table:table-cell table:style-name="Label"><text:p text:style-name="P">占　用　期　間</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="3"><text:p text:style-name="Center">年　　月　　日から　　　年　　月　　日まで</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
        </table:table-row>
        <table:table-row table:style-name="Tall">
          <table:table-cell table:style-name="Label"><text:p text:style-name="P">工　事　期　間</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="3"><text:p text:style-name="Center">年　　月　　日から　　　年　　月　　日まで</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
          <table:covered-table-cell table:style-name="Open"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="P">※許可書の写しを添付した場合は、上記「既許可事項」は省略できます。</text:p>
      <text:p text:style-name="P">※工事の完了届には、状況（施工前、施工中、施工後）写真を添付してください。</text:p>
    </office:text>
  </office:body>
</office:document>