<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:font-face-decls>
    <style:font-face style:name="Mincho" style:font-family="serif"/>
  </office:font-face-decls>
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="120%"/>
      <style:text-properties style:font-name="Mincho" fo:font-size="10.5pt"/>
    </style:default-style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PL1">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="2cm" fo:margin-bottom="1.8cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
    </style:page-layout>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="1pt"/>
      <style:text-properties fo:font-size="1pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0.2cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="15pt"/>
    </style:style>
    <style:style style:name="BodyText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="145%"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="SmallText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="115%"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="CenterText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="TableFrame" style:family="table">
      <style:table-properties style:width="17cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="TopColA" style:family="table-column">
      <style:table-column-properties style:column-width="6cm"/>
    </style:style>
    <style:style style:name="TopColB" style:family="table-column">
      <style:table-column-properties style:column-width="11cm"/>
    </style:style>
    <style:style style:name="GridCol1" style:family="table-column">
      <style:table-column-properties style:column-width="1cm"/>
    </style:style>
    <style:style style:name="GridCol2" style:family="table-column">
      <style:table-column-properties style:column-width="5cm"/>
    </style:style>
    <style:style style:name="GridCol3" style:family="table-column">
      <style:table-column-properties style:column-width="7.2cm"/>
    </style:style>
    <style:style style:name="GridCol4" style:family="table-column">
      <style:table-column-properties style:column-width="3.8cm"/>
    </style:style>
    <style:style style:name="FrameCell" style:family="table-cell">
      <style:table-cell-properties fo:border-left="0.5pt solid #000000" fo:border-right="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="FrameTopCell" style:family="table-cell">
      <style:table-cell-properties fo:border-top="0.5pt solid #000000" fo:border-left="0.5pt solid #000000" fo:border-right="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="FrameBottomCell" style:family="table-cell">
      <style:table-cell-properties fo:border-bottom="0.5pt solid #000000" fo:border-left="0.5pt solid #000000" fo:border-right="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="GridCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="GridCellTop" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="GridLabel" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="TableMain" style:family="table">
      <style:table-properties style:width="17cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PL1"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="Title">道　路　占　用　届　出　書</text:p>
      <table:table table:name="TopFrame" table:style-name="TableFrame">
        <table:table-column table:style-name="TopColA"/>
        <table:table-column table:style-name="TopColB"/>
        <table:table-row>
          <table:table-cell table:style-name="FrameTopCell">
            <text:p text:style-name="BodyText"/>
          </table:table-cell>
          <table:table-cell table:style-name="FrameTopCell">
            <text:p text:style-name="BodyText">届出日：　　　年　　月　　日</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FrameCell">
            <text:p text:style-name="BodyText">高知土木事務所　様</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FrameCell">
            <text:p text:style-name="BodyText">住　所</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FrameCell"><text:p text:style-name="BodyText"/></table:table-cell>
          <table:table-cell table:style-name="FrameCell"><text:p text:style-name="BodyText">氏　名</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FrameCell"><text:p text:style-name="BodyText"/></table:table-cell>
          <table:table-cell table:style-name="FrameCell"><text:p text:style-name="BodyText">担当者（連絡先）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FrameCell"><text:p text:style-name="BodyText"/></table:table-cell>
          <table:table-cell table:style-name="FrameCell"><text:p text:style-name="BodyText">氏　名</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FrameCell"><text:p text:style-name="BodyText"/></table:table-cell>
          <table:table-cell table:style-name="FrameCell"><text:p text:style-name="BodyText">電　話</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FrameBottomCell">
            <text:p text:style-name="BodyText">道路の占用について、</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FrameBottomCell">
            <text:p text:style-name="BodyText">工事を完了した</text:p>
            <text:p text:style-name="BodyText">工事を中止した</text:p>
            <text:p text:style-name="BodyText">軽易な事項を変更※した　ので、届け出ます。</text:p>
            <text:p text:style-name="SmallText">（※住所等の変更を含む）</text:p>
            <text:p text:style-name="BodyText">廃　止　し　た</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="SmallText">※該当するものを○で囲むか又は不要な文言を削除すること。</text:p>
      <text:p text:style-name="SmallText">※占用許可者（申請者）の交代は、占用許可申請書を提出すること。</text:p>
      <table:table table:name="FormGrid" table:style-name="TableMain">
        <table:table-column table:style-name="GridCol1"/>
        <table:table-column table:style-name="GridCol2"/>
        <table:table-column table:style-name="GridCol3"/>
        <table:table-column table:style-name="GridCol4"/>
        <table:table-row>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p text:style-name="CenterText">完了（中止）・変更・廃止した日</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p text:style-name="CenterText">年　　　月　　　日</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p text:style-name="CenterText">届出内容及び理由等</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridCellTop" table:number-columns-spanned="2">
            <text:p text:style-name="SmallText">※「工事の中止」の場合は理由を、「軽易な事項の変更」「住所</text:p>
            <text:p text:style-name="SmallText">（氏名）の変更」の場合は内容（変更前後の事項、住所等）及</text:p>
            <text:p text:style-name="SmallText">び理由を記入のこと。</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell" table:number-rows-spanned="6">
            <text:p text:style-name="CenterText">既</text:p>
            <text:p text:style-name="CenterText">許</text:p>
            <text:p text:style-name="CenterText">可</text:p>
            <text:p text:style-name="CenterText">事</text:p>
            <text:p text:style-name="CenterText">項</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="GridLabel"><text:p text:style-name="CenterText">占用許可番号及び許可年月日</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p text:style-name="CenterText">高知県指令　　　第　　　号・　　　年　　月　　日</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridLabel"><text:p text:style-name="CenterText">占　用　目　的</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p text:style-name="BodyText"/></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridLabel"><text:p text:style-name="CenterText">占用物件の種類及び数量</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p text:style-name="BodyText"/></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridLabel"><text:p text:style-name="CenterText">占用場所及び路線名</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p text:style-name="BodyText"/></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridLabel"><text:p text:style-name="CenterText">占　用　期　間</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p text:style-name="CenterText">年　　月　　日から　　　年　　月　　日まで</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridLabel"><text:p text:style-name="CenterText">工　事　期　間</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p text:style-name="CenterText">年　　月　　日から　　　年　　月　　日まで</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="SmallText">※許可書の写しを添付した場合は、上記「既許可事項」は省略できます。</text:p>
      <text:p text:style-name="SmallText">※工事の完了届には、状況（施工前、施工中、施工後）写真を添付してください。</text:p>
    </office:text>
  </office:body>
</office:document>