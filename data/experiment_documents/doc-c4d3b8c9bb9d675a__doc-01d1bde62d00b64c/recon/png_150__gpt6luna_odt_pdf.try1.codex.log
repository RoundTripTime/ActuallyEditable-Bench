          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p text:style-name="CenterText">高知県指令　　　第　　　号・　　　年　　月　　日</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridLabel"><text:p text:style-name="CenterText">占　用　目　的</text:p></table:table-cell>
