          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p text:style-name="CenterText">年　　　月　　　日</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p text:style-name="CenterText">届出内容及び理由等</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridCellTop" table:number-columns-spanned="2">
            <text:p text:style-name="SmallText">※「工事の中止」の場合は理由を、「軽易な事項の変更」「住所</text:p>
            <text:p text:style-name="SmallText">（氏名）の変更」の場合は内容（変更前後の事項、住所等）及</text:p>
