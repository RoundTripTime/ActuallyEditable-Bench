<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Normal" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.08cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.35cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-size="16pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="BoldNote" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.04cm" fo:margin-bottom="0.04cm"/>
      <style:text-properties fo:font-size="10pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="middle"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="NoBorderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0.02cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="VerticalCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0.02cm" style:vertical-align="middle" style:writing-mode="tb-rl"/>
      <style:text-properties fo:font-size="9pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Grid" style:family="table">
      <style:table-properties style:width="18.4cm" table:align="center"/>
    </style:style>
    <style:style style:name="Col0" style:family="table-column">
      <style:table-column-properties style:column-width="0.5cm"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="7.16cm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="1.5cm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="3.87cm"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties style:column-width="1.5cm"/>
    </style:style>
    <style:style style:name="Col5" style:family="table-column">
      <style:table-column-properties style:column-width="3.87cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1cm" fo:margin-bottom="1cm" fo:margin-left="1.3cm" fo:margin-right="1.3cm" style:print-orientation="portrait"/>
    </style:page-layout>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0.06cm"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0cm" fo:margin-bottom="0.06cm"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="CellP" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Right">（様式第４号）</text:p>
      <text:p text:style-name="Right">令和　　年　　月　　日</text:p>
      <text:p text:style-name="Normal">海田町長　様</text:p>
      <text:p text:style-name="Right">団体名　＿＿＿＿＿＿＿＿＿＿</text:p>
      <text:p text:style-name="Right">スタンプ番号　＿＿＿＿＿＿＿＿</text:p>
      <text:p text:style-name="Right">代表者住所　＿＿＿＿＿＿＿＿</text:p>
      <text:p text:style-name="Right">代表者氏名　＿＿＿＿＿＿＿＿</text:p>
      <text:p text:style-name="Right">連絡先氏名及び電話番号　（　　　　）　　　　―　　　　―</text:p>
      <text:p text:style-name="Title">高齢者いきいき活動ポイント事業活動団体登録内容変更届出書</text:p>
      <text:p text:style-name="Normal">高齢者いきいき活動ポイント事業の活動団体として届け出た内容に下記のとおり変更がありましたので、</text:p>
      <text:p text:style-name="Normal">届け出ます。</text:p>
      <text:p text:style-name="Center">記</text:p>
      <text:p text:style-name="BoldNote">※　変更のあった項目欄にのみ記載してください（変更のない項目欄には記載しないでください）。</text:p>
      <text:p text:style-name="BoldNote">※　登録内容を追加する場合には、変更後の欄に、追加する内容だけでなく変更前の欄に記載している内容も</text:p>
      <text:p text:style-name="BoldNote">　　併せて記載してください（記入例を参照）。</text:p>
      <table:table table:name="変更内容" table:style-name="Grid">
        <table:table-column table:style-name="Col0"/>
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-column table:style-name="Col5"/>
        <table:table-row>
          <table:table-cell table:style-name="NoBorderCell"/>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="CellCenter">変更項目</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="HeaderCell"><text:p text:style-name="CellCenter">変更前</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="HeaderCell"><text:p text:style-name="CellCenter">変更後</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:number-rows-spanned="19" table:style-name="VerticalCell"><text:p text:style-name="CellCenter">代表者を変更する場合は、住所の変更も併せて御確認ください。</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">団体名</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"/>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">代表者の住所又は</text:p><text:p text:style-name="CellP">団体（グループ）の所在地（スタンプ送付先）</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"/>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">ホームページアドレス</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"/>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">メールアドレス</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"/>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">代表者氏名・連絡先電話番号</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"/>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">スタンプ管理責任者氏名・連絡先電話番号</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"/>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">スタンプ管理副責任者氏名・連絡先電話番号</text:p><text:p text:style-name="CellP">※　変更する者が多数の場合は別紙を添付してください。</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"/>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">主な活動場所</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"/>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:number-rows-spanned="11" table:style-name="Cell">
            <text:p text:style-name="CellP">活動内容</text:p>
            <text:p text:style-name="CellP">（該当する記号に○印を付けてください。</text:p>
            <text:p text:style-name="CellP">複数の活動を行っている場合は、複数の記号に○印を付けてください。E～Hに○を付ける場合には、活動のポイント数にも○を付けてください。）</text:p>
          </table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p text:style-name="CellP">記号に○をお願いします。</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p text:style-name="CellP">記号に○をお願いします。</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">ア</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">A</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">ア</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">A</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">イ</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">B</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">イ</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">B</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">ウ</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">C</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">ウ</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">C</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">エ</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">D</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">エ</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">D</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">オ</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">E（２Ｐ・４Ｐ）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">オ</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">E（２Ｐ・４Ｐ）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">カ</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">F（２Ｐ・４Ｐ）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">カ</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">F（２Ｐ・４Ｐ）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">キ</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">G（２Ｐ・４Ｐ）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">キ</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">G（２Ｐ・４Ｐ）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">ク</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">H（２Ｐ・４Ｐ）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">ク</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">H（２Ｐ・４Ｐ）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:number-rows-spanned="2" table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">I</text:p></table:cell>
          <table:table-cell table:number-rows-spanned="2" table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">I</text:p></table:cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">J</text:p></table:cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">J</text:p></table:cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Normal">【留意事項】</text:p>
      <text:p text:style-name="Normal">　変更後の内容でスタンプを押印していただけるのは、町が登録内容変更届出書を受け付けた後になります。</text:p>
      <text:p text:style-name="PageBreak">（町が登録内容変更届出書を受け付ける前に変更後の内容でスタンプを押印することはできません。）</text:p>
    </office:text>
  </office:body>
</office:document>