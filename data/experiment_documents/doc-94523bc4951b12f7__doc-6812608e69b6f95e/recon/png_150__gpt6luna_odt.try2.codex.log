        <table:table-column table:style-name="ColOption"/>
        <table:table-column table:style-name="ColOption"/>
        <table:table-row>
          <table:table-cell table:style-name="VerticalCell" table:number-rows-spanned="20"><text:p>代表者を変更する場合は、住所の変更も併せて御確認ください。</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>変更項目</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter" table:number-columns-spanned="2"><text:p>変更前</text:p></table:table-cell>
