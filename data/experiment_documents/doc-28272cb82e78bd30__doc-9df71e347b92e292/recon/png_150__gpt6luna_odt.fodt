<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.18cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="12pt" style:font-name="serif"/>
    </style:default-style>
    <style:style style:name="DefaultTable" style:family="table">
      <style:table-properties table:align="margins"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-top="1.8cm" fo:margin-bottom="1.8cm" fo:margin-left="1.9cm" fo:margin-right="1.9cm"/>
    </style:page-layout>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="2.6cm"/>
    </style:style>
    <style:style style:name="SmallText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="1.2cm" fo:margin-bottom="1.5cm"/>
      <style:text-properties fo:font-size="17pt"/>
    </style:style>
    <style:style style:name="AmountTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="1cm" fo:margin-bottom="0.5cm"/>
      <style:text-properties fo:font-size="21pt"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" fo:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" fo:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellNoBorder" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0.05cm" fo:vertical-align="middle"/>
    </style:style>
    <style:style style:name="UnderlineCell" style:family="table-cell">
      <style:table-cell-properties fo:border-bottom="0.7pt solid #000000" fo:padding="0.06cm" fo:vertical-align="middle"/>
    </style:style>
    <style:style style:name="ShortRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.65cm"/>
    </style:style>
    <style:style style:name="TallRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.15cm"/>
    </style:style>
    <style:style style:name="LargeRow" style:family="table-row">
      <style:table-row-properties style:row-height="2.5cm"/>
    </style:style>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="2.15cm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="1.55cm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="1.85cm"/>
    </style:style>
    <style:style style:name="ColBank" style:family="table-column">
      <style:table-column-properties style:column-width="1.43cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p>様式２号</text:p>
      <text:p style:style-name="Right">年　　　月　　　日</text:p>
      <text:p>美作市長　　　様</text:p>
      <text:p/>
      <table:table table:name="Claimant" table:style-name="DefaultTable">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColA"/>
        <table:table-row>
          <table:table-cell table:style-name="CellNoBorder"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellNoBorder"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellNoBorder"><text:p>請求者　住所</text:p></table:table-cell>
          <table:table-cell table:style-name="UnderlineCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellNoBorder"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellNoBorder"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellNoBorder"><text:p>氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="UnderlineCell"><text:p>印</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellNoBorder"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellNoBorder"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellNoBorder"><text:p>電話番号</text:p></table:table-cell>
          <table:table-cell table:style-name="UnderlineCell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p style:style-name="Title">美作市がん患者医療用補整具（アピアランスケア）助成金請求書</text:p>
      <text:p>美作市がん患者医療用補整具（アピアランスケア）助成金交付要綱第９条の規定により助成金を</text:p>
      <text:p>請求します。</text:p>
      <text:p style:style-name="AmountTitle">請求額</text:p>
      <table:table table:name="Amount" table:style-name="DefaultTable">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColA"/>
        <table:table-row>
          <table:table-cell table:number-columns-spanned="3" table:style-name="UnderlineCell"><text:p>￥</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellNoBorder"><text:p style:style-name="Right">円</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p/>
      <table:table table:name="ApplicantAndExpenses" table:style-name="DefaultTable">
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColA"/>
        <table:table-row table:style-name="TallRow">
          <table:table-cell table:number-rows-spanned="3" table:style-name="Cell"><text:p><text:line-break/>助<text:line-break/>成<text:line-break/>対<text:line-break/>象<text:line-break/>者</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>フリガナ</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="4" table:style-name="Cell"><text:p>□請求者に同じ</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p style:style-name="Center">生年月日</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="TallRow">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>氏名</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="4" table:style-name="Cell"><text:p/></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p style:style-name="Center">年　　　月　　　日</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="LargeRow">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>住所</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="6" table:style-name="Cell"><text:p>美作市　　　　　　　　　　　　　　　　□請求者に同じ</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="LargeRow">
          <table:table-cell table:number-rows-spanned="1" table:style-name="Cell"><text:p><text:line-break/>購<text:line-break/>入<text:line-break/>額</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="Cell"><text:p>医療用ウィッグ等<text:line-break/><text:line-break/><text:line-break/><text:line-break/><text:line-break/>円</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="4" table:style-name="Cell"><text:p>補整具等<text:line-break/><text:line-break/><text:line-break/><text:line-break/><text:line-break/>円</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p style:style-name="PageBreak"/>
      <table:table table:name="DesignatedBankAccount" table:style-name="DefaultTable">
        <table:table-column table:style-name="ColBank"/>
        <table:table-column table:style-name="ColBank"/>
        <table:table-column table:style-name="ColBank"/>
        <table:table-column table:style-name="ColBank"/>
        <table:table-column table:style-name="ColBank"/>
        <table:table-column table:style-name="ColBank"/>
        <table:table-column table:style-name="ColBank"/>
        <table:table-column table:style-name="ColBank"/>
        <table:table-column table:style-name="ColBank"/>
        <table:table-column table:style-name="ColBank"/>
        <table:table-column table:style-name="ColBank"/>
        <table:table-column table:style-name="ColBank"/>
        <table:table-row table:style-name="ShortRow">
          <table:table-cell table:number-rows-spanned="6" table:style-name="Cell"><text:p><text:line-break/>指<text:line-break/>定<text:line-break/>口<text:line-break/>座</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p style:style-name="Center">金融機関名</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="4" table:style-name="Cell"><text:p/></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p style:style-name="Center">銀行　農協<text:line-break/>金庫　組合</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>本・支店</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ShortRow">
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p>銀行等</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p>口座番号</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p style:style-name="Center">預金種別</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="4" table:style-name="Cell"><text:p style:style-name="Center">普通　・　当座</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="TallRow">
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="3" table:style-name="Cell"><text:p>郵便局（ゆうちょ銀行）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p style:style-name="Center">記　号<text:line-break/>（５ケタ）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p/></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p style:style-name="Center">番　号<text:line-break/>（８ケタ）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ShortRow">
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="4" table:style-name="Cell"><text:p style:style-name="Center">金融機関コード</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="4" table:style-name="Cell"><text:p style:style-name="Center">店舗コード</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="3" table:style-name="Cell"><text:p/></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="TallRow">
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p>口座名義</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>カ　ナ</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="TallRow">
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p>口座名義</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>名　義　人</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="8" table:style-name="Cell"><text:p/></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>