<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:font-size="11pt" fo:margin-top="0cm" fo:margin-bottom="0.15cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.1cm"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0cm" fo:margin-bottom="0.1cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0.1cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="1.1cm" fo:margin-bottom="1.35cm"/>
      <style:text-properties fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="Amount" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="1.1cm" fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-size="19pt"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.12cm" style:vertical-align="middle"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="CellSmall" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.05cm" style:vertical-align="middle"/>
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
    <style:style style:name="CellLabel" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.1cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.1cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="LineCell" style:family="table-cell">
      <style:table-cell-properties fo:border-bottom="0.7pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Table" style:family="table">
      <style:table-properties style:width="17.5cm"/>
    </style:style>
    <style:style style:name="BankTable" style:family="table">
      <style:table-properties style:width="16.6cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="1.9cm" fo:margin-right="1.9cm"/>
    </style:page-layout>
    <style:style style:name="P1" style:family="table-column">
      <style:table-column-properties style:column-width="1cm"/>
    </style:style>
    <style:style style:name="P2" style:family="table-column">
      <style:table-column-properties style:column-width="1.8cm"/>
    </style:style>
    <style:style style:name="P3" style:family="table-column">
      <style:table-column-properties style:column-width="8.5cm"/>
    </style:style>
    <style:style style:name="P4" style:family="table-column">
      <style:table-column-properties style:column-width="3.1cm"/>
    </style:style>
    <style:style style:name="P5" style:family="table-column">
      <style:table-column-properties style:column-width="3.1cm"/>
    </style:style>
    <style:style style:name="BCol" style:family="table-column">
      <style:table-column-properties style:column-width="1.66cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Small">様式２号</text:p>
      <text:p text:style-name="Right">年　　　　月　　　　日</text:p>
      <text:p text:style-name="Body">美作市長　　様</text:p>
      <text:p text:style-name="Right">請求者　住所　________________________________</text:p>
      <text:p text:style-name="Right">氏名　________________________________　印</text:p>
      <text:p text:style-name="Right">電話番号　________________________________</text:p>
      <text:p text:style-name="Title">美作市がん患者医療用補整具（アピアランスケア）助成金請求書</text:p>
      <text:p text:style-name="Body">美作市がん患者医療用補整具（アピアランスケア）助成金交付要綱第９条の規定により助成金を</text:p>
      <text:p text:style-name="Body">請求します。</text:p>
      <text:p text:style-name="Amount">請求額</text:p>
      <table:table table:name="請求額" table:style-name="Table">
        <table:table-column table:style-name="P1"/>
        <table:table-column table:style-name="P2"/>
        <table:table-column table:style-name="P3"/>
        <table:table-column table:style-name="P4"/>
        <table:table-column table:style-name="P5"/>
        <table:table-row>
          <table:table-cell table:number-columns-spanned="5" table:style-name="LineCell"><text:p>￥　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　円</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <table:table table:name="助成対象者・購入額" table:style-name="Table">
        <table:table-column table:style-name="P1"/>
        <table:table-column table:style-name="P2"/>
        <table:table-column table:style-name="P3"/>
        <table:table-column table:style-name="P4"/>
        <table:table-column table:style-name="P5"/>
        <table:table-row>
          <table:table-cell table:number-rows-spanned="3" table:style-name="CellCenter"><text:p>助</text:p><text:p>成</text:p><text:p>対</text:p><text:p>象</text:p><text:p>者</text:p></table:table-cell>
          <table:table-cell table:style-name="CellLabel"><text:p>フリガナ</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p/></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellLabel"><text:p>生年月日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellLabel"><text:p>氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>□請求者に同じ</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>年　　　　月　　　　日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellLabel"><text:p>住所</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="Cell"><text:p>美作市　　　　　　　　　　　　　　　　　　　　　　　　　□請求者に同じ</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:number-rows-spanned="2" table:style-name="CellCenter"><text:p>購</text:p><text:p>入</text:p><text:p>額</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p>医療用ウィッグ等</text:p><text:p>　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　円</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p>補整具等</text:p><text:p>　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　円</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p/></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p/></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageBreak"/>
      <table:table table:name="指定口座" table:style-name="BankTable">
        <table:table-column table:style-name="BCol" table:number-columns-repeated="10"/>
        <table:table-row>
          <table:table-cell table:number-rows-spanned="6" table:style-name="CellCenter"><text:p>口座振込先</text:p><text:p>指</text:p><text:p>定</text:p><text:p>口</text:p><text:p>座</text:p></table:table-cell>
          <table:table-cell table:number-rows-spanned="2" table:style-name="CellCenter"><text:p>銀行等</text:p></table:table-cell>
          <table:table-cell table:number-rows-spanned="2" table:style-name="CellCenter"><text:p>金融機関名</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="4" table:style-name="Cell"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="CellCenter"><text:p>銀行　農協</text:p><text:p>金庫　組合</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellCenter"><text:p>本</text:p><text:p>・</text:p><text:p>支</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="4" table:style-name="Cell"><text:p>口座番号</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="CellCenter"><text:p>預金種別</text:p><text:p>普通　・　当座</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="CellCenter"><text:p>郵便局（ゆうちょ銀行）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="CellCenter"><text:p>記　号</text:p><text:p>（５ケタ）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="CellCenter"><text:p>番　号</text:p><text:p>（８ケタ）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p/></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="3" table:style-name="CellCenter"><text:p>金融機関コード</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="4" table:style-name="CellCenter"><text:p>店舗コード</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:number-rows-spanned="2" table:style-name="CellCenter"><text:p>口座名義</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>カ　ナ</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="7" table:style-name="Cell"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="CellCenter"><text:p>名　義　人</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="7" table:style-name="Cell"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>