<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Normal" style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph" style:parent-style-name="Normal">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="18pt"/>
    </style:style>
    <style:style style:name="Centered" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08in" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="ColNarrow" style:family="table-column">
      <style:table-column-properties style:column-width="1.6in"/>
    </style:style>
    <style:style style:name="ColWide" style:family="table-column">
      <style:table-column-properties style:column-width="5.0in"/>
    </style:style>
    <style:style style:name="ColHalf" style:family="table-column">
      <style:table-column-properties style:column-width="3.3in"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="8.27in" fo:page-height="11.69in" fo:margin-top="0.65in" fo:margin-bottom="0.65in" fo:margin-left="0.65in" fo:margin-right="0.65in"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">（様式第１号）</text:p>
      <text:p text:style-name="Title">豊山町ふるさと寄附金返礼品提供事業者申出書</text:p>
      <text:p text:style-name="Centered">年　　月　　日</text:p>
      <text:p>豊山町長　様</text:p>
      <text:p>　　　　　　　　　　　　　　　（申請者）　所在地＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿</text:p>
      <text:p>　　　　　　　　　　　　　　　　　　　　　事業者名＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿</text:p>
      <text:p>　　　　　　　　　　　　　　　　　　　　　代表者名＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿</text:p>
      <text:p>豊山町ふるさと寄附金返礼品提供事業者募集要領に基づき、返礼品提供事業者として応募するとともに、以下の商品を返礼品として提案します。</text:p>
      <text:p>１．企業等情報</text:p>
      <table:table table:name="企業等情報">
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-column table:style-name="ColWide"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2"><text:p>（１）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>ふ　り　が　な</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>事　業　者　名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>（２）所在地</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>〒</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2" table:number-rows-spanned="5"><text:p>（３）担当者</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>所　属　部　署</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>ふりがな</text:p><text:p>担当者氏名</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>電　話　番　号</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>Ｆ　Ａ　Ｘ　番　号</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>メールアドレス</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>（４）事業者情報</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>事業者ホームページの有無：（　有　・　無　）</text:p><text:p>ＨＰアドレス：</text:p><text:p>※会社概要がわかるパンフレット等があれば添付してください。</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p>２．集荷先等</text:p>
      <table:table table:name="集荷先等">
        <table:table-column table:style-name="ColNarrow"/><table:table-column table:style-name="ColNarrow"/><table:table-column table:style-name="ColWide"/>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-rows-spanned="4"><text:p>（１）集荷先</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>住　　所</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>〒</text:p></table:table-cell></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>電　話　番　号</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>Ｆ　Ａ　Ｘ　番　号</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>発　注　先</text:p><text:p>メールアドレス</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>（２）集荷可能日</text:p><text:p>（可能な日に○）</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>月　　　火　　　水　　　木　　　金　　　土　　　日</text:p><text:p>□　　　 □　　　 □　　　 □　　　 □　　　 □　　　 □</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
      </table:table>

      <text:p text:style-name="PageStart">３．返礼品</text:p>
      <table:table table:name="返礼品">
        <table:table-column table:style-name="ColNarrow"/><table:table-column table:style-name="ColWide"/>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>（１）寄附金額区分</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>□１万円　□２万円　□３万円　□４万円　□５万円以上</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>（２）商品の金額</text:p><text:p>（市場価格／消費税込）</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>　　　　　　　　　　　　　　　　　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>（３）</text:p><text:p>ふりがな</text:p><text:p>商品（セット）名</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>（４）商品の内容（内訳）</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>（５）商品説明（ＰＲ）</text:p><text:p>※200字程度</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>（６）販売・発送可能時期</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>□通年</text:p><text:p>□期間限定（発送時期：　　月～　　月）</text:p><text:p>□個数限定（　　　　個限定）</text:p><text:p>発送方法：□通常　　□冷蔵　　□冷凍</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>（７）その他特記事項</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
      </table:table>
      <text:p>【添付書類】</text:p>
      <text:p>・承認を受けようとする商品が確認できる写真（電子データ可）やチラシ等</text:p>
      <text:p>※申出書は返礼品ごとに記入してください。</text:p>

      <text:p text:style-name="PageStart">（様式第２号）</text:p>
      <text:p text:style-name="Title">誓　約　書</text:p>
      <text:p text:style-name="Centered">年　　月　　日</text:p>
      <text:p>豊山町長　様</text:p>
      <text:p>　　　　　　　　　　　　　　　　　　　　　事業者名＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿</text:p>
      <text:p>　　　　　　　　　　　　　　　　　　　　　代表者名＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿</text:p>
      <text:p>豊山町ふるさと寄附金返礼品提供事業者募集要領に定める以下の協賛企業としての要件全てを満たしていることを誓約します。</text:p>
      <table:table table:name="誓約事項">
        <table:table-column table:style-name="ColWide"/>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>（１）本社（本店）、支社（支店）、事業所、工場が町内にある企業または個人事業所であること</text:p><text:p>（２）納期が到来している町税の滞納がないこと</text:p><text:p>（３）豊山町暴力団排除条例（平成２４年豊山町条例第２号）第２条第２号に規定する暴力団員または同上第１号に規定する暴力団もしくは暴力団員と密接な関係有するものではない者</text:p></table:table-cell></table:table-row>
      </table:table>

      <text:p text:style-name="PageStart">（様式第４号）</text:p>
      <text:p text:style-name="Title">豊山町ふるさと寄附金返礼品　内容変更<br/>承認取消　申請書</text:p>
      <text:p text:style-name="Centered">年　　月　　日</text:p>
      <text:p>豊山町長　様</text:p>
      <text:p>　　　　　　　　　　　　　　　（申請者）</text:p>
      <text:p>　　　　　　　　　　　　　　　　　　　　　住　所＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿</text:p>
      <text:p>　　　　　　　　　　　　　　　　　　　　　事業者名＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿</text:p>
      <text:p>　　　　　　　　　　　　　　　　　　　　　代表者名＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿</text:p>
      <text:p>豊山町ふるさと寄附金返礼品提供事業者募集要領に基づき、次のとおり届け出ます。</text:p>
      <table:table table:name="内容変更承認取消申請">
        <table:table-column table:style-name="ColNarrow"/><table:table-column table:style-name="ColWide"/>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>１．承認番号</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>２．商品名</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>３．届出内容</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>４．内容変更</text:p><text:p>　　承認取消　希望日</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>年　　月　　日</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-rows-spanned="5"><text:p>５．連絡先</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>担　当　部　署</text:p></table:table-cell></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>担　当　者</text:p></table:table-cell></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>電　話　番　号</text:p></table:table-cell></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>ＦＡＸ番号</text:p></table:table-cell></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>電子メール</text:p></table:table-cell></table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>