<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin="0in" fo:line-height="100%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.52in" fo:margin-bottom="0.22in" fo:line-height="1.25"/>
      <style:text-properties fo:font-size="18pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Club" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end" fo:margin-top="0.12in" fo:margin-bottom="0.24in"/>
      <style:text-properties fo:font-size="15pt" style:text-underline-style="solid"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.08in" fo:margin-bottom="0.02in"/>
      <style:text-properties fo:font-size="13pt"/>
    </style:style>
    <style:style style:name="BodyText" style:family="paragraph">
      <style:paragraph-properties fo:margin="0in" fo:line-height="100%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="RightText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin="0in"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin="0in" fo:line-height="0pt"/>
    </style:style>
    <style:style style:name="Footer" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.04in"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="8.27in" fo:page-height="11.69in" style:print-orientation="portrait" fo:margin-top="0.62in" fo:margin-bottom="0.55in" fo:margin-left="0.88in" fo:margin-right="0.50in"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties/>
    </style:style>
    <style:style style:name="LeftColumn" style:family="table-column">
      <style:table-column-properties style:column-width="5.51in"/>
    </style:style>
    <style:style style:name="RightColumn" style:family="table-column">
      <style:table-column-properties style:column-width="1.38in"/>
    </style:style>
    <style:style style:name="HeaderRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.51in"/>
    </style:style>
    <style:style style:name="InputRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.60in"/>
    </style:style>
    <style:style style:name="LastInputRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.85in"/>
    </style:style>
    <style:style style:name="LabelCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06in" style:vertical-align="middle"/>
      <style:paragraph-properties fo:margin="0in" fo:line-height="100%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="CountCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.03in" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center" fo:margin="0in"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="EmptyCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0in" style:vertical-align="top"/>
      <style:paragraph-properties fo:margin="0in" fo:line-height="100%"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">老人クラブ地域活動状況等調査票</text:p>
      <text:p text:style-name="Club">老人クラブ</text:p>
      <text:p text:style-name="Section">1　今年度の活動について</text:p>
      <table:table table:name="活動状況調査票" table:style-name="FormTable">
        <table:table-column table:style-name="LeftColumn"/>
        <table:table-column table:style-name="RightColumn"/>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="BodyText">①友愛活動 ・・・ 地区内のひとり暮らしやねたきりの高齢者宅を訪問し</text:p><text:p text:style-name="BodyText">　　　　　話し相手となるなど</text:p></table:table-cell>
          <table:table-cell table:style-name="CountCell"><text:p text:style-name="RightText">回数・参加者</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="EmptyCell"><text:p text:style-name="BodyText"/></table:table-cell>
          <table:table-cell table:style-name="EmptyCell"><text:p text:style-name="BodyText"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="BodyText">②生活支援活動 ・・・ 近隣の高齢者に対する家事の手助け等</text:p></table:table-cell>
          <table:table-cell table:style-name="CountCell"><text:p text:style-name="RightText">回数・参加者</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="EmptyCell"><text:p text:style-name="BodyText"/></table:table-cell>
          <table:table-cell table:style-name="EmptyCell"><text:p text:style-name="BodyText"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="BodyText">③清掃･奉仕･環境活動 ・・・ リサイクルの実施、歩道などの花壇の整備等</text:p></table:table-cell>
          <table:table-cell table:style-name="CountCell"><text:p text:style-name="RightText">回数・参加者</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="EmptyCell"><text:p text:style-name="BodyText"/></table:table-cell>
          <table:table-cell table:style-name="EmptyCell"><text:p text:style-name="BodyText"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="BodyText">④文化･学習サークル活動 ・・・ 短歌、書道、詩吟、陶芸などの活動</text:p></table:table-cell>
          <table:table-cell table:style-name="CountCell"><text:p text:style-name="RightText">回数・参加者</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="EmptyCell"><text:p text:style-name="BodyText"/></table:table-cell>
          <table:table-cell table:style-name="EmptyCell"><text:p text:style-name="BodyText"/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageBreak"/>
      <table:table table:name="活動状況調査票続き" table:style-name="FormTable">
        <table:table-column table:style-name="LeftColumn"/>
        <table:table-column table:style-name="RightColumn"/>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="BodyText">⑤スポーツサークル活動 ・・・ ゲートボール、グラウンドゴルフ、歩こう会など</text:p></table:table-cell>
          <table:table-cell table:style-name="CountCell"><text:p text:style-name="RightText">回数・参加者</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="EmptyCell"><text:p text:style-name="BodyText"/></table:table-cell>
          <table:table-cell table:style-name="EmptyCell"><text:p text:style-name="BodyText"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="BodyText">⑥安全活動 ・・・ 交差点での交通安全運動など</text:p></table:table-cell>
          <table:table-cell table:style-name="CountCell"><text:p text:style-name="RightText">回数・参加者</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="EmptyCell"><text:p text:style-name="BodyText"/></table:table-cell>
          <table:table-cell table:style-name="EmptyCell"><text:p text:style-name="BodyText"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="BodyText">⑦世代間の交流 ・・・ 地域の子ども会と昔の遊びをするなど</text:p></table:table-cell>
          <table:table-cell table:style-name="CountCell"><text:p text:style-name="RightText">回数・参加者</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="LastInputRow">
          <table:table-cell table:style-name="EmptyCell"><text:p text:style-name="BodyText"/></table:table-cell>
          <table:table-cell table:style-name="EmptyCell"><text:p text:style-name="BodyText"/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Footer">年　　月　　日（　）までに高齢者支援課へ提出してください。</text:p>
    </office:text>
  </office:body>
</office:document>