<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt" fo:color="#000000"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.95cm" fo:margin-bottom="0.75cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="16pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Club" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-bottom="0.65cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="14pt" style:text-underline-style="solid" style:text-underline-width="auto" style:text-underline-color="font-color"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.4cm" fo:margin-bottom="0.05cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="CellText" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.12cm" fo:margin-right="0.08cm" fo:line-height="100%"/>
    </style:style>
    <style:style style:name="CountText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="100%"/>
    </style:style>
    <style:style style:name="Submit" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.18cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="NewPage" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:line-height="100%"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout" style:page-usage="all">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="2.2cm" fo:margin-right="1.2cm" fo:margin-top="1.7cm" fo:margin-bottom="1.2cm"/>
    </style:page-layout>
    <style:style style:name="ColWide" style:family="table-column">
      <style:table-column-properties style:column-width="14cm"/>
    </style:style>
    <style:style style:name="ColNarrow" style:family="table-column">
      <style:table-column-properties style:column-width="3.5cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.05cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HeadRowA" style:family="table-row">
      <style:table-row-properties style:row-height="1.287cm"/>
    </style:style>
    <style:style style:name="BlankRowA" style:family="table-row">
      <style:table-row-properties style:row-height="4.094cm"/>
    </style:style>
    <style:style style:name="HeadRowB" style:family="table-row">
      <style:table-row-properties style:row-height="1.255cm"/>
    </style:style>
    <style:style style:name="BlankRowB" style:family="table-row">
      <style:table-row-properties style:row-height="4.198cm"/>
    </style:style>
    <style:style style:name="HeadRowC" style:family="table-row">
      <style:table-row-properties style:row-height="1.26cm"/>
    </style:style>
    <style:style style:name="BlankRowC" style:family="table-row">
      <style:table-row-properties style:row-height="3.975cm"/>
    </style:style>
    <style:style style:name="HeadRowD" style:family="table-row">
      <style:table-row-properties style:row-height="1.255cm"/>
    </style:style>
    <style:style style:name="BlankRowD" style:family="table-row">
      <style:table-row-properties style:row-height="4.2cm"/>
    </style:style>
    <style:style style:name="HeadRowE" style:family="table-row">
      <style:table-row-properties style:row-height="1.249cm"/>
    </style:style>
    <style:style style:name="BlankRowE" style:family="table-row">
      <style:table-row-properties style:row-height="3.966cm"/>
    </style:style>
    <style:style style:name="HeadRowF" style:family="table-row">
      <style:table-row-properties style:row-height="1.294cm"/>
    </style:style>
    <style:style style:name="BlankRowF" style:family="table-row">
      <style:table-row-properties style:row-height="4.212cm"/>
    </style:style>
    <style:style style:name="HeadRowG" style:family="table-row">
      <style:table-row-properties style:row-height="1.277cm"/>
    </style:style>
    <style:style style:name="BlankRowG" style:family="table-row">
      <style:table-row-properties style:row-height="4.709cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">老人クラブ地域活動状況等調査票</text:p>
      <text:p text:style-name="Club">老人クラブ</text:p>
      <text:p text:style-name="Section">１　今年度の活動について</text:p>
      <table:table table:name="地域活動状況">
        <table:table-column table:style-name="ColWide"/>
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-row table:style-name="HeadRowA">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellText">①友愛活動・・・地区内のひとり暮らしやねたきりの高齢者宅を訪問し<text:line-break/>　　　　　　　　　話し相手となるなど</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CountText">回数・参加者</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="BlankRowA">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="HeadRowB">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellText">②生活支援活動・・・近隣の高齢者に対する家事の手助け等</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CountText">回数・参加者</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="BlankRowB">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="HeadRowC">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellText">③清掃･奉仕･環境活動・・・リサイクルの実施、歩道などの花壇の整備等</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CountText">回数・参加者</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="BlankRowC">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="HeadRowD">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellText">④文化･学習サークル活動・・・短歌、書道、詩吟、陶芸などの活動</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CountText">回数・参加者</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="BlankRowD">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="NewPage"/>
      <table:table table:name="地域活動状況続き">
        <table:table-column table:style-name="ColWide"/>
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-row table:style-name="HeadRowE">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellText">⑤スポーツサークル活動・・・ゲートボール、グラウンドゴルフ、歩こう会など</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CountText">回数・参加者</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="BlankRowE">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="HeadRowF">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellText">⑥安全活動・・・交差点での交通安全運動など</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CountText">回数・参加者</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="BlankRowF">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="HeadRowG">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellText">⑦世代間の交流・・・地域の子ども会と昔の遊びをするなど</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CountText">回数・参加者</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="BlankRowG">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Submit">年　　月　　日（　）までに高齢者支援課へ提出してください。</text:p>
    </office:text>
  </office:body>
</office:document>