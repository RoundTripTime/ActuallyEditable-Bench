          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">連　絡</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Center">年　　月　　日</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">連絡方法</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Center">□電　話　　　□直　接</text:p></table:table-cell>
