      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="Right">古河市　都市建設部　建築指導課</text:p>
      <table:table table:name="裁" table:style-name="T">
        <table:table-column table:style-name="C" table:number-columns-repeated="10"/>
        <table:table-row>
          <table:table-cell table:style-name="CenterCell"><text:p text:style-name="P">裁</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="P"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="P"/></table:table-cell>
