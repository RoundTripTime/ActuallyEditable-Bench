          <table:table-cell table:style-name="StrongCell" table:number-columns-spanned="4"><text:p>年　月　日　　　　　　の　　　　　　　　　による</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
