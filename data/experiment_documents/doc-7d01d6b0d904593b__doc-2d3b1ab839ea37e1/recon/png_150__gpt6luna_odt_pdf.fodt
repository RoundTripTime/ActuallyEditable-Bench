<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt" style:font-name="serif"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.55cm" fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-size="20pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="1pt"/>
    </style:style>
    <style:style style:name="Grid" style:family="table">
      <style:table-properties style:width="17.8cm" table:align="center"/>
    </style:style>
    <style:style style:name="GridCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="110%"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="GridLabel" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="110%"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="StrongCell" style:family="table-cell">
      <style:table-cell-properties fo:border="1.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="110%"/>
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.6cm" fo:margin-bottom="1.5cm" fo:margin-left="1.6cm" fo:margin-right="1.6cm" style:print-orientation="portrait"/>
    </style:page-layout>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="3.4cm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="1.8cm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="5.5cm"/>
    </style:style>
    <style:style style:name="ColD" style:family="table-column">
      <style:table-column-properties style:column-width="1.8cm"/>
    </style:style>
    <style:style style:name="ColE" style:family="table-column">
      <style:table-column-properties style:column-width="5.3cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">罹災証明申請書</text:p>
      <text:p text:style-name="Body">年　月　日</text:p>
      <text:p text:style-name="Body">（あて先）富里市長</text:p>
      <table:table table:name="申請者及び世帯情報" table:style-name="Grid">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColD"/>
        <table:table-column table:style-name="ColE"/>
        <table:table-row>
          <table:table-cell table:style-name="GridLabel" table:number-rows-spanned="2"><text:p>申請者情報</text:p></table:table-cell>
          <table:table-cell table:style-name="GridLabel"><text:p>住所</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridLabel"><text:p>氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridLabel"><text:p>世帯主との関係</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="3"><text:p>☐　本人　　□同一世帯の親族　　□その他※</text:p><text:p>（　　　　　　）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridLabel"><text:p>世帯主情報</text:p><text:p>（申請者と同じ場合</text:p><text:p>記載不要）</text:p></table:table-cell>
          <table:table-cell table:style-name="GridLabel"><text:p>住所</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridLabel"><text:p>氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridLabel"><text:p>受取方法</text:p></table:table-cell>
          <table:table-cell table:style-name="GridLabel"><text:p>受取方法</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p>□　郵送（申請者住所）</text:p><text:p>□　市役所窓口</text:p></table:table-cell>
          <table:table-cell table:style-name="GridLabel"><text:p>連絡先</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
      </table:table>
      <table:table table:name="世帯構成員" table:style-name="Grid">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColE"/>
        <table:table-row>
          <table:table-cell table:style-name="GridLabel" table:number-rows-spanned="4"><text:p>世帯構成員</text:p><text:p>（世帯主以外）</text:p></table:table-cell>
          <table:table-cell table:style-name="GridLabel"><text:p>氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="GridLabel"><text:p>続柄</text:p></table:table-cell>
          <table:table-cell table:style-name="GridLabel"><text:p>備考</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridLabel" table:number-rows-spanned="1"><text:p>世帯主</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body">※その他の場合、委任状（任意様式）が必要</text:p>
      <table:table table:name="罹災原因" table:style-name="Grid">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColD"/>
        <table:table-column table:style-name="ColE"/>
        <table:table-row>
          <table:table-cell table:style-name="StrongCell"><text:p>罹災原因</text:p></table:table-cell>
          <table:table-cell table:style-name="StrongCell" table:number-columns-spanned="4"><text:p>年　月　日　　　　　　の　　　　　　　　　による</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <table:table table:name="被災住家" table:style-name="Grid">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColD"/>
        <table:table-column table:style-name="ColE"/>
        <table:table-row>
          <table:table-cell table:style-name="StrongCell"><text:p>被災住家※</text:p><text:p>の所在地</text:p><text:p>（申請者住所と同じ</text:p><text:p>場合は記入不要）</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="StrongCell"><text:p>証明書</text:p><text:p>必要数</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridLabel"><text:p>枚</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Small">※住家とは、現実に居住（世帯が生活の本拠として日常的に使用していることをいう。）</text:p>
      <text:p text:style-name="Small">のために使用している建物のことをいいます（被災者生活再建支援金や災害救助法による住宅の応急修理等の対象となる住家）。</text:p>
      <table:table table:name="判定方式選択" table:style-name="Grid">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColD"/>
        <table:table-column table:style-name="ColE"/>
        <table:table-row>
          <table:table-cell table:style-name="StrongCell"><text:p>判定方式選択</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="4"><text:p>□　現地確認による判定を希望します。</text:p><text:p>なお、被害認定調査を迅速に行うため、固定資産税課税台帳</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageBreak"/>
      <table:table table:name="同意欄及び自己判定方式" table:style-name="Grid">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColD"/>
        <table:table-column table:style-name="ColE"/>
        <table:table-row>
          <table:table-cell table:style-name="StrongCell" table:number-rows-spanned="2"><text:p>（同意欄）</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="4"><text:p>等に記載された建物の所在・地番、床面積、構造、図面といった情報を利用することについて所有者等の同意を得ています。</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="4"><text:p>□　自己判定方式※を希望します。</text:p><text:p>かつ、「準半壊に至らない（一部損壊）」という調査結果に同意します。</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Small">※自己判定方式は、家屋全体に対する損害割合が10％未満となるような軽微な被害の場合、申請者が「準半壊に至らない（一部損壊）」であることについて、同意していただいたうえで、被害箇所を撮影した写真のみで判定する方式です。そのため短期間で証明書を交付することが可能です。</text:p>
      <table:table table:name="注意事項" table:style-name="Grid">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColD"/>
        <table:table-column table:style-name="ColE"/>
        <table:table-row>
          <table:table-cell table:style-name="GridLabel"><text:p>注意事項</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="4">
            <text:p>● 本人確認できる書類等（運転免許証やマイナンバーカードなど）を</text:p>
            <text:p>　お持ちで無い場合、証明書を発行できない場合があります。</text:p>
            <text:p>● 申請者が同一世帯の親族以外で委任状をお持ちで無い場合、証明書を発行できない場合があります。</text:p>
            <text:p>● 申請書に記載された内容は、適切に管理し、罹災状況の調査及び被災者支援に係る事務に限り、本市関係各課等において使用します。</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>