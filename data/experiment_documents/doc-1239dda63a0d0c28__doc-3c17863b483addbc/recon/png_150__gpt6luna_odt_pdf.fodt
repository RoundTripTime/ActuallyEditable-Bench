<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:font-size="10pt" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:color="#000000"/>
    </style:default-style>
    <style:style style:name="Footer" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="8pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Bold" style:family="text">
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="1.4cm" fo:margin-right="1.4cm" fo:margin-top="1.5cm" fo:margin-bottom="1.2cm"/>
    </style:page-layout>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayoutAuto">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="1.4cm" fo:margin-right="1.4cm" fo:margin-top="1.5cm" fo:margin-bottom="1.2cm"/>
    </style:page-layout>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:font-size="26pt" fo:margin-top="0.1cm" fo:margin-bottom="0.45cm" fo:border-bottom="0.04cm solid #4F81BD" fo:padding-bottom="0.2cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="26pt" fo:color="#17365D"/>
    </style:style>
    <style:style style:name="Currency" style:family="paragraph">
      <style:paragraph-properties fo:font-size="10pt" fo:margin-top="0.25cm" fo:margin-bottom="0.2cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="MetaTable" style:family="table">
      <style:table-properties fo:width="18.2cm" table:align="margins"/>
    </style:style>
    <style:style style:name="MetaLabelCol" style:family="table-column">
      <style:table-column-properties style:column-width="9.1cm"/>
    </style:style>
    <style:style style:name="MetaValueCol" style:family="table-column">
      <style:table-column-properties style:column-width="9.1cm"/>
    </style:style>
    <style:style style:name="MetaCell" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:padding-left="0.2cm" fo:padding-right="0.2cm" fo:padding-top="0.04cm" fo:padding-bottom="0.04cm"/>
    </style:style>
    <style:style style:name="MetaLabel" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:padding-left="0.2cm" fo:padding-right="0.2cm" fo:padding-top="0.04cm" fo:padding-bottom="0.04cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:font-weight="bold" fo:color="#366092"/>
    </style:style>
    <style:style style:name="MetaValue" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:padding-left="0.2cm" fo:padding-right="0.2cm" fo:padding-top="0.04cm" fo:padding-bottom="0.04cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:color="#366092"/>
    </style:style>
    <style:style style:name="MetaPlainRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.6cm"/>
    </style:style>
    <style:style style:name="MetaBlueRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.6cm" fo:background-color="#D3DFEF"/>
    </style:style>
    <style:style style:name="MetaTopCell" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:padding-left="0.2cm" fo:padding-right="0.2cm" fo:padding-top="0.04cm" fo:padding-bottom="0.04cm" fo:border-top="0.04cm solid #4F81BD"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:font-weight="bold" fo:color="#366092"/>
    </style:style>
    <style:style style:name="MetaTopValue" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:padding-left="0.2cm" fo:padding-right="0.2cm" fo:padding-top="0.04cm" fo:padding-bottom="0.04cm" fo:border-top="0.04cm solid #4F81BD"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:color="#366092"/>
    </style:style>
    <style:style style:name="MetaBottomCell" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:padding-left="0.2cm" fo:padding-right="0.2cm" fo:padding-top="0.04cm" fo:padding-bottom="0.04cm" fo:border-bottom="0.04cm solid #4F81BD"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:font-weight="bold" fo:color="#366092"/>
    </style:style>
    <style:style style:name="MetaBottomValue" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:padding-left="0.2cm" fo:padding-right="0.2cm" fo:padding-top="0.04cm" fo:padding-bottom="0.04cm" fo:border-bottom="0.04cm solid #4F81BD"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:color="#366092"/>
    </style:style>
    <style:style style:name="SectionGap" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.35cm" fo:margin-bottom="0.3cm"/>
    </style:style>
    <style:style style:name="InvoiceTable" style:family="table">
      <style:table-properties fo:width="18.2cm" table:align="margins"/>
    </style:style>
    <style:style style:name="DescCol" style:family="table-column">
      <style:table-column-properties style:column-width="7.6cm"/>
    </style:style>
    <style:style style:name="QtyCol" style:family="table-column">
      <style:table-column-properties style:column-width="2.4cm"/>
    </style:style>
    <style:style style:name="RateCol" style:family="table-column">
      <style:table-column-properties style:column-width="4.1cm"/>
    </style:style>
    <style:style style:name="AmountCol" style:family="table-column">
      <style:table-column-properties style:column-width="4.1cm"/>
    </style:style>
    <style:style style:name="InvoiceHeader" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.58cm"/>
    </style:style>
    <style:style style:name="InvoiceHeaderCell" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:padding-left="0.2cm" fo:padding-right="0.2cm" fo:padding-top="0.04cm" fo:padding-bottom="0.04cm" fo:border-top="0.04cm solid #4F81BD" fo:border-bottom="0.04cm solid #4F81BD"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="9pt" fo:font-weight="bold" fo:color="#366092"/>
    </style:style>
    <style:style style:name="InvoiceHeaderCenter" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:padding-left="0.1cm" fo:padding-right="0.1cm" fo:padding-top="0.04cm" fo:padding-bottom="0.04cm" fo:text-align="center" fo:border-top="0.04cm solid #4F81BD" fo:border-bottom="0.04cm solid #4F81BD"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="9pt" fo:font-weight="bold" fo:color="#366092"/>
    </style:style>
    <style:style style:name="EntryRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.62cm" fo:background-color="#D3DFEF"/>
    </style:style>
    <style:style style:name="EntryCell" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:padding-left="0.12cm" fo:padding-right="0.12cm" fo:padding-top="0.04cm" fo:padding-bottom="0.04cm"/>
    </style:style>
    <style:style style:name="SpacerRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.56cm"/>
    </style:style>
    <style:style style:name="TotalLine" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.25cm" fo:border-top="0.04cm solid #4F81BD" fo:padding-top="0.05cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="TotalText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.25cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.12cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayoutAuto">
      <style:footer>
        <text:p text:style-name="Footer">OnlineBiller | Original English resource | Blank template</text:p>
      </style:footer>
    </style:master-page>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">Freelance Invoice</text:p>
      <text:p text:style-name="Currency">BLANK TEMPLATE | Currency: INR</text:p>
      <table:table table:name="InvoiceDetails" table:style-name="MetaTable">
        <table:table-column table:style-name="MetaLabelCol"/>
        <table:table-column table:style-name="MetaValueCol"/>
        <table:table-row table:style-name="MetaPlainRow">
          <table:table-cell table:style-name="MetaTopCell"><text:p>Freelancer</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaTopValue"><text:p>________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="MetaBlueRow">
          <table:table-cell table:style-name="MetaLabel"><text:p>Client</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaValue"><text:p>________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="MetaPlainRow">
          <table:table-cell table:style-name="MetaLabel"><text:p>Invoice / date</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaValue"><text:p>________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="MetaBlueRow">
          <table:table-cell table:style-name="MetaLabel"><text:p>Work reference</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaValue"><text:p>________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="MetaPlainRow">
          <table:table-cell table:style-name="MetaLabel"><text:p>Billing period</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaValue"><text:p>________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="MetaBlueRow">
          <table:table-cell table:style-name="MetaLabel"><text:p>Due date</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaValue"><text:p>________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="MetaPlainRow">
          <table:table-cell table:style-name="MetaLabel"><text:p>Payment instructions</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaValue"><text:p>________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="MetaBlueRow">
          <table:table-cell table:style-name="MetaBottomCell"><text:p>Tax basis</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaBottomValue"><text:p>________________________________________</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="SectionGap"/>
      <table:table table:name="InvoiceLines" table:style-name="InvoiceTable">
        <table:table-column table:style-name="DescCol"/>
        <table:table-column table:style-name="QtyCol"/>
        <table:table-column table:style-name="RateCol"/>
        <table:table-column table:style-name="AmountCol"/>
        <table:table-row table:style-name="InvoiceHeader">
          <table:table-cell table:style-name="InvoiceHeaderCell"><text:p>Description</text:p></table:table-cell>
          <table:table-cell table:style-name="InvoiceHeaderCenter"><text:p>Quantity</text:p></table:table-cell>
          <table:table-cell table:style-name="InvoiceHeaderCenter"><text:p>Rate (INR)</text:p></table:table-cell>
          <table:table-cell table:style-name="InvoiceHeaderCenter"><text:p>Amount (INR)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="EntryRow">
          <table:table-cell table:style-name="EntryCell"/>
          <table:table-cell table:style-name="EntryCell"/>
          <table:table-cell table:style-name="EntryCell"/>
          <table:table-cell table:style-name="EntryCell"/>
        </table:table-row>
        <table:table-row table:style-name="SpacerRow">
          <table:table-cell/><table:table-cell/><table:table-cell/><table:table-cell/>
        </table:table-row>
        <table:table-row table:style-name="EntryRow">
          <table:table-cell table:style-name="EntryCell"/>
          <table:table-cell table:style-name="EntryCell"/>
          <table:table-cell table:style-name="EntryCell"/>
          <table:table-cell table:style-name="EntryCell"/>
        </table:table-row>
        <table:table-row table:style-name="SpacerRow">
          <table:table-cell/><table:table-cell/><table:table-cell/><table:table-cell/>
        </table:table-row>
        <table:table-row table:style-name="EntryRow">
          <table:table-cell table:style-name="EntryCell"/>
          <table:table-cell table:style-name="EntryCell"/>
          <table:table-cell table:style-name="EntryCell"/>
          <table:table-cell table:style-name="EntryCell"/>
        </table:table-row>
        <table:table-row table:style-name="SpacerRow">
          <table:table-cell/><table:table-cell/><table:table-cell/><table:table-cell/>
        </table:table-row>
        <table:table-row table:style-name="EntryRow">
          <table:table-cell table:style-name="EntryCell"/>
          <table:table-cell table:style-name="EntryCell"/>
          <table:table-cell table:style-name="EntryCell"/>
          <table:table-cell table:style-name="EntryCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="TotalLine"><text:span text:style-name="Bold">Subtotal:</text:span> INR ____________</text:p>
      <text:p text:style-name="TotalText"><text:span text:style-name="Bold">Amount due:</text:span> INR ____________</text:p>
      <text:p text:style-name="Note">Fixed-fee and hourly units are explicitly labeled. Enter recorded, agreed work only.</text:p>
      <text:p text:style-name="Note">No time tracking, tax classification or payment collection is performed.</text:p>
      <text:p text:style-name="Note">Word amounts are manual. Check line amounts and totals after every edit.</text:p>
    </office:text>
  </office:body>
</office:document>