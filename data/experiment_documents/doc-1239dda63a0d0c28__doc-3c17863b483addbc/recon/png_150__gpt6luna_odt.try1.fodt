<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-size="11pt" fo:color="#000000"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph" style:master-page-name="Page1">
      <style:paragraph-properties fo:margin-top="0.1cm" fo:margin-bottom="0.38cm" fo:border-bottom="0.04cm solid #3f79c4" fo:padding-bottom="0.16cm"/>
      <style:text-properties fo:font-size="28pt" fo:color="#17365d"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.1cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="FormLabel" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="11pt" fo:font-weight="bold" fo:color="#35639c"/>
    </style:style>
    <style:style style:name="TableHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt" fo:font-weight="bold" fo:color="#35639c"/>
    </style:style>
    <style:style style:name="BodyText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.1cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="TotalText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.12cm" fo:margin-bottom="0.12cm" fo:border-top="0.04cm solid #3f79c4" fo:padding-top="0.05cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="FooterText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="9pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="MetaTable" style:family="table">
      <style:table-properties table:align="margins" style:width="18.2cm"/>
    </style:style>
    <style:style style:name="ItemsTable" style:family="table">
      <style:table-properties table:align="margins" style:width="18.2cm"/>
    </style:style>
    <style:style style:name="ColMetaLabel" style:family="table-column">
      <style:table-column-properties style:column-width="9.1cm"/>
    </style:style>
    <style:style style:name="ColMetaInput" style:family="table-column">
      <style:table-column-properties style:column-width="9.1cm"/>
    </style:style>
    <style:style style:name="ColDesc" style:family="table-column">
      <style:table-column-properties style:column-width="8.1cm"/>
    </style:style>
    <style:style style:name="ColQty" style:family="table-column">
      <style:table-column-properties style:column-width="2.5cm"/>
    </style:style>
    <style:style style:name="ColRate" style:family="table-column">
      <style:table-column-properties style:column-width="3.5cm"/>
    </style:style>
    <style:style style:name="ColAmount" style:family="table-column">
      <style:table-column-properties style:column-width="4.1cm"/>
    </style:style>
    <style:style style:name="MetaCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="MetaCellShade" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#d2dfef" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="MetaTop" style:family="table-cell">
      <style:table-cell-properties fo:border-top="0.04cm solid #3f79c4" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="MetaBottomShade" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#d2dfef" fo:border-bottom="0.04cm solid #3f79c4" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="ItemHeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:border-top="0.04cm solid #3f79c4" fo:border-bottom="0.04cm solid #3f79c4" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="ItemShade" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#d2dfef" fo:padding="0.06cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="SpacerCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0cm"/>
    </style:style>
    <style:style style:name="ItemRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.58cm"/>
    </style:style>
    <style:style style:name="SpacerRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.56cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout1">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="1.4cm" fo:margin-right="1.4cm" fo:margin-top="1.4cm" fo:margin-bottom="1.4cm" style:print-orientation="portrait"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Page1" style:page-layout-name="PageLayout1">
      <style:footer>
        <text:p text:style-name="FooterText">OnlineBiller | Original English resource | Blank template</text:p>
      </style:footer>
    </style:master-page>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">Freelance Invoice</text:p>
      <text:p text:style-name="Subtitle">BLANK TEMPLATE | Currency: INR</text:p>
      <table:table table:name="InvoiceDetails" table:style-name="MetaTable">
        <table:table-column table:style-name="ColMetaLabel"/>
        <table:table-column table:style-name="ColMetaInput"/>
        <table:table-row>
          <table:table-cell table:style-name="MetaTop"><text:p text:style-name="FormLabel">Freelancer</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaTop"><text:p>______________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaCellShade"><text:p text:style-name="FormLabel">Client</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaCellShade"><text:p>______________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="FormLabel">Invoice / date</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaCell"><text:p>______________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaCellShade"><text:p text:style-name="FormLabel">Work reference</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaCellShade"><text:p>______________________________________</text:p></table:cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="FormLabel">Billing period</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaCell"><text:p>______________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaCellShade"><text:p text:style-name="FormLabel">Due date</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaCellShade"><text:p>______________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="FormLabel">Payment instructions</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaCell"><text:p>______________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaBottomShade"><text:p text:style-name="FormLabel">Tax basis</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaBottomShade"><text:p>______________________________________</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="BodyText"/>
      <table:table table:name="InvoiceItems" table:style-name="ItemsTable">
        <table:table-column table:style-name="ColDesc"/>
        <table:table-column table:style-name="ColQty"/>
        <table:table-column table:style-name="ColRate"/>
        <table:table-column table:style-name="ColAmount"/>
        <table:table-row>
          <table:table-cell table:style-name="ItemHeaderCell"><text:p text:style-name="TableHeading">Description</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHeaderCell"><text:p text:style-name="TableHeading">Quantity</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHeaderCell"><text:p text:style-name="TableHeading">Rate (INR)</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHeaderCell"><text:p text:style-name="TableHeading">Amount (INR)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ItemRow">
          <table:table-cell table:style-name="ItemShade"/>
          <table:table-cell table:style-name="ItemShade"/>
          <table:table-cell table:style-name="ItemShade"/>
          <table:table-cell table:style-name="ItemShade"/>
        </table:table-row>
        <table:table-row table:style-name="SpacerRow">
          <table:table-cell table:style-name="SpacerCell" table:number-columns-spanned="4"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="ItemRow">
          <table:table-cell table:style-name="ItemShade"/>
          <table:table-cell table:style-name="ItemShade"/>
          <table:table-cell table:style-name="ItemShade"/>
          <table:table-cell table:style-name="ItemShade"/>
        </table:table-row>
        <table:table-row table:style-name="SpacerRow">
          <table:table-cell table:style-name="SpacerCell" table:number-columns-spanned="4"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="ItemRow">
          <table:table-cell table:style-name="ItemShade"/>
          <table:table-cell table:style-name="ItemShade"/>
          <table:table-cell table:style-name="ItemShade"/>
          <table:table-cell table:style-name="ItemShade"/>
        </table:table-row>
        <table:table-row table:style-name="SpacerRow">
          <table:table-cell table:style-name="SpacerCell" table:number-columns-spanned="4"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="ItemRow">
          <table:table-cell table:style-name="ItemShade"/>
          <table:table-cell table:style-name="ItemShade"/>
          <table:table-cell table:style-name="ItemShade"/>
          <table:table-cell table:style-name="ItemShade"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="TotalText"><text:span text:style-name="FormLabel">Subtotal:</text:span> INR __________</text:p>
      <text:p text:style-name="BodyText"><text:span text:style-name="FormLabel">Amount due:</text:span> INR __________</text:p>
      <text:p text:style-name="BodyText">Fixed-fee and hourly units are explicitly labeled. Enter recorded, agreed work only.</text:p>
      <text:p text:style-name="BodyText">No time tracking, tax classification or payment collection is performed.</text:p>
      <text:p text:style-name="BodyText">Word amounts are manual. Check line amounts and totals after every edit.</text:p>
    </office:text>
  </office:body>
</office:document>