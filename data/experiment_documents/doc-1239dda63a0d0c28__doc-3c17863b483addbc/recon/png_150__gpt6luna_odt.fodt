<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.12cm" fo:line-height="0.48cm"/>
      <style:text-properties fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.45cm" fo:line-height="1.05cm" fo:border-bottom="0.04cm solid #4f81bd" fo:padding-bottom="0.16cm"/>
      <style:text-properties fo:font-size="28pt" fo:color="#17365d"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.22cm" fo:line-height="0.52cm"/>
      <style:text-properties fo:font-size="12pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Label" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="0.55cm"/>
      <style:text-properties fo:font-size="12pt" fo:font-weight="bold" fo:color="#366092"/>
    </style:style>
    <style:style style:name="Value" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="0.55cm"/>
      <style:text-properties fo:font-size="11pt" fo:color="#366092"/>
    </style:style>
    <style:style style:name="TableHead" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="0.52cm"/>
      <style:text-properties fo:font-size="11pt" fo:font-weight="bold" fo:color="#366092"/>
    </style:style>
    <style:style style:name="SmallRow" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="0.62cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.1cm" fo:line-height="0.55cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Footer" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="12.5cm" fo:margin-bottom="0cm" fo:line-height="0.42cm"/>
      <style:text-properties fo:font-size="9pt" fo:color="#000000"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="1.4cm" fo:margin-right="1.4cm" fo:margin-top="1.45cm" fo:margin-bottom="1.35cm"/>
    </style:page-layout>
    <style:style style:name="DetailsTable" style:family="table">
      <style:table-properties style:width="18.2cm" table:align="margins"/>
    </style:style>
    <style:style style:name="DetailsLabelCell" style:family="table-cell">
      <style:table-cell-properties fo:padding-left="0.2cm" fo:padding-right="0.1cm" fo:padding-top="0.02cm" fo:padding-bottom="0.02cm" fo:border-top="0.02cm solid #4f81bd"/>
    </style:style>
    <style:style style:name="DetailsLabelBlue" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#d6e1f0" fo:padding-left="0.2cm" fo:padding-right="0.1cm" fo:padding-top="0.02cm" fo:padding-bottom="0.02cm" fo:border-top="0.02cm solid #4f81bd"/>
    </style:style>
    <style:style style:name="DetailsValueCell" style:family="table-cell">
      <style:table-cell-properties fo:padding-left="0.1cm" fo:padding-right="0.1cm" fo:padding-top="0.02cm" fo:padding-bottom="0.02cm" fo:border-top="0.02cm solid #4f81bd"/>
    </style:style>
    <style:style style:name="DetailsValueBlue" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#d6e1f0" fo:padding-left="0.1cm" fo:padding-right="0.1cm" fo:padding-top="0.02cm" fo:padding-bottom="0.02cm" fo:border-top="0.02cm solid #4f81bd"/>
    </style:style>
    <style:style style:name="ItemTable" style:family="table">
      <style:table-properties style:width="18.2cm" table:align="margins"/>
    </style:style>
    <style:style style:name="ItemHeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:padding-left="0.2cm" fo:padding-right="0.1cm" fo:padding-top="0.02cm" fo:padding-bottom="0.02cm" fo:border-top="0.04cm solid #4f81bd" fo:border-bottom="0.04cm solid #4f81bd"/>
    </style:style>
    <style:style style:name="ItemEmptyCell" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#d6e1f0" fo:padding-left="0.1cm" fo:padding-right="0.1cm" fo:padding-top="0.02cm" fo:padding-bottom="0.02cm"/>
    </style:style>
    <style:style style:name="ItemEmptyWhiteCell" style:family="table-cell">
      <style:table-cell-properties fo:padding-left="0.1cm" fo:padding-right="0.1cm" fo:padding-top="0.02cm" fo:padding-bottom="0.02cm"/>
    </style:style>
    <style:style style:name="Total" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.15cm" fo:line-height="0.55cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="TotalRule" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.3cm" fo:margin-bottom="0.12cm" fo:line-height="0.55cm" fo:border-top="0.04cm solid #4f81bd" fo:padding-top="0.02cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Bold" style:family="text">
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Column1" style:family="table-column">
      <style:table-column-properties style:column-width="8cm"/>
    </style:style>
    <style:style style:name="Column2" style:family="table-column">
      <style:table-column-properties style:column-width="2.5cm"/>
    </style:style>
    <style:style style:name="Column3" style:family="table-column">
      <style:table-column-properties style:column-width="3.5cm"/>
    </style:style>
    <style:style style:name="Column4" style:family="table-column">
      <style:table-column-properties style:column-width="4.2cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">Freelance Invoice</text:p>
      <text:p text:style-name="Subtitle">BLANK TEMPLATE | Currency: INR</text:p>
      <table:table table:name="InvoiceDetails" table:style-name="DetailsTable">
        <table:table-column table:number-columns-repeated="2"/>
        <table:table-row>
          <table:table-cell table:style-name="DetailsLabelCell"><text:p text:style-name="Label">Freelancer</text:p></table:table-cell>
          <table:table-cell table:style-name="DetailsValueCell"><text:p text:style-name="Value">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="DetailsLabelBlue"><text:p text:style-name="Label">Client</text:p></table:table-cell>
          <table:table-cell table:style-name="DetailsValueBlue"><text:p text:style-name="Value">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="DetailsLabelCell"><text:p text:style-name="Label">Invoice / date</text:p></table:table-cell>
          <table:table-cell table:style-name="DetailsValueCell"><text:p text:style-name="Value">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="DetailsLabelBlue"><text:p text:style-name="Label">Work reference</text:p></table:table-cell>
          <table:table-cell table:style-name="DetailsValueBlue"><text:p text:style-name="Value">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="DetailsLabelCell"><text:p text:style-name="Label">Billing period</text:p></table:table-cell>
          <table:table-cell table:style-name="DetailsValueCell"><text:p text:style-name="Value">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="DetailsLabelBlue"><text:p text:style-name="Label">Due date</text:p></table:table-cell>
          <table:table-cell table:style-name="DetailsValueBlue"><text:p text:style-name="Value">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="DetailsLabelCell"><text:p text:style-name="Label">Payment instructions</text:p></table:table-cell>
          <table:table-cell table:style-name="DetailsValueCell"><text:p text:style-name="Value">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="DetailsLabelBlue"><text:p text:style-name="Label">Tax basis</text:p></table:table-cell>
          <table:table-cell table:style-name="DetailsValueBlue"><text:p text:style-name="Value">________________________________________</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body"/>
      <table:table table:name="InvoiceItems" table:style-name="ItemTable">
        <table:table-column table:style-name="Column1"/>
        <table:table-column table:style-name="Column2"/>
        <table:table-column table:style-name="Column3"/>
        <table:table-column table:style-name="Column4"/>
        <table:table-row>
          <table:table-cell table:style-name="ItemHeaderCell"><text:p text:style-name="TableHead">Description</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHeaderCell"><text:p text:style-name="TableHead">Quantity</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHeaderCell"><text:p text:style-name="TableHead">Rate (INR)</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHeaderCell"><text:p text:style-name="TableHead">Amount (INR)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ItemEmptyCell"><text:p text:style-name="SmallRow"/></table:table-cell>
          <table:table-cell table:style-name="ItemEmptyCell"><text:p text:style-name="SmallRow"/></table:table-cell>
          <table:table-cell table:style-name="ItemEmptyCell"><text:p text:style-name="SmallRow"/></table:table-cell>
          <table:table-cell table:style-name="ItemEmptyCell"><text:p text:style-name="SmallRow"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ItemEmptyWhiteCell"><text:p text:style-name="SmallRow"/></table:table-cell>
          <table:table-cell table:style-name="ItemEmptyWhiteCell"><text:p text:style-name="SmallRow"/></table:table-cell>
          <table:table-cell table:style-name="ItemEmptyWhiteCell"><text:p text:style-name="SmallRow"/></table:table-cell>
          <table:table-cell table:style-name="ItemEmptyWhiteCell"><text:p text:style-name="SmallRow"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ItemEmptyCell"><text:p text:style-name="SmallRow"/></table:table-cell>
          <table:table-cell table:style-name="ItemEmptyCell"><text:p text:style-name="SmallRow"/></table:table-cell>
          <table:table-cell table:style-name="ItemEmptyCell"><text:p text:style-name="SmallRow"/></table:table-cell>
          <table:table-cell table:style-name="ItemEmptyCell"><text:p text:style-name="SmallRow"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ItemEmptyWhiteCell"><text:p text:style-name="SmallRow"/></table:table-cell>
          <table:table-cell table:style-name="ItemEmptyWhiteCell"><text:p text:style-name="SmallRow"/></table:table-cell>
          <table:table-cell table:style-name="ItemEmptyWhiteCell"><text:p text:style-name="SmallRow"/></table:table-cell>
          <table:table-cell table:style-name="ItemEmptyWhiteCell"><text:p text:style-name="SmallRow"/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="TotalRule"><text:span text:style-name="Bold">Subtotal:</text:span> INR __________</text:p>
      <text:p text:style-name="Total"><text:span text:style-name="Bold">Amount due:</text:span> INR __________</text:p>
      <text:p text:style-name="Note">Fixed-fee and hourly units are explicitly labeled. Enter recorded, agreed work only.</text:p>
      <text:p text:style-name="Note">No time tracking, tax classification or payment collection is performed.</text:p>
      <text:p text:style-name="Note">Word amounts are manual. Check line amounts and totals after every edit.</text:p>
      <text:p text:style-name="Footer">OnlineBiller | Original English resource | Blank template</text:p>
    </office:text>
  </office:body>
</office:document>