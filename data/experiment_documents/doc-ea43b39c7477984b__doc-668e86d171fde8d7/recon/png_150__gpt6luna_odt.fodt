<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:default-style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="3cm" fo:margin-right="2.6cm" fo:margin-top="2cm" fo:margin-bottom="2cm"/>
    </style:page-layout>
    <style:style style:name="FormCode" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="1.3cm" fo:margin-bottom="1cm"/>
    </style:style>
    <style:style style:name="FormTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-bottom="0.9cm"/>
      <style:text-properties fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="Organization" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="7.8cm" fo:margin-right="1.5cm" fo:margin-bottom="0.8cm" fo:border-bottom="0.5pt solid #000000"/>
    </style:style>
    <style:style style:name="CellLabel" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.12cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="LeftColumn" style:family="table-column">
      <style:table-column-properties style:column-width="4.33cm"/>
    </style:style>
    <style:style style:name="RightColumn" style:family="table-column">
      <style:table-column-properties style:column-width="11.07cm"/>
    </style:style>
    <style:style style:name="RowOne" style:family="table-row">
      <style:table-row-properties style:row-height="5.1cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RowTwo" style:family="table-row">
      <style:table-row-properties style:row-height="5.1cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RowThree" style:family="table-row">
      <style:table-row-properties style:row-height="5.6cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="NewPage" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="FormCode">〔様式第６号〕</text:p>
      <text:p text:style-name="FormTitle">規約変更の内容及び理由</text:p>
      <text:p text:style-name="Organization">団体名</text:p>
      <table:table table:name="ChangeDetails">
        <table:table-column table:style-name="LeftColumn"/>
        <table:table-column table:style-name="RightColumn"/>
        <table:table-row table:style-name="RowOne">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellLabel">変更前の内容</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p/>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowTwo">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellLabel">変更後の内容</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p/>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowThree">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellLabel">変更理由</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p/>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="NewPage"/>
    </office:text>
  </office:body>
</office:document>