<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" fo:margin-left="30mm" fo:margin-right="26.4mm" fo:margin-top="25mm" fo:margin-bottom="20mm"/>
    </style:page-layout>
    <style:style style:name="Kicker" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="10mm" fo:margin-bottom="11.4mm" fo:line-height="5mm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0mm" fo:margin-bottom="8mm" fo:line-height="6mm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="GroupName" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="77.8mm" fo:margin-top="0mm" fo:margin-bottom="5.7mm" fo:line-height="5mm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Underline" style:family="text">
      <style:text-properties style:text-underline-style="solid" style:text-underline-type="single"/>
    </style:style>
    <style:style style:name="FirstColumn" style:family="table-column">
      <style:table-column-properties style:column-width="43.2mm"/>
    </style:style>
    <style:style style:name="SecondColumn" style:family="table-column">
      <style:table-column-properties style:column-width="110.4mm"/>
    </style:style>
    <style:style style:name="FirstRow" style:family="table-row">
      <style:table-row-properties style:row-height="51.1mm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="SecondRow" style:family="table-row">
      <style:table-row-properties style:row-height="51.1mm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="ThirdRow" style:family="table-row">
      <style:table-row-properties style:row-height="56.7mm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="FormCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin="0mm" fo:line-height="5mm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="EmptyCell" style:family="paragraph">
      <style:paragraph-properties fo:margin="0mm" fo:line-height="5mm"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin="0mm" fo:line-height="1pt"/>
      <style:text-properties fo:font-family="serif" fo:font-size="1pt"/>
    </style:style>
  </office:automatic-styles>
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin="0mm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="10.5pt"/>
    </style:default-style>
  </office:styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Kicker">〔様式第6号〕</text:p>
      <text:p text:style-name="Title">規約変更の内容及び理由</text:p>
      <text:p text:style-name="GroupName"><text:span text:style-name="Underline">団体名<text:s text:c="16"/></text:span></text:p>
      <table:table table:name="Form">
        <table:table-column table:style-name="FirstColumn"/>
        <table:table-column table:style-name="SecondColumn"/>
        <table:table-row table:style-name="FirstRow">
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellText">変更前の内容</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="EmptyCell"/>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="SecondRow">
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellText">変更後の内容</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="EmptyCell"/>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ThirdRow">
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellText">変更理由</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="EmptyCell"/>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageBreak"/>
    </office:text>
  </office:body>
</office:document>