<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:line-height="115%" fo:margin-top="0cm" fo:margin-bottom="0.05cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.1cm" fo:margin-bottom="0.2cm"/>
      <style:text-properties fo:font-size="18pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="PageTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.1cm" fo:margin-bottom="0.2cm"/>
      <style:text-properties fo:font-size="16pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="1pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="BoldCenter" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Label" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle" fo:background-color="#eeeeee"/>
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="CenterCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="NarrowCol" style:family="table-column">
      <style:table-column-properties style:column-width="2.4cm"/>
    </style:style>
    <style:style style:name="WideCol" style:family="table-column">
      <style:table-column-properties style:column-width="5.2cm"/>
    </style:style>
    <style:style style:name="FullTable" style:family="table">
      <style:table-properties style:width="17.5cm" table:align="center"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.5cm" fo:margin-bottom="1.5cm" fo:margin-left="1.5cm" fo:margin-right="1.5cm" style:print-orientation="portrait"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">「학교장 허가(승인) 교외체험학습」 신청서</text:p>
      <table:table table:name="신청서" table:style-name="FullTable">
        <table:table-column table:style-name="NarrowCol"/>
        <table:table-column table:style-name="NarrowCol"/>
        <table:table-column table:style-name="NarrowCol"/>
        <table:table-column table:style-name="WideCol"/>
        <table:table-row>
          <table:table-cell table:style-name="CenterCell"><text:p text:style-name="Center">담임</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p text:style-name="Center">부장</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p text:style-name="Center">교감</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p text:style-name="BoldCenter">학생 성명</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Label"><text:p text:style-name="BoldCenter">학년　반　번</text:p></table:table-cell>
          <table:table-cell table:style-name="Label"><text:p text:style-name="BoldCenter">휴대전화</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p text:style-name="BoldCenter">출석인정기간</text:p><text:p text:style-name="BoldCenter">학기당 10일</text:p></table:table-cell>
          <table:table-cell table:style-name="Label"><text:p text:style-name="BoldCenter">신청 기간</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">년　 월　 일　~　 월　 일 (　) 일간</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="BoldCenter">우리 학교 학교장 허가 교외체험학습 규정 및 불허기간을 확인하였음</text:p><text:p text:style-name="BoldCenter">시험기간, 성적이의신청기간(3일간), 재시험기간(2일간)에는 불허</text:p><text:p text:style-name="BoldCenter">※ 필요 시 담임교사와의 사전 협의 또는 문의</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="CenterCell"><text:p text:style-name="Center">서명 또는 (인)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p text:style-name="BoldCenter">학습 내용</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p>○ 현장체험학습(　) ○ 친·인척 방문(　) ○ 가족동반여행(　) ○ 고적답사(　)</text:p><text:p>○ 향토행사 참여(　) ○ 기타(　　　　　　　　　)</text:p><text:p>○ 감염병 심각 단계로 인한 가정학습(　)</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p text:style-name="BoldCenter">목적지</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Label"><text:p text:style-name="BoldCenter">숙박장소</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p text:style-name="BoldCenter">보호자명</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Label"><text:p text:style-name="BoldCenter">관계</text:p></table:table-cell>
          <table:table-cell table:style-name="Label"><text:p text:style-name="BoldCenter">휴대폰</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p text:style-name="BoldCenter">인솔자명</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">(　 세)</text:p></table:table-cell>
          <table:table-cell table:style-name="Label"><text:p text:style-name="BoldCenter">관계</text:p></table:table-cell>
          <table:table-cell table:style-name="Label"><text:p text:style-name="BoldCenter">휴대폰</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p text:style-name="BoldCenter">목 적</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p text:style-name="BoldCenter">교외</text:p><text:p text:style-name="BoldCenter">체험</text:p><text:p text:style-name="BoldCenter">학습</text:p><text:p text:style-name="BoldCenter">계획</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label" table:number-rows-spanned="2"><text:p text:style-name="Center">보호자 외 대리</text:p><text:p text:style-name="Center">인솔 시 학생</text:p><text:p text:style-name="Center">안전 위임 등에</text:p><text:p text:style-name="Center">대한 내용</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p text:style-name="Center">인솔자</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>이름:</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p text:style-name="Center">연락처</text:p><text:p text:style-name="Center">☎ (　)-(　)-(　)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CenterCell"><text:p text:style-name="Center">인솔 내용</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CenterCell"><text:p text:style-name="Center">서약</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3">
            <text:p>○ 미성년자이므로 보호자 동반 체험학습이 원칙이나, 보호자의 위임을 받아 학생의 안전·건강을 책임지고 대리 인솔합니다.</text:p>
            <text:p>학생과 관련된 안전사고 발생 시 이에 대한 책임을 지겠습니다.</text:p>
            <text:p text:style-name="Center">인솔자:　　　　□</text:p>
          </table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body">‘(연속) 5일 이상 교외체험학습(가정학습 포함)시 주 1회 이상 자녀(학생)가 담임교사와 통화하여</text:p>
      <text:p text:style-name="Body">안전, 건강을 확인시키겠습니다.’　　　　□ 동의합니다.</text:p>
      <text:p text:style-name="Body">위반 시 위기학생관리위원회 개최를 요청하고, 군청 관련과 또는 수사기관에 신고할 수 있음을</text:p>
      <text:p text:style-name="Body">알려드립니다.</text:p>
      <text:p text:style-name="Body">가족동반여행 등 교외체험학습의 경우 미성년자인 자녀의 보호를 위해 보호자 동행함이</text:p>
      <text:p text:style-name="Body">원칙임을 안내합니다. 만약 신청 기간 중 발생하는 안전사고는 보호자 책임임을 인지하며, 위 학생의</text:p>
      <text:p text:style-name="Body">교외체험학습을 실시하고자 신청합니다.</text:p>
      <text:p text:style-name="Center">년　 월　 일</text:p>
      <text:p text:style-name="Body">--------------------------------학생:　 ______　 인</text:p>
      <text:p text:style-name="Body">-------------------------- 보호자:　 ______　 인</text:p>
      <text:p text:style-name="Title">범서중학교장　귀하</text:p>

      <text:p text:style-name="PageBreak"/>
      <text:p text:style-name="PageTitle">「학교장 허가(승인) 교외체험학습」 결과보고서</text:p>
      <table:table table:name="결과보고서" table:style-name="FullTable">
        <table:table-column table:style-name="NarrowCol"/><table:table-column table:style-name="NarrowCol"/><table:table-column table:style-name="NarrowCol"/><table:table-column table:style-name="WideCol"/>
        <table:table-row><table:table-cell table:style-name="Label"><text:p text:style-name="BoldCenter">성 명</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Label"><text:p text:style-name="BoldCenter">학년 반</text:p></table:table-cell><table:table-cell table:style-name="CenterCell"><text:p text:style-name="Center">학년　 반　 번</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Label" table:number-columns-spanned="2"><text:p text:style-name="BoldCenter">교외체험학습 기간</text:p></table:table-cell><table:covered-table-cell/><table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">20　 년　 월　 일　~　 월　 일 (　) 일간</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Label" table:number-columns-spanned="2"><text:p text:style-name="BoldCenter">교외체험학습 장소</text:p></table:table-cell><table:covered-table-cell/><table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Label"><text:p text:style-name="BoldCenter">학습 내용</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p>○ 현장체험학습(　) ○ 친·인척 방문(　) ○ 가족동반여행(　) ○ 고적답사(　)</text:p><text:p>○ 향토행사 참여(　) ○ 기타(　　　　) ○ 감염병 심각단계로 인한 가정학습(　)</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Label"><text:p text:style-name="BoldCenter">제　목</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="3"/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p>＊ 각 일정별로 느낀 점, 배운 점 등을 글로 기록하고, 자료, 사진 등으로 학생이 직접 작성합니다. (검은색 볼펜 사용)</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p>첨부: 사진(본인 및 배경 포함)　 장, 입장권　 매, 항공권　 매 등</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Center">위와 같이 「학교장 허가(승인) 교외 체험학습」 결과보고서를 제출합니다.</text:p><text:p text:style-name="Center">20　 .　 .　 .</text:p><text:p text:style-name="Center">보호자:　　 (서명 또는 인)</text:p><text:p text:style-name="Center">학생:　　　(서명 또는 인)</text:p><text:p text:style-name="Title">범서중학교장　귀하</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
      </table:table>
      <text:p text:style-name="Body">※ 보고서 제출 기한: 체험학습 종료 후 7일 이내(휴일 포함)</text:p>

      <text:p text:style-name="PageBreak"/>
