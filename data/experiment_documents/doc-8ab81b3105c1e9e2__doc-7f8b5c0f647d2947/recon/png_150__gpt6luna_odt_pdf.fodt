<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="10pt"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.08cm" fo:line-height="110%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.45cm" fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="16pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="SmallCenter" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="7pt"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="1pt"/>
    </style:style>
    <style:style style:name="Grid" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Heavy" style:family="table-cell">
      <style:table-cell-properties fo:border="1.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="NoBorder" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0.02cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Vert" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="middle" style:writing-mode="tb-rl"/>
    </style:style>
    <style:style style:name="Col" style:family="table-column">
      <style:table-column-properties style:column-width="2cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.1cm" fo:margin-bottom="1.1cm" fo:margin-left="1.25cm" fo:margin-right="1.25cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">軽自動車税減免申請書</text:p>
      <text:p text:style-name="Body">（あて先）亀山市長　　　　　　　　　　　　　　　　　　　　　　　　　令和　　年　　月　　日</text:p>
      <table:table table:name="納税義務者">
        <table:table-column table:style-name="Col" table:number-columns-repeated="6"/>
        <table:table-row>
          <table:table-cell table:style-name="Grid" table:number-rows-spanned="4"><text:p text:style-name="Center">納税義務者</text:p><text:p text:style-name="Center">（申請者）</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid"><text:p text:style-name="Center">住　所</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="4"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Grid"><text:p text:style-name="SmallCenter">ふりがな</text:p><text:p text:style-name="Center">氏　名</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="2"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Grid"><text:p text:style-name="SmallCenter">（本人が自署しない場合は押印）</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid"><text:p text:style-name="SmallCenter">身体障害者等との関係</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Grid"><text:p text:style-name="Center">電話番号</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="4"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Grid"><text:p text:style-name="Center">個人番号</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Grid"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Grid"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Grid"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body">亀山市税条例第９７条第１項第１号の規定に基づき、軽自動車税の減免を受けたいので、下記の</text:p>
      <text:p text:style-name="Body">とおり申請します。</text:p>
      <text:p text:style-name="Center">記</text:p>
      <table:table table:name="申請事項">
        <table:table-column table:style-name="Col" table:number-columns-repeated="9"/>
        <table:table-row>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="3"><text:p text:style-name="Center">運　転　区　分</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="6"><text:p text:style-name="Center">□本人運転　　□家族運転　　□介護者運転</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Vert" table:number-rows-spanned="7"><text:p text:style-name="Center">減免を申請する軽自動車等の内</text:p></table:table-cell>
          <table:table-cell table:style-name="Vert" table:number-rows-spanned="2"><text:p text:style-name="Center">所有者</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid"><text:p text:style-name="Center">住　所</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="6"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Grid"><text:p text:style-name="Center">氏　名</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="3"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="2"><text:p text:style-name="SmallCenter">身体障害者等との関係</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Vert" table:number-rows-spanned="2"><text:p text:style-name="Center">使用者</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid"><text:p text:style-name="Center">車　両　番　号</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="3"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="2"><text:p text:style-name="Center">種　別</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Grid"><text:p text:style-name="Center">主たる定置場</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="6"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="2"><text:p text:style-name="Center">用途及び使用目的</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="6"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Grid"><text:p text:style-name="Center">住　所</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="7"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Grid"><text:p text:style-name="Center">氏　名</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="3"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="2"><text:p text:style-name="SmallCenter">身体障害者等との関係</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="2"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Vert" table:number-rows-spanned="3"><text:p text:style-name="Center">の内容</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid"><text:p text:style-name="Center">番　号</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid"><text:p text:style-name="Center">第　　　号</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="2"><text:p text:style-name="Center">交付年月日</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="3"><text:p text:style-name="Center">令和　　年　　月　　日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Grid"><text:p text:style-name="Center">有効期限</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid"><text:p text:style-name="Center">令和　　年　　月　　日</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="2"><text:p text:style-name="Center">種　類</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="3"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Grid"><text:p text:style-name="Center">条　件</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="5"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageBreak"/>
      <table:table table:name="手帳等の内容">
        <table:table-column table:style-name="Col" table:number-columns-repeated="8"/>
        <table:table-row>
          <table:table-cell table:style-name="Grid"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Grid"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Heavy"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Heavy"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="4"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Vert" table:number-rows-spanned="5"><text:p text:style-name="Center">身体障害者</text:p></table:table-cell>
          <table:table-cell table:style-name="Vert" table:number-rows-spanned="5"><text:p text:style-name="Center">手帳等の内容</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid"><text:p text:style-name="Center">住　所</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="5"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Grid"><text:p text:style-name="Center">氏　名</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="2"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Heavy" table:number-columns-spanned="2"><text:p text:style-name="Center">年　齢</text:p></table:table-cell>
          <table:table-cell table:style-name="Heavy"><text:p text:style-name="Center">歳</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Grid"><text:p text:style-name="Center">身体障害者手帳等の番号</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="2"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="2"><text:p text:style-name="Center">交付年月日</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid"><text:p text:style-name="Center">年　　月　　日</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Grid" table:number-rows-spanned="2"><text:p text:style-name="Center">障害名</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="2" table:number-rows-spanned="2"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="2" table:number-rows-spanned="2"><text:p text:style-name="Center">障害の程度</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="2" table:number-rows-spanned="2"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <table:table table:name="市役所記入欄">
        <table:table-column table:style-name="Col" table:number-columns-repeated="4"/>
        <table:table-row>
          <table:table-cell table:style-name="Grid" table:number-rows-spanned="4"><text:p text:style-name="Center">市</text:p><text:p text:style-name="Center">役</text:p><text:p text:style-name="Center">所</text:p><text:p text:style-name="Center">記</text:p><text:p text:style-name="Center">入</text:p><text:p text:style-name="Center">欄</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid"><text:p text:style-name="Center">受付</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid"><text:p text:style-name="Center">入力</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid"><text:p text:style-name="Center">確認</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Grid"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Grid"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Grid"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Grid" table:number-rows-spanned="2"><text:p text:style-name="Center">宛名番号</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="2" table:number-rows-spanned="2"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>