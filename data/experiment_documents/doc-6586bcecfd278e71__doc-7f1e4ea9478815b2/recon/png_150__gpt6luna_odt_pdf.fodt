<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin="0pt" fo:line-height="normal"/>
      <style:text-properties fo:font-family="Noto Sans CJK TC" fo:font-size="18pt" style:font-size-asian="18pt" style:font-size-complex="18pt"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="3pt" fo:margin-bottom="30pt" fo:line-height="32pt"/>
      <style:text-properties fo:font-family="Noto Sans CJK TC" fo:font-size="26pt" style:font-size-asian="26pt" style:font-size-complex="26pt"/>
    </style:style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:line-height="36pt"/>
      <style:text-properties fo:font-family="Noto Sans CJK TC" fo:font-size="22pt" style:font-size-asian="22pt" style:font-size-complex="22pt"/>
    </style:style>
    <style:style style:name="Close" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="61pt" fo:line-height="36pt"/>
      <style:text-properties fo:font-family="Noto Sans CJK TC" fo:font-size="18pt" style:font-size-asian="18pt" style:font-size-complex="18pt"/>
    </style:style>
    <style:style style:name="OfficeName" style:family="paragraph">
      <style:paragraph-properties fo:line-height="36pt"/>
      <style:text-properties fo:font-family="Noto Sans CJK TC" fo:font-size="18pt" style:font-size-asian="18pt" style:font-size-complex="18pt"/>
    </style:style>
    <style:style style:name="FieldTable" style:family="table">
      <style:table-properties style:width="481pt" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="FieldCol1" style:family="table-column">
      <style:table-column-properties style:column-width="94pt"/>
    </style:style>
    <style:style style:name="FieldCol2" style:family="table-column">
      <style:table-column-properties style:column-width="100pt"/>
    </style:style>
    <style:style style:name="FieldCol3" style:family="table-column">
      <style:table-column-properties style:column-width="287pt"/>
    </style:style>
    <style:style style:name="DateTable" style:family="table">
      <style:table-properties style:width="474pt" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="DateCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0pt" fo:border="none" style:vertical-align="middle"/>
      <style:paragraph-properties fo:line-height="26pt" fo:text-align="center"/>
      <style:text-properties fo:font-family="Noto Sans CJK TC" fo:font-size="16pt" style:font-size-asian="16pt" style:font-size-complex="16pt"/>
    </style:style>
    <style:style style:name="FooterTable" style:family="table">
      <style:table-properties style:width="481pt" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="FooterCol1" style:family="table-column">
      <style:table-column-properties style:column-width="276pt"/>
    </style:style>
    <style:style style:name="FooterCol2" style:family="table-column">
      <style:table-column-properties style:column-width="205pt"/>
    </style:style>
    <style:style style:name="FooterCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0pt" fo:border="none" style:vertical-align="middle"/>
      <style:paragraph-properties fo:line-height="20pt"/>
      <style:text-properties fo:font-family="Times New Roman" fo:font-size="12pt" style:font-size-asian="12pt" style:font-size-complex="12pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="2cm" fo:margin-right="2cm" fo:margin-top="1.8cm" fo:margin-bottom="2cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">逢「4」不編申請書</text:p>
      <text:p text:style-name="Body">本人<text:s text:c="15"/>於<text:s/>貴轄新建房屋<text:s text:c="5"/>戶，建造執照(　)</text:p>
      <text:p text:style-name="Body">建執照字第<text:s text:c="8"/>號，懇請貴所於編釘門牌時，將門</text:p>
      <text:p text:style-name="Body">牌尾數號次為「4」者，抽空不編。</text:p>
      <text:p text:style-name="Close">此致</text:p>
      <text:p text:style-name="OfficeName">桃園市平鎮區戶政事務所</text:p>
      <table:table table:name="ApplicantFields" table:style-name="FieldTable">
        <table:table-column table:style-name="FieldCol1"/>
        <table:table-column table:style-name="FieldCol2"/>
        <table:table-column table:style-name="FieldCol3"/>
        <table:table-row>
          <table:table-cell><text:p>申請人姓名:</text:p></table:table-cell>
          <table:table-cell><text:p/></table:table-cell>
          <table:table-cell><text:p>(簽章)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell><text:p>身分證字號:</text:p></table:table-cell>
          <table:table-cell><text:p/></table:table-cell>
          <table:table-cell><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell><text:p>戶籍地址:</text:p></table:table-cell>
          <table:table-cell><text:p/></table:table-cell>
          <table:table-cell><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell><text:p>電話:</text:p></table:table-cell>
          <table:table-cell><text:p/></table:table-cell>
          <table:table-cell><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <table:table table:name="DateLine" table:style-name="DateTable">
        <table:table-column table:style-name="DateCell" table:number-columns-repeated="13"/>
        <table:table-row>
          <table:table-cell table:style-name="DateCell"><text:p>中</text:p></table:table-cell>
          <table:table-cell table:style-name="DateCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="DateCell"><text:p>華</text:p></table:table-cell>
          <table:table-cell table:style-name="DateCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="DateCell"><text:p>民</text:p></table:table-cell>
          <table:table-cell table:style-name="DateCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="DateCell"><text:p>國</text:p></table:table-cell>
          <table:table-cell table:style-name="DateCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="DateCell"><text:p>年</text:p></table:table-cell>
          <table:table-cell table:style-name="DateCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="DateCell"><text:p>月</text:p></table:table-cell>
          <table:table-cell table:style-name="DateCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="DateCell"><text:p>日</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <table:table table:name="PrintedFooter" table:style-name="FooterTable">
        <table:table-column table:style-name="FooterCol1"/>
        <table:table-column table:style-name="FooterCol2"/>
        <table:table-row>
          <table:table-cell table:style-name="FooterCell"><text:p>380022200AC2Z006</text:p></table:table-cell>
          <table:table-cell table:style-name="FooterCell"><text:p>10540101</text:p></table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>