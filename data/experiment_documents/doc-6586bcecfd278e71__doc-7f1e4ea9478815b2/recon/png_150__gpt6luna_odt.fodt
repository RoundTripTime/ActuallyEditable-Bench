<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="120%" fo:margin-top="0.45cm" fo:margin-bottom="1.25cm"/>
      <style:text-properties fo:font-size="22pt"/>
    </style:style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:line-height="145%" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-size="20pt"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:line-height="145%" fo:margin-bottom="0.15cm"/>
      <style:text-properties fo:font-size="18pt"/>
    </style:style>
    <style:style style:name="Spacer" style:family="paragraph">
      <style:paragraph-properties fo:line-height="1cm"/>
      <style:text-properties fo:font-size="1pt"/>
    </style:style>
    <style:style style:name="Field" style:family="paragraph">
      <style:paragraph-properties fo:line-height="1.28cm"/>
      <style:text-properties fo:font-size="18pt"/>
    </style:style>
    <style:style style:name="DateText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="1.1cm"/>
      <style:text-properties fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="FooterText" style:family="paragraph">
      <style:paragraph-properties fo:line-height="0.6cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.5cm" fo:margin-bottom="2cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
    </style:page-layout>
    <style:style style:name="FieldTable" style:family="table">
      <style:table-properties table:align="margins"/>
    </style:style>
    <style:style style:name="FieldCol1" style:family="table-column">
      <style:table-column-properties style:column-width="6cm"/>
    </style:style>
    <style:style style:name="FieldCol2" style:family="table-column">
      <style:table-column-properties style:column-width="5cm"/>
    </style:style>
    <style:style style:name="FieldCol3" style:family="table-column">
      <style:table-column-properties style:column-width="6cm"/>
    </style:style>
    <style:style style:name="DateTable" style:family="table">
      <style:table-properties table:align="margins"/>
    </style:style>
    <style:style style:name="DateCol2" style:family="table-column">
      <style:table-column-properties style:column-width="2cm"/>
    </style:style>
    <style:style style:name="DateCol36" style:family="table-column">
      <style:table-column-properties style:column-width="3.6cm"/>
    </style:style>
    <style:style style:name="DateCol34" style:family="table-column">
      <style:table-column-properties style:column-width="3.4cm"/>
    </style:style>
    <style:style style:name="DateColLast" style:family="table-column">
      <style:table-column-properties style:column-width="0.6cm"/>
    </style:style>
    <style:style style:name="FooterCol1" style:family="table-column">
      <style:table-column-properties style:column-width="9cm"/>
    </style:style>
    <style:style style:name="FooterCol2" style:family="table-column">
      <style:table-column-properties style:column-width="8cm"/>
    </style:style>
    <style:style style:name="PlainCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0cm" style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">逢「4」不編申請書</text:p>
      <text:p text:style-name="Body">本人<text:s text:c="8"/>於 貴轄新建房屋<text:s text:c="4"/>戶，建造執照( )</text:p>
      <text:p text:style-name="Body">建執照字第<text:s text:c="5"/>號，懇請貴所於編釘門牌時，將門</text:p>
      <text:p text:style-name="Body">牌尾數號次為「4」者，抽空不編。</text:p>
      <text:p text:style-name="Spacer"/>
      <text:p text:style-name="Section">此致</text:p>
      <text:p text:style-name="Section">桃園市平鎮區戶政事務所</text:p>
      <text:p text:style-name="Spacer"/>
      <table:table table:name="ApplicantFields" table:style-name="FieldTable">
        <table:table-column table:style-name="FieldCol1"/>
        <table:table-column table:style-name="FieldCol2"/>
        <table:table-column table:style-name="FieldCol3"/>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="Field">申請人姓名:</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="Field">(簽章)</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="Field"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="Field">身分證字號:</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="Field"/></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="Field"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="Field">戶籍地址:</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="Field"/></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="Field"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="Field">電話:</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="Field"/></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="Field"/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Spacer"/>
      <text:p text:style-name="Spacer"/>
      <table:table table:name="DateLine" table:style-name="DateTable">
        <table:table-column table:style-name="DateCol2"/>
        <table:table-column table:style-name="DateCol2"/>
        <table:table-column table:style-name="DateCol2"/>
        <table:table-column table:style-name="DateCol36"/>
        <table:table-column table:style-name="DateCol34"/>
        <table:table-column table:style-name="DateCol34"/>
        <table:table-column table:style-name="DateColLast"/>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="DateText">中</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="DateText">華</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="DateText">民</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="DateText">國</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="DateText">年</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="DateText">月</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="DateText">日</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Spacer"/>
      <table:table table:name="PrintedCodes" table:style-name="FieldTable">
        <table:table-column table:style-name="FooterCol1"/>
        <table:table-column table:style-name="FooterCol2"/>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="FooterText">380022200AC2Z006</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="FooterText">10540101</text:p></table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>