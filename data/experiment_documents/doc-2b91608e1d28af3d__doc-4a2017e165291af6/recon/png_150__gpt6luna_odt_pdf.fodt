<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="1.2cm" fo:margin-bottom="1.2cm"/>
      <style:text-properties fo:font-family="Batang" fo:font-size="12pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.7cm" fo:margin-bottom="1.4cm"/>
      <style:text-properties fo:font-family="Batang" fo:font-size="20pt" fo:font-weight="bold" style:text-underline-style="solid"/>
    </style:style>
    <style:style style:name="CellText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Batang" fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="CenterText" style:family="paragraph" style:parent-style-name="CellText">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
    </style:style>
    <style:style style:name="BoldCell" style:family="paragraph" style:parent-style-name="CenterText">
      <style:text-properties fo:font-family="Batang" fo:font-size="10pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="SectionText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Batang" fo:font-size="12pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="StatementText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="130%"/>
      <style:text-properties fo:font-family="Batang" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Signature" style:family="text">
      <style:text-properties fo:color="#0000ff" style:text-underline-style="solid"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties table:align="margins" style:width="17.8cm"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="2.18cm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="6.32cm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="2.05cm"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties style:column-width="1.32cm"/>
    </style:style>
    <style:style style:name="Col5" style:family="table-column">
      <style:table-column-properties style:column-width="5.93cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #555555" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="GrayCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #555555" fo:padding="0.04cm" fo:background-color="#E6E6E6" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="TallCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #555555" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="FormRow" style:family="table-row">
      <style:table-row-properties fo:keep-together="always"/>
    </style:style>
    <style:style style:name="LargeRow" style:family="table-row">
      <style:table-row-properties fo:min-height="5.5cm"/>
    </style:style>
    <style:style style:name="StatementRow" style:family="table-row">
      <style:table-row-properties fo:min-height="4.8cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-left="1.5cm" fo:margin-right="1.5cm" fo:margin-top="1.5cm" fo:margin-bottom="1.5cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">【붙임1-2】</text:p>
      <text:p text:style-name="Title">공공심야약국 운영계획서</text:p>
      <table:table table:name="운영계획서" table:style-name="FormTable">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-column table:style-name="Col5"/>
        <table:table-row table:style-name="FormRow">
          <table:table-cell table:style-name="GrayCell" table:number-columns-spanned="5"><text:p text:style-name="SectionText">1. 일반 현황</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:table-cell table:style-name="GrayCell" table:number-rows-spanned="4"><text:p text:style-name="BoldCell">현재</text:p><text:p text:style-name="BoldCell">근무인력</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText">약국개설자:</text:p></table:table-cell>
          <table:table-cell table:style-name="GrayCell" table:number-rows-spanned="4"><text:p text:style-name="BoldCell">주변환경</text:p><text:p text:style-name="BoldCell">(주거지역,</text:p><text:p text:style-name="BoldCell">의료기관)</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="CellText">1층 위치 여부: □ 예 □ 아니오</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText">상근약사 :</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="CellText">5km 이내 주거단지 규모:</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText">비상근(시간제)약사 :</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="CellText">월평균 처방조제건수 :</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText">보조인력 :</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="CellText">월평균 일반약매출액 :</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:table-cell table:style-name="GrayCell" table:number-rows-spanned="4"><text:p text:style-name="BoldCell">현재</text:p><text:p text:style-name="BoldCell">운영시간</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText">평일:</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="CellText">現휴일지킴이 약국 여부: □ 예 □ 아니오</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText">토요일:</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="CellText">現달빛어린이병원 협력약국 여부: □ 예 □ 아니오</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText">일·공휴일:</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="CellText">前공공심야약국 운영 경험 여부:□ 예□아니오</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText">휴무일:</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="CellText">前공공심야약국 운영 기간:</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:table-cell table:style-name="GrayCell" table:number-columns-spanned="5"><text:p text:style-name="SectionText">2. 운영 계획</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:table-cell table:style-name="GrayCell" table:number-rows-spanned="7"><text:p text:style-name="BoldCell">심야시간</text:p><text:p text:style-name="BoldCell">근무인력</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText">약국개설자: 해당없음</text:p></table:table-cell>
          <table:table-cell table:style-name="GrayCell" table:number-rows-spanned="7"><text:p text:style-name="BoldCell">심야시간</text:p><text:p text:style-name="BoldCell">운영계획</text:p></table:table-cell>
          <table:table-cell table:style-name="GrayCell" table:number-rows-spanned="3"><text:p text:style-name="BoldCell">단일기</text:p><text:p text:style-name="BoldCell">관</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText">□ 매일 22시 ～ 익일 1시</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText">상근약사: 해당없음</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText">□ 매일 21시 ～ 24시</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText">비상근(시간제)약사: 2명(교대)</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText">□ 매일 20시 ～ 23시</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText">보조인력:</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GrayCell" table:number-rows-spanned="4"><text:p text:style-name="BoldCell">연합기</text:p><text:p text:style-name="BoldCell">관</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText">□월·화·수·목·금 □토 □일·</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText">※비고사항: 채용계획 등</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText">□ 운영일 22시 ～ 익일 1시</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p text:style-name="CellText"/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText">□ 운영일 21시 ～ 24시</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p text:style-name="CellText"/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText">□ 운영일 20시 ～ 23시</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="LargeRow">
          <table:table-cell table:style-name="GrayCell"><text:p text:style-name="BoldCell">세부</text:p><text:p text:style-name="BoldCell">운영계획</text:p></table:table-cell>
          <table:table-cell table:style-name="TallCell" table:number-columns-spanned="4"><text:p text:style-name="CellText"/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="StatementRow">
          <table:table-cell table:style-name="GrayCell"><text:p text:style-name="BoldCell">사업참여의</text:p><text:p text:style-name="BoldCell">지계획</text:p></table:table-cell>
          <table:table-cell table:style-name="TallCell" table:number-columns-spanned="4">
            <text:p text:style-name="StatementText">본인은 약사법 제21조의3(공공심야약국 지정·운영 등)에 따른 공공심야약국을 지정받기를 희망하며, 상기 운영 계획에 따라 사업에 참여하여, 정해진 운영시간과 준수사항을 이행하여 지역주민의 의약품 접근성을 높이는 데 사회적 역할과 책임을 다하고, 정부의 공공심야약국 지정·운영 사업의 효과적 수행을 위해 최선의 노력과 협조를 다하겠습니다.</text:p>
            <text:p text:style-name="CenterText">년 월 일　　　　　　　　　　　　약국 개설자　<text:span text:style-name="Signature">(서명)</text:span></text:p>
          </table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>