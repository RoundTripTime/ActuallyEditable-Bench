<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
                 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
                 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
                 xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
                 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
                 office:mimetype="application/vnd.oasis.opendocument.text"
                 office:version="1.4">
  <office:styles>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0in" fo:margin-right="0in" fo:margin-top="0in" fo:margin-bottom="0in" fo:line-height="16pt"/>
      <style:text-properties fo:font-family="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:text-align="center" fo:line-height="20pt"/>
      <style:text-properties fo:font-family="serif" fo:font-size="15pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Indent" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:margin-left="0.30in"/>
    </style:style>
    <style:style style:name="DeepIndent" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:margin-left="0.95in"/>
    </style:style>
    <style:style style:name="RightStamp" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:margin-left="5.95in"/>
      <style:text-properties fo:font-family="serif" fo:font-size="18pt"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:break-before="page" fo:line-height="1pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="8.27in" fo:page-height="11.69in" style:print-orientation="portrait" fo:margin-left="0.75in" fo:margin-right="0.75in" fo:margin-top="0.45in" fo:margin-bottom="0.45in"/>
    </style:page-layout>
    <style:style style:name="TopStamp" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:margin-left="0.65in" fo:margin-top="0.20in"/>
      <style:text-properties fo:font-size="18pt"/>
    </style:style>
    <style:style style:name="PageOneTitle" style:family="paragraph" style:parent-style-name="Title">
      <style:paragraph-properties fo:margin-top="0.70in"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:margin-left="2.90in" fo:margin-top="0.18in"/>
    </style:style>
    <style:style style:name="NameLine" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:margin-left="4.05in" fo:margin-top="0.58in"/>
    </style:style>
    <style:style style:name="Item" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:margin-top="0.78in"/>
    </style:style>
    <style:style style:name="SubItem" style:family="paragraph" style:parent-style-name="Indent">
      <style:paragraph-properties fo:margin-top="0.58in"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:margin-top="0.60in"/>
    </style:style>
    <style:style style:name="Subsection" style:family="paragraph" style:parent-style-name="Indent">
      <style:paragraph-properties fo:margin-top="0.20in"/>
    </style:style>
    <style:style style:name="PageTwoTop" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:margin-left="0.23in" fo:margin-top="1.45in"/>
    </style:style>
    <style:style style:name="PageTwoSection" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:margin-top="1.92in"/>
    </style:style>
    <style:style style:name="PageTwoItem" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:margin-top="1.45in"/>
    </style:style>
    <style:style style:name="PageTwoSub" style:family="paragraph" style:parent-style-name="Indent">
      <style:paragraph-properties fo:margin-top="0.28in"/>
    </style:style>
    <style:style style:name="PageTwoStamp" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:margin-left="0.78in" fo:margin-top="0.48in"/>
      <style:text-properties fo:font-size="18pt"/>
    </style:style>
    <style:style style:name="PageTwoSubLarge" style:family="paragraph" style:parent-style-name="Indent">
      <style:paragraph-properties fo:margin-top="0.52in"/>
    </style:style>
    <style:style style:name="PageThreeTop" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:margin-left="0.23in" fo:margin-top="2.22in"/>
    </style:style>
    <style:style style:name="PageThreeItem" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:margin-top="1.78in"/>
    </style:style>
    <style:style style:name="PageThreeItemLarge" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:margin-top="1.90in"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="2.40in" table:align="left"/>
    </style:style>
    <style:style style:name="FormColumnA" style:family="table-column">
      <style:table-column-properties style:column-width="0.70in"/>
    </style:style>
    <style:style style:name="FormColumnB" style:family="table-column">
      <style:table-column-properties style:column-width="0.50in"/>
    </style:style>
    <style:style style:name="FormColumnC" style:family="table-column">
      <style:table-column-properties style:column-width="0.65in"/>
    </style:style>
    <style:style style:name="FormColumnD" style:family="table-column">
      <style:table-column-properties style:column-width="0.35in"/>
    </style:style>
    <style:style style:name="FormColumnE" style:family="table-column">
      <style:table-column-properties style:column-width="0.20in"/>
    </style:style>
    <style:style style:name="FormCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0in" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="FormRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.40in"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="TopStamp">㊞</text:p>
      <text:p text:style-name="PageOneTitle">営　農　計　画　書</text:p>
      <text:p text:style-name="Recipient">譲受人（借人）　住所</text:p>
      <text:p text:style-name="NameLine">氏名</text:p>
      <text:p text:style-name="RightStamp">㊞</text:p>
      <text:p text:style-name="Item">1.　構成人数（同一世帯人数）　　　　　　　　　人</text:p>
      <text:p text:style-name="SubItem">うち、必要な農作業に常時従事する者　　　　　人</text:p>
      <text:p text:style-name="Section">2.　経営面積</text:p>
      <table:table table:name="AreaFields" table:style-name="FormTable">
        <table:table-column table:style-name="FormColumnA"/>
        <table:table-column table:style-name="FormColumnB"/>
        <table:table-column table:style-name="FormColumnC"/>
        <table:table-column table:style-name="FormColumnD"/>
        <table:table-column table:style-name="FormColumnE"/>
        <table:table-row table:style-name="FormRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="P">畑</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="P"/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="P">a,　計</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="P"/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="P">a</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="DeepIndent">うち、借入地</text:p>
      <table:table table:name="BorrowedAreaFields" table:style-name="FormTable">
        <table:table-column table:style-name="FormColumnA"/>
        <table:table-column table:style-name="FormColumnB"/>
        <table:table-column table:style-name="FormColumnC"/>
        <table:table-column table:style-name="FormColumnD"/>
        <table:table-column table:style-name="FormColumnE"/>
        <table:table-row table:style-name="FormRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="P">畑</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="P"/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="P">a,　計</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="P"/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="P">a</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Section">3.　営農経営の概要等</text:p>
      <text:p text:style-name="Subsection">（1）　現在の経営状況及び年間販売高等</text:p>

      <text:p text:style-name="PageBreak"/>
      <text:p text:style-name="PageTwoTop">（2）　申請地を取得した後の具体的な営農計画及び年間販売高等</text:p>
      <text:p text:style-name="PageTwoSection">4.　農業以外の事業を行っている場合は、その概要</text:p>
      <text:p text:style-name="PageTwoItem">5.　取得しようとする農地に必要とする所要労働力及び重要な作業方法等</text:p>
      <text:p text:style-name="PageTwoSub">（1）　播種及び植付の方法</text:p>
      <text:p text:style-name="PageTwoStamp">㊞</text:p>
      <text:p text:style-name="PageTwoSubLarge">（2）　水利見廻り等一般管理の方法</text:p>
      <text:p text:style-name="PageTwoSubLarge">（3）　施肥、除草等の方法</text:p>

      <text:p text:style-name="PageBreak"/>
      <text:p text:style-name="PageThreeTop">（4）　病害虫発生等に係る薬剤散布の方法</text:p>
      <text:p text:style-name="PageThreeItem">（5）　収穫の方法</text:p>
      <text:p text:style-name="PageThreeItemLarge">6.　他の農地における作業と競合の有無及び対策</text:p>
      <text:p text:style-name="PageThreeItemLarge">7.　取得する農地の付近に現に耕作する農地があれば、その表示</text:p>
    </office:text>
  </office:body>
</office:document>