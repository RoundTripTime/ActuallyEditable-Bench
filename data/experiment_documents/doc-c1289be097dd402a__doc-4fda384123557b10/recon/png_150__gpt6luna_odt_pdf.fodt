<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="12pt" fo:color="#000000"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:master-page-name="Standard" style:next-style-name="Body">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.6cm" fo:margin-bottom="0.55cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="District" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-bottom="0.25cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.12cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Centered" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="100%"/>
    </style:style>
    <style:style style:name="TotalLabel" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="100%"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.25cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="UnderlinedSpace" style:family="text">
      <style:text-properties style:text-underline-style="solid" style:text-underline-type="single" style:text-underline-width="auto"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-left="2.08cm" fo:margin-right="2.08cm" fo:margin-top="2.4cm" fo:margin-bottom="2.4cm"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="16.84cm" table:align="center" table:border-model="collapsing" fo:margin-bottom="0.7cm"/>
    </style:style>
    <style:style style:name="ColItem" style:family="table-column">
      <style:table-column-properties style:column-width="4.45cm"/>
    </style:style>
    <style:style style:name="ColAmount" style:family="table-column">
      <style:table-column-properties style:column-width="4.94cm"/>
    </style:style>
    <style:style style:name="ColRemarks" style:family="table-column">
      <style:table-column-properties style:column-width="7.45cm"/>
    </style:style>
    <style:style style:name="FormCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.12cm" style:vertical-align="middle"/>
      <style:text-properties fo:font-family="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="HeaderRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.99cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="InputRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.18cm" style:use-optimal-row-height="false"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">区誌　（史）　編さん事業　収支予算書</text:p>
      <text:p text:style-name="District"><text:span text:style-name="UnderlinedSpace"><text:s text:c="9"/></text:span>　区</text:p>
      <text:p text:style-name="Section">＜収入の部＞</text:p>
      <table:table table:name="収入の部" table:style-name="FormTable">
        <table:table-column table:style-name="ColItem"/>
        <table:table-column table:style-name="ColAmount"/>
        <table:table-column table:style-name="ColRemarks"/>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">項　　目</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">金　額（円）</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">備　　考</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="FormCell"><text:p>市補助金</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="TotalLabel">合　計</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Section">＜支出の部＞</text:p>
      <table:table table:name="支出の部" table:style-name="FormTable">
        <table:table-column table:style-name="ColItem"/>
        <table:table-column table:style-name="ColAmount"/>
        <table:table-column table:style-name="ColRemarks"/>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">項　　目</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">金　額（円）</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">備　　考</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="FormCell"><text:p>印刷製本費</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="TotalLabel">合　計</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Note">※収入の部は、この補助金のほか収入の種類ごとに分け、支出の部は、</text:p>
      <text:p text:style-name="Note">事業費、事務費、会議費等必要な科目を設定し記入すること。</text:p>
    </office:text>
  </office:body>
</office:document>