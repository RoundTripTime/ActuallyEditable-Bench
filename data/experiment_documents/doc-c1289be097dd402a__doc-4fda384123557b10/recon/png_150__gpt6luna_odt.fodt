<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:text-properties fo:font-size="12pt"/>
      <style:paragraph-properties fo:line-height="100%"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-top="1.8cm" fo:margin-bottom="1.8cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
    </style:page-layout>
    <style:style style:name="Title" style:family="paragraph" style:master-page-name="Standard">
      <style:paragraph-properties fo:text-align="center" fo:break-before="page" fo:margin-top="0.7cm" fo:margin-bottom="1.1cm"/>
      <style:text-properties fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="District" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-bottom="0.7cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.15cm" fo:margin-bottom="0.15cm"/>
      <style:text-properties fo:font-size="13pt"/>
    </style:style>
    <style:style style:name="TableIncome" style:family="table">
      <style:table-properties style:width="17cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="4.45cm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="4.95cm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="7.6cm"/>
    </style:style>
    <style:style style:name="HeadRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.18cm"/>
    </style:style>
    <style:style style:name="DataRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.18cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HeadCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="TotalCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="TablePara" style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="LabelPara" style:family="paragraph">
      <style:paragraph-properties fo:text-align="left" fo:line-height="100%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="CenterPara" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="100%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="AfterTable" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.7cm"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.35cm" fo:line-height="145%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">区誌（史）編さん事業　収支予算書</text:p>
      <text:p text:style-name="District">____________________　区</text:p>
      <text:p text:style-name="Section">＜収入の部＞</text:p>
      <table:table table:name="収入の部" table:style-name="TableIncome">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-row table:style-name="HeadRow">
          <table:table-cell table:style-name="HeadCell"><text:p>項　目</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>金　額 （円）</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>備　考</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="LabelPara">市補助金</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="TotalCell"><text:p>合　計</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="AfterTable"/>
      <text:p text:style-name="Section">＜支出の部＞</text:p>
      <table:table table:name="支出の部" table:style-name="TableIncome">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-row table:style-name="HeadRow">
          <table:table-cell table:style-name="HeadCell"><text:p>項　目</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>金　額 （円）</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>備　考</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="LabelPara">印刷製本費</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="TotalCell"><text:p>合　計</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Note">※収入の部は、この補助金のほか収入の種類ごとに分け、支出の部は、<text:line-break/>事業費、事務費、会議費等必要な科目を設定し記入すること。</text:p>
    </office:text>
  </office:body>
</office:document>