        <table:table-row><table:table-cell table:style-name="Cell" table:number-rows-spanned="2"><text:p text:style-name="Center">[　]<br/>입영<br/>ㆍ소집일<br/>연기</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="P9">입영ㆍ소집일<br/>　년　　월　　일</text:p></table:table-cell><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p text:style-name="P9">입영부대(복무기관)</text:p></table:table-cell></table:table-row>
