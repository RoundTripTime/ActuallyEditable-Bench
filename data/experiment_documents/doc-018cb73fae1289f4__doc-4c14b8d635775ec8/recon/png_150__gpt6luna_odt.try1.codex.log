          <table:table-cell table:style-name="PlainCell" table:number-columns-spanned="2"><text:p text:style-name="P">추가 자녀 계획 (미정인 경우 0명)</text:p><text:p text:style-name="Right">(                  명)</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
