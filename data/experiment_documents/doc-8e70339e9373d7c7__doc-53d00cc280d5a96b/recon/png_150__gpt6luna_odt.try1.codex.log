  <office:body>
    <office:text>
      <text:p text:style-name="First">様式第１号（第３条関係）</text:p>
      <text:p text:style-name="CenterTitle">開　示　請　求　書</text:p>
      <text:p text:style-name="Right">令和　　年　　月　　日</text:p>
      <text:p text:style-name="SmallGap">請求先（実施機関）</text:p>
      <table:table table:name="AddressedTo" table:style-name="MainTable">
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColWide"/>
        <table:table-row>
          <table:table-cell table:style-name="LineCell"><text:p text:style-name="P"/></table:table-cell>
          <table:table-cell table:style-name="LineCell"><text:p text:style-name="Right">殿</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="P"/></table:table-cell>
          <table:table-cell table:style-name="LineCell"><text:p text:style-name="P">住所</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="Right">請　求　者</text:p></table:table-cell>
          <table:table-cell table:style-name="LineCell"><text:p text:style-name="P">氏　名</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="P"/></table:table-cell>
          <table:table-cell table:style-name="LineCell"><text:p text:style-name="P">電話番号</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="P">桂川町情報公開条例第６条第１項の規定に基づき、次のとおり行政文書の開示を請求します。</text:p>
      <table:table table:name="DisclosureRequest" table:style-name="MainTable">
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColWide"/>
        <table:table-row>
          <table:table-cell table:style-name="TallCell"><text:p text:style-name="P">開示請求に係る行</text:p><text:p text:style-name="P">政文書の名称又は</text:p><text:p text:style-name="P">内容</text:p></table:table-cell>
          <table:table-cell table:style-name="TallCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="P">開示の実施方法</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="P">□閲覧　　　　　　□写しの交付　　　　　　□視聴</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="P">備考</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="P">（注意）</text:p>
      <text:p text:style-name="P">請求者が法人その他の団体の場合は、備考欄に連絡可能な方の氏名及び電話番号を記入してください。</text:p>
      <text:p text:style-name="P">＊下記の枠内は記入の必要はありません。</text:p>
      <table:table table:name="OfficeUse" table:style-name="AdminTable">
        <table:table-column table:style-name="ColAdmin1"/>
        <table:table-column table:style-name="ColAdmin2"/>
        <table:table-column table:style-name="ColAdmin3"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="P">行政文書の所管課名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="P">処理状況</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2">
            <text:p text:style-name="P">１　開示　　　２　一部開示　　　３　不開示</text:p>
            <text:p text:style-name="P">４　その他（　　　　　　　　　）</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="P">条例第１０条第１項ただし書きに規定する書面</text:p><text:p text:style-name="P">による通知の省略</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="P">１　省略　　　２　書面通知</text:p></table:table-cell>
        </table:table-row>
