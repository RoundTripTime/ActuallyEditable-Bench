<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.12cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="1.7cm" fo:margin-bottom="1.7cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
    </style:page-layout>
    <style:style style:name="First" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0.15cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="CenterTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.3cm" fo:margin-bottom="0.3cm"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end" fo:margin-top="0cm" fo:margin-bottom="0.1cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="SmallGap" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.05cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="MainTable" style:family="table">
      <style:table-properties fo:width="100%" table:align="margins" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="AdminTable" style:family="table">
      <style:table-properties fo:width="100%" table:align="margins" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ColLabel" style:family="table-column">
      <style:table-column-properties style:column-width="4.1cm"/>
    </style:style>
    <style:style style:name="ColWide" style:family="table-column">
      <style:table-column-properties style:column-width="12.9cm"/>
    </style:style>
    <style:style style:name="ColAdmin1" style:family="table-column">
      <style:table-column-properties style:column-width="4.1cm"/>
    </style:style>
    <style:style style:name="ColAdmin2" style:family="table-column">
      <style:table-column-properties style:column-width="4.8cm"/>
    </style:style>
    <style:style style:name="ColAdmin3" style:family="table-column">
      <style:table-column-properties style:column-width="8.1cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.16cm" style:vertical-align="middle"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="TallCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.16cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:line-height="160%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="LineCell" style:family="table-cell">
      <style:table-cell-properties fo:border-bottom="0.5pt solid #000000" fo:padding="0.12cm" style:vertical-align="middle"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="NoBorderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0.05cm" style:vertical-align="middle"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="First">様式第１号（第３条関係）</text:p>
      <text:p text:style-name="CenterTitle">開　示　請　求　書</text:p>
      <text:p text:style-name="Right">令和　　年　　月　　日</text:p>
      <text:p text:style-name="SmallGap">請求先（実施機関）</text:p>
      <table:table table:name="AddressedTo" table:style-name="MainTable">
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColWide"/>
        <table:table-row>
          <table:table-cell table:style-name="LineCell"><text:p text:style-name="P"/></table:table-cell>
          <table:table-cell table:style-name="LineCell"><text:p text:style-name="Right">殿</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="P"/></table:table-cell>
          <table:table-cell table:style-name="LineCell"><text:p text:style-name="P">住所</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="Right">請　求　者</text:p></table:table-cell>
          <table:table-cell table:style-name="LineCell"><text:p text:style-name="P">氏　名</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="P"/></table:table-cell>
          <table:table-cell table:style-name="LineCell"><text:p text:style-name="P">電話番号</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="P">桂川町情報公開条例第６条第１項の規定に基づき、次のとおり行政文書の開示を請求します。</text:p>
      <table:table table:name="DisclosureRequest" table:style-name="MainTable">
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColWide"/>
        <table:table-row>
          <table:table-cell table:style-name="TallCell"><text:p text:style-name="P">開示請求に係る行</text:p><text:p text:style-name="P">政文書の名称又は</text:p><text:p text:style-name="P">内容</text:p></table:table-cell>
          <table:table-cell table:style-name="TallCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="P">開示の実施方法</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="P">□閲覧　　　　　　□写しの交付　　　　　　□視聴</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="P">備考</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="P">（注意）</text:p>
      <text:p text:style-name="P">請求者が法人その他の団体の場合は、備考欄に連絡可能な方の氏名及び電話番号を記入してください。</text:p>
      <text:p text:style-name="P">＊下記の枠内は記入の必要はありません。</text:p>
      <table:table table:name="OfficeUse" table:style-name="AdminTable">
        <table:table-column table:style-name="ColAdmin1"/>
        <table:table-column table:style-name="ColAdmin2"/>
        <table:table-column table:style-name="ColAdmin3"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="P">行政文書の所管課名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="P">処理状況</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2">
            <text:p text:style-name="P">１　開示　　　２　一部開示　　　３　不開示</text:p>
            <text:p text:style-name="P">４　その他（　　　　　　　　　）</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="P">条例第１０条第１項ただし書きに規定する書面</text:p><text:p text:style-name="P">による通知の省略</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="P">１　省略　　　２　書面通知</text:p></table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>