<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="1.15"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:default-style>
  </office:styles>
  <office:automatic-styles>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin="0cm" fo:line-height="1.15"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.6cm" fo:margin-bottom="0.4cm"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="FormTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.3cm" fo:margin-bottom="0.5cm"/>
      <style:text-properties fo:font-size="13pt"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin="0cm"/>
    </style:style>
    <style:style style:name="SmallSpace" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.15cm" fo:margin-bottom="0.15cm"/>
    </style:style>
    <style:style style:name="TableText" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="1.5"/>
    </style:style>
    <style:style style:name="TableCenter" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin="0cm" fo:line-height="1.4"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.18cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="InputCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.18cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="LineCell" style:family="table-cell">
      <style:table-cell-properties fo:border-left="none" fo:border-right="none" fo:border-top="none" fo:border-bottom="0.6pt solid #000000" fo:padding="0.12cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="MainCol1" style:family="table-column">
      <style:table-column-properties style:column-width="42mm"/>
    </style:style>
    <style:style style:name="MainCol2" style:family="table-column">
      <style:table-column-properties style:column-width="126mm"/>
    </style:style>
    <style:style style:name="AdminCol1" style:family="table-column">
      <style:table-column-properties style:column-width="48mm"/>
    </style:style>
    <style:style style:name="AdminCol2" style:family="table-column">
      <style:table-column-properties style:column-width="52mm"/>
    </style:style>
    <style:style style:name="AdminCol3" style:family="table-column">
      <style:table-column-properties style:column-width="68mm"/>
    </style:style>
    <style:style style:name="AdminColLabel" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.18cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="PageLayout" style:family="paragraph"/>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" fo:margin-top="36mm" fo:margin-bottom="20mm" fo:margin-left="23mm" fo:margin-right="19mm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="Title">様式第１号（第３条関係）</text:p>
      <table:table table:name="申請欄">
        <table:table-column table:style-name="MainCol1"/>
        <table:table-column table:style-name="MainCol2"/>
        <table:table-row>
          <table:table-cell table:style-name="InputCell" table:number-columns-spanned="2">
            <text:p text:style-name="FormTitle">開　示　請　求　書</text:p>
            <text:p text:style-name="Right">令和　　年　　月　　日</text:p>
            <text:p text:style-name="SmallSpace"/>
            <text:p>請求先（実施機関）</text:p>
            <text:p text:style-name="Right">殿</text:p>
            <text:p text:style-name="Right">住　　所</text:p>
            <text:p text:style-name="Right">請　求　者　　氏　　名</text:p>
            <text:p text:style-name="Right">電話番号</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="InputCell">
            <text:p text:style-name="TableText">桂川町情報公開条例第６条第１項の規定に基づき、次のとおり行政文書の開示を請求します。</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <table:table table:name="開示請求内容">
        <table:table-column table:style-name="MainCol1"/>
        <table:table-column table:style-name="MainCol2"/>
        <table:table-row>
          <table:table-cell table:style-name="InputCell">
            <text:p text:style-name="TableText">開示請求に係る行政文書の名称又は内容</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>開示の実施方法</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="TableCenter">□閲覧　　　　□写しの交付　　　　□視聴</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>備考</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="SmallSpace">（注意）</text:p>
      <text:p>請求者が法人その他の団体の場合は、備考欄に連絡可能な方の氏名及び電話番号を記入してください。</text:p>
      <text:p text:style-name="SmallSpace">＊下記の枠内は記入の必要はありません。</text:p>
      <table:table table:name="処理欄">
        <table:table-column table:style-name="AdminCol1"/>
        <table:table-column table:style-name="AdminCol2"/>
        <table:table-column table:style-name="AdminCol3"/>
        <table:table-row>
          <table:table-cell table:style-name="AdminColLabel"><text:p>行政文書の所管課名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p/></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="AdminColLabel"><text:p>処理状況</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2">
            <text:p>１　開示　　２　一部開示　　３　不開示</text:p>
            <text:p>４　その他（　　　　　　　　　）</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="AdminColLabel" table:number-columns-spanned="2">
            <text:p>条例第１０条第１項ただし書きに規定する書面による通知の省略</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="TableCenter">１　省略　　２　書面通知</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>