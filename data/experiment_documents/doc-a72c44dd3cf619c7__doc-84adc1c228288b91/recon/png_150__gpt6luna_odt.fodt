<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:line-height="150%" fo:margin-left="0cm" fo:margin-right="0cm" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="TopDate" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="2.6cm" fo:margin-bottom="0.5cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph">
      <style:paragraph-properties fo:text-align="left" fo:margin-top="0.3cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Spacer" style:family="paragraph">
      <style:paragraph-properties fo:line-height="0.45cm" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.2cm" fo:margin-bottom="0.5cm"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="FormText" style:family="paragraph">
      <style:paragraph-properties fo:line-height="150%" fo:margin-top="0.4cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.5cm" fo:margin-bottom="0.5cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="OwnerDate" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0.9cm" fo:margin-bottom="0.6cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.9cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="16cm"/>
    </style:style>
    <style:style style:name="LeftColumn" style:family="table-column">
      <style:table-column-properties style:column-width="9cm"/>
    </style:style>
    <style:style style:name="RightColumn" style:family="table-column">
      <style:table-column-properties style:column-width="7cm"/>
    </style:style>
    <style:style style:name="OwnerCol1" style:family="table-column">
      <style:table-column-properties style:column-width="4.3cm"/>
    </style:style>
    <style:style style:name="OwnerCol2" style:family="table-column">
      <style:table-column-properties style:column-width="1.3cm"/>
    </style:style>
    <style:style style:name="OwnerCol3" style:family="table-column">
      <style:table-column-properties style:column-width="8.2cm"/>
    </style:style>
    <style:style style:name="OwnerCol4" style:family="table-column">
      <style:table-column-properties style:column-width="1.2cm"/>
    </style:style>
    <style:style style:name="InputLine" style:family="table-cell">
      <style:table-cell-properties fo:border-bottom="0.5pt solid #000000"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-left="2.5cm" fo:margin-right="2.5cm" fo:margin-top="2cm" fo:margin-bottom="2cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="TopDate">年　月　日</text:p>
      <text:p text:style-name="Recipient">豊見城市長　殿</text:p>
      <text:p text:style-name="Spacer"/>
      <table:table table:name="Applicant" table:style-name="FormTable">
        <table:table-column table:style-name="LeftColumn"/>
        <table:table-column table:style-name="RightColumn"/>
        <table:table-row>
          <table:table-cell/>
          <table:table-cell><text:p text:style-name="Body">（申請者）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell/>
          <table:table-cell><text:p text:style-name="Body">住　所</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell/>
          <table:table-cell><text:p text:style-name="Body">氏　名</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell/>
          <table:table-cell><text:p text:style-name="Body">電話番号</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Spacer"/>
      <text:p text:style-name="Title">豊見城市住宅リフォーム支援事業工事承諾書</text:p>
      <text:p text:style-name="FormText">豊見城市住宅リフォーム支援事業補助金の申請に当たり、下記のとおり住宅等の所有者からリ<text:line-break/>フォーム工事及び当該補助金の交付申請をすることへの承諾を得ましたので提出します。</text:p>
      <text:p text:style-name="Center">記</text:p>
      <text:p text:style-name="FormText">豊見城市住宅リフォーム支援事業に係る補助金の申請に当たり、当該住宅の所有者である私は、リ<text:line-break/>フォーム工事及び補助金の交付申請をすることについて承諾します。</text:p>
      <text:p text:style-name="OwnerDate">年　月　日</text:p>
      <table:table table:name="OwnerSignature" table:style-name="FormTable">
        <table:table-column table:style-name="OwnerCol1"/>
        <table:table-column table:style-name="OwnerCol2"/>
        <table:table-column table:style-name="OwnerCol3"/>
        <table:table-column table:style-name="OwnerCol4"/>
        <table:table-row>
          <table:table-cell><text:p text:style-name="Body">（住宅等の所有者）</text:p></table:table-cell>
          <table:table-cell><text:p text:style-name="Body">住所</text:p></table:table-cell>
          <table:table-cell table:style-name="InputLine"/>
          <table:table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell/>
          <table:table-cell><text:p text:style-name="Body">氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="InputLine"/>
          <table:table-cell><text:p text:style-name="Body">（印）</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Note">(注) 補助の対象は同一人・同住宅に対し１回限りですので、御注意ください。</text:p>
    </office:text>
  </office:body>
</office:document>