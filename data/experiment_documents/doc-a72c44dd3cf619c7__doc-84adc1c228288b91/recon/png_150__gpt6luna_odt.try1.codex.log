  <office:body>
    <office:text>
      <text:p text:style-name="TopDate">年　月　日</text:p>
      <text:p text:style-name="Recipient">豊見城市長　殿</text:p>
      <text:p text:style-name="Spacer"/>
      <table:table table:name="Applicant" table:style-name="FormTable">
        <table:table-column table:style-name="LeftColumn"/>
        <table:table-column table:style-name="RightColumn"/>
        <table:table-row>
          <table:table-cell/>
          <table:table-cell><text:p text:style-name="Body">（申請者）</text:p></table:table-cell>
