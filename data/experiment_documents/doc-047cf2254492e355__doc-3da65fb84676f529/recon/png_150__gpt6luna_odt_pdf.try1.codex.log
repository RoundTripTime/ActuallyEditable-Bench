          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="Normal">(2)人材育成活動支援事業</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Gap18"/>
      <text:p text:style-name="Normal">2. 交付事業の内容</text:p>
      <text:p text:style-name="Normal">(1)実施事業名</text:p>
      <text:p text:style-name="Gap36"/>
      <text:p text:style-name="Normal">(2)事業実施期間</text:p>
      <text:p text:style-name="Gap18"/>
      <text:p text:style-name="Center">令和　年　月　日　～　令和　年　月　日</text:p>
      <text:p text:style-name="Gap18"/>
      <text:p text:style-name="Normal">(3)事業費</text:p>
      <text:p text:style-name="Gap18"/>
      <text:p text:style-name="Center">円</text:p>
