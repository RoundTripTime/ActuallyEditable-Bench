        <table:table-row table:style-name="TallRow"><table:table-cell table:style-name="MetaLabel"><text:p text:style-name="P"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"/></table:table-row>
        <table:table-row table:style-name="LunchRow"><table:table-cell table:style-name="MetaLabel"><text:p text:style-name="P"/></table:table-cell><table:table-cell table:style-name="MetaLabel" table:number-columns-spanned="6"><text:p text:style-name="BoldCenter">Lunch</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row table:style-name="TallRow"><table:table-cell table:style-name="MetaLabel"><text:p text:style-name="P"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"/></table:table-row>
