<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.45cm"/>
      <style:text-properties fo:font-size="28pt" fo:font-weight="normal" fo:color="#292b27"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.28cm"/>
      <style:text-properties fo:font-size="12pt" fo:color="#292b27"/>
    </style:style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.2cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="12pt" fo:color="#292b27"/>
    </style:style>
    <style:style style:name="RustHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.05cm" fo:margin-bottom="0.22cm"/>
      <style:text-properties fo:font-size="16pt" fo:font-weight="normal" fo:color="#A45335"/>
    </style:style>
    <style:style style:name="ReviewHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.1cm" fo:margin-bottom="0.18cm"/>
      <style:text-properties fo:font-size="16pt" fo:font-weight="normal" fo:color="#A45335"/>
    </style:style>
    <style:style style:name="Bullet" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="1.25cm" fo:text-indent="-0.62cm" fo:margin-top="0cm" fo:margin-bottom="0.18cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="12pt" fo:color="#292b27"/>
    </style:style>
    <style:style style:name="FinalNote" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.18cm" fo:margin-bottom="0cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="12pt" fo:color="#292b27"/>
    </style:style>
    <style:style style:name="ProjectTitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.55cm"/>
      <style:text-properties fo:font-size="16pt" fo:font-weight="normal" fo:color="#A45335"/>
    </style:style>
    <style:style style:name="Subhead" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.28cm"/>
      <style:text-properties fo:font-size="14pt" fo:font-weight="bold" fo:color="#292b27"/>
    </style:style>
    <style:style style:name="Instruction" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.22cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="12pt" fo:color="#292b27"/>
    </style:style>
    <style:style style:name="Entry" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="1.05cm"/>
      <style:text-properties fo:font-size="12pt" fo:color="#292b27"/>
    </style:style>
    <style:style style:name="LastEntry" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt" fo:color="#292b27"/>
    </style:style>
    <style:style style:name="Footer" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt" fo:color="#292b27"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:style style:name="PageTwoStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0.55cm"/>
      <style:text-properties fo:font-size="16pt" fo:font-weight="normal" fo:color="#A45335"/>
    </style:style>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21.59cm" fo:page-height="27.94cm" fo:margin-left="1.75cm" fo:margin-right="1.75cm" fo:margin-top="1.5cm" fo:margin-bottom="1.5cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout">
      <style:footer>
        <text:p text:style-name="Footer">OpenLintel • Planning resource • <text:page-number text:select-page="current">1</text:page-number></text:p>
      </style:footer>
    </style:master-page>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">Interior design proposal template</text:p>
      <text:p text:style-name="Subtitle">Blank editable template</text:p>
      <text:p text:style-name="Body">OpenLintel • Educational planning resource • September 26, 2026</text:p>
      <text:p text:style-name="Body">Illustrative teaching extension of The Window Room; not a client record, supplier quote, site survey, or construction-ready document. Pending professional review.</text:p>
      <text:p text:style-name="RustHeading">How to use</text:p>
      <text:p text:style-name="Body">Adapt the outline to the services you actually offer. The example is a fictional teaching document with no quoted fee, real client, or enforceable terms. It is not a contract and does not replace professional legal review of an agreement. Check every proposed output against your actual services; separate unpriced items, allowances, and exclusions.</text:p>
      <text:p text:style-name="Bullet">•　Summarize discovery in the client’s language.</text:p>
      <text:p text:style-name="Bullet">•　Pair each proposed deliverable with a clear phase and review.</text:p>
      <text:p text:style-name="Bullet">•　Discuss assumptions and exclusions before preparing a separate agreement.</text:p>
      <text:p text:style-name="ReviewHeading">Review before use</text:p>
      <text:p text:style-name="Bullet">•　Do not copy sample services into an offer you cannot deliver.</text:p>
      <text:p text:style-name="Bullet">•　Do not mix design fees with the furniture purchasing budget.</text:p>
      <text:p text:style-name="Bullet">•　Do not present this educational proposal outline as a legal contract.</text:p>
      <text:p text:style-name="FinalNote">Replace illustrative information with verified project records. No approval, legal agreement, or construction readiness is represented. Keep completed client documents in your own secure system.</text:p>
      <text:p text:style-name="PageTwoStart">Your project</text:p>
      <text:p text:style-name="Subhead">Project understanding</text:p>
      <text:p text:style-name="Instruction">Restate the client’s intended outcome and identify the information you have relied on.</text:p>
      <text:p text:style-name="Entry">[Enter your project information here. Leave unknowns explicit.]</text:p>
      <text:p text:style-name="Subhead">Proposed approach</text:p>
      <text:p text:style-name="Instruction">Explain the sequence and where client decisions will be needed.</text:p>
      <text:p text:style-name="Entry">[Enter your project information here. Leave unknowns explicit.]</text:p>
      <text:p text:style-name="Subhead">Proposed deliverables</text:p>
      <text:p text:style-name="Instruction">Name each output and the level of development. Avoid an undefined promise of “all drawings”.</text:p>
      <text:p text:style-name="Entry">[Enter your project information here. Leave unknowns explicit.]</text:p>
      <text:p text:style-name="Subhead">Phases and reviews</text:p>
      <text:p text:style-name="Instruction">Describe review gates rather than inventing a universal project duration.</text:p>
      <text:p text:style-name="Entry">[Enter your project information here. Leave unknowns explicit.]</text:p>
      <text:p text:style-name="Subhead">Fee discussion</text:p>
      <text:p text:style-name="Instruction">List the services to be priced and the basis for discussion. Keep purchasing allowances separate from professional fees.</text:p>
      <text:p text:style-name="Entry">[Enter your project information here. Leave unknowns explicit.]</text:p>
      <text:p text:style-name="Subhead">Assumptions and exclusions</text:p>
      <text:p text:style-name="Instruction">Identify missing inputs, specialist work, procurement responsibilities, and what this proposal does not include.</text:p>
      <text:p text:style-name="Entry">[Enter your project information here. Leave unknowns explicit.]</text:p>
      <text:p text:style-name="Subhead">Next steps</text:p>
      <text:p text:style-name="Instruction">Name the information needed to develop an agreement. Do not use this outline as a substitute for legal terms.</text:p>
      <text:p text:style-name="LastEntry">[Enter your project information here. Leave unknowns explicit.]</text:p>
    </office:text>
  </office:body>
</office:document>