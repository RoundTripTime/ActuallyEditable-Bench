<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="本文" style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="中央" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="100%"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="右寄せ" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end" fo:line-height="100%"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="ページ">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin="1.8cm"/>
    </style:page-layout>
    <style:style style:name="表" style:family="table">
      <style:table-properties style:width="17.4cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="左列" style:family="table-column">
      <style:table-column-properties style:column-width="3.3cm"/>
    </style:style>
    <style:style style:name="右列" style:family="table-column">
      <style:table-column-properties style:column-width="14.1cm"/>
    </style:style>
    <style:style style:name="小列" style:family="table-column">
      <style:table-column-properties style:column-width="11.2cm"/>
    </style:style>
    <style:style style:name="金額列" style:family="table-column">
      <style:table-column-properties style:column-width="2.9cm"/>
    </style:style>
    <style:style style:name="内表" style:family="table">
      <style:table-properties style:width="100%" table:align="margins" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="セル" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #666666" fo:padding="0.05cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="上寄せセル" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #666666" fo:padding="0.05cm" style:vertical-align="top"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="標準ページ" style:page-layout-name="ページ"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="本文">別記様式第１号（第４条関係）</text:p>
      <text:p text:style-name="中央">浦幌町まち・ひと・しごと創生寄附活用事業寄附申出書</text:p>
      <text:p text:style-name="右寄せ">年　　月　　日</text:p>
      <text:p text:style-name="本文">浦幌町長　様</text:p>
      <text:p text:style-name="右寄せ">法　人　名</text:p>
      <text:p text:style-name="右寄せ">法　人　番　号</text:p>
      <text:p text:style-name="右寄せ">代表者職・氏名</text:p>
      <text:p text:style-name="右寄せ">本　社　住　所　〒</text:p>
      <text:p text:style-name="本文">浦幌町で実施する浦幌町まち・ひと・しごと創生寄附活用事業に対し、下記のとおり寄附することを申し出ます。</text:p>
      <text:p text:style-name="中央">記</text:p>
      <table:table table:name="寄附申出書" table:style-name="表">
        <table:table-column table:style-name="左列"/>
        <table:table-column table:style-name="右列"/>
        <table:table-row>
          <table:table-cell table:style-name="セル">
            <text:p text:style-name="中央">寄　附　申　出　額</text:p>
            <text:p text:style-name="中央">（総　額）等</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="セル">
            <text:p text:style-name="本文">金　　　　　　　　　円（寄附予定年月：　　年　　月）</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="セル" table:number-rows-spanned="2">
            <text:p text:style-name="中央">寄附の対象事業</text:p>
            <text:p text:style-name="中央">及　び　寄　附　金　額</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="セル">
            <table:table table:name="事業一覧" table:style-name="内表">
              <table:table-column table:style-name="小列"/>
              <table:table-column table:style-name="金額列"/>
              <table:table-row>
                <table:table-cell table:style-name="セル"><text:p text:style-name="中央">事業名</text:p></table:table-cell>
                <table:table-cell table:style-name="セル"><text:p text:style-name="中央">寄附金額</text:p></table:table-cell>
              </table:table-row>
              <table:table-row>
                <table:table-cell table:style-name="セル"><text:p text:style-name="本文">□　安心して暮らせる持続可能なまちづくり事業</text:p></table:table-cell>
                <table:table-cell table:style-name="セル"><text:p text:style-name="右寄せ">円</text:p></table:table-cell>
              </table:table-row>
              <table:table-row>
                <table:table-cell table:style-name="セル"><text:p text:style-name="本文">□　地域資源を生かした稼ぐ力の創出事業</text:p></table:table-cell>
                <table:table-cell table:style-name="セル"><text:p text:style-name="右寄せ">円</text:p></table:table-cell>
              </table:table-row>
              <table:table-row>
                <table:table-cell table:style-name="セル"><text:p text:style-name="本文">□　多様な人が集い、学び、活躍できる地域社会事業</text:p></table:table-cell>
                <table:table-cell table:style-name="セル"><text:p text:style-name="右寄せ">円</text:p></table:table-cell>
              </table:table-row>
            </table:table>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="セル">
            <text:p text:style-name="本文">○具体的な支援事業（上記より具体的な支援希望があればご記入ください）</text:p>
            <text:p text:style-name="本文">　事業名：　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="セル"><text:p text:style-name="中央">寄附情報の公表</text:p></table:table-cell>
          <table:table-cell table:style-name="セル">
            <text:p text:style-name="本文">□　企業概要（法人名・本社所在地など）、寄附活用事業・年月日・金額</text:p>
            <text:p text:style-name="本文">□　企業概要（法人名・本社所在地など）、寄附活用事業・年月日</text:p>
            <text:p text:style-name="本文">□　公表を希望しない（理由：　　　　　　　　　　　　　　　　　　　　　　　　　）</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="セル"><text:p text:style-name="中央">入　金　方　法</text:p></table:table-cell>
          <table:table-cell table:style-name="セル">
            <text:p text:style-name="本文">□　町が発行する納付書</text:p>
            <text:p text:style-name="本文">□　町長が指定する口座への振込み</text:p>
            <text:p text:style-name="本文">□　現金書留郵便</text:p>
            <text:p text:style-name="本文">□　現金・小切手の持参</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="セル"><text:p text:style-name="中央">感　謝　状　贈　呈　式</text:p></table:table-cell>
          <table:table-cell table:style-name="セル">
            <text:p text:style-name="本文">□　希望する</text:p>
            <text:p text:style-name="本文">□　希望しない（郵送等による贈呈）</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="セル"><text:p text:style-name="中央">担　当　者　連　絡　先</text:p></table:table-cell>
          <table:table-cell table:style-name="セル">
            <table:table table:name="連絡先" table:style-name="内表">
              <table:table-column table:style-name="小列"/>
              <table:table-column table:style-name="金額列"/>
              <table:table-row>
                <table:table-cell table:style-name="セル"><text:p text:style-name="本文">所属・職・氏名</text:p></table:table-cell>
                <table:table-cell table:style-name="セル"><text:p text:style-name="本文">　　　　　　　　　　　　　　　　　</text:p></table:table-cell>
              </table:table-row>
              <table:table-row>
                <table:table-cell table:style-name="セル"><text:p text:style-name="本文">住　　　所　〒</text:p></table:table-cell>
                <table:table-cell table:style-name="セル"><text:p text:style-name="本文">　　　　　　　　　　　　　　　　　</text:p></table:table-cell>
              </table:table-row>
              <table:table-row>
                <table:table-cell table:style-name="セル"><text:p text:style-name="本文">電　話　番　号</text:p></table:table-cell>
                <table:table-cell table:style-name="セル"><text:p text:style-name="本文">　　　　　　　　　　　　　　　　　</text:p></table:table-cell>
              </table:table-row>
              <table:table-row>
                <table:table-cell table:style-name="セル"><text:p text:style-name="本文">メールアドレス</text:p></table:table-cell>
                <table:table-cell table:style-name="セル"><text:p text:style-name="本文">　　　　　　　　　　　　　　　　　</text:p></table:table-cell>
              </table:table-row>
            </table:table>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="セル">
            <text:p text:style-name="中央">寄　附　の　契　機　と</text:p>
            <text:p text:style-name="中央">なった仲介事業</text:p>
            <text:p text:style-name="中央">者</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="セル">
            <text:p text:style-name="本文">□　有（仲介事業者名：　　　　　　　　　）</text:p>
            <text:p text:style-name="本文">□　無</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="セル"><text:p text:style-name="中央">備　　　考</text:p></table:table-cell>
          <table:table-cell table:style-name="セル"><text:p text:style-name="本文"/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="本文">※寄附申出額（総額）が100万円以上の場合、感謝状贈呈式の希望項目にチェック☑を入れてください。</text:p>
    </office:text>
  </office:body>
</office:document>