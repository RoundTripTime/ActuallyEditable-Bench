<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="115%"/>
      <style:text-properties fo:font-size="11pt" fo:font-family="serif"/>
    </style:default-style>
    <style:style style:name="DefaultTable" style:family="table">
      <style:table-properties table:align="margins"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="3.4cm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="7.2cm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="3.6cm"/>
    </style:style>
    <style:style style:name="TableCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #666666" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Centered" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="1.8cm" fo:margin-bottom="1.8cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
    </style:page-layout>
    <style:style style:name="FirstPage" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.2cm" fo:margin-bottom="0.3cm"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table" style:parent-style-name="DefaultTable">
      <style:table-properties table:align="margins"/>
    </style:style>
    <style:style style:name="FormCell" style:family="table-cell" style:parent-style-name="TableCell">
      <style:table-cell-properties fo:border="0.5pt solid #666666" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="FirstPage"/>
      <text:p>別記様式第１号（第４条関係）</text:p>
      <text:p text:style-name="Title">浦幌町まち・ひと・しごと創生寄附活用事業寄附申出書</text:p>
      <text:p text:style-name="Right">年　　　月　　　日</text:p>
      <text:p>浦幌町長　様</text:p>
      <text:p text:style-name="Right">法　人　名</text:p>
      <text:p text:style-name="Right">法 人 番 号</text:p>
      <text:p text:style-name="Right">代表者職・氏名</text:p>
      <text:p text:style-name="Right">本 社 住 所　〒</text:p>
      <text:p>浦幌町で実施する浦幌町まち・ひと・しごと創生寄附活用事業に対し、下記のとおり寄附することを申し出ます。</text:p>
      <text:p text:style-name="Centered">記</text:p>
      <table:table table:name="ContributionForm" table:style-name="FormTable">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-row>
          <table:table-cell table:style-name="FormCell">
            <text:p>寄 附 申 出 額</text:p>
            <text:p>（ 総 額 ） 等</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="2">
            <text:p>金　　　　　　　　　　　円（寄附予定年月：　　年　　月）</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell" table:number-rows-spanned="5">
            <text:p>寄附の対象事業及び寄附金額</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="1">
            <text:p text:style-name="Centered">事業名</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="Centered">寄附金額</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="FormCell">
            <text:p>□ 安心して暮らせる持続可能なまちづくり事業</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="Right">円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="FormCell">
            <text:p>□ 地域資源を生かした稼ぐ力の創出事業</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="Right">円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="FormCell">
            <text:p>□ 多様な人が集い、学び、活躍できる地域社会事業</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="Right">円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="2">
            <text:p>○具体的な支援事業（上記より具体的な支援希望があればご記入ください）</text:p>
            <text:p>　事業名：　　　　　　　　　　　　　　　　　　　　　　　　　　　</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell">
            <text:p>寄附情報の公表</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="2">
            <text:p>□ 企業概要（法人名・本社所在地など）、寄附活用事業・年月日・金額</text:p>
            <text:p>□ 企業概要（法人名・本社所在地など）、寄附活用事業・年月日</text:p>
            <text:p>□ 公表を希望しない（理由：　　　　　　　　　　　　　　　　　）</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell">
            <text:p>入　金　方　法</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="2">
            <text:p>□ 町が発行する納付書</text:p>
            <text:p>□ 町長が指定する口座への振込み</text:p>
            <text:p>□ 現金書留郵便</text:p>
            <text:p>□ 現金・小切手の持参</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell">
            <text:p>感 謝 状 贈 呈 式</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="2">
            <text:p>□ 希望する</text:p>
            <text:p>□ 希望しない（郵送等による贈呈）</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell">
            <text:p>担 当 者 連 絡 先</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p>所属・職・氏名</text:p>
            <text:p>住　　　所　〒</text:p>
            <text:p>電　話　番　号</text:p>
            <text:p>メールアドレス</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p>　　　　　　　　　　　</text:p>
            <text:p>　　　　　　　　　　　</text:p>
            <text:p>　　　　　　　　　　　</text:p>
            <text:p>　　　　　　　　　　　</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell">
            <text:p>寄附の契機となった仲介事業者</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="2">
            <text:p>□ 有（仲介事業者名：　　　　）</text:p>
            <text:p>□ 無</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell">
            <text:p>備　　　考</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="2">
            <text:p>　</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Small">※寄附申出額（総額）が１００万円以上の場合、感謝状贈呈式の希望項目にチェック☑を入れてください。</text:p>
    </office:text>
  </office:body>
</office:document>