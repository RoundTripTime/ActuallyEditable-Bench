<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="Centered" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%" fo:text-align="center"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="Bold" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="9pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="1pt"/>
    </style:style>
    <style:style style:name="TCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="top"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="CenterCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="GreyCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" fo:background-color="#D9D9D9" style:vertical-align="middle"/>
      <style:text-properties fo:font-size="9pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="TitleCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.12cm" fo:background-color="#00B050" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="18pt" fo:font-weight="bold" fo:color="#FFFFFF"/>
    </style:style>
    <style:style style:name="YellowCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" fo:background-color="#FFFF66" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="10pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="BlueCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" fo:background-color="#AFC5E8" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="10pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="GreenCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" fo:background-color="#8FF58F" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="10pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="PinkCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" fo:background-color="#F2B4F4" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="10pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="ConcernGreen" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #FFFFFF" fo:padding="0.02cm" fo:background-color="#92D050" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
    <style:style style:name="ConcernYellow" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #FFFFFF" fo:padding="0.02cm" fo:background-color="#FFC000" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
    <style:style style:name="ConcernRed" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #FFFFFF" fo:padding="0.02cm" fo:background-color="#FF0000" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="8pt" fo:color="#FFFFFF"/>
    </style:style>
    <style:style style:name="VerticalHead" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.03cm" style:vertical-align="middle" style:writing-mode="tb-rl"/>
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="6pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="SmallHead" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.03cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="7pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="RowLabel" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="middle"/>
      <style:text-properties fo:font-size="8pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="AttainCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.02cm"/>
    </style:style>
    <style:style style:name="InfoColumn" style:family="table-column">
      <style:table-column-properties style:column-width="4.4cm"/>
    </style:style>
    <style:style style:name="InfoColumn2" style:family="table-column">
      <style:table-column-properties style:column-width="4.4cm"/>
    </style:style>
    <style:style style:name="InfoColumn3" style:family="table-column">
      <style:table-column-properties style:column-width="3.2cm"/>
    </style:style>
    <style:style style:name="InfoColumn4" style:family="table-column">
      <style:table-column-properties style:column-width="5.4cm"/>
    </style:style>
    <style:style style:name="DomainLabelCol" style:family="table-column">
      <style:table-column-properties style:column-width="1.55cm"/>
    </style:style>
    <style:style style:name="DomainCol" style:family="table-column">
      <style:table-column-properties style:column-width="0.96cm"/>
    </style:style>
    <style:style style:name="PageLayout" style:family="graphic"/>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PL1">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-left="1.5cm" fo:margin-right="1.5cm" fo:margin-top="1.2cm" fo:margin-bottom="1.2cm"/>
    </style:page-layout>
    <style:style style:name="InfoTable" style:family="table">
      <style:table-properties style:width="17.4cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ConcernTable" style:family="table">
      <style:table-properties style:width="17.4cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="SummaryTable" style:family="table">
      <style:table-properties style:width="17.4cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="Page2Table" style:family="table">
      <style:table-properties style:width="17.4cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ShortRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.48cm"/>
    </style:style>
    <style:style style:name="TallRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.78cm"/>
    </style:style>
    <style:style style:name="ScoreRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="1.55cm"/>
    </style:style>
    <style:style style:name="LongFieldRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="1.6cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PL1"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Centered"><text:span text:style-name="P">Gloucestershire</text:span></text:p>
      <text:p text:style-name="Centered"><text:span text:style-name="P">COUNTY COUNCIL</text:span></text:p>
      <table:table table:name="TransitionRecord" table:style-name="InfoTable">
        <table:table-column table:style-name="InfoColumn"/>
        <table:table-column table:style-name="InfoColumn2"/>
        <table:table-column table:style-name="InfoColumn3"/>
        <table:table-column table:style-name="InfoColumn4"/>
        <table:table-row table:style-name="TallRow">
          <table:table-cell table:style-name="TitleCell" table:number-columns-spanned="4"><text:p text:style-name="Centered">Ready for Reception Transition Record</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="TallRow">
          <table:table-cell table:style-name="TCell"><text:p text:style-name="P">Child’s Name:</text:p></table:table-cell>
          <table:table-cell table:style-name="TCell"/>
          <table:table-cell table:style-name="TCell"><text:p text:style-name="P">Child’s Date of Birth:</text:p></table:table-cell>
          <table:table-cell table:style-name="TCell"/>
        </table:table-row>
        <table:table-row table:style-name="TallRow">
          <table:table-cell table:style-name="TCell"><text:p text:style-name="P">EY Setting:</text:p></table:table-cell>
          <table:table-cell table:style-name="TCell"/>
          <table:table-cell table:style-name="TCell"><text:p text:style-name="P">Practitioner’s Name:</text:p></table:table-cell>
          <table:table-cell table:style-name="TCell"/>
        </table:table-row>
        <table:table-row table:style-name="TallRow">
          <table:table-cell table:style-name="TCell"><text:p text:style-name="P">Funded Hours Entitlement:</text:p></table:table-cell>
          <table:table-cell table:style-name="TCell"><text:p text:style-name="P">□15</text:p><text:p text:style-name="P">□30</text:p></table:table-cell>
          <table:table-cell table:style-name="TCell"><text:p text:style-name="P">Accessing Full Entitlement:</text:p></table:table-cell>
          <table:table-cell table:style-name="TCell"><text:p text:style-name="P">□Yes</text:p><text:p text:style-name="P">□No</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="TallRow">
          <table:table-cell table:style-name="TCell"><text:p text:style-name="P">Child’s Ethnicity:</text:p></table:table-cell>
          <table:table-cell table:style-name="TCell"/>
          <table:table-cell table:style-name="TCell"><text:p text:style-name="P">Child’s Gender:</text:p></table:table-cell>
          <table:table-cell table:style-name="TCell"><text:p text:style-name="P">□ Male</text:p><text:p text:style-name="P">□ Female</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="TallRow">
          <table:table-cell table:style-name="TCell"><text:p text:style-name="P">Home language:</text:p></table:table-cell>
          <table:table-cell table:style-name="TCell"/>
          <table:table-cell table:style-name="TCell"><text:p text:style-name="P">Spoken Language:</text:p></table:table-cell>
          <table:table-cell table:style-name="TCell"/>
        </table:table-row>
        <table:table-row table:style-name="TallRow">
          <table:table-cell table:style-name="TCell"><text:p text:style-name="P">Child with SEND:</text:p></table:table-cell>
          <table:table-cell table:style-name="TCell"><text:p text:style-name="P">□Yes</text:p><text:p text:style-name="P">□No</text:p></table:table-cell>
          <table:table-cell table:style-name="TCell"><text:p text:style-name="P">Additional Information:</text:p></table:table-cell>
          <table:table-cell table:style-name="TCell">
            <text:p text:style-name="P">LAC □  CIN □  MP □</text:p>
            <text:p text:style-name="P">CP  □  IHCP □  MP+ □</text:p>
            <text:p text:style-name="P">EHCP □</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <table:table table:name="LearningScores" table:style-name="ConcernTable">
        <table:table-column table:style-name="InfoColumn"/>
        <table:table-column table:style-name="InfoColumn2"/>
        <table:table-column table:style-name="InfoColumn3"/>
        <table:table-column table:style-name="InfoColumn4"/>
        <table:table-row table:style-name="ShortRow">
          <table:table-cell table:style-name="GreyCell" table:number-columns-spanned="4"><text:p text:style-name="P">Ready for Learning – April score (please delete as appropriate below and attach RFL questionnaire)</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="TallRow">
          <table:table-cell table:style-name="YellowCell"><text:p text:style-name="Centered">Emotional Resilience</text:p></table:table-cell>
          <table:table-cell table:style-name="BlueCell"><text:p text:style-name="Centered">Language &amp; Cognition</text:p></table:table-cell>
          <table:table-cell table:style-name="GreenCell"><text:p text:style-name="Centered">Daily Living Skills</text:p></table:table-cell>
          <table:table-cell table:style-name="PinkCell"><text:p text:style-name="Centered">Family Support</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ShortRow">
          <table:table-cell table:style-name="ConcernGreen"><text:p text:style-name="Centered">No concerns</text:p></table:table-cell>
          <table:table-cell table:style-name="ConcernGreen"><text:p text:style-name="Centered">No concerns</text:p></table:table-cell>
          <table:table-cell table:style-name="ConcernGreen"><text:p text:style-name="Centered">No concerns</text:p></table:table-cell>
          <table:table-cell table:style-name="ConcernGreen"><text:p text:style-name="Centered">No concerns</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ShortRow">
          <table:table-cell table:style-name="ConcernYellow"><text:p text:style-name="Centered">Some concerns</text:p></table:table-cell>
          <table:table-cell table:style-name="ConcernYellow"><text:p text:style-name="Centered">Some concerns</text:p></table:table-cell>
          <table:table-cell table:style-name="ConcernYellow"><text:p text:style-name="Centered">Some concerns</text:p></table:table-cell>
          <table:table-cell table:style-name="ConcernYellow"><text:p text:style-name="Centered">Some concerns</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ShortRow">
          <table:table-cell table:style-name="ConcernRed"><text:p text:style-name="Centered">High concerns</text:p></table:table-cell>
          <table:table-cell table:style-name="ConcernRed"><text:p text:style-name="Centered">High concerns</text:p></table:table-cell>
          <table:table-cell table:style-name="ConcernRed"><text:p text:style-name="Centered">High concerns</text:p></table:table-cell>
          <table:table-cell table:style-name="ConcernRed"><text:p text:style-name="Centered">High concerns</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <table:table table:name="EYFSAttainment" table:style-name="SummaryTable">
        <table:table-column table:style-name="DomainLabelCol"/>
        <table:table-column table:style-name="DomainCol" table:number-columns-repeated="17"/>
        <table:table-row table:style-name="ShortRow">
          <table:table-cell table:style-name="GreyCell" table:number-columns-spanned="18"><text:p text:style-name="P">Summary of EYFS attainment</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="TallRow">
          <table:table-cell table:style-name="SmallHead" table:number-rows-spanned="2"/>
          <table:table-cell table:style-name="SmallHead" table:number-columns-spanned="2"><text:p text:style-name="Centered">Communication and Language</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="SmallHead" table:number-columns-spanned="3"><text:p text:style-name="Centered">Personal, Social and Emotional development</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="SmallHead" table:number-columns-spanned="2"><text:p text:style-name="Centered">Physical Development</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="SmallHead" table:number-columns-spanned="3"><text:p text:style-name="Centered">Literacy</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="SmallHead" table:number-columns-spanned="2"><text:p text:style-name="Centered">Maths</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="SmallHead" table:number-columns-spanned="3"><text:p text:style-name="Centered">Understanding the World</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="SmallHead" table:number-columns-spanned="2"><text:p text:style-name="Centered">Expressive Arts and Design</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="ScoreRow">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="VerticalHead"><text:p text:style-name="Centered">Listening, Attention and Understanding</text:p></table:table-cell>
          <table:table-cell table:style-name="VerticalHead"><text:p text:style-name="Centered">Speaking</text:p></table:table-cell>
          <table:table-cell table:style-name="VerticalHead"><text:p text:style-name="Centered">Self-Regulation</text:p></table:table-cell>
          <table:table-cell table:style-name="VerticalHead"><text:p text:style-name="Centered">Managing Self</text:p></table:table-cell>
          <table:table-cell table:style-name="VerticalHead"><text:p text:style-name="Centered">Building Relationships</text:p></table:table-cell>
          <table:table-cell table:style-name="VerticalHead"><text:p text:style-name="Centered">Gross Motor Skills</text:p></table:table-cell>
          <table:table-cell table:style-name="VerticalHead"><text:p text:style-name="Centered">Fine Motor Skills</text:p></table:table-cell>
          <table:table-cell table:style-name="VerticalHead"><text:p text:style-name="Centered">Comprehension</text:p></table:table-cell>
          <table:table-cell table:style-name="VerticalHead"><text:p text:style-name="Centered">Exploring Words</text:p></table:table-cell>
          <table:table-cell table:style-name="VerticalHead"><text:p text:style-name="Centered">Mark-Making</text:p></table:table-cell>
          <table:table-cell table:style-name="VerticalHead"><text:p text:style-name="Centered">Number</text:p></table:table-cell>
          <table:table-cell table:style-name="VerticalHead"><text:p text:style-name="Centered">Shape, Space &amp; Measure</text:p></table:table-cell>
          <table:table-cell table:style-name="VerticalHead"><text:p text:style-name="Centered">Past and Present</text:p></table:table-cell>
          <table:table-cell table:style-name="VerticalHead"><text:p text:style-name="Centered">People, Culture and Communities</text:p></table:table-cell>
          <table:table-cell table:style-name="VerticalHead"><text:p text:style-name="Centered">The Natural World</text:p></table:table-cell>
          <table:table-cell table:style-name="VerticalHead"><text:p text:style-name="Centered">Creating with Materials</text:p></table:table-cell>
          <table:table-cell table:style-name="VerticalHead"><text:p text:style-name="Centered">Being Imaginative and Expressive</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ShortRow">
          <table:table-cell table:style-name="RowLabel"><text:p text:style-name="P">On track</text:p></table:table-cell>
          <table:table-cell table:style-name="AttainCell"/><table:table-cell table:style-name="AttainCell"/><table:table-cell table:style-name="AttainCell"/><table:table-cell table:style-name="AttainCell"/><table:table-cell table:style-name="AttainCell"/><table:table-cell table:style-name="AttainCell"/><table:table-cell table:style-name="AttainCell"/><table:table-cell table:style-name="AttainCell"/><table:table-cell table:style-name="AttainCell"/><table:table-cell table:style-name="AttainCell"/><table:table-cell table:style-name="AttainCell"/><table:table-cell table:style-name="AttainCell"/><table:table-cell table:style-name="AttainCell"/><table:table-cell table:style-name="AttainCell"/><table:table-cell table:style-name="AttainCell"/><table:table-cell table:style-name="AttainCell"/><table:table-cell table:style-name="AttainCell"/>
        </table:table-row>
