<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
                 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
                 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
                 xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
                 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
                 office:mimetype="application/vnd.oasis.opendocument.text"
                 office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:default-style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="A4">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="1.7cm" fo:margin-bottom="1.7cm" fo:margin-left="2.5cm" fo:margin-right="2.5cm"/>
    </style:page-layout>
    <style:style style:name="T" style:family="table">
      <style:table-properties table:align="margins"/>
    </style:style>
    <style:style style:name="C" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CThin" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.035cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Green" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" fo:background-color="#00b050" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Grey" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.07cm" fo:background-color="#e7e6e6" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Yellow" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.05cm" fo:background-color="#ffff66" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Blue" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.05cm" fo:background-color="#b4c7e7" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Lime" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.05cm" fo:background-color="#99ff99" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Pink" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.05cm" fo:background-color="#ffccff" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="NoConcern" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.015cm" fo:background-color="#92d050" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="SomeConcern" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.015cm" fo:background-color="#ffc000" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HighConcern" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.015cm" fo:background-color="#ff0000" style:vertical-align="middle"/>
      <style:text-properties fo:color="#ffffff"/>
    </style:style>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="4cm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="4.3cm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="3cm"/>
    </style:style>
    <style:style style:name="ColD" style:family="table-column">
      <style:table-column-properties style:column-width="4.7cm"/>
    </style:style>
    <style:style style:name="SumLabel" style:family="table-column">
      <style:table-column-properties style:column-width="1.5cm"/>
    </style:style>
    <style:style style:name="SumCol" style:family="table-column">
      <style:table-column-properties style:column-width="0.85cm"/>
    </style:style>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="7pt"/>
    </style:style>
    <style:style style:name="Tiny" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="6pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:text-align="center"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="CenterSmall" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:text-align="center"/>
      <style:text-properties fo:font-size="7pt"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:text-align="end"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:text-align="center"/>
      <style:text-properties fo:font-size="19pt" fo:font-weight="bold" fo:color="#ffffff"/>
    </style:style>
    <style:style style:name="Bold" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-weight="bold" fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:text-align="end"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="Date" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.25cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="Vertical" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.02cm" style:vertical-align="middle" style:rotation-angle="90deg" style:rotation-align="center"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="A4"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p style-name="Right">Gloucestershire COUNTY COUNCIL</text:p>
      <text:p/>
      <table:table table:name="ChildDetails" table:style-name="T">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColD"/>
        <table:table-row>
          <table:table-cell table:style-name="Green" table:number-columns-spanned="4"><text:p style-name="Title">Ready for Reception Transition Record</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C"><text:p>Child’s Name:</text:p></table:table-cell>
          <table:table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"><text:p>Child’s Date of Birth:</text:p></table:table-cell>
          <table:table-cell table:style-name="C"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C"><text:p>EY Setting:</text:p></table:table-cell>
          <table:table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"><text:p>Practitioner’s Name:</text:p></table:table-cell>
          <table:table-cell table:style-name="C"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C"><text:p>Funded Hours Entitlement:</text:p></table:table-cell>
          <table:table-cell table:style-name="C"><text:p>□15</text:p><text:p>□30</text:p></table:table-cell>
          <table:table-cell table:style-name="C"><text:p>Accessing Full Entitlement:</text:p></table:table-cell>
          <table:table-cell table:style-name="C"><text:p>□Yes</text:p><text:p>□No</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C"><text:p>Child’s Ethnicity:</text:p></table:table-cell>
          <table:table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"><text:p>Child’s Gender:</text:p></table:table-cell>
          <table:table-cell table:style-name="C"><text:p>□ Male</text:p><text:p>□ Female</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C"><text:p>Home language:</text:p></table:table-cell>
          <table:table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"><text:p>Spoken Language:</text:p></table:table-cell>
          <table:table-cell table:style-name="C"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C"><text:p>Child with SEND:</text:p></table:table-cell>
          <table:table-cell table:style-name="C"><text:p>□Yes</text:p><text:p>□No</text:p></table:table-cell>
          <table:table-cell table:style-name="C"><text:p>Additional Information:</text:p></table:table-cell>
          <table:table-cell table:style-name="C"><text:p>LAC □   CIN □   MP □</text:p><text:p>CP □   IHCP □   MP+ □</text:p><text:p>EHCP □</text:p></table:table-cell>
        </table:table-row>
      </table:table>

      <table:table table:name="Readiness" table:style-name="T">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColD"/>
        <table:table-row>
          <table:table-cell table:style-name="Grey" table:number-columns-spanned="4"><text:p style-name="Bold">Ready for Learning – April score (please delete as appropriate below and attach RFL questionnaire)</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Yellow"><text:p style-name="Center"><text:span>Emotional Resilience</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="Blue"><text:p style-name="Center"><text:span>Language &amp; Cognition</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="Lime"><text:p style-name="Center">Daily Living Skills</text:p></table:table-cell>
          <table:table-cell table:style-name="Pink"><text:p style-name="Center">Family Support</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="NoConcern"><text:p style-name="CenterSmall">No concerns</text:p></table:table-cell>
          <table:table-cell table:style-name="NoConcern"><text:p style-name="CenterSmall">No concerns</text:p></table:table-cell>
          <table:table-cell table:style-name="NoConcern"><text:p style-name="CenterSmall">No concerns</text:p></table:table-cell>
          <table:table-cell table:style-name="NoConcern"><text:p style-name="CenterSmall">No concerns</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="SomeConcern"><text:p style-name="CenterSmall">Some concerns</text:p></table:table-cell>
          <table:table-cell table:style-name="SomeConcern"><text:p style-name="CenterSmall">Some concerns</text:p></table:table-cell>
          <table:table-cell table:style-name="SomeConcern"><text:p style-name="CenterSmall">Some concerns</text:p></table:table-cell>
          <table:table-cell table:style-name="SomeConcern"><text:p style-name="CenterSmall">Some concerns</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HighConcern"><text:p style-name="CenterSmall">High concerns</text:p></table:table-cell>
          <table:table-cell table:style-name="HighConcern"><text:p style-name="CenterSmall">High concerns</text:p></table:table-cell>
          <table:table-cell table:style-name="HighConcern"><text:p style-name="CenterSmall">High concerns</text:p></table:table-cell>
          <table:table-cell table:style-name="HighConcern"><text:p style-name="CenterSmall">High concerns</text:p></table:table-cell>
        </table:table-row>
      </table:table>

      <table:table table:name="EYFSattainment" table:style-name="T">
        <table:table-column table:style-name="SumLabel"/>
        <table:table-column table:style-name="SumCol"/><table:table-column table:style-name="SumCol"/><table:table-column table:style-name="SumCol"/><table:table-column table:style-name="SumCol"/><table:table-column table:style-name="SumCol"/><table:table-column table:style-name="SumCol"/><table:table-column table:style-name="SumCol"/><table:table-column table:style-name="SumCol"/><table:table-column table:style-name="SumCol"/><table:table-column table:style-name="SumCol"/><table:table-column table:style-name="SumCol"/><table:table-column table:style-name="SumCol"/><table:table-column table:style-name="SumCol"/><table:table-column table:style-name="SumCol"/><table:table-column table:style-name="SumCol"/><table:table-column table:style-name="SumCol"/><table:table-column table:style-name="SumCol"/>
        <table:table-row>
          <table:table-cell table:style-name="Grey" table:number-columns-spanned="18"><text:p style-name="Bold">Summary of EYFS attainment</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CThin"/>
          <table:table-cell table:style-name="CThin" table:number-columns-spanned="2"><text:p style-name="CenterSmall">Communication and Language</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="CThin" table:number-columns-spanned="3"><text:p style-name="CenterSmall">Personal, Social and Emotional development</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="CThin" table:number-columns-spanned="2"><text:p style-name="CenterSmall">Physical Development</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="CThin" table:number-columns-spanned="3"><text:p style-name="CenterSmall">Literacy</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="CThin" table:number-columns-spanned="2"><text:p style-name="CenterSmall">Maths</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="CThin" table:number-columns-spanned="3"><text:p style-name="CenterSmall">Understanding the World</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="CThin" table:number-columns-spanned="2"><text:p style-name="CenterSmall">Expressive Arts and Design</text:p></table:table-cell><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CThin"/>
          <table:table-cell table:style-name="Vertical"><text:p style-name="Tiny">Listening, Attention and Understanding</text:p></table:table-cell>
          <table:table-cell table:style-name="Vertical"><text:p style-name="Tiny">Speaking</text:p></table:table-cell>
          <table:table-cell table:style-name="Vertical"><text:p style-name="Tiny">Self-Regulation</text:p></table:table-cell>
          <table:table-cell table:style-name="Vertical"><text:p style-name="Tiny">Managing Self</text:p></table:table-cell>
          <table:table-cell table:style-name="Vertical"><text:p style-name="Tiny">Building Relationships</text:p></table:table-cell>
          <table:table-cell table:style-name="Vertical"><text:p style-name="Tiny">Gross Motor Skills</text:p></table:table-cell>
          <table:table-cell table:style-name="Vertical"><text:p style-name="Tiny">Fine Motor Skills</text:p></table:table-cell>
          <table:table-cell table:style-name="Vertical"><text:p style-name="Tiny">Comprehension</text:p></table:table-cell>
          <table:table-cell table:style-name="Vertical"><text:p style-name="Tiny">Exploring Words</text:p></table:table-cell>
          <table:table-cell table:style-name="Vertical"><text:p style-name="Tiny">Mark-Making</text:p></table:table-cell>
          <table:table-cell table:style-name="Vertical"><text:p style-name="Tiny">Number</text:p></table:table-cell>
          <table:table-cell table:style-name="Vertical"><text:p style-name="Tiny">Shape, Space &amp; Measure</text:p></table:table-cell>
          <table:table-cell table:style-name="Vertical"><text:p style-name="Tiny">Past and Present</text:p></table:table-cell>
          <table:table-cell table:style-name="Vertical"><text:p style-name="Tiny">People, Culture and Communities</text:p></table:table-cell>
          <table:table-cell table:style-name="Vertical"><text:p style-name="Tiny">The Natural World</text:p></table:table-cell>
          <table:table-cell table:style-name="Vertical"><text:p style-name="Tiny">Creating with Materials</text:p></table:table-cell>
          <table:table-cell table:style-name="Vertical"><text:p style-name="Tiny">Being Imaginative and Expressive</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C"><text:p style-name="Bold">On track</text:p></table:table-cell>
          <table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C"><text:p style-name="Bold">Working towards</text:p></table:table-cell>
          <table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C"><text:p style-name="Bold">Below</text:p></table:table-cell>
          <table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/><table:table-cell table:style-name="CThin"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Grey" table:number-columns-spanned="18"><text:p style-name="Bold">Additional Information to be completed by practitioner</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C" table:number-columns-spanned="18"><text:p>My strengths and talents:</text:p><text:p/><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
