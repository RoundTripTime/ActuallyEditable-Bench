<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Default" style:family="paragraph">
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="PageStartRight" style:family="paragraph" style:parent-style-name="Default">
      <style:paragraph-properties fo:break-before="page" fo:text-align="end"/>
    </style:style>
    <style:style style:name="Left" style:family="paragraph" style:parent-style-name="Default">
      <style:paragraph-properties fo:text-align="start"/>
    </style:style>
    <style:style style:name="Centered" style:family="paragraph" style:parent-style-name="Default">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph" style:parent-style-name="Default">
      <style:paragraph-properties fo:text-align="end"/>
    </style:style>
    <style:style style:name="UnderlinedCentered" style:family="paragraph" style:parent-style-name="Default">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties style:text-underline-style="solid"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="8.27in" fo:page-height="11.69in" style:print-orientation="portrait" fo:margin-top="0.55in" fo:margin-bottom="0.55in" fo:margin-left="0.75in" fo:margin-right="0.75in"/>
    </style:page-layout>
    <style:style style:name="NarrowTable" style:family="table">
      <style:table-properties style:width="6in" table:align="center"/>
    </style:style>
    <style:style style:name="WideTable" style:family="table">
      <style:table-properties style:width="6.77in" table:align="center"/>
    </style:style>
    <style:style style:name="TopCol1" style:family="table-column">
      <style:table-column-properties style:column-width="1in"/>
    </style:style>
    <style:style style:name="TopCol2" style:family="table-column">
      <style:table-column-properties style:column-width="3.4in"/>
    </style:style>
    <style:style style:name="TopCol3" style:family="table-column">
      <style:table-column-properties style:column-width="0.7in"/>
    </style:style>
    <style:style style:name="TopCol4" style:family="table-column">
      <style:table-column-properties style:column-width="0.9in"/>
    </style:style>
    <style:style style:name="CostCol1" style:family="table-column">
      <style:table-column-properties style:column-width="0.5in"/>
    </style:style>
    <style:style style:name="CostCol2" style:family="table-column">
      <style:table-column-properties style:column-width="1.8in"/>
    </style:style>
    <style:style style:name="CostCol3" style:family="table-column">
      <style:table-column-properties style:column-width="0.8in"/>
    </style:style>
    <style:style style:name="CostCol4" style:family="table-column">
      <style:table-column-properties style:column-width="1.08in"/>
    </style:style>
    <style:style style:name="CostCol5" style:family="table-column">
      <style:table-column-properties style:column-width="1.08in"/>
    </style:style>
    <style:style style:name="CostCol6" style:family="table-column">
      <style:table-column-properties style:column-width="1.51in"/>
    </style:style>
    <style:style style:name="MapCol" style:family="table-column">
      <style:table-column-properties style:column-width="6.77in"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.04in" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="MapCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #b0b0b0" fo:padding="0.08in" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="MapRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="2in"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Master" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStartRight">令和　年　月　日提出</text:p>
      <table:table table:name="ApplicationForm" table:style-name="NarrowTable">
        <table:table-column table:style-name="TopCol1"/>
        <table:table-column table:style-name="TopCol2"/>
        <table:table-column table:style-name="TopCol3"/>
        <table:table-column table:style-name="TopCol4"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Left">令和</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Centered">年度みやき町緑の郷土づくり運動事業実施要望申請書</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Left">地区名<text:line-break/>代表者名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Right">㊞</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Left">事業内容<text:line-break/>及び目的</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p/></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Left">実施場所</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Left">面積</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">m²</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Left">実施予定時期</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Centered">令和　年　月頃</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Left">【植樹予定樹種及び支出見込額】</text:p>
      <table:table table:name="EstimatedCosts" table:style-name="WideTable">
        <table:table-column table:style-name="CostCol1"/>
        <table:table-column table:style-name="CostCol2"/>
        <table:table-column table:style-name="CostCol3"/>
        <table:table-column table:style-name="CostCol4"/>
        <table:table-column table:style-name="CostCol5"/>
        <table:table-column table:style-name="CostCol6"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Left">名　称（種類）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Left">数量</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Left">単価</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Left">予算額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Left">備考</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="3"><text:p text:style-name="Centered">樹<text:line-break/>種<text:line-break/>名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">本</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Left">高さ＝　　　 m</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">本</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Left">高さ＝　　　 m</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">本</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Left">高さ＝　　　 m</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="5"><text:p text:style-name="Centered">原<text:line-break/>材<text:line-break/>料<text:line-break/>費</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="3"><text:p text:style-name="Centered">そ<text:line-break/>の<text:line-break/>他</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Left">計</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <table:table table:name="LocationMap" table:style-name="WideTable">
        <table:table-column table:style-name="MapCol"/>
        <table:table-row table:style-name="MapRow">
          <table:table-cell table:style-name="MapCell">
            <text:p text:style-name="Left">【実施場所位置図】</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Centered">【必要書類】</text:p>
      <text:p text:style-name="UnderlinedCentered">樹種及び原材料費等の見積書</text:p>
    </office:text>
  </office:body>
</office:document>