<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:default-style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Centered" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="TitleLine" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-size="13pt"/>
    </style:style>
    <style:style style:name="SectionTitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="LargeCentered" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="CenteredSmall" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Spacer" style:family="paragraph">
      <style:paragraph-properties fo:line-height="3mm" fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-size="3pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" style:print-orientation="portrait" fo:margin-left="18mm" fo:margin-right="18mm" fo:margin-top="18mm" fo:margin-bottom="17mm"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="174mm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="LocationTable" style:family="table">
      <style:table-properties style:width="174mm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="TopCol1" style:family="table-column">
      <style:table-column-properties style:column-width="26mm"/>
    </style:style>
    <style:style style:name="TopCol2" style:family="table-column">
      <style:table-column-properties style:column-width="76.5mm"/>
    </style:style>
    <style:style style:name="TopCol3" style:family="table-column">
      <style:table-column-properties style:column-width="18mm"/>
    </style:style>
    <style:style style:name="TopCol4" style:family="table-column">
      <style:table-column-properties style:column-width="53.5mm"/>
    </style:style>
    <style:style style:name="BudgetCol1" style:family="table-column">
      <style:table-column-properties style:column-width="12.8mm"/>
    </style:style>
    <style:style style:name="BudgetCol2" style:family="table-column">
      <style:table-column-properties style:column-width="45.9mm"/>
    </style:style>
    <style:style style:name="BudgetCol3" style:family="table-column">
      <style:table-column-properties style:column-width="20.5mm"/>
    </style:style>
    <style:style style:name="BudgetCol4" style:family="table-column">
      <style:table-column-properties style:column-width="28mm"/>
    </style:style>
    <style:style style:name="BudgetCol5" style:family="table-column">
      <style:table-column-properties style:column-width="28mm"/>
    </style:style>
    <style:style style:name="BudgetCol6" style:family="table-column">
      <style:table-column-properties style:column-width="38.8mm"/>
    </style:style>
    <style:style style:name="BorderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.6mm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="MapCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #b0b0b0" fo:padding="1mm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="TopRowTitle" style:family="table-row">
      <style:table-row-properties style:row-height="6.5mm"/>
    </style:style>
    <style:style style:name="TopRowPeople" style:family="table-row">
      <style:table-row-properties style:row-height="16mm"/>
    </style:style>
    <style:style style:name="TopRowPurpose" style:family="table-row">
      <style:table-row-properties style:row-height="26mm"/>
    </style:style>
    <style:style style:name="TopRowPlace" style:family="table-row">
      <style:table-row-properties style:row-height="10.5mm"/>
    </style:style>
    <style:style style:name="TopRowDate" style:family="table-row">
      <style:table-row-properties style:row-height="10.5mm"/>
    </style:style>
    <style:style style:name="BudgetHeader" style:family="table-row">
      <style:table-row-properties style:row-height="7mm"/>
    </style:style>
    <style:style style:name="BudgetRow" style:family="table-row">
      <style:table-row-properties style:row-height="7mm"/>
    </style:style>
    <style:style style:name="BudgetLastRow" style:family="table-row">
      <style:table-row-properties style:row-height="7mm"/>
    </style:style>
    <style:style style:name="MapRow" style:family="table-row">
      <style:table-row-properties style:row-height="52mm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">令和　　年　　月　　日提出</text:p>
      <text:p text:style-name="Spacer"/>
      <table:table table:name="Application" table:style-name="FormTable">
        <table:table-column table:style-name="TopCol1"/>
        <table:table-column table:style-name="TopCol2"/>
        <table:table-column table:style-name="TopCol3"/>
        <table:table-column table:style-name="TopCol4"/>
        <table:table-row table:style-name="TopRowTitle">
          <table:table-cell table:style-name="BorderCell" table:number-columns-spanned="4">
            <text:p text:style-name="TitleLine">令和　　年度みやき町緑の郷土づくり運動事業実施要望申請書</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="TopRowPeople">
          <table:table-cell table:style-name="BorderCell">
            <text:p>地区名</text:p>
            <text:p>代表者名</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="BorderCell" table:number-columns-spanned="3">
            <text:p text:style-name="Right">㊞</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="TopRowPurpose">
          <table:table-cell table:style-name="BorderCell">
            <text:p>事業内容</text:p>
            <text:p>及び目的</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="BorderCell" table:number-columns-spanned="3">
            <text:p/>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="TopRowPlace">
          <table:table-cell table:style-name="BorderCell">
            <text:p>実施場所</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="BorderCell">
            <text:p/>
          </table:table-cell>
          <table:table-cell table:style-name="BorderCell">
            <text:p>面積</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="BorderCell">
            <text:p text:style-name="Right">㎡</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="TopRowDate">
          <table:table-cell table:style-name="BorderCell">
            <text:p>実施予定時期</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="BorderCell" table:number-columns-spanned="3">
            <text:p text:style-name="CenteredSmall">令和　　年　　月頃</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Spacer"/>
      <text:p text:style-name="SectionTitle">【植樹予定樹種及び支出見込額】</text:p>
      <table:table table:name="Estimate" table:style-name="FormTable">
        <table:table-column table:style-name="BudgetCol1"/>
        <table:table-column table:style-name="BudgetCol2"/>
        <table:table-column table:style-name="BudgetCol3"/>
        <table:table-column table:style-name="BudgetCol4"/>
        <table:table-column table:style-name="BudgetCol5"/>
        <table:table-column table:style-name="BudgetCol6"/>
        <table:table-row table:style-name="BudgetHeader">
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p>名　称（種類）</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p>数量</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p>単価</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p>予算額</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p>備考</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="BudgetRow">
          <table:table-cell table:style-name="BorderCell" table:number-rows-spanned="3"><text:p text:style-name="Centered">樹種名</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p text:style-name="Right">本</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p>高さ＝　　 m</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="BudgetRow">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p text:style-name="Right">本</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p>高さ＝　　 m</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="BudgetRow">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p text:style-name="Right">本</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p>高さ＝　　 m</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="BudgetRow">
          <table:table-cell table:style-name="BorderCell" table:number-rows-spanned="5"><text:p text:style-name="Centered">原材料費</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="BudgetRow">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="BudgetRow">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="BudgetRow">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="BudgetRow">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="BudgetRow">
          <table:table-cell table:style-name="BorderCell" table:number-rows-spanned="3"><text:p text:style-name="Centered">その他</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="BudgetRow">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="BudgetRow">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="BudgetLastRow">
          <table:table-cell table:style-name="BorderCell"><text:p>計</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Spacer"/>
      <table:table table:name="LocationMap" table:style-name="LocationTable">
        <table:table-column table:style-name="TopCol1"/>
        <table:table-column table:style-name="TopCol2"/>
        <table:table-column table:style-name="TopCol3"/>
        <table:table-column table:style-name="TopCol4"/>
        <table:table-row table:style-name="MapRow">
          <table:table-cell table:style-name="MapCell" table:number-columns-spanned="4">
            <text:p>【実施場所位置図】</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Spacer"/>
      <text:p text:style-name="LargeCentered">【必要書類】</text:p>
      <text:p text:style-name="Centered">樹種及び原材料費等の見積書</text:p>
    </office:text>
  </office:body>
</office:document>