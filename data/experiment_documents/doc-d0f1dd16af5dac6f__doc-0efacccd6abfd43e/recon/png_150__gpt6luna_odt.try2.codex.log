  <office:body>
    <office:text>
      <text:p text:style-name="Center">農地法第５条第１項の規定による許可申請書</text:p>
      <text:p text:style-name="Body">　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　年　　　月　　　日</text:p>
      <text:p text:style-name="Body">岐阜県知事　　　様</text:p>
      <text:p text:style-name="Body">　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　譲受人　氏名　　　　　　　　　印</text:p>
