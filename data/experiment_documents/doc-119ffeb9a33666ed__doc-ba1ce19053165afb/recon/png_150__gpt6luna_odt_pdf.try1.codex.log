    <office:text>
      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="SmallTop">様式第４号</text:p>
      <text:p text:style-name="TitlePara">委　任　状</text:p>
      <text:p text:style-name="RightDate">令和　　年　　月　　日</text:p>
      <text:p text:style-name="IndentPara">（あて先）</text:p>
      <text:p text:style-name="IndentPara">長 泉 町 長</text:p>
      <text:p text:style-name="BodyPara">私は、令和８年11月11日実施の町有地売却一般競争入札に参加するに当たり、下記のとおり代理人に権限を委任します。</text:p>
      <text:p text:style-name="SectionPara">町有地売却一般競争入札参加申込者（委任する人）</text:p>
      <text:p text:style-name="IndentPara">住所（法人にあっては、主たる事務所の所在地）</text:p>
      <table:table table:name="ApplicantAddressLine" table:style-name="FieldTable">
        <table:table-column table:style-name="FieldCol"/>
        <table:table-row>
          <table:table-cell table:style-name="BlankLineCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="IndentPara">氏名（法人にあっては、名称及び代表者名）</text:p>
      <table:table table:name="ApplicantNameLine" table:style-name="FieldTable">
        <table:table-column table:style-name="FieldCol"/>
        <table:table-row>
          <table:table-cell table:style-name="BlankLineCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="RightDate">　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　㊞</text:p>
      <text:p text:style-name="Centered">記</text:p>
      <text:p text:style-name="SectionPara">１．委任する権限</text:p>
      <text:p text:style-name="IndentPara">令和８年11月11日に実施する次の物件の一般競争入札に関する一切の権限</text:p>
      <table:table table:name="PropertyNumber" table:style-name="TableBase">
        <table:table-column table:style-name="NarrowCol"/>
        <table:table-column table:style-name="WideCol"/>
        <table:table-row>
          <table:table-cell table:style-name="ItemLeft">
            <text:p text:style-name="Centered">物　件</text:p>
            <text:p text:style-name="Centered">番　号</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="ItemRight">
            <text:p text:style-name="Centered">１</text:p>
          </table:table-cell>
        </table:table-row>
