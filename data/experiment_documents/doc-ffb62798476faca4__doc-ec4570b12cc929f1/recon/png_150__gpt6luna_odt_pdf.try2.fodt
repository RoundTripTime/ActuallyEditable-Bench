<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="0mm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" style:font-family-asian="serif" style:language-asian="ja" fo:font-size="9pt" style:font-size-asian="9pt"/>
    </style:default-style>
    <style:style style:name="BreakStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0mm" fo:margin-bottom="1mm"/>
    </style:style>
    <style:style style:name="Caption" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="0.7mm"/>
      <style:text-properties fo:font-size="9pt" style:font-size-asian="9pt"/>
    </style:style>
    <style:style style:name="CellP" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="0mm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="9pt" style:font-size-asian="9pt"/>
    </style:style>
    <style:style style:name="CenteredP" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0mm" fo:margin-bottom="0mm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="9pt" style:font-size-asian="9pt"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.15mm solid #000000" fo:padding="0.6mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellThick" style:family="table-cell">
      <style:table-cell-properties fo:border="0.4mm solid #000000" fo:padding="0.6mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="OuterCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.4mm solid #000000" fo:padding="0.8mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="NoBorderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0mm" style:vertical-align="middle"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" fo:margin-top="15mm" fo:margin-bottom="14mm" fo:margin-left="17mm" fo:margin-right="17mm"/>
    </style:page-layout>
    <style:style style:name="TableFull" style:family="table">
      <style:table-properties style:width="176mm" table:align="margins"/>
    </style:style>
    <style:style style:name="ColFull" style:family="table-column">
      <style:table-column-properties style:column-width="176mm"/>
    </style:style>
    <style:style style:name="ColTimingA" style:family="table-column">
      <style:table-column-properties style:column-width="40mm"/>
    </style:style>
    <style:style style:name="ColTimingB" style:family="table-column">
      <style:table-column-properties style:column-width="40mm"/>
    </style:style>
    <style:style style:name="ColTimingC" style:family="table-column">
      <style:table-column-properties style:column-width="48mm"/>
    </style:style>
    <style:style style:name="ColTimingD" style:family="table-column">
      <style:table-column-properties style:column-width="48mm"/>
    </style:style>
    <style:style style:name="ColPurposeA" style:family="table-column">
      <style:table-column-properties style:column-width="34mm"/>
    </style:style>
    <style:style style:name="ColPurposeB" style:family="table-column">
      <style:table-column-properties style:column-width="31mm"/>
    </style:style>
    <style:style style:name="ColPurposeC" style:family="table-column">
      <style:table-column-properties style:column-width="30mm"/>
    </style:style>
    <style:style style:name="ColPurposeD" style:family="table-column">
      <style:table-column-properties style:column-width="31mm"/>
    </style:style>
    <style:style style:name="ColPurposeE" style:family="table-column">
      <style:table-column-properties style:column-width="31mm"/>
    </style:style>
    <style:style style:name="ColPurposeF" style:family="table-column">
      <style:table-column-properties style:column-width="19mm"/>
    </style:style>
    <style:style style:name="ColFinance" style:family="table-column">
      <style:table-column-properties style:column-width="22mm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="BreakStart">様式３－３</text:p>
      <table:table table:name="ReasonDetails" table:style-name="TableFull">
        <table:table-column table:style-name="ColFull"/>
        <table:table-row>
          <table:table-cell table:style-name="CellThick"><text:p text:style-name="CellP">転　用　事　由　の　詳　細</text:p></table:table-cell>
        </table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="CellThick"><text:p text:style-name="CellP"/></table:table-cell></table:table-row>
      </table:table>
      <table:table table:name="Timing" table:style-name="TableFull">
        <table:table-column table:style-name="ColTimingA"/>
        <table:table-column table:style-name="ColTimingB"/>
        <table:table-column table:style-name="ColTimingC"/>
        <table:table-column table:style-name="ColTimingD"/>
        <table:table-row><table:table-cell table:number-columns-spanned="4" table:style-name="CellThick"><text:p text:style-name="CellP">転　用　の　時　期</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">工事着手年月日</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenteredP">年　　月　　日</text:p></table:table-cell>
          <table:table-cell table:number-rows-spanned="2" table:style-name="Cell"><text:p text:style-name="CenteredP">事業の操業期間又</text:p><text:p text:style-name="CenteredP">は施設の利用期間</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenteredP">年　　月　　日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">工事完成年月日</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenteredP">年　　月　　日</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenteredP">から　　年間</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <table:table table:name="ProjectOverview" table:style-name="TableFull">
        <table:table-column table:style-name="ColPurposeA"/>
        <table:table-column table:style-name="ColPurposeB"/>
        <table:table-column table:style-name="ColPurposeC"/>
        <table:table-column table:style-name="ColPurposeD"/>
        <table:table-column table:style-name="ColPurposeE"/>
        <table:table-column table:style-name="ColPurposeF"/>
        <table:table-row><table:table-cell table:number-columns-spanned="6" table:style-name="CellThick"><text:p text:style-name="CellP">転用目的に係る事業又は施設の概要</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellThick"><text:p text:style-name="CellP"/></table:table-cell>
          <table:table-cell table:style-name="CellThick"><text:p text:style-name="CenteredP">名　称</text:p></table:table-cell>
          <table:table-cell table:style-name="CellThick"><text:p text:style-name="CenteredP">棟　数</text:p></table:table-cell>
          <table:table-cell table:style-name="CellThick"><text:p text:style-name="CenteredP">建築面積</text:p></table:table-cell>
          <table:table-cell table:style-name="CellThick"><text:p text:style-name="CenteredP">所要面積</text:p></table:table-cell>
          <table:table-cell table:style-name="CellThick"><text:p text:style-name="CenteredP">備　考</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenteredP">土　地　造　成</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CenteredP">㎡</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenteredP">建　　築　　物</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CenteredP">㎡</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell>
        </table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="CenteredP">小　　計</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="CenteredP">工　作　物</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="CenteredP">小　　計</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="CenteredP">計</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">地下資源採取の場合</text:p></table:table-cell><table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p text:style-name="CenteredP">掘削深　　ｍ</text:p></table:table-cell><table:covered-table-cell/><table:table-cell table:number-columns-spanned="3" table:style-name="Cell"><text:p text:style-name="CenteredP">採取量　　ｍ³</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
      </table:table>
      <table:table table:name="FundingPlan" table:style-name="TableFull">
        <table:table-column table:style-name="ColFinance"/><table:table-column table:style-name="ColFinance"/><table:table-column table:style-name="ColFinance"/><table:table-column table:style-name="ColFinance"/>
        <table:table-column table:style-name="ColFinance"/><table:table-column table:style-name="ColFinance"/><table:table-column table:style-name="ColFinance"/><table:table-column table:style-name="ColFinance"/>
        <table:table-row><table:table-cell table:number-columns-spanned="8" table:style-name="CellThick"><text:p text:style-name="CellP">資　金　調　達　に　つ　い　て　の　計　画</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="4" table:style-name="Cell"><text:p text:style-name="CellP">（必要経費内訳）</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:number-columns-spanned="4" table:style-name="Cell"><text:p text:style-name="CellP">（調達方法）</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p text:style-name="CellP">土地購入費（賃借料）</text:p></table:table-cell><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p text:style-name="CenteredP">円</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">建物建築費</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CenteredP">円</text:p></table:table-cell><table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p text:style-name="CellP">自　己　資　金</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">施　設　費</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CenteredP">円</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">土地造成費</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CenteredP">円</text:p></table:table-cell><table:table-cell table:number-columns-spanned="3" table:style-name="Cell"><text:p text:style-name="CenteredP">から借入</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p text:style-name="CenteredP">円</text:p></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="CenteredP">費</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CenteredP">円</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CenteredP">合　　計</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CenteredP">円</text:p></table:table-cell><table:table-cell table:number-columns-spanned="3" table:style-name="Cell"><text:p text:style-name="CenteredP">補　　助　　金</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p text:style-name="CenteredP">円</text:p></table:table-cell></table:table-row>
      </table:table>
      <table:table table:name="DamagePrevention" table:style-name="TableFull">
        <table:table-column table:style-name="ColFull"/>
        <table:table-row><table:table-cell table:style-name="CellThick"><text:p text:style-name="CellP">転用することによって生ずる付近の農地、作物等の被害の防除施設の概要</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="CellThick"><text:p text:style-name="CellP"/></table:table-cell></table:table-row>
      </table:table>
      <table:table table:name="OtherInformation" table:style-name="TableFull">
        <table:table-column table:style-name="ColPurposeA"/>
        <table:table-column table:style-name="ColPurposeB"/>
        <table:table-column table:style-name="ColPurposeC"/>
        <table:table-column table:style-name="ColPurposeD"/>
        <table:table-column table:style-name="ColPurposeE"/>
        <table:table-column table:style-name="ColPurposeF"/>
        <table:table-row><table:table-cell table:number-columns-spanned="1" table:style-name="Cell"><text:p text:style-name="CellP">関係法令の許認可申請届等手続状況</text:p></table:table-cell><table:table-cell table:number-columns-spanned="5" table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">その他参考となるべき事項</text:p></table:table-cell><table:table-cell table:number-columns-spanned="5" table:style-name="Cell"><text:p text:style-name="CellP"/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>