<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="TopLine" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="13pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="CellBorder" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="TableLayout" style:family="table">
      <style:table-properties style:width="15.3cm" table:align="center"/>
    </style:style>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="2.4cm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="0.7cm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="12.2cm"/>
    </style:style>
    <style:style style:name="HeadRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.15cm"/>
    </style:style>
    <style:style style:name="MainRow" style:family="table-row">
      <style:table-row-properties style:row-height="8.1cm"/>
    </style:style>
    <style:style style:name="AgentRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.9cm"/>
    </style:style>
    <style:style style:name="ConsentRow" style:family="table-row">
      <style:table-row-properties style:row-height="5.1cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-top="3cm" fo:margin-bottom="2cm" fo:margin-left="2.7cm" fo:margin-right="2.7cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="TopLine">様式第３２号（第１９条関係）</text:p>
      <table:table table:name="申告書" table:style-name="TableLayout">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-row table:style-name="HeadRow">
          <table:table-cell table:style-name="CellBorder" table:number-columns-spanned="3">
            <text:p text:style-name="Title">市・県民税納税管理人（変更）申告書</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="MainRow">
          <table:table-cell table:style-name="CellBorder" table:number-columns-spanned="3">
            <text:p text:style-name="Right">年　　月　　日</text:p>
            <text:p>　</text:p>
            <text:p>結城市長　　　　様</text:p>
            <text:p>　</text:p>
            <text:p text:style-name="Right">納税義務者</text:p>
            <text:p text:style-name="Right">（特別徴収義務者）</text:p>
            <text:p text:style-name="Right">住（居）所</text:p>
            <text:p text:style-name="Right">氏　名</text:p>
            <text:p text:style-name="Right">（電話　　　　　　　　　）</text:p>
            <text:p text:style-name="Right">個人番号又</text:p>
            <text:p text:style-name="Right">は法人番号</text:p>
            <text:p>　</text:p>
            <text:p>　</text:p>
            <text:p>　</text:p>
            <text:p>下記の者を市・県民税の納税管理人として定めました（変更します）から申告いたしま</text:p>
            <text:p>す。</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="AgentRow">
          <table:table-cell table:style-name="CellBorder" table:number-rows-spanned="2">
            <text:p text:style-name="Center">納税管理人</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="CellBorder">
            <text:p text:style-name="Center">新</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="CellBorder">
            <text:p>住（居）所</text:p>
            <text:p>氏　名</text:p>
            <text:p text:style-name="Right">（電話　　　　　　　　　　　　　　　　）</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="AgentRow">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellBorder">
            <text:p text:style-name="Center">旧</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="CellBorder">
            <text:p>住（居）所</text:p>
            <text:p>氏　名</text:p>
            <text:p text:style-name="Right">（電話　　　　　　　　　　　　　　　　）</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ConsentRow">
          <table:table-cell table:style-name="CellBorder" table:number-columns-spanned="3">
            <text:p text:style-name="Center">承　諾　書</text:p>
            <text:p>　</text:p>
            <text:p text:style-name="Right">年　　月　　日</text:p>
            <text:p>　</text:p>
            <text:p>結城市長　　　　様</text:p>
            <text:p>　</text:p>
            <text:p text:style-name="Right">氏名</text:p>
            <text:p>　</text:p>
            <text:p>納税義務者（特別徴収義務者）　　　　の納税管理人を承諾しました。</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body">（注）市・県民税の納税義務者は、納税義務を負う市内に住所、居所、事務所又は事業</text:p>
      <text:p text:style-name="Body">　　所を有しない場合には、納税に関する一切の事項を処理させるため、市の区域内に</text:p>
      <text:p text:style-name="Body">　　居住する者のうちから納税管理人を定め、これを市長に申告しなければなりません。</text:p>
      <text:p text:style-name="Body">　　納税管理人を変更した場合においても、また同様です。</text:p>
    </office:text>
  </office:body>
</office:document>