        <rng:ref name="styleNameRef"/>
      </rng:attribute>
      <rng:optional>
        <rng:attribute name="draw:style-name">
          <rng:ref name="styleNameRef"/>
        </rng:attribute>
      </rng:optional>
      <rng:optional>
        <rng:attribute name="style:next-style-name">
          <rng:ref name="styleNameRef"/>
        </rng:attribute>
      </rng:optional>
    </rng:interleave>
  </rng:define>
  <rng:define name="style-num-letter-sync-attlist">
    <rng:optional>
