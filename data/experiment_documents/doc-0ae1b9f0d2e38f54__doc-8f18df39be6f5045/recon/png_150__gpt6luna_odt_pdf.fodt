<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:xml="http://www.w3.org/XML/1998/namespace" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:font-size="13pt" fo:line-height="1.35"/>
      <style:text-properties fo:font-family="MS Mincho" fo:font-size="13pt"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="2.8cm" fo:margin-bottom="1.0cm" fo:break-before="page"/>
      <style:text-properties fo:font-family="MS Mincho" fo:font-size="22pt"/>
    </style:style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:line-height="1.45"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:font-size="10.5pt" fo:line-height="1.5"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="CenterSmall" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:font-size="10.5pt" fo:line-height="1.5"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="1.0cm" fo:margin-bottom="0.2cm"/>
    </style:style>
    <style:style style:name="FieldTable" style:family="table">
      <style:table-properties table:align="left" style:width="15cm"/>
    </style:style>
    <style:style style:name="FieldLabel" style:family="table-column">
      <style:table-column-properties style:column-width="1.8cm"/>
    </style:style>
    <style:style style:name="FieldValue" style:family="table-column">
      <style:table-column-properties style:column-width="13.2cm"/>
    </style:style>
    <style:style style:name="InputLine" style:family="table-cell">
      <style:table-cell-properties fo:border-bottom="0.5pt solid #000000" fo:padding="0.08cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="3cm" fo:margin-right="3cm" fo:margin-top="2.5cm" fo:margin-bottom="2.5cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">委　任　状</text:p>
      <table:table table:name="代理人欄" table:style-name="FieldTable">
        <table:table-column table:style-name="FieldLabel"/>
        <table:table-column table:style-name="FieldValue"/>
        <table:table-row>
          <table:table-cell><text:p>代理人</text:p></table:table-cell>
          <table:table-cell table:style-name="InputLine"><text:p>住所</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell><text:p/></table:table-cell>
          <table:table-cell table:style-name="InputLine"><text:p>氏名</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body" fo:margin-top="1.2cm">私は、上記のものを代理人と定め、<text:span text:style-name="Underlined">横浜市　　　　　　　　　　　　　　　　</text:span></text:p>
      <text:p text:style-name="Body">に所在する土地及び建築物に関して、次の権限を委任します。</text:p>
      <text:p text:style-name="Section">委任事項</text:p>
      <text:p>　・</text:p>
      <text:p>　・</text:p>
      <text:p>　・</text:p>
      <text:p>　・</text:p>
      <text:p>　・</text:p>
      <text:p text:style-name="Small" fo:margin-top="4.0cm">なお、上記委任事項に関連する個人情報について代理人に提供することに同意します。</text:p>
      <text:p text:style-name="CenterSmall">令和　年　月　日</text:p>
      <text:p text:style-name="CenterSmall">（委任状作成年月日）</text:p>
      <table:table table:name="本人欄" table:style-name="FieldTable">
        <table:table-column table:style-name="FieldLabel"/>
        <table:table-column table:style-name="FieldValue"/>
        <table:table-row>
          <table:table-cell><text:p>本人</text:p></table:table-cell>
          <table:table-cell table:style-name="InputLine"><text:p>住所</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell><text:p/></table:table-cell>
          <table:table-cell table:style-name="InputLine"><text:p>氏名</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell><text:p/></table:table-cell>
          <table:table-cell table:style-name="InputLine"><text:p>電話番号</text:p></table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>