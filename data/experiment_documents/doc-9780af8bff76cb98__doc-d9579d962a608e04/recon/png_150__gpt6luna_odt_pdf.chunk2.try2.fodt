        <table:table-column table:style-name="ColMed"/>
        <table:table-column table:style-name="ColWide"/>
        <table:table-row><table:table-cell table:number-columns-spanned="4" table:style-name="GrayCell"><text:p text:style-name="MainText">1　危険物品等</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">種類・数量</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">使用場所</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">使用期間・時間</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">堆積・設置方法等</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="TallCell"><text:p/></table:table-cell><table:table-cell table:style-name="TallCell"><text:p/></table:table-cell><table:table-cell table:style-name="TallCell"><text:p/></table:table-cell><table:table-cell table:style-name="TallCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="TallCell"><text:p/></table:table-cell><table:table-cell table:style-name="TallCell"><text:p/></table:table-cell><table:table-cell table:style-name="TallCell"><text:p/></table:table-cell><table:table-cell table:style-name="TallCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="GrayCell"><text:p text:style-name="MainText">2</text:p><text:p text:style-name="Centered">管</text:p><text:p text:style-name="Centered">理</text:p><text:p text:style-name="Centered">の</text:p><text:p text:style-name="Centered">方</text:p><text:p text:style-name="Centered">法</text:p><text:p text:style-name="Centered">等</text:p></table:table-cell><table:table-cell table:number-columns-spanned="3" table:style-name="TallCell"><text:p/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
      </table:table>

      <text:p text:style-name="BreakPara"/>
      <text:p text:style-name="PageStart">別表 1</text:p>
      <text:p text:style-name="Title">日常の火災予防組織</text:p>
      <table:table table:name="日常の火災予防組織">
        <table:table-column table:style-name="ColTiny"/>
        <table:table-column table:style-name="ColMed"/>
        <table:table-column table:style-name="ColWide"/>
        <table:table-column table:style-name="ColMed"/>
        <table:table-column table:style-name="ColWide"/>
        <table:table-row><table:table-cell table:number-rows-spanned="2" table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">防火担当責任者</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">業　務</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">火元責任者</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">業　務</text:p></table:table-cell></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="TallCell"><text:p/></table:table-cell><table:table-cell table:style-name="TallCell"><text:p/></table:table-cell><table:table-cell table:style-name="TallCell"><text:p/></table:table-cell><table:table-cell table:style-name="TallCell"><text:p/></table:table-cell></table:table-row>
      </table:table>

      <text:p text:style-name="BreakPara"/>
      <text:p text:style-name="PageStart">別表 2</text:p>
      <text:p text:style-name="Title">日常の自主検査チェック表</text:p>
      <text:p text:style-name="RightSmall">月</text:p>
      <table:table table:name="日常の自主検査チェック表">
        <table:table-column table:style-name="ColTiny"/>
        <table:table-column table:style-name="ColTiny"/>
        <table:table-column table:style-name="ColCheck" table:number-columns-repeated="11"/>
        <table:table-column table:style-name="ColRemarks"/>
        <table:table-row>
          <table:table-cell table:number-rows-spanned="3" table:style-name="Cell"><text:p text:style-name="Centered">日</text:p></table:table-cell>
          <table:table-cell table:number-rows-spanned="3" table:style-name="Cell"><text:p text:style-name="Centered">曜</text:p><text:p text:style-name="Centered">日</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="11" table:style-name="Cell"><text:p text:style-name="Centered">検　査　項　目</text:p></table:table-cell>
          <table:table-cell table:number-rows-spanned="3" table:style-name="Cell"><text:p text:style-name="LeftSmall">備考</text:p><text:p/><text:p text:style-name="LeftSmall">○不備欠陥事項記入</text:p><text:p text:style-name="LeftSmall">○改修状況記入</text:p><text:p text:style-name="LeftSmall">○その他</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="3" table:style-name="Cell"><text:p/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="4" table:style-name="Cell"><text:p/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="4" table:style-name="Cell"><text:p/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">1</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:number-columns-repeated="11" table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">2</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:number-columns-repeated="11" table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">3</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:number-columns-repeated="11" table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">4</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:number-columns-repeated="11" table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-row>
