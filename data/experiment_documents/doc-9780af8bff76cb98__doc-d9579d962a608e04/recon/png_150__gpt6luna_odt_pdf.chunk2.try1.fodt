        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-row>
          <table:table-cell table:style-name="GrayCell" table:number-columns-spanned="3"><text:p><text:span text:style-name="Heading">１　消防用設備等</text:span></text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">種類・区域</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">支障を生じる期間</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">代替措置の概要</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="TallRow">
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="MediumRow">
          <table:table-cell table:style-name="GrayCell"><text:p text:style-name="Centered">２</text:p><text:p text:style-name="Centered">管理の方法等</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p/></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>

      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="Label">別紙２</text:p>
