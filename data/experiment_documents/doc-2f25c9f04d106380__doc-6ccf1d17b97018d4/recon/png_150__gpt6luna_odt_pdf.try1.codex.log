          </table:table-cell>
          <table:table-cell table:style-name="BorderCell">
            <text:p text:style-name="CellText">First approved version</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p/></table:table-cell>
