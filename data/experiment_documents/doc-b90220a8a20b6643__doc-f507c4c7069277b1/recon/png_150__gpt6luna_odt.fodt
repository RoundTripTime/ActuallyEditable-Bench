<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.08cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.05cm" fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-size="18pt"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0cm" fo:margin-bottom="0.05cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Heading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.12cm" fo:margin-bottom="0.08cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.04cm"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="Centered" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Bold" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.04cm"/>
      <style:text-properties fo:font-size="11pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="FrameCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.06cm solid #000000" fo:padding="0.18cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="ContactCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.12cm solid #000000" fo:padding="0.16cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.06cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="FrameTable" style:family="table">
      <style:table-properties style:rel-width="100%" table:align="center"/>
    </style:style>
    <style:style style:name="InnerTable" style:family="table">
      <style:table-properties style:rel-width="100%" table:align="center"/>
    </style:style>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="3.8cm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="4.5cm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="4.5cm"/>
    </style:style>
    <style:style style:name="ColD" style:family="table-column">
      <style:table-column-properties style:column-width="5.2cm"/>
    </style:style>
    <style:style style:name="ColFull" style:family="table-column">
      <style:table-column-properties style:column-width="18cm"/>
    </style:style>
    <style:style style:name="LabelTable" style:family="table">
      <style:table-properties style:width="2.1cm" table:align="right"/>
    </style:style>
    <style:style style:name="LabelCol" style:family="table-column">
      <style:table-column-properties style:column-width="2.1cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="0.8cm" fo:margin-bottom="0.8cm" fo:margin-left="1.2cm" fo:margin-right="1.2cm" style:print-orientation="portrait"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Master" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart"/>
      <table:table table:name="AppendixLabel" table:style-name="LabelTable">
        <table:table-column table:style-name="LabelCol"/>
        <table:table-row>
          <table:table-cell table:style-name="FrameCell"><text:p text:style-name="Centered">別紙１</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Title">春日部市民の日協賛事業申込書</text:p>
      <text:p text:style-name="Right">申込日　令和　年　月　日</text:p>
      <text:p text:style-name="Heading">＜春日部市民の日協賛事業　開催内容＞<text:span>※ご記入いただいた内容をもとに市ホームページ掲載情報を作成します。</text:span></text:p>
      <table:table table:name="EventFrame" table:style-name="FrameTable">
        <table:table-column table:style-name="ColFull"/>
        <table:table-row>
          <table:table-cell table:style-name="FrameCell">
            <text:p text:style-name="P">フリガナ</text:p>
            <table:table table:name="EventFields" table:style-name="InnerTable">
              <table:table-column table:style-name="ColA"/>
              <table:table-column table:style-name="ColB"/>
              <table:table-column table:style-name="ColC"/>
              <table:table-column table:style-name="ColD"/>
              <table:table-row>
                <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Heading">企業・団体等名称</text:p></table:table-cell>
                <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
              </table:table-row>
              <table:table-row>
                <table:table-cell table:style-name="Cell"><text:p text:style-name="Heading">事業名</text:p></table:table-cell>
                <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="P">例）春日部市民の日記念</text:p><text:p text:style-name="P">○○○セール</text:p></table:table-cell>
                <table:covered-table-cell/><table:covered-table-cell/>
              </table:table-row>
              <table:table-row>
                <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Small">※事業名に必ず「春日部市民の日記念」を入れてください</text:p></table:table-cell>
                <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
              </table:table-row>
              <table:table-row>
                <table:table-cell table:style-name="Cell"><text:p text:style-name="Heading">事業内容</text:p><text:p text:style-name="Small">※留意事項（先着○○名様限り、なくなり次第終了等）を記載してください。</text:p></table:table-cell>
                <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="P"></text:p><text:p text:style-name="P"></text:p><text:p text:style-name="P"></text:p></table:table-cell>
                <table:covered-table-cell/><table:covered-table-cell/>
              </table:table-row>
              <table:table-row>
                <table:table-cell table:style-name="Cell"><text:p text:style-name="Heading">開催日</text:p></table:table-cell>
                <table:table-cell table:style-name="Cell"><text:p text:style-name="P">月　　日（　）～</text:p></table:table-cell>
                <table:table-cell table:style-name="Cell"><text:p text:style-name="P">月　　日（　）</text:p></table:table-cell>
                <table:table-cell table:style-name="Cell"></table:table-cell>
              </table:table-row>
              <table:table-row>
                <table:table-cell table:style-name="Cell"><text:p text:style-name="Heading">開催時間</text:p></table:table-cell>
                <table:table-cell table:style-name="Cell"><text:p text:style-name="P">時　　分　　～</text:p></table:table-cell>
                <table:table-cell table:style-name="Cell"><text:p text:style-name="P">時　　分</text:p></table:table-cell>
                <table:table-cell table:style-name="Cell"></table:table-cell>
              </table:table-row>
              <table:table-row>
                <table:table-cell table:style-name="Cell"><text:p text:style-name="Heading">開催場所</text:p></table:table-cell>
                <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"></table:table-cell>
                <table:covered-table-cell/><table:covered-table-cell/>
              </table:table-row>
              <table:table-row>
                <table:table-cell table:style-name="Cell"><text:p text:style-name="Heading">市民からの問合せ先</text:p><text:p text:style-name="P">（電話番号）</text:p></table:table-cell>
                <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"></table:table-cell>
                <table:covered-table-cell/><table:covered-table-cell/>
              </table:table-row>
            </table:table>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Heading">＜申込者情報＞</text:p>
      <table:table table:name="ApplicantFrame" table:style-name="FrameTable">
        <table:table-column table:style-name="ColFull"/>
        <table:table-row>
          <table:table-cell table:style-name="FrameCell">
            <table:table table:name="ApplicantFields" table:style-name="InnerTable">
              <table:table-column table:style-name="ColA"/>
              <table:table-column table:style-name="ColB"/>
              <table:table-column table:style-name="ColC"/>
              <table:table-column table:style-name="ColD"/>
              <table:table-row>
                <table:table-cell table:style-name="Cell"><text:p text:style-name="P">担当者（フリガナ）</text:p></table:table-cell>
                <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="P">（　　　　　　　　　　　　　　）</text:p></table:table-cell>
                <table:covered-table-cell/><table:covered-table-cell/>
              </table:table-row>
              <table:table-row>
                <table:table-cell table:style-name="Cell"><text:p text:style-name="P">電話番号</text:p></table:table-cell>
                <table:table-cell table:style-name="Cell"></table:table-cell>
                <table:table-cell table:style-name="Cell"><text:p text:style-name="P">FAX番号</text:p></table:table-cell>
                <table:table-cell table:style-name="Cell"></table:table-cell>
              </table:table-row>
              <table:table-row>
                <table:table-cell table:style-name="Cell"><text:p text:style-name="P">メールアドレス</text:p></table:table-cell>
                <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"></table:table-cell>
                <table:covered-table-cell/><table:covered-table-cell/>
              </table:table-row>
              <table:table-row>
                <table:table-cell table:style-name="Cell"><text:p text:style-name="P">所在地</text:p></table:table-cell>
                <table:table-cell table:style-name="Cell"><text:p text:style-name="P">〒</text:p></table:table-cell>
                <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"></table:table-cell>
                <table:covered-table-cell/>
              </table:table-row>
              <table:table-row>
                <table:table-cell table:style-name="Cell"><text:p text:style-name="P">内容等確認方法</text:p></table:table-cell>
                <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Small">市のHP等掲載内容の確認方法について、ご希望の方法に○をつけてください</text:p><text:p text:style-name="P">メール　・　FAX</text:p></table:table-cell>
                <table:covered-table-cell/><table:covered-table-cell/>
              </table:table-row>
              <table:table-row>
                <table:table-cell table:style-name="Cell"><text:p text:style-name="P">事業PRの方法</text:p><text:p text:style-name="Small">※現段階でお考えのPR方法を教えてください。</text:p><text:p text:style-name="Small">※市のHP等は除く。</text:p><text:p text:style-name="Small">チェックを入れてください。</text:p></table:table-cell>
                <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="P">PR方法と時期</text:p><text:p text:style-name="P"></text:p><text:p text:style-name="P"></text:p><text:p text:style-name="P"></text:p></table:table-cell>
                <table:covered-table-cell/><table:covered-table-cell/>
              </table:table-row>
              <table:table-row>
                <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="P">□ 「春日部市民の日協賛事業募集要項」の内容を確認の上、協賛事業に申込みます。</text:p></table:table-cell>
                <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
              </table:table-row>
            </table:table>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <table:table table:name="ContactFrame" table:style-name="FrameTable">
        <table:table-column table:style-name="ColFull"/>
        <table:table-row>
          <table:table-cell table:style-name="ContactCell">
            <text:p text:style-name="Bold">お問い合わせ先：春日部市役所 シティセールス広報課 シティセールス推進担当</text:p>
            <text:p text:style-name="P">郵送先：〒344-8577 春日部市中央7-2-1　春日部市役所シティセールス広報課</text:p>
            <text:p text:style-name="P">電話番号：048-796-5985（直通）　※平日の8:30～17:15</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>