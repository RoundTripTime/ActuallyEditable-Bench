<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt" style:font-name="serif"/>
    </style:default-style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:text-align="center" fo:margin-bottom="0.4cm"/>
      <style:text-properties fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
    <style:style style:name="Bold" style:family="paragraph">
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="1.6cm" fo:margin-right="1.6cm" fo:margin-top="1.2cm" fo:margin-bottom="0.8cm"/>
    </style:page-layout>
    <style:style style:name="MainTable" style:family="table">
      <style:table-properties style:width="17.8cm" table:align="margins"/>
    </style:style>
    <style:style style:name="GridTable" style:family="table">
      <style:table-properties style:width="17.8cm" table:align="margins"/>
    </style:style>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="4.45cm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="4.45cm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="4.45cm"/>
    </style:style>
    <style:style style:name="ColD" style:family="table-column">
      <style:table-column-properties style:column-width="4.45cm"/>
    </style:style>
    <style:style style:name="Box" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0.12cm"/>
    </style:style>
    <style:style style:name="DottedBottom" style:family="table-cell">
      <style:table-cell-properties fo:border-left="0.75pt solid #000000" fo:border-right="0.75pt solid #000000" fo:border-top="0.75pt solid #000000" fo:border-bottom="0.5pt dotted #000000" fo:padding="0.12cm"/>
    </style:style>
    <style:style style:name="OuterTop" style:family="table-cell">
      <style:table-cell-properties fo:border-top="0.75pt solid #000000" fo:border-left="0.75pt solid #000000" fo:border-right="0.75pt solid #000000" fo:padding="0.12cm"/>
    </style:style>
    <style:style style:name="OuterLeft" style:family="table-cell">
      <style:table-cell-properties fo:border-left="0.75pt solid #000000" fo:padding="0.12cm"/>
    </style:style>
    <style:style style:name="OuterRight" style:family="table-cell">
      <style:table-cell-properties fo:border-right="0.75pt solid #000000" fo:padding="0.12cm"/>
    </style:style>
    <style:style style:name="OuterBottom" style:family="table-cell">
      <style:table-cell-properties fo:border-left="0.75pt solid #000000" fo:border-right="0.75pt solid #000000" fo:border-bottom="0.75pt solid #000000" fo:padding="0.12cm"/>
    </style:style>
    <style:style style:name="OuterLR" style:family="table-cell">
      <style:table-cell-properties fo:border-left="0.75pt solid #000000" fo:border-right="0.75pt solid #000000" fo:padding="0.12cm"/>
    </style:style>
    <style:style style:name="FooterBox" style:family="table-cell">
      <style:table-cell-properties fo:border="2pt solid #000000" fo:padding="0.18cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">春日部市民の日協賛事業申込書</text:p>
      <text:p text:style-name="Right">申込日　令和　年　月　日</text:p>
      <text:p>＜春日部市民の日協賛事業　開催内容＞<text:span text:style-name="Small">※ご記入いただいた内容をもとに市ホームページ掲載情報を作成します。</text:span></text:p>
      <table:table table:name="開催内容" table:style-name="MainTable">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColD"/>
        <table:table-row>
          <table:table-cell table:style-name="DottedBottom" table:number-columns-spanned="4"><text:p>フリガナ</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="OuterLeft" table:number-columns-spanned="4"><text:p>企業・団体等名称</text:p><text:p/><text:p>事業名</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="OuterLR"><text:p text:style-name="Small">例）春日部市民の日記念</text:p><text:p>○○○セール</text:p></table:table-cell>
          <table:table-cell table:style-name="OuterLR" table:number-columns-spanned="3"><text:p>※事業名に必ず「春日部市民の日記念」を入れてください</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="OuterLR" table:number-columns-spanned="4"><text:p>事業内容</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="OuterLeft" table:number-columns-spanned="4"><text:p>※留意事項（先着○○名様</text:p><text:p>　限り、なくなり次第終了</text:p><text:p>　等）を記載してください。</text:p><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="OuterLR"><text:p>開催日</text:p></table:table-cell>
          <table:table-cell table:style-name="OuterLR" table:number-columns-spanned="3"><text:p>月　　　日（　）～　　　月　　　日（　）</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="OuterLR"><text:p>開催時間</text:p></table:table-cell>
          <table:table-cell table:style-name="OuterLR" table:number-columns-spanned="3"><text:p>時　　　分　　～　　　時　　　分</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="OuterLR"><text:p>開催場所</text:p></table:table-cell>
          <table:table-cell table:style-name="OuterLR" table:number-columns-spanned="3"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="OuterBottom"><text:p>市民からの問合せ先</text:p><text:p text:style-name="Small">（電話番号）</text:p></table:table-cell>
          <table:table-cell table:style-name="OuterBottom" table:number-columns-spanned="3"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p/>
      <text:p>＜申込者情報＞</text:p>
      <table:table table:name="申込者情報" table:style-name="GridTable">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColD"/>
        <table:table-row>
          <table:table-cell table:style-name="Box" table:number-columns-spanned="2"><text:p>担当者（フリガナ）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Box" table:number-columns-spanned="2"><text:p>（　　　　　　　　　　　　　　）</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Box" table:number-columns-spanned="2"><text:p>電話番号</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Box" table:number-columns-spanned="2"><text:p>FAX番号</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Box" table:number-columns-spanned="4"><text:p>メールアドレス</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Box"><text:p>所在地</text:p></table:table-cell>
          <table:table-cell table:style-name="Box" table:number-columns-spanned="3"><text:p>〒</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Box"><text:p>内容等確認方法</text:p></table:table-cell>
          <table:table-cell table:style-name="Box" table:number-columns-spanned="3"><text:p text:style-name="Small">市のHP等掲載内容の確認方法について、ご希望の方法に○をつけてください</text:p><text:p text:style-name="Center">メール　・　FAX</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Box"><text:p>事業PRの方法</text:p><text:p text:style-name="Small">※現段階でお考えのPR方法を教えてください。</text:p><text:p text:style-name="Small">※市のHP等は除く。</text:p><text:p text:style-name="Small">チェックを入れてください。</text:p></table:table-cell>
          <table:table-cell table:style-name="Box" table:number-columns-spanned="3"><text:p>PR方法と時期</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Box" table:number-columns-spanned="4"><text:p>□ 「春日部市民の日協賛事業募集要項」の内容を確認の上、協賛事業に申込みます。</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p/>
      <table:table table:name="問い合わせ先" table:style-name="GridTable">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColD"/>
        <table:table-row>
          <table:table-cell table:style-name="FooterBox" table:number-columns-spanned="4">
            <text:p text:style-name="Bold">お問い合わせ先：春日部市役所 シティセールス広報課 シティセールス推進担当</text:p>
            <text:p>郵送先：〒344-8577 春日部市中央7-2-1　春日部市役所シティセールス広報課</text:p>
            <text:p>電話番号：048-796-5985（直通）　※平日の8:30～17:15</text:p>
          </table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>