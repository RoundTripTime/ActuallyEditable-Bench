<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:font-size="12pt" fo:line-height="140%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Date" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="end" fo:margin-top="2.3cm" fo:margin-bottom="1.1cm" fo:break-before="page"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:margin-left="0.8cm" fo:margin-bottom="1.3cm"/>
    </style:style>
    <style:style style:name="Applicant" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="center" fo:margin-left="6cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="1.5cm" fo:margin-bottom="1.3cm"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="Intro" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:margin-left="0.4cm" fo:margin-bottom="0.4cm"/>
    </style:style>
    <style:style style:name="CellText" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:line-height="125%"/>
      <style:text-properties fo:font-size="11.5pt"/>
    </style:style>
    <style:style style:name="CellLabel" style:family="paragraph" style:parent-style-name="CellText">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="paragraph" style:parent-style-name="CellText">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="DesignLine" style:family="paragraph" style:parent-style-name="CellText">
      <style:paragraph-properties fo:border-top="0.5pt dashed #000000" fo:padding-top="0.08cm"/>
    </style:style>
    <style:style style:name="Grid" style:family="table">
      <style:table-properties style:width="15.4cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="LeftColumn" style:family="table-column">
      <style:table-column-properties style:column-width="3.6cm"/>
    </style:style>
    <style:style style:name="RightColumn" style:family="table-column">
      <style:table-column-properties style:column-width="11.8cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellTop" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="RowShort" style:family="table-row">
      <style:table-row-properties style:min-row-height="1.0cm"/>
    </style:style>
    <style:style style:name="RowPurpose" style:family="table-row">
      <style:table-row-properties style:min-row-height="1.9cm"/>
    </style:style>
    <style:style style:name="RowDesign" style:family="table-row">
      <style:table-row-properties style:min-row-height="2.6cm"/>
    </style:style>
    <style:style style:name="RowContact" style:family="table-row">
      <style:table-row-properties style:min-row-height="1.1cm"/>
    </style:style>
    <style:style style:name="RowAttachments" style:family="table-row">
      <style:table-row-properties style:min-row-height="1.8cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="2.8cm" fo:margin-right="2.8cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Date">年　月　日</text:p>
      <text:p text:style-name="Recipient">一戸町長　様</text:p>
      <text:p text:style-name="Applicant">申請者　住　所</text:p>
      <text:p text:style-name="Applicant">団体等名称</text:p>
      <text:p text:style-name="Applicant">代表者氏名</text:p>
      <text:p text:style-name="Applicant">電話番号</text:p>
      <text:p text:style-name="Title">御所野遺跡世界遺産 PR キャラクターデザイン使用申請書</text:p>
      <text:p text:style-name="Intro">次のとおり、御所野遺跡世界遺産 PR キャラクターデザインを使用したいので</text:p>
      <text:p text:style-name="Intro">申請します。</text:p>
      <table:table table:name="申請書" table:style-name="Grid">
        <table:table-column table:style-name="LeftColumn"/>
        <table:table-column table:style-name="RightColumn"/>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellLabel">申　請　区　分</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTop">
            <text:p text:style-name="CellText">□ 新規　　□ 継続（前回承認番号：令和　年　月　日第</text:p>
            <text:p text:style-name="CellText">号）</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellLabel">使用対象物件</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="RowPurpose">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellLabel">使　用　目　的</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTop">
            <text:p text:style-name="CellText">・広報活動用　　・キャラクター商品製作販売使用</text:p>
            <text:p text:style-name="CellText">・商品等パッケージ使用</text:p>
            <text:p text:style-name="CellText">・その他（　　　　　　　　　　　　　　　　　　　　　　　　　　　）</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellLabel">使　用　内　容</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellLabel">使　用　方　法</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellLabel">使　用　期　間</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellCenter">年　　月　　日　　～　　年　　月　　日</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowDesign">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellLabel">使用デザイン</text:p><text:p text:style-name="CellLabel">（○で囲む）</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTop">
            <text:p text:style-name="CellText">・基本形　　・A　　・B　　・C　　・D　　・E　　・F　　・G</text:p>
            <text:p text:style-name="CellText">・H　　・I　　・J　　・K　　・L　　・M　　・N　　・O　　・P</text:p>
            <text:p text:style-name="DesignLine">・S1　　・S2　　・S3　　・S4　　・S5　　・S6　　・S7　　・S8　　・S9</text:p>
            <text:p text:style-name="CellText">・S10　　・S11　　・S12　　・S13　　・S14</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowContact">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellLabel">担当者連絡先</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTop">
            <text:p text:style-name="CellText">住所：　　　　　　　　電話番号：　　－　　－</text:p>
            <text:p text:style-name="CellText">※申請者と同一の場合、記入不要</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowAttachments">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellLabel">添　付　書　類</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTop">
            <text:p text:style-name="CellText">1　企画書、見本等（レイアウト、スケッチ、原稿等）</text:p>
            <text:p text:style-name="CellText">2　申請者の概要書</text:p>
            <text:p text:style-name="CellText">3　その他（　　　　　　　　　　　　　　　　　　　　　　　　　　　）</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>