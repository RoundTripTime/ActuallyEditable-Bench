<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Centered" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="RightAligned" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:text-align="right" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="1.25cm" fo:margin-bottom="1.25cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Intro" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.25cm" fo:margin-bottom="0.5cm" fo:text-indent="0.4cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="2.4cm" fo:margin-bottom="2.4cm" fo:margin-left="2.8cm" fo:margin-right="2.8cm"/>
    </style:page-layout>
    <style:style style:name="Table" style:family="table">
      <style:table-properties style:width="15.4cm"/>
    </style:style>
    <style:style style:name="LabelColumn" style:family="table-column">
      <style:table-column-properties style:column-width="3.6cm"/>
    </style:style>
    <style:style style:name="InputColumn" style:family="table-column">
      <style:table-column-properties style:column-width="11.8cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="LabelCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="DashedTopCell" style:family="table-cell">
      <style:table-cell-properties fo:border-left="0.5pt solid #000000" fo:border-right="0.5pt solid #000000" fo:border-bottom="0.5pt solid #000000" fo:border-top="0.5pt dashed #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">年　　月　　日</text:p>
      <text:p text:style-name="Body">一戸町長　様</text:p>
      <text:p text:style-name="Body">　</text:p>
      <text:p text:style-name="RightAligned">申請者　住所</text:p>
      <text:p text:style-name="RightAligned">団体等名称</text:p>
      <text:p text:style-name="RightAligned">代表者氏名</text:p>
      <text:p text:style-name="RightAligned">電話番号</text:p>
      <text:p text:style-name="Title">御所野遺跡世界遺産 PRキャラクターデザイン使用申請書</text:p>
      <text:p text:style-name="Intro">次のとおり、御所野遺跡世界遺産 PRキャラクターデザインを使用したいので</text:p>
      <text:p text:style-name="Intro">申請します。</text:p>
      <table:table table:name="申請書" table:style-name="Table">
        <table:table-column table:style-name="LabelColumn"/>
        <table:table-column table:style-name="InputColumn"/>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="Centered">申　請　区　分</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p>□ 新規　　□ 継続（前回承認番号：令和　年　月　日第</text:p>
            <text:p>号）</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="Centered">使用対象物件</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="Centered">使　用　目　的</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p>・広報活動用　　・キャラクター商品製作販売使用</text:p>
            <text:p>・商品等パッケージ使用</text:p>
            <text:p>・その他（　　　　　　　　　　　　　　　　　　　　　　　）</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="Centered">使　用　内　容</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="Centered">使　用　方　法</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="Centered">使　用　期　間</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="Centered">年　　　月　　　日　～　　　年　　　月　　　日</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell" table:number-rows-spanned="2">
            <text:p text:style-name="Centered">使用デザイン</text:p>
            <text:p text:style-name="Centered">（○で囲む）</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p>・基本形　　・Ａ　　・Ｂ　　・Ｃ　　・Ｄ　　・Ｅ　　・Ｆ　　・Ｇ</text:p>
            <text:p>・Ｈ　　・Ｉ　　・Ｊ　　・Ｋ　　・Ｌ　　・Ｍ　　・Ｎ　　・Ｏ　　・Ｐ</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="DashedTopCell">
            <text:p>・S1　　・S2　　・S3　　・S4　　・S5　　・S6　　・S7　　・S8　　・S9</text:p>
            <text:p>・S10　　・S11　　・S12　　・S13　　・S14</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="Centered">担当者連絡先</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p>住所：　　　　　　　　電話番号：　　　―　　　―</text:p>
            <text:p>※申請者と同一の場合、記入不要</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="Centered">添　付　書　類</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p>1　企画書、見本等（レイアウト、スケッチ、原稿等）</text:p>
            <text:p>2　申請者の概要書</text:p>
            <text:p>3　その他（　　　　　　　　　　　　　　　　　　　　　　　）</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>