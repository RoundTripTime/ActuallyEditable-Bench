  </rng:define>
  <rng:define name="style-master-page">
    <rng:element name="style:master-page">
      <rng:ref name="style-master-page-attlist"/>
      <rng:optional>
        <rng:ref name="style-header"/>
        <rng:optional>
          <rng:ref name="style-header-left"/>
        </rng:optional>
        <rng:optional>
          <rng:ref name="style-header-first"/>
