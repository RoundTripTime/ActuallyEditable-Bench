  <office:body>
    <office:text>
      <text:p text:style-name="StartPage">様式第１号（第５条関係）</text:p>
      <text:p text:style-name="Right">年　　月　　日</text:p>
      <text:p>青森市長　様</text:p>
      <text:p text:style-name="Center">青森市まち・ひと・しごと創生寄附活用事業に係る寄附申出書</text:p>
      <text:p>青森市の「　　　　　　　　　　　　　　　　　　　　　」を応援するため、下表のとおり</text:p>
      <text:p>寄附を申し出ます。</text:p>
      <table:table table:name="Form" table:style-name="FormTable">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-row>
          <table:table-cell table:style-name="Label" table:number-columns-spanned="2"><text:p text:style-name="LabelText">法人名</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="Label"/>
          <table:table-cell table:style-name="Input"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label" table:number-columns-spanned="2"><text:p text:style-name="LabelText">法人番号</text:p></table:table-cell>
