<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
                 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
                 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
                 xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
                 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
                 office:mimetype="application/vnd.oasis.opendocument.text"
                 office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:font-size="10.5pt"/>
      <style:text-properties style:font-name="MS Mincho" fo:font-size="10.5pt"/>
    </style:default-style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
    <style:style style:name="Date" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end" fo:margin-top="5mm" fo:margin-bottom="5mm"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="4mm" fo:margin-top="2mm" fo:margin-bottom="5mm"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-bottom="5mm"/>
    </style:style>
    <style:style style:name="Intro" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0mm"/>
    </style:style>
    <style:style style:name="SmallNote" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0mm" fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="2.5cm" fo:margin-bottom="2.2cm" fo:margin-left="2.5cm" fo:margin-right="2.5cm"/>
    </style:page-layout>
    <style:style style:name="TableStyle" style:family="table">
      <style:table-properties style:width="16cm" table:align="left" fo:margin-top="3mm" fo:margin-bottom="1mm"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="6.49cm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="4.5cm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="5.01cm"/>
    </style:style>
    <style:style style:name="Row50" style:family="table-row">
      <style:table-row-properties style:row-height="1.76cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="Row37" style:family="table-row">
      <style:table-row-properties style:row-height="1.31cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="Row51" style:family="table-row">
      <style:table-row-properties style:row-height="1.81cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="Row26" style:family="table-row">
      <style:table-row-properties style:row-height="0.92cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="Row49" style:family="table-row">
      <style:table-row-properties style:row-height="1.74cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="Row47" style:family="table-row">
      <style:table-row-properties style:row-height="1.66cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="Row73" style:family="table-row">
      <style:table-row-properties style:row-height="2.59cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="2mm" style:vertical-align="middle"/>
      <style:text-properties style:font-name="MS Gothic" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Label" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="2mm" fo:background-color="#ffbf00" style:vertical-align="middle"/>
      <style:text-properties style:font-name="MS Gothic" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="SmallLabel" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="1.5mm" fo:background-color="#ffbf00" style:vertical-align="middle"/>
      <style:text-properties style:font-name="MS Gothic" fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="Footnote" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties style:font-name="MS Mincho" fo:font-size="9.5pt"/>
    </style:style>
    <style:style style:name="CellText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties style:font-name="MS Mincho" fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="CenteredCell" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties style:font-name="MS Mincho" fo:font-size="10pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">様式第１号（第５条関係）</text:p>
      <text:p text:style-name="Date">年　　月　　日</text:p>
      <text:p text:style-name="Recipient">青森市長　様</text:p>
      <text:p text:style-name="Title">青森市まち・ひと・しごと創生寄附活用事業に係る寄附申出書</text:p>
      <text:p text:style-name="Intro">青森市の「<text:s text:c="18"/>」を応援するため、下表のとおり</text:p>
      <text:p text:style-name="Intro">寄附を申し出ます。</text:p>
      <table:table table:name="寄附申出書" table:style-name="TableStyle">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-row table:style-name="Row50">
          <table:table-cell table:style-name="Label"><text:p>法人名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="Row37">
          <table:table-cell table:style-name="Label"><text:p>法人番号</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="Row37">
          <table:table-cell table:style-name="Label"><text:p>代表者　役職・氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="Row51">
          <table:table-cell table:style-name="Label"><text:p>主たる事務所又は事業所の所在地</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>〒</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="Row26">
          <table:table-cell table:style-name="Label" table:number-rows-spanned="4"><text:p>連絡先</text:p></table:table-cell>
          <table:table-cell table:style-name="Label"><text:p>担当者　役職・氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="Row26">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Label"><text:p>電話番号</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="Row26">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Label"><text:p>ＦＡＸ番号</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="Row49">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Label"><text:p>受領証等送付先</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p>〒</text:p>
            <text:p text:style-name="CenteredCell">□　主たる事務所又は事業所の所在地に同じ</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="Row47">
          <table:table-cell table:style-name="SmallLabel">
            <text:p>寄附申出額</text:p>
            <text:p text:style-name="SmallNote">※１０万円以上かつ事業の実施に要する</text:p>
            <text:p text:style-name="SmallNote">　経費の範囲内の額となります。</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2">
            <text:p text:style-name="CenteredCell"><text:s text:c="17"/>円</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="Row73">
          <table:table-cell table:style-name="SmallLabel">
            <text:p>寄附状況の公表</text:p>
            <text:p text:style-name="SmallNote">※公表することに同意いただける項目に</text:p>
            <text:p text:style-name="SmallNote">　チェックをお願いします。</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2">
            <text:p>□　法人名</text:p>
            <text:p>□　所在地（※都道府県名まで）</text:p>
            <text:p>□　所在地（※市町村名まで）</text:p>
            <text:p>□　寄附の金額</text:p>
            <text:p>□　寄附を充てる対象事業及び事業年度</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="Row51">
          <table:table-cell table:style-name="SmallLabel">
            <text:p>寄附の申出窓口</text:p>
            <text:p text:style-name="SmallNote">※今回の寄附の申出を行った窓口について</text:p>
            <text:p text:style-name="SmallNote">　お知らせください。</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2">
            <text:p>□　受託者（　　　　　　銀行　　　　　支店）</text:p>
            <text:p>□　青森市</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Footnote">※青森市の区域内に主たる事務所又は事業所を有しない法人様からの寄附が対象となります。</text:p>
      <text:p text:style-name="Footnote">※寄附の納付は、事業の実施に要する経費（年度ごと）の確定後となります。</text:p>
      <text:p text:style-name="Footnote">※事業の実施に要する経費（年度ごと）の確定前に寄附の納付を希望する場合はご相談ください。</text:p>
      <text:p text:style-name="Footnote">※寄附の受領後、税額控除に必要となる受領証を送付します。</text:p>
      <text:p text:style-name="Footnote">※寄附を納付した日が属する事業年度において税額控除が適用されます。</text:p>
    </office:text>
  </office:body>
</office:document>