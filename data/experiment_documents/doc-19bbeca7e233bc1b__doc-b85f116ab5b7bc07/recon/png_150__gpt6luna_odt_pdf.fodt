<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:default-style>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="PB" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="1pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.1cm" fo:margin-bottom="0.2cm"/>
      <style:text-properties fo:font-size="16pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Head" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
    <style:style style:name="Grid" style:family="table">
      <style:table-properties style:width="19cm" table:align="margins"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="2.8cm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="4.7cm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="2cm"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties style:column-width="1.5cm"/>
    </style:style>
    <style:style style:name="Col5" style:family="table-column">
      <style:table-column-properties style:column-width="2cm"/>
    </style:style>
    <style:style style:name="Col6" style:family="table-column">
      <style:table-column-properties style:column-width="6cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellB" style:family="table-cell">
      <style:table-cell-properties fo:border="1.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Noborder" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0.05cm" style:vertical-align="middle"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.2cm" fo:margin-bottom="1.2cm" fo:margin-left="1.1cm" fo:margin-right="1.1cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PB"/>
      <text:p text:style-name="Small" fo:text-align="end">避難者カード【中国語（繁体）</text:p>
      <text:p text:style-name="Title">避難者卡（正面）【様式－7】</text:p>
      <text:p text:style-name="Head">填寫日　　年　　月　　日　　請每個家庭都填寫張。</text:p>
      <table:table table:name="正面上部" table:style-name="Grid">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-column table:style-name="Col5"/>
        <table:table-column table:style-name="Col6"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Head">避難日期</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Center">年　月　日　　點左右</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="3"><text:p>居住組 - No</text:p><text:p text:style-name="Center">―</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Head">避難場所</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Center">避　難　所　　・　　居　家　　・　　其　他　（</text:p><text:p text:style-name="Center">）</text:p><text:p text:style-name="Small">※在車內住宿避難者請填寫停車場的位置。</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Head">自治會名稱</text:p><text:p text:style-name="Head">　　　稱</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p>※如果未加入自治會，寫上 “未加入”</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <table:table table:name="正面名簿" table:style-name="Grid">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-column table:style-name="Col5"/>
        <table:table-column table:style-name="Col6"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">在避難所的人打圈</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">片假名讀音</text:p><text:p text:style-name="Center">姓 名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Head">年齡</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Head">性別</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Head">關係</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Head">備註※需要照顧者號碼以及需要照顧的地方</text:p></table:table-cell>
        </table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"><text:p>（代表者）</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>　　歳</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">男・女・その他</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"><text:p>　　歳</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">男・女・その他</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"><text:p>　　歳</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">男・女・その他</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"><text:p>　　歳</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">男・女・その他</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"><text:p>　　歳</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">男・女・その他</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Head">地址</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p>〒</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Small">代表者電話號碼</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p>（　　　　　　）</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Head">有無寵物</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p>有　　・　　無　　※選「有」的，請接著填寫寵物登記票。</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Head">需照顧者</text:p><text:p text:style-name="Small">※請在備註欄</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p>1 孕產婦　　2 嬰幼兒　　3 殘疾人</text:p><text:p>（　　　　　　　　　　　　　　）</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
      </table:table>

      <text:p text:style-name="PB"/>
      <table:table table:name="填寫所屬號碼" table:style-name="Grid">
        <table:table-column table:style-name="Col1"/><table:table-column table:style-name="Col2"/><table:table-column table:style-name="Col3"/><table:table-column table:style-name="Col4"/><table:table-column table:style-name="Col5"/><table:table-column table:style-name="Col6"/>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Head">填寫所屬號碼</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p>4 需要護理　　5 使用醫療機械（</text:p><text:p>　）</text:p><text:p>6 過敏徵（　　　　　　　　　）　　7 外國人（國籍　　　　　）</text:p><text:p>8 其他（　　　　　　　　　　　　）</text:p><text:p text:style-name="Small">※需照顧者指孕產婦、嬰幼兒、殘疾人等在避難生活中需要特別照顧的人士。</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
      </table:table>
      <text:p text:style-name="Title">避難者卡（背面）【様式-7】</text:p>
      <text:p text:style-name="Head">背面內容可等狀況安定後再填寫。</text:p>
      <table:table table:name="背面安否" table:style-name="Grid">
        <table:table-column table:style-name="Col1"/><table:table-column table:style-name="Col2"/><table:table-column table:style-name="Col3"/><table:table-column table:style-name="Col4"/><table:table-column table:style-name="Col5"/><table:table-column table:style-name="Col6"/>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="6"><text:p>為了確認安否而公開信息（請選「希望」「不希望」的任意壹個，並打○。）</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p>您同意通過網頁或報道機構等公開避難者（您的）信息嗎？</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>希望・不希望</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p>當親戚、同個住所的人、朋友問及您的安否時，您同意提供避難者（您的）信息嗎？</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>希望・不希望</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-rows-spanned="2"><text:p text:style-name="Head">房屋受災狀況</text:p><text:p>※請在該當的選項上畫圈。</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p>有　　・　　無　　※選 “有” 後，請詳細填寫住房受害狀況。</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p>※填寫例</text:p><text:p>・房子倒塌，近期內無法居住。</text:p><text:p>・室內收拾好後，可以回去居住。</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>停電　　停水　　煤氣斷了　　電話不通</text:p><text:p>其他（　　　　　　　　　　　　　　　）</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="6"><text:p text:style-name="Head">傷病者信息</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="6"><text:p>請填寫姓名和具體的負傷、疾病狀況。</text:p><text:p/><text:p/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>收容場所</text:p><text:p>（送往機構）</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>收容場所信息</text:p><text:p>（送往機構地址）</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="6"><text:p>特記事項（如果有有種資格等，可以提供合作的人士，請填寫姓名和內容。）</text:p><text:p/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
      </table:table>
      <text:p>＜避難所運營委員會填寫欄＞</text:p>
      <table:table table:name="運營委員填寫欄" table:style-name="Grid">
        <table:table-column table:style-name="Col1"/><table:table-column table:style-name="Col2"/><table:table-column table:style-name="Col3"/><table:table-column table:style-name="Col4"/><table:table-column table:style-name="Col5"/><table:table-column table:style-name="Col6"/>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="6"><text:p/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
      </table:table>

      <text:p text:style-name="PB"/>
      <table:table table:name="退所欄" table:style-name="Grid">
        <table:table-column table:style-name="Col1"/><table:table-column table:style-name="Col2"/><table:table-column table:style-name="Col3"/><table:table-column table:style-name="Col4"/><table:table-column table:style-name="Col5"/><table:table-column table:style-name="Col6"/>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>退所年月日</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p>年　月　日</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>退出後去向</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p/></table:table-cell><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>電話</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p/></table:table-cell><table:covered-table-cell/></table:table-row>
      </table:table>
      <text:p>※為了避難所能順利運作，也請避難者（也包含在家避難及在車上避難的民眾），在可以的能力範圍內協助避難所營運。</text:p>
    </office:text>
  </office:body>
</office:document>