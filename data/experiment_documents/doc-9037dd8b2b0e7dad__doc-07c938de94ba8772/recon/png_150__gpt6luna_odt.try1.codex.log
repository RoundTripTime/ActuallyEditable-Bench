  <rng:define name="CURIE">
    <rng:data type="string">
      <rng:param name="pattern">(([\i-[:]][\c-[:]]*)?:)?.+</rng:param>
      <rng:param name="minLength">1</rng:param>
    </rng:data>
  </rng:define>
  <rng:define name="CURIEs">
    <rng:list>
      <rng:oneOrMore>
        <rng:ref name="CURIE"/>
      </rng:oneOrMore>
    </rng:list>
  </rng:define>
  <rng:define name="ID">
    <rng:data type="ID"/>
  </rng:define>
