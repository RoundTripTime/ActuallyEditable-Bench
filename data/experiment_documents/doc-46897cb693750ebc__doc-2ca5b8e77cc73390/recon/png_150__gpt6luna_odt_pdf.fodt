<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:font-size="10.5pt" fo:line-height="1.25"/>
      <style:text-properties fo:font-size="10.5pt" style:font-name="MS Mincho"/>
    </style:style>
    <style:style style:name="CenterTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-bottom="24pt"/>
      <style:text-properties fo:font-size="18pt" fo:font-weight="bold" style:font-name="MS Mincho"/>
    </style:style>
    <style:style style:name="RightText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right"/>
      <style:text-properties fo:font-size="10.5pt" style:font-name="MS Mincho"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="4pt" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="50pt"/>
      <style:text-properties fo:font-size="10.5pt" style:font-name="MS Mincho"/>
    </style:style>
    <style:style style:name="Agenda" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="12pt" fo:margin-top="8pt" fo:margin-bottom="8pt"/>
      <style:text-properties fo:font-size="10.5pt" style:font-name="MS Mincho"/>
    </style:style>
    <style:style style:name="Signature" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="120pt" fo:margin-top="20pt"/>
      <style:text-properties fo:font-size="10.5pt" style:font-name="MS Mincho"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="2.1cm" fo:margin-right="2.1cm" fo:margin-top="2.1cm" fo:margin-bottom="2.1cm"/>
    </style:page-layout>
    <style:style style:name="ColNumber" style:family="table-column">
      <style:table-column-properties style:column-width="0.95cm"/>
    </style:style>
    <style:style style:name="ColLabel" style:family="table-column">
      <style:table-column-properties style:column-width="3cm"/>
    </style:style>
    <style:style style:name="ColInput" style:family="table-column">
      <style:table-column-properties style:column-width="13.1cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Body">書式第７号（法第１０条関係）</text:p>
      <text:p text:style-name="RightText">設　立　用</text:p>
      <text:p text:style-name="CenterTitle">設立総会議事録</text:p>
      <table:table table:name="Form">
        <table:table-column table:style-name="ColNumber"/>
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColInput"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">1</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">法人名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">特定非営利活動法人________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">2</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">日付</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">3</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">時間</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">4</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">場所</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">5</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">出席者数</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">6</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">出席者氏名</text:p><text:p text:style-name="Body">以下、敬称略</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">7</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">審議事項</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="Agenda">(1)</text:p>
            <text:p text:style-name="Agenda">(2)</text:p>
            <text:p text:style-name="Agenda">(3)</text:p>
            <text:p text:style-name="Agenda">(4)</text:p>
            <text:p text:style-name="Agenda">(5)</text:p>
            <text:p text:style-name="Agenda">(6)</text:p>
            <text:p text:style-name="Agenda">(7)</text:p>
            <text:p text:style-name="Agenda">(8)</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">8</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">議長選任</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageStart">9　議事の経過の概要及び議決の結果</text:p>
      <text:p text:style-name="Agenda">(1)</text:p>
      <text:p text:style-name="Agenda">(2)</text:p>
      <text:p text:style-name="Agenda">(3)</text:p>
      <text:p text:style-name="Agenda">(4)</text:p>
      <text:p text:style-name="Agenda">(5)</text:p>
      <text:p text:style-name="Agenda">(6)</text:p>
      <text:p text:style-name="Agenda">(7)</text:p>
      <text:p text:style-name="Agenda">(8)</text:p>
      <text:p text:style-name="Body">１０　議事録署名人の選任に関する事項</text:p>
      <text:p text:style-name="Body"><text:s text:c="4"/>以上、この議事録が正確であることを証します。</text:p>
      <text:p text:style-name="Signature">認　　証　　日　　　年　　　月　　　日</text:p>
      <text:p text:style-name="Signature">議　　　　長</text:p>
      <text:p text:style-name="Signature">議　事　録　署　名　人</text:p>
      <text:p text:style-name="Signature">議　事　録　署　名　人</text:p>
    </office:text>
  </office:body>
</office:document>