<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Standard" style:family="paragraph">
      <style:paragraph-properties fo:font-size="11pt" fo:line-height="120%"/>
      <style:text-properties fo:font-size="11pt" style:font-family="serif"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="1.2mm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:margin="0mm" fo:line-height="120%"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="1mm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center" fo:margin="0mm" fo:line-height="120%"/>
    </style:style>
    <style:style style:name="PlainCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="1mm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:margin="0mm" fo:line-height="120%"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" fo:margin-left="17mm" fo:margin-right="17mm" fo:margin-top="17mm" fo:margin-bottom="17mm" fo:border="0.5pt solid #000000"/>
    </style:page-layout>
    <style:style style:name="HeaderRow" style:family="table-row">
      <style:table-row-properties fo:min-row-height="10mm"/>
    </style:style>
    <style:style style:name="ShortRow" style:family="table-row">
      <style:table-row-properties fo:min-row-height="9mm"/>
    </style:style>
    <style:style style:name="LongRow" style:family="table-row">
      <style:table-row-properties fo:min-row-height="9.5mm"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="3mm" fo:margin-bottom="8mm" fo:line-height="130%"/>
      <style:text-properties fo:font-size="18pt" fo:font-weight="bold" style:font-family="serif"/>
    </style:style>
    <style:style style:name="FormNumber" style:family="paragraph">
      <style:paragraph-properties fo:margin="0mm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="10pt" style:font-family="serif"/>
    </style:style>
    <style:style style:name="BoxText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin="0mm" fo:line-height="160%"/>
      <style:text-properties fo:font-size="16pt" fo:font-weight="bold" style:font-family="serif"/>
    </style:style>
    <style:style style:name="TableText" style:family="paragraph">
      <style:paragraph-properties fo:margin="0mm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="11pt" style:font-family="serif"/>
    </style:style>
    <style:style style:name="ItemLine" style:family="paragraph">
      <style:paragraph-properties fo:margin="0mm" fo:line-height="9.5mm"/>
      <style:text-properties fo:font-size="11pt" style:font-family="serif"/>
    </style:style>
    <style:style style:name="PageTwoStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="5mm" fo:margin-bottom="3mm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="12pt" style:font-family="serif"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="4mm" fo:margin-bottom="3mm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="12pt" style:font-family="serif"/>
    </style:style>
    <style:style style:name="ListLine" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="2mm" fo:margin-top="0mm" fo:margin-bottom="0mm" fo:line-height="10mm"/>
      <style:text-properties fo:font-size="11pt" style:font-family="serif"/>
    </style:style>
    <style:style style:name="Certify" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="8mm" fo:margin-bottom="7mm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="11pt" style:font-family="serif"/>
    </style:style>
    <style:style style:name="SigRow" style:family="table-row">
      <style:table-row-properties fo:min-row-height="11mm"/>
    </style:style>
    <style:style style:name="SigLabel" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin="0mm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="11pt" style:font-family="serif"/>
    </style:style>
    <style:style style:name="PrimaryTable" style:family="table">
      <style:table-properties style:width="176mm" table:align="margins"/>
    </style:style>
    <style:style style:name="HeaderTable" style:family="table">
      <style:table-properties style:width="176mm" table:align="margins"/>
    </style:style>
    <style:style style:name="BoxCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="1mm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center" fo:margin="0mm"/>
    </style:style>
    <style:style style:name="SigTable" style:family="table">
      <style:table-properties style:width="150mm" table:align="center"/>
    </style:style>
    <style:style style:name="NumCol" style:family="table-column">
      <style:table-column-properties style:column-width="10mm"/>
    </style:style>
    <style:style style:name="LabelCol" style:family="table-column">
      <style:table-column-properties style:column-width="30mm"/>
    </style:style>
    <style:style style:name="InputCol" style:family="table-column">
      <style:table-column-properties style:column-width="136mm"/>
    </style:style>
    <style:style style:name="HeadLeftCol" style:family="table-column">
      <style:table-column-properties style:column-width="120mm"/>
    </style:style>
    <style:style style:name="HeadRightCol" style:family="table-column">
      <style:table-column-properties style:column-width="56mm"/>
    </style:style>
    <style:style style:name="SigCol" style:family="table-column">
      <style:table-column-properties style:column-width="30mm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="StandardPage" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <table:table table:name="Header" table:style-name="HeaderTable">
        <table:table-column table:style-name="HeadLeftCol"/>
        <table:table-column table:style-name="HeadRightCol"/>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="PlainCell">
            <text:p text:style-name="FormNumber">書式第７号（法第１０条関係）</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="BoxCell">
            <text:p text:style-name="BoxText">設　立　用</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Title">設立総会議事録</text:p>
      <table:table table:name="設立総会議事録" table:style-name="PrimaryTable">
        <table:table-column table:style-name="NumCol"/>
        <table:table-column table:style-name="LabelCol"/>
        <table:table-column table:style-name="InputCol"/>
        <table:table-row table:style-name="ShortRow">
          <table:table-cell table:style-name="CellCenter"><text:p text:style-name="TableText">1</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">法人名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">特定非営利活動法人＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ShortRow">
          <table:table-cell table:style-name="CellCenter"><text:p text:style-name="TableText">2</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">日付</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ShortRow">
          <table:table-cell table:style-name="CellCenter"><text:p text:style-name="TableText">3</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">時間</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ShortRow">
          <table:table-cell table:style-name="CellCenter"><text:p text:style-name="TableText">4</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">場所</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ShortRow">
          <table:table-cell table:style-name="CellCenter"><text:p text:style-name="TableText">5</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">出席者数</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ShortRow">
          <table:table-cell table:style-name="CellCenter"><text:p text:style-name="TableText">6</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="TableText">出席者氏名</text:p>
            <text:p text:style-name="TableText">以下、敬称略</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="LongRow">
          <table:table-cell table:style-name="CellCenter" table:number-rows-spanned="8"><text:p text:style-name="TableText">7</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="8"><text:p text:style-name="TableText">審議事項</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="ItemLine">(1)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="LongRow">
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="ItemLine">(2)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="LongRow">
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="ItemLine">(3)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="LongRow">
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="ItemLine">(4)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="LongRow">
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="ItemLine">(5)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="LongRow">
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="ItemLine">(6)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="LongRow">
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="ItemLine">(7)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="LongRow">
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="ItemLine">(8)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ShortRow">
          <table:table-cell table:style-name="CellCenter"><text:p text:style-name="TableText">8</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">議長選任</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageTwoStart">９　議事の経過の概要及び議決の結果</text:p>
      <text:p text:style-name="ListLine">(1)</text:p>
      <text:p text:style-name="ListLine">(2)</text:p>
      <text:p text:style-name="ListLine">(3)</text:p>
      <text:p text:style-name="ListLine">(4)</text:p>
      <text:p text:style-name="ListLine">(5)</text:p>
      <text:p text:style-name="ListLine">(6)</text:p>
      <text:p text:style-name="ListLine">(7)</text:p>
      <text:p text:style-name="ListLine">(8)</text:p>
      <text:p text:style-name="Section">１０　議事録署名人の選任に関する事項</text:p>
      <text:p text:style-name="Certify">以上、この議事録が正確であることを証します。</text:p>
      <table:table table:name="署名欄" table:style-name="SigTable">
        <table:table-column table:style-name="SigCol"/>
        <table:table-column table:style-name="SigCol"/>
        <table:table-column table:style-name="SigCol"/>
        <table:table-column table:style-name="SigCol"/>
        <table:table-column table:style-name="SigCol"/>
        <table:table-row table:style-name="SigRow">
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="SigLabel">確　認</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="SigLabel">日</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="SigLabel">年</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="SigLabel">月</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="SigLabel">日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="SigRow">
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="SigLabel">議</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="SigLabel">長</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="SigRow">
          <table:table-cell table:style-name="PlainCell" table:number-columns-spanned="5"><text:p text:style-name="SigLabel">議　事　録　署　名　人</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="SigRow">
          <table:table-cell table:style-name="PlainCell" table:number-columns-spanned="5"><text:p text:style-name="SigLabel">議　事　録　署　名　人</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>