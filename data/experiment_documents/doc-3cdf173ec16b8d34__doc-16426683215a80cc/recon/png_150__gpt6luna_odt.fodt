<?xml version="1.0" encoding="UTF-8"?>
<office:document
    xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
    xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
    xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
    xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
    office:mimetype="application/vnd.oasis.opendocument.text"
    office:version="1.4">
  <office:styles>
    <style:style style:name="Default" style:family="paragraph">
      <style:paragraph-properties fo:font-size="10pt"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.3in" fo:margin-bottom="0.35in"/>
      <style:text-properties fo:font-size="22pt"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
    <style:style style:name="Centered" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="RightAligned" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="1.65cm" fo:margin-right="1.65cm" fo:margin-top="1.8cm" fo:margin-bottom="1.8cm"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties table:align="margins" style:width="17.7cm"/>
    </style:style>
    <style:style style:name="FormColumnLabel" style:family="table-column">
      <style:table-column-properties style:column-width="4.4cm"/>
    </style:style>
    <style:style style:name="FormColumnBody" style:family="table-column">
      <style:table-column-properties style:column-width="13.3cm"/>
    </style:style>
    <style:style style:name="FormCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.1cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="FormLabelCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.1cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="NoteText" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.3cm" fo:margin-bottom="0.05cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p>第 １ 号様式（第６条関係）</text:p>
      <text:p text:style-name="Title">事業計画概要書</text:p>
      <text:p text:style-name="RightAligned">年　　　月　　　日</text:p>
      <text:p>大府市長殿</text:p>
      <text:p text:style-name="RightAligned">住所</text:p>
      <text:p text:style-name="RightAligned">氏名</text:p>
      <text:p text:style-name="RightAligned">（法人その他の団体にあっては、事務所又は事業所の所在地、名称及び代表者の氏名）</text:p>
      <text:p>大府市開発等事業の手続及び基準等に関する条例第９条第１項の規定により、事業計画概要書を提出します。</text:p>
      <table:table table:name="事業計画概要" table:style-name="FormTable">
        <table:table-column table:style-name="FormColumnLabel"/>
        <table:table-column table:style-name="FormColumnBody"/>
        <table:table-row>
          <table:table-cell table:style-name="FormLabelCell"><text:p>事 業 区 域 の 位 置</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p>大府市</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormLabelCell"><text:p>事 業 区 域 の 面 積</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="RightAligned">平方メートル</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormLabelCell"><text:p>都 市 計 画 区 域 及 び 用 途 地 域</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p>市街化区域（用途地域　　　　　　　　　　　　　　）・ 市街化調整区域</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormLabelCell"><text:p>事 業 の 目 的</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormLabelCell"><text:p>予定建築物の用途</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormLabelCell"><text:p>予定区画数・戸数</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="RightAligned">区画・　　　　　　　　　　　　　　　戸</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormLabelCell"><text:p>予 定 建 築 物</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p>構　　　造　　　　　　　　　　　　　　　　造　　　建築面積　　　　　　　　　　㎡</text:p>
            <text:p>高　　　さ　　　　　　　　　　　　　　　　ｍ　　　延べ床面積　　　　　　　　㎡</text:p>
            <text:p>階　　　数　　　地上　　階・地下　　階　　　棟　　　数　　　　　　　　　棟</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormLabelCell"><text:p>付 属 建 築 物</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p>有（倉庫・駐車場・駐輪場・物置・その他（　　　　　））・無</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormLabelCell"><text:p>造 成 計 画 概 要</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p>切土高さ　　　　　　　ｍ・盛土高さ　　　　　　　ｍ</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormLabelCell"><text:p>排 水 計 画 概 要</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p>雨水放流先（側溝・水路・その他（　　　　　　　　））</text:p>
            <text:p>汚水及び雑排水放流先（公共下水・浄化槽・その他（　　　　　　　　））</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormLabelCell"><text:p>公 共 施 設 の 設 置</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p>有（公園・道路・水路・調整池・その他（　　　　　））・無</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormLabelCell"><text:p>ご み 置 場 の 設 置</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p>有（　　　ヶ所・有効面積　　　　　　㎡）・無</text:p></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="PageStart"/>
      <table:table table:name="続き" table:style-name="FormTable">
        <table:table-column table:style-name="FormColumnLabel"/>
        <table:table-column table:style-name="FormColumnBody"/>
        <table:table-row>
          <table:table-cell table:style-name="FormLabelCell"><text:p>設 備 機 器 の 設 置</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p>有（キュービクル・受水槽・その他（　　　　　　　　））・無</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormLabelCell"><text:p>工 事 予 定 期 間</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">年　　　月　　　日　から　　　年　　　月　　　日まで</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormLabelCell"><text:p>工 事 実 施 日</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">平日・土曜日・日曜日・祝日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormLabelCell"><text:p>工 事 時 間</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Centered">（午前・午後）　　時　　分から（午前・午後）　　時　　分まで</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormLabelCell"><text:p>安 全 対 策</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p>・事業区域及び周辺の事故防止や近隣住民等への安全対策等について</text:p>
            <text:p>　</text:p>
            <text:p>・振動、騒音等の防止対策について</text:p>
            <text:p>　</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormLabelCell"><text:p>公 害 防 止 対 策</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p>（予定建築物の用途に住宅が含まれない場合のみ記入）</text:p>
            <text:p>・予定建築物からの排水、騒音、振動、火災等の対策について</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormLabelCell"><text:p>電 波 障 害 対 応</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p>・調査方法や建物完成後に影響があった場合の対応について</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormLabelCell"><text:p>連 絡 先</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p>（事業者代理人）</text:p>
            <text:p>　住所</text:p>
            <text:p>　氏名</text:p>
            <text:p>　電話（　　　　　　　　　）　　　―</text:p>
            <text:p>（工事施行者担当）</text:p>
            <text:p>　住所</text:p>
            <text:p>　氏名</text:p>
            <text:p>　電話（　　　　　　　　　）　　　―</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormLabelCell"><text:p>そ の 他</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="PageStart"/>
      <table:table table:name="添付図書と受付印">
        <table:table-column table:style-name="FormColumnBody"/>
        <table:table-column table:style-name="FormColumnLabel"/>
        <table:table-row>
          <table:table-cell table:style-name="FormCell">
            <text:p>※事業計画概要書には、以下の図書を添付してください。</text:p>
            <text:p>・事業区域位置図</text:p>
            <text:p>・現況図及び現況写真</text:p>
            <text:p>・土地利用計画図、造成計画平面図及び排水施設計画平面図</text:p>
            <text:p>・予定建築物の平面図及び立面図</text:p>
            <text:p>・工事車両の搬出入経路図</text:p>
            <text:p>・建築基準法第56条の２に規定する日影図（予定建築物の高さが10メートルを超える場合に限る。）</text:p>
            <text:p>・電波障害調査報告書（予定建築物の高さが10メートルを超える場合に限る。）</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="Centered">受付印</text:p>
            <text:p>　</text:p>
            <text:p>　</text:p>
            <text:p>　</text:p>
            <text:p>　</text:p>
            <text:p>　</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>