<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Default" style:family="paragraph">
      <style:paragraph-properties fo:line-height="115%"/>
      <style:text-properties style:font-name="Noto Serif CJK JP" fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.6cm" fo:margin-bottom="0.5cm"/>
      <style:text-properties style:font-name="Noto Serif CJK JP" fo:font-size="22pt"/>
    </style:style>
    <style:style style:name="Centered" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:line-height="1pt" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="1pt"/>
    </style:style>
    <style:style style:name="PlainTable" style:family="table">
      <style:table-properties style:width="100%" table:align="margins"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.12cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellSmall" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Label" style:family="table-cell" style:parent-style-name="Cell">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="LabelSmall" style:family="table-cell" style:parent-style-name="CellSmall">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="StampCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.2cm" style:vertical-align="top"/>
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="MainLabelColumn" style:family="table-column">
      <style:table-column-properties fo:column-width="5.3cm"/>
    </style:style>
    <style:style style:name="MainValueColumn" style:family="table-column">
      <style:table-column-properties fo:column-width="12.4cm"/>
    </style:style>
    <style:style style:name="DetailA" style:family="table-column">
      <style:table-column-properties fo:column-width="2.4cm"/>
    </style:style>
    <style:style style:name="DetailB" style:family="table-column">
      <style:table-column-properties fo:column-width="2.8cm"/>
    </style:style>
    <style:style style:name="DetailC" style:family="table-column">
      <style:table-column-properties fo:column-width="5.2cm"/>
    </style:style>
    <style:style style:name="DetailD" style:family="table-column">
      <style:table-column-properties fo:column-width="3.1cm"/>
    </style:style>
    <style:style style:name="DetailE" style:family="table-column">
      <style:table-column-properties fo:column-width="4.2cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.8cm" fo:margin-bottom="1.8cm" fo:margin-left="1.65cm" fo:margin-right="1.65cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p>第１号様式（第６条関係）</text:p>
      <text:p text:style-name="Title">事業計画概要書</text:p>
      <text:p text:style-name="Right">年　　　月　　　日</text:p>
      <text:p>大府市長殿</text:p>
      <text:p text:style-name="Right">住所</text:p>
      <text:p text:style-name="Right">氏名</text:p>
      <text:p text:style-name="Right">（法人その他の団体にあっては、事務所又は事業所の所在地、名称及び代表者の氏名）</text:p>
      <text:p>大府市開発等事業の手続及び基準等に関する条例第９条第１項の規定により、事業計画概要書を提出します。</text:p>
      <table:table table:name="FormPage1" table:style-name="PlainTable">
        <table:table-column table:style-name="MainLabelColumn"/>
        <table:table-column table:style-name="MainValueColumn"/>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p>事業区域の位置</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>大府市</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p>事業区域の面積</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">平方メートル</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p>都市計画区域</text:p><text:p>及び用途地域</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>市街化区域（用途地域　　　　　　　　　）・　市街化調整区域</text:p><text:p>域</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p>事業の目的</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p>予定建築物の用途</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p>予定区画数・戸数</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">区画・　　　　　　　　　戸</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p>予定建築物</text:p></table:table-cell>
          <table:table-cell table:style-name="CellSmall">
            <table:table table:name="BuildingDetails" table:style-name="PlainTable">
              <table:table-column table:style-name="DetailA"/>
              <table:table-column table:style-name="DetailB"/>
              <table:table-column table:style-name="DetailC"/>
              <table:table-column table:style-name="DetailD"/>
              <table:table-column table:style-name="DetailE"/>
              <table:table-row>
                <table:table-cell table:style-name="LabelSmall"><text:p>構造</text:p></table:table-cell>
                <table:table-cell table:style-name="LabelSmall"><text:p>造</text:p></table:table-cell>
                <table:table-cell table:style-name="CellSmall"/>
                <table:table-cell table:style-name="LabelSmall"><text:p>建築面積</text:p></table:table-cell>
                <table:table-cell table:style-name="CellSmall"><text:p text:style-name="Right">㎡</text:p></table:table-cell>
              </table:table-row>
              <table:table-row>
                <table:table-cell table:style-name="LabelSmall"><text:p>高さ</text:p></table:table-cell>
                <table:table-cell table:style-name="CellSmall"><text:p text:style-name="Right">ｍ</text:p></table:table-cell>
                <table:table-cell table:style-name="LabelSmall"><text:p>延べ床面積</text:p></table:table-cell>
                <table:table-cell table:style-name="CellSmall"><text:p text:style-name="Right">㎡</text:p></table:table-cell>
                <table:table-cell table:style-name="CellSmall"/>
              </table:table-row>
              <table:table-row>
                <table:table-cell table:style-name="LabelSmall"><text:p>階数</text:p></table:table-cell>
                <table:table-cell table:style-name="CellSmall" table:number-columns-spanned="2"><text:p>地上　　階・地下　　階</text:p></table:table-cell>
                <table:covered-table-cell/>
                <table:table-cell table:style-name="LabelSmall"><text:p>棟数</text:p></table:table-cell>
                <table:table-cell table:style-name="CellSmall"><text:p text:style-name="Right">棟</text:p></table:table-cell>
              </table:table-row>
            </table:table>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p>付属建築物</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>有（倉庫・駐車場・駐輪場・物置・その他（　　　））・</text:p><text:p>無</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p>造成計画概要</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>切土高さ　　　　　ｍ・盛土高さ　　　　　ｍ</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p>排水計画概要</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>雨水放流先（側溝・水路・その他（　　　　　　　））</text:p><text:p>汚水及び雑排水放流先（公共下水・浄化槽・その他（</text:p><text:p>　　　））</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p>公共施設の設置</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>有（公園・道路・水路・調整池・その他（　　　））・</text:p><text:p>無</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p>ごみ置場の設置</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>有（　　　ヶ所・有効面積　　　　　㎡）・無</text:p></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="PageBreak"/>
      <table:table table:name="FormPage2" table:style-name="PlainTable">
        <table:table-column table:style-name="MainLabelColumn"/>
        <table:table-column table:style-name="MainValueColumn"/>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p>設備機器の設置</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>有（キュービクル・受水槽・その他（　　　　　　　））・</text:p><text:p>無</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p>工事予定期間</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">年　　　月　　　日　から　　　年　　　月　　　日まで</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p>工事実施日</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">平日・土曜日・日曜日・祝日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p>工事時間</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">（午前・午後）　　時　　分から（午前・午後）　　時</text:p><text:p text:style-name="Centered">分まで</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p>安全対策</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p>・事業区域及び周辺の事故防止や近隣住民等への安全対策</text:p>
            <text:p>等について</text:p>
            <text:p/>
            <text:p>・振動、騒音等の防止対策について</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p>公害防止対策</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p>（予定建築物の用途に住宅が含まれない場合のみ記入）</text:p>
            <text:p>・予定建築物からの排水、騒音、振動、火災等の対策につ</text:p>
            <text:p>いて</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p>電波障害対応</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>・調査方法や建物完成後に影響があった場合の対応につい</text:p><text:p>て</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p>連絡先</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p>（事業者代理人）</text:p>
            <text:p>　住所</text:p>
            <text:p>　氏名</text:p>
            <text:p>　電話（　　　　　　　　　）　　―</text:p>
            <text:p>（工事施行者担当）</text:p>
            <text:p>　住所</text:p>
            <text:p>　氏名</text:p>
            <text:p>　電話（　　　　　　　　　）　　―</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p>その他</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>

      <text:p text:style-name="PageBreak"/>
      <table:table table:name="AttachmentsAndStamp" table:style-name="PlainTable">
        <table:table-column table:style-name="DetailC"/>
        <table:table-column table:style-name="DetailE"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell">
            <text:p>※事業計画概要書には、以下の図書を添付してください。</text:p>
            <text:p>・事業区域位置図</text:p>
            <text:p>・現況図及び現況写真</text:p>
            <text:p>・土地利用計画図、造成計画平面図及び排水施設計画平面図</text:p>
            <text:p>・予定建築物の平面図及び立面図</text:p>
            <text:p>・工事車両の搬出入経路図</text:p>
            <text:p>・建築基準法第56条の２に規定する日影図（予定建築物の高さが10</text:p>
            <text:p>　メートルを超える場合に限る。）</text:p>
            <text:p>・電波障害調査報告書（予定建築物の高さが10メートルを超える場合に</text:p>
            <text:p>　限る。）</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="StampCell"><text:p>受付印</text:p></table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>