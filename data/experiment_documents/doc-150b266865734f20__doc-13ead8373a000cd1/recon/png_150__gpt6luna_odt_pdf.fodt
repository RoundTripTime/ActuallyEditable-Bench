      <style:paragraph-properties fo:line-height="13pt" fo:margin-top="0pt" fo:margin-bottom="0pt"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="CellLabel" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="13pt" fo:margin-top="0pt" fo:margin-bottom="0pt"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="ExplanationTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="11pt" fo:margin-top="0pt" fo:margin-bottom="0pt"/>
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
    <style:style style:name="Explanation0" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0cm" fo:line-height="11pt" fo:margin-top="0pt" fo:margin-bottom="0pt"/>
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
    <style:style style:name="Explanation1" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.42cm" fo:line-height="11pt" fo:margin-top="0pt" fo:margin-bottom="0pt"/>
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
    <style:style style:name="Explanation2" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.85cm" fo:line-height="11pt" fo:margin-top="0pt" fo:margin-bottom="0pt"/>
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
    <style:style style:name="Explanation3" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="1.27cm" fo:line-height="11pt" fo:margin-top="0pt" fo:margin-bottom="0pt"/>
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="2.5cm" fo:margin-bottom="2cm" fo:margin-left="2.5cm" fo:margin-right="2.5cm"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="15.8cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="FormColumn1" style:family="table-column">
      <style:table-column-properties style:column-width="5.4cm"/>
    </style:style>
    <style:style style:name="FormColumn2" style:family="table-column">
      <style:table-column-properties style:column-width="10.4cm"/>
    </style:style>
    <style:style style:name="FormBox" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.12cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="FormCellPlain" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.12cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="FormCellNoBorder" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
