    <style:style style:name="Explanation3" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="1.27cm" fo:line-height="11pt" fo:margin-top="0pt" fo:margin-bottom="0pt"/>
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
  </office:styles>
