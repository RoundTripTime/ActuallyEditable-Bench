<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Normal" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.18cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0.55cm" fo:padding-bottom="0.15cm" fo:border-bottom="0.8pt solid #4F81BD"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="26pt" fo:color="#17365D"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.05cm" fo:margin-bottom="0.22cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="MetaLabel" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:font-weight="bold" fo:color="#376092"/>
    </style:style>
    <style:style style:name="MetaValue" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:color="#376092"/>
    </style:style>
    <style:style style:name="ColumnHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:font-weight="bold" fo:color="#376092"/>
    </style:style>
    <style:style style:name="Total" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.28cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.18cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="FooterText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="8pt" fo:color="#000000"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-left="1.4cm" fo:margin-right="1.4cm" fo:margin-top="1.4cm" fo:margin-bottom="1.4cm"/>
    </style:page-layout>
    <style:style style:name="MetaTable" style:family="table">
      <style:table-properties style:width="18.2cm" table:align="margins" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="MetaColumn" style:family="table-column">
      <style:table-column-properties style:column-width="9.1cm"/>
    </style:style>
    <style:style style:name="ItemsTable" style:family="table">
      <style:table-properties style:width="18.2cm" table:align="margins" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ItemCol1" style:family="table-column">
      <style:table-column-properties style:column-width="8.2cm"/>
    </style:style>
    <style:style style:name="ItemCol2" style:family="table-column">
      <style:table-column-properties style:column-width="2.5cm"/>
    </style:style>
    <style:style style:name="ItemCol3" style:family="table-column">
      <style:table-column-properties style:column-width="3.6cm"/>
    </style:style>
    <style:style style:name="ItemCol4" style:family="table-column">
      <style:table-column-properties style:column-width="3.9cm"/>
    </style:style>
    <style:style style:name="MetaCell" style:family="table-cell">
      <style:table-cell-properties fo:padding-left="0.2cm" fo:padding-right="0.2cm" fo:padding-top="0.03cm" fo:padding-bottom="0.03cm"/>
    </style:style>
    <style:style style:name="MetaBlue" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#D3DFEF" fo:padding-left="0.2cm" fo:padding-right="0.2cm" fo:padding-top="0.03cm" fo:padding-bottom="0.03cm"/>
    </style:style>
    <style:style style:name="LineHeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:border-top="0.8pt solid #4F81BD" fo:border-bottom="0.8pt solid #4F81BD" fo:padding-left="0.2cm" fo:padding-right="0.2cm" fo:padding-top="0.04cm" fo:padding-bottom="0.04cm"/>
    </style:style>
    <style:style style:name="LineBlueCell" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#D3DFEF" fo:padding-left="0cm" fo:padding-right="0cm" fo:padding-top="0.14cm" fo:padding-bottom="0.14cm"/>
    </style:style>
    <style:style style:name="LineWhiteCell" style:family="table-cell">
      <style:table-cell-properties fo:padding-left="0cm" fo:padding-right="0cm" fo:padding-top="0.14cm" fo:padding-bottom="0.14cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout">
      <style:footer>
        <text:p text:style-name="FooterText">OnlineBiller | Original English resource | Blank template</text:p>
      </style:footer>
    </style:master-page>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">Restaurant Bill</text:p>
      <text:p text:style-name="Subtitle">BLANK TEMPLATE | Currency: INR</text:p>
      <table:table table:name="BillDetails" table:style-name="MetaTable">
        <table:table-column table:style-name="MetaColumn"/>
        <table:table-column table:style-name="MetaColumn"/>
        <table:table-row>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="MetaLabel">Restaurant</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="MetaValue">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaBlue"><text:p text:style-name="MetaLabel">Bill / date</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaBlue"><text:p text:style-name="MetaValue">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="MetaLabel">Table / order</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="MetaValue">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaBlue"><text:p text:style-name="MetaLabel">Service</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaBlue"><text:p text:style-name="MetaValue">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="MetaLabel">Guest reference</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="MetaValue">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaBlue"><text:p text:style-name="MetaLabel">Price basis</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaBlue"><text:p text:style-name="MetaValue">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="MetaLabel">Payment reference</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="MetaValue">________________________________________</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Normal"/>
      <table:table table:name="Items" table:style-name="ItemsTable">
        <table:table-column table:style-name="ItemCol1"/>
        <table:table-column table:style-name="ItemCol2"/>
        <table:table-column table:style-name="ItemCol3"/>
        <table:table-column table:style-name="ItemCol4"/>
        <table:table-row>
          <table:table-cell table:style-name="LineHeaderCell"><text:p text:style-name="ColumnHeading">Description</text:p></table:table-cell>
          <table:table-cell table:style-name="LineHeaderCell"><text:p text:style-name="ColumnHeading">Quantity</text:p></table:table-cell>
          <table:table-cell table:style-name="LineHeaderCell"><text:p text:style-name="ColumnHeading">Rate (INR)</text:p></table:table-cell>
          <table:table-cell table:style-name="LineHeaderCell"><text:p text:style-name="ColumnHeading">Amount (INR)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LineBlueCell"><text:p text:style-name="Normal"/></table:table-cell>
          <table:table-cell table:style-name="LineBlueCell"><text:p text:style-name="Normal"/></table:table-cell>
          <table:table-cell table:style-name="LineBlueCell"><text:p text:style-name="Normal"/></table:table-cell>
          <table:table-cell table:style-name="LineBlueCell"><text:p text:style-name="Normal"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LineWhiteCell"><text:p text:style-name="Normal"/></table:table-cell>
          <table:table-cell table:style-name="LineWhiteCell"><text:p text:style-name="Normal"/></table:table-cell>
          <table:table-cell table:style-name="LineWhiteCell"><text:p text:style-name="Normal"/></table:table-cell>
          <table:table-cell table:style-name="LineWhiteCell"><text:p text:style-name="Normal"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LineBlueCell"><text:p text:style-name="Normal"/></table:table-cell>
          <table:table-cell table:style-name="LineBlueCell"><text:p text:style-name="Normal"/></table:table-cell>
          <table:table-cell table:style-name="LineBlueCell"><text:p text:style-name="Normal"/></table:table-cell>
          <table:table-cell table:style-name="LineBlueCell"><text:p text:style-name="Normal"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LineWhiteCell"><text:p text:style-name="Normal"/></table:table-cell>
          <table:table-cell table:style-name="LineWhiteCell"><text:p text:style-name="Normal"/></table:table-cell>
          <table:table-cell table:style-name="LineWhiteCell"><text:p text:style-name="Normal"/></table:table-cell>
          <table:table-cell table:style-name="LineWhiteCell"><text:p text:style-name="Normal"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LineBlueCell"><text:p text:style-name="Normal"/></table:table-cell>
          <table:table-cell table:style-name="LineBlueCell"><text:p text:style-name="Normal"/></table:table-cell>
          <table:table-cell table:style-name="LineBlueCell"><text:p text:style-name="Normal"/></table:table-cell>
          <table:table-cell table:style-name="LineBlueCell"><text:p text:style-name="Normal"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LineWhiteCell"><text:p text:style-name="Normal"/></table:table-cell>
          <table:table-cell table:style-name="LineWhiteCell"><text:p text:style-name="Normal"/></table:table-cell>
          <table:table-cell table:style-name="LineWhiteCell"><text:p text:style-name="Normal"/></table:table-cell>
          <table:table-cell table:style-name="LineWhiteCell"><text:p text:style-name="Normal"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LineBlueCell"><text:p text:style-name="Normal"/></table:table-cell>
          <table:table-cell table:style-name="LineBlueCell"><text:p text:style-name="Normal"/></table:table-cell>
          <table:table-cell table:style-name="LineBlueCell"><text:p text:style-name="Normal"/></table:table-cell>
          <table:table-cell table:style-name="LineBlueCell"><text:p text:style-name="Normal"/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Normal"/>
      <text:p text:style-name="Total"><text:span text:style-name="Normal">Subtotal:</text:span> INR __________</text:p>
      <text:p text:style-name="Total"><text:span text:style-name="Normal">Agreed discount (deduct):</text:span> INR __________</text:p>
      <text:p text:style-name="Total"><text:span text:style-name="Normal">Amount due:</text:span> INR __________</text:p>
      <text:p text:style-name="Note">The example demonstrates item totals and an agreed discount; it does not calculate tax.</text:p>
      <text:p text:style-name="Note">Payment status must match the actual payment record.</text:p>
      <text:p text:style-name="Note">Word amounts are manual. Check line amounts and totals after every edit.</text:p>
    </office:text>
  </office:body>
</office:document>