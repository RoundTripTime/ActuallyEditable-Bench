        <table:table-column table:style-name="ColSigE"/>
        <table:table-row>
          <table:table-cell table:style-name="DottedCell" table:number-columns-spanned="2"><text:p>不在者投票請求人氏名</text:p></table:table-cell>
          <table:covered-table-cell/>
