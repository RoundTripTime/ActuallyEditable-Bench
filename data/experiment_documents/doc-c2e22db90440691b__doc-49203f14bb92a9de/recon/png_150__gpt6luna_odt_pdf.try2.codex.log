          <table:table-cell table:style-name="LargeTextCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="LargeTextCell"><text:p>生年月日</text:p></table:table-cell>
          <table:table-cell table:style-name="LargeTextCell"><text:p>正・昭・平成　年　月　日生</text:p></table:table-cell>
