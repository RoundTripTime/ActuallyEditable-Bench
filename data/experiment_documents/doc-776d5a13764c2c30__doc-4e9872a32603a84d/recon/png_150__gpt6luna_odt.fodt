<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Default" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0.8cm" fo:break-before="page"/>
      <style:text-properties fo:font-size="16pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="CenterBold" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.7cm" fo:margin-bottom="0.1cm"/>
      <style:text-properties fo:font-size="12pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="LeftIndented" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.6cm" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="SmallCenter" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.6cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.5cm" fo:margin-bottom="1.5cm" fo:margin-left="1.8cm" fo:margin-right="1.8cm"/>
    </style:page-layout>
    <style:style style:name="Table" style:family="table">
      <style:table-properties style:width="17.4cm" table:align="center"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="3.3cm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="2.8cm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="4.5cm"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties style:column-width="2.5cm"/>
    </style:style>
    <style:style style:name="Col5" style:family="table-column">
      <style:table-column-properties style:column-width="4.3cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="LabelCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Label" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="FormText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Orange" style:family="text">
      <style:text-properties fo:color="#ff4b26"/>
    </style:style>
    <style:style style:name="OrangeParagraph" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="11pt" fo:color="#ff4b26"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">新北市政府辦理原住民創業及所營事業信用保證融資貸款<text:line-break/>申請書</text:p>
      <table:table table:name="申請表" table:style-name="Table">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-column table:style-name="Col5"/>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Label">申請人</text:p></table:table-cell>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Label">公司/商號</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Label">負責人</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Label">族別</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Label">申請類型</text:p><text:p text:style-name="Label">（擇一申請）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4">
            <text:p text:style-name="FormText">□創業資金(創業初期需準備資本性之開辦費及營運之週轉性支出)。</text:p>
            <text:p text:style-name="FormText">□營運周轉（購置或租用營運、生產設備或支應場地租用、營運周轉金等事業經營所需）。</text:p>
            <text:p text:style-name="FormText">□升級轉型（產品改良與創新開發，或升級生產技術、擴大企業規模等項目）。</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Label">通訊地址</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Label">聯絡人</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Label">市內電話</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Label">電子郵件</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Label">手機</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Label">申請資格</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4">
            <text:p text:style-name="OrangeParagraph">申請本貸款，應符合下列規定：</text:p>
            <text:p text:style-name="OrangeParagraph">1.□事業負責人已成年。</text:p>
            <text:p text:style-name="OrangeParagraph">2.所營事業設於本市滿三個月，且符合下列條件之一者：</text:p>
            <text:p text:style-name="OrangeParagraph">□符合中小企業認定標準第二條，且於本市辦理公司登記、</text:p>
            <text:p text:style-name="OrangeParagraph">有限公司登記或商業登記之事業，惟不含金融及保險</text:p>
            <text:p text:style-name="OrangeParagraph">業、特殊娛樂業。</text:p>
            <text:p text:style-name="OrangeParagraph">□於本市辦理合作社登記之公司。</text:p>
            <text:p text:style-name="OrangeParagraph">□依商業登記法第五條規定得免辦理登記之小規模商業，且</text:p>
            <text:p text:style-name="OrangeParagraph">有稅籍登記者。</text:p>
            <text:p text:style-name="OrangeParagraph">3.□已接受本府原住民個人、機構、法人或團體所營事業諮詢</text:p>
            <text:p text:style-name="OrangeParagraph">服務。</text:p>
            <text:p text:style-name="OrangeParagraph">4.□已取得原住民機構、法人或團體證明者。</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Default">檢附以下書件：</text:p>
      <text:p text:style-name="Default">□貸款計畫書 1 份。</text:p>
      <text:p text:style-name="Default">□申請人身分證正反面影本及戶籍謄本各 1 份。</text:p>
      <text:p text:style-name="Default">□稅籍登記證明或公司登記、商業登記或合作社登記證明文件 1 份。</text:p>
      <text:p text:style-name="SmallCenter">(民)原經建 09-(民)表一-1/2</text:p>
      <text:p text:style-name="Title">新北市政府辦理原住民創業及所營事業信用保證融資貸款<text:line-break/>申請書</text:p>
      <text:p text:style-name="LeftIndented">□原住民機構、法人或團體證明書 1 份。</text:p>
      <text:p text:style-name="LeftIndented">□切結書 1 份。</text:p>
      <text:p text:style-name="LeftIndented">□聯徵查詢同意書-法人或負責人 1 份。</text:p>
      <text:p text:style-name="LeftIndented">□委託書-國稅無欠稅證明、委託書-地方稅無欠稅證明各 1 份。</text:p>
      <text:p text:style-name="LeftIndented">□貸款計畫諮詢服務報告書 1 份。</text:p>
      <text:p text:style-name="LeftIndented">□財團法人金融聯合徵信中心綜合信用報告 1 份(<text:span text:style-name="Orange">事業體及負責人各 1 份</text:span>)。</text:p>
      <text:p text:style-name="LeftIndented">本府代為調查，申請人免自行檢附之文件：</text:p>
      <text:p text:style-name="LeftIndented">※　戶籍謄本。</text:p>
      <text:p text:style-name="LeftIndented">※　最近三年內之納稅記錄。</text:p>
      <text:p text:style-name="CenterBold">以上各項資料及所檢附之文件均屬實際發生</text:p>
      <text:p text:style-name="LeftIndented">※　承貸銀行得參考貸款審查會議結論並依承貸銀行相關核貸規範</text:p>
      <text:p text:style-name="LeftIndented">　　有授信案之最終核決權。</text:p>
      <text:p text:style-name="LeftIndented"><text:span>申 請 人（公司/商號）：</text:span></text:p>
      <text:p text:style-name="LeftIndented">（請加蓋公司/商業大小章）</text:p>
      <text:p text:style-name="LeftIndented">中　華　民　國　　　　年　　　　月　　　　日</text:p>
      <text:p text:style-name="SmallCenter">(民)原經建 09-(民)表一-2/2</text:p>
    </office:text>
  </office:body>
</office:document>