    <office:text>
      <text:p text:style-name="Title">新北市政府辦理原住民創業及所營事業信用保證融資貸款<text:line-break/>申請書</text:p>
      <table:table table:name="申請表" table:style-name="FormTable">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
