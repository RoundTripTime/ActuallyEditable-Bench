          <table:table-cell table:style-name="GridHead" table:number-rows-spanned="2"><text:p>作物の種類別作付面積（又は栽培面積）</text:p></table:table-cell>
          <table:table-cell table:style-name="GridHead" table:number-rows-spanned="2"><text:p>生産数量</text:p></table:table-cell>
          <table:table-cell table:style-name="GridHead" table:number-rows-spanned="2"><text:p>反収</text:p></table:table-cell>
          <table:table-cell table:style-name="GridHead" table:number-rows-spanned="2"><text:p>備考</text:p></table:table-cell>
        </table:table-row>
