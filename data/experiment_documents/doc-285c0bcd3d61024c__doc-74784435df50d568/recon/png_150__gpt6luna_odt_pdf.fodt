<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties style:font-name="MS PMincho" fo:font-size="11pt"/>
    </style:default-style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-left="2.9cm" fo:margin-top="2.3cm" fo:margin-bottom="0.55cm"/>
    </style:style>
    <style:style style:name="TitleLine" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.1cm" fo:margin-bottom="0.3cm"/>
    </style:style>
    <style:style style:name="ReportTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="1.25cm"/>
    </style:style>
    <style:style style:name="Club" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-left="7cm" fo:margin-right="3.9cm" fo:margin-bottom="0.35cm"/>
    </style:style>
    <style:style style:name="Heading" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="2.9cm" fo:margin-top="0.15cm" fo:margin-bottom="0.5cm"/>
    </style:style>
    <style:style style:name="Subheading" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="3.1cm" fo:margin-top="0cm" fo:margin-bottom="0.2cm"/>
    </style:style>
    <style:style style:name="SubheadingNext" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="3.1cm" fo:margin-top="0.18cm" fo:margin-bottom="0.2cm"/>
    </style:style>
    <style:style style:name="TableHeading" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin="0cm"/>
    </style:style>
    <style:style style:name="UnderlinedText" style:family="text">
      <style:text-properties style:text-underline-style="solid" style:text-underline-width="auto" style:text-underline-color="font-color"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="2.3cm" fo:margin-bottom="2.3cm" fo:margin-left="2.5cm" fo:margin-right="2.5cm"/>
    </style:page-layout>
    <style:style style:name="TableOne" style:family="table">
      <style:table-properties style:width="14.3cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="TableTwo" style:family="table">
      <style:table-properties style:width="14.5cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ColOneWide" style:family="table-column">
      <style:table-column-properties style:column-width="10.7cm"/>
    </style:style>
    <style:style style:name="ColOneNarrow" style:family="table-column">
      <style:table-column-properties style:column-width="3.6cm"/>
    </style:style>
    <style:style style:name="ColTwoDate" style:family="table-column">
      <style:table-column-properties style:column-width="3.75cm"/>
    </style:style>
    <style:style style:name="ColTwoContent" style:family="table-column">
      <style:table-column-properties style:column-width="7.25cm"/>
    </style:style>
    <style:style style:name="ColTwoCount" style:family="table-column">
      <style:table-column-properties style:column-width="3.5cm"/>
    </style:style>
    <style:style style:name="HeaderRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.65cm"/>
    </style:style>
    <style:style style:name="InputRowOne" style:family="table-row">
      <style:table-row-properties style:row-height="3.1cm"/>
    </style:style>
    <style:style style:name="InputRowTwo" style:family="table-row">
      <style:table-row-properties style:row-height="10.35cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.05cm" style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">別紙</text:p>
      <text:p text:style-name="TitleLine">令和　　年度東郷町高齢者花壇管理事業</text:p>
      <text:p text:style-name="ReportTitle">（花いっぱい活動事業）実績報告</text:p>
      <text:p text:style-name="Club"><text:span text:style-name="UnderlinedText">老人クラブ</text:span></text:p>
      <text:p text:style-name="Heading">１　実績報告</text:p>
      <text:p text:style-name="Subheading">⑴　補助対象花壇設置場所</text:p>
      <table:table table:name="花壇設置場所" table:style-name="TableOne">
        <table:table-column table:style-name="ColOneWide"/>
        <table:table-column table:style-name="ColOneNarrow"/>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableHeading">補 助 対 象 花 壇 設 置 場 所</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableHeading">面　積</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InputRowOne">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="SubheadingNext">⑵　補助事業実施内容</text:p>
      <table:table table:name="事業実施内容" table:style-name="TableTwo">
        <table:table-column table:style-name="ColTwoDate"/>
        <table:table-column table:style-name="ColTwoContent"/>
        <table:table-column table:style-name="ColTwoCount"/>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableHeading">実 施 日</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableHeading">実施内容</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableHeading">参加人数</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InputRowTwo">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>