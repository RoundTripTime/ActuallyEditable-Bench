<?xml version="1.0" encoding="UTF-8"?>
<office:document
    xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
    xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
    xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
    xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
    office:mimetype="application/vnd.oasis.opendocument.text"
    office:version="1.4">
  <office:styles>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin="0cm"/>
    </style:style>
    <style:style style:name="Plain" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="CenterTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="RightLine" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="12pt" style:text-underline-style="solid"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="GridCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="GridTable1" style:family="table">
      <style:table-properties style:width="143mm" fo:margin-left="17mm" table:align="left"/>
    </style:style>
    <style:style style:name="GridTable2" style:family="table">
      <style:table-properties style:width="145mm" fo:margin-left="15mm" table:align="left"/>
    </style:style>
    <style:style style:name="Col105" style:family="table-column">
      <style:table-column-properties style:column-width="105mm"/>
    </style:style>
    <style:style style:name="Col38" style:family="table-column">
      <style:table-column-properties style:column-width="38mm"/>
    </style:style>
    <style:style style:name="Col37" style:family="table-column">
      <style:table-column-properties style:column-width="37mm"/>
    </style:style>
    <style:style style:name="Col73" style:family="table-column">
      <style:table-column-properties style:column-width="73mm"/>
    </style:style>
    <style:style style:name="Col35" style:family="table-column">
      <style:table-column-properties style:column-width="35mm"/>
    </style:style>
    <style:style style:name="RowSmall" style:family="table-row">
      <style:table-row-properties style:row-height="7mm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RowArea" style:family="table-row">
      <style:table-row-properties style:row-height="31mm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RowLarge" style:family="table-row">
      <style:table-row-properties style:row-height="104mm" style:use-optimal-row-height="false"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" fo:print-orientation="portrait" fo:margin-top="20mm" fo:margin-bottom="20mm" fo:margin-left="25mm" fo:margin-right="25mm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">別紙</text:p>
      <text:p text:style-name="Plain"/>
      <text:p text:style-name="CenterTitle">令和<text:s text:c="4"/>年度東郷町高齢者花壇管理事業</text:p>
      <text:p text:style-name="CenterTitle">(花いっぱい活動事業)実績報告</text:p>
      <text:p text:style-name="Plain"/>
      <text:p text:style-name="Plain"/>
      <text:p text:style-name="RightLine">老人クラブ</text:p>
      <text:p text:style-name="Plain"/>
      <text:p text:style-name="Plain">１　実績報告</text:p>
      <text:p text:style-name="Plain"/>
      <text:p text:style-name="Plain">(1)　補助対象花壇設置場所</text:p>
      <table:table table:name="Table1" table:style-name="GridTable1">
        <table:table-column table:style-name="Col105"/>
        <table:table-column table:style-name="Col38"/>
        <table:table-row table:style-name="RowSmall">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">補 助 対 象 花 壇 設 置 場 所</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">面　積</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowArea">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="Plain"/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="Plain"/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Plain"/>
      <text:p text:style-name="Plain">(2)　補助事業実施内容</text:p>
      <table:table table:name="Table2" table:style-name="GridTable2">
        <table:table-column table:style-name="Col37"/>
        <table:table-column table:style-name="Col73"/>
        <table:table-column table:style-name="Col35"/>
        <table:table-row table:style-name="RowSmall">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">実 施 日</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">実施内容</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">参加人数</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowLarge">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="Plain"/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="Plain"/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="Plain"/></table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>