          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C1" table:number-rows-spanned="2"><text:p>7. 선별검사</text:p></table:table-cell>
          <table:table-cell table:style-name="C1"><text:p>① 검사명</text:p></table:table-cell>
          <table:table-cell table:style-name="C1" table:number-columns-spanned="2"><text:p>② 검사기관명</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="C1" table:number-columns-spanned="2"><text:p>③ 검사일</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="C1" table:number-columns-spanned="2"><text:p>④ 금액(본인부담금)</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="C1"><text:p>① 검사명</text:p></table:table-cell>
          <table:table-cell table:style-name="C1" table:number-columns-spanned="2"><text:p>② 검사기관명</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="C1" table:number-columns-spanned="2"><text:p>③ 검사일</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="C1" table:number-columns-spanned="2"><text:p>④ 금액(본인부담금)</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C1"><text:p>8. 확진검사</text:p></table:table-cell>
          <table:table-cell table:style-name="C1"><text:p>① 검사명</text:p></table:table-cell>
          <table:table-cell table:style-name="C1" table:number-columns-spanned="2"><text:p>② 검사기관명</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="C1" table:number-columns-spanned="2"><text:p>③ 검사일</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="C1" table:number-columns-spanned="2"><text:p>④ 금액(본인부담금)</text:p></table:table-cell>
