<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="PTitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0cm" fo:margin-right="0cm" fo:margin-top="0.65cm" fo:margin-bottom="0.45cm" fo:text-align="start" fo:line-height="1.15"/>
      <style:text-properties fo:font-family="Microsoft JhengHei" fo:font-size="24pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="PTitleDate" style:family="text">
      <style:text-properties fo:font-family="Times New Roman" fo:font-size="24pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="PPageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin="0cm" fo:line-height="0.1cm"/>
      <style:text-properties fo:font-family="Microsoft JhengHei" fo:font-size="1pt"/>
    </style:style>
    <style:style style:name="PHeader" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="1.2" fo:text-align="start"/>
      <style:text-properties fo:font-family="Microsoft JhengHei" fo:font-size="16pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="PBody" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="1.2" fo:text-align="start"/>
      <style:text-properties fo:font-family="Microsoft JhengHei" fo:font-size="12pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="PBodyLow" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0cm" fo:margin-right="0cm" fo:margin-top="6.55cm" fo:margin-bottom="0cm" fo:line-height="1.2" fo:text-align="start"/>
      <style:text-properties fo:font-family="Microsoft JhengHei" fo:font-size="12pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="PContinuation" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="1.2" fo:text-align="start"/>
      <style:text-properties fo:font-family="Microsoft JhengHei" fo:font-size="14pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="PSignature" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="1.2" fo:text-align="start"/>
      <style:text-properties fo:font-family="Microsoft JhengHei" fo:font-size="15pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="TGrid" style:family="table">
      <style:table-properties style:width="26.1cm" table:align="left" fo:margin="0cm"/>
    </style:style>
    <style:style style:name="TSignature" style:family="table">
      <style:table-properties style:width="26.1cm" table:align="left" fo:margin="0cm"/>
    </style:style>
    <style:style style:name="C1" style:family="table-column">
      <style:table-column-properties style:column-width="3.224cm"/>
    </style:style>
    <style:style style:name="C2" style:family="table-column">
      <style:table-column-properties style:column-width="1.905cm"/>
    </style:style>
    <style:style style:name="C3" style:family="table-column">
      <style:table-column-properties style:column-width="3.175cm"/>
    </style:style>
    <style:style style:name="C4" style:family="table-column">
      <style:table-column-properties style:column-width="2.88cm"/>
    </style:style>
    <style:style style:name="C5" style:family="table-column">
      <style:table-column-properties style:column-width="3.47cm"/>
    </style:style>
    <style:style style:name="C6" style:family="table-column">
      <style:table-column-properties style:column-width="4.13cm"/>
    </style:style>
    <style:style style:name="C7" style:family="table-column">
      <style:table-column-properties style:column-width="7.316cm"/>
    </style:style>
    <style:style style:name="RHeader" style:family="table-row">
      <style:table-row-properties style:row-height="2.98cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RBody" style:family="table-row">
      <style:table-row-properties style:row-height="12.75cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RContinuation" style:family="table-row">
      <style:table-row-properties style:row-height="1.08cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RSignature" style:family="table-row">
      <style:table-row-properties style:use-optimal-row-height="true"/>
    </style:style>
    <style:style style:name="CellGrid" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.05cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellBody" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.05cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="CellContinuation" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.02cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellNoBorder" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0cm" style:vertical-align="top"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="29.7cm" fo:page-height="21cm" style:print-orientation="landscape" fo:margin-left="1.5cm" fo:margin-right="2.1cm" fo:margin-top="1.5cm" fo:margin-bottom="1.5cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PTitle">（機關全銜）<text:span text:style-name="PTitleDate">107</text:span>年度聘僱計畫檢討報告表</text:p>
      <table:table table:name="MainForm" table:style-name="TGrid">
        <table:table-column table:style-name="C1"/>
        <table:table-column table:style-name="C2"/>
        <table:table-column table:style-name="C3"/>
        <table:table-column table:style-name="C4"/>
        <table:table-column table:style-name="C5"/>
        <table:table-column table:style-name="C6"/>
        <table:table-column table:style-name="C7"/>
        <table:table-row table:style-name="RHeader">
          <table:table-cell table:style-name="CellGrid"><text:p text:style-name="PHeader">工作內容</text:p></table:table-cell>
          <table:table-cell table:style-name="CellGrid"><text:p text:style-name="PHeader">聘僱計<text:line-break/>畫初次<text:line-break/>日期</text:p></table:table-cell>
          <table:table-cell table:style-name="CellGrid"><text:p text:style-name="PHeader">人員姓名及<text:line-break/>初次聘<text:line-break/>（僱）用日<text:line-break/>期</text:p></table:table-cell>
          <table:table-cell table:style-name="CellGrid"><text:p text:style-name="PHeader">業務性質</text:p></table:table-cell>
          <table:table-cell table:style-name="CellGrid"><text:p text:style-name="PHeader">辦理經常性<text:line-break/>業務原因</text:p></table:table-cell>
          <table:table-cell table:style-name="CellGrid"><text:p text:style-name="PHeader">聘僱用人數年限<text:line-break/>超過<text:line-break/>　5％5年原因</text:p></table:table-cell>
          <table:table-cell table:style-name="CellGrid"><text:p text:style-name="PHeader">研提改進措施</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RBody">
          <table:table-cell table:style-name="CellBody"/>
          <table:table-cell table:style-name="CellBody"/>
          <table:table-cell table:style-name="CellBody"/>
          <table:table-cell table:style-name="CellBody"><text:p text:style-name="PBodyLow">（ ）經常性</text:p></table:table-cell>
          <table:table-cell table:style-name="CellBody"/>
          <table:table-cell table:style-name="CellBody"/>
          <table:table-cell table:style-name="CellBody"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PPageBreak"/>
      <table:table table:name="MainFormContinuation" table:style-name="TGrid">
        <table:table-column table:style-name="C1"/>
        <table:table-column table:style-name="C2"/>
        <table:table-column table:style-name="C3"/>
        <table:table-column table:style-name="C4"/>
        <table:table-column table:style-name="C5"/>
        <table:table-column table:style-name="C6"/>
        <table:table-column table:style-name="C7"/>
        <table:table-row table:style-name="RContinuation">
          <table:table-cell table:style-name="CellContinuation"/>
          <table:table-cell table:style-name="CellContinuation"/>
          <table:table-cell table:style-name="CellContinuation"/>
          <table:table-cell table:style-name="CellContinuation"><text:p text:style-name="PContinuation">（ ）臨時性</text:p></table:table-cell>
          <table:table-cell table:style-name="CellContinuation"/>
          <table:table-cell table:style-name="CellContinuation"/>
          <table:table-cell table:style-name="CellContinuation"/>
        </table:table-row>
      </table:table>
      <table:table table:name="Signatures" table:style-name="TSignature">
        <table:table-column table:style-name="C1"/>
        <table:table-column table:style-name="C3"/>
        <table:table-column table:style-name="C7"/>
        <table:table-row table:style-name="RSignature">
          <table:table-cell table:style-name="CellNoBorder"><text:p text:style-name="PSignature">承辦人:</text:p></table:table-cell>
          <table:table-cell table:style-name="CellNoBorder"><text:p text:style-name="PSignature">單位主管:</text:p></table:table-cell>
          <table:table-cell table:style-name="CellNoBorder"><text:p text:style-name="PSignature">機關首長:</text:p></table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>