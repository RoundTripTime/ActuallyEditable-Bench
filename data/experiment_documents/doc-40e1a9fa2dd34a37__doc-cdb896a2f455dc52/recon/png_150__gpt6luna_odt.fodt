<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="DefaultParagraph" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm"/>
      <style:text-properties fo:font-size="15pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="LandscapeA4">
      <style:page-layout-properties fo:page-width="29.7cm" fo:page-height="21cm" style:print-orientation="landscape" fo:margin-left="1.5cm" fo:margin-right="1.5cm" fo:margin-top="2.2cm" fo:margin-bottom="1.5cm"/>
    </style:page-layout>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:margin-bottom="0.3cm"/>
      <style:text-properties fo:font-size="25pt"/>
    </style:style>
    <style:style style:name="HeaderText" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm"/>
      <style:text-properties fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="BodyText" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm"/>
      <style:text-properties fo:font-size="15pt"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:line-height="0cm" fo:margin="0cm"/>
    </style:style>
    <style:style style:name="Signatures" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:margin-top="0.35cm"/>
      <style:text-properties fo:font-size="15pt"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="26.7cm" table:align="left" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="FormCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="BusinessCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Column1" style:family="table-column">
      <style:table-column-properties style:column-width="3.3cm"/>
    </style:style>
    <style:style style:name="Column2" style:family="table-column">
      <style:table-column-properties style:column-width="1.95cm"/>
    </style:style>
    <style:style style:name="Column3" style:family="table-column">
      <style:table-column-properties style:column-width="3.25cm"/>
    </style:style>
    <style:style style:name="Column4" style:family="table-column">
      <style:table-column-properties style:column-width="2.95cm"/>
    </style:style>
    <style:style style:name="Column5" style:family="table-column">
      <style:table-column-properties style:column-width="3.5cm"/>
    </style:style>
    <style:style style:name="Column6" style:family="table-column">
      <style:table-column-properties style:column-width="4.15cm"/>
    </style:style>
    <style:style style:name="Column7" style:family="table-column">
      <style:table-column-properties style:column-width="7.6cm"/>
    </style:style>
    <style:style style:name="HeaderRow" style:family="table-row">
      <style:table-row-properties style:row-height="3cm"/>
    </style:style>
    <style:style style:name="BodyRow" style:family="table-row">
      <style:table-row-properties style:row-height="12.7cm"/>
    </style:style>
    <style:style style:name="ContinuationRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.1cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="DefaultMaster" style:page-layout-name="LandscapeA4"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">( 機關全銜 ) 107 年度聘僱計畫檢討報告表</text:p>
      <table:table table:name="聘僱計畫檢討表" table:style-name="FormTable">
        <table:table-column table:style-name="Column1"/>
        <table:table-column table:style-name="Column2"/>
        <table:table-column table:style-name="Column3"/>
        <table:table-column table:style-name="Column4"/>
        <table:table-column table:style-name="Column5"/>
        <table:table-column table:style-name="Column6"/>
        <table:table-column table:style-name="Column7"/>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="HeaderText">工作內容</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="HeaderText">聘僱計畫初次日期</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="HeaderText">人員姓名及初次聘（僱）用日期</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="HeaderText">業務性質</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="HeaderText">辦理經常性業務原因</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="HeaderText">聘僱用人數年限超過 5%5 年原因</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="HeaderText">研提改進措施</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="BodyRow">
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="BusinessCell"><text:p text:style-name="BodyText">( ) 經常性</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageStart"/>
      <table:table table:name="聘僱計畫檢討表續頁" table:style-name="FormTable">
        <table:table-column table:style-name="Column1"/>
        <table:table-column table:style-name="Column2"/>
        <table:table-column table:style-name="Column3"/>
        <table:table-column table:style-name="Column4"/>
        <table:table-column table:style-name="Column5"/>
        <table:table-column table:style-name="Column6"/>
        <table:table-column table:style-name="Column7"/>
        <table:table-row table:style-name="ContinuationRow">
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="BusinessCell"><text:p text:style-name="BodyText">( ) 臨時性</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Signatures">承辦人：　　　　　　　　　單位主管：　　　　　　　　　機關首長：</text:p>
    </office:text>
  </office:body>
</office:document>