<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Line" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.15cm" fo:margin-right="0cm" fo:margin-top="0cm" fo:margin-bottom="0.18cm" fo:text-align="start"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="CellText" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0cm" fo:margin-right="0cm" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:text-align="center" fo:line-height="100%"/>
      <style:text-properties fo:font-size="28pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-left="1.08cm" fo:margin-right="1.72cm" fo:margin-top="1.1cm" fo:margin-bottom="2cm"/>
    </style:page-layout>
    <style:style style:name="Grid" style:family="table">
      <style:table-properties style:width="18.2cm" table:align="left" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="Column" style:family="table-column">
      <style:table-column-properties style:column-width="1.4cm"/>
    </style:style>
    <style:style style:name="Row" style:family="table-row">
      <style:table-row-properties style:row-height="1.418cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0cm" style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Line">____________________________</text:p>
      <table:table table:name="Multiplication" table:style-name="Grid">
