<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Normal" style:family="paragraph">
      <style:paragraph-properties fo:line-height="115%"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.5cm" fo:margin-bottom="1.5cm" fo:margin-left="1.5cm" fo:margin-right="1.5cm"/>
    </style:page-layout>
    <style:style style:name="PB" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:line-height="100%"/>
      <style:text-properties fo:font-size="1pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="110%"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="130%"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:line-height="105%"/>
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:border="0.5pt solid #000000" fo:padding="0.04cm"/>
      <style:paragraph-properties fo:line-height="105%"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:border="0.5pt solid #000000" fo:padding="0.04cm"/>
      <style:paragraph-properties fo:text-align="center" fo:line-height="105%"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="SmallCell" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:border="0.5pt solid #000000" fo:padding="0.03cm"/>
      <style:paragraph-properties fo:line-height="100%"/>
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
    <style:style style:name="SmallCenter" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:border="0.5pt solid #000000" fo:padding="0.03cm"/>
      <style:paragraph-properties fo:text-align="center" fo:line-height="100%"/>
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
    <style:style style:name="ColumnNarrow" style:family="table-column">
      <style:table-column-properties style:column-width="0.8cm"/>
    </style:style>
    <style:style style:name="ColumnLabel" style:family="table-column">
      <style:table-column-properties style:column-width="3.8cm"/>
    </style:style>
    <style:style style:name="ColumnContent" style:family="table-column">
      <style:table-column-properties style:column-width="9.5cm"/>
    </style:style>
    <style:style style:name="ColumnResult" style:family="table-column">
      <style:table-column-properties style:column-width="3.0cm"/>
    </style:style>
    <style:style style:name="ColumnNote" style:family="table-column">
      <style:table-column-properties style:column-width="1.3cm"/>
    </style:style>
    <style:style style:name="ColumnMeta1" style:family="table-column">
      <style:table-column-properties style:column-width="4.0cm"/>
    </style:style>
    <style:style style:name="ColumnMeta2" style:family="table-column">
      <style:table-column-properties style:column-width="14.4cm"/>
    </style:style>
    <style:style style:name="ColumnRecord1" style:family="table-column">
      <style:table-column-properties style:column-width="3.0cm"/>
    </style:style>
    <style:style style:name="ColumnRecord2" style:family="table-column">
      <style:table-column-properties style:column-width="2.0cm"/>
    </style:style>
    <style:style style:name="ColumnRecord3" style:family="table-column">
      <style:table-column-properties style:column-width="13.4cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Center">中間検査時提出</text:p>
      <text:p text:style-name="Title">建築基準法第１２条第５項に基づく工事監理状況報告書（RC造）</text:p>
      <text:p>（あて先）　横須賀市建築主事</text:p>
      <text:p text:style-name="Right">年　　　月　　　日</text:p>
      <table:table table:name="基本事項">
        <table:table-column table:style-name="ColumnMeta1"/>
        <table:table-column table:style-name="ColumnMeta2"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>建築確認済証番号</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">年　　　月　　　日　第　　　　　　　　　号</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>建築主氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>建築場所</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>神奈川県横須賀市</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p>上記、工事中の建築物の設計図書と施工状況の照合結果を以下のとおり報告します。</text:p>
      <text:p>工事監理資格　　　（　　　　）建築士（　　　　　　　）登録　第　　　　　　　　　号</text:p>
      <text:p>氏名</text:p>
      <text:p>建築事務所名　　　（　　　　）建築士事務所　（　　　　　　　）知事登録第　　　　　　　　　号</text:p>
      <text:p text:style-name="Right">電話　　　　　　　　　　　　　　　　番</text:p>
      <text:p>建築確認図書と照合した結果、変更は　□　ありません。</text:p>
      <text:p>　　　　　　　　　　　　　　　　□　ありますので、別添「軽微な変更説明書」を添付します。</text:p>
      <text:p>【チェック項目】</text:p>
      <text:p>チェック結果欄について施工状況を確認し、結果を○で囲んで下さい。（該当しない項目は記入しないで下さい。）</text:p>
      <text:p>適：建築確認図書のとおり施工されているもの　不：建築確認図書のとおり施工されていないもの　未：未施工のもの</text:p>
      <table:table table:name="チェック項目１">
        <table:table-column table:style-name="ColumnNarrow"/>
        <table:table-column table:style-name="ColumnLabel"/>
        <table:table-column table:style-name="ColumnContent"/>
        <table:table-column table:style-name="ColumnResult"/>
        <table:table-column table:style-name="ColumnNote"/>
        <table:table-row>
          <table:table-cell table:style-name="SmallCenter"><text:p/>
          </table:table-cell>
          <table:table-cell table:style-name="SmallCenter"><text:p>確　認　事　項</text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCenter"><text:p>内　　　容</text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCenter"><text:p>チェック結果</text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCenter"><text:p>※</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="SmallCenter"><text:p>1</text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCell"><text:p>確認表示板</text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCell"><text:p>確認表示板の設置</text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="SmallCenter" table:number-rows-spanned="4"><text:p>2</text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCell" table:number-rows-spanned="4"><text:p>敷地と道路の関係</text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCell"><text:p>（1）道路の幅員</text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCell" table:number-rows-spanned="4"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="SmallCell"><text:p>（2）道路に接する敷地の長さ</text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="SmallCell"><text:p>（3）２項道路の後退</text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="SmallCell"><text:p>（4）法第43条許可・認定条件との照合</text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="SmallCenter" table:number-rows-spanned="2"><text:p>3</text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCell" table:number-rows-spanned="2"><text:p>敷地形状、建物形状</text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCell"><text:p>（1）敷地の形状（敷地の形、高低差）</text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCell" table:number-rows-spanned="2"/>
        </table:table-row>
        <table:table-row><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="SmallCell"><text:p>（2）建物形状、配置、寸法</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="SmallCenter"><text:p>4</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"><text:p>斜線制限</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"><text:p>確認図書との照合（離れ、配置）</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="SmallCenter"><text:p>5</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"><text:p>居室の採光、換気</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"><text:p>外壁の開口部の位置・大きさ</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="SmallCenter"><text:p>6</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"><text:p>地盤の状況</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"><text:p>支持地盤の位置、種類、支持力等の確認</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="SmallCenter"><text:p>7</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"><text:p>建築物全体</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"><text:p>間取り（柱・横架材・壁・床の位置）</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="SmallCenter"><text:p>8</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"><text:p>建築材料の品質（法37）</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"><text:p>日本工業規格又は日本農林規格に適合、若しくは指定建築材料が大臣認定を受けたもの</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"/></table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="SmallCenter" table:number-rows-spanned="4"><text:p>9</text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCell" table:number-rows-spanned="4"><text:p>施工状況</text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCell"><text:p>（1）鉄筋の乱れ、踏み荒し、波打ち、たるみの有無</text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCell" table:number-rows-spanned="4"/>
        </table:table-row>
        <table:table-row><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="SmallCell"><text:p>（2）柱、梁、スラブが設計図書通りに配置されているか</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="SmallCell"><text:p>（3）適正なかぶり厚さがとれているか</text:p></table:cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="SmallCell"><text:p>（4）型枠中に木片、空缶等のゴミはないか</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
      </table:table>
      <text:p text:style-name="PB"/>
      <table:table table:name="チェック項目２">
        <table:table-column table:style-name="ColumnNarrow"/>
        <table:table-column table:style-name="ColumnLabel"/>
        <table:table-column table:style-name="ColumnContent"/>
        <table:table-column table:style-name="ColumnResult"/>
        <table:table-column table:style-name="ColumnNote"/>
        <table:table-row><table:table-cell table:style-name="SmallCenter" table:number-rows-spanned="4"><text:p>10</text:p></table:table-cell><table:table-cell table:style-name="SmallCell" table:number-rows-spanned="4"><text:p>柱</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"><text:p>（1）上階の主筋本数、径、配置方向</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:cell><table:table-cell table:style-name="SmallCell" table:number-rows-spanned="4"/></table:table-row>
        <table:table-row><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="SmallCell"><text:p>（2）各階止まり、柱頭主筋の止まり高さと定着状況</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="SmallCell"><text:p>（3）柱仕口部分の帯筋の径、ピッチ</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="SmallCell"><text:p>（4）第一帯筋の位置と柱頭拘束帯筋の有無</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="SmallCenter" table:number-rows-spanned="7"><text:p>11</text:p></table:table-cell><table:table-cell table:style-name="SmallCell" table:number-rows-spanned="7"><text:p>梁</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"><text:p>（1）主筋、あばら筋、腹筋、幅止筋の状況</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:table-cell table:style-name="SmallCell" table:number-rows-spanned="7"/></table:table-row>
        <table:table-row><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="SmallCell"><text:p>（2）主筋の定着方法、長さ</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="SmallCell"><text:p>（3）中吊り筋の位置</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="SmallCell"><text:p>（4）継手の位置と長さ（重ね継手の場合）</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="SmallCell"><text:p>（5）片持ち主筋の位置と定着</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="SmallCell"><text:p>（6）貫通部の位置、補強方法</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="SmallCell"><text:p>（7）ハンチ部分のあばら筋補強</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="SmallCenter" table:number-rows-spanned="5"><text:p>12</text:p></table:table-cell><table:table-cell table:style-name="SmallCell" table:number-rows-spanned="5"><text:p>スラブ</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"><text:p>（1）主筋方向、ピッチ、径、スラブ厚</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:table-cell table:style-name="SmallCell" table:number-rows-spanned="5"/></table:table-row>
        <table:table-row><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="SmallCell"><text:p>（2）定着方法、長さ</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="SmallCell"><text:p>（3）継手の位置と長さ</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="SmallCell"><text:p>（4）片持ちスラブの定着と上端筋位置確保</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="SmallCell"><text:p>（5）隅部、開口部、設備配管に対する補強</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="SmallCenter" table:number-rows-spanned="3"><text:p>13</text:p></table:table-cell><table:table-cell table:style-name="SmallCell" table:number-rows-spanned="3"><text:p>壁</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"><text:p>（1）縦筋の定着方法、長さ</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:table-cell table:style-name="SmallCell" table:number-rows-spanned="3"/></table:table-row>
        <table:table-row><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="SmallCell"><text:p>（2）壁交差部の縦筋補強</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="SmallCell"><text:p>（3）スリットの位置、施工状況</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="SmallCenter" table:number-rows-spanned="2"><text:p>14</text:p></table:table-cell><table:table-cell table:style-name="SmallCell" table:number-rows-spanned="2"><text:p>圧接</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"><text:p>（1）ガス圧接継手の形状、位置ずらし</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:table-cell table:style-name="SmallCell" table:number-rows-spanned="2"/></table:table-row>
        <table:table-row><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="SmallCell"><text:p>（2）特殊継手の認定・評定確認</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="SmallCenter"><text:p>15</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"><text:p>その他</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"><text:p>（　　　　　　　　　　　　　　　　　　　　　　　　　）</text:p></table:table-cell><table:table-cell table:style-name="SmallCenter"><text:p>適 ・ 不 ・ 未</text:p></table:table-cell><table:table-cell table:style-name="SmallCell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Small">《注意事項》</text:p>
      <text:p text:style-name="Small">・結果が不適合の場合は「工事施工者への指示記録」欄に項目番号、指示日及び指摘内容を記載して下さい。</text:p>
      <text:p text:style-name="Small">・※欄は空欄のままにしてください。</text:p>
      <text:p>・設計図書の内容について設計者に確認した事項</text:p>
