<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-bottom="0.30cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.20cm" fo:margin-bottom="0.20cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="18pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.10cm" fo:margin-bottom="0.20cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Fields" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.05cm" fo:margin-bottom="0.30cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Intro" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.15cm" fo:margin-bottom="0.18cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Footer" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end" fo:margin-top="0.85cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="8pt"/>
    </style:style>
    <style:style style:name="FieldTable" style:family="table">
      <style:table-properties table:align="right"/>
    </style:style>
    <style:style style:name="ReportTable" style:family="table">
      <style:table-properties table:align="center"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="29.7cm" fo:page-height="21cm" style:print-orientation="landscape" fo:margin-left="1.2cm" fo:margin-right="1.2cm" fo:margin-top="0.8cm" fo:margin-bottom="0.8cm"/>
    </style:page-layout>
    <style:style style:name="FieldLabel" style:family="table-cell">
      <style:table-cell-properties fo:border-bottom="0.5pt solid #000000" fo:padding="0.04cm" style:vertical-align="middle"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="FieldBlank" style:family="table-cell">
      <style:table-cell-properties fo:border-bottom="0.5pt solid #000000" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="FieldCol1" style:family="table-column">
      <style:table-column-properties style:column-width="3.0cm"/>
    </style:style>
    <style:style style:name="FieldCol2" style:family="table-column">
      <style:table-column-properties style:column-width="3.8cm"/>
    </style:style>
    <style:style style:name="FieldCol3" style:family="table-column">
      <style:table-column-properties style:column-width="2.4cm"/>
    </style:style>
    <style:style style:name="FieldCol4" style:family="table-column">
      <style:table-column-properties style:column-width="2.2cm"/>
    </style:style>
    <style:style style:name="HdrCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HdrCenter" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-family="serif" fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="HdrNote" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start"/>
      <style:text-properties fo:font-family="serif" fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="HdrContent" style:family="table-cell">
      <style:table-cell-properties fo:border-top="0.5pt solid #000000" fo:border-bottom="0.5pt solid #000000" fo:border-left="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HdrNoteCell" style:family="table-cell">
      <style:table-cell-properties fo:border-top="0.5pt solid #000000" fo:border-bottom="0.5pt solid #000000" fo:border-right="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="EntryDate1" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:border-right="0.5pt dashed #000000" fo:padding="0.03cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="EntryDate2" style:family="table-cell">
      <style:table-cell-properties fo:border-top="0.5pt solid #000000" fo:border-bottom="0.5pt solid #000000" fo:border-left="0.5pt dashed #000000" fo:border-right="0.5pt dashed #000000" fo:padding="0.03cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="EntryDate3" style:family="table-cell">
      <style:table-cell-properties fo:border-top="0.5pt solid #000000" fo:border-bottom="0.5pt solid #000000" fo:border-left="0.5pt dashed #000000" fo:border-right="0.5pt solid #000000" fo:padding="0.03cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="EntryCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.03cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="RowHeader" style:family="table-row">
      <style:table-row-properties style:row-height="0.65cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RowEntry" style:family="table-row">
      <style:table-row-properties style:row-height="0.85cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="FieldCol1Auto" style:family="table-column">
      <style:table-column-properties style:column-width="0.8cm"/>
    </style:style>
    <style:style style:name="FieldCol2Auto" style:family="table-column">
      <style:table-column-properties style:column-width="0.8cm"/>
    </style:style>
    <style:style style:name="FieldCol3Auto" style:family="table-column">
      <style:table-column-properties style:column-width="0.8cm"/>
    </style:style>
    <style:style style:name="ReportCol4" style:family="table-column">
      <style:table-column-properties style:column-width="3.8cm"/>
    </style:style>
    <style:style style:name="ReportCol5" style:family="table-column">
      <style:table-column-properties style:column-width="4.85cm"/>
    </style:style>
    <style:style style:name="ReportCol6" style:family="table-column">
      <style:table-column-properties style:column-width="1.88cm"/>
    </style:style>
    <style:style style:name="ReportCol7" style:family="table-column">
      <style:table-column-properties style:column-width="5cm"/>
    </style:style>
    <style:style style:name="ReportCol8" style:family="table-column">
      <style:table-column-properties style:column-width="9.2cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">（ 様式　第３号 ）</text:p>
      <text:p text:style-name="Title">令和　年度　地区育成（子ども）会 事業実施報告書</text:p>
      <text:p text:style-name="Recipient">飯綱町教育委員会 御中</text:p>
      <table:table table:name="Identification" table:style-name="FieldTable">
        <table:table-column table:style-name="FieldCol1"/>
        <table:table-column table:style-name="FieldCol2"/>
        <table:table-column table:style-name="FieldCol3"/>
        <table:table-column table:style-name="FieldCol4"/>
        <table:table-row>
          <table:table-cell table:style-name="FieldLabel"><text:p>育成会名称</text:p></table:table-cell>
          <table:table-cell table:style-name="FieldBlank"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FieldLabel"><text:p>代表者氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="FieldBlank"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Intro">令和　年度に実施した育成会事業は次のとおりです。</text:p>
      <table:table table:name="Activities" table:style-name="ReportTable">
        <table:table-column table:style-name="FieldCol1Auto"/>
        <table:table-column table:style-name="FieldCol2Auto"/>
        <table:table-column table:style-name="FieldCol3Auto"/>
        <table:table-column table:style-name="ReportCol4"/>
        <table:table-column table:style-name="ReportCol5"/>
        <table:table-column table:style-name="ReportCol6"/>
        <table:table-column table:style-name="ReportCol7"/>
        <table:table-column table:style-name="ReportCol8"/>
        <table:table-row table:style-name="RowHeader">
          <table:table-cell table:style-name="HdrCell" table:number-columns-spanned="3"><text:p text:style-name="HdrCenter">開催期日</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="HdrCell"><text:p text:style-name="HdrCenter">開催場所など</text:p></table:table-cell>
          <table:table-cell table:style-name="HdrCell"><text:p text:style-name="HdrCenter">事 業 名 称</text:p></table:table-cell>
          <table:table-cell table:style-name="HdrCell"><text:p text:style-name="HdrCenter">参加者数</text:p></table:table-cell>
          <table:table-cell table:style-name="HdrContent"><text:p text:style-name="HdrCenter">事 業 内 容</text:p></table:table-cell>
          <table:table-cell table:style-name="HdrNoteCell"><text:p text:style-name="HdrNote">※行った内容を記入してください</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowEntry">
          <table:table-cell table:style-name="EntryDate1"><text:p/></table:table-cell><table:table-cell table:style-name="EntryDate2"><text:p/></table:table-cell><table:table-cell table:style-name="EntryDate3"><text:p/></table:table-cell><table:table-cell table:style-name="EntryCell"><text:p/></table:table-cell><table:table-cell table:style-name="EntryCell"><text:p/></table:table-cell><table:table-cell table:style-name="EntryCell"><text:p/></table:table-cell><table:table-cell table:style-name="EntryCell" table:number-columns-spanned="2"><text:p/></table:table-cell><table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowEntry" table:number-rows-repeated="14">
          <table:table-cell table:style-name="EntryDate1"><text:p/></table:table-cell><table:table-cell table:style-name="EntryDate2"><text:p/></table:table-cell><table:table-cell table:style-name="EntryDate3"><text:p/></table:table-cell><table:table-cell table:style-name="EntryCell"><text:p/></table:table-cell><table:table-cell table:style-name="EntryCell"><text:p/></table:table-cell><table:table-cell table:style-name="EntryCell"><text:p/></table:table-cell><table:table-cell table:style-name="EntryCell" table:number-columns-spanned="2"><text:p/></table:table-cell><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Footer">地区育成会 事業実施報告書 230310</text:p>
    </office:text>
  </office:body>
</office:document>