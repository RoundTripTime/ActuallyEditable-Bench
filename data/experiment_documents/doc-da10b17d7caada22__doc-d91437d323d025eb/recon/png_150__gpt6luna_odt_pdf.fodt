<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties style:font-name="Noto Serif CJK JP" fo:font-size="11pt" style:font-size-asian="11pt" style:font-name-asian="Noto Serif CJK JP"/>
    </style:default-style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="9pt" style:font-size-asian="9pt"/>
    </style:style>
    <style:style style:name="FormTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.55cm" fo:margin-bottom="0.2cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="20pt" style:font-size-asian="20pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.05cm" fo:margin-bottom="0.2cm"/>
      <style:text-properties fo:font-size="12pt" style:font-size-asian="12pt"/>
    </style:style>
    <style:style style:name="FormFields" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.1cm" fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-size="12pt" style:font-size-asian="12pt"/>
    </style:style>
    <style:style style:name="Intro" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.15cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-size="12pt" style:font-size-asian="12pt"/>
    </style:style>
    <style:style style:name="TableHeaderText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="11pt" style:font-size-asian="11pt"/>
    </style:style>
    <style:style style:name="TableHeaderWide" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt" style:font-size-asian="10pt"/>
    </style:style>
    <style:style style:name="FooterText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0.85cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="9pt" style:font-size-asian="9pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="29.7cm" fo:page-height="21cm" style:print-orientation="landscape" fo:margin-left="1.2cm" fo:margin-right="1.2cm" fo:margin-top="0.8cm" fo:margin-bottom="0.8cm"/>
    </style:page-layout>
    <style:style style:name="ReportTable" style:family="table">
      <style:table-properties table:align="margins" style:width="27.3cm"/>
    </style:style>
    <style:style style:name="DateA" style:family="table-column">
      <style:table-column-properties style:column-width="0.82cm"/>
    </style:style>
    <style:style style:name="DateB" style:family="table-column">
      <style:table-column-properties style:column-width="0.81cm"/>
    </style:style>
    <style:style style:name="DateC" style:family="table-column">
      <style:table-column-properties style:column-width="0.82cm"/>
    </style:style>
    <style:style style:name="VenueCol" style:family="table-column">
      <style:table-column-properties style:column-width="3.82cm"/>
    </style:style>
    <style:style style:name="NameCol" style:family="table-column">
      <style:table-column-properties style:column-width="4.85cm"/>
    </style:style>
    <style:style style:name="CountCol" style:family="table-column">
      <style:table-column-properties style:column-width="1.88cm"/>
    </style:style>
    <style:style style:name="ContentsCol" style:family="table-column">
      <style:table-column-properties style:column-width="14.3cm"/>
    </style:style>
    <style:style style:name="ReportRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.85cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="HeaderRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.65cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" style:vertical-align="middle" fo:padding="0.05cm"/>
    </style:style>
    <style:style style:name="DateLeft" style:family="table-cell">
      <style:table-cell-properties fo:border-top="0.5pt solid #000000" fo:border-bottom="0.5pt solid #000000" fo:border-left="0.5pt solid #000000" fo:border-right="0.5pt dashed #000000" style:vertical-align="middle" fo:padding="0.02cm"/>
    </style:style>
    <style:style style:name="DateMiddle" style:family="table-cell">
      <style:table-cell-properties fo:border-top="0.5pt solid #000000" fo:border-bottom="0.5pt solid #000000" fo:border-left="0.5pt dashed #000000" fo:border-right="0.5pt dashed #000000" style:vertical-align="middle" fo:padding="0.02cm"/>
    </style:style>
    <style:style style:name="DateRight" style:family="table-cell">
      <style:table-cell-properties fo:border-top="0.5pt solid #000000" fo:border-bottom="0.5pt solid #000000" fo:border-right="0.5pt solid #000000" fo:border-left="0.5pt dashed #000000" style:vertical-align="middle" fo:padding="0.02cm"/>
    </style:style>
    <style:style style:name="DateHeader" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" style:vertical-align="middle" fo:padding="0.03cm"/>
    </style:style>
    <style:style style:name="VenueCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" style:vertical-align="middle" fo:padding="0.03cm"/>
    </style:style>
    <style:style style:name="NameCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" style:vertical-align="middle" fo:padding="0.03cm"/>
    </style:style>
    <style:style style:name="CountCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" style:vertical-align="middle" fo:padding="0.03cm"/>
    </style:style>
    <style:style style:name="ContentsCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" style:vertical-align="middle" fo:padding="0.03cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="DefaultPage" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">（ 様式 第３号 ）</text:p>
      <text:p text:style-name="FormTitle">令和　年度　地区育成（子ども）会　事業実施報告書</text:p>
      <text:p text:style-name="Recipient">飯綱町教育委員会　御中</text:p>
      <text:p text:style-name="FormFields">育成会名称＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿　代表者氏名＿＿＿＿＿＿</text:p>
      <text:p text:style-name="Intro">令和　年度に実施した育成会事業は次のとおりです。</text:p>
      <table:table table:name="事業実施報告" table:style-name="ReportTable">
        <table:table-column table:style-name="DateA"/>
        <table:table-column table:style-name="DateB"/>
        <table:table-column table:style-name="DateC"/>
        <table:table-column table:style-name="VenueCol"/>
        <table:table-column table:style-name="NameCol"/>
        <table:table-column table:style-name="CountCol"/>
        <table:table-column table:style-name="ContentsCol"/>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="DateHeader" table:number-columns-spanned="3"><text:p text:style-name="TableHeaderText">開催期日</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="VenueCell"><text:p text:style-name="TableHeaderText">開催場所など</text:p></table:table-cell>
          <table:table-cell table:style-name="NameCell"><text:p text:style-name="TableHeaderText">事業名称</text:p></table:table-cell>
          <table:table-cell table:style-name="CountCell"><text:p text:style-name="TableHeaderText">参加者数</text:p></table:table-cell>
          <table:table-cell table:style-name="ContentsCell"><text:p text:style-name="TableHeaderWide">事業内容　　　　※行った内容を記入してください</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ReportRow"><table:table-cell table:style-name="DateLeft"/><table:table-cell table:style-name="DateMiddle"/><table:table-cell table:style-name="DateRight"/><table:table-cell table:style-name="VenueCell"/><table:table-cell table:style-name="NameCell"/><table:table-cell table:style-name="CountCell"/><table:table-cell table:style-name="ContentsCell"/></table:table-row>
        <table:table-row table:style-name="ReportRow"><table:table-cell table:style-name="DateLeft"/><table:table-cell table:style-name="DateMiddle"/><table:table-cell table:style-name="DateRight"/><table:table-cell table:style-name="VenueCell"/><table:table-cell table:style-name="NameCell"/><table:table-cell table:style-name="CountCell"/><table:table-cell table:style-name="ContentsCell"/></table:table-row>
        <table:table-row table:style-name="ReportRow"><table:table-cell table:style-name="DateLeft"/><table:table-cell table:style-name="DateMiddle"/><table:table-cell table:style-name="DateRight"/><table:table-cell table:style-name="VenueCell"/><table:table-cell table:style-name="NameCell"/><table:table-cell table:style-name="CountCell"/><table:table-cell table:style-name="ContentsCell"/></table:table-row>
        <table:table-row table:style-name="ReportRow"><table:table-cell table:style-name="DateLeft"/><table:table-cell table:style-name="DateMiddle"/><table:table-cell table:style-name="DateRight"/><table:table-cell table:style-name="VenueCell"/><table:table-cell table:style-name="NameCell"/><table:table-cell table:style-name="CountCell"/><table:table-cell table:style-name="ContentsCell"/></table:table-row>
        <table:table-row table:style-name="ReportRow"><table:table-cell table:style-name="DateLeft"/><table:table-cell table:style-name="DateMiddle"/><table:table-cell table:style-name="DateRight"/><table:table-cell table:style-name="VenueCell"/><table:table-cell table:style-name="NameCell"/><table:table-cell table:style-name="CountCell"/><table:table-cell table:style-name="ContentsCell"/></table:table-row>
        <table:table-row table:style-name="ReportRow"><table:table-cell table:style-name="DateLeft"/><table:table-cell table:style-name="DateMiddle"/><table:table-cell table:style-name="DateRight"/><table:table-cell table:style-name="VenueCell"/><table:table-cell table:style-name="NameCell"/><table:table-cell table:style-name="CountCell"/><table:table-cell table:style-name="ContentsCell"/></table:table-row>
        <table:table-row table:style-name="ReportRow"><table:table-cell table:style-name="DateLeft"/><table:table-cell table:style-name="DateMiddle"/><table:table-cell table:style-name="DateRight"/><table:table-cell table:style-name="VenueCell"/><table:table-cell table:style-name="NameCell"/><table:table-cell table:style-name="CountCell"/><table:table-cell table:style-name="ContentsCell"/></table:table-row>
        <table:table-row table:style-name="ReportRow"><table:table-cell table:style-name="DateLeft"/><table:table-cell table:style-name="DateMiddle"/><table:table-cell table:style-name="DateRight"/><table:table-cell table:style-name="VenueCell"/><table:table-cell table:style-name="NameCell"/><table:table-cell table:style-name="CountCell"/><table:table-cell table:style-name="ContentsCell"/></table:table-row>
        <table:table-row table:style-name="ReportRow"><table:table-cell table:style-name="DateLeft"/><table:table-cell table:style-name="DateMiddle"/><table:table-cell table:style-name="DateRight"/><table:table-cell table:style-name="VenueCell"/><table:table-cell table:style-name="NameCell"/><table:table-cell table:style-name="CountCell"/><table:table-cell table:style-name="ContentsCell"/></table:table-row>
        <table:table-row table:style-name="ReportRow"><table:table-cell table:style-name="DateLeft"/><table:table-cell table:style-name="DateMiddle"/><table:table-cell table:style-name="DateRight"/><table:table-cell table:style-name="VenueCell"/><table:table-cell table:style-name="NameCell"/><table:table-cell table:style-name="CountCell"/><table:table-cell table:style-name="ContentsCell"/></table:table-row>
        <table:table-row table:style-name="ReportRow"><table:table-cell table:style-name="DateLeft"/><table:table-cell table:style-name="DateMiddle"/><table:table-cell table:style-name="DateRight"/><table:table-cell table:style-name="VenueCell"/><table:table-cell table:style-name="NameCell"/><table:table-cell table:style-name="CountCell"/><table:table-cell table:style-name="ContentsCell"/></table:table-row>
        <table:table-row table:style-name="ReportRow"><table:table-cell table:style-name="DateLeft"/><table:table-cell table:style-name="DateMiddle"/><table:table-cell table:style-name="DateRight"/><table:table-cell table:style-name="VenueCell"/><table:table-cell table:style-name="NameCell"/><table:table-cell table:style-name="CountCell"/><table:table-cell table:style-name="ContentsCell"/></table:table-row>
        <table:table-row table:style-name="ReportRow"><table:table-cell table:style-name="DateLeft"/><table:table-cell table:style-name="DateMiddle"/><table:table-cell table:style-name="DateRight"/><table:table-cell table:style-name="VenueCell"/><table:table-cell table:style-name="NameCell"/><table:table-cell table:style-name="CountCell"/><table:table-cell table:style-name="ContentsCell"/></table:table-row>
        <table:table-row table:style-name="ReportRow"><table:table-cell table:style-name="DateLeft"/><table:table-cell table:style-name="DateMiddle"/><table:table-cell table:style-name="DateRight"/><table:table-cell table:style-name="VenueCell"/><table:table-cell table:style-name="NameCell"/><table:table-cell table:style-name="CountCell"/><table:table-cell table:style-name="ContentsCell"/></table:table-row>
        <table:table-row table:style-name="ReportRow"><table:table-cell table:style-name="DateLeft"/><table:table-cell table:style-name="DateMiddle"/><table:table-cell table:style-name="DateRight"/><table:table-cell table:style-name="VenueCell"/><table:table-cell table:style-name="NameCell"/><table:table-cell table:style-name="CountCell"/><table:table-cell table:style-name="ContentsCell"/></table:table-row>
      </table:table>
      <text:p text:style-name="FooterText">地区育成会 事業実施報告書 230310</text:p>
    </office:text>
  </office:body>
</office:document>