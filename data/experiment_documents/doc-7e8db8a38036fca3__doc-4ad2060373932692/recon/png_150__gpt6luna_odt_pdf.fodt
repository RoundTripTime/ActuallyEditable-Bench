      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.7cm" fo:margin-bottom="1.7cm" fo:margin-left="1.95cm" fo:margin-right="1.95cm"/>
    </style:page-layout>
