    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="Center">■ 지방세법 시행규칙[별지 제37호서식] <text:span text:style-name="Blue">&lt;개정 2025. 12. 31.&gt;</text:span></text:p>
      <text:p text:style-name="Title">주민세 사업소분 ([ ]기한 내/[ ]기한 후) 신고서</text:p>
      <text:p>※ 색상이 어두운 난은 신청인이 작성하지 아니하며, 뒤쪽의 작성방법을 읽고 작성하시기 바랍니다.</text:p>
      <table:table table:style-name="T">
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-row>
          <table:table-cell table:style-name="Gray"><text:p>접수번호</text:p></table:table-cell>
          <table:table-cell table:style-name="Gray"><text:p>접수일</text:p></table:table-cell>
          <table:table-cell table:style-name="Gray"><text:p>관리번호</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="4"><text:p text:style-name="Center">신고인<br/>(납세자)</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>① 사업소명(상호)</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>② 성명(법인명)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>③ 주민(법인)등록번호</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>④ 자본금액 또는 출자금액</text:p></table:table-cell></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>⑤ 사업소 소재지</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>⑥ 사업자등록번호</text:p></table:table-cell></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>⑦ 전화번호</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>⑧ FAX번호</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="Center"><text:span text:style-name="Bold">20　　년　신고납부 내역</text:span></text:p>
      <table:table table:style-name="T">
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-row><table:table-cell table:style-name="Gray" table:number-columns-spanned="3"><text:p text:style-name="Center">사업소 연면적에 대한 세액 과세표준</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">⑨ 사업소 건축물의 전체 연면적</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">⑩ 과세제외 면적</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">⑪ 과세대상 면적(=⑨-⑩)</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Right">m²</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Right">m²</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Right">m²</text:p></table:table-cell></table:table-row>
      </table:table>
