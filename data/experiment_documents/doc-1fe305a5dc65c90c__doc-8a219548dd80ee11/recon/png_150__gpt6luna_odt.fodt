<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:xml="http://www.w3.org/XML/1998/namespace" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.15cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#29443d"/>
    </style:default-style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:color="#29443d"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="28pt" fo:color="#29443d"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.55cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="12pt" fo:color="#29443d"/>
    </style:style>
    <style:style style:name="Metadata" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.05cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#29443d"/>
    </style:style>
    <style:style style:name="SectionHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.22cm" fo:margin-bottom="0.2cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="13pt" fo:font-weight="bold" fo:color="#29443d"/>
    </style:style>
    <style:style style:name="Checklist" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.28cm" fo:margin-left="0cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#29443d"/>
    </style:style>
    <style:style style:name="Source" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#29443d"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.7cm" fo:margin-bottom="1.7cm" fo:margin-left="1.7cm" fo:margin-right="1.7cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout">
      <style:footer>
        <text:p>Ostro templates · 1</text:p>
      </style:footer>
    </style:master-page>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">OSTRO / WORKING TEMPLATES</text:p>
      <text:p text:style-name="Title">Website design proposal</text:p>
      <text:p text:style-name="Subtitle">Editable template · replace every bracketed field before use</text:p>
      <text:p text:style-name="Metadata">Prepared by: [your name or business]</text:p>
      <text:p text:style-name="Metadata">Prepared for: [client name]</text:p>
      <text:p text:style-name="Metadata">Date: [date]</text:p>
      <text:p text:style-name="SectionHeading">Project summary</text:p>
      <text:p>[Add your project summary here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="SectionHeading">Objectives and success criteria</text:p>
      <text:p>[Add your objectives and success criteria here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="SectionHeading">Deliverables</text:p>
      <text:p>[Add your deliverables here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="SectionHeading">Out of scope</text:p>
      <text:p>[Add your out of scope here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="SectionHeading">Timeline and milestones</text:p>
      <text:p>[Add your timeline and milestones here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="SectionHeading">Client responsibilities</text:p>
      <text:p>[Add your client responsibilities here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="SectionHeading">Commercial terms</text:p>
      <text:p>[Add your commercial terms here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="SectionHeading">Revisions and next steps</text:p>
      <text:p>[Add your revisions and next steps here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="SectionHeading">Before sending — remove this checklist</text:p>
      <text:p text:style-name="Checklist">• Replace the example scope with the actual client requirements.</text:p>
      <text:p text:style-name="Checklist">• Agree on included revisions, responsibilities and approval timing.</text:p>
      <text:p text:style-name="Checklist">• Review the price, schedule and acceptance process before sending.</text:p>
      <text:p text:style-name="Source">Template and example: https://tryostro.com/templates/website-design-proposal/</text:p>
    </office:text>
  </office:body>
</office:document>