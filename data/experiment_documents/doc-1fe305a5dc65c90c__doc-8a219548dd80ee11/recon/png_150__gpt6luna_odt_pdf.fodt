<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%"/>
      <style:text-properties fo:font-size="11pt" fo:color="#263f38"/>
    </style:default-style>
    <style:style style:name="Kicker" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="4mm" fo:break-before="page"/>
      <style:text-properties fo:font-size="10pt" fo:color="#263f38"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="3mm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="28pt" fo:color="#263f38"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="4mm"/>
      <style:text-properties fo:font-size="11pt" fo:color="#263f38"/>
    </style:style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="1mm"/>
      <style:text-properties fo:font-size="11pt" fo:color="#263f38"/>
    </style:style>
    <style:style style:name="SectionHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="2mm" fo:margin-bottom="2mm"/>
      <style:text-properties fo:font-size="12.5pt" fo:font-weight="bold" fo:color="#263f38"/>
    </style:style>
    <style:style style:name="ChecklistHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="2mm" fo:margin-bottom="2mm"/>
      <style:text-properties fo:font-size="12.5pt" fo:font-weight="bold" fo:color="#263f38"/>
    </style:style>
    <style:style style:name="Bullet" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="2mm"/>
      <style:text-properties fo:font-size="11pt" fo:color="#263f38"/>
    </style:style>
    <style:style style:name="Source" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="2mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-size="10.5pt" fo:color="#263f38"/>
    </style:style>
    <style:style style:name="FooterText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-size="9pt" fo:color="#263f38"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" fo:margin-left="16.8mm" fo:margin-right="16.8mm" fo:margin-top="19.6mm" fo:margin-bottom="15mm" style:print-orientation="portrait"/>
      <style:footer-style>
        <style:header-footer-properties fo:min-height="6mm" fo:margin-left="0mm" fo:margin-right="0mm" fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      </style:footer-style>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout">
      <style:footer>
        <text:p text:style-name="FooterText">Ostro templates  ·  1</text:p>
      </style:footer>
    </style:master-page>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Kicker">OSTRO / WORKING TEMPLATES</text:p>
      <text:p text:style-name="Title">Website design proposal</text:p>
      <text:p text:style-name="Subtitle">Editable template · replace every bracketed field before use</text:p>
      <text:p text:style-name="Body">Prepared by: [your name or business]</text:p>
      <text:p text:style-name="Body">Prepared for: [client name]</text:p>
      <text:p text:style-name="Body">Date: [date]</text:p>
      <text:p text:style-name="SectionHeading">Project summary</text:p>
      <text:p text:style-name="Body">[Add your project summary here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="SectionHeading">Objectives and success criteria</text:p>
      <text:p text:style-name="Body">[Add your objectives and success criteria here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="SectionHeading">Deliverables</text:p>
      <text:p text:style-name="Body">[Add your deliverables here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="SectionHeading">Out of scope</text:p>
      <text:p text:style-name="Body">[Add your out of scope here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="SectionHeading">Timeline and milestones</text:p>
      <text:p text:style-name="Body">[Add your timeline and milestones here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="SectionHeading">Client responsibilities</text:p>
      <text:p text:style-name="Body">[Add your client responsibilities here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="SectionHeading">Commercial terms</text:p>
      <text:p text:style-name="Body">[Add your commercial terms here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="SectionHeading">Revisions and next steps</text:p>
      <text:p text:style-name="Body">[Add your revisions and next steps here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="ChecklistHeading">Before sending — remove this checklist</text:p>
      <text:p text:style-name="Bullet">• Replace the example scope with the actual client requirements.</text:p>
      <text:p text:style-name="Bullet">• Agree on included revisions, responsibilities and approval timing.</text:p>
      <text:p text:style-name="Bullet">• Review the price, schedule and acceptance process before sending.</text:p>
      <text:p text:style-name="Source">Template and example: https://tryostro.com/templates/website-design-proposal/</text:p>
    </office:text>
  </office:body>
</office:document>