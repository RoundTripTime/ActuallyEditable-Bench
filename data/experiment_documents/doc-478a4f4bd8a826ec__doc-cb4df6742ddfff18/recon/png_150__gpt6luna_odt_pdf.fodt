<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
 xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
 office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
 <office:styles>
  <style:default-style style:family="paragraph">
   <style:paragraph-properties fo:orphans="2" fo:widows="2"/>
   <style:text-properties style:font-name="Times New Roman" fo:font-size="14pt" fo:language="en" fo:country="US"/>
  </style:default-style>
  <style:style style:name="P" style:family="paragraph">
   <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="0mm" fo:line-height="100%"/>
   <style:text-properties style:font-name="Times New Roman" fo:font-size="14pt"/>
  </style:style>
  <style:style style:name="BoldUnder" style:family="text">
   <style:text-properties fo:font-weight="bold" style:text-underline-style="solid" style:text-underline-type="single"/>
  </style:style>
  <style:style style:name="Bold" style:family="text">
   <style:text-properties fo:font-weight="bold"/>
  </style:style>
 </office:styles>
 <office:automatic-styles>
  <style:page-layout style:name="PL1">
   <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" fo:margin-left="25mm" fo:margin-right="25mm" fo:margin-top="12mm" fo:margin-bottom="15mm"/>
  </style:page-layout>
  <style:style style:name="First" style:family="paragraph">
   <style:paragraph-properties fo:break-before="page" fo:margin-top="0mm" fo:margin-bottom="0mm" fo:line-height="100%"/>
   <style:text-properties style:font-name="Times New Roman" fo:font-size="14pt"/>
  </style:style>
  <style:style style:name="Box" style:family="paragraph">
   <style:paragraph-properties fo:margin-left="0mm" fo:margin-right="130mm" fo:margin-top="0mm" fo:margin-bottom="12mm" fo:padding="2mm" fo:border="0.25mm solid #b0b0b0"/>
   <style:text-properties style:font-name="Droid Sans Fallback" fo:font-size="12pt"/>
  </style:style>
  <style:style style:name="Title" style:family="paragraph">
   <style:paragraph-properties fo:text-align="center" fo:margin-top="0mm" fo:margin-bottom="18mm"/>
   <style:text-properties style:font-name="Times New Roman" fo:font-size="18pt" fo:font-weight="bold"/>
  </style:style>
  <style:style style:name="BodyLine" style:family="paragraph">
   <style:paragraph-properties fo:text-align="justify" fo:text-align-last="justify" fo:margin-top="0mm" fo:margin-bottom="4.3mm" fo:line-height="100%"/>
   <style:text-properties style:font-name="Times New Roman" fo:font-size="14pt"/>
  </style:style>
  <style:style style:name="LeftLine" style:family="paragraph">
   <style:paragraph-properties fo:text-align="start" fo:margin-top="0mm" fo:margin-bottom="4.3mm" fo:line-height="100%"/>
   <style:text-properties style:font-name="Times New Roman" fo:font-size="14pt"/>
  </style:style>
  <style:style style:name="Witness" style:family="paragraph">
   <style:paragraph-properties fo:margin-top="12mm" fo:margin-bottom="12mm"/>
   <style:text-properties style:font-name="Times New Roman" fo:font-size="14pt"/>
  </style:style>
  <style:style style:name="DateLine" style:family="paragraph">
   <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="20mm"/>
   <style:text-properties style:font-name="Times New Roman" fo:font-size="14pt"/>
  </style:style>
  <style:style style:name="SignLine" style:family="paragraph">
   <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="5mm" fo:line-height="100%"/>
   <style:text-properties style:font-name="Times New Roman" fo:font-size="14pt" fo:font-weight="bold"/>
  </style:style>
  <style:style style:name="PageNum" style:family="paragraph">
   <style:paragraph-properties fo:text-align="center" fo:margin-top="43mm"/>
   <style:text-properties style:font-name="Droid Sans Fallback" fo:font-size="10pt" fo:color="#666666"/>
  </style:style>
 </office:automatic-styles>
 <office:master-styles>
  <style:master-page style:name="Standard" style:page-layout-name="PL1"/>
 </office:master-styles>
 <office:body>
  <office:text>
   <text:p text:style-name="Box">附件一</text:p>
   <text:p text:style-name="Title">POWER OF ATTORNEY</text:p>
   <text:p text:style-name="BodyLine">We, <text:span text:style-name="BoldUnder">name of the company</text:span>, a company organized and existing under the laws</text:p>
   <text:p text:style-name="BodyLine">of <text:span text:style-name="BoldUnder">name of the country or area</text:span>, having its head office at <text:span text:style-name="BoldUnder">address of the</text:span></text:p>
   <text:p text:style-name="BodyLine"><text:span text:style-name="BoldUnder">company</text:span>, and has no fixed place of business in the Republic of China, hereby</text:p>
   <text:p text:style-name="BodyLine">appoint <text:span text:style-name="BoldUnder">name of the agent</text:span>, Taiwan, Republic of China, to act jointly and/or</text:p>
   <text:p text:style-name="BodyLine">severally, as our attorney-in-fact in the Republic of China, to file and</text:p>
   <text:p text:style-name="BodyLine">prosecute on our behalf all applications for the deemed profit basis which is</text:p>
   <text:p text:style-name="BodyLine">based on Article 25 of the Income Tax Law for <text:span text:style-name="BoldUnder">name of the project or kinds</text:span></text:p>
   <text:p text:style-name="LeftLine"><text:span text:style-name="BoldUnder">of activities</text:span> provided to <text:span text:style-name="BoldUnder">name of Taiwan customer.</text:span></text:p>
   <text:p text:style-name="Witness">IN WITNESS WHEREOF,</text:p>
   <text:p text:style-name="DateLine">We have executed this power-of-attorney on <text:span text:style-name="BoldUnder">date/month/year.</text:span></text:p>
   <text:p text:style-name="SignLine"><text:span text:style-name="BoldUnder">Name of the company</text:span>　　　　　　　　　　　<text:span text:style-name="BoldUnder">(type)</text:span></text:p>
   <text:p text:style-name="SignLine">　　　　　　　　　　　　　　　　<text:span text:style-name="BoldUnder">(signature)</text:span></text:p>
   <text:p text:style-name="SignLine"><text:span text:style-name="BoldUnder">Name of the authorized signature</text:span>　　　　　　<text:span text:style-name="BoldUnder">(type)</text:span></text:p>
   <text:p text:style-name="SignLine"><text:span text:style-name="BoldUnder">Job title</text:span>　＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿　<text:span text:style-name="BoldUnder">(type)</text:span></text:p>
   <text:p text:style-name="PageNum">第1頁</text:p>
  </office:text>
 </office:body>
</office:document>