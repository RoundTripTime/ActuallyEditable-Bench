<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
                 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
                 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
                 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
                 office:mimetype="application/vnd.oasis.opendocument.text"
                 office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:text-properties fo:font-family="Times New Roman" fo:font-size="16pt"/>
    </style:default-style>
    <style:style style:name="StrongUnderline" style:family="text">
      <style:text-properties fo:font-weight="bold" style:text-underline-style="solid" style:text-underline-type="single"/>
    </style:style>
    <style:style style:name="TitleText" style:family="text">
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm"
                                   fo:margin-left="3cm" fo:margin-right="2.5cm"
                                   fo:margin-top="1.2cm" fo:margin-bottom="1.2cm"
                                   style:print-orientation="portrait"/>
    </style:page-layout>
    <style:style style:name="Start" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0.5cm"
                                  fo:margin-right="11cm" fo:padding="0.12cm"
                                  fo:border="0.5pt solid #999999"/>
      <style:text-properties fo:font-family="Times New Roman" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Heading" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.15cm" fo:margin-bottom="1.35cm"/>
      <style:text-properties fo:font-family="Times New Roman" fo:font-size="20pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="MainLine" style:family="paragraph">
      <style:paragraph-properties fo:text-align="justify" fo:text-align-last="justify"
                                  fo:line-height="1.45" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Times New Roman" fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="Witness" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="1.6cm" fo:margin-bottom="1.05cm"/>
      <style:text-properties fo:font-family="Times New Roman" fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="DateLine" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0cm" fo:margin-bottom="1.85cm"/>
      <style:text-properties fo:font-family="Times New Roman" fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="SignatureLine" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:line-height="1.5" fo:margin-top="0cm" fo:margin-bottom="0.15cm"/>
      <style:text-properties fo:font-family="Times New Roman" fo:font-size="16pt" fo:font-weight="bold"
                             style:text-underline-style="solid" style:text-underline-type="single"/>
    </style:style>
    <style:style style:name="PageNumber" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="4.15cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Times New Roman" fo:font-size="11pt" fo:color="#666666"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="StandardPage" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Start">附件一</text:p>
      <text:p text:style-name="Heading">POWER OF ATTORNEY</text:p>
      <text:p text:style-name="MainLine">We, <text:span text:style-name="StrongUnderline">name of the company</text:span>, a company organized and existing under the laws</text:p>
      <text:p text:style-name="MainLine">of <text:span text:style-name="StrongUnderline">name of the country or area</text:span>, having its head office at <text:span text:style-name="StrongUnderline">address of the</text:span></text:p>
      <text:p text:style-name="MainLine"><text:span text:style-name="StrongUnderline">company</text:span>, and has no fixed place of business in the Republic of China, hereby</text:p>
      <text:p text:style-name="MainLine">appoint <text:span text:style-name="StrongUnderline">name of the agent</text:span>, Taiwan, Republic of China, to act jointly and/or</text:p>
      <text:p text:style-name="MainLine">severally, as our attorney-in-fact in the Republic of China, to file and</text:p>
      <text:p text:style-name="MainLine">prosecute on our behalf all applications for the deemed profit basis which is</text:p>
      <text:p text:style-name="MainLine">based on Article 25 of the Income Tax Law for <text:span text:style-name="StrongUnderline">name of the project or kinds</text:span></text:p>
      <text:p text:style-name="MainLine"><text:span text:style-name="StrongUnderline">of activities</text:span> provided to <text:span text:style-name="StrongUnderline">name of Taiwan customer.</text:span></text:p>
      <text:p text:style-name="Witness">IN WITNESS WHEREOF,</text:p>
      <text:p text:style-name="DateLine">We have executed this power-of-attorney on <text:span text:style-name="StrongUnderline">date/month/year.</text:span></text:p>
      <text:p text:style-name="SignatureLine">Name of the company　　　　　　　　　　　　　　　　　(type)</text:p>
      <text:p text:style-name="SignatureLine">　　　　　　　　　　　　　　　　　　　　　　　　　(signature)</text:p>
      <text:p text:style-name="SignatureLine">Name of the authorized signature　　　　　　　　　　　(type)</text:p>
      <text:p text:style-name="SignatureLine">Job title　____________________________________________________(type)</text:p>
      <text:p text:style-name="PageNumber">第1頁</text:p>
    </office:text>
  </office:body>
</office:document>