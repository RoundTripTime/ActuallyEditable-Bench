      <text:p text:style-name="Section">２　転用計画の概要</text:p>
      <text:p text:style-name="Subsection">（１）　転用目的</text:p>
      <text:p text:style-name="Subsection">（２）　転用時期</text:p>
      <text:p text:style-name="FormLine">イ　工事着手年月日　　　　　　　　年　　　月　　　日</text:p>
      <text:p text:style-name="FormLine">ロ　工事完了年月日　　　　　　　　年　　　月　　　日</text:p>
      <text:p text:style-name="PageStart">（３）　転用の目的に係る事業又は施設の概要</text:p>
      <table:table table:name="事業又は施設の概要" table:style-name="Table2">
        <table:table-column table:style-name="D1"/>
        <table:table-column table:style-name="D2"/>
        <table:table-column table:style-name="D3"/>
        <table:table-column table:style-name="D4"/>
        <table:table-column table:style-name="D5"/>
        <table:table-row>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="CellLeft">建築物又は</text:p><text:p text:style-name="CellLeft">施設の名称</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="CellLeft">建築物総棟数又</text:p><text:p text:style-name="CellLeft">は施設の総数</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="CellLeft">総建築面積又は</text:p><text:p text:style-name="CellLeft">総施設面積</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="CellCenter">所要全面積</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="CellCenter">備　　考</text:p></table:table-cell>
        </table:table-row>
