      <text:p text:style-name="Section">2　転用計画の概要</text:p>
      <text:p text:style-name="Subsection">（１）　転用目的</text:p>
      <text:p text:style-name="Subsection">（２）　転用時期</text:p>
      <text:p>　　　イ　工事着手年月日　　　　　年　　　月　　　日</text:p>
      <text:p>　　　ロ　工事完了年月日　　　　　年　　　月　　　日</text:p>
      <text:p text:style-name="PageBreak"/>
      <text:p text:style-name="Centered">（３）　転用の目的に係る事業又は施設の概要</text:p>
      <table:table table:name="FacilityOverview" table:style-name="TableB">
        <table:table-column table:style-name="BColA"/>
        <table:table-column table:style-name="BColB"/>
        <table:table-column table:style-name="BColC"/>
        <table:table-column table:style-name="BColD"/>
        <table:table-column table:style-name="BColE"/>
        <table:table-row>
          <table:table-cell table:style-name="HeadCell"><text:p text:style-name="LeftCell">建築物又は<text:line-break/>施設の名称</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p text:style-name="LeftCell">建築物総棟数又<text:line-break/>は施設の総数</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p text:style-name="LeftCell">総建築面積又は<text:line-break/>総施設面積</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p text:style-name="CenteredCell">所要全面積</text:p></table:table-cell>
