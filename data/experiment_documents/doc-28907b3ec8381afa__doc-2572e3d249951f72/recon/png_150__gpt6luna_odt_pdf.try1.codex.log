          <table:covered-table-cell table:style-name="HeadCell"/>
          <table:table-cell table:style-name="HeadCell" table:number-columns-spanned="2"><text:p text:style-name="CenteredCell">耕　作　者</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="HeadCell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="HeadCell"/>
