<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:text-properties fo:font-size="11pt" fo:font-family="serif"/>
      <style:paragraph-properties fo:line-height="1.2"/>
    </style:style>
    <style:style style:name="FormNo" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="1.1cm" fo:margin-bottom="1.3cm"/>
    </style:style>
    <style:style style:name="Date" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0.7cm" fo:margin-bottom="0.2cm" fo:margin-right="0.1cm"/>
    </style:style>
    <style:style style:name="Mayor" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.8cm" fo:margin-top="0.2cm" fo:margin-bottom="1.2cm"/>
    </style:style>
    <style:style style:name="AddressTitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="6.8cm" fo:margin-top="0cm" fo:margin-bottom="0.2cm"/>
    </style:style>
    <style:style style:name="AddressLabel" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="5.8cm" fo:margin-top="0cm" fo:margin-bottom="0.2cm"/>
    </style:style>
    <style:style style:name="Representative" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="5.8cm" fo:margin-top="0cm" fo:margin-bottom="1.1cm"/>
    </style:style>
    <style:style style:name="ApplicationText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.2cm" fo:margin-bottom="0cm" fo:line-height="1.2"/>
    </style:style>
    <style:style style:name="TableText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="CenterText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="RightText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="AttachmentText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.18cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.3cm" fo:margin-bottom="1.8cm" fo:margin-left="3cm" fo:margin-right="3cm"/>
    </style:page-layout>
    <style:style style:name="MainTable" style:family="table">
      <style:table-properties style:width="15cm" table:align="center"/>
    </style:style>
    <style:style style:name="LeftColumn" style:family="table-column">
      <style:table-column-properties style:column-width="4.25cm"/>
    </style:style>
    <style:style style:name="RightColumn" style:family="table-column">
      <style:table-column-properties style:column-width="10.75cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.12cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="AttachmentCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding-left="0.2cm" fo:padding-right="0.2cm" fo:padding-top="0.12cm" fo:padding-bottom="1.2cm" style:vertical-align="top"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="FormNo">様式第１号（第６条関係）</text:p>
      <text:p text:style-name="Title">尾道市生産性向上等促進事業補助金交付申請書</text:p>
      <text:p text:style-name="Date">年　　月　　日</text:p>
      <text:p text:style-name="Mayor">尾道市長　様</text:p>
      <text:p text:style-name="AddressTitle">住所及び所在地</text:p>
      <text:p text:style-name="AddressLabel">名　称</text:p>
      <text:p text:style-name="Representative">代表者職・氏名</text:p>
      <text:p text:style-name="ApplicationText">尾道市生産性向上等促進事業補助金の交付を受けたいので、尾道市生産性<br/>向上等促進事業補助金交付要綱第６条の規定により、関係書類を添えて申請<br/>します。</text:p>
      <table:table table:name="申請書" table:style-name="MainTable">
        <table:table-column table:style-name="LeftColumn"/>
        <table:table-column table:style-name="RightColumn"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="TableText">補助事業の名称</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CenterText">□　生産性向上枠　　□　ＤＸ推進枠</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="TableText">補助事業等の目的及び内容</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CenterText">別紙事業計画書のとおり</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="TableText">補助事業等に要する経費</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="RightText">円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="TableText">補助対象経費</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="RightText">円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="TableText">補助金交付申請額</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="RightText">円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:number-columns-spanned="2" table:style-name="AttachmentCell">
            <text:p text:style-name="TableText">添付書類</text:p>
            <text:p text:style-name="AttachmentText">1　事業計画書（別紙１）</text:p>
            <text:p text:style-name="AttachmentText">2　事業収支予算書（別紙２）</text:p>
            <text:p text:style-name="AttachmentText">3　法人登記簿謄本又は履歴事項証明書の写し（個人事業主にあっては、開業届又<br/>は許認可証の写し）</text:p>
            <text:p text:style-name="AttachmentText">4　事業所配置図及び位置図</text:p>
            <text:p text:style-name="AttachmentText">5　補助対象経費に係る見積書の写し</text:p>
            <text:p text:style-name="AttachmentText">6　導入する設備の概要を示したパンフレット等の写し</text:p>
            <text:p text:style-name="AttachmentText">7　設備を導入する事業所に常駐する従業員等の名簿の写し（別紙３）</text:p>
            <text:p text:style-name="AttachmentText">8　前期分の決算書の写し（個人事業主にあっては、前年分の所得税青色申告書又<br/>は収支内訳書の写し）</text:p>
            <text:p text:style-name="AttachmentText">9　市税の完納証明書（原本）</text:p>
            <text:p text:style-name="AttachmentText">10　誓約書兼同意書（別紙４）</text:p>
            <text:p text:style-name="AttachmentText">11　その他市長が必要と認める書類</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>