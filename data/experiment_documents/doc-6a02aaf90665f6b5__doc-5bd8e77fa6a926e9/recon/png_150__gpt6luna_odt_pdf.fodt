<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:text-properties fo:font-size="11pt"/>
    </style:default-style>
    <style:style style:name="TopLabel" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.9cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.25cm" fo:margin-bottom="0.95cm"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="Date" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0.3cm" fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="6cm" fo:line-height="0.78cm" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Narrative" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.85cm" fo:margin-bottom="0.05cm" fo:line-height="0.55cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="CellText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="0.55cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="0.55cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="CellRight" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="0.55cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="AttachmentHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="0.55cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="AttachmentItem" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0cm" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="0.67cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout1">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="1.5cm" fo:margin-bottom="2cm" fo:margin-left="3cm" fo:margin-right="3cm"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="15cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="LeftColumn" style:family="table-column">
      <style:table-column-properties style:column-width="4.25cm"/>
    </style:style>
    <style:style style:name="RightColumn" style:family="table-column">
      <style:table-column-properties style:column-width="10.75cm"/>
    </style:style>
    <style:style style:name="FormCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.16cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="AttachmentCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.2cm" style:vertical-align="top"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout1"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="TopLabel">様式第１号（第６条関係）</text:p>
      <text:p text:style-name="Title">尾道市生産性向上等促進事業補助金交付申請書</text:p>
      <text:p text:style-name="Date">年　月　日</text:p>
      <text:p text:style-name="Recipient">尾道市長　様</text:p>
      <text:p text:style-name="Recipient">住所及び所在地</text:p>
      <text:p text:style-name="Recipient">名　　　　称</text:p>
      <text:p text:style-name="Recipient">代表者職・氏名</text:p>
      <text:p text:style-name="Narrative">尾道市生産性向上等促進事業補助金の交付を受けたいので、尾道市生産性<text:line-break/>向上等促進事業補助金交付要綱第６条の規定により、関係書類を添えて申請<text:line-break/>します。</text:p>
      <table:table table:name="FormTable" table:style-name="FormTable">
        <table:table-column table:style-name="LeftColumn"/>
        <table:table-column table:style-name="RightColumn"/>
        <table:table-row>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellText">補助事業の名称</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellCenter">□　生産性向上枠　　□　ＤＸ推進枠</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellText">補助事業等の目的及び内容</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellCenter">別紙事業計画書のとおり</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellText">補助事業等に要する経費</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellRight">円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellText">補助対象経費</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellRight">円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellText">補助金交付申請額</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellRight">円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="AttachmentCell" table:number-columns-spanned="2">
            <text:p text:style-name="AttachmentHeading">添付書類</text:p>
            <text:p text:style-name="AttachmentItem">1　事業計画書（別紙１）</text:p>
            <text:p text:style-name="AttachmentItem">2　事業収支予算書（別紙２）</text:p>
            <text:p text:style-name="AttachmentItem">3　法人登記簿謄本又は履歴事項証明書の写し（個人事業主にあっては、開業届又<text:line-break/>　　は許認可証の写し）</text:p>
            <text:p text:style-name="AttachmentItem">4　事業所配置図及び位置図</text:p>
            <text:p text:style-name="AttachmentItem">5　補助対象経費に係る見積書の写し</text:p>
            <text:p text:style-name="AttachmentItem">6　導入する設備の概要を示したパンフレット等の写し</text:p>
            <text:p text:style-name="AttachmentItem">7　設備を導入する事業所に常駐する従業員等の名簿の写し（別紙３）</text:p>
            <text:p text:style-name="AttachmentItem">8　前期分の決算書の写し（個人事業主にあっては、前年度分の所得税青色申告書又<text:line-break/>　　は収支内訳書の写し）</text:p>
            <text:p text:style-name="AttachmentItem">9　市税の完納証明書（原本）</text:p>
            <text:p text:style-name="AttachmentItem">10　誓約書兼同意書（別紙４）</text:p>
            <text:p text:style-name="AttachmentItem">11　その他市長が必要と認める書類</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>