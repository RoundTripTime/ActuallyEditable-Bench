<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right"/>
    </style:style>
    <style:style style:name="Applicant" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="50mm"/>
    </style:style>
    <style:style style:name="Centered" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="BodyText" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0mm" fo:margin-right="0mm" fo:line-height="150%"/>
    </style:style>
    <style:style style:name="Footnote" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0mm" fo:margin-right="0mm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" style:print-orientation="portrait" fo:margin-left="30mm" fo:margin-right="30mm" fo:margin-top="35mm" fo:margin-bottom="30mm"/>
    </style:page-layout>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="30mm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="30mm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="83mm"/>
    </style:style>
    <style:style style:name="FormCell" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:border="0.75pt solid #000000" fo:padding="1.5mm"/>
    </style:style>
    <style:style style:name="CenteredCell" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:border="0.75pt solid #000000" fo:padding="1.5mm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">様式第１号（第５条関係）</text:p>
      <text:p text:style-name="Right">令和　　年　　月　　日</text:p>
      <text:p/>
      <text:p>塙町長　宮田秀利　様</text:p>
      <text:p/>
      <text:p text:style-name="Applicant">申請者　住所</text:p>
      <text:p text:style-name="Applicant">団体名</text:p>
      <text:p text:style-name="Applicant">代表者氏名　　　　　　　　　　　　　　　　印</text:p>
      <text:p text:style-name="Applicant">電　話</text:p>
      <text:p/>
      <text:p/>
      <text:p text:style-name="Centered">塙町除雪機械購入費補助金交付申請書</text:p>
      <text:p/>
      <text:p text:style-name="BodyText">塙町除雪機械購入費補助金交付要綱第５条の規定により、下記のとおり補助金の</text:p>
      <text:p text:style-name="BodyText">交付を申請します。</text:p>
      <text:p/>
      <table:table table:name="申請書">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-row>
          <table:table-cell table:style-name="FormCell" table:number-rows-spanned="3">
            <text:p text:style-name="Centered">購入予定の</text:p>
            <text:p text:style-name="Centered">除雪機械</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="Centered">メーカー名</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="Centered">機種名</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="Centered">型　式</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="2">
            <text:p text:style-name="Centered">購入予定金額（見積額）</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="Centered">円（消費税込み）</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="2">
            <text:p text:style-name="Centered">補助金申請額</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="Centered">円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="2">
            <text:p text:style-name="Centered">添付書類</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell">
            <text:p>１　カタログ等</text:p>
            <text:p>２　販売店の見積書</text:p>
            <text:p>３　その他（　組合規約　　　　）</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p/>
      <text:p text:style-name="Footnote">※ 補助金申請額は、購入予定金額の３分の２の額です。</text:p>
      <text:p text:style-name="Footnote">（　１，０００円未満の端数切り捨て。上限５０，０００円）</text:p>
    </office:text>
  </office:body>
</office:document>