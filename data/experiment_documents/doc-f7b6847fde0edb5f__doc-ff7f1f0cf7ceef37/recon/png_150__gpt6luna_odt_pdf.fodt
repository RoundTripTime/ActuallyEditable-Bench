<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:line-height="150%" fo:margin-top="0cm" fo:margin-bottom="0.18cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="150%" fo:margin-top="1.45cm" fo:margin-bottom="0.75cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="150%" fo:margin-top="0cm" fo:margin-bottom="0.18cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:line-height="150%" fo:margin-top="0cm" fo:margin-bottom="0.18cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:line-height="150%" fo:margin-top="0.35cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="2.9cm" fo:margin-right="2.9cm" fo:margin-top="2.5cm" fo:margin-bottom="2.5cm" style:print-orientation="portrait"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="14.3cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="2.92cm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="2.92cm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="8.46cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="150%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="CellCenterP" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="150%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="CellLeftP" style:family="paragraph">
      <style:paragraph-properties fo:text-align="left" fo:line-height="150%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Body">様式第１号（第５条関係）</text:p>
      <text:p text:style-name="Right">令和　　年　　月　　日</text:p>
      <text:p text:style-name="Body">塙町長　宮 田 秀 利　様</text:p>
      <text:p text:style-name="Body">申請者　住　所</text:p>
      <text:p text:style-name="Body">　団体名</text:p>
      <text:p text:style-name="Body">　代表者氏名　　　　　　　　　　　　　　　㊞</text:p>
      <text:p text:style-name="Body">　　電　話</text:p>
      <text:p text:style-name="Title">塙町除雪機械購入費補助金交付申請書</text:p>
      <text:p text:style-name="Body">　塙町除雪機械購入費補助金交付要綱第５条の規定により、下記のとおり補助金の交付を申請します。</text:p>
      <table:table table:name="Form" table:style-name="FormTable">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="3">
            <text:p text:style-name="CellCenterP">購入予定の<text:line-break/>除雪機械</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellCenterP">メーカー名</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellLeftP"/>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellCenterP">機種名</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellLeftP"/>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellCenterP">型　式</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellLeftP"/>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2">
            <text:p text:style-name="CellCenterP">購入予定金額（見積額）</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellCenterP">円（消費税込み）</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2">
            <text:p text:style-name="CellCenterP">補助金申請額</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellCenterP">円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2">
            <text:p text:style-name="CellCenterP">添付書類</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellLeftP">１　カタログ等</text:p>
            <text:p text:style-name="CellLeftP">２　販売店の見積書</text:p>
            <text:p text:style-name="CellLeftP">３　その他（　組合規約　　　　　）</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Note">※　補助金申請額は、購入予定金額の３分の２の額です。</text:p>
      <text:p text:style-name="Body">　（１，０００円未満の端数切り捨て。上限５００，０００円）</text:p>
    </office:text>
  </office:body>
</office:document>