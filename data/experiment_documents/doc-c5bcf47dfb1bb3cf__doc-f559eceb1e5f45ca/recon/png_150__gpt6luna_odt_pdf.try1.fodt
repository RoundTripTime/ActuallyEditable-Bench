<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="9pt" style:font-name="Noto Sans Devanagari"/>
    </style:default-style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
    <style:style style:name="Centered" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="17cm" table:align="margins"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:padding="0.08cm" fo:border="0.5pt solid #000000"/>
    </style:style>
    <style:style style:name="HeadCell" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:padding="0.08cm" fo:border="0.5pt solid #000000"/>
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="SmallText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="8pt" style:font-name="Noto Sans Devanagari"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.4cm" fo:margin-bottom="1.4cm" fo:margin-left="2.2cm" fo:margin-right="2.2cm"/>
    </style:page-layout>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="2.4cm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="3.2cm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="2.2cm"/>
    </style:style>
    <style:style style:name="ColD" style:family="table-column">
      <style:table-column-properties style:column-width="2.2cm"/>
    </style:style>
    <style:style style:name="ColE" style:family="table-column">
      <style:table-column-properties style:column-width="2.2cm"/>
    </style:style>
    <style:style style:name="ColF" style:family="table-column">
      <style:table-column-properties style:column-width="4.8cm"/>
    </style:style>
    <style:style style:name="WideCol" style:family="table-column">
      <style:table-column-properties style:column-width="8.5cm"/>
    </style:style>
    <style:style style:name="MedCol" style:family="table-column">
      <style:table-column-properties style:column-width="4.2cm"/>
    </style:style>
    <style:style style:name="NarrowCol" style:family="table-column">
      <style:table-column-properties style:column-width="2.1cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Centered">避難者カード【ネパール】</text:p>
      <text:p>शिविर कार्ड (अगाडिको भाग)　【様式－７】</text:p>
      <text:p>उदाहरण　 मिति　 साल　 महिना　 दिन　 कृपया प्रत्येक घरको लागि सूची बनाउनुहोस्।</text:p>
      <table:table table:name="FormPage1" table:style-name="FormTable">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColD"/>
        <table:table-column table:style-name="ColE"/>
        <table:table-column table:style-name="ColF"/>
        <table:table-row>
          <table:table-cell table:style-name="HeadCell"><text:p>शिविर मिति र समय</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>साल</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>महिना</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>दिन</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>समय</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>समूह－ नम्बर.</text:p><text:p>－</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>शिविर केन्द्र</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>निकास स्थल　・ घर ・ अन्यत्र （　　　　　　　　　）</text:p><text:p>※ गाउँमा बसोबास गर्नेहरूले, कृपया पार्किङको स्थान लेख्नुहोस्</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>छिमेकी संघको नाम</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>※ बासिन्दा संघमा सामेल नभएकाहरूले “सामेल नभएको” भनेर लेख्नुहोस्।</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>शिविरमा भ्याएको बेलालाई गोलो लगाउनुहोस्</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>कतागाना नाम</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>उमेर</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>लिंग</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>नाता</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>नोट* विशेष हेरचाह आवश्यक पर्ने व्यक्तिको संख्या वर्णन गर्नुहोस्</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>(मुख्य व्यक्ति)</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>वर्ष</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>पुरुष ・ महिला ・ अन्य</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="HeadCell"><text:p>वर्ष</text:p></table:table-cell><table:table-cell table:style-name="HeadCell"><text:p>पुरुष ・ महिला ・ अन्य</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="HeadCell"><text:p>वर्ष</text:p></table:table-cell><table:table-cell table:style-name="HeadCell"><text:p>पुरुष ・ महिला ・ अन्य</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="HeadCell"><text:p>वर्ष</text:p></table:table-cell><table:table-cell table:style-name="HeadCell"><text:p>पुरुष ・ महिला ・ अन्य</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="HeadCell"><text:p>वर्ष</text:p></table:table-cell><table:table-cell table:style-name="HeadCell"><text:p>पुरुष ・ महिला ・ अन्य</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeadCell"><text:p>ठेगाना</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>〒</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeadCell"><text:p>घर मुलिको नम्बर</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>（　　　　　）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeadCell"><text:p>घर पालुवा जनावर</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>छ　・　छैन　　※छ भने घरपालुवा जनावर फरम भर्नुहोस्।</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeadCell"><text:p>विशेष हेरचाह आवश्यक व्यक्तिहरू</text:p><text:p>※ सम्बन्धित व्यक्तिको नम्बर</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>1 गर्भवती महिला,　2 शिशु,　3 अपाङ्गता भएका व्यक्तिहरू（　　　　　　　）</text:p><text:p>4 दीर्घकालीन हेरचाह प्राप्तकर्ताहरू</text:p><text:p>5 मेडिकल उपकरण प्रयोगकर्ताहरू（　　　　　　　）</text:p><text:p>6 एलर्जी（　　　　）　7 विदेशी नागरिक(देशको नाम　　　　　)</text:p><text:p>8 अन्य（　　　　　　　　　　　　　　）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p>※　 विशेष ध्यान चाहिने व्यक्तिहरू हुन्, जसलाई शिविर जीवनको लागि विशेष हेरचाह आवश्यक पर्दछ, जस्तै गर्भवती महिला, शिशुहरू, र अपाङ्गता भएका व्यक्तिहरू।</text:p>
      <text:p>शिविर कार्ड (पछाडिको भाग)　　　　　　　　　　　　　　【様式－７】</text:p>
      <text:p>पछाडिको विवरण स्थिति ठीक भएपिछि भर्दा फरक पर्दैन।</text:p>
      <text:p text:style-name="PageBreak"/>
      <table:table table:name="FormPage2" table:style-name="FormTable">
        <table:table-column table:style-name="WideCol"/>
        <table:table-column table:style-name="MedCol"/>
        <table:table-column table:style-name="NarrowCol"/>
        <table:table-column table:style-name="NarrowCol"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>सुरक्षा पुष्टिको लागि जानकारीको खुलासा (चाहनुहुन्छ” वा चाहनुहुन्न ” मा गोलो लगाउनुहोस्)</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>के तपाईं वेबसाइट वा मिडिया मार्फत उद्धारकर्ताहरूको जानकारी खुलासा गर्न चाहनुहुन्छ?</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>चाहनुहुन्छ / चाहनुहुन्न</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>के तपाईं आफन्तहरू, घरका साथीहरू, र परिचितहरूबाट सुरक्षा सोधपुछको जवाफमा विस्थापित जानकारी प्रदान गर्न चाहनुहुन्छ?</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>चाहनुहुन्छ / चाहनुहुन्न</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>आवास क्षति</text:p><text:p>*कृपया क्षति भएका सबै वस्तुहरू गोलो लगाउनुहोस्</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>छ / छैन　* यदि “छ” भने, कृपया घरको क्षतिको अवस्थालाई विस्तृत रूपमा वर्णन गर्नुहोस्।</text:p><text:p>※वर्णन उदाहरण</text:p><text:p>・ घर भत्किएको छ र अहिले बस्न सक्ने अवस्थामा छैन।</text:p><text:p>　・ कोठा सफा गर्यो भने, आफ्नो घर फर्कन सक्छु</text:p><text:p>बत्ती बन्द，　 पानी बन्द，　 ग्यास बन्द，　 टेलिफोन अवरोध</text:p><text:p>अन्य（　　　　　　　　　　　）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>पीडितको जानकारी</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>कृपया तपाईंको नाम र तपाईंको चोट वा रोगको विस्तृत स्थिति बारे बताउनुहोस्।</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>शिविर</text:p><text:p>(स्थानान्तरण गर्नुपर्ने)</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>शिविरबारे जानकारी</text:p><text:p>（शिविरको ठेगाना）</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>अन्य विशेष नोट (यदि तपाईंको पास योग्यता है और आप सहयोग कर सकते हैं, तो कृपया अपना नाम और सामग्री दर्ज करें।)</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p>〈 शिविर संचालन समितिको भर्ने विवरण 〉</text:p>
      <table:table table:name="CampCommittee" table:style-name="FormTable">
        <table:table-column table:style-name="MedCol"/>
        <table:table-column table:style-name="NarrowCol"/>
        <table:table-column table:style-name="NarrowCol"/>
        <table:table-column table:style-name="NarrowCol"/>
        <table:table-row><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>प्रस्थान मिति</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>साल</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>महिना</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>दिन</text:p></table:table-cell>
        </table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>प्रस्थान स्थान</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"><text:p>फोन नम्बर</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p>※　आश्रयस्थलको सुचारु सञ्चालनका लागि, आश्रित व्यक्तिहरू (घरमै बसेर आश्रय लिने वा गाडीमा बसेर आश्रय लिने व्यक्तिहरू समेत) ले पनि सम्भव भएसम्म आश्रयस्थल सञ्चालनमा सहयोग गर्न अनुरोध गरिन्छ।</text:p>
    </office:text>
  </office:body>
</office:document>