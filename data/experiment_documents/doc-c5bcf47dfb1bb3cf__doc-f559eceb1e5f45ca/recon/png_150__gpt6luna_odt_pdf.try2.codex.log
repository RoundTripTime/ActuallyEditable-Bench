          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="HeadCell"><text:p>वर्ष</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>पुरुष ・ महिला ・ अन्य</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
