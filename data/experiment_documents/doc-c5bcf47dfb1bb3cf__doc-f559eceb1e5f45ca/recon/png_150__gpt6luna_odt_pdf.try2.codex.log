        <table:table-column table:style-name="C6"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="6"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeadCell"><text:p>प्रस्थान मिति</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>साल</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>महिना</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>दिन</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p/></table:table-cell><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeadCell"><text:p>प्रस्थान स्थान</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p/></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="HeadCell"><text:p>फोन नम्बर</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p/></table:table-cell><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p>※　आश्रयस्थलको सुधार सञ्चालनका लागि, आश्रित व्यक्तिहरू (घरमै बसेर आश्रय लिने वा गाडीमा बसेर आश्रय लिने व्यक्तिहरू समेत) ले पनि सम्भव भएसम्म आश्रयस्थल सञ्चालनमा सहयोग गर्न अनुरोध गरिन्छ।</text:p>
    </office:text>
  </office:body>
