        <table:table-row><table:table-cell table:style-name="Cell"><text:p>घर मुलिको नम्बर</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>（　　　　　　　　　）</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>घर पालुवा जनावर</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>छ　 ・　 छैन　 ※छ भने घरपालुवा जनावर फरम भर्नुहोस्।</text:p></table:table-cell></table:table-row>
