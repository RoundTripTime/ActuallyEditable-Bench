<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:font-size="10pt"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:default-style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
    <style:style style:name="Grid" style:family="table">
      <style:table-properties table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08in" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HeadCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08in" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="BoldCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08in" style:vertical-align="middle"/>
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="C1" style:family="table-column">
      <style:table-column-properties style:column-width="1.3in"/>
    </style:style>
    <style:style style:name="C2" style:family="table-column">
      <style:table-column-properties style:column-width="1.8in"/>
    </style:style>
    <style:style style:name="C3" style:family="table-column">
      <style:table-column-properties style:column-width="0.8in"/>
    </style:style>
    <style:style style:name="C4" style:family="table-column">
      <style:table-column-properties style:column-width="0.65in"/>
    </style:style>
    <style:style style:name="C5" style:family="table-column">
      <style:table-column-properties style:column-width="0.85in"/>
    </style:style>
    <style:style style:name="C6" style:family="table-column">
      <style:table-column-properties style:column-width="2.2in"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="8.27in" fo:page-height="11.69in" fo:print-orientation="portrait" fo:margin-top="0.72in" fo:margin-bottom="0.72in" fo:margin-left="0.78in" fo:margin-right="0.78in"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p/>
      <text:p>避難者カード【ネパール</text:p>
      <text:p>उदाहरण　　　 शिविर कार्ड（आगाडिको भाग）　　　【様式－७】</text:p>
      <text:p>मिति　　साल　　महिना　　दिन　 कृपया प्रत्येक घरको लागि सूची बनाउनुहोस्।</text:p>
      <table:table table:name="मुख्य विवरण" table:style-name="Grid">
        <table:table-column table:style-name="C1"/>
        <table:table-column table:style-name="C2"/>
        <table:table-column table:style-name="C3"/>
        <table:table-column table:style-name="C4"/>
        <table:table-column table:style-name="C5"/>
        <table:table-column table:style-name="C6"/>
        <table:table-row>
          <table:table-cell table:style-name="HeadCell"><text:p>शिविर मिति र समय</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>साल</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>महिना</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>दिन</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>समय</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell" table:number-rows-spanned="3"><text:p>समूह－ नम्बर.</text:p><text:p>－</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>शिविर केन्द्र</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p>निकास स्थल　・ घर ・ अत्रैत्र （　　　　　　　　　）</text:p><text:p>※गाडीमा बसोबास गर्नुहुनेलो, कृपया पार्किङको स्थान लेख्नुहोस्</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>छिमेकी संघको नाम</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p>※ बासिन्दा संघमा सामेल नभएकाहरूले “सामेल नभएको” भनेर लेख्नुहोस्।</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BoldCell"><text:p>शिविर मा भएकोव्यक्ति विवरण गोला लगाउनुहोस्</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>कतागाना नाम</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>उमेर</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>लिंग</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>नाता</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>नोट* विशेष हेरचाह आवश्यक पर्ने व्यक्तिको संख्या वर्णन गर्नुहोस्</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>(मुख्य व्यक्ति)</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="HeadCell"><text:p>वर्ष</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>पुरुष ・ महिला ・ अन्य</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="HeadCell"><text:p>वर्ष</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>पुरुष ・ महिला ・ अन्य</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="HeadCell"><text:p>वर्ष</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>पुरुष ・ महिला ・ अन्य</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="HeadCell"><text:p>वर्ष</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>पुरुष ・ महिला ・ अन्य</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="HeadCell"><text:p>वर्ष</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>पुरुष ・ महिला ・ अन्य</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeadCell">ठेगाना</table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p>〒</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeadCell"><text:p>घर मुलिको नम्बर</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p>（　　　　　　　　）</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeadCell"><text:p>घर पालुवा जनावर</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p>छ　・　छैन　 ※छ भने घरपालुवा जनावर फरम भर्नुहोस्।</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BoldCell"><text:p>विशेष हेरचाह आवश्यक व्यक्तिहरू</text:p><text:p>※ सम्बन्धित व्यक्तिको नम्बर</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5">
            <text:p>1 गर्भवती महिला,　2 शिशु,　3 अपाङ्गता भएका व्यक्तिहरू（　　　　　　　　）</text:p>
            <text:p>4 दीर्घकालीन हेरचाह प्राप्तकर्ताहरू</text:p>
            <text:p>5 मेडिकल उपकरण प्रयोगकर्ताहरू（　　　　　　　　）</text:p>
            <text:p>6 एलर्जी（　　　　　　）　7 विदेशी नागरिक（देशको नाम　　　　　　）</text:p>
            <text:p>8 अत्रै（　　　　　　　　　　　　　　　　　）</text:p>
          </table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p>※　विशेष ध्यान चाहिने व्यक्तिहरू ती हुन् जसलाई शिविर जीवनको लागि विशेष हेरचाह आवश्यक पर्दछ, जस्तै गर्भवती महिला, शिशुहरू, र अपाङ्गता भएका व्यक्तिहरू।</text:p>
      <text:p>शिविर कार्ड（पछाडिको भाग）　　　　　　　　　　　　　　　　【様式－७】</text:p>
      <text:p>पछाडिको विवरण स्थिति ठीक भएपछी भर्दा फरक पर्दैन।</text:p>
      <text:p text:style-name="PageStart"/>
      <table:table table:name="सुरक्षा र अवस्था" table:style-name="Grid">
        <table:table-column table:style-name="C1"/>
        <table:table-column table:style-name="C2"/>
        <table:table-column table:style-name="C3"/>
        <table:table-column table:style-name="C4"/>
        <table:table-column table:style-name="C5"/>
        <table:table-column table:style-name="C6"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="6"><text:p>सुरक्षा पुष्टिको लागि जानकारीको खुलासा（चाहनुहुन्छ” वा चाहनुहुन्न ” मा गोलो लगाउनुहोस्）</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p>के तपाईँ वेबसाइट वा मिडिया मार्फत उद्धारकर्ताहरूको जानकारी खुलासा गर्न चाहनुहुन्छ?</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="HeadCell" table:number-columns-spanned="2"><text:p>चाहनुहुन्छ / चाहँदैन</text:p></table:table-cell><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p>के तपाईँ आफन्तहरू, घरका साथीहरू, र परिचितहरूबाट सुरक्षा सोधपुछको जवाफमा विस्थापित जानकारी प्रदान गर्न चाहनुहुन्छ?</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="HeadCell" table:number-columns-spanned="2"><text:p>चाहनुहुन्छ / चाहँदैन</text:p></table:table-cell><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeadCell" table:number-rows-spanned="3"><text:p>आवास क्षति</text:p><text:p>*कृपया क्षति भएका सबै वस्तुहरू गोला लगाउनुहोस्</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p>छ / छैन　 * यदि “छ” भने, कृपया घरको क्षतिको अवस्थालाई विस्तृत रूपमा वर्णन गर्नुहोस्।</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p>※वर्णन उदाहरण</text:p><text:p>・ घर भत्किएको छ र अहिले बस्न सक्ने अवस्थामा छैन।</text:p><text:p>　・ कोठा सफा गर्यो भने, आफ्नो घर फर्कन सक्नुहुन्छ</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p>बत्ती बन्द，　 पानी बन्द，　 ग्यास बन्द，　 टेलिफोन अवरोध</text:p><text:p>अत्रै（　　　　　　　　　）</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BoldCell" table:number-columns-spanned="6"><text:p>पीडितको जानकारी</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="6"><text:p>कृपया तपाईंको नाम र तपाईंको चोट वा रोगको विस्तृत स्थिति बारे बताउनुहोस्।</text:p><text:p/><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>शिविर</text:p><text:p>（स्थानान्तरण गन्तव्य）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>शिविरबारे जानकारी</text:p><text:p>（शिविरको ठेगाना）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="6"><text:p>अन्य विशेष नोट (यदि तपाईंको पास योग्यता छ र तपाईं सहयोग गर्न सक्नुहुन्छ, तो कृपया आफ्नो नाम र सामग्री दर्ज करें।)</text:p><text:p/><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p>〈 शिविर संचालन समितिले भर्ने विवरण 〉</text:p>
      <table:table table:name="शिविर संचालन" table:style-name="Grid">
        <table:table-column table:style-name="C1"/>
        <table:table-column table:style-name="C2"/>
        <table:table-column table:style-name="C3"/>
        <table:table-column table:style-name="C4"/>
        <table:table-column table:style-name="C5"/>
        <table:table-column table:style-name="C6"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="6"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeadCell"><text:p>प्रस्थान मिति</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>साल</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>महिना</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell"><text:p>दिन</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p/></table:table-cell><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeadCell"><text:p>प्रस्थान स्थान</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p/></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="HeadCell"><text:p>फोन नम्बर</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p/></table:table-cell><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p>※　आश्रयस्थलको सुधार सञ्चालनका लागि, आश्रित व्यक्तिहरू (घरमै बसेर आश्रय लिने वा गाडीमा बसेर आश्रय लिने व्यक्तिहरू समेत) ले पनि सम्भव भएसम्म आश्रयस्थल सञ्चालनमा सहयोग गर्न अनुरोध गरिन्छ।</text:p>
    </office:text>
  </office:body>
</office:document>