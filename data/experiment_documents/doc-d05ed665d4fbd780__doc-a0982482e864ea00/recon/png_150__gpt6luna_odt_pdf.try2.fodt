  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">（ 様式 第２号 ）</text:p>
      <text:p text:style-name="Title">育 成（子ども）会</text:p>
      <text:p text:style-name="Subtitle">令和　　年度 予算書・令和　　年度(前年度) 決算書</text:p>
      <text:p text:style-name="Section">〔 収 入 〕<text:tab/>単位：円</text:p>
