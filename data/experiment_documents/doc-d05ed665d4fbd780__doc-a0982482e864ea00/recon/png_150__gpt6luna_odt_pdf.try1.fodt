  <office:body>
    <office:text>
      <text:p text:style-name="PageMark">（　様式 第2号　）</text:p>
      <text:p text:style-name="MainTitle"><text:span text:style-name="Underlined">育 成（子ども）会</text:span></text:p>
      <text:p text:style-name="Subtitle">令和　年度 予算書・令和　年度(前年度) 決算書</text:p>
      <text:p text:style-name="SectionLabel">〔 収 入 〕<text:tab/>単位：円</text:p>
      <table:table table:name="収入">
        <table:table-column table:style-name="IncomeCol1"/>
        <table:table-column table:style-name="IncomeCol2"/>
        <table:table-column table:style-name="IncomeCol3"/>
        <table:table-column table:style-name="IncomeCol4"/>
        <table:table-row table:style-name="IncomeHeaderRow">
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="Centered">科　目</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="Centered">令和　年度<text:line-break/>予 算 額</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="Centered">令和　年度<text:line-break/>（前年度）<text:line-break/>決 算 額</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="Centered">令和　年度（前年度）<text:line-break/>決算説明および備考</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="IncomeBodyRow"><table:table-cell table:style-name="TableCell"><text:p text:style-name="LeftCell">町補助金</text:p></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="IncomeBodyRow"><table:table-cell table:style-name="TableCell"><text:p text:style-name="LeftCell">ふるさと教室補助金</text:p></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="IncomeBodyRow"><table:table-cell table:style-name="TableCell"><text:p text:style-name="LeftCell">環境美化補助金</text:p></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="IncomeBodyRow"><table:table-cell table:style-name="TableCell"><text:p text:style-name="LeftCell">区補助金</text:p></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="IncomeBodyRow"><table:table-cell table:style-name="TableCell"><text:p text:style-name="LeftCell">会　費</text:p></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="IncomeBodyRow"><table:table-cell table:style-name="TableCell"><text:p text:style-name="LeftCell">寄 付 金</text:p></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="IncomeBodyRow"><table:table-cell table:style-name="TableCell"><text:p text:style-name="LeftCell">繰 越 金</text:p></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="IncomeBodyRow"><table:table-cell table:style-name="TableCell"><text:p text:style-name="LeftCell">そ の 他</text:p></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="IncomeBodyRow"><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="IncomeBodyRow"><table:table-cell table:style-name="TableCell"><text:p text:style-name="LeftCell">雑入</text:p></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="IncomeBodyRow"><table:table-cell table:style-name="TableCellDoubleTop"><text:p text:style-name="Centered">合　計</text:p></table:table-cell><table:table-cell table:style-name="TableCellDoubleTop"><text:p/></table:table-cell><table:table-cell table:style-name="TableCellDoubleTop"><text:p/></table:table-cell><table:table-cell table:style-name="TableCellDoubleTop"><text:p/></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="Gap"/>
      <text:p text:style-name="SectionLabel">〔 支 出 〕<text:tab/>単位：円</text:p>
