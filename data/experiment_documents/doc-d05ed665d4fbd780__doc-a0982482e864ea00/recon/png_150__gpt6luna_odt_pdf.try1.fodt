        <table:table-row table:style-name="ExpenseBodyRow"><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell><table:table-cell table:style-name="TableCell"><text:p/></table:table-cell><table:table-cell table:style-name="TableCellDouble"><text:p/></table:table-cell></table:table-row>
