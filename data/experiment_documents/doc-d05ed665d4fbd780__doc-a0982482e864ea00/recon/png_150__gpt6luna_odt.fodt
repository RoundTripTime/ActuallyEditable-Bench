<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:font-size="10pt" fo:margin-top="0cm" fo:margin-bottom="0.12cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="TopLine" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:text-align="left" fo:font-size="10pt" fo:margin-top="0cm" fo:margin-bottom="0.55cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:font-size="16pt" fo:margin-top="0cm" fo:margin-bottom="0.05cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:font-size="13pt" fo:margin-top="0cm" fo:margin-bottom="0.55cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="13pt"/>
    </style:style>
    <style:style style:name="SectionLabel" style:family="paragraph">
      <style:paragraph-properties fo:text-align="left" fo:font-size="11pt" fo:margin-top="0.14cm" fo:margin-bottom="0.05cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="UnitLabel" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:font-size="10pt" fo:margin-top="0.14cm" fo:margin-bottom="0.05cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Footer" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:font-size="8pt" fo:margin-top="0.6cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="8pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="2.3cm" fo:margin-right="2.3cm" fo:margin-top="1cm" fo:margin-bottom="1cm"/>
    </style:page-layout>
    <style:style style:name="IncomeTable" style:family="table">
      <style:table-properties style:width="16.4cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ExpenseTable" style:family="table">
      <style:table-properties style:width="16.4cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ICol1" style:family="table-column">
      <style:table-column-properties style:column-width="3.28cm"/>
    </style:style>
    <style:style style:name="ICol2" style:family="table-column">
      <style:table-column-properties style:column-width="2.48cm"/>
    </style:style>
    <style:style style:name="ICol3" style:family="table-column">
      <style:table-column-properties style:column-width="2.48cm"/>
    </style:style>
    <style:style style:name="ICol4" style:family="table-column">
      <style:table-column-properties style:column-width="8.16cm"/>
    </style:style>
    <style:style style:name="ECol1" style:family="table-column">
      <style:table-column-properties style:column-width="3.18cm"/>
    </style:style>
    <style:style style:name="ECol2" style:family="table-column">
      <style:table-column-properties style:column-width="2.46cm"/>
    </style:style>
    <style:style style:name="ECol3" style:family="table-column">
      <style:table-column-properties style:column-width="2.46cm"/>
    </style:style>
    <style:style style:name="ECol4" style:family="table-column">
      <style:table-column-properties style:column-width="6.3cm"/>
    </style:style>
    <style:style style:name="ECol5" style:family="table-column">
      <style:table-column-properties style:column-width="2cm"/>
    </style:style>
    <style:style style:name="HeadRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.18cm"/>
    </style:style>
    <style:style style:name="DataRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.69cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.04cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:font-size="10pt" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="LeftCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding-left="0.2cm" fo:padding-right="0.04cm" fo:padding-top="0.04cm" fo:padding-bottom="0.04cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="left" fo:font-size="10pt" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="CenterCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.04cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center" fo:font-size="10pt" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="NarrowCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.02cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center" fo:font-size="8pt" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="95%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="8pt"/>
    </style:style>
    <style:style style:name="IncomeTotalRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.69cm"/>
    </style:style>
    <style:style style:name="ExpenseTotalRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.69cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="TopLine">（様式 第２号）</text:p>
      <text:p text:style-name="Title">育成（子ども）会</text:p>
      <text:p text:style-name="Subtitle">令和　年度　予算書・令和　年度(前年度) 決算書</text:p>
      <text:p text:style-name="SectionLabel">［ 収　入 ］</text:p>
      <text:p text:style-name="UnitLabel">単位：円</text:p>
      <table:table table:name="収入" table:style-name="IncomeTable">
        <table:table-column table:style-name="ICol1"/>
        <table:table-column table:style-name="ICol2"/>
        <table:table-column table:style-name="ICol3"/>
        <table:table-column table:style-name="ICol4"/>
        <table:table-row table:style-name="HeadRow">
          <table:table-cell table:style-name="CenterCell"><text:p>科　目</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p>令和　年度<text:line-break/>予 算 額</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p>令和　年度<text:line-break/>（前年度）<text:line-break/>決 算 額</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p>令和　年度（前年度）<text:line-break/>決算説明および備考</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="LeftCell"><text:p>町補助金</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="LeftCell"><text:p>ふるさと教室補助金</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="LeftCell"><text:p>環境美化補助金</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="LeftCell"><text:p>区補助金</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="LeftCell"><text:p>会　費</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="LeftCell"><text:p>寄 付 金</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="LeftCell"><text:p>繰 越 金</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="LeftCell"><text:p>そ の 他</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="LeftCell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="LeftCell"><text:p>雑入</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="IncomeTotalRow">
          <table:table-cell table:style-name="CenterCell"><text:p>合　計</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="SectionLabel">［ 支　出 ］</text:p>
      <text:p text:style-name="UnitLabel">単位：円</text:p>
      <table:table table:name="支出" table:style-name="ExpenseTable">
        <table:table-column table:style-name="ECol1"/>
        <table:table-column table:style-name="ECol2"/>
        <table:table-column table:style-name="ECol3"/>
        <table:table-column table:style-name="ECol4"/>
        <table:table-column table:style-name="ECol5"/>
        <table:table-row table:style-name="HeadRow">
          <table:table-cell table:style-name="CenterCell"><text:p>科　目</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p>令和　年度<text:line-break/>予 算 額</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p>令和　年度<text:line-break/>（前年度）<text:line-break/>決 算 額</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p>令和　年度（前年度）<text:line-break/>決算説明および備考</text:p></table:table-cell>
          <table:table-cell table:style-name="NarrowCell"><text:p>補助対象<text:line-break/>経　費<text:line-break/>※記入しない</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DataRow" table:number-rows-repeated="16">
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="LeftCell"><text:p>次年度繰越金</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ExpenseTotalRow">
          <table:table-cell table:style-name="CenterCell"><text:p>合　計</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Footer">当年度　予算書・前年度　決算書 230310</text:p>
    </office:text>
  </office:body>
</office:document>