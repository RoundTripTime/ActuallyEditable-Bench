<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
 xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
 office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
 <office:styles>
  <style:default-style style:family="paragraph">
   <style:paragraph-properties fo:margin="0pt" fo:line-height="100%"/>
   <style:text-properties style:font-name="Microsoft JhengHei" fo:font-size="12pt"/>
  </style:default-style>
  <style:style style:name="Body" style:family="paragraph">
   <style:paragraph-properties fo:margin="0pt" fo:line-height="100%"/>
  </style:style>
  <style:style style:name="Centered" style:family="paragraph">
   <style:paragraph-properties fo:margin="0pt" fo:line-height="100%" fo:text-align="center"/>
  </style:style>
  <style:style style:name="Title" style:family="paragraph">
   <style:paragraph-properties fo:margin="0pt" fo:line-height="100%" fo:text-align="center"/>
   <style:text-properties fo:font-size="14pt" fo:font-weight="bold"/>
  </style:style>
  <style:style style:name="SmallText" style:family="paragraph">
   <style:paragraph-properties fo:margin="0pt" fo:line-height="100%"/>
   <style:text-properties fo:font-size="10pt"/>
  </style:style>
  <style:style style:name="PageStart" style:family="paragraph">
   <style:paragraph-properties fo:break-before="page" fo:margin="0pt" fo:line-height="1pt"/>
   <style:text-properties fo:font-size="1pt"/>
  </style:style>
 </office:styles>
 <office:automatic-styles>
  <style:page-layout style:name="PageLayout">
   <style:page-layout-properties fo:page-width="210.01mm" fo:page-height="297mm"
    fo:margin-left="19.45mm" fo:margin-right="21.6mm" fo:margin-top="21.4mm"
    fo:margin-bottom="12mm" style:print-orientation="portrait"/>
  </style:page-layout>
  <style:style style:name="GridTable" style:family="table">
   <style:table-properties fo:width="169mm" table:align="left"/>
  </style:style>
  <style:style style:name="Column" style:family="table-column">
   <style:table-column-properties style:use-optimal-column-width="false"/>
  </style:style>
  <style:style style:name="Row" style:family="table-row">
   <style:table-row-properties style:use-optimal-row-height="false"/>
  </style:style>
  <style:style style:name="Cell" style:family="table-cell">
   <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.2mm" style:vertical-align="middle"/>
   <style:paragraph-properties fo:margin="0pt" fo:line-height="100%"/>
  </style:style>
  <style:style style:name="TopCell" style:family="table-cell">
   <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.2mm" style:vertical-align="top"/>
   <style:paragraph-properties fo:margin="0pt" fo:line-height="100%"/>
  </style:style>
  <style:style style:name="Col1" style:family="table-column"><style:table-column-properties style:column-width="16.4mm"/></style:style>
  <style:style style:name="Col2" style:family="table-column"><style:table-column-properties style:column-width="20.6mm"/></style:style>
  <style:style style:name="Col3" style:family="table-column"><style:table-column-properties style:column-width="12.7mm"/></style:style>
  <style:style style:name="Col4" style:family="table-column"><style:table-column-properties style:column-width="24.9mm"/></style:style>
  <style:style style:name="Col5" style:family="table-column"><style:table-column-properties style:column-width="20.8mm"/></style:style>
  <style:style style:name="Col6" style:family="table-column"><style:table-column-properties style:column-width="29.1mm"/></style:style>
  <style:style style:name="Col7" style:family="table-column"><style:table-column-properties style:column-width="21.8mm"/></style:style>
  <style:style style:name="Col8" style:family="table-column"><style:table-column-properties style:column-width="22.7mm"/></style:style>
  <style:style style:name="RTitle" style:family="table-row"><style:table-row-properties style:row-height="9.5mm"/></style:style>
  <style:style style:name="RHeader" style:family="table-row"><style:table-row-properties style:row-height="12.9mm"/></style:style>
  <style:style style:name="RPerson" style:family="table-row"><style:table-row-properties style:row-height="26.95mm"/></style:style>
  <style:style style:name="RAgency" style:family="table-row"><style:table-row-properties style:row-height="18mm"/></style:style>
  <style:style style:name="RClaim" style:family="table-row"><style:table-row-properties style:row-height="97.9mm"/></style:style>
  <style:style style:name="WideCol" style:family="table-column"><style:table-column-properties style:column-width="169mm"/></style:style>
  <style:style style:name="RFact" style:family="table-row"><style:table-row-properties style:row-height="69.7mm"/></style:style>
  <style:style style:name="RReason" style:family="table-row"><style:table-row-properties style:row-height="66.1mm"/></style:style>
  <style:style style:name="FactTable" style:family="table">
   <style:table-properties fo:width="169mm" table:align="left"/>
  </style:style>
  <style:style style:name="TwoLine" style:family="paragraph">
   <style:paragraph-properties fo:margin="0pt" fo:line-height="100%" fo:text-align="center"/>
  </style:style>
  <style:style style:name="Signature" style:family="paragraph">
   <style:paragraph-properties fo:margin-left="61mm" fo:margin-top="0pt" fo:margin-bottom="0pt" fo:line-height="100%"/>
   <style:text-properties fo:font-size="14pt"/>
  </style:style>
  <style:style style:name="AfterTable" style:family="paragraph">
   <style:paragraph-properties fo:margin-top="7mm" fo:margin-bottom="0pt" fo:line-height="100%"/>
   <style:text-properties fo:font-size="14pt"/>
  </style:style>
  <style:style style:name="SpacedLine" style:family="paragraph">
   <style:paragraph-properties fo:margin-top="7mm" fo:margin-bottom="0pt" fo:line-height="100%"/>
   <style:text-properties fo:font-size="14pt"/>
  </style:style>
  <style:style style:name="DateLine" style:family="paragraph">
   <style:paragraph-properties fo:margin-top="7mm" fo:margin-bottom="0pt" fo:line-height="100%"/>
   <style:text-properties fo:font-size="14pt"/>
  </style:style>
  <style:style style:name="FooterLine" style:family="paragraph">
   <style:paragraph-properties fo:margin-top="3mm" fo:margin-bottom="0pt" fo:line-height="100%" fo:text-align="end"/>
   <style:text-properties fo:font-size="10pt"/>
  </style:style>
 </office:automatic-styles>
 <office:master-styles>
  <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
 </office:master-styles>
 <office:body>
  <office:text>
   <text:p text:style-name="Body"><text:span text:style-name="Body"/></text:p>
   <text:p text:style-name="Body"><text:span text:style-name="Body"/></text:p>
   <table:table table:name="訴願書基本資料" table:style-name="GridTable">
    <table:table-column table:style-name="Col1"/>
    <table:table-column table:style-name="Col2"/>
    <table:table-column table:style-name="Col3"/>
    <table:table-column table:style-name="Col4"/>
    <table:table-column table:style-name="Col5"/>
    <table:table-column table:style-name="Col6"/>
    <table:table-column table:style-name="Col7"/>
    <table:table-column table:style-name="Col8"/>
    <table:table-row table:style-name="RTitle">
     <table:table-cell table:style-name="Cell" table:number-columns-spanned="8"><text:p text:style-name="Title">訴願書</text:p></table:table-cell>
     <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
    </table:table-row>
    <table:table-row table:style-name="RHeader">
     <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">稱　謂</text:p></table:table-cell>
     <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Centered">姓名（公司名稱）</text:p></table:table-cell>
     <table:covered-table-cell/><table:covered-table-cell/>
     <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">出生年月日</text:p></table:table-cell>
     <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">國民身分證統一編號</text:p></table:table-cell>
     <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Centered">住所或居所</text:p></table:table-cell>
     <table:covered-table-cell/>
     <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">聯絡電話</text:p></table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="RPerson">
     <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">訴願人</text:p></table:table-cell>
     <table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="RPerson">
     <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">代表人</text:p></table:table-cell>
     <table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="RPerson">
     <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">代理人</text:p></table:table-cell>
     <table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="RAgency">
     <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>原行政處分機關</text:p></table:table-cell><table:covered-table-cell/>
     <table:table-cell table:style-name="Cell" table:number-columns-spanned="6"><text:p/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
    </table:table-row>
    <table:table-row table:style-name="RAgency">
     <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>行政處分書</text:p><text:p>發文日期及文號</text:p></table:table-cell><table:covered-table-cell/>
     <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
     <table:table-cell table:style-name="Cell"><text:p>訴願人收受或知</text:p><text:p>悉行政處分之年</text:p><text:p>月日</text:p></table:table-cell>
     <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="RClaim">
     <table:table-cell table:style-name="TopCell" table:number-columns-spanned="8"><text:p>訴願請求</text:p></table:table-cell>
     <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
    </table:table-row>
   </table:table>
   <text:p text:style-name="FooterLine">勞動部印製</text:p>
   <text:p text:style-name="PageStart"/>
   <table:table table:name="事實與理由" table:style-name="FactTable">
    <table:table-column table:style-name="WideCol"/>
    <table:table-row table:style-name="RFact">
     <table:table-cell table:style-name="TopCell"><text:p>事實</text:p></table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="RReason">
     <table:table-cell table:style-name="TopCell"><text:p>理由</text:p></table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="AfterTable">此　致</text:p>
   <text:p text:style-name="SpacedLine">（原行政處分機關全銜）</text:p>
   <text:p text:style-name="Signature">訴願人　　（簽名或蓋章）</text:p>
   <text:p text:style-name="Signature">代表人　　（簽名或蓋章）</text:p>
   <text:p text:style-name="Signature">代理人　　（簽名或蓋章）</text:p>
   <text:p text:style-name="DateLine">中　華　民　國　　　　年　　　　月　　　　日</text:p>
   <text:p text:style-name="SpacedLine">附　件：</text:p>
   <text:p text:style-name="SpacedLine">副　本　已　於　　　　年　　　　月　　　　日　抄　送　訴　願　管　轄　機　關</text:p>
   <text:p text:style-name="FooterLine">勞動部印製</text:p>
  </office:text>
 </office:body>
</office:document>