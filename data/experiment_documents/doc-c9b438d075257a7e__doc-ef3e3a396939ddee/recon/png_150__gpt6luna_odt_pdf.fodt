<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:default-style>
    <style:style style:name="TitleOne" style:family="paragraph" style:master-page-name="PageOne">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="2cm" fo:margin-bottom="0.25cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="TitleTwo" style:family="paragraph" style:master-page-name="PageTwo">
      <style:paragraph-properties fo:break-before="page" fo:text-align="center" fo:margin-top="2cm" fo:margin-bottom="0.25cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="Centered" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin="0cm" fo:line-height="100%"/>
    </style:style>
    <style:style style:name="SmallText" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="BodyText" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="GridTable" style:family="table">
      <style:table-properties style:width="18.1cm" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="PageOneTable" style:family="table">
      <style:table-properties style:width="18.1cm" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="PageTwoTable" style:family="table">
      <style:table-properties style:width="18cm" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.03cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.05cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="TopCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="P1C1" style:family="table-column">
      <style:table-column-properties style:column-width="1.46cm"/>
    </style:style>
    <style:style style:name="P1C2" style:family="table-column">
      <style:table-column-properties style:column-width="0.95cm"/>
    </style:style>
    <style:style style:name="P1C3" style:family="table-column">
      <style:table-column-properties style:column-width="10.48cm"/>
    </style:style>
    <style:style style:name="P1C4" style:family="table-column">
      <style:table-column-properties style:column-width="1.59cm"/>
    </style:style>
    <style:style style:name="P1C5" style:family="table-column">
      <style:table-column-properties style:column-width="1.59cm"/>
    </style:style>
    <style:style style:name="P1C6" style:family="table-column">
      <style:table-column-properties style:column-width="2.05cm"/>
    </style:style>
    <style:style style:name="P2C1" style:family="table-column">
      <style:table-column-properties style:column-width="0.85cm"/>
    </style:style>
    <style:style style:name="P2C2" style:family="table-column">
      <style:table-column-properties style:column-width="4.02cm"/>
    </style:style>
    <style:style style:name="P2C3" style:family="table-column">
      <style:table-column-properties style:column-width="1.27cm"/>
    </style:style>
    <style:style style:name="P2C4" style:family="table-column">
      <style:table-column-properties style:column-width="4.23cm"/>
    </style:style>
    <style:style style:name="P2C5" style:family="table-column">
      <style:table-column-properties style:column-width="1.27cm"/>
    </style:style>
    <style:style style:name="P2C6" style:family="table-column">
      <style:table-column-properties style:column-width="1.27cm"/>
    </style:style>
    <style:style style:name="P2C7" style:family="table-column">
      <style:table-column-properties style:column-width="1.27cm"/>
    </style:style>
    <style:style style:name="P2C8" style:family="table-column">
