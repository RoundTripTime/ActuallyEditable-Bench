        <table:table-row><table:table-cell table:style-name="C" table:number-columns-spanned="5"><text:p text:style-name="PL">□ 抵押權登記</text:p></table:table-cell><table:table-cell table:style-name="C" table:number-columns-spanned="7"><text:p text:style-name="PL">□ 設定　□ 法定　□</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="C" table:number-columns-spanned="5"><text:p text:style-name="PL">□ 抵押權塗銷登記</text:p></table:table-cell><table:table-cell table:style-name="C" table:number-columns-spanned="7"><text:p text:style-name="PL">□ 清償　□ 拋棄　□ 混同　□ 判決塗銷　□</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
