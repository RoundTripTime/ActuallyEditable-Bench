<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
                 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
                 xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
                 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
                 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
                 office:mimetype="application/vnd.oasis.opendocument.text"
                 office:version="1.4">
  <office:styles>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.25cm" fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-size="16pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0.05cm" fo:margin-bottom="0.1cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:text-align="right" fo:margin-top="0cm" fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="CenteredDate" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.55cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="125%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="CellLeft" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="125%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="18.8cm" table:align="margins" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="2.7cm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="3.1cm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="2.3cm"/>
    </style:style>
    <style:style style:name="ColD" style:family="table-column">
      <style:table-column-properties style:column-width="4.15cm"/>
    </style:style>
    <style:style style:name="ColE" style:family="table-column">
      <style:table-column-properties style:column-width="2.75cm"/>
    </style:style>
    <style:style style:name="ColF" style:family="table-column">
      <style:table-column-properties style:column-width="3.8cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.14cm" style:vertical-align="middle"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="1.1cm" fo:margin-right="1.1cm" fo:margin-top="1.1cm" fo:margin-bottom="1.1cm" style:print-orientation="portrait"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Right">附件二</text:p>
      <text:p text:style-name="Title">新北市政府徵收補償費預約到府服務申請書</text:p>
      <text:p text:style-name="Right">114.8 版本</text:p>
      <table:table table:name="申請表" table:style-name="FormTable">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColD"/>
        <table:table-column table:style-name="ColE"/>
        <table:table-column table:style-name="ColF"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">應受補償人</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">出生日期</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">身分證字號</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">申請人</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">與應受補償人關係</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellLeft">□本人</text:p><text:p text:style-name="CellLeft">□___</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">連絡電話</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">申請到府服務原因</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5">
            <text:p text:style-name="CellLeft">□　65 歲以上。</text:p>
            <text:p text:style-name="CellLeft">□　領有「中華民國身心障礙手冊」且屬視覺障礙、聽覺機能障礙、平衡機能障礙、下肢肢體障礙、重要器官失去功能或其他障礙等確為行動不便者。</text:p>
            <text:p text:style-name="CellLeft">□　持醫院開立之「醫療證明」確為行動不便者。</text:p>
            <text:p text:style-name="CellLeft">□　5 人以上於同一地點受理（無資格條件限制）。</text:p>
            <text:p text:style-name="CellLeft">□　領有孕婦健康手冊。</text:p>
            <text:p text:style-name="CellLeft">□　其他特殊狀況者________________。</text:p>
            <text:p text:style-name="CellLeft"/>
            <text:p text:style-name="CellLeft">＊應受補償人須意識清楚。</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">適宜到府時間</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p text:style-name="CellLeft"/><text:p text:style-name="Right">（以週一至週五 9:00~19:00 為限）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">到府地址</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p text:style-name="CellLeft"/></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">應附證明文件</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5">
            <text:p text:style-name="CellLeft">1. 應受補償人身分證明文件影本(如申請人與應受補償人非同一人，請一併檢附</text:p>
            <text:p text:style-name="CellLeft">　　申請人身分證明文件影本)</text:p>
            <text:p text:style-name="CellLeft">2. 證明文件(請擇一檢附)：</text:p>
            <text:p text:style-name="CellLeft">　□身心障礙手冊　□醫療證明　□孕婦健康手冊　□其他______________</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">徵收不動產資訊</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5">
            <text:p text:style-name="CellLeft">工程名稱：</text:p>
            <text:p text:style-name="CellLeft">新北市____區_____段_____小段_____地/建號</text:p>
            <text:p text:style-name="CellLeft">保管字號：___年保管字第_____號</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">備註</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p text:style-name="CellLeft"/></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">蓋章</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">應受補償人</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="CellCenter"/></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">申請人</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter"/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageStart">附件二</text:p>
      <table:table table:name="簽章列續頁" table:style-name="FormTable">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColD"/>
        <table:table-column table:style-name="ColE"/>
        <table:table-column table:style-name="ColF"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter"/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="CenteredDate">中華民國　年　月　日</text:p>
    </office:text>
  </office:body>
</office:document>