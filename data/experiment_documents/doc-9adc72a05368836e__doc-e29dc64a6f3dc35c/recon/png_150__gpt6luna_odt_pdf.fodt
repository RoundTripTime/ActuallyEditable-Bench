<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="115%"/>
      <style:text-properties fo:font-size="10pt" style:font-size-asian="10pt"/>
    </style:style>
    <style:style style:name="Centered" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:text-align="right"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="Centered">
      <style:paragraph-properties fo:margin-top="0.75cm" fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-size="16pt" style:font-size-asian="16pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Header" style:family="paragraph" style:parent-style-name="Right">
      <style:text-properties fo:font-size="12pt" style:font-size-asian="12pt"/>
    </style:style>
    <style:style style:name="Version" style:family="paragraph" style:parent-style-name="Right">
      <style:paragraph-properties fo:margin-bottom="0.12cm"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.12cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="LabelCell" style:family="table-cell" style:parent-style-name="Cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.1cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Column" style:family="table-column">
      <style:table-column-properties style:column-width="2.62cm"/>
    </style:style>
    <style:style style:name="Column2" style:family="table-column">
      <style:table-column-properties style:column-width="3cm"/>
    </style:style>
    <style:style style:name="Column3" style:family="table-column">
      <style:table-column-properties style:column-width="0.25cm"/>
    </style:style>
    <style:style style:name="Column4" style:family="table-column">
      <style:table-column-properties style:column-width="2cm"/>
    </style:style>
    <style:style style:name="Column5" style:family="table-column">
      <style:table-column-properties style:column-width="2.52cm"/>
    </style:style>
    <style:style style:name="Column6" style:family="table-column">
      <style:table-column-properties style:column-width="1.48cm"/>
    </style:style>
    <style:style style:name="Column7" style:family="table-column">
      <style:table-column-properties style:column-width="0.82cm"/>
    </style:style>
    <style:style style:name="Column8" style:family="table-column">
      <style:table-column-properties style:column-width="1.83cm"/>
    </style:style>
    <style:style style:name="Column9" style:family="table-column">
      <style:table-column-properties style:column-width="3.57cm"/>
    </style:style>
    <style:style style:name="LargeCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.18cm" style:vertical-align="middle"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.2cm" fo:margin-bottom="1.2cm" fo:margin-left="1.45cm" fo:margin-right="1.45cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout">
      <style:header>
        <text:p text:style-name="Header">附件二</text:p>
      </style:header>
    </style:master-page>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">新北市政府徵收補償費預約到府服務申請書</text:p>
      <text:p text:style-name="Version">114.8 版本</text:p>
      <table:table table:name="申請表">
        <table:table-column table:style-name="Column"/>
        <table:table-column table:style-name="Column2"/>
        <table:table-column table:style-name="Column3"/>
        <table:table-column table:style-name="Column4"/>
        <table:table-column table:style-name="Column5"/>
        <table:table-column table:style-name="Column6"/>
        <table:table-column table:style-name="Column7"/>
        <table:table-column table:style-name="Column8"/>
        <table:table-column table:style-name="Column9"/>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Centered">應受補償人</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="LabelCell"><text:p text:style-name="Centered">出生日期</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"/>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="LabelCell"><text:p text:style-name="Centered">身分證字號</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Centered">申請人</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="LabelCell"><text:p text:style-name="Centered">與應受補償人關係</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell">
            <text:p>□本人</text:p>
            <text:p>□___</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="LabelCell"><text:p text:style-name="Centered">連絡電話</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="Centered">申請到府服</text:p>
            <text:p text:style-name="Centered">務原因</text:p>
          </table:table-cell>
          <table:table-cell table:number-columns-spanned="8" table:style-name="LargeCell">
            <text:p>□　65 歲以上。</text:p>
            <text:p>□　領有「中華民國身心障礙手冊」且屬視覺障礙、聽覺機能障礙、平衡機能障</text:p>
            <text:p>　　礙、下肢肢體障礙、重要器官失去功能或其他障礙等確為行動不便者。</text:p>
            <text:p>□　持醫院開立之「醫療證明」確為行動不便者。</text:p>
            <text:p>□　5 人以上並於同一地點受理 ( 無資格條件限制 )。</text:p>
            <text:p>□　領有孕婦健康手冊。</text:p>
            <text:p>□　其他特殊狀況者________________。</text:p>
            <text:p/>
            <text:p>* 應受補償人須意識清楚。</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Centered">適宜到府時間</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="8" table:style-name="Cell"><text:p text:style-name="Right">(以週一至週五 9:00~19:00 為限)</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Centered">到府</text:p><text:p text:style-name="Centered">地址</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="8" table:style-name="Cell"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Centered">應附證明文</text:p><text:p text:style-name="Centered">件</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="8" table:style-name="LargeCell">
            <text:p>1. 應受補償人身分證明文件影本（如申請人與應受補償人非同一人，請一併檢附</text:p>
            <text:p>　申請人身分證明文件影本）</text:p>
            <text:p/>
            <text:p>2. 證明文件（請擇一檢附）：</text:p>
            <text:p>　□身心障礙手冊□醫療證明□孕婦健康手冊□其他____________</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Centered">徵收不動產</text:p><text:p text:style-name="Centered">資訊</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="8" table:style-name="LargeCell">
            <text:p>工程名稱：</text:p>
            <text:p>新北市____區____段____小段____地/建號</text:p>
            <text:p>保管字號：___年保管字第____號</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Centered">備註</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="8" table:style-name="Cell"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Centered">蓋章</text:p></table:table-cell>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Centered">應受補償人</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="Cell"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="LabelCell"><text:p text:style-name="Centered">申請人</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageBreak"/>
      <table:table table:name="簽章欄續頁">
        <table:table-column table:style-name="Column"/>
        <table:table-column table:style-name="Column2"/>
        <table:table-column table:style-name="Column3"/>
        <table:table-column table:style-name="Column4"/>
        <table:table-column table:style-name="Column5"/>
        <table:table-column table:style-name="Column6"/>
        <table:table-column table:style-name="Column7"/>
        <table:table-column table:style-name="Column8"/>
        <table:table-column table:style-name="Column9"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:number-columns-spanned="3" table:style-name="Cell"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"/>
          <table:covered-table-cell/>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p/>
      <text:p text:style-name="Centered">中華民國　年　月　日</text:p>
    </office:text>
  </office:body>
</office:document>