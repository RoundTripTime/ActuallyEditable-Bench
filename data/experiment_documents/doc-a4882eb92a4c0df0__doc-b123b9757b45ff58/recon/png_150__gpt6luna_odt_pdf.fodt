<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%"/>
      <style:text-properties style:font-name="MS Mincho" fo:font-size="11pt"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph"/>
    <style:style style:name="Left" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="start"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="end"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="164mm" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ColumnA" style:family="table-column">
      <style:table-column-properties style:column-width="26mm"/>
    </style:style>
    <style:style style:name="ColumnB" style:family="table-column">
      <style:table-column-properties style:column-width="51mm"/>
    </style:style>
    <style:style style:name="ColumnC" style:family="table-column">
      <style:table-column-properties style:column-width="87mm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="2mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="table-cell" style:parent-style-name="Cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="2mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="TableCenter" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" fo:margin-left="20mm" fo:margin-right="20mm" fo:margin-top="18mm" fo:margin-bottom="18mm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Body" fo:margin-top="25mm">様式第１（第４条関係）</text:p>
      <text:p text:style-name="Right">年　　月　　日</text:p>
      <text:p text:style-name="Body" fo:margin-top="10mm">東　郷　町　長　殿</text:p>
      <text:p text:style-name="Left" fo:margin-left="75mm">住所</text:p>
      <text:p text:style-name="Left" fo:margin-left="75mm">団体名</text:p>
      <text:p text:style-name="Left" fo:margin-left="75mm">代表者氏名</text:p>
      <text:p text:style-name="Center" fo:margin-top="12mm">東郷町老人クラブ助成事業補助金交付申請書</text:p>
      <text:p text:style-name="Body" fo:margin-top="10mm">年度において下記のとおり　　　　　　　　　　　老人クラブの事業を実施したいので、</text:p>
      <text:p text:style-name="Body">東郷町補助金等交付規則第３条の規定により補助金の交付を申請します。</text:p>
      <text:p text:style-name="Center" fo:margin-top="10mm" fo:margin-bottom="10mm">記</text:p>
      <table:table table:name="申請補助事業内容" table:style-name="FormTable">
        <table:table-column table:style-name="ColumnA"/>
        <table:table-column table:style-name="ColumnB"/>
        <table:table-column table:style-name="ColumnC"/>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-columns-spanned="2"><text:p text:style-name="TableCenter">申請補助事業内容</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Left">□　老人クラブ活動事業</text:p><text:p text:style-name="Left">□　花壇管理事業</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-rows-spanned="3"><text:p text:style-name="TableCenter">申請金額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Left">老人クラブ活動事業①</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（単位数_____・会員数_____）</text:p><text:p text:style-name="Left">金　　　　　　　　　　　　　　　　　円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Left">花壇管理事業②</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">（花壇管理面積　計_____m²）</text:p><text:p text:style-name="Left">金　　　　　　　　　　　　　　　　　円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Left">合計（①＋②）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Left">金　　　　　　　　　　　　　　　　　円</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body" fo:margin-top="9mm"/>
      <table:table table:name="添付書類" table:style-name="FormTable">
        <table:table-column table:style-name="ColumnA"/>
        <table:table-column table:style-name="ColumnB"/>
        <table:table-column table:style-name="ColumnC"/>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-rows-spanned="2"><text:p text:style-name="TableCenter">添付書類</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Left">老人クラブ活動事業</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Left">(1)事業計画(2)歳入歳出予算書(3)会員名簿</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Left">花壇管理事業</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Left">(1)花壇事業計画(2)花壇位置図(3)求積図</text:p></table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>