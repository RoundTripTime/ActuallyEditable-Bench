<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Head" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.2cm"/>
    </style:style>
    <style:style style:name="Date" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0.4cm" fo:margin-bottom="1.0cm"/>
    </style:style>
    <style:style style:name="Addr" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:margin-left="0.4cm" fo:margin-top="0.2cm" fo:margin-bottom="0.2cm"/>
    </style:style>
    <style:style style:name="Fields" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:margin-left="8.0cm" fo:margin-top="0.15cm" fo:margin-bottom="0.15cm"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="1.0cm" fo:margin-bottom="1.1cm"/>
    </style:style>
    <style:style style:name="BodyText" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:margin-top="0.2cm" fo:margin-bottom="0.2cm"/>
    </style:style>
    <style:style style:name="Record" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.8cm" fo:margin-bottom="0.7cm"/>
    </style:style>
    <style:style style:name="CellP" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="CenterCellP" style:family="paragraph" style:parent-style-name="CellP">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="2.4cm" fo:margin-bottom="2.4cm" fo:margin-left="2.5cm" fo:margin-right="2.5cm"/>
    </style:page-layout>
    <style:style style:name="Grid" style:family="table">
      <style:table-properties style:width="16cm" table:align="center"/>
    </style:style>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="2.6cm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="5cm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="8.4cm"/>
    </style:style>
    <style:style style:name="GridCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellCentered" style:family="table-cell" style:parent-style-name="GridCell">
      <style:table-cell-properties style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Head">様式第１　（第４条関係）</text:p>
      <text:p text:style-name="Date">年　　月　　日</text:p>
      <text:p text:style-name="Addr">東　郷　町　長　　殿</text:p>
      <text:p text:style-name="Fields">住　所</text:p>
      <text:p text:style-name="Fields">団体名</text:p>
      <text:p text:style-name="Fields">代表者氏名</text:p>
      <text:p text:style-name="Title">東郷町老人クラブ助成事業補助金交付申請書</text:p>
      <text:p text:style-name="BodyText">年度において下記のとおり　　　　　　　　　老人クラブの事業を実施したいので、</text:p>
      <text:p text:style-name="BodyText">東郷町補助金等交付規則第３条の規定により補助金の交付を申請します。</text:p>
      <text:p text:style-name="Record">記</text:p>
      <table:table table:name="申請書" table:style-name="Grid">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-row>
          <table:table-cell table:style-name="CellCentered" table:number-columns-spanned="2"><text:p text:style-name="CenterCellP">申請補助事業内容</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="CellCentered"/>
          <table:table-cell table:style-name="GridCell">
            <text:p text:style-name="CellP">□　老人クラブ活動事業</text:p>
            <text:p text:style-name="CellP">□　花壇管理事業</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCentered" table:number-rows-spanned="3"><text:p text:style-name="CenterCellP">申請金額</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellP">老人クラブ活動事業①</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell">
            <text:p text:style-name="CenterCellP">（単位数＿＿＿＿・会員数＿＿＿＿）</text:p>
            <text:p text:style-name="CellP">金　　　　　　　　　　　　　　　　　　　　　　　円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="CellCentered"/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellP">花壇管理事業②</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell">
            <text:p text:style-name="CenterCellP">（花壇管理面積　計＿＿＿＿　m²）</text:p>
            <text:p text:style-name="CellP">金　　　　　　　　　　　　　　　　　　　　　　　円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="CellCentered"/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellP">合計（①＋②）</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellP">金　　　　　　　　　　　　　　　　　　　　　　　円</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="CellP"> </text:p>
      <table:table table:name="添付書類" table:style-name="Grid">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-row>
          <table:table-cell table:style-name="CellCentered" table:number-rows-spanned="2"><text:p text:style-name="CenterCellP">添付書類</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellP">老人クラブ活動事業</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellP">(1)事業計画(2)歳入歳出予算書(3)会員名簿</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="CellCentered"/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellP">花壇管理事業</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellP">(1)花壇事業計画(2)花壇位置図(3)求積図</text:p></table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>