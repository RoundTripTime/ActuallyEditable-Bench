   <text:p text:style-name="RedText">112.07.01 啟用版</text:p>
   <text:p text:style-name="Title">身心障礙證明申請表</text:p>
   <text:p text:style-name="Section">一、個人基本資料</text:p>
   <table:table table:name="PersonalData" table:style-name="FormTable">
    <table:table-column table:style-name="LabelCol"/>
    <table:table-column table:style-name="InputCol"/>
    <table:table-row><table:table-cell table:style-name="Cell"><text:p>縣市</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>鄉鎮市區</text:p></table:table-cell></table:table-row>
    <table:table-row><table:table-cell table:style-name="Cell"><text:p>申請項目</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>□1.初次申請□2.異議複檢（評）□3.屆期重鑑</text:p><text:p>□4.自行申請變更（須檢附 3 個月內診斷證明書）</text:p><text:p>□5.再次申請</text:p><text:p>□6.無須重新鑑定換證</text:p><text:p>□7.指定期日換證</text:p><text:p>照片黏貼處</text:p></table:table-cell></table:table-row>
    <table:table-row><table:table-cell table:style-name="Cell"><text:p>姓名</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
