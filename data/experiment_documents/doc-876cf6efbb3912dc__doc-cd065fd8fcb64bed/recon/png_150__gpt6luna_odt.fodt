<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:default-style>
    <style:style style:name="TitleCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0.05cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="18cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="HeaderTable" style:family="table">
      <style:table-properties style:width="18cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="MainCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="TitleColumn" style:family="table-column">
      <style:table-column-properties style:column-width="9cm"/>
    </style:style>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="3.4cm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="5.2cm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="3.2cm"/>
    </style:style>
    <style:style style:name="ColD" style:family="table-column">
      <style:table-column-properties style:column-width="6.2cm"/>
    </style:style>
    <style:style style:name="TitleLeft" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start"/>
      <style:text-properties fo:font-size="16pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="TitleRight" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end"/>
      <style:text-properties fo:font-size="16pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.12cm" fo:margin-bottom="0.16cm"/>
      <style:text-properties fo:font-size="15pt"/>
    </style:style>
    <style:style style:name="DateLine" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-bottom="0.16cm"/>
      <style:text-properties fo:font-size="13pt"/>
    </style:style>
    <style:style style:name="CellText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="SectionTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="13pt"/>
    </style:style>
    <style:style style:name="SectionBody" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:line-height="130%" fo:margin-top="0.03cm" fo:margin-bottom="0.08cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Notes" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:line-height="120%" fo:margin-top="0cm" fo:margin-bottom="0.03cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Stamp" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0.25cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout1">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.4cm" fo:margin-bottom="1.4cm" fo:margin-left="1.5cm" fo:margin-right="1.5cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="DefaultPage" style:page-layout-name="PageLayout1"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <table:table table:name="PageHeading" table:style-name="HeaderTable">
        <table:table-column table:style-name="TitleColumn"/>
        <table:table-column table:style-name="TitleColumn"/>
        <table:table-row>
          <table:table-cell table:style-name="TitleCell">
            <text:p text:style-name="TitleLeft">財政部北區國稅局</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="TitleCell">
            <text:p text:style-name="TitleRight">分局（稽徵所、服務處）</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Subtitle">代理營業人辦理集中購買、撤銷、變更案件申請書及回復表</text:p>
      <text:p text:style-name="DateLine">申請日期：　　年　　月　　日　　　案件編號：</text:p>
      <table:table table:name="ApplicationForm" table:style-name="FormTable">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColD"/>
        <table:table-row>
          <table:table-cell table:style-name="HeaderCell">
            <text:p text:style-name="CellText">代理人名稱</text:p>
            <text:p text:style-name="CellText">（事務所或核准總繳之總機構）</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="MainCell"/>
          <table:table-cell table:style-name="HeaderCell">
            <text:p text:style-name="CellText">負責人姓名</text:p>
            <text:p text:style-name="CellText">身分證字號</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="MainCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeaderCell">
            <text:p text:style-name="CellText">統一編號</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="MainCell"/>
          <table:table-cell table:style-name="HeaderCell">
            <text:p text:style-name="CellText">聯絡人</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="MainCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeaderCell">
            <text:p text:style-name="CellText">營業地址</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="MainCell"/>
          <table:table-cell table:style-name="HeaderCell">
            <text:p text:style-name="CellText">聯絡電話</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="MainCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeaderCell" table:number-columns-spanned="4">
            <text:p text:style-name="SectionTitle">申請事項</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MainCell" table:number-columns-spanned="4">
            <text:p text:style-name="SectionBody">本代理人（事務所或核准總繳之總機構）因</text:p>
            <text:p text:style-name="SectionBody">□代理各營業人(附營業人資料表)購買統一發票</text:p>
            <text:p text:style-name="SectionBody">□變更代理記帳人員</text:p>
            <text:p text:style-name="SectionBody">□其他（原因：　　　　　　）</text:p>
            <text:p text:style-name="SectionBody">請惠予同意 □申請(增加)</text:p>
            <text:p text:style-name="SectionBody">□撤銷(減少)　　　　　於　　　　　　集中購買統一發票。</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeaderCell" table:number-columns-spanned="4">
            <text:p text:style-name="SectionTitle">回復情形</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MainCell" table:number-columns-spanned="4">
            <text:p text:style-name="SectionBody">貴代理人（事務所或核准總繳之總機構）</text:p>
            <text:p text:style-name="SectionBody">□申請(增加)　　　集中購買統一發票乙節，准予辦理，請查照。</text:p>
            <text:p text:style-name="SectionBody">□撤銷(減少)</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MainCell" table:number-columns-spanned="4">
            <text:p text:style-name="Notes">備註：</text:p>
            <text:p text:style-name="Notes">一、本申請書及回復表一式 2 聯，第 1 聯交營業人收執，第 2 聯依公文程序</text:p>
            <text:p text:style-name="Notes">　　留存歸檔或存稅籍資料袋。</text:p>
            <text:p text:style-name="Notes">二、未加蓋核發單位戳章或經塗改者無效。</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Stamp">核發單位服務台收件戳章：</text:p>
    </office:text>
  </office:body>
</office:document>