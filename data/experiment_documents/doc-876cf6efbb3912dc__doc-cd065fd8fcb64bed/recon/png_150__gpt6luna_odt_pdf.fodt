<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:text-align="center" fo:margin-top="0.10cm" fo:margin-bottom="0.10cm"/>
      <style:text-properties fo:font-size="18pt" fo:font-weight="bold" style:font-name="Microsoft JhengHei"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.05cm" fo:margin-bottom="0.20cm"/>
      <style:text-properties fo:font-size="16pt" style:font-name="Microsoft JhengHei"/>
    </style:style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.12cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="14pt" style:font-name="Microsoft JhengHei"/>
    </style:style>
    <style:style style:name="TableText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="14pt" style:font-name="Microsoft JhengHei"/>
    </style:style>
    <style:style style:name="TableCenter" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="14pt" style:font-name="Microsoft JhengHei"/>
    </style:style>
    <style:style style:name="GridCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.05cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="GridTop" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.05cm" style:vertical-align="top"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout" style:page-usage="all">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.35cm" fo:margin-bottom="1.35cm" fo:margin-left="1.9cm" fo:margin-right="1.9cm"/>
    </style:page-layout>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="3.5cm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="5.1cm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="3.2cm"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties style:column-width="5.3cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">財政部北區國稅局　　　　　　　　　分局（稽徵所、服務處）</text:p>
      <text:p text:style-name="Subtitle">代理營業人辦理集中購買、撤銷、變更案件申請書及回復表</text:p>
      <text:p text:style-name="Body">申請日期：　　年　　月　　日　　　案件編號：</text:p>
      <table:table table:name="Form">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-row>
          <table:table-cell table:style-name="GridCell">
            <text:p text:style-name="TableText">代理人名稱</text:p>
            <text:p text:style-name="TableText">（事務所或核</text:p>
            <text:p text:style-name="TableText">准總繳之總機</text:p>
            <text:p text:style-name="TableText">構）</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCell">
            <text:p text:style-name="TableText">負責人姓名</text:p>
            <text:p text:style-name="TableText">身分證字號</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell">
            <text:p text:style-name="TableText">統一編號</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCell">
            <text:p text:style-name="TableText">聯絡人</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell">
            <text:p text:style-name="TableText">營業地址</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCell">
            <text:p text:style-name="TableText">聯絡電話</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="4">
            <text:p text:style-name="TableCenter">申　請　事　項</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="GridCell"/>
          <table:covered-table-cell table:style-name="GridCell"/>
          <table:covered-table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridTop" table:number-columns-spanned="4">
            <text:p text:style-name="TableText">本代理人（事務所或核准總繳之總機構）因</text:p>
            <text:p text:style-name="TableText">□代理各營業人(附營業人資料表)購買統一發票</text:p>
            <text:p text:style-name="TableText">□變更代理記帳人員</text:p>
            <text:p text:style-name="TableText">□其他（原因：　　　　　　　　　）</text:p>
            <text:p text:style-name="TableText">請惠予同意 □申請(增加)</text:p>
            <text:p text:style-name="TableText">□撤銷(減少)　於　　　　　　　　集中購買統一發票。</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="GridTop"/>
          <table:covered-table-cell table:style-name="GridTop"/>
          <table:covered-table-cell table:style-name="GridTop"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="4">
            <text:p text:style-name="TableCenter">回　復　情　形</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="GridCell"/>
          <table:covered-table-cell table:style-name="GridCell"/>
          <table:covered-table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridTop" table:number-columns-spanned="4">
            <text:p text:style-name="TableText">貴代理人（事務所或核准總繳之總機構）</text:p>
            <text:p text:style-name="TableText">□申請(增加)</text:p>
            <text:p text:style-name="TableText">□撤銷(減少)　　集中購買統一發票之節，准予辦理，請查照。</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="GridTop"/>
          <table:covered-table-cell table:style-name="GridTop"/>
          <table:covered-table-cell table:style-name="GridTop"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridTop" table:number-columns-spanned="4">
            <text:p text:style-name="TableText">備註：</text:p>
            <text:p text:style-name="TableText">　一、本申請書及回復表一式 2 聯，第 1 聯交營業人收執，第 2 聯依公文程序</text:p>
            <text:p text:style-name="TableText">　　　留存歸檔或存稅籍資料袋。</text:p>
            <text:p text:style-name="TableText">　二、未加蓋核發單位戳章或經塗改者無效。</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="GridTop"/>
          <table:covered-table-cell table:style-name="GridTop"/>
          <table:covered-table-cell table:style-name="GridTop"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body">核發單位服務台收件戳章：</text:p>
    </office:text>
  </office:body>
</office:document>