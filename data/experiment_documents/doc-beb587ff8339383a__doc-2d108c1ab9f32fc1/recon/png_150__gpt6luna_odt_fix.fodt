        <table:table-row><table:table-cell table:style-name="c2_CellCenter"><text:p>避難誘導班</text:p></table:table-cell><table:table-cell table:style-name="c2_CellLeft"><text:p>班長：［役職］　［氏名］</text:p></table:table-cell><table:table-cell table:style-name="c2_CellLeft"><text:p>班員：［役職］　［氏名］</text:p><text:p>班員：［役職］　［氏名］</text:p></table:table-cell></table:table-row>
