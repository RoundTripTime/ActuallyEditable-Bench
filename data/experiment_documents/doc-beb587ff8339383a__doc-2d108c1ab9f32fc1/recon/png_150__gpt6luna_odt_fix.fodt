        <table:table-row><table:table-cell table:style-name="Cell"><text:p>　</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>　</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>→　____________の福祉施設</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>　</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>施設職員　→　利用者</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>　</text:p></table:table-cell></table:table-row>
      </table:table>
