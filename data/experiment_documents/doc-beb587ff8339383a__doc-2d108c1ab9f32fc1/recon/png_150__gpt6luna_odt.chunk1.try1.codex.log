        <table:table-row><table:table-cell table:number-columns-spanned="2" table:style-name="Gray"><text:p text:style-name="Center">昼間・夜間</text:p></table:table-cell><table:covered-table-cell/><table:table-cell table:number-columns-spanned="2" table:style-name="Gray"><text:p text:style-name="Center">休日</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
