<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:xml="http://www.w3.org/XML/1998/namespace" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:line-height="125%" fo:margin-top="0cm" fo:margin-bottom="0.08cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Centered" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="end"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.2cm" fo:margin-bottom="0.25cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:margin-top="0.45cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="2.7cm" fo:margin-bottom="2.7cm" fo:margin-left="2.7cm" fo:margin-right="2.7cm"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="15.6cm" table:align="margins"/>
    </style:style>
    <style:style style:name="ColNum" style:family="table-column">
      <style:table-column-properties style:column-width="0.65cm"/>
    </style:style>
    <style:style style:name="ColLabel" style:family="table-column">
      <style:table-column-properties style:column-width="3.3cm"/>
    </style:style>
    <style:style style:name="ColField" style:family="table-column">
      <style:table-column-properties style:column-width="11.65cm"/>
    </style:style>
    <style:style style:name="ColHalf" style:family="table-column">
      <style:table-column-properties style:column-width="7.8cm"/>
    </style:style>
    <style:style style:name="ColHalf2" style:family="table-column">
      <style:table-column-properties style:column-width="7.8cm"/>
    </style:style>
    <style:style style:name="Underline" style:family="text">
      <style:text-properties style:text-underline-style="solid" style:text-underline-width="auto"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <table:table table:name="Header" table:style-name="FormTable">
        <table:table-column table:style-name="ColHalf"/>
        <table:table-column table:style-name="ColHalf2"/>
        <table:table-row>
          <table:table-cell><text:p text:style-name="Body">様式第１号（第４条関係）</text:p></table:table-cell>
          <table:table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:number-columns-spanned="2"><text:p text:style-name="Title">公 園 内 行 為 許 可 申 請 書</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell/>
          <table:table-cell><text:p text:style-name="Right">年　　月　　日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell><text:p text:style-name="Body">鹿部町長　盛田　昌彦　様</text:p></table:table-cell>
          <table:table-cell><text:p text:style-name="Right">申請者　住所</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell/>
          <table:table-cell><text:p text:style-name="Right">氏　名　　　○　　印</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell/>
          <table:table-cell><text:p text:style-name="Right">職　業</text:p></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="Body">鹿部町公園条例第５条第１項及び第２項の行為をしたいので、下記のとおり関係図面を添えて申請します。</text:p>
      <text:p text:style-name="Centered">記</text:p>

      <table:table table:name="ApplicationItems" table:style-name="FormTable">
        <table:table-column table:style-name="ColNum"/>
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColField"/>
        <table:table-row>
          <table:table-cell><text:p text:style-name="Body">1</text:p></table:table-cell>
          <table:table-cell><text:p text:style-name="Body">行為の目的</text:p></table:table-cell>
          <table:table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell><text:p text:style-name="Body">2</text:p></table:table-cell>
          <table:table-cell><text:p text:style-name="Body">行為の内容</text:p></table:table-cell>
          <table:table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell><text:p text:style-name="Body">3</text:p></table:table-cell>
          <table:table-cell><text:p text:style-name="Body">行為の期間</text:p></table:table-cell>
          <table:table-cell><text:p text:style-name="Body">年　　月　　日から　　　年　　月　　日まで　　日間</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell><text:p text:style-name="Body">4</text:p></table:table-cell>
          <table:table-cell><text:p text:style-name="Body">公園の名称及び</text:p><text:p text:style-name="Body">場所(図面添付)</text:p></table:table-cell>
          <table:table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell><text:p text:style-name="Body">5</text:p></table:table-cell>
          <table:table-cell><text:p text:style-name="Body">使用する面積</text:p></table:table-cell>
          <table:table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell><text:p text:style-name="Body">6</text:p></table:table-cell>
          <table:table-cell><text:p text:style-name="Body">施設の構造</text:p></table:table-cell>
          <table:table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell><text:p text:style-name="Body">7</text:p></table:table-cell>
          <table:table-cell><text:p text:style-name="Body">入場料等の徴収</text:p><text:p text:style-name="Body">の有無</text:p></table:table-cell>
          <table:table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell><text:p text:style-name="Body">8</text:p></table:table-cell>
          <table:table-cell><text:p text:style-name="Body">使用料</text:p></table:table-cell>
          <table:table-cell><text:p text:style-name="Right"><text:span text:style-name="Underline">　　　　　　　　　</text:span>円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell><text:p text:style-name="Body">9</text:p></table:table-cell>
          <table:table-cell><text:p text:style-name="Body">備　考</text:p></table:table-cell>
          <table:table-cell/>
        </table:table-row>
      </table:table>

      <text:p text:style-name="Note">※備考欄に、利用人数（大人・子ども各人数）及び、ご連絡先電話番号の記載をお願い致します。</text:p>
      <text:p text:style-name="Body">営利を目的とした使用等、使用料が発生する場合がございます。</text:p>
      <text:p text:style-name="Centered">--------------------------------------------------（切り取り線）--------------------------------------------------</text:p>
      <text:p text:style-name="Centered">鹿部町公園内行為許可(不許可)書</text:p>
      <text:p text:style-name="Body">年　月　日申請の鹿部町公園内行為使用について次のとおり許可（不許可）とする。</text:p>
      <text:p text:style-name="Centered">記</text:p>
      <table:table table:name="Decision" table:style-name="FormTable">
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColField"/>
        <table:table-row>
          <table:table-cell><text:p text:style-name="Body">許可条件</text:p></table:table-cell>
          <table:table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell><text:p text:style-name="Body">不許可理由</text:p></table:table-cell>
          <table:table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell/>
          <table:table-cell><text:p text:style-name="Right">年　月　日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell><text:p text:style-name="Right">様</text:p></table:table-cell>
          <table:table-cell><text:p text:style-name="Right">鹿部町長　　　□　印</text:p></table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>