<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.1cm" fo:line-height="0.52cm"/>
      <style:text-properties fo:font-family="MS Mincho" fo:font-size="10.5pt"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.1cm" fo:line-height="0.52cm"/>
      <style:text-properties fo:font-family="MS Mincho" fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0.2cm" fo:line-height="0.52cm"/>
      <style:text-properties fo:font-family="MS Mincho" fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end" fo:margin-top="0cm" fo:margin-bottom="0.1cm" fo:line-height="0.52cm"/>
      <style:text-properties fo:font-family="MS Mincho" fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0.1cm" fo:line-height="0.52cm"/>
      <style:text-properties fo:font-family="MS Mincho" fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="Gap" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.2cm" fo:line-height="0.52cm"/>
      <style:text-properties fo:font-family="MS Mincho" fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="15cm" table:align="left" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ColNum" style:family="table-column">
      <style:table-column-properties style:column-width="0.6cm"/>
    </style:style>
    <style:style style:name="ColLabel" style:family="table-column">
      <style:table-column-properties style:column-width="4.2cm"/>
    </style:style>
    <style:style style:name="ColEntry" style:family="table-column">
      <style:table-column-properties style:column-width="8.3cm"/>
    </style:style>
    <style:style style:name="ColEnd" style:family="table-column">
      <style:table-column-properties style:column-width="1.9cm"/>
    </style:style>
    <style:style style:name="FormCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="0.5cm"/>
      <style:text-properties fo:font-family="MS Mincho" fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="EntryLine" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:border-bottom="0.5pt solid #000000" fo:padding="0cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="0.5cm"/>
      <style:text-properties fo:font-family="MS Mincho" fo:font-size="10.5pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-left="3cm" fo:margin-right="3cm" fo:margin-top="2.8cm" fo:margin-bottom="2.8cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Body">様式第1号(第4条関係)</text:p>
      <text:p text:style-name="Title">公園内行為許可申請書</text:p>
      <text:p text:style-name="Right">年　　月　　日</text:p>
      <text:p text:style-name="Gap">　　鹿部町長　盛田　昌彦　様</text:p>
      <text:p text:style-name="Right">申請者　住所</text:p>
      <text:p text:style-name="Right">氏名　　　　　　　　　○　印</text:p>
      <text:p text:style-name="Right">職業</text:p>
      <text:p text:style-name="Body">　　鹿部町公園条例第5条第1項及び第2項の行為をしたいので、下記のとおり関係図面</text:p>
      <text:p text:style-name="Body">を添えて申請します。</text:p>
      <text:p text:style-name="Center">記</text:p>
      <table:table table:name="ApplicationItems" table:style-name="FormTable">
        <table:table-column table:style-name="ColNum"/>
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColEntry"/>
        <table:table-column table:style-name="ColEnd"/>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body">1</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body">　行為の目的</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body">2</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body">　行為の内容</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body">3</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body">　行為の期間</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body">年　　月　　日から　　　　年　　月　　日まで</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body">　　日間</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body">4</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="Body">　公園の名称及び</text:p>
            <text:p text:style-name="Body">　場所(図面添付)</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body">5</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body">　使用する面積</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body">6</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body">　施設の構造</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body">7</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="Body">入場料等の徴収</text:p>
            <text:p text:style-name="Body">の有無</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body">8</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body">　使用料</text:p></table:table-cell>
          <table:table-cell table:style-name="EntryLine"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body">円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body">9</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body">　備　考</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body">※備考欄に、利用人数（大人・子ども各人数）及び、ご連絡先電話番号の記載をお願い致</text:p>
      <text:p text:style-name="Body">します。</text:p>
      <text:p text:style-name="Body">　営利を目的とした使用等、使用料が発生する場合がございます。</text:p>
      <text:p text:style-name="Center">---------------------------------------------- （切り取り線） ----------------------------------------------</text:p>
      <text:p text:style-name="Center">鹿部町公園内行為許可(不許可)書</text:p>
      <text:p text:style-name="Body">　　年　月　日申請の鹿部町公園内行為使用について次のとおり許可(不許可)と</text:p>
      <text:p text:style-name="Body">する。</text:p>
      <text:p text:style-name="Center">記</text:p>
      <text:p text:style-name="Body">　許可条件</text:p>
      <text:p text:style-name="Body">　不許可理由</text:p>
      <text:p text:style-name="Right">年　　月　　日</text:p>
      <text:p text:style-name="Right">　　　　　　　　　　　様</text:p>
      <text:p text:style-name="Right">鹿部町長　　　　　　　　□　印</text:p>
    </office:text>
  </office:body>
</office:document>