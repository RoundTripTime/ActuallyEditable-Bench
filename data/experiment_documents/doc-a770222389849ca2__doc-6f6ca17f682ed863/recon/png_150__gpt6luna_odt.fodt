<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph" style:master-page-name="Standard">
      <style:paragraph-properties fo:font-size="10pt" fo:line-height="150%"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:font-size="9pt" fo:line-height="130%"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="12mm" fo:margin-bottom="14mm" fo:line-height="150%"/>
      <style:text-properties fo:font-size="18pt"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="end"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0mm" fo:margin-bottom="8mm"/>
    </style:style>
    <style:style style:name="Indented" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:margin-left="3mm"/>
    </style:style>
    <style:style style:name="AttachmentHeading" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:margin-top="2mm" fo:margin-bottom="1mm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" style:print-orientation="portrait" fo:margin-top="20mm" fo:margin-bottom="18mm" fo:margin-left="20mm" fo:margin-right="16mm"/>
    </style:page-layout>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="17mm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="24mm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="23mm"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties style:column-width="32mm"/>
    </style:style>
    <style:style style:name="Col5" style:family="table-column">
      <style:table-column-properties style:column-width="24mm"/>
    </style:style>
    <style:style style:name="Col6" style:family="table-column">
      <style:table-column-properties style:column-width="54mm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.6pt solid #000000" fo:padding="1mm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:font-size="10pt" fo:line-height="130%"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="CenteredCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.6pt solid #000000" fo:padding="1mm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center" fo:font-size="10pt" fo:line-height="130%"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Small">別記様式第２号（第９条関係）</text:p>
      <text:p text:style-name="Title">解体工事事前周知報告書</text:p>
      <text:p text:style-name="Right">年　　月　　日</text:p>
      <text:p text:style-name="Body">文　京　区　長　殿</text:p>
      <text:p text:style-name="Right">発注者等　住所</text:p>
      <text:p text:style-name="Right">氏名</text:p>
      <text:p text:style-name="Right">（法人にあっては、名称及び代表者の氏名）</text:p>
      <text:p text:style-name="Right">電話</text:p>
      <text:p text:style-name="Body">文京区建築物の解体工事の事前周知等に関する指導要綱第９条の規定により、下記のとおり報告します。</text:p>
      <table:table table:name="解体工事事前周知報告書1">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-column table:style-name="Col5"/>
        <table:table-column table:style-name="Col6"/>
        <table:table-row>
          <table:table-cell table:style-name="CenteredCell" table:number-rows-spanned="5"><text:p text:style-name="CellText">解体<br/>建築物</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>工事の名称</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>敷地の位置</text:p><text:p text:style-name="Small">（住居表示）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p>文京区</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CenteredCell" table:number-rows-spanned="2"><text:p>建築物の</text:p><text:p>概　要</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>構　造</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>階　数</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>地上　　　　　階</text:p><text:p>地下　　　　　階</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>高　さ</text:p></table:table-cell>
          <table:table-cell table:style-name="CenteredCell"><text:p>m</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>延べ面積</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>　　　　　　　　　m²</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>工事期間</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p>年　　月　　日から　　　　年　　月　　日まで</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CenteredCell" table:number-columns-spanned="2" table:number-rows-spanned="2"><text:p>解体工事施工者</text:p><text:p text:style-name="Small">（元請業者又は自主施工者）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p>住所</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p>氏名</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageStart"/>
      <table:table table:name="解体工事事前周知報告書2">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-column table:style-name="Col5"/>
        <table:table-column table:style-name="Col6"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Small">（法人にあっては、名称及び代表者の氏名）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>電話</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CenteredCell" table:number-columns-spanned="2"><text:p>現　場　責　任　者</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p/></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>電　　話</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CenteredCell"><text:p>標識</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>設置年月日</text:p></table:table-cell>
          <table:table-cell table:style-name="CenteredCell" table:number-columns-spanned="2"><text:p>年　　月　　日</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>設置場所</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>別紙のとおり</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CenteredCell" table:number-rows-spanned="3"><text:p>近隣</text:p><text:p>説明</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>説明時期</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>実施方法</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p>説明会　・　個別訪問　・　その他（　　　　　　　　　）</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>説明内容</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p>別紙のとおり</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="AttachmentHeading">【添付書類】</text:p>
      <text:p text:style-name="Indented">□標識設置場所の写真（遠景及び近景）</text:p>
      <text:p text:style-name="Indented">□標識の掲示内容</text:p>
      <text:p text:style-name="Indented">□石綿の分析調査結果書の写し</text:p>
      <text:p text:style-name="Indented">□標識の設置場所と近隣説明の範囲を案内図に記入したもの</text:p>
      <text:p text:style-name="Indented">□近隣説明で配布した資料</text:p>
    </office:text>
  </office:body>
</office:document>