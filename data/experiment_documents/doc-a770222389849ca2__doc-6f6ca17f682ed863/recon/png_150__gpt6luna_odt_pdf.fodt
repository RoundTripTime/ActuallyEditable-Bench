<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Normal" style:family="paragraph">
      <style:paragraph-properties fo:font-size="12pt" fo:line-height="150%" fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" style:print-orientation="portrait" fo:margin-left="21mm" fo:margin-right="15mm" fo:margin-top="20mm" fo:margin-bottom="20mm"/>
    </style:page-layout>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0mm" fo:margin-bottom="0mm"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="9mm" fo:margin-bottom="15mm"/>
      <style:text-properties fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0mm" fo:margin-bottom="0mm"/>
    </style:style>
    <style:style style:name="Intro" style:family="paragraph">
      <style:paragraph-properties fo:text-align="justify" fo:line-height="180%" fo:margin-top="11mm" fo:margin-bottom="1mm"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="Table" style:family="table">
      <style:table-properties style:width="174mm" table:align="margins"/>
    </style:style>
    <style:style style:name="Col17" style:family="table-column">
      <style:table-column-properties style:column-width="17mm"/>
    </style:style>
    <style:style style:name="Col25" style:family="table-column">
      <style:table-column-properties style:column-width="25mm"/>
    </style:style>
    <style:style style:name="Col24" style:family="table-column">
      <style:table-column-properties style:column-width="24mm"/>
    </style:style>
    <style:style style:name="Col38" style:family="table-column">
      <style:table-column-properties style:column-width="38mm"/>
    </style:style>
    <style:style style:name="Col22" style:family="table-column">
      <style:table-column-properties style:column-width="22mm"/>
    </style:style>
    <style:style style:name="Col48" style:family="table-column">
      <style:table-column-properties style:column-width="48mm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.4mm solid #000000" fo:padding="1.4mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HeavyCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.7mm solid #000000" fo:padding="1.4mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellP" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="CenterP" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="SmallP" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Small">別記様式第２号（第９条関係）</text:p>
      <text:p text:style-name="Title">解体工事事前周知報告書</text:p>
      <text:p text:style-name="Right">年　　月　　日</text:p>
      <text:p text:style-name="Normal">文 京 区 長 殿</text:p>
      <text:p text:style-name="Right">発注者等　住所</text:p>
      <text:p text:style-name="Right">氏名</text:p>
      <text:p text:style-name="Right">（法人にあっては、名称及び代表者の氏名）</text:p>
      <text:p text:style-name="Right">電話</text:p>
      <text:p text:style-name="Intro">文京区建築物の解体工事の事前周知等に関する指導要綱第９条の規定により、下記のとおり報告します。</text:p>
      <table:table table:name="解体建築物" table:style-name="Table">
        <table:table-column table:style-name="Col17"/>
        <table:table-column table:style-name="Col25"/>
        <table:table-column table:style-name="Col24"/>
        <table:table-column table:style-name="Col38"/>
        <table:table-column table:style-name="Col22"/>
        <table:table-column table:style-name="Col48"/>
        <table:table-row>
          <table:table-cell table:style-name="HeavyCell" table:number-rows-spanned="5"><text:p text:style-name="CellP">解体</text:p><text:p text:style-name="CellP">建築物</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">工事の名称</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">敷地の位置</text:p><text:p text:style-name="SmallP">（住居表示）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="CellP">文京区</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2"><text:p text:style-name="CellP">建築物の</text:p><text:p text:style-name="CellP">概　要</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">構　造</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">階　数</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">地上　　　　　階</text:p><text:p text:style-name="CellP">地下　　　　　階</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">高　さ</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">　　　　　　　　　m</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">延べ面積</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">　　　　　　　m²</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">工事期間</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="CenterP">年　　月　　日から　　　年　　月　　日まで</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeavyCell" table:number-columns-spanned="2" table:number-rows-spanned="2"><text:p text:style-name="CellP">解体工事施工者</text:p><text:p text:style-name="SmallP">(元請業者又は自主施工者</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="CellP">住所</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="CellP">氏名</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageStart"/>
      <table:table table:name="続き" table:style-name="Table">
        <table:table-column table:style-name="Col17"/>
        <table:table-column table:style-name="Col25"/>
        <table:table-column table:style-name="Col24"/>
        <table:table-column table:style-name="Col38"/>
        <table:table-column table:style-name="Col22"/>
        <table:table-column table:style-name="Col48"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="SmallP">（法人にあっては、名称及</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="CellP">電話</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeavyCell" table:number-columns-spanned="2"><text:p text:style-name="CellP">現場責任者</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="CellP">氏名</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">電　話</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeavyCell"><text:p text:style-name="CellP">標識</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">設置年月日</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="CenterP">年　　月　　日</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">設置場所</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">別紙のとおり</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeavyCell" table:number-rows-spanned="3"><text:p text:style-name="CellP">近隣</text:p><text:p text:style-name="CellP">説明</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">説明時期</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">実施方法</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="CellP">説明会　・　個別訪問　・　その他（　　　　　　　　　　　）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">説明内容</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="CellP">別紙のとおり</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Normal">【添付書類】</text:p>
      <text:p text:style-name="Normal">　□標識設置場所の写真（遠景及び近景）</text:p>
      <text:p text:style-name="Normal">　□標識の掲示内容</text:p>
      <text:p text:style-name="Normal">　□石綿の分析調査結果書の写し</text:p>
      <text:p text:style-name="Normal">　□標識の設置場所と近隣説明の範囲を案内図に記入したもの</text:p>
      <text:p text:style-name="Normal">　□近隣説明で配布した資料</text:p>
    </office:text>
  </office:body>
</office:document>