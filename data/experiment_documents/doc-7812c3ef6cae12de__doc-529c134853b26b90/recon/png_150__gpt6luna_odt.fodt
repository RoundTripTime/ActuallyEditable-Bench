<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:text-properties fo:font-family="serif" fo:font-size="12pt"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.15cm"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:text-align="center" fo:margin-top="0.1cm" fo:margin-bottom="0.35cm"/>
    </style:style>
    <style:style style:name="Date" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end" fo:margin-bottom="0.45cm"/>
    </style:style>
    <style:style style:name="Address" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.35cm"/>
    </style:style>
    <style:style style:name="Applicant" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.25cm"/>
    </style:style>
    <style:style style:name="SectionHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.3cm" fo:margin-bottom="0.25cm"/>
    </style:style>
    <style:style style:name="FieldText" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.3cm"/>
    </style:style>
    <style:style style:name="ContentLabel" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.15cm" fo:margin-bottom="0.25cm"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.2cm"/>
    </style:style>
    <style:style style:name="NoteIndented" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.75cm" fo:margin-top="0cm" fo:margin-bottom="0.2cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="3cm" fo:margin-right="2.5cm" fo:margin-top="4.2cm" fo:margin-bottom="2cm"/>
    </style:page-layout>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="3.3cm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="4.2cm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="3.4cm"/>
    </style:style>
    <style:style style:name="ColD" style:family="table-column">
      <style:table-column-properties style:column-width="4.1cm"/>
    </style:style>
    <style:style style:name="NoBorders" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0cm"/>
    </style:style>
    <style:style style:name="ApplicantLeft" style:family="table-column">
      <style:table-column-properties style:column-width="7.5cm"/>
    </style:style>
    <style:style style:name="ApplicantRight" style:family="table-column">
      <style:table-column-properties style:column-width="7.5cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">て　ん　末　書</text:p>
      <text:p text:style-name="Date">令和　　年　　月　　日</text:p>
      <text:p text:style-name="Address">佐渡市長様</text:p>
      <table:table table:name="ApplicantBlock">
        <table:table-column table:style-name="ApplicantLeft"/>
        <table:table-column table:style-name="ApplicantRight"/>
        <table:table-row>
          <table:table-cell table:style-name="NoBorders">
            <text:p/>
          </table:table-cell>
          <table:table-cell table:style-name="NoBorders">
            <text:p text:style-name="Applicant">申請者　住所　佐渡市</text:p>
            <text:p text:style-name="Applicant">氏名</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="SectionHeading">下記自動車の登録番号紛失のてん末</text:p>
      <table:table table:name="VehicleDetails">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColD"/>
        <table:table-row>
          <table:table-cell table:style-name="NoBorders"><text:p text:style-name="FieldText">登録番号</text:p></table:table-cell>
          <table:table-cell table:style-name="NoBorders"><text:p text:style-name="FieldText"/></table:table-cell>
          <table:table-cell table:style-name="NoBorders"><text:p text:style-name="FieldText">車体番号</text:p></table:table-cell>
          <table:table-cell table:style-name="NoBorders"><text:p text:style-name="FieldText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="NoBorders"><text:p text:style-name="FieldText">車　　名</text:p></table:table-cell>
          <table:table-cell table:style-name="NoBorders"><text:p text:style-name="FieldText"/></table:table-cell>
          <table:table-cell table:style-name="NoBorders"><text:p text:style-name="FieldText">エンジン番号</text:p></table:table-cell>
          <table:table-cell table:style-name="NoBorders"><text:p text:style-name="FieldText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="NoBorders"><text:p text:style-name="FieldText">型　　式</text:p></table:table-cell>
          <table:table-cell table:style-name="NoBorders"><text:p text:style-name="FieldText"/></table:table-cell>
          <table:table-cell table:style-name="NoBorders"><text:p text:style-name="FieldText">認定番号</text:p></table:table-cell>
          <table:table-cell table:style-name="NoBorders"><text:p text:style-name="FieldText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="NoBorders"><text:p text:style-name="FieldText">取得日</text:p></table:table-cell>
          <table:table-cell table:style-name="NoBorders"><text:p text:style-name="FieldText">年　　月　　日</text:p></table:table-cell>
          <table:table-cell table:style-name="NoBorders"><text:p text:style-name="FieldText"/></table:table-cell>
          <table:table-cell table:style-name="NoBorders"><text:p text:style-name="FieldText"/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="ContentLabel">内　　容</text:p>
      <text:p/>
      <text:p/>
      <text:p/>
      <text:p/>
      <text:p/>
      <text:p/>
      <text:p/>
      <text:p/>
      <text:p/>
      <text:p/>
      <text:p/>
      <text:p/>
      <text:p/>
      <text:p/>
      <text:p/>
      <text:p/>
      <text:p/>
      <text:p/>
      <text:p text:style-name="Note">(注)紛失日時、紛失区間、届出警察署又は駐在所を明記の上詳細にてん末を</text:p>
      <text:p text:style-name="NoteIndented">記入すること。</text:p>
    </office:text>
  </office:body>
</office:document>