<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="100%" fo:margin-top="1.6cm" fo:margin-bottom="0.55cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="CellP" style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="5cm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="3cm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="4.5cm"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties style:column-width="2.5cm"/>
    </style:style>
    <style:style style:name="WideCol1" style:family="table-column">
      <style:table-column-properties style:column-width="7.3cm"/>
    </style:style>
    <style:style style:name="WideCol2" style:family="table-column">
      <style:table-column-properties style:column-width="7.7cm"/>
    </style:style>
    <style:style style:name="DateCol1" style:family="table-column">
      <style:table-column-properties style:column-width="9.6cm"/>
    </style:style>
    <style:style style:name="DateCol2" style:family="table-column">
      <style:table-column-properties style:column-width="1.5cm"/>
    </style:style>
    <style:style style:name="DateCol3" style:family="table-column">
      <style:table-column-properties style:column-width="1.5cm"/>
    </style:style>
    <style:style style:name="DateCol4" style:family="table-column">
      <style:table-column-properties style:column-width="2.7cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-left="3cm" fo:margin-right="3cm" fo:margin-top="3.2cm" fo:margin-bottom="2cm"/>
    </style:page-layout>
    <style:style style:name="DateGap" style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0.55cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="SectionGap" style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0.55cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="FieldGap" style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="TallBlank" style:family="paragraph">
      <style:paragraph-properties fo:line-height="8.5cm" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="NoteIndent" style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%" fo:margin-left="0.75cm" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="ApplicantTable" style:family="table">
      <style:table-properties fo:width="15cm"/>
    </style:style>
    <style:style style:name="FieldsTable" style:family="table">
      <style:table-properties fo:width="15cm"/>
    </style:style>
    <style:style style:name="DateTable" style:family="table">
      <style:table-properties fo:width="15cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">て　ん　末　書</text:p>
      <text:p text:style-name="Right">令和　年　月　日</text:p>
      <text:p text:style-name="SectionGap">佐渡市長様</text:p>
      <table:table table:name="Applicant" table:style-name="ApplicantTable">
        <table:table-column table:style-name="WideCol1"/>
        <table:table-column table:style-name="WideCol2"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellP">申請者　住所　佐渡市</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellP">氏名</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="FieldGap">下記自動車の登録番号紛失のてん末</text:p>
      <table:table table:name="VehicleFields" table:style-name="FieldsTable">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">登録番号</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">車体番号</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">車　名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">エンジン番号</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">型　式</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">認定番号</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <table:table table:name="AcquisitionDate" table:style-name="DateTable">
        <table:table-column table:style-name="DateCol1"/>
        <table:table-column table:style-name="DateCol2"/>
        <table:table-column table:style-name="DateCol3"/>
        <table:table-column table:style-name="DateCol4"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">取得日</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">年</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">月</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellP">日</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="FieldGap">内　容</text:p>
      <text:p text:style-name="TallBlank"/>
      <text:p text:style-name="NoteIndent">(注)紛失日時、紛失区間、届出警察署又は駐在所を明記の上詳細にてん末を</text:p>
      <text:p text:style-name="NoteIndent">記入すること。</text:p>
    </office:text>
  </office:body>
</office:document>