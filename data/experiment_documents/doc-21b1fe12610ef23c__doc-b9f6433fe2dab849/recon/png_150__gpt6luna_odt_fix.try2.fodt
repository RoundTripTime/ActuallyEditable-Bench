          <table:table-cell table:style-name="Cell"><text:p>フリガナ</text:p><text:p>氏　名</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>死亡年月日</text:p><text:p>年　　　月　　　日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>住　所</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell" table:number-columns-spanned="2"><text:p/></table:table-cell>
