      <table:table table:name="RegistrationStatus">
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter"><text:p>相続登記の状況</text:p><text:p>（該当する番号に○印をしてください。）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>１　相続登記は　　　　年　　月　　日に完了しています。</text:p><text:p>２　相続登記は　　　　年　　月　　日頃までに完了する予定です。</text:p><text:p>３　相続登記は当面予定ありません。</text:p></table:table-cell>
        </table:table-row>
