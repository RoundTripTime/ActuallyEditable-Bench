<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="1.5cm" fo:margin-bottom="1.8cm"/>
      <style:text-properties fo:font-size="20pt"/>
    </style:style>
    <style:style style:name="SecondTitle" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:text-align="center" fo:margin-top="1cm" fo:margin-bottom="1.6cm"/>
      <style:text-properties fo:font-size="19pt"/>
    </style:style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.12cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Indented" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="5.8cm" fo:margin-top="0.12cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="FieldLabel" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="1cm" fo:margin-top="0.15cm" fo:margin-bottom="0.15cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="FormLine" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.5cm" fo:margin-right="0.5cm" fo:margin-top="0.2cm" fo:margin-bottom="1.6cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.1cm" fo:margin-bottom="0.1cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Formula" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.2cm" fo:margin-right="0.2cm" fo:margin-top="0.15cm" fo:margin-bottom="0.15cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.12cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="ExampleHead" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.25cm" fo:margin-bottom="0.05cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="TableCaption" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.35cm" fo:margin-bottom="0.05cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="TableText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.04cm" fo:margin-bottom="0.04cm"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="PageLayout" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayoutA4">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.5cm" fo:margin-bottom="1.5cm" fo:margin-left="3cm" fo:margin-right="3cm"/>
    </style:page-layout>
    <style:style style:name="AttachBox" style:family="table-cell">
      <style:table-cell-properties fo:border="0.6pt dashed #333333" fo:padding="1.3cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="RuleCell" style:family="table-cell">
      <style:table-cell-properties fo:border-bottom="0.5pt solid #999999" fo:padding="0.08cm"/>
    </style:style>
    <style:style style:name="CalcTable" style:family="table">
      <style:table-properties style:width="17cm" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="C1" style:family="table-column">
      <style:table-column-properties style:column-width="4cm"/>
    </style:style>
    <style:style style:name="C2" style:family="table-column">
      <style:table-column-properties style:column-width="1.7cm"/>
    </style:style>
    <style:style style:name="C3" style:family="table-column">
      <style:table-column-properties style:column-width="1.7cm"/>
    </style:style>
    <style:style style:name="C4" style:family="table-column">
      <style:table-column-properties style:column-width="2.4cm"/>
    </style:style>
    <style:style style:name="C5" style:family="table-column">
      <style:table-column-properties style:column-width="1.6cm"/>
    </style:style>
    <style:style style:name="C6" style:family="table-column">
      <style:table-column-properties style:column-width="1.9cm"/>
    </style:style>
    <style:style style:name="C7" style:family="table-column">
      <style:table-column-properties style:column-width="2.5cm"/>
    </style:style>
    <style:style style:name="GridCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #666666" fo:padding="0.06cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="BlueCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #666666" fo:background-color="#badcf5" fo:padding="0.06cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="PaleCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #666666" fo:background-color="#e5f1fa" fo:padding="0.06cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="GrayCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #666666" fo:background-color="#eeeeee" fo:padding="0.06cm" style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayoutA4"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">建設業退職金共済掛金収納書</text:p>
      <text:p text:style-name="Indented">受注者</text:p>
      <text:p text:style-name="Indented">住所</text:p>
      <text:p text:style-name="Indented">商号又は名称</text:p>
      <text:p text:style-name="Indented">代表者氏名　　　　　　　　　　　　　　　　　　　　　　　　　㊞</text:p>
      <text:p text:style-name="Body"/>
      <table:table>
        <table:table-column table:style-name="C1"/>
        <table:table-row>
          <table:table-cell table:style-name="RuleCell">
            <text:p text:style-name="Body">工事名</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="FieldLabel">（共済掛金の目安）</text:p>
      <text:p text:style-name="Formula">　　　　　　　　　　　　　　　円 × 　　　　　　　　 ／1,000 × 　　　　　　　 ％ ／ 70％　＝ 　　　　　　　　　　　　　　　円</text:p>
      <text:p text:style-name="Center">　　　　　　　　　　　①　　　　　　　　　　　　　　　　②　　　　　　　　　③</text:p>
      <text:p text:style-name="Body">※上記計算式中、①＝請負金額、②＝次ページ掲載「共済証紙購入の考え方」の表を参照、</text:p>
      <text:p text:style-name="Body">③＝労働者の建退共制度加入率とする。</text:p>
      <text:p text:style-name="Body"/>
      <table:table>
        <table:table-column table:style-name="C1"/>
        <table:table-row>
          <table:table-cell table:style-name="AttachBox">
            <text:p text:style-name="Center">収納書貼付箇所</text:p>
            <text:p text:style-name="Center">※契約者記入欄は必ず記入して下さい</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="SecondTitle">建設業退職金共済掛金収納書（計算例）</text:p>
      <text:p text:style-name="ExampleHead">◆計算例１（その他の土木）</text:p>
      <text:p text:style-name="Body">請負額：9,000,000 円　　建退共制度加入率：50％　の場合</text:p>
      <text:p text:style-name="Formula">（掛金計算式）　9,000,000 円 × 4.1／1000 × 50％ ／ 70％＝ 26,357 円</text:p>
      <text:p text:style-name="Small">　　　　　　　　　　　　　　請負金額　　　　下記の表より　　　加入率</text:p>
      <text:p text:style-name="ExampleHead">◆計算例２（その他の土木）</text:p>
      <text:p text:style-name="Body">請負額：20,000,000 円　　建退共制度加入率：70％　の場合</text:p>
      <text:p text:style-name="Formula">（掛金計算式）　20,000,000 円 × 3.6／1000 × 70％ ／ 70％＝ 72,000 円</text:p>
      <text:p text:style-name="Small">　　　　　　　　　　　　　　請負金額　　　　下記の表より　　　加入率</text:p>
      <text:p text:style-name="Small">※詳細については建退共ホームページ（http://www.kentaikyo.taisyokukin.go.jp/）を参照</text:p>
      <text:p text:style-name="TableCaption">「共済証紙購入の考え方」の表　（建退共ホームページより抜粋）</text:p>
      <table:table table:style-name="CalcTable">
        <table:table-column table:style-name="C1"/>
        <table:table-column table:style-name="C2"/>
        <table:table-column table:style-name="C3"/>
        <table:table-column table:style-name="C4"/>
        <table:table-column table:style-name="C5"/>
        <table:table-column table:style-name="C6"/>
        <table:table-column table:style-name="C7"/>
        <table:table-row>
          <table:table-cell table:style-name="BlueCell" table:number-rows-spanned="2"><text:p text:style-name="TableText"/></table:table-cell>
          <table:table-cell table:style-name="BlueCell" table:number-columns-spanned="6"><text:p text:style-name="TableText">土　木</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="PaleCell"><text:p text:style-name="TableText">舗装</text:p></table:table-cell>
          <table:table-cell table:style-name="PaleCell"><text:p text:style-name="TableText">橋梁等</text:p></table:table-cell>
          <table:table-cell table:style-name="PaleCell"><text:p text:style-name="TableText">隧道</text:p></table:table-cell>
          <table:table-cell table:style-name="PaleCell"><text:p text:style-name="TableText">堰堤</text:p></table:table-cell>
          <table:table-cell table:style-name="PaleCell"><text:p text:style-name="TableText">浚渫・埋立</text:p></table:table-cell>
          <table:table-cell table:style-name="PaleCell"><text:p text:style-name="TableText">その他の土木</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GrayCell"><text:p text:style-name="TableText">1,000 ～9,999 千円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">3.5/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">3.5/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">4.5/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">4.1/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">3.7/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">4.1/1000</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GrayCell"><text:p text:style-name="TableText">10,000 ～49,999 千円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">3.3/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">3.2/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">3.6/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">3.8/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.8/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">3.6/1000</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GrayCell"><text:p text:style-name="TableText">50,000～99,999 千円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.9/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.8/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.8/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">3.1/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.7/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">3.1/1000</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GrayCell"><text:p text:style-name="TableText">100,000～499,999 千円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.3/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.1/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.1/1000</text:p></table:cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.5/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">1.9/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.3/1000</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GrayCell"><text:p text:style-name="TableText">500,000 千円以上</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">1.7/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">1.6/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">1.9/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">1.8/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">1.7/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">1.8/1000</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BlueCell" table:number-rows-spanned="2"><text:p text:style-name="TableText"/></table:table-cell>
          <table:table-cell table:style-name="BlueCell" table:number-columns-spanned="3"><text:p text:style-name="TableText">建　築</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="BlueCell" table:number-columns-spanned="3"><text:p text:style-name="TableText">設　備</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="PaleCell" table:number-columns-spanned="2"><text:p text:style-name="TableText">住宅・同設備</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="PaleCell"><text:p text:style-name="TableText">非住宅・同設備</text:p></table:table-cell>
          <table:table-cell table:style-name="PaleCell" table:number-columns-spanned="2"><text:p text:style-name="TableText">屋外の電気等</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="PaleCell"><text:p text:style-name="TableText">機械器具設置</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GrayCell"><text:p text:style-name="TableText">1,000 ～9,999 千円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p text:style-name="TableText">4.8/1000</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">3.2/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p text:style-name="TableText">2.9/1000</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.2/1000</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GrayCell"><text:p text:style-name="TableText">10,000 ～49,999 千円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p text:style-name="TableText">2.9/1000</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">3.0/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p text:style-name="TableText">2.1/1000</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">1.7/1000</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GrayCell"><text:p text:style-name="TableText">50,000～99,999 千円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p text:style-name="TableText">2.7/1000</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.5/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p text:style-name="TableText">1.8/1000</text:p></table:cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">1.4/1000</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GrayCell"><text:p text:style-name="TableText">100,000～499,999 千円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p text:style-name="TableText">2.2/1000</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.1/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p text:style-name="TableText">1.4/1000</text:p></table:cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">1.1/1000</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GrayCell"><text:p text:style-name="TableText">500,000 千円以上</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p text:style-name="TableText">2.0/1000</text:p></table:table-cell>
