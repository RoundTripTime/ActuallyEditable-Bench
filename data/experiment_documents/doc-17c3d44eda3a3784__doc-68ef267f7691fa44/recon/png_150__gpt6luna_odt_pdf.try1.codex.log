      <text:p text:style-name="Title">建設業退職金共済掛金収納書</text:p>
      <text:p text:style-name="Indented">受注者</text:p>
      <text:p text:style-name="Indented">住所</text:p>
      <text:p text:style-name="Indented">商号又は名称</text:p>
      <text:p text:style-name="Indented">代表者氏名　　　　　　　　　　　　　　　　　　　　　　　　　㊞</text:p>
      <text:p text:style-name="Body"/>
      <table:table>
        <table:table-column table:style-name="C1"/>
        <table:table-row>
