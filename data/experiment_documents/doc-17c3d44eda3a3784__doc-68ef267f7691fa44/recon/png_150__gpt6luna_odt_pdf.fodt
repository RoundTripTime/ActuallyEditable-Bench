<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.12cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Noto Serif CJK JP" fo:font-size="10pt"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.3cm" fo:margin-bottom="1.4cm"/>
      <style:text-properties fo:font-family="Noto Sans CJK JP" fo:font-size="20pt"/>
    </style:style>
    <style:style style:name="Title2" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.2cm" fo:margin-bottom="1.1cm"/>
      <style:text-properties fo:font-family="Noto Sans CJK JP" fo:font-size="19pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right"/>
    </style:style>
    <style:style style:name="Subhead" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.55cm" fo:margin-bottom="0.25cm"/>
      <style:text-properties fo:font-size="12pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.12cm" fo:margin-bottom="0.1cm"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.6pt solid #666666" fo:padding="0.04cm" style:vertical-align="middle"/>
      <style:text-properties fo:font-family="Noto Sans CJK JP" fo:font-size="8.5pt"/>
    </style:style>
    <style:style style:name="HeadBlue" style:family="table-cell">
      <style:table-cell-properties fo:border="0.6pt solid #666666" fo:padding="0.04cm" fo:background-color="#badcf7" style:vertical-align="middle"/>
      <style:text-properties fo:font-family="Noto Sans CJK JP" fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="SubBlue" style:family="table-cell">
      <style:table-cell-properties fo:border="0.6pt solid #666666" fo:padding="0.04cm" fo:background-color="#e5f2fc" style:vertical-align="middle"/>
      <style:text-properties fo:font-family="Noto Sans CJK JP" fo:font-size="8.5pt"/>
    </style:style>
    <style:style style:name="RowHead" style:family="table-cell">
      <style:table-cell-properties fo:border="0.6pt solid #666666" fo:padding="0.04cm" fo:background-color="#eeeeee" style:vertical-align="middle"/>
      <style:text-properties fo:font-family="Noto Sans CJK JP" fo:font-size="8.5pt"/>
    </style:style>
    <style:style style:name="DashedBox" style:family="table-cell">
      <style:table-cell-properties fo:border="0.7pt dashed #222222" fo:padding="1cm" style:vertical-align="middle"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="2.5cm" fo:margin-right="2.5cm" fo:margin-top="2.2cm" fo:margin-bottom="2.2cm"/>
    </style:page-layout>
    <style:style style:name="FormLine" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.18cm" fo:margin-bottom="0.18cm" fo:margin-left="0.3cm" fo:margin-right="0.3cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="TableTopCol" style:family="table-column">
      <style:table-column-properties style:column-width="3.55cm"/>
    </style:style>
    <style:style style:name="TableTopColNarrow" style:family="table-column">
      <style:table-column-properties style:column-width="1.73cm"/>
    </style:style>
    <style:style style:name="TableBottomLabel" style:family="table-column">
      <style:table-column-properties style:column-width="4.0cm"/>
    </style:style>
    <style:style style:name="TableBottomCol" style:family="table-column">
      <style:table-column-properties style:column-width="3.0cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">建設業退職金共済掛金収納書</text:p>
      <text:p text:style-name="Center">受注者</text:p>
      <text:p text:style-name="Center">住所</text:p>
      <text:p text:style-name="Center">商号又は名称</text:p>
      <text:p text:style-name="Center">代表者氏名　　　　　　　　　　　　　　　　印</text:p>
      <text:p text:style-name="FormLine">工事名________________________________________________________________________________</text:p>
      <text:p text:style-name="Subhead">（共済掛金の目安）</text:p>
      <text:p text:style-name="FormLine">........................................................................円 × .............................. ／1,000 × ....................％ ／ 70％　＝ ................................................................円</text:p>
      <text:p text:style-name="Center">　　　　　　　①　　　　　　　　　　　　②　　　　　　　　　　③</text:p>
      <text:p>※上記計算式中、①＝請負金額、②＝次ページ掲載「共済証紙購入の考え方」の表を参照、</text:p>
      <text:p>③＝労働者の建退共制度加入率とする。</text:p>
      <table:table table:name="収納書貼付箇所">
        <table:table-column table:style-name="TableTopCol"/>
        <table:table-row>
          <table:table-cell table:style-name="DashedBox">
            <text:p text:style-name="Center">収納書貼付箇所</text:p>
            <text:p text:style-name="Center">※契約者記入欄は必ず記入して下さい</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageBreak"/>
      <text:p text:style-name="Title2">建設業退職金共済掛金収納書（計算例）</text:p>
      <text:p>◆計算例１（その他の土木）</text:p>
      <text:p>請負額：9,000,000 円　　建退共制度加入率：50％　の場合</text:p>
      <text:p text:style-name="FormLine">（掛金計算式）　9,000,000　円 ×　4.1／1000 ×　50％ ／ 70％＝　26,357　円</text:p>
      <text:p text:style-name="Center">請負金額　　　　　　　　　下記の表より　　　　　加入率</text:p>
      <text:p>◆計算例２（その他の土木）</text:p>
      <text:p>請負額：20,000,000 円　　建退共制度加入率：70％　の場合</text:p>
      <text:p text:style-name="FormLine">（掛金計算式）　20,000,000　円 ×　3.6／1000 ×　70％ ／ 70％＝　72,000　円</text:p>
      <text:p text:style-name="Center">請負金額　　　　　　　　　下記の表より　　　　　加入率</text:p>
      <text:p text:style-name="Small">※詳細については建退共ホームページ（http://www.kentaikyo.taisyoukin.go.jp/）を参照</text:p>
      <text:p text:style-name="Small">「共済証紙購入の考え方」の表　（建退共ホームページより抜粋）</text:p>
      <table:table table:name="土木の掛金率">
        <table:table-column table:style-name="TableTopCol"/>
        <table:table-column table:style-name="TableTopColNarrow"/>
        <table:table-column table:style-name="TableTopColNarrow"/>
        <table:table-column table:style-name="TableTopColNarrow"/>
        <table:table-column table:style-name="TableTopColNarrow"/>
        <table:table-column table:style-name="TableTopColNarrow"/>
        <table:table-column table:style-name="TableTopColNarrow"/>
        <table:table-row>
          <table:table-cell table:style-name="HeadBlue" table:number-rows-spanned="2"><text:p text:style-name="Center"/></table:table-cell>
          <table:table-cell table:style-name="HeadBlue" table:number-columns-spanned="6"><text:p text:style-name="Center">土木</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="SubBlue"><text:p text:style-name="Center">舗装</text:p></table:table-cell>
          <table:table-cell table:style-name="SubBlue"><text:p text:style-name="Center">橋梁等</text:p></table:table-cell>
          <table:table-cell table:style-name="SubBlue"><text:p text:style-name="Center">隧道</text:p></table:table-cell>
          <table:table-cell table:style-name="SubBlue"><text:p text:style-name="Center">堰堤</text:p></table:table-cell>
          <table:table-cell table:style-name="SubBlue"><text:p text:style-name="Center">浚渫･埋立</text:p></table:table-cell>
          <table:table-cell table:style-name="SubBlue"><text:p text:style-name="Center">その他の土木</text:p></table:table-cell>
        </table:table-row>
        <table:table-row><table:table-cell table:style-name="RowHead"><text:p text:style-name="Center">1,000 ～9,999 千円</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">3.5/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">3.5/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">4.5/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">4.1/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">3.7/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">4.1/1000</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="RowHead"><text:p text:style-name="Center">10,000 ～49,999 千円</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">3.3/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">3.2/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">3.6/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">3.8/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">2.8/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">3.6/1000</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="RowHead"><text:p text:style-name="Center">50,000～99,999 千円</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">2.9/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">2.8/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">2.8/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">3.1/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">2.7/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">3.1/1000</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="RowHead"><text:p text:style-name="Center">100,000～499,999 千円</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">2.3/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">2.1/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">2.1/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">2.5/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">1.9/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">2.3/1000</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="RowHead"><text:p text:style-name="Center">500,000 千円以上</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">1.7/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">1.6/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">1.9/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">1.8/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">1.7/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">1.8/1000</text:p></table:table-cell></table:table-row>
      </table:table>
      <table:table table:name="建築設備の掛金率">
        <table:table-column table:style-name="TableBottomLabel"/>
        <table:table-column table:style-name="TableBottomCol"/>
        <table:table-column table:style-name="TableBottomCol"/>
        <table:table-column table:style-name="TableBottomCol"/>
        <table:table-column table:style-name="TableBottomCol"/>
        <table:table-row>
          <table:table-cell table:style-name="HeadBlue" table:number-rows-spanned="2"><text:p text:style-name="Center"/></table:table-cell>
          <table:table-cell table:style-name="HeadBlue" table:number-columns-spanned="2"><text:p text:style-name="Center">建　築</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="HeadBlue" table:number-columns-spanned="2"><text:p text:style-name="Center">設　備</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="SubBlue"><text:p text:style-name="Center">住宅･同設備</text:p></table:table-cell>
          <table:table-cell table:style-name="SubBlue"><text:p text:style-name="Center">非住宅･同設備</text:p></table:table-cell>
          <table:table-cell table:style-name="SubBlue"><text:p text:style-name="Center">屋外の電気等</text:p></table:table-cell>
          <table:table-cell table:style-name="SubBlue"><text:p text:style-name="Center">機械器具設置</text:p></table:table-cell>
        </table:table-row>
        <table:table-row><table:table-cell table:style-name="RowHead"><text:p text:style-name="Center">1,000 ～9,999 千円</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">4.8/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">3.2/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">2.9/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">2.2/1000</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="RowHead"><text:p text:style-name="Center">10,000 ～49,999 千円</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">2.9/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">3.0/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">2.1/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">1.7/1000</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="RowHead"><text:p text:style-name="Center">50,000～99,999 千円</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">2.7/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">2.5/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">1.8/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">1.4/1000</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="RowHead"><text:p text:style-name="Center">100,000～499,999 千円</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">2.2/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">2.1/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">1.4/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">1.1/1000</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="RowHead"><text:p text:style-name="Center">500,000 千円以上</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">2.0/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">1.8/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">1.1/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">1.1/1000</text:p></table:table-cell></table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>