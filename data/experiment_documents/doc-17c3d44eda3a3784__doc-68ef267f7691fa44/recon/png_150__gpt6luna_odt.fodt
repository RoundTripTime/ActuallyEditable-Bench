<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Normal" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.15cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="Normal">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="1.1cm" fo:margin-bottom="1.15cm"/>
      <style:text-properties fo:font-size="22pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Page2Title" style:family="paragraph" style:parent-style-name="Normal">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.6cm" fo:margin-bottom="1.0cm" fo:break-before="page"/>
      <style:text-properties fo:font-size="21pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph" style:parent-style-name="Normal">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="1pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph" style:parent-style-name="Normal">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph" style:parent-style-name="Normal">
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="TableText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="115%"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="TableHeader" style:family="paragraph" style:parent-style-name="TableText">
      <style:text-properties fo:font-size="9pt" fo:font-weight="bold"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-top="1.6cm" fo:margin-bottom="1.6cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
    </style:page-layout>
    <style:style style:name="ReceiptTable" style:family="table">
      <style:table-properties style:width="13cm" table:align="center"/>
    </style:style>
    <style:style style:name="ReceiptCol" style:family="table-column">
      <style:table-column-properties style:column-width="13cm"/>
    </style:style>
    <style:style style:name="ReceiptCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.04cm dashed #000000" fo:padding="0.2cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="SoilTable" style:family="table">
      <style:table-properties style:width="16.5cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="SoilLabelCol" style:family="table-column">
      <style:table-column-properties style:column-width="3.4cm"/>
    </style:style>
    <style:style style:name="SoilDataCol" style:family="table-column">
      <style:table-column-properties style:column-width="2.18cm"/>
    </style:style>
    <style:style style:name="BuildTable" style:family="table">
      <style:table-properties style:width="16.5cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="BuildLabelCol" style:family="table-column">
      <style:table-column-properties style:column-width="4.4cm"/>
    </style:style>
    <style:style style:name="BuildDataCol" style:family="table-column">
      <style:table-column-properties style:column-width="3.025cm"/>
    </style:style>
    <style:style style:name="GridCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.03cm solid #666666" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="BlueHead" style:family="table-cell">
      <style:table-cell-properties fo:border="0.03cm solid #666666" fo:padding="0.08cm" fo:background-color="#B7D9F2" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="PaleHead" style:family="table-cell">
      <style:table-cell-properties fo:border="0.03cm solid #666666" fo:padding="0.08cm" fo:background-color="#E3F0FA" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="RowLabel" style:family="table-cell">
      <style:table-cell-properties fo:border="0.03cm solid #666666" fo:padding="0.08cm" fo:background-color="#EEEEEE" style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">建設業退職金共済掛金収納書</text:p>
      <text:p text:style-name="Center">受注者</text:p>
      <text:p text:style-name="Center">住所</text:p>
      <text:p text:style-name="Center">商号又は名称</text:p>
      <text:p text:style-name="Center">代表者氏名　　　　　　　　　　　　　　　印</text:p>
      <text:p text:style-name="Normal"/>
      <text:p>工事名</text:p>
      <text:p>________________________________________________________________________________</text:p>
      <text:p text:style-name="Normal"/>
      <text:p>（共済掛金の目安）</text:p>
      <text:p text:style-name="Normal"/>
      <text:p>........................................円 × ..................................... ／1,000 × ..................... ％ ／ 70％ ＝ ....................................................円</text:p>
      <text:p text:style-name="Center">　　　　　　　　　①　　　　　　　　　　　　　　　②　　　　　　　　　③</text:p>
      <text:p text:style-name="Normal">※上記計算式中、①＝請負金額、②＝次ページ掲載「共済証紙購入の考え方」の表を参照、</text:p>
      <text:p>③＝労働者の建退共制度加入率とする。</text:p>
      <text:p text:style-name="Normal"/>
      <table:table table:name="ReceiptArea" table:style-name="ReceiptTable">
        <table:table-column table:style-name="ReceiptCol"/>
        <table:table-row>
          <table:table-cell table:style-name="ReceiptCell">
            <text:p text:style-name="Center">収納書貼付箇所</text:p>
            <text:p text:style-name="Center">※契約者記入欄は必ず記入して下さい</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="Page2Title">建設業退職金共済掛金収納書（計算例）</text:p>
      <text:p>◆計算例 1　（その他の土木）</text:p>
      <text:p>請負額：9,000,000 円　　建退共制度加入率：50%　の場合</text:p>
      <text:p>（掛金計算式）　9,000,000 円 ×　4.1／1000 ×　50% ／ 70%＝　26,357 円</text:p>
      <text:p text:style-name="Center">請負金額　　　　　　　　　下記の表より　　　　加入率</text:p>
      <text:p>◆計算例 2　（その他の土木）</text:p>
      <text:p>請負額：20,000,000 円　　建退共制度加入率：70%　の場合</text:p>
      <text:p>（掛金計算式）　20,000,000 円 ×　3.6／1000 ×　70% ／ 70%＝　72,000 円</text:p>
      <text:p text:style-name="Center">請負金額　　　　　　　　　下記の表より　　　　加入率</text:p>
      <text:p text:style-name="Small">※詳細については建退共ホームページ（http://www.kentaikyo.taisyokukin.go.jp/）を参照</text:p>
      <text:p text:style-name="Center">「共済証紙購入の考え方」の表　（建退共ホームページより抜粋）</text:p>
      <table:table table:name="SoilRates" table:style-name="SoilTable">
        <table:table-column table:style-name="SoilLabelCol"/>
        <table:table-column table:style-name="SoilDataCol"/>
        <table:table-column table:style-name="SoilDataCol"/>
        <table:table-column table:style-name="SoilDataCol"/>
        <table:table-column table:style-name="SoilDataCol"/>
        <table:table-column table:style-name="SoilDataCol"/>
        <table:table-column table:style-name="SoilDataCol"/>
        <table:table-row>
          <table:table-cell table:style-name="BlueHead" table:number-rows-spanned="2"/>
          <table:table-cell table:style-name="BlueHead" table:number-columns-spanned="6"><text:p text:style-name="TableHeader">土　木</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="PaleHead"><text:p text:style-name="TableHeader">舗装</text:p></table:table-cell>
          <table:table-cell table:style-name="PaleHead"><text:p text:style-name="TableHeader">橋梁等</text:p></table:table-cell>
          <table:table-cell table:style-name="PaleHead"><text:p text:style-name="TableHeader">隧道</text:p></table:table-cell>
          <table:table-cell table:style-name="PaleHead"><text:p text:style-name="TableHeader">堰堤</text:p></table:table-cell>
          <table:table-cell table:style-name="PaleHead"><text:p text:style-name="TableHeader">浚渫･埋立</text:p></table:table-cell>
          <table:table-cell table:style-name="PaleHead"><text:p text:style-name="TableHeader">その他の土木</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="RowLabel"><text:p text:style-name="TableText">1,000 ～9,999 千円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">3.5/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">3.5/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">4.5/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">4.1/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">3.7/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">4.1/1000</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="RowLabel"><text:p text:style-name="TableText">10,000 ～49,999 千円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">3.3/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">3.2/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">3.6/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">3.8/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.8/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">3.6/1000</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="RowLabel"><text:p text:style-name="TableText">50,000～99,999 千円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.9/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.8/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.8/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">3.1/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.7/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">3.1/1000</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="RowLabel"><text:p text:style-name="TableText">100,000～499,999 千円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.3/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.1/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.1/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.5/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">1.9/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.3/1000</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="RowLabel"><text:p text:style-name="TableText">500,000 千円以上</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">1.7/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">1.6/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">1.9/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">1.8/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">1.7/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">1.8/1000</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <table:table table:name="BuildRates" table:style-name="BuildTable">
        <table:table-column table:style-name="BuildLabelCol"/>
        <table:table-column table:style-name="BuildDataCol"/>
        <table:table-column table:style-name="BuildDataCol"/>
        <table:table-column table:style-name="BuildDataCol"/>
        <table:table-column table:style-name="BuildDataCol"/>
        <table:table-row>
          <table:table-cell table:style-name="BlueHead" table:number-rows-spanned="2"/>
          <table:table-cell table:style-name="BlueHead" table:number-columns-spanned="2"><text:p text:style-name="TableHeader">建　築</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="BlueHead" table:number-columns-spanned="2"><text:p text:style-name="TableHeader">設　備</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="PaleHead"><text:p text:style-name="TableHeader">住宅･同設備</text:p></table:table-cell>
          <table:table-cell table:style-name="PaleHead"><text:p text:style-name="TableHeader">非住宅･同設備</text:p></table:table-cell>
          <table:table-cell table:style-name="PaleHead"><text:p text:style-name="TableHeader">屋外の電気等</text:p></table:table-cell>
          <table:table-cell table:style-name="PaleHead"><text:p text:style-name="TableHeader">機械器具設置</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="RowLabel"><text:p text:style-name="TableText">1,000 ～9,999 千円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">4.8/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">3.2/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.9/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.2/1000</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="RowLabel"><text:p text:style-name="TableText">10,000 ～49,999 千円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.9/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">3.0/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.1/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">1.7/1000</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="RowLabel"><text:p text:style-name="TableText">50,000～99,999 千円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.7/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.5/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">1.8/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">1.4/1000</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="RowLabel"><text:p text:style-name="TableText">100,000～499,999 千円</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.2/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.1/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">1.4/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">1.1/1000</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="RowLabel"><text:p text:style-name="TableText">500,000 千円以上</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">2.0/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">1.8/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">1.1/1000</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="TableText">1.1/1000</text:p></table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>