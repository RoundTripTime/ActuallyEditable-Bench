<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="0mm" fo:line-height="1"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="0mm" fo:line-height="1"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" style:print-orientation="portrait" fo:margin-left="25mm" fo:margin-right="25mm" fo:margin-top="20mm" fo:margin-bottom="20mm"/>
    </style:page-layout>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="8mm" fo:margin-bottom="0mm" fo:line-height="8mm"/>
      <style:text-properties fo:font-size="16pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="LeftText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0mm" fo:margin-bottom="0mm" fo:line-height="6mm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="RightText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end" fo:margin-top="0mm" fo:margin-bottom="0mm" fo:line-height="6mm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Gap11" style:family="paragraph">
      <style:paragraph-properties fo:line-height="11mm"/>
      <style:text-properties fo:font-size="1pt"/>
    </style:style>
    <style:style style:name="Gap14" style:family="paragraph">
      <style:paragraph-properties fo:line-height="14mm"/>
      <style:text-properties fo:font-size="1pt"/>
    </style:style>
    <style:style style:name="Gap10" style:family="paragraph">
      <style:paragraph-properties fo:line-height="10mm"/>
      <style:text-properties fo:font-size="1pt"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:line-height="1pt"/>
      <style:text-properties fo:font-size="1pt"/>
    </style:style>
    <style:style style:name="Statement" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:line-height="10mm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="1mm" style:vertical-align="middle"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="CellTight" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.5mm" style:vertical-align="middle"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="1mm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center" fo:line-height="5mm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="CellRight" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="1mm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="end" fo:line-height="5mm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Table16" style:family="table">
      <style:table-properties style:width="160mm" table:align="center"/>
    </style:style>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="22mm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="34mm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="48mm"/>
    </style:style>
    <style:style style:name="ColD" style:family="table-column">
      <style:table-column-properties style:column-width="56mm"/>
    </style:style>
    <style:style style:name="ColApplicant" style:family="table-column">
      <style:table-column-properties style:column-width="22mm"/>
    </style:style>
    <style:style style:name="ColLabel" style:family="table-column">
      <style:table-column-properties style:column-width="34mm"/>
    </style:style>
    <style:style style:name="ColWide" style:family="table-column">
      <style:table-column-properties style:column-width="104mm"/>
    </style:style>
    <style:style style:name="ColEquipLeft" style:family="table-column">
      <style:table-column-properties style:column-width="22mm"/>
    </style:style>
    <style:style style:name="ColEquipA" style:family="table-column">
      <style:table-column-properties style:column-width="64mm"/>
    </style:style>
    <style:style style:name="ColEquipB" style:family="table-column">
      <style:table-column-properties style:column-width="74mm"/>
    </style:style>
    <style:style style:name="Row13" style:family="table-row">
      <style:table-row-properties style:row-height="13mm"/>
    </style:style>
    <style:style style:name="Row29" style:family="table-row">
      <style:table-row-properties style:row-height="29mm"/>
    </style:style>
    <style:style style:name="Row11" style:family="table-row">
      <style:table-row-properties style:row-height="11mm"/>
    </style:style>
    <style:style style:name="Row20" style:family="table-row">
      <style:table-row-properties style:row-height="20mm"/>
    </style:style>
    <style:style style:name="RowEquip" style:family="table-row">
      <style:table-row-properties style:row-height="11mm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">領収証明書</text:p>
      <text:p text:style-name="Gap11"/>
      <text:p text:style-name="LeftText">（あて先）千葉市長</text:p>
      <text:p text:style-name="Gap14"/>
      <text:p text:style-name="RightText">年　　　月　　　日</text:p>
      <text:p text:style-name="Gap14"/>
      <text:p text:style-name="LeftText">住　所</text:p>
      <text:p text:style-name="Gap11"/>
      <text:p text:style-name="LeftText">名　称</text:p>
      <text:p text:style-name="Gap11"/>
      <text:p text:style-name="LeftText">代表者職氏名　　　　　　　　　　　　　　　　　　　　　　　　　　　　印</text:p>
      <text:p text:style-name="Gap14"/>
      <text:p text:style-name="Statement">次の顧客の千葉市住宅用設備等脱炭素化促進事業補助金に関し、下記内容で代金<text:line-break/>を受領いたしました。なお、本書は顧客のクレジット（ローン）返済金の受領を証<text:line-break/>するものではありません。</text:p>
      <text:p text:style-name="Gap10"/>
      <table:table table:name="Applicant" table:style-name="Table16">
        <table:table-column table:style-name="ColApplicant"/>
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColWide"/>
        <table:table-row table:style-name="Row13">
          <table:table-cell table:style-name="CellCenter" table:number-rows-spanned="2"><text:p>支払者<text:line-break/>（申請<text:line-break/>者）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="Row29">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>住所</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Gap10"/>
      <table:table table:name="PaymentFirst" table:style-name="Table16">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColD"/>
        <table:table-row table:style-name="Row11">
          <table:table-cell table:style-name="CellCenter" table:number-rows-spanned="3"><text:p>支払額</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>費　用</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>金　額</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>入金（受領）日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="Row11">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellCenter"><text:p>現　金</text:p></table:table-cell>
          <table:table-cell table:style-name="CellRight"><text:p>円</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>年　月　日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="Row11">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellCenter"><text:p>クレジット</text:p></table:table-cell>
          <table:table-cell table:style-name="CellRight"><text:p>円</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>年　月　日</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageBreak"/>
      <text:p text:style-name="Gap10"/>
      <table:table table:name="PaymentContinuation" table:style-name="Table16">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColD"/>
        <table:table-row table:style-name="Row11">
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2"/>
          <table:table-cell table:style-name="CellCenter"><text:p>（ローン）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="Row11">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellCenter"><text:p>合　計</text:p></table:table-cell>
          <table:table-cell table:style-name="CellRight" table:number-columns-spanned="2"><text:p>円</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <table:table table:name="Equipment" table:style-name="Table16">
        <table:table-column table:style-name="ColEquipLeft"/>
        <table:table-column table:style-name="ColEquipA"/>
        <table:table-column table:style-name="ColEquipB"/>
        <table:table-row table:style-name="RowEquip">
          <table:table-cell table:style-name="CellCenter" table:number-rows-spanned="5"><text:p>支払対象<text:line-break/>設備<text:line-break/>（該当す<text:line-break/>る設備に<text:line-break/>チェッ<text:line-break/>ク）</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTight"><text:p>□太陽光発電システム</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTight"><text:p>□電気自動車</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowEquip">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellTight"><text:p>□ZEH＋</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTight"><text:p>□プラグインハイブリッド</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowEquip">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellTight"><text:p>□家庭用燃料電池システム(エネファーム)</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTight"><text:p>□V2H 充放電設備</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowEquip">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellTight"><text:p>□定置用リチウムイオン蓄電システム</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTight"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellTight"><text:p>□窓の断熱改修</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTight"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Gap14"/>
      <text:p text:style-name="LeftText">※原本でのご提出をお願いします</text:p>
    </office:text>
  </office:body>
</office:document>