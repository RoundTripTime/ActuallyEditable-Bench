<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin="0mm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="12pt"/>
    </style:default-style>
    <style:style style:name="DefaultTable" style:family="table">
      <style:table-properties style:width="160mm"/>
    </style:style>
    <style:style style:name="BaseText" style:family="paragraph">
      <style:paragraph-properties fo:margin="0mm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="12pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" fo:print-orientation="portrait" fo:margin-top="20mm" fo:margin-bottom="20mm" fo:margin-left="25mm" fo:margin-right="25mm"/>
    </style:page-layout>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="8mm" fo:margin-bottom="14mm" fo:line-height="7mm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="16pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="3mm" fo:margin-bottom="0mm" fo:line-height="7mm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Date" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="14mm" fo:margin-bottom="15mm" fo:line-height="7mm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="InfoLabel" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="60mm" fo:line-height="10mm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="BodyLineFirst" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="4mm" fo:margin-top="12mm" fo:line-height="10.5mm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="BodyLine" style:family="paragraph">
      <style:paragraph-properties fo:line-height="10.5mm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="AfterBody" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="6mm" fo:line-height="1mm"/>
      <style:text-properties fo:font-size="1pt"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin="0mm" fo:line-height="1mm"/>
      <style:text-properties fo:font-size="1pt"/>
    </style:style>
    <style:style style:name="Page2Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="14mm" fo:line-height="7mm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="CenterCell" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="RightCell" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="SmallCell" style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="1mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="21.7mm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="37.4mm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="49.4mm"/>
    </style:style>
    <style:style style:name="ColD" style:family="table-column">
      <style:table-column-properties style:column-width="51.5mm"/>
    </style:style>
    <style:style style:name="InfoColA" style:family="table-column">
      <style:table-column-properties style:column-width="21.7mm"/>
    </style:style>
    <style:style style:name="InfoColB" style:family="table-column">
      <style:table-column-properties style:column-width="37.1mm"/>
    </style:style>
    <style:style style:name="InfoColC" style:family="table-column">
      <style:table-column-properties style:column-width="98.6mm"/>
    </style:style>
    <style:style style:name="BreakColC" style:family="table-column">
      <style:table-column-properties style:column-width="26.4mm"/>
    </style:style>
    <style:style style:name="BreakColD" style:family="table-column">
      <style:table-column-properties style:column-width="23mm"/>
    </style:style>
    <style:style style:name="BreakColE" style:family="table-column">
      <style:table-column-properties style:column-width="51.5mm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="DefaultPage" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">領収証明書</text:p>
      <text:p text:style-name="Recipient">（あて先）千葉市長</text:p>
      <text:p text:style-name="Date">年　　　月　　　日</text:p>
      <text:p text:style-name="InfoLabel">住　所</text:p>
      <text:p text:style-name="InfoLabel">名　称</text:p>
      <text:p text:style-name="InfoLabel">代表者職氏名　　　　　　　　　　　　　　　　印</text:p>
      <text:p text:style-name="BodyLineFirst">次の顧客の千葉市住宅用設備等脱炭素化促進事業補助金に関し、下記内容で代金</text:p>
      <text:p text:style-name="BodyLine">を受領いたしました。なお、本書は顧客のクレジット（ローン）返済金の受領を証</text:p>
      <text:p text:style-name="BodyLine">するものではありません。</text:p>
      <text:p text:style-name="AfterBody"/>
      <table:table table:name="PayerInformation" table:style-name="DefaultTable">
        <table:table-column table:style-name="InfoColA"/>
        <table:table-column table:style-name="InfoColB"/>
        <table:table-column table:style-name="InfoColC"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2"><text:p text:style-name="CenterCell">支払者</text:p><text:p text:style-name="CenterCell">（ 申 請 者）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>住所</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="AfterBody"/>
      <table:table table:name="PaymentInformation" table:style-name="DefaultTable">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColD"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="3"><text:p text:style-name="CenterCell">支払額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterCell">費　用</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterCell">金　額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterCell">入金（受領）日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterCell">現　金</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightCell">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterCell">年　月　日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterCell">クレジット</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightCell">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterCell">年　月　日</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageBreak"/>
      <table:table table:name="PaymentContinuationAndEquipment" table:style-name="DefaultTable">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="BreakColC"/>
        <table:table-column table:style-name="BreakColD"/>
        <table:table-column table:style-name="BreakColE"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterCell">（ローン）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterCell">合　計</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="RightCell">円</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="5"><text:p text:style-name="CenterCell">支払対象</text:p><text:p text:style-name="CenterCell">設備</text:p><text:p text:style-name="CenterCell">（該当す</text:p><text:p text:style-name="CenterCell">る設備に</text:p><text:p text:style-name="CenterCell">チェック）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="SmallCell">□太陽光発電システム</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="SmallCell">□電気自動車</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="SmallCell">□ZEH＋</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="SmallCell">□プラグインハイブリッド</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="SmallCell">□家庭用燃料電池システム(エネファーム)</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="SmallCell">□V2H 充放電設備</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="SmallCell">□定置用リチウムイオン蓄電システム</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="SmallCell">□窓の断熱改修</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Page2Note">※原本でのご提出をお願いします</text:p>
    </office:text>
  </office:body>
</office:document>