<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="InvoiceTable" style:family="table"/>
    <style:style style:name="InvoiceColumn" style:family="table-column">
      <style:table-column-properties style:column-width="2.64cm"/>
    </style:style>
    <style:style style:name="InvoiceRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.49cm"/>
    </style:style>
    <style:style style:name="InvoiceCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #c8d5e3" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="1.25cm" fo:margin-right="1.25cm" fo:margin-top="1.6cm" fo:margin-bottom="1.6cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Body">FACTURE</text:p>
      <text:p text:style-name="Body">MODÈLE VIERGE — À COMPLÉTER</text:p>
      <text:p text:style-name="Body">Émetteur : À compléter</text:p>
      <text:p text:style-name="Body">Adresse émetteur : À compléter</text:p>
      <text:p text:style-name="Body">ICE / IF / RC (selon situation) : À compléter</text:p>
      <text:p text:style-name="Body">Client : À compléter</text:p>
      <text:p text:style-name="Body">Adresse et ICE client : À compléter</text:p>
      <text:p text:style-name="Body">Numéro / Date : À compléter dans votre série</text:p>
      <text:p text:style-name="Body">Référence devis / commande : À compléter si applicable</text:p>
      <text:p text:style-name="Body">Instructions : Remplacez les exemples, choisissez la TVA applicable et vérifiez la numérotation.</text:p>
      <table:table table:name="Facture" table:style-name="InvoiceTable">
        <table:table-column table:style-name="InvoiceColumn" table:number-columns-repeated="7"/>
        <table:table-row table:style-name="InvoiceRow">
          <table:table-cell table:style-name="InvoiceCell"><text:p text:style-name="Body">Désignation</text:p></table:table-cell>
          <table:table-cell table:style-name="InvoiceCell"><text:p text:style-name="Body">Quantité</text:p></table:table-cell>
          <table:table-cell table:style-name="InvoiceCell"><text:p text:style-name="Body">P.U. HT (MAD)</text:p></table:table-cell>
          <table:table-cell table:style-name="InvoiceCell"><text:p text:style-name="Body">TVA (%)</text:p></table:table-cell>
          <table:table-cell table:style-name="InvoiceCell"><text:p text:style-name="Body">HT (MAD)</text:p></table:table-cell>
          <table:table-cell table:style-name="InvoiceCell"><text:p text:style-name="Body">TVA (MAD)</text:p></table:table-cell>
          <table:table-cell table:style-name="InvoiceCell"><text:p text:style-name="Body">TTC (MAD)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InvoiceRow">
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
        </table:table-row>
        <table:table-row table:style-name="InvoiceRow">
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
        </table:table-row>
        <table:table-row table:style-name="InvoiceRow">
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
        </table:table-row>
        <table:table-row table:style-name="InvoiceRow">
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
        </table:table-row>
        <table:table-row table:style-name="InvoiceRow">
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
        </table:table-row>
        <table:table-row table:style-name="InvoiceRow">
          <table:table-cell table:style-name="InvoiceCell"><text:p text:style-name="Body">TOTAUX</text:p></table:table-cell>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
          <table:table-cell table:style-name="InvoiceCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body">Conditions / mentions complémentaires : À compléter selon votre activité et l’opération.</text:p>
      <text:p text:style-name="Body">TVA de 20 % utilisée uniquement pour illustrer le calcul ; aucun taux n’est présumé applicable.</text:p>
      <text:p text:style-name="Body">Vérifiez les mentions applicables avant utilisation.</text:p>
      <text:p text:style-name="Body">Modèle gratuit FactureGo — https://facturego.ma/modele-facture-ice-gratuit</text:p>
    </office:text>
  </office:body>
</office:document>