<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Default" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0.08in" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0.04in" fo:margin-bottom="0.20in" fo:line-height="100%" fo:border-bottom="1.2pt solid #4A80C2" fo:padding-bottom="0.08in"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="30pt" fo:color="#1C3A63"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.08in" fo:margin-bottom="0.08in" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="FieldLabel" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0in" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:font-weight="bold" fo:color="#35649A"/>
    </style:style>
    <style:style style:name="FieldLine" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0in" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#35649A"/>
    </style:style>
    <style:style style:name="GridHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0in" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:font-weight="bold" fo:color="#35649A"/>
    </style:style>
    <style:style style:name="BodyNote" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.07in" fo:margin-bottom="0.07in" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="FooterText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0in" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="9pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Strong" style:family="text">
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="8.27in" fo:page-height="11.69in" fo:print-orientation="portrait" fo:margin-left="0.55in" fo:margin-right="0.55in" fo:margin-top="0.58in" fo:margin-bottom="0.58in"/>
      <style:footer-style/>
    </style:page-layout>
    <style:style style:name="MetaLeftCol" style:family="table-column">
      <style:table-column-properties style:column-width="3.72in"/>
    </style:style>
    <style:style style:name="MetaRightCol" style:family="table-column">
      <style:table-column-properties style:column-width="3.45in"/>
    </style:style>
    <style:style style:name="MetaLabelCell" style:family="table-cell">
      <style:table-cell-properties fo:padding-left="0.08in" fo:padding-right="0.08in" fo:padding-top="0.04in" fo:padding-bottom="0.04in"/>
    </style:style>
    <style:style style:name="MetaInputCell" style:family="table-cell">
      <style:table-cell-properties fo:padding-left="0.08in" fo:padding-right="1.00in" fo:padding-top="0.04in" fo:padding-bottom="0.04in" fo:border-bottom="0.8pt solid #35649A"/>
    </style:style>
    <style:style style:name="MetaBand" style:family="table-row">
      <style:table-row-properties style:row-height="0.24in" fo:background-color="#D5E1EF"/>
    </style:style>
    <style:style style:name="MetaPlain" style:family="table-row">
      <style:table-row-properties style:row-height="0.24in"/>
    </style:style>
    <style:style style:name="GridCol1" style:family="table-column">
      <style:table-column-properties style:column-width="3.04in"/>
    </style:style>
    <style:style style:name="GridCol2" style:family="table-column">
      <style:table-column-properties style:column-width="1.00in"/>
    </style:style>
    <style:style style:name="GridCol3" style:family="table-column">
      <style:table-column-properties style:column-width="1.36in"/>
    </style:style>
    <style:style style:name="GridCol4" style:family="table-column">
      <style:table-column-properties style:column-width="1.77in"/>
    </style:style>
    <style:style style:name="GridHeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:padding-left="0.08in" fo:padding-right="0.05in" fo:padding-top="0.03in" fo:padding-bottom="0.06in" fo:border-top="1pt solid #4A80C2" fo:border-bottom="1pt solid #4A80C2"/>
    </style:style>
    <style:style style:name="GridBand" style:family="table-row">
      <style:table-row-properties style:row-height="0.28in" fo:background-color="#D5E1EF"/>
    </style:style>
    <style:style style:name="GridGap" style:family="table-row">
      <style:table-row-properties style:row-height="0.16in"/>
    </style:style>
    <style:style style:name="GridCell" style:family="table-cell">
      <style:table-cell-properties fo:padding-left="0.06in" fo:padding-right="0.06in" fo:padding-top="0.03in" fo:padding-bottom="0.03in"/>
    </style:style>
    <style:style style:name="Totals" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0.07in" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Subtotal" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.20in" fo:margin-bottom="0.10in" fo:line-height="100%" fo:border-top="1pt solid #4A80C2" fo:padding-top="0.02in"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout">
      <style:footer>
        <text:p text:style-name="FooterText">OnlineBiller | Original English resource | Blank template</text:p>
      </style:footer>
    </style:master-page>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">Purchase Order</text:p>
      <text:p text:style-name="Subtitle">BLANK TEMPLATE | Currency: INR</text:p>
      <table:table table:name="OrderDetails">
        <table:table-column table:style-name="MetaLeftCol"/>
        <table:table-column table:style-name="MetaRightCol"/>
        <table:table-row table:style-name="MetaPlain">
          <table:table-cell table:style-name="MetaLabelCell"><text:p text:style-name="FieldLabel">Buyer</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaInputCell"><text:p text:style-name="FieldLine"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="MetaBand">
          <table:table-cell table:style-name="MetaLabelCell"><text:p text:style-name="FieldLabel">Supplier</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaInputCell"><text:p text:style-name="FieldLine"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="MetaPlain">
          <table:table-cell table:style-name="MetaLabelCell"><text:p text:style-name="FieldLabel">PO / date</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaInputCell"><text:p text:style-name="FieldLine"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="MetaBand">
          <table:table-cell table:style-name="MetaLabelCell"><text:p text:style-name="FieldLabel">Quote reference</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaInputCell"><text:p text:style-name="FieldLine"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="MetaPlain">
          <table:table-cell table:style-name="MetaLabelCell"><text:p text:style-name="FieldLabel">Requested delivery</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaInputCell"><text:p text:style-name="FieldLine"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="MetaBand">
          <table:table-cell table:style-name="MetaLabelCell"><text:p text:style-name="FieldLabel">Ship to</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaInputCell"><text:p text:style-name="FieldLine"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="MetaPlain">
          <table:table-cell table:style-name="MetaLabelCell"><text:p text:style-name="FieldLabel">Payment terms</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaInputCell"><text:p text:style-name="FieldLine"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="MetaBand">
          <table:table-cell table:style-name="MetaLabelCell"><text:p text:style-name="FieldLabel">Authorized buyer</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaInputCell"><text:p text:style-name="FieldLine"/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Subtitle"/>
      <table:table table:name="OrderItems">
        <table:table-column table:style-name="GridCol1"/>
        <table:table-column table:style-name="GridCol2"/>
        <table:table-column table:style-name="GridCol3"/>
        <table:table-column table:style-name="GridCol4"/>
        <table:table-row>
          <table:table-cell table:style-name="GridHeaderCell"><text:p text:style-name="GridHeading">Description</text:p></table:table-cell>
          <table:table-cell table:style-name="GridHeaderCell"><text:p text:style-name="GridHeading">Quantity</text:p></table:table-cell>
          <table:table-cell table:style-name="GridHeaderCell"><text:p text:style-name="GridHeading">Rate (INR)</text:p></table:table-cell>
          <table:table-cell table:style-name="GridHeaderCell"><text:p text:style-name="GridHeading">Amount (INR)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="GridBand">
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="GridGap">
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="GridBand">
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="GridGap">
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="GridBand">
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="GridGap">
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="GridBand">
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Subtotal"><text:span text:style-name="Strong">Subtotal:</text:span> INR __________</text:p>
      <text:p text:style-name="Totals"><text:span text:style-name="Strong">Order value:</text:span> INR __________</text:p>
      <text:p text:style-name="BodyNote">Buyer-issued order example; not a supplier invoice or payment receipt.</text:p>
      <text:p text:style-name="BodyNote">No inventory, supplier approval or tax classification is performed.</text:p>
      <text:p text:style-name="BodyNote">Word amounts are manual. Check line amounts and totals after every edit.</text:p>
    </office:text>
  </office:body>
</office:document>