<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties style:font-name="Arial" fo:font-size="10pt" fo:color="#000000"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.25cm" fo:padding-bottom="0.2cm" fo:border-bottom="0.7pt solid #4F81BD"/>
      <style:text-properties style:font-name="Arial" fo:font-size="26pt" fo:color="#17365D"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.2cm" fo:margin-bottom="0.2cm"/>
      <style:text-properties style:font-name="Arial" fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Label" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties style:font-name="Arial" fo:font-size="10pt" fo:font-weight="bold" fo:color="#365F91"/>
    </style:style>
    <style:style style:name="Field" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties style:font-name="Arial" fo:font-size="10pt" fo:color="#365F91"/>
    </style:style>
    <style:style style:name="ColumnHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties style:font-name="Arial" fo:font-size="9pt" fo:font-weight="bold" fo:color="#365F91"/>
    </style:style>
    <style:style style:name="BodyText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.15cm" fo:margin-bottom="0cm"/>
      <style:text-properties style:font-name="Arial" fo:font-size="10pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Total" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.15cm" fo:margin-bottom="0cm"/>
      <style:text-properties style:font-name="Arial" fo:font-size="10pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="BoldText" style:family="text">
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="MetaTable" style:family="table"/>
    <style:style style:name="ItemsTable" style:family="table"/>
    <style:style style:name="MetaCol" style:family="table-column">
      <style:table-column-properties style:column-width="9cm"/>
    </style:style>
    <style:style style:name="ItemCol1" style:family="table-column">
      <style:table-column-properties style:column-width="7.75cm"/>
    </style:style>
    <style:style style:name="ItemCol2" style:family="table-column">
      <style:table-column-properties style:column-width="2.52cm"/>
    </style:style>
    <style:style style:name="ItemCol3" style:family="table-column">
      <style:table-column-properties style:column-width="3.87cm"/>
    </style:style>
    <style:style style:name="ItemCol4" style:family="table-column">
      <style:table-column-properties style:column-width="3.87cm"/>
    </style:style>
    <style:style style:name="MetaCell" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:padding="0.08cm" fo:border="none"/>
    </style:style>
    <style:style style:name="MetaBand" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:padding="0.08cm" fo:border="none" fo:background-color="#D3DFEF"/>
    </style:style>
    <style:style style:name="MetaTop" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:padding="0.08cm" fo:border-top="0.7pt solid #4F81BD"/>
    </style:style>
    <style:style style:name="MetaBandTop" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:padding="0.08cm" fo:border-top="0.7pt solid #4F81BD" fo:background-color="#D3DFEF"/>
    </style:style>
    <style:style style:name="MetaBottomBand" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:padding="0.08cm" fo:border-bottom="0.7pt solid #4F81BD" fo:background-color="#D3DFEF"/>
    </style:style>
    <style:style style:name="MetaBottom" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:padding="0.08cm" fo:border-bottom="0.7pt solid #4F81BD"/>
    </style:style>
    <style:style style:name="ItemHead" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:padding="0.05cm" fo:border-top="0.7pt solid #4F81BD" fo:border-bottom="0.7pt solid #4F81BD"/>
    </style:style>
    <style:style style:name="ItemBand" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:padding="0.18cm 0.05cm" fo:border="none" fo:background-color="#D3DFEF"/>
    </style:style>
    <style:style style:name="ItemSpacer" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:padding="0.12cm 0.05cm" fo:border="none"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-left="1.4cm" fo:margin-right="1.4cm" fo:margin-top="1.35cm" fo:margin-bottom="1.1cm"/>
      <style:footer-style>
        <style:header-footer-properties fo:min-height="0.4cm" fo:margin-left="0cm" fo:margin-right="0cm"/>
      </style:footer-style>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout">
      <style:footer>
        <text:p><text:span>OnlineBiller | Original English resource | Blank template</text:span></text:p>
      </style:footer>
    </style:master-page>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">Purchase Order</text:p>
      <text:p text:style-name="Subtitle">BLANK TEMPLATE | Currency: INR</text:p>
      <table:table table:name="OrderDetails" table:style-name="MetaTable">
        <table:table-column table:style-name="MetaCol"/>
        <table:table-column table:style-name="MetaCol"/>
        <table:table-row>
          <table:table-cell table:style-name="MetaTop"><text:p text:style-name="Label">Buyer</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaTop"><text:p text:style-name="Field">_______________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaBand"><text:p text:style-name="Label">Supplier</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaBand"><text:p text:style-name="Field">_______________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="Label">PO / date</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="Field">_______________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaBand"><text:p text:style-name="Label">Quote reference</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaBand"><text:p text:style-name="Field">_______________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="Label">Requested delivery</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="Field">_______________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaBand"><text:p text:style-name="Label">Ship to</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaBand"><text:p text:style-name="Field">_______________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="Label">Payment terms</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="Field">_______________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaBottomBand"><text:p text:style-name="Label">Authorized buyer</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaBottomBand"><text:p text:style-name="Field">_______________________________</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p/>
      <table:table table:name="OrderLines" table:style-name="ItemsTable">
        <table:table-column table:style-name="ItemCol1"/>
        <table:table-column table:style-name="ItemCol2"/>
        <table:table-column table:style-name="ItemCol3"/>
        <table:table-column table:style-name="ItemCol4"/>
        <table:table-row>
          <table:table-cell table:style-name="ItemHead"><text:p text:style-name="ColumnHeading">Description</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHead"><text:p text:style-name="ColumnHeading">Quantity</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHead"><text:p text:style-name="ColumnHeading">Rate (INR)</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHead"><text:p text:style-name="ColumnHeading">Amount (INR)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ItemBand"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemBand"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemBand"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemBand"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ItemSpacer"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemSpacer"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemSpacer"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemSpacer"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ItemBand"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemBand"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemBand"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemBand"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ItemSpacer"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemSpacer"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemSpacer"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemSpacer"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ItemBand"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemBand"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemBand"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemBand"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ItemSpacer"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemSpacer"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemSpacer"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemSpacer"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ItemBand"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemBand"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemBand"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemBand"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Total"><text:span text:style-name="BoldText">Subtotal:</text:span> INR __________</text:p>
      <text:p text:style-name="Total"><text:span text:style-name="BoldText">Order value:</text:span> INR __________</text:p>
      <text:p text:style-name="BodyText">Buyer-issued order example; not a supplier invoice or payment receipt.</text:p>
      <text:p text:style-name="BodyText">No inventory, supplier approval or tax classification is performed.</text:p>
      <text:p text:style-name="BodyText">Word amounts are manual. Check line amounts and totals after every edit.</text:p>
    </office:text>
  </office:body>
</office:document>