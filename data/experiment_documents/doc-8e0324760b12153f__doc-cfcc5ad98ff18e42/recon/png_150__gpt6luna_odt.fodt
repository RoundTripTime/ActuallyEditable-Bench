        <table:table-row><table:table-cell table:style-name="c2_Cell" table:number-rows-spanned="2"><text:p text:style-name="c2_Label">工事施工者</text:p></table:table-cell><table:table-cell table:style-name="c2_Cell" table:number-columns-spanned="3"><text:p text:style-name="c2_Input">住所</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="c2_Cell" table:number-columns-spanned="3"><text:p text:style-name="c2_Input">氏名（電話　　　　　　　　　）</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
