<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%"/>
      <style:text-properties fo:font-family="serif" style:font-family-asian="serif" fo:font-size="12pt" style:font-size-asian="12pt"/>
    </style:default-style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:text-align="end" fo:margin-bottom="0.35in"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.28in" fo:margin-bottom="0.32in"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.28in" fo:margin-bottom="0.02in"/>
      <style:text-properties fo:font-size="15pt" style:font-size-asian="15pt"/>
    </style:style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:text-indent="0.8in" fo:line-height="145%" fo:margin-bottom="0.28in"/>
    </style:style>
    <style:style style:name="Attachments" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.02in" fo:margin-bottom="0.03in"/>
    </style:style>
    <style:style style:name="AttachmentItem" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.18in" fo:margin-bottom="0.01in"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="8.27in" fo:page-height="11.69in" style:print-orientation="portrait" fo:margin-top="1.35in" fo:margin-bottom="0.8in" fo:margin-left="1.18in" fo:margin-right="1.18in"/>
    </style:page-layout>
    <style:style style:name="SignatoryTable" style:family="table">
      <style:table-properties style:width="3.7in" table:align="right" fo:margin-top="0.02in" fo:margin-bottom="0.02in"/>
    </style:style>
    <style:style style:name="RoleCol" style:family="table-column">
      <style:table-column-properties style:column-width="1in"/>
    </style:style>
    <style:style style:name="LabelCol" style:family="table-column">
      <style:table-column-properties style:column-width="0.65in"/>
    </style:style>
    <style:style style:name="InputCol" style:family="table-column">
      <style:table-column-properties style:column-width="2.05in"/>
    </style:style>
    <style:style style:name="OpenCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0in" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="RoleCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0in" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="FieldText" style:family="paragraph">
      <style:paragraph-properties fo:line-height="145%"/>
    </style:style>
    <style:style style:name="NoteText" style:family="paragraph">
      <style:paragraph-properties fo:line-height="145%"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="DefaultPage" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">年<text:s text:c="4"/>月<text:s text:c="4"/>日</text:p>
      <text:p text:style-name="Recipient">（宛先）野田市長</text:p>
      <table:table table:name="Signatory" table:style-name="SignatoryTable">
        <table:table-column table:style-name="RoleCol"/>
        <table:table-column table:style-name="LabelCol"/>
        <table:table-column table:style-name="InputCol"/>
        <table:table-row>
          <table:table-cell table:style-name="RoleCell" table:number-rows-spanned="3">
            <text:p text:style-name="FieldText">交付決定者</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="OpenCell">
            <text:p text:style-name="FieldText">住所</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="OpenCell"><text:p text:style-name="FieldText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="OpenCell">
            <text:p text:style-name="FieldText">氏名</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="OpenCell"><text:p text:style-name="FieldText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="OpenCell">
            <text:p text:style-name="FieldText">電話番号</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="OpenCell"><text:p text:style-name="FieldText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="OpenCell"><text:p text:style-name="FieldText"/></table:table-cell>
          <table:table-cell table:style-name="OpenCell" table:number-columns-spanned="2">
            <text:p text:style-name="NoteText">法人その他の団体にあっては、事<text:line-break/>務所の所在地又は代表者の住所、<text:line-break/>名称及び代表者の氏名</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Title">野田市えんがわ支援事業補助金実績報告書</text:p>
      <text:p text:style-name="Body">年<text:s text:c="4"/>月<text:s text:c="4"/>日付け野福高第<text:s text:c="7"/>号により交付の決定のあった野<text:line-break/>田市えんがわ支援事業補助金について、次のとおり実績報告します。</text:p>
      <text:p text:style-name="Attachments">添付書類</text:p>
      <text:p text:style-name="AttachmentItem">（1）<text:s text:c="2"/>事業実績報告書（年次）</text:p>
      <text:p text:style-name="AttachmentItem">（2）<text:s text:c="2"/>収支決算書</text:p>
      <text:p text:style-name="AttachmentItem">（3）<text:s text:c="2"/>補助対象経費に掛かる支出を証する書類</text:p>
    </office:text>
  </office:body>
</office:document>