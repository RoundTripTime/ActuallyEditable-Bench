<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="120%"/>
      <style:text-properties style:font-name="serif" fo:font-size="12pt" fo:language="ja" fo:country="JP"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0cm" fo:margin-right="0cm"/>
      <style:text-properties style:font-name="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Date" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end" fo:margin-right="1.5cm" fo:margin-bottom="1.5cm"/>
      <style:text-properties style:font-name="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="1cm" fo:margin-top="1.4cm" fo:margin-bottom="1.3cm"/>
      <style:text-properties style:font-name="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Identity" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="10.2cm" fo:margin-bottom="0cm"/>
      <style:text-properties style:font-name="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="GroupNote" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="10.2cm" fo:margin-right="1cm" fo:margin-top="0.1cm" fo:margin-bottom="1.1cm"/>
      <style:text-properties style:font-name="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.5cm" fo:margin-bottom="0cm"/>
      <style:text-properties style:font-name="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Report" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0cm" fo:margin-right="0cm"/>
      <style:text-properties style:font-name="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Attachments" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0cm" fo:margin-top="1cm"/>
      <style:text-properties style:font-name="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="AttachmentItem" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.8cm"/>
      <style:text-properties style:font-name="serif" fo:font-size="12pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Date">年　　月　　日</text:p>
      <text:p text:style-name="Recipient">（宛先）野田市長</text:p>
      <text:p text:style-name="Identity">住所</text:p>
      <text:p text:style-name="Identity">交付決定者　氏名</text:p>
      <text:p text:style-name="Identity">電話番号</text:p>
      <text:p text:style-name="GroupNote">法人その他の団体にあっては、事<br/>務所の所在地又は代表者の住所、<br/>名称及び代表者の氏名</text:p>
      <text:p text:style-name="Title">野田市えんがわ支援事業補助金実績報告書</text:p>
      <text:p text:style-name="Report">　　年　　月　　日付け野福高第　　号により交付の決定のあった野</text:p>
      <text:p text:style-name="Report">田市えんがわ支援事業補助金について、次のとおり実績報告します。</text:p>
      <text:p text:style-name="Attachments">添付書類</text:p>
      <text:p text:style-name="AttachmentItem">（1）　事業実績報告書（年次）</text:p>
      <text:p text:style-name="AttachmentItem">（2）　収支決算書</text:p>
      <text:p text:style-name="AttachmentItem">（3）　補助対象経費に掛かる支出を証する書類</text:p>
    </office:text>
  </office:body>
</office:document>