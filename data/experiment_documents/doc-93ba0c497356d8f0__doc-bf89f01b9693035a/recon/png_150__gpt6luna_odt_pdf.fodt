<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="TopCode" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="7mm" fo:line-height="6mm"/>
      <style:text-properties style:font-name="Noto Serif CJK JP" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0mm" fo:margin-bottom="6mm" fo:line-height="8mm"/>
      <style:text-properties style:font-name="Noto Serif CJK JP" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Date" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end" fo:margin-top="0mm" fo:margin-bottom="7mm" fo:line-height="6mm"/>
      <style:text-properties style:font-name="Noto Serif CJK JP" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Applicant" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="59mm" fo:margin-top="0mm" fo:margin-bottom="0mm" fo:line-height="6mm"/>
      <style:text-properties style:font-name="Noto Serif CJK JP" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Mayor" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="7mm" fo:line-height="6mm"/>
      <style:text-properties style:font-name="Noto Serif CJK JP" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Intro" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="0mm" fo:line-height="6mm" fo:text-indent="4.4mm"/>
      <style:text-properties style:font-name="Noto Serif CJK JP" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="CellText" style:family="paragraph">
      <style:paragraph-properties fo:margin="0mm" fo:line-height="5.5mm"/>
      <style:text-properties style:font-name="Noto Serif CJK JP" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin="0mm" fo:line-height="5.5mm"/>
      <style:text-properties style:font-name="Noto Serif CJK JP" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="CellRight" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end" fo:margin="0mm" fo:line-height="5.5mm"/>
      <style:text-properties style:font-name="Noto Serif CJK JP" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="AttachText" style:family="paragraph">
      <style:paragraph-properties fo:margin="0mm" fo:line-height="7mm"/>
      <style:text-properties style:font-name="Noto Serif CJK JP" fo:font-size="11pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" fo:margin-left="30mm" fo:margin-right="30mm" fo:margin-top="25mm" fo:margin-bottom="25mm"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="148mm" table:align="margins"/>
    </style:style>
    <style:style style:name="Col45" style:family="table-column">
      <style:table-column-properties style:column-width="45mm"/>
    </style:style>
    <style:style style:name="Col25" style:family="table-column">
      <style:table-column-properties style:column-width="25.5mm"/>
    </style:style>
    <style:style style:name="Col77" style:family="table-column">
      <style:table-column-properties style:column-width="77.5mm"/>
    </style:style>
    <style:style style:name="Row15" style:family="table-row">
      <style:table-row-properties style:row-height="15.2mm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="Row30" style:family="table-row">
      <style:table-row-properties style:row-height="30mm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.2mm solid #333333" fo:padding="1.5mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="AttachCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.2mm solid #333333" fo:padding="1.5mm" style:vertical-align="top"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="TopCode">様式第６号(第１０条関係)</text:p>
      <text:p text:style-name="Title">尾道市生産性向上等促進事業補助金実績報告書</text:p>
      <text:p text:style-name="Date">年　　　月　　　日</text:p>
      <text:p text:style-name="Mayor">尾道市長　　　様</text:p>
      <text:p text:style-name="Applicant">住所及び所在地</text:p>
      <text:p text:style-name="Applicant">名　　　称</text:p>
      <text:p text:style-name="Applicant">代表者職・氏名</text:p>
      <text:p text:style-name="Intro">次のとおり事業を完了したので、尾道市生産性向上等促進事業補助金交付要</text:p>
      <text:p text:style-name="Intro">綱第１０条の規定により、関係書類を添えて提出します。</text:p>
      <table:table table:name="Form" table:style-name="FormTable">
        <table:table-column table:style-name="Col45"/>
        <table:table-column table:style-name="Col25"/>
        <table:table-column table:style-name="Col77"/>
        <table:table-row table:style-name="Row15">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellCenter">補助金交付決定番号</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2">
            <text:p text:style-name="CellCenter">年　　　月　　　日　　　第　　　号</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="Row15">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellCenter">補助事業等の名称</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2">
            <text:p text:style-name="CellCenter">□　生産性向上枠　　□　ＤＸ推進枠</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="Row15">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellText">補助事業等の実施場</text:p>
            <text:p text:style-name="CellText">所</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
          <table:covered-table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="Row15">
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellCenter">事　業　実　施　期　間</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2">
            <text:p text:style-name="CellCenter">年　　　月　　　日　～　　年　　　月　　　日</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="Row15">
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2">
            <text:p text:style-name="CellCenter">補　助　事　業　に　要　し　た　経　費</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellRight">円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="Row15">
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2">
            <text:p text:style-name="CellCenter">補　助　対　象　事　業　費</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellRight">円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="Row15">
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2">
            <text:p text:style-name="CellCenter">補　助　金　交　付　決　定　額</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellRight">円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="Row30">
          <table:table-cell table:style-name="AttachCell" table:number-columns-spanned="3">
            <text:p text:style-name="AttachText">添付書類</text:p>
            <text:p text:style-name="AttachText">１　事業収支決算書（別紙）</text:p>
            <text:p text:style-name="AttachText">２　補助対象事業を実施したことを証明する書類</text:p>
            <text:p text:style-name="AttachText">３　支払を証明する書類の写し</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="AttachCell"/>
          <table:covered-table-cell table:style-name="AttachCell"/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>