<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#000000"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0pt" fo:margin-bottom="3pt"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="SmallNote" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0pt" fo:margin-bottom="11pt"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="9pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Name" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0pt" fo:margin-bottom="7pt"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="24pt" fo:font-weight="bold" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Role" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0pt" fo:margin-bottom="7pt"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="14pt" fo:font-weight="bold" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="10pt" fo:margin-bottom="7pt"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="12pt" fo:font-weight="bold" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Job" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="7pt" fo:margin-bottom="6pt"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="12pt" fo:font-weight="bold" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Bullet" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.25in" fo:text-indent="-0.25in" fo:margin-top="0pt" fo:margin-bottom="1pt"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Project" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0pt" fo:margin-bottom="7pt"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Education" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0pt" fo:margin-bottom="7pt"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="FooterNumber" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="54pt" fo:margin-bottom="0pt"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="9pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Strong" style:family="text">
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="8.27in" fo:page-height="11.69in" fo:margin-top="0.83in" fo:margin-bottom="0.83in" fo:margin-left="0.83in" fo:margin-right="0.83in" style:print-orientation="portrait"/>
    </style:page-layout>
    <style:style style:name="PageTwoStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0pt" fo:margin-bottom="6pt"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="12pt" fo:font-weight="bold" fo:color="#000000"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="SmallNote">Prefilled template - all experience and results are examples to replace.</text:p>
      <text:p text:style-name="Name">[Your full name]</text:p>
      <text:p text:style-name="Role">Senior Operations Coordinator</text:p>
      <text:p text:style-name="Body">[City or suburb, State] | [Phone number] | [Email address]</text:p>
      <text:p text:style-name="Section">Professional Summary</text:p>
      <text:p text:style-name="Body">Operations and customer service professional with nine years of experience supporting order fulfilment, supplier coordination and business administration. Combines practical Excel reporting with clear communication across warehouse, sales and finance teams. Experienced in managing delivery exceptions, documenting repeatable processes and helping colleagues adopt better ways of working. Seeking a senior operations role focused on reliable service and continuous improvement.</text:p>
      <text:p text:style-name="Section">Core Skills</text:p>
      <text:p text:style-name="Body"><text:span text:style-name="Strong">Operations:</text:span> Order processing, delivery scheduling, stock reconciliation, supplier follow-up and purchase order administration.</text:p>
      <text:p text:style-name="Body"><text:span text:style-name="Strong">Reporting and systems:</text:span> Excel pivot tables, XLOOKUP, data validation, weekly performance reporting, CRM records and shared order trackers.</text:p>
      <text:p text:style-name="Body"><text:span text:style-name="Strong">Customer service:</text:span> Enquiry triage, complaint resolution, delivery updates, written correspondence and escalation management.</text:p>
      <text:p text:style-name="Body"><text:span text:style-name="Strong">Team coordination:</text:span> Work allocation, onboarding, handover notes, stakeholder updates and cross-team problem solving.</text:p>
      <text:p text:style-name="Body"><text:span text:style-name="Strong">Process improvement:</text:span> Workflow mapping, standard operating procedures, exception tracking, document control and quality checks.</text:p>
      <text:p text:style-name="Section">Work Experience</text:p>
      <text:p text:style-name="Job">Senior Operations Coordinator</text:p>
      <text:p text:style-name="Body">[Employer 1] | Brisbane, QLD | March 2023 - Present</text:p>
      <text:p text:style-name="Body">Coordinate daily order fulfilment for a fictional business-to-business distributor, working with an eight-person warehouse and customer service team.</text:p>
      <text:p text:style-name="Bullet">•　Coordinate approximately 180 customer orders each week, balancing stock availability, carrier cut-off times and delivery commitments across Queensland and northern NSW.</text:p>
      <text:p text:style-name="Bullet">•　Built an Excel exception tracker using XLOOKUP and data validation, reducing unresolved delivery enquiries older than two days from 24 to 9 per week over three months.</text:p>
      <text:p text:style-name="Bullet">•　Review open orders with warehouse and sales colleagues each morning, assign follow-up owners and provide customers with realistic delivery updates when schedules change.</text:p>
      <text:p text:style-name="Bullet">•　Reconcile purchase orders, delivery records and supplier invoices before finance approval, resolving quantity or price discrepancies with suppliers and internal requesters.</text:p>
      <text:p text:style-name="Bullet">•　Prepare a weekly operations report covering outstanding orders, returns and service exceptions, with clear actions for the operations manager and account team.</text:p>
      <text:p text:style-name="Bullet">•　Created a practical onboarding checklist and trained four new team members in order entry, escalation handling and consistent CRM record keeping.</text:p>
      <text:p text:style-name="FooterNumber">Page 1 of 2</text:p>
      <text:p text:style-name="PageTwoStart">Operations Administrator</text:p>
      <text:p text:style-name="Body">[Employer 2] | Brisbane, QLD | June 2020 - February 2023</text:p>
      <text:p text:style-name="Body">Supported purchasing, stock records and customer deliveries for a fictional homewares wholesaler.</text:p>
      <text:p text:style-name="Bullet">•　Processed approximately 120 sales orders each week, checking product codes, pricing and delivery details before releasing orders to the warehouse.</text:p>
      <text:p text:style-name="Bullet">•　Maintained purchase order and back-order registers for 15 suppliers, following up expected arrival dates and flagging shortages to the sales team.</text:p>
      <text:p text:style-name="Bullet">•　Introduced a daily order-checking checklist that reduced avoidable order-entry corrections from 18 to 7 per month during a six-month review.</text:p>
      <text:p text:style-name="Bullet">•　Assisted with monthly stock counts, investigated differences between physical counts and system records, and documented adjustments for manager approval.</text:p>
      <text:p text:style-name="Bullet">•　Prepared delivery paperwork, reconciled returned goods and kept shared customer records current so colleagues could respond without repeating earlier enquiries.</text:p>
      <text:p text:style-name="Job">Customer Service Officer</text:p>
      <text:p text:style-name="Body">[Employer 3] | Logan, QLD | July 2017 - May 2020</text:p>
      <text:p text:style-name="Bullet">•　Handled 35 to 45 customer enquiries per day by phone and email, explaining order status, product availability and the next steps for returns.</text:p>
      <text:p text:style-name="Bullet">•　Recorded accurate case notes and follow-up dates in the CRM, escalating unresolved delivery and billing issues to the appropriate team.</text:p>
      <text:p text:style-name="Bullet">•　Drafted reusable responses for common delivery questions, helping colleagues provide consistent information while adapting messages to each customer's situation.</text:p>
      <text:p text:style-name="Bullet">•　Supported new starters with call shadowing and demonstrated how to verify customer details, document commitments and close enquiries correctly.</text:p>
      <text:p text:style-name="Section">Selected Projects</text:p>
      <text:p text:style-name="Project"><text:span text:style-name="Strong">Returns handover guide:</text:span> Mapped the handover between customer service, the warehouse and finance, then wrote a one-page checklist explaining who approves, receives and credits a return.</text:p>
      <text:p text:style-name="Project"><text:span text:style-name="Strong">Monthly supplier review:</text:span> Combined delivery exceptions and back-order notes into a shared review sheet so the purchasing team could discuss recurring problems with suppliers using specific examples.</text:p>
      <text:p text:style-name="Section">Education</text:p>
      <text:p text:style-name="Education"><text:span text:style-name="Strong">Diploma of Business</text:span> | [Institution] | 2018</text:p>
      <text:p text:style-name="Education"><text:span text:style-name="Strong">Certificate III in Business</text:span> | [Institution] | 2016</text:p>
      <text:p text:style-name="Section">Professional Development</text:p>
      <text:p text:style-name="Education">Advanced Excel workshop | Internal professional development | 2024</text:p>
      <text:p text:style-name="Education">Customer complaint handling | Internal professional development | 2022</text:p>
      <text:p text:style-name="Education">Workplace health and safety induction | Employer training | 2023</text:p>
      <text:p text:style-name="FooterNumber">Page 2 of 2</text:p>
    </office:text>
  </office:body>
</office:document>