<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%" fo:margin-bottom="0.08in"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%" fo:margin-bottom="0.08in"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.22in" fo:margin-bottom="0.20in"/>
      <style:text-properties fo:font-size="18pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="CenteredBoldUnderline" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.08in" fo:margin-bottom="0.06in"/>
      <style:text-properties fo:font-size="14pt" fo:font-weight="bold" style:text-underline-style="solid"/>
    </style:style>
    <style:style style:name="Reminder" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="120%" fo:margin-bottom="0.02in"/>
      <style:text-properties fo:font-size="12.5pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="FormFields" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.32in" fo:line-height="115%" fo:margin-bottom="0"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="8.27in" fo:page-height="11.69in" style:print-orientation="portrait" fo:margin-top="0.65in" fo:margin-bottom="0.65in" fo:margin-left="0.78in" fo:margin-right="0.78in"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="6.71in" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="FormColumn" style:family="table-column">
      <style:table-column-properties style:column-width="3.355in"/>
    </style:style>
    <style:style style:name="FormCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #333333" fo:padding="0.10in" style:vertical-align="middle"/>
      <style:text-properties fo:font-size="13pt"/>
    </style:style>
    <style:style style:name="BoldText" style:family="text">
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">徵收繼承案審查申請書</text:p>
      <text:p text:style-name="Body">受理機關：新北市政府地政局</text:p>
      <text:p text:style-name="Body">主旨：為領取　　工程徵收被繼承人____________所有土<text:line-break/>　　　地、建築改良物、農林作物徵收補償費，申請徵收繼承案件審查。</text:p>
      <text:p text:style-name="Body">說明：</text:p>
      <text:p text:style-name="Body">　一、土地坐落：　　區　　段　　小段　　　　地號。</text:p>
      <text:p text:style-name="Body">　二、建物坐落：　　區　　　路/街　　段　　巷　弄<text:line-break/>　　　號　樓。</text:p>
      <text:p text:style-name="Body">　三、檢附下列文件：</text:p>
      <table:table table:name="附件清單" table:style-name="FormTable">
        <table:table-column table:style-name="FormColumn"/>
        <table:table-column table:style-name="FormColumn"/>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p>1. 繼承系統表　份。</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p>2. 除戶謄本　份。</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p>3. 繼承人現戶戶籍謄本　份。</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p>4. 印鑑證明　份。（<text:span text:style-name="BoldText">以一年內核發者<text:line-break/>為限，遺產分割協議者須檢附</text:span>）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p>5. 新北市政府函通知影本　份。</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p>6. 切結書　份。</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p>7. 委託書　份。</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p>8. 遺產分割協議書　份。</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p>9. 其他。</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="CenteredBoldUnderline">貼心提醒您</text:p>
      <text:p text:style-name="Reminder">徵收補償費之領取，無論男女均得依民法第1138條規定之遺產繼承人相關順序繼承之；</text:p>
      <text:p text:style-name="Reminder">同性配偶亦有相互繼承之權利，互為法定繼承人，準用民法繼承編相關規定。</text:p>
      <text:p text:style-name="FormFields">申請人：</text:p>
      <text:p text:style-name="FormFields">身分證字號：</text:p>
      <text:p text:style-name="FormFields">住　址：</text:p>
      <text:p text:style-name="FormFields">通　訊　處：</text:p>
      <text:p text:style-name="FormFields">聯絡電話：</text:p>
      <text:p text:style-name="Body">中華民國　年　月　日</text:p>
    </office:text>
  </office:body>
</office:document>