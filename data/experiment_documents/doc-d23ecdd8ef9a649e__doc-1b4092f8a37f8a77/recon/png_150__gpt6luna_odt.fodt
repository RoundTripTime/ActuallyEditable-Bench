<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:default-style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.8cm" fo:margin-bottom="1.6cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
    </style:page-layout>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.25cm" fo:margin-bottom="0.35cm" fo:line-height="130%"/>
      <style:text-properties fo:font-size="18pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.12cm" fo:margin-bottom="0.12cm" fo:line-height="130%"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="Indented" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="1.3cm" fo:margin-top="0.12cm" fo:margin-bottom="0.12cm" fo:line-height="130%"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="TableCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0.2cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Column" style:family="table-column">
      <style:table-column-properties style:column-width="8.5cm"/>
    </style:style>
    <style:style style:name="Reminder" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.12cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-size="14pt" fo:font-weight="bold" style:text-underline-style="solid" style:text-underline-width="auto" style:text-underline-color="font-color"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.08cm" fo:margin-bottom="0.08cm" fo:line-height="130%"/>
      <style:text-properties fo:font-size="13pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Applicant" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.65cm" fo:line-height="125%"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="Date" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.45cm" fo:line-height="130%"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="Bold" style:family="text">
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">徵收繼承案審查申請書</text:p>
      <text:p text:style-name="Body">受理機關：新北市政府地政局</text:p>
      <text:p text:style-name="Body">主旨：為領取<text:s text:c="10"/>工程徵收被繼承人__________所有土</text:p>
      <text:p text:style-name="Indented">地、建築改良物、農林作物徵收補償費，申請徵收繼承案件審查。</text:p>
      <text:p text:style-name="Body">說明：</text:p>
      <text:p text:style-name="Indented">一、土地坐落：<text:s text:c="2"/>區<text:s text:c="2"/>段<text:s text:c="2"/>小段<text:s text:c="4"/>地號。</text:p>
      <text:p text:style-name="Indented">二、建物坐落：<text:s text:c="2"/>區<text:s text:c="3"/>路/街<text:s text:c="2"/>段<text:s text:c="2"/>巷<text:s text:c="2"/>弄</text:p>
      <text:p text:style-name="Indented"><text:s text:c="8"/>號<text:s text:c="2"/>樓。</text:p>
      <text:p text:style-name="Body">三、檢附下列文件：</text:p>
      <table:table table:name="附檢文件">
        <table:table-column table:style-name="Column"/>
        <table:table-column table:style-name="Column"/>
        <table:table-row>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="Body">1.繼承系統表<text:s text:c="2"/>份。</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="Body">2.除戶謄本<text:s text:c="2"/>份。</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="Body">3.繼承人現戶戶籍謄本<text:s text:c="2"/>份。</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="Body">4.印鑑證明<text:s text:c="2"/>份。（<text:span text:style-name="Bold">以一年內核發者<text:line-break/>為限，遺產分割協議者須檢附</text:span>）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="Body">5.新北市政府函通知影本<text:s text:c="2"/>份。</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="Body">6.切結書<text:s text:c="2"/>份。</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="Body">7.委託書<text:s text:c="2"/>份。</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="Body">8.遺產分割協議書<text:s text:c="2"/>份。</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="Body">9.其他。</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Reminder">貼心提醒您</text:p>
      <text:p text:style-name="Note">徵收補償費之領取，無論男女均得依民法第1138條規定之遺產繼承人相關順序繼承之；</text:p>
      <text:p text:style-name="Note">同性配偶亦有相互繼承之權利，互為法定繼承人，準用民法繼承編相關規定。</text:p>
      <text:p text:style-name="Applicant">申<text:s/>請<text:s/>人：</text:p>
      <text:p text:style-name="Applicant">身分證字號：</text:p>
      <text:p text:style-name="Applicant">住<text:s text:c="2"/>址：</text:p>
      <text:p text:style-name="Applicant">通<text:s text:c="2"/>訊<text:s text:c="2"/>處：</text:p>
      <text:p text:style-name="Applicant">聯絡電話：</text:p>
      <text:p text:style-name="Date">中華民國<text:s text:c="2"/>年<text:s text:c="2"/>月<text:s text:c="2"/>日</text:p>
    </office:text>
  </office:body>
</office:document>