<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:text-properties fo:font-size="12pt"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph" style:master-page-name="Standard">
      <style:paragraph-properties fo:text-align="center" fo:break-before="page" fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-size="18pt"/>
    </style:style>
    <style:style style:name="Info" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:line-height="38pt" fo:margin="0cm"/>
      <style:text-properties fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="CenteredCell" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin="0cm"/>
      <style:text-properties fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="Footnote" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0.35cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="FooterText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21.59cm" fo:page-height="27.94cm" fo:print-orientation="portrait" fo:margin-left="2.05cm" fo:margin-right="2.58cm" fo:margin-top="2.5cm" fo:margin-bottom="2cm"/>
    </style:page-layout>
    <style:style style:name="TableColumns1" style:family="table-column">
      <style:table-column-properties style:column-width="1.65cm"/>
    </style:style>
    <style:style style:name="TableColumns2" style:family="table-column">
      <style:table-column-properties style:column-width="3.3cm"/>
    </style:style>
    <style:style style:name="TableColumns3" style:family="table-column">
      <style:table-column-properties style:column-width="4cm"/>
    </style:style>
    <style:style style:name="TableColumns4" style:family="table-column">
      <style:table-column-properties style:column-width="8.01cm"/>
    </style:style>
    <style:style style:name="TopRow" style:family="table-row">
      <style:table-row-properties style:row-height="4.27cm"/>
    </style:style>
    <style:style style:name="HeaderRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.21cm"/>
    </style:style>
    <style:style style:name="DataRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.5cm"/>
    </style:style>
    <style:style style:name="GridCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #777777" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="MergedTopCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #777777" fo:padding="0.08cm" fo:padding-left="0.12cm" style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout">
      <style:footer>
        <text:p text:style-name="FooterText">第1頁 / 共1頁</text:p>
      </style:footer>
    </style:master-page>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">營業人資料表</text:p>
      <table:table table:name="營業人資料表">
        <table:table-column table:style-name="TableColumns1"/>
        <table:table-column table:style-name="TableColumns2"/>
        <table:table-column table:style-name="TableColumns3"/>
        <table:table-column table:style-name="TableColumns4"/>
        <table:table-row table:style-name="TopRow">
          <table:table-cell table:style-name="MergedTopCell" table:number-columns-spanned="4">
            <text:p text:style-name="Info">代理人名稱:</text:p>
            <text:p text:style-name="Info">統一編號：</text:p>
            <text:p text:style-name="Info">負責人:</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CenteredCell">序號</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CenteredCell">統一編號</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CenteredCell">稅籍編號</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CenteredCell">營業人名稱</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CenteredCell">1</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CenteredCell">2</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CenteredCell">3</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CenteredCell">4</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CenteredCell">5</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CenteredCell">6</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CenteredCell">7</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CenteredCell">8</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CenteredCell">9</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CenteredCell">10</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Footnote">每次申辦僅以代理同一局所轄營業人為限，如涉及跨局營業人，請按局分別申辦。</text:p>
    </office:text>
  </office:body>
</office:document>