<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.12in" fo:margin-bottom="0.12in" fo:line-height="1.0"/>
      <style:text-properties fo:font-size="20pt" style:font-size-asian="20pt"/>
    </style:style>
    <style:style style:name="FormLabel" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-left="0.05in" fo:margin-top="0.08in" fo:margin-bottom="0.08in" fo:line-height="0.34in"/>
      <style:text-properties fo:font-size="18pt" style:font-size-asian="18pt"/>
    </style:style>
    <style:style style:name="ColumnHeading" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin="0in" fo:line-height="0.42in"/>
      <style:text-properties fo:font-size="18pt" style:font-size-asian="18pt"/>
    </style:style>
    <style:style style:name="SerialNumber" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin="0in" fo:line-height="0.53in"/>
      <style:text-properties fo:font-size="17pt" style:font-size-asian="17pt"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0.18in" fo:margin-bottom="0in" fo:line-height="0.28in"/>
      <style:text-properties fo:font-size="14pt" style:font-size-asian="14pt"/>
    </style:style>
    <style:style style:name="PageCount" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.42in" fo:margin-bottom="0in" fo:line-height="0.22in"/>
      <style:text-properties fo:font-size="11pt" style:font-size-asian="11pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="8.5in" fo:page-height="11in" style:print-orientation="portrait" fo:margin-top="0.7in" fo:margin-bottom="0.55in" fo:margin-left="0.8in" fo:margin-right="0.8in"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="6.7in" table:align="center" style:may-break-between-rows="false"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="0.65in"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="1.3in"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="1.58in"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties style:column-width="3.17in"/>
    </style:style>
    <style:style style:name="FormCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #777777" fo:padding="0.03in" style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">營業人資料表</text:p>
      <table:table table:name="Form" table:style-name="FormTable">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-row>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="4">
            <text:p text:style-name="FormLabel">代理人名稱:</text:p>
            <text:p text:style-name="FormLabel">統一編號：</text:p>
            <text:p text:style-name="FormLabel">負責人：</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="ColumnHeading">序號</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="ColumnHeading">統一編號</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="ColumnHeading">稅籍編號</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="ColumnHeading">營業人名稱</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="SerialNumber">1</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="SerialNumber">2</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="SerialNumber">3</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="SerialNumber">4</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="SerialNumber">5</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="SerialNumber">6</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="SerialNumber">7</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="SerialNumber">8</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="SerialNumber">9</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="SerialNumber">10</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Note">每次申辦僅以代理同一局所轄營業人為限，如涉及跨局營業人，請按局分別申辦。</text:p>
      <text:p text:style-name="PageCount">第1頁 / 共1頁</text:p>
    </office:text>
  </office:body>
</office:document>