<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt" style:font-name="Liberation Serif"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.1cm" fo:margin-bottom="0.1cm"/>
      <style:text-properties fo:font-size="13pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:text-align="right"/>
    </style:style>
    <style:style style:name="Bold" style:family="paragraph" style:parent-style-name="P">
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="BoldCenter" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
    <style:style style:name="BorderBox" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:text-align="center" fo:padding="0.08cm" fo:border="0.02cm solid #000000"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-top="1cm" fo:margin-bottom="1cm" fo:margin-left="1cm" fo:margin-right="1cm"/>
    </style:page-layout>
    <style:style style:name="C" style:family="table-cell">
      <style:table-cell-properties fo:border="0.02cm solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CT" style:family="table-cell">
      <style:table-cell-properties fo:border="0.02cm solid #000000" fo:padding="0.08cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="C1" style:family="table-column">
      <style:table-column-properties style:column-width="1.6cm"/>
    </style:style>
    <style:style style:name="C2" style:family="table-column">
      <style:table-column-properties style:column-width="5.4cm"/>
    </style:style>
    <style:style style:name="C3" style:family="table-column">
      <style:table-column-properties style:column-width="1.8cm"/>
    </style:style>
    <style:style style:name="C4" style:family="table-column">
      <style:table-column-properties style:column-width="1.3cm"/>
    </style:style>
    <style:style style:name="C5" style:family="table-column">
      <style:table-column-properties style:column-width="1.8cm"/>
    </style:style>
    <style:style style:name="C6" style:family="table-column">
      <style:table-column-properties style:column-width="6.5cm"/>
    </style:style>
    <style:style style:name="Top1" style:family="table-column">
      <style:table-column-properties style:column-width="3cm"/>
    </style:style>
    <style:style style:name="Top2" style:family="table-column">
      <style:table-column-properties style:column-width="2cm"/>
    </style:style>
    <style:style style:name="Top3" style:family="table-column">
      <style:table-column-properties style:column-width="2cm"/>
    </style:style>
    <style:style style:name="Top4" style:family="table-column">
      <style:table-column-properties style:column-width="2cm"/>
    </style:style>
    <style:style style:name="Top5" style:family="table-column">
      <style:table-column-properties style:column-width="7cm"/>
    </style:style>
    <style:style style:name="Top6" style:family="table-column">
      <style:table-column-properties style:column-width="3cm"/>
    </style:style>
    <style:style style:name="Back1" style:family="table-column">
      <style:table-column-properties style:column-width="4.5cm"/>
    </style:style>
    <style:style style:name="Back2" style:family="table-column">
      <style:table-column-properties style:column-width="14.5cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Right">避難者カード【ベトナム</text:p>
      <text:p text:style-name="Title">Phiếu Người Sơ tán (mặt trước)</text:p>
      <text:p text:style-name="Right">【Mẫu - 7】</text:p>
      <text:p text:style-name="P">Ngày điền　 Ngày　　tháng　　năm　　　Điền vào mẫu cho từng hộ gia đình</text:p>
      <table:table table:name="FrontTop">
        <table:table-column table:style-name="Top1"/>
        <table:table-column table:style-name="Top2"/>
        <table:table-column table:style-name="Top3"/>
        <table:table-column table:style-name="Top4"/>
        <table:table-column table:style-name="Top5"/>
        <table:table-column table:style-name="Top6"/>
        <table:table-row>
          <table:table-cell table:style-name="C"><text:p text:style-name="BoldCenter">Ngày Giờ</text:p></table:table-cell>
          <table:table-cell table:style-name="C" table:number-columns-spanned="4"><text:p>Ngày　　tháng　 năm　 khoảng　 giờ</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="C" table:number-rows-spanned="3"><text:p>Nhóm - No cư trú</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C"><text:p text:style-name="BoldCenter">Địa điểm Sơ tán</text:p></table:table-cell>
          <table:table-cell table:style-name="C" table:number-columns-spanned="4"><text:p>Trung tâm Sơ tán / Nhà / Khác / (　　　　　　　　　　)</text:p><text:p text:style-name="Right">※Nếu di tản bằng xe, hãy cho biết vị trí đậu xe</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C"><text:p text:style-name="BoldCenter">Hội Tự trị</text:p></table:table-cell>
          <table:table-cell table:style-name="C" table:number-columns-spanned="4"><text:p>Hội tự trị khu</text:p><text:p>※Nếu gia đình chưa là thành viên viết là "chưa tham gia".</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>

      <table:table table:name="Household">
        <table:table-column table:style-name="C1"/>
        <table:table-column table:style-name="C2"/>
        <table:table-column table:style-name="C3"/>
        <table:table-column table:style-name="C4"/>
        <table:table-column table:style-name="C5"/>
        <table:table-column table:style-name="C6"/>
        <table:table-row>
          <table:table-cell table:style-name="C"><text:p text:style-name="Bold">Khoanh tròn nếu ở TT Sơ tán</text:p></table:table-cell>
          <table:table-cell table:style-name="C"><text:p text:style-name="BoldCenter">Họ Tên</text:p><text:p text:style-name="Center">(cùng với chữ Katakana)</text:p></table:table-cell>
          <table:table-cell table:style-name="C"><text:p text:style-name="BoldCenter">Tuổi</text:p></table:table-cell>
          <table:table-cell table:style-name="C"><text:p text:style-name="BoldCenter">Giới tính</text:p></table:table-cell>
          <table:table-cell table:style-name="C"><text:p text:style-name="BoldCenter">Quan hệ</text:p></table:table-cell>
          <table:table-cell table:style-name="C"><text:p text:style-name="Bold">Ghi chú *Viết con số và những điều lưu ý cho những người cần xem xét đặc biệt.</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C"><text:p/></table:table-cell>
          <table:table-cell table:style-name="C"><text:p>(Người đại diện)</text:p></table:table-cell>
          <table:table-cell table:style-name="C"><text:p text:style-name="Right">tuổi</text:p></table:table-cell>
          <table:table-cell table:style-name="C"><text:p text:style-name="Center">Nam ・ Nữ ・ Khác</text:p></table:table-cell>
          <table:table-cell table:style-name="C"><text:p/></table:table-cell>
          <table:table-cell table:style-name="C"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row><table:table-cell table:style-name="C"><text:p/></table:table-cell><table:table-cell table:style-name="C"><text:p/></table:table-cell><table:table-cell table:style-name="C"><text:p text:style-name="Right">tuổi</text:p></table:table-cell><table:table-cell table:style-name="C"><text:p text:style-name="Center">Nam ・ Nữ ・ Khác</text:p></table:table-cell><table:table-cell table:style-name="C"><text:p/></table:table-cell><table:table-cell table:style-name="C"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="C"><text:p/></table:table-cell><table:table-cell table:style-name="C"><text:p/></table:table-cell><table:table-cell table:style-name="C"><text:p text:style-name="Right">tuổi</text:p></table:table-cell><table:table-cell table:style-name="C"><text:p text:style-name="Center">Nam ・ Nữ ・ Khác</text:p></table:table-cell><table:table-cell table:style-name="C"><text:p/></table:table-cell><table:table-cell table:style-name="C"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="C"><text:p/></table:table-cell><table:table-cell table:style-name="C"><text:p/></table:table-cell><table:table-cell table:style-name="C"><text:p text:style-name="Right">tuổi</text:p></table:table-cell><table:table-cell table:style-name="C"><text:p text:style-name="Center">Nam ・ Nữ ・ Khác</text:p></table:table-cell><table:table-cell table:style-name="C"><text:p/></table:table-cell><table:table-cell table:style-name="C"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="C"><text:p/></table:table-cell><table:table-cell table:style-name="C"><text:p/></table:table-cell><table:table-cell table:style-name="C"><text:p text:style-name="Right">tuổi</text:p></table:table-cell><table:table-cell table:style-name="C"><text:p text:style-name="Center">Nam ・ Nữ ・ Khác</text:p></table:table-cell><table:table-cell table:style-name="C"><text:p/></table:table-cell><table:table-cell table:style-name="C"><text:p/></table:table-cell></table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="BoldCenter">Địa chỉ</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="C" table:number-columns-spanned="4"><text:p>〒</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="BoldCenter">Số điện thoại Người đại diện</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="C" table:number-columns-spanned="4"><text:p>（　　　　　　　　　　　）</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="BoldCenter">Thú cưng</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="C" table:number-columns-spanned="4"><text:p>Có　▪　Không　　※ Nếu “Có”; điền vào phiếu đăng ký con vật nuôi.</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C"><text:p text:style-name="BoldCenter">Người cần xem xét *Viết con số vào cột ghi chú</text:p></table:table-cell>
          <table:table-cell table:style-name="CT" table:number-columns-spanned="5">
            <text:p>1 Phụ nữ có thai　　2 Trẻ sơ sinh　　3 Người khuyết tật （　　　　　　　　　）</text:p>
            <text:p>4 Người cần chăm sóc　　5 Người đang thiết bị y tế （　　　　　　　　　）</text:p>
            <text:p>6 Dị ứng （　　　　　　　　　）　　7 Người nước ngoài（Quốc tịch</text:p>
            <text:p>）</text:p>
            <text:p>8 Khác （　　　　　　　　　　　　　　　　　　　　　　　　　）</text:p>
          </table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>

      <text:p text:style-name="PageBreak">※Những người cần được xem xét đặc biệt trong cuộc sống sơ tán như phụ nữ có thai, trẻ sơ sinh và người khuyết tật v.v.</text:p>

      <text:p text:style-name="PageBreak"/>
      <text:p text:style-name="Title">Phiếu Người Sơ tán (mặt sau)</text:p>
      <text:p text:style-name="Right">【Mẫu - 7】</text:p>
      <text:p text:style-name="Bold">Về những mục ở mặt sau bạn có thể viết sau khi tình hình đã ổn định.</text:p>
      <table:table table:name="Back">
        <table:table-column table:style-name="Back1"/>
        <table:table-column table:style-name="Back2"/>
        <table:table-row><table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p>Công bố thông tin để xác nhận người sơ tán an toàn (khoanh tròn " muốn" hoặc "không muốn".</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C"><text:p>Bạn có muốn thông tin người sơ tán được công bố trên trang web hoặc qua phương tiện truyền thông không?</text:p></table:table-cell>
          <table:table-cell table:style-name="C"><text:p text:style-name="Center">Muốn　▪　Không muốn</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C"><text:p>Bạn có muốn chúng tôi cung cấp thông tin người sơ tán đáp ứng yêu cầu từ người gia đình, ở cùng nhà và người quen của bạn về sự an toàn của người sơ tán không?</text:p></table:table-cell>
          <table:table-cell table:style-name="C"><text:p text:style-name="Center">Muốn　▪　Không muốn</text:p></table:table-cell>
        </table:table-row>
        <table:table-row><table:table-cell table:style-name="C"><text:p text:style-name="Bold">Thiệt hại nhà ở ※Khoanh tròn các mục áp dụng cho tình huống của bạn</text:p></table:table-cell><table:table-cell table:style-name="C"><text:p>Có　▪　Không　　※Nếu “Có”, mô tả chi tiết tình hình hư hỏng của ngôi nhà</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="C"><text:p/></table:table-cell><table:table-cell table:style-name="CT"><text:p>※Ví dụ về miêu tả tình huống</text:p><text:p>・Nhà ở đã sập; không có thể sống ở đó được.</text:p><text:p>・Có thể trở về nhà lại nếu dọn dẹp sắp xếp lại phòng</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="C"><text:p/></table:table-cell><table:table-cell table:style-name="C"><text:p>Cúp điện　　　Cúp nước　　　Cúp gas　　　Sập đường dây điện thoại</text:p><text:p>Khác （　　　　　　　　　　　　　　　）</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="Bold">Thông tin nạn nhân</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p>Viết tên và tình trạng cụ thể chấn thương hoặc bệnh tật.</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="CT" table:number-columns-spanned="2"><text:p> </text:p><text:p> </text:p><text:p> </text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="C"><text:p text:style-name="BoldCenter">Nơi điều trị</text:p><text:p text:style-name="BoldCenter">(Nơi chuyển đến)</text:p></table:table-cell><table:table-cell table:style-name="C"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="C"><text:p text:style-name="BoldCenter">Thông tin nơi điều trị</text:p><text:p text:style-name="BoldCenter">(Địa chỉ)</text:p></table:table-cell><table:table-cell table:style-name="C"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="Bold">Các ghi chú đặc biệt khác (Nếu ai có đủ tư cách và có thể hợp tác, viết tên và nội dung hợp tác.)</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="CT" table:number-columns-spanned="2"><text:p> </text:p><text:p> </text:p><text:p> </text:p></table:table-cell><table:covered-table-cell/></table:table-row>
      </table:table>

      <text:p text:style-name="Bold">＜Khung để Ủy ban quản lý trung tâm sơ tán ghi vào＞</text:p>
      <table:table table:name="Exit">
        <table:table-column table:style-name="Back1"/>
        <table:table-column table:style-name="Back2"/>
        <table:table-row><table:table-cell table:style-name="CT" table:number-columns-spanned="2"><text:p> </text:p><text:p> </text:p><text:p> </text:p><text:p> </text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="C"><text:p text:style-name="Bold">Rời trung tâm</text:p></table:table-cell><table:table-cell table:style-name="C"><text:p>Năm　　tháng　　ngày</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="C"><text:p text:style-name="BoldCenter">Nơi cư trú</text:p></table:table-cell><table:table-cell table:style-name="C"><text:p>　　　　　　　　　　　　ĐT　　　　　　　　　　　　</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p>※Để đảm bảo việc vận hành nơi sơ tán được thuận lợi, chúng tôi mong tất cả những người sơ tán (bao gồm cả người sơ tán tại nhà và người sơ tán trong xe) hợp tác</text:p>

      <text:p text:style-name="PageBreak">tham gia vận hành nơi sơ tán trong phạm vi có thể.pp</text:p>
    </office:text>
  </office:body>
</office:document>