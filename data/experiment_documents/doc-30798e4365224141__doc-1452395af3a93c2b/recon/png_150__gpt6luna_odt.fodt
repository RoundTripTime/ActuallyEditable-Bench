<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
                 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
                 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
                 xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
                 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
                 office:mimetype="application/vnd.oasis.opendocument.text"
                 office:version="1.4">
  <office:styles>
    <style:style style:name="DefaultParagraph" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="2cm" fo:margin-right="2cm" fo:margin-top="1.2cm" fo:margin-bottom="1.5cm"/>
    </style:page-layout>

    <style:style style:name="BoxLabel" style:family="paragraph">
      <style:paragraph-properties fo:border="0.75pt solid #000000" fo:padding="0.04cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="PageBreakBoxLabel" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:border="0.75pt solid #000000" fo:padding="0.04cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="FormNumber" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.22cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="DocumentTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.6cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="DateLine" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0.65cm" fo:margin-right="3.2cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="AddressLine" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.7cm" fo:margin-top="0.45cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="ApplicantLine" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.9cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="IntroFirst" style:family="paragraph">
      <style:paragraph-properties fo:text-indent="0.35cm" fo:margin-top="1.15cm" fo:margin-bottom="0cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="IntroSecond" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.2cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="TableLabelParagraph" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="11.5pt"/>
    </style:style>
    <style:style style:name="TableContentParagraph" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="11.5pt"/>
    </style:style>
    <style:style style:name="SmallLabelParagraph" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="110%"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="AwardParagraph" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.06cm" fo:margin-bottom="0.06cm" fo:line-height="125%"/>
      <style:text-properties fo:font-size="11.5pt"/>
    </style:style>
    <style:style style:name="DateCellParagraph" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="11.5pt"/>
    </style:style>

    <style:style style:name="Column1" style:family="table-column">
      <style:table-column-properties style:column-width="3.5cm"/>
    </style:style>
    <style:style style:name="Column2" style:family="table-column">
      <style:table-column-properties style:column-width="5.2cm"/>
    </style:style>
    <style:style style:name="Column3" style:family="table-column">
      <style:table-column-properties style:column-width="1.55cm"/>
    </style:style>
    <style:style style:name="Column4" style:family="table-column">
      <style:table-column-properties style:column-width="6.75cm"/>
    </style:style>

    <style:style style:name="TableCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.05cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="FuriganaLeft" style:family="table-cell">
      <style:table-cell-properties fo:border-top="0.5pt solid #000000" fo:border-left="0.5pt solid #000000" fo:border-right="0.5pt solid #000000" fo:border-bottom="0.5pt dashed #000000" fo:padding="0.05cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="FuriganaRight" style:family="table-cell">
      <style:table-cell-properties fo:border-top="0.5pt solid #000000" fo:border-left="0.5pt solid #000000" fo:border-right="0.5pt solid #000000" fo:border-bottom="0.5pt dashed #000000" fo:padding="0.05cm" style:vertical-align="middle"/>
    </style:style>

    <style:style style:name="FuriganaRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.7cm"/>
    </style:style>
    <style:style style:name="NameRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.2cm"/>
    </style:style>
    <style:style style:name="AddressRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.3cm"/>
    </style:style>
    <style:style style:name="BirthRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.1cm"/>
    </style:style>
    <style:style style:name="WorkRow" style:family="table-row">
      <style:table-row-properties style:row-height="1cm"/>
    </style:style>
    <style:style style:name="AwardRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.7cm"/>
    </style:style>
    <style:style style:name="SummaryRow" style:family="table-row">
      <style:table-row-properties style:row-height="2.8cm"/>
    </style:style>
    <style:style style:name="ShortRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.5cm"/>
    </style:style>
  </office:automatic-styles>

  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>

  <office:body>
    <office:text>
      <text:p text:style-name="BoxLabel">別紙２</text:p>
      <text:p text:style-name="FormNumber">様式第１号（第４条関係）</text:p>
      <text:p text:style-name="DocumentTitle">表彰内申書</text:p>
      <text:p text:style-name="DateLine">年　　　　月　　　　日</text:p>
      <text:p text:style-name="AddressLine">（宛先）白岡市長</text:p>
      <text:p text:style-name="ApplicantLine">内申者 ______________________________</text:p>
      <text:p text:style-name="IntroFirst">次のものは、白岡市表彰規則に規定する表彰の種類に該当し、表彰すること</text:p>
      <text:p text:style-name="IntroSecond">が適当と認められるので内申しいたします。</text:p>

      <table:table table:name="表彰内申書">
        <table:table-column table:style-name="Column1"/>
        <table:table-column table:style-name="Column2"/>
        <table:table-column table:style-name="Column3"/>
        <table:table-column table:style-name="Column4"/>

        <table:table-row table:style-name="FuriganaRow">
          <table:table-cell table:style-name="FuriganaLeft">
            <text:p text:style-name="TableLabelParagraph">ふりがな</text:p>
          </table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="FuriganaRight"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>

        <table:table-row table:style-name="NameRow">
          <table:table-cell table:style-name="TableCell">
            <text:p text:style-name="TableLabelParagraph">氏名又は</text:p>
            <text:p text:style-name="TableLabelParagraph">団体名</text:p>
          </table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="TableCell"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>

        <table:table-row table:style-name="AddressRow">
          <table:table-cell table:style-name="TableCell">
            <text:p text:style-name="TableLabelParagraph">住所又は</text:p>
            <text:p text:style-name="TableLabelParagraph">所在地</text:p>
          </table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="TableCell"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>

        <table:table-row table:style-name="BirthRow">
          <table:table-cell table:style-name="TableCell">
            <text:p text:style-name="TableLabelParagraph">生年月日又は</text:p>
            <text:p text:style-name="TableLabelParagraph">設立年月日</text:p>
          </table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="TableCell">
            <text:p text:style-name="DateCellParagraph">年　　　　月　　　　日</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>

        <table:table-row table:style-name="WorkRow">
          <table:table-cell table:style-name="TableCell">
            <text:p text:style-name="TableLabelParagraph">職業又は業種</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="TableCell"/>
          <table:table-cell table:style-name="TableCell">
            <text:p text:style-name="TableLabelParagraph">電話</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="TableCell"/>
        </table:table-row>

        <table:table-row table:style-name="AwardRow">
          <table:table-cell table:style-name="TableCell">
            <text:p text:style-name="TableLabelParagraph">表彰の種類</text:p>
            <text:p text:style-name="SmallLabelParagraph">（番号を〇で囲み、号数を記入）</text:p>
          </table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="TableCell">
            <text:p text:style-name="AwardParagraph">①　功労表彰（第　　号）　　　②　善行表彰（第　　号）</text:p>
            <text:p text:style-name="AwardParagraph">③　特別表彰（第　　号）</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>

        <table:table-row table:style-name="SummaryRow">
          <table:table-cell table:style-name="TableCell">
            <text:p text:style-name="TableLabelParagraph">経歴の概要</text:p>
          </table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="TableCell"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>

        <table:table-row table:style-name="SummaryRow">
          <table:table-cell table:style-name="TableCell">
            <text:p text:style-name="TableLabelParagraph">功績の概要</text:p>
          </table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="TableCell"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>

        <table:table-row table:style-name="ShortRow">
          <table:table-cell table:style-name="TableCell">
            <text:p text:style-name="TableLabelParagraph">賞　　　　罰</text:p>
          </table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="TableCell"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>

        <table:table-row table:style-name="ShortRow">
          <table:table-cell table:style-name="TableCell">
            <text:p text:style-name="TableLabelParagraph">内　申　理　由</text:p>
          </table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="TableCell"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>

      <text:p text:style-name="PageBreakBoxLabel">別紙２</text:p>
      <text:p text:style-name="FormNumber">注　各欄が長文にわたるときは、別紙によること。</text:p>
    </office:text>
  </office:body>
</office:document>