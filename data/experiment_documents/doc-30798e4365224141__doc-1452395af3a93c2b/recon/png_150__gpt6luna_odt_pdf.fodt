<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:text-properties style:font-name="Noto Serif CJK JP" fo:font-size="13pt"/>
      <style:paragraph-properties fo:margin-top="0pt" fo:margin-bottom="0pt"/>
    </style:default-style>
    <style:style style:name="Plain" style:family="paragraph"/>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.2cm" fo:margin-bottom="1.2cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
    </style:page-layout>
    <style:style style:name="TitleLine" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.2cm"/>
    </style:style>
    <style:style style:name="MainTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.55cm" fo:margin-bottom="0.6cm"/>
      <style:text-properties fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="DateLine" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-bottom="0.7cm"/>
      <style:text-properties fo:font-size="13pt"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.7cm" fo:margin-bottom="1.1cm"/>
    </style:style>
    <style:style style:name="Applicant" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-right="3cm" fo:margin-bottom="1.3cm"/>
    </style:style>
    <style:style style:name="Statement" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.4cm"/>
      <style:text-properties fo:font-size="13pt"/>
    </style:style>
    <style:style style:name="TableStyle" style:family="table">
      <style:table-properties style:width="17cm" table:align="margins"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="3.5cm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="5.2cm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="1.5cm"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties style:column-width="6.8cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="2pt" fo:vertical-align="middle"/>
    </style:style>
    <style:style style:name="DashedCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:border-bottom="0.5pt dashed #000000" fo:padding="2pt" fo:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Label" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="FormText" style:family="paragraph">
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="ShortRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.9cm"/>
    </style:style>
    <style:style style:name="MidRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.3cm"/>
    </style:style>
    <style:style style:name="AwardRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.9cm"/>
    </style:style>
    <style:style style:name="LargeRow" style:family="table-row">
      <style:table-row-properties style:row-height="3.1cm"/>
    </style:style>
    <style:style style:name="SmallRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.6cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="TitleLine">別紙２</text:p>
      <text:p text:style-name="TitleLine">様式第１号（第４条関係）</text:p>
      <text:p text:style-name="MainTitle">表彰内申書</text:p>
      <text:p text:style-name="DateLine">年　　月　　日</text:p>
      <text:p text:style-name="Recipient">（宛先）白岡市長</text:p>
      <text:p text:style-name="Applicant">内申者　＿＿＿＿＿＿＿＿＿＿＿＿＿＿</text:p>
      <text:p text:style-name="Statement">次のものは、白岡市表彰規則に規定する表彰の種類に該当し、表彰すること</text:p>
      <text:p text:style-name="Statement">が適当と認められるので内申いたします。</text:p>
      <table:table table:name="FormTable" table:style-name="TableStyle">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-row table:style-name="ShortRow">
          <table:table-cell table:style-name="DashedCell"><text:p text:style-name="Label">ふりがな</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="DashedCell"/>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="ShortRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Label">氏名又は</text:p><text:p text:style-name="Label">団体名</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="Cell"/>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="MidRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Label">住所又は</text:p><text:p text:style-name="Label">所在地</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="Cell"/>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="MidRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Label">生年月日又は</text:p><text:p text:style-name="Label">設立年月日</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="Cell"><text:p text:style-name="Center">年　　　　月　　　　日</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="MidRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Label">職業又は業種</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Label">電話</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="AwardRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Label">表彰の種類</text:p><text:p text:style-name="Label">（番号を○で囲み、号数を記入）</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="Cell">
            <text:p text:style-name="FormText">①　功労表彰（第　号）　　　②　善行表彰（第　号）</text:p>
            <text:p text:style-name="FormText">③　特別表彰（第　号）</text:p>
          </table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="LargeRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Label">経歴の概要</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="Cell"/>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="LargeRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Label">功績の概要</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="Cell"/>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="SmallRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Label">賞　罰</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="Cell"/>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="SmallRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Label">内申理由</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="Cell"/>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageBreak">別紙２</text:p>
      <text:p>注　各欄が長文にわたるときは、別紙によること。</text:p>
    </office:text>
  </office:body>
</office:document>