  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="29.7cm" fo:page-height="21cm" fo:margin="1.9cm" style:print-orientation="landscape"/>
    </style:page-layout>
    <style:style style:name="Col1" style:family="table-column"><style:table-column-properties style:column-width="1.98cm"/></style:style>
    <style:style style:name="Col2" style:family="table-column"><style:table-column-properties style:column-width="3.20cm"/></style:style>
    <style:style style:name="Col3" style:family="table-column"><style:table-column-properties style:column-width="2.56cm"/></style:style>
    <style:style style:name="Col4" style:family="table-column"><style:table-column-properties style:column-width="3.36cm"/></style:style>
    <style:style style:name="Col5" style:family="table-column"><style:table-column-properties style:column-width="2.78cm"/></style:style>
