    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="PrivacyCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt dotted #555555" fo:padding="0.08cm" fo:background-color="#e6e6e6" style:vertical-align="middle"/>
    </style:style>
