<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:text-align="center" fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0.08cm"/>
      <style:text-properties fo:font-family="Malgun Gothic" fo:font-size="14pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Malgun Gothic" fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="CenterBold" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Malgun Gothic" fo:font-size="9pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="LeftSmall" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Malgun Gothic" fo:font-size="8pt"/>
    </style:style>
    <style:style style:name="Notes" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Malgun Gothic" fo:font-size="8pt"/>
    </style:style>
    <style:style style:name="NotesBold" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Malgun Gothic" fo:font-size="8pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="25.6cm" table:align="margins"/>
    </style:style>
    <style:style style:name="ConsentTable" style:family="table">
      <style:table-properties style:width="25.6cm" table:align="margins"/>
    </style:style>
    <style:style style:name="GridColumn" style:family="table-column">
      <style:table-column-properties style:column-width="2.5cm"/>
    </style:style>
    <style:style style:name="GridCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.02cm solid #000000" fo:padding="0.03cm" fo:vertical-align="middle"/>
    </style:style>
    <style:style style:name="ConsentLeftCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.02cm dotted #000000" fo:padding="0.08cm" fo:vertical-align="middle" fo:background-color="#E6E6E6"/>
    </style:style>
    <style:style style:name="ConsentRightCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.02cm dotted #000000" fo:padding="0.08cm" fo:vertical-align="middle" fo:background-color="#E6E6E6"/>
    </style:style>
    <style:style style:name="RowShort" style:family="table-row">
      <style:table-row-properties style:row-height="0.64cm"/>
    </style:style>
    <style:style style:name="RowSection" style:family="table-row">
      <style:table-row-properties style:row-height="0.64cm"/>
    </style:style>
    <style:style style:name="RowHeaderTop" style:family="table-row">
      <style:table-row-properties style:row-height="0.56cm"/>
    </style:style>
    <style:style style:name="RowHeaderBottom" style:family="table-row">
      <style:table-row-properties style:row-height="1.00cm"/>
    </style:style>
    <style:style style:name="RowEntry" style:family="table-row">
      <style:table-row-properties style:row-height="0.62cm"/>
    </style:style>
    <style:style style:name="RowTotal" style:family="table-row">
      <style:table-row-properties style:row-height="0.86cm"/>
    </style:style>
    <style:style style:name="RowNotes" style:family="table-row">
      <style:table-row-properties style:row-height="4.42cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="29.7cm" fo:page-height="21cm" style:print-orientation="landscape" fo:margin-left="2.05cm" fo:margin-right="2.05cm" fo:margin-top="0.18cm" fo:margin-bottom="2.75cm"/>
    </style:page-layout-properties>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">주민세 사업소분 건축물 사용명세서(건물 소유자 작성)　 문의전화 : 032-509-8920 (fax.032-509-8928)</text:p>
      <table:table table:name="건축물사용명세" table:style-name="FormTable">
        <table:table-column table:style-name="GridColumn" table:number-columns-repeated="10"/>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="3"><text:p text:style-name="CenterBold">건축물 소재지</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="7"><text:p text:style-name="LeftSmall">도로명 주소:</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p text:style-name="CenterBold">건축물 소유자</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="Center">성 명(법인명)</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="3"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p text:style-name="Center">생년월일(법인등록번호)</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="3"><text:p text:style-name="CenterBold">연면적(가설건축물 포함)</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="3"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p text:style-name="Center">연 락 처</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowSection">
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="10"><text:p text:style-name="CenterBold">사 용 현 황(7월 1일 기준)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowHeaderTop">
          <table:table-cell table:style-name="GridCell" table:number-rows-spanned="2"><text:p text:style-name="Center">①구분</text:p><text:p text:style-name="Center">(층별,호수)</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-rows-spanned="2"><text:p text:style-name="Center">②사용현황</text:p><text:p text:style-name="Center">(자가,임대,공실 등)</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-rows-spanned="2"><text:p text:style-name="Center">③사용면적(m²)</text:p><text:p text:style-name="Center">(전용+공용)</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-rows-spanned="2"><text:p text:style-name="Center">④상 호</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="6"><text:p text:style-name="CenterBold">⑤사 용 자</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowHeaderBottom">
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="Center">성 명</text:p><text:p text:style-name="Center">(법인명)</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="Center">생년월일</text:p><text:p text:style-name="Center">(법인등록번호)</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="Center">사업자등록번호</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p text:style-name="Center">사용기간 (임대·</text:p><text:p text:style-name="Center">공실 포함)</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="Center">연락처</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowEntry">
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowEntry">
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowEntry">
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowEntry">
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowEntry">
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowEntry">
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowEntry">
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell><table:table-cell table:style-name="GridCell"><text:p/></table:cell><table:table-cell table:style-name="GridCell"><text:p/></table:cell><table:table-cell table:style-name="GridCell"><text:p/></table:cell><table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p/></table:cell><table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>