      <table:table table:name="Confirmation" table:style-name="T">
        <table:table-column table:style-name="C1"/>
        <table:table-column table:style-name="C2"/>
        <table:table-column table:style-name="C3"/>
        <table:table-column table:style-name="C4"/>
        <table:table-column table:style-name="C5"/>
        <table:table-column table:style-name="C6"/>
        <table:table-column table:style-name="C7"/>
        <table:table-column table:style-name="C8"/>
        <table:table-column table:style-name="C9"/>
        <table:table-row table:style-name="TopRow">
          <table:table-cell table:style-name="TC" table:number-columns-spanned="9"><text:p text:style-name="CenterBold">작성일 :　 년　 월　 일</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="TC"/><table:covered-table-cell table:style-name="TC"/><table:covered-table-cell table:style-name="TC"/><table:covered-table-cell table:style-name="TC"/><table:covered-table-cell table:style-name="TC"/><table:covered-table-cell table:style-name="TC"/><table:covered-table-cell table:style-name="TC"/><table:covered-table-cell table:style-name="TC"/>
        </table:table-row>
        <table:table-row table:style-name="TopRow">
          <table:table-cell table:style-name="TC" table:number-columns-spanned="4"><text:p text:style-name="CenterBold">확인자(건물 소유자)</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="TC"/><table:covered-table-cell table:style-name="TC"/><table:covered-table-cell table:style-name="TC"/>
          <table:table-cell table:style-name="TC" table:number-columns-spanned="5"><text:p text:style-name="CenterBold">(인 또는 서명)</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="TC"/><table:covered-table-cell table:style-name="TC"/><table:covered-table-cell table:style-name="TC"/><table:covered-table-cell table:style-name="TC"/>
        </table:table-row>
