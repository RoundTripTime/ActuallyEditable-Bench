<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:font-size="12pt" fo:line-height="1.33"/>
      <style:text-properties fo:font-family="Microsoft JhengHei" fo:font-size="12pt"/>
    </style:default-style>
    <style:style style:name="TableText" style:family="paragraph">
      <style:paragraph-properties fo:line-height="1.2"/>
      <style:text-properties fo:font-family="Microsoft JhengHei" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="FormTitle" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="6mm" fo:margin-bottom="10mm" fo:margin-left="31mm" fo:line-height="1"/>
      <style:text-properties fo:font-family="Microsoft JhengHei" fo:font-size="24pt"/>
    </style:style>
    <style:style style:name="CellText" style:family="paragraph">
      <style:paragraph-properties fo:line-height="1.2"/>
      <style:text-properties fo:font-family="Microsoft JhengHei" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="CellLabel" style:family="paragraph">
      <style:paragraph-properties fo:line-height="1.35"/>
      <style:text-properties fo:font-family="Microsoft JhengHei" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="CellBorder" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="2mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="MergedBorder" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="2mm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="19mm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="42.7mm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="12.8mm"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties style:column-width="21.3mm"/>
    </style:style>
    <style:style style:name="Col5" style:family="table-column">
      <style:table-column-properties style:column-width="27.8mm"/>
    </style:style>
    <style:style style:name="Col6" style:family="table-column">
      <style:table-column-properties style:column-width="42.7mm"/>
    </style:style>
    <style:style style:name="Col7" style:family="table-column">
      <style:table-column-properties style:column-width="19.6mm"/>
    </style:style>
    <style:style style:name="HeaderRow" style:family="table-row">
      <style:table-row-properties style:row-height="17mm"/>
    </style:style>
    <style:style style:name="RowA" style:family="table-row">
      <style:table-row-properties style:row-height="16mm"/>
    </style:style>
    <style:style style:name="RowB" style:family="table-row">
      <style:table-row-properties style:row-height="15mm"/>
    </style:style>
    <style:style style:name="RowC" style:family="table-row">
      <style:table-row-properties style:row-height="18mm"/>
    </style:style>
    <style:style style:name="RowD" style:family="table-row">
      <style:table-row-properties style:row-height="29.5mm"/>
    </style:style>
    <style:style style:name="WideText" style:family="paragraph">
      <style:paragraph-properties fo:line-height="1.33" fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-family="Microsoft JhengHei" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="WideOpening" style:family="paragraph">
      <style:paragraph-properties fo:line-height="1.33" fo:margin-top="47mm" fo:margin-bottom="0mm" fo:margin-left="4mm"/>
      <style:text-properties fo:font-family="Microsoft JhengHei" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="WideRecipient" style:family="paragraph">
      <style:paragraph-properties fo:line-height="1.33" fo:margin-top="13mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-family="Microsoft JhengHei" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="WideSign1" style:family="paragraph">
      <style:paragraph-properties fo:line-height="1.33" fo:margin-top="4mm" fo:margin-bottom="0mm" fo:margin-left="48mm"/>
      <style:text-properties fo:font-family="Microsoft JhengHei" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="WideSign2" style:family="paragraph">
      <style:paragraph-properties fo:line-height="1.33" fo:margin-top="10mm" fo:margin-bottom="0mm" fo:margin-left="48mm"/>
      <style:text-properties fo:font-family="Microsoft JhengHei" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="WideDate" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="1.33" fo:margin-top="24mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-family="Microsoft JhengHei" fo:font-size="12pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" fo:margin-left="10mm" fo:margin-right="10mm" fo:margin-top="15mm" fo:margin-bottom="15mm" style:print-orientation="portrait"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="FormTitle">委　任　書</text:p>
      <table:table table:name="委任書資料表">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-column table:style-name="Col5"/>
        <table:table-column table:style-name="Col6"/>
        <table:table-column table:style-name="Col7"/>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="CellBorder"><text:p text:style-name="CellLabel">稱謂</text:p></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p text:style-name="CellLabel">姓名</text:p></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p text:style-name="CellLabel">性別</text:p></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p text:style-name="CellLabel">出生<text:line-break/>年月日</text:p></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p text:style-name="CellLabel">身分證字號</text:p></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p text:style-name="CellLabel">住(居)所</text:p></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p text:style-name="CellLabel">聯絡電<text:line-break/>話或手<text:line-break/>機</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowA">
          <table:table-cell table:style-name="CellBorder"><text:p text:style-name="CellText">委任人</text:p></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowB">
          <table:table-cell table:style-name="CellBorder"><text:p text:style-name="CellText">法定代<text:line-break/>理人</text:p></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowC">
          <table:table-cell table:style-name="CellBorder"><text:p text:style-name="CellText">受任人</text:p></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowD">
          <table:table-cell table:style-name="CellBorder"><text:p text:style-name="CellText">委任代<text:line-break/>理人</text:p></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MergedBorder" table:number-columns-spanned="7">
            <text:p text:style-name="WideOpening">此　致</text:p>
            <text:p text:style-name="WideText">桃園市政府地政局</text:p>
            <text:p text:style-name="WideRecipient">茲與　　間因　　所衍生消費爭議事件，委任　　為代理人，有代<text:line-break/>為一切協商/調解之權，並有同意協商/調解條件、撤回、捨棄、領取系爭物或選任代理人等特別<text:line-break/>代理權。</text:p>
            <text:p text:style-name="WideSign1">委任人</text:p>
            <text:p text:style-name="WideSign1">（委任代理人）：　　　　（簽名或蓋章-負責人印章）</text:p>
            <text:p text:style-name="WideSign2">受任人　　　　　　（簽名或蓋章）</text:p>
            <text:p text:style-name="WideDate">中華民國　年　月　日</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>