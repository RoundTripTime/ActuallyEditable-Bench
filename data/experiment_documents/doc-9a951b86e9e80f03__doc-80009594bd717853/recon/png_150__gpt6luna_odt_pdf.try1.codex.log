          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="17"><text:p text:style-name="GridText">1.勞動部勞工保險局原核定函影本。</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
