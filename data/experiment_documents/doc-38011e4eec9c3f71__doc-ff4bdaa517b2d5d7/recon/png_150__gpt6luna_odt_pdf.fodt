<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:line-height="150%"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0pt" fo:margin-bottom="0pt" fo:line-height="150%"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0pt" fo:margin-bottom="0pt" fo:line-height="150%"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0pt" fo:margin-bottom="18pt" fo:line-height="150%"/>
      <style:text-properties fo:font-size="15pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="14pt" fo:margin-bottom="3pt" fo:line-height="150%"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="Gap" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0pt" fo:margin-bottom="12pt" fo:line-height="150%"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0pt" fo:margin-bottom="0pt" fo:line-height="150%"/>
    </style:style>
    <style:style style:name="SmallNote" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="3pt" fo:margin-bottom="0pt" fo:line-height="125%"/>
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
    <style:style style:name="TableCentered" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0pt" fo:margin-bottom="0pt" fo:line-height="150%"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="InputTable" style:family="table">
      <style:table-properties style:width="140mm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ShortTable" style:family="table">
      <style:table-properties style:width="148mm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="Col35" style:family="table-column">
      <style:table-column-properties style:column-width="35mm"/>
    </style:style>
    <style:style style:name="Col70" style:family="table-column">
      <style:table-column-properties style:column-width="70mm"/>
    </style:style>
    <style:style style:name="Col37" style:family="table-column">
      <style:table-column-properties style:column-width="37mm"/>
    </style:style>
    <style:style style:name="Col111" style:family="table-column">
      <style:table-column-properties style:column-width="111mm"/>
    </style:style>
    <style:style style:name="RowHeader" style:family="table-row">
      <style:table-row-properties style:row-height="7mm"/>
    </style:style>
    <style:style style:name="RowInput" style:family="table-row">
      <style:table-row-properties style:row-height="17.5mm"/>
    </style:style>
    <style:style style:name="RowShortHeader" style:family="table-row">
      <style:table-row-properties style:row-height="10mm"/>
    </style:style>
    <style:style style:name="RowShortLabel" style:family="table-row">
      <style:table-row-properties style:row-height="6mm"/>
    </style:style>
    <style:style style:name="RowShortBlank" style:family="table-row">
      <style:table-row-properties style:row-height="24mm"/>
    </style:style>
    <style:style style:name="CellBorder" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="1mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellShade" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="1mm" fo:background-color="#F2F2F2" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellBlank" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="1mm" style:vertical-align="top"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" style:print-orientation="portrait" fo:margin-left="30mm" fo:margin-right="30mm" fo:margin-top="25mm" fo:margin-bottom="25mm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Body" fo:margin-left="105mm">令和　　年　　月　　日</text:p>
      <text:p text:style-name="Body" fo:margin-left="2mm">（提出先）</text:p>
      <text:p text:style-name="Body" fo:margin-left="4mm">横浜市長</text:p>
      <text:p text:style-name="Title">是正報告書</text:p>
      <text:p text:style-name="Body" fo:text-align="center" fo:margin-left="55mm">住所</text:p>
      <text:p text:style-name="Body" fo:text-align="center" fo:margin-left="55mm">氏名</text:p>
      <text:p text:style-name="Body" fo:text-align="center" fo:margin-left="55mm">電話</text:p>
      <text:p text:style-name="Gap"/>
      <text:p text:style-name="Body">次のとおり是正しましたので報告します。</text:p>
      <text:p text:style-name="Section">１　所在地</text:p>
      <text:p text:style-name="Body" fo:margin-left="7mm">＿＿</text:p>
      <text:p text:style-name="Section">２　是正方法等</text:p>
      <table:table table:name="CorrectionMethods" table:style-name="InputTable">
        <table:table-column table:style-name="Col35"/>
        <table:table-column table:style-name="Col70"/>
        <table:table-column table:style-name="Col35"/>
        <table:table-row table:style-name="RowHeader">
          <table:table-cell table:style-name="CellBorder"><text:p text:style-name="TableCentered">是正箇所</text:p></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p text:style-name="TableCentered">是正方法</text:p></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p text:style-name="TableCentered">条文</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowInput">
          <table:table-cell table:style-name="CellBlank"/>
          <table:table-cell table:style-name="CellBlank"/>
          <table:table-cell table:style-name="CellBlank"/>
        </table:table-row>
        <table:table-row table:style-name="RowInput">
          <table:table-cell table:style-name="CellBlank"/>
          <table:table-cell table:style-name="CellBlank"/>
          <table:table-cell table:style-name="CellBlank"/>
        </table:table-row>
        <table:table-row table:style-name="RowInput">
          <table:table-cell table:style-name="CellBlank"/>
          <table:table-cell table:style-name="CellBlank"/>
          <table:table-cell table:style-name="CellBlank"/>
        </table:table-row>
        <table:table-row table:style-name="RowInput">
          <table:table-cell table:style-name="CellBlank"/>
          <table:table-cell table:style-name="CellBlank"/>
          <table:table-cell table:style-name="CellBlank"/>
        </table:table-row>
        <table:table-row table:style-name="RowInput">
          <table:table-cell table:style-name="CellBlank"/>
          <table:table-cell table:style-name="CellBlank"/>
          <table:table-cell table:style-name="CellBlank"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="SmallNote">※　法：建築基準法、令：建築基準法施行令、市：横浜市建築基準条例、盛：宅地造成及び特定盛土等規制法、都：都市計<text:line-break/>画法</text:p>
      <text:p text:style-name="Section">３　是正年月日</text:p>
      <text:p text:style-name="Body">是正工事完了日　　：　　令和　　年　　月　　日</text:p>
      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="Section">４　是正に係る設計者・施工者</text:p>
      <text:p text:style-name="Body" fo:margin-left="2mm">（１）設計者</text:p>
      <text:p text:style-name="Body" fo:margin-left="11mm">氏　　名：</text:p>
      <text:p text:style-name="Body" fo:margin-left="11mm">所　在　地：</text:p>
      <text:p text:style-name="Body" fo:margin-left="11mm">電話番号：</text:p>
      <text:p text:style-name="Gap"/>
      <text:p text:style-name="Body" fo:margin-left="2mm">（２）工事施工者</text:p>
      <text:p text:style-name="Body" fo:margin-left="11mm">氏　　名：</text:p>
      <text:p text:style-name="Body" fo:margin-left="11mm">所　在　地：</text:p>
      <text:p text:style-name="Body" fo:margin-left="11mm">電話番号：</text:p>
      <text:p text:style-name="Section">５　添付図書</text:p>
      <text:p text:style-name="Body">□配置図　　□敷地面積求積図　　□床面積求積図　　□各階平面図</text:p>
      <text:p text:style-name="Body">□立面図　　□断面図　　　　　□敷地断面図　　□地盤面算定表</text:p>
      <text:p text:style-name="Body">□建具詳細図　　□耐火構造等の構造詳細図　　□設備に関する資料</text:p>
      <text:p text:style-name="Body">□仕上げ表　　□認定書の写し　　□製品カタログ　　□写真　　□工程表</text:p>
      <text:p text:style-name="Body">□その他（　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　）</text:p>
      <text:p text:style-name="Section">６　特記事項その他</text:p>
      <text:p text:style-name="Gap"/>
      <table:table table:name="Confirmation" table:style-name="ShortTable">
        <table:table-column table:style-name="Col37"/>
        <table:table-column table:style-name="Col111"/>
        <table:table-row table:style-name="RowShortHeader">
          <table:table-cell table:style-name="CellBorder"><text:p text:style-name="TableCentered">確認欄</text:p></table:table-cell>
          <table:table-cell table:style-name="CellBorder"><text:p text:style-name="TableCentered">建違対第　　　号　　令和　　年　　月　　日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowShortLabel">
          <table:table-cell table:style-name="CellShade" table:number-columns-spanned="2"><text:p text:style-name="Body">市記入欄</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowShortBlank">
          <table:table-cell table:style-name="CellBlank" table:number-columns-spanned="2"/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="SmallNote" fo:margin-left="5mm">※　宅地造成及び特定盛土等規制法22条第１項については「是正」を「改善」と読み替えます。</text:p>
    </office:text>
  </office:body>
</office:document>