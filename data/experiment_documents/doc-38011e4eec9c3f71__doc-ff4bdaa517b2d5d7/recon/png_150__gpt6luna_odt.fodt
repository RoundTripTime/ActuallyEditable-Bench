<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:line-height="150%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:default-style>
    <style:style style:name="P" style:family="paragraph"/>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.15cm" fo:margin-bottom="0.8cm"/>
      <style:text-properties fo:font-size="16pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.45cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PL1">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="2.8cm" fo:margin-bottom="2.5cm" fo:margin-left="2.5cm" fo:margin-right="2.5cm"/>
    </style:page-layout>
    <style:style style:name="T1" style:family="table">
      <style:table-properties style:width="14cm" table:align="left"/>
    </style:style>
    <style:style style:name="T2" style:family="table">
      <style:table-properties style:width="14.8cm" table:align="left"/>
    </style:style>
    <style:style style:name="C1" style:family="table-column">
      <style:table-column-properties style:column-width="3.5cm"/>
    </style:style>
    <style:style style:name="C2" style:family="table-column">
      <style:table-column-properties style:column-width="7cm"/>
    </style:style>
    <style:style style:name="C3" style:family="table-column">
      <style:table-column-properties style:column-width="3.5cm"/>
    </style:style>
    <style:style style:name="C4" style:family="table-column">
      <style:table-column-properties style:column-width="4cm"/>
    </style:style>
    <style:style style:name="C5" style:family="table-column">
      <style:table-column-properties style:column-width="5.4cm"/>
    </style:style>
    <style:style style:name="C6" style:family="table-column">
      <style:table-column-properties style:column-width="5.4cm"/>
    </style:style>
    <style:style style:name="HeaderRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.65cm"/>
    </style:style>
    <style:style style:name="DataRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.75cm"/>
    </style:style>
    <style:style style:name="CheckRow" style:family="table-row">
      <style:table-row-properties style:row-height="1cm"/>
    </style:style>
    <style:style style:name="ConfirmRow" style:family="table-row">
      <style:table-row-properties style:row-height="1cm"/>
    </style:style>
    <style:style style:name="MemoRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.65cm"/>
    </style:style>
    <style:style style:name="MemoSpace" style:family="table-row">
      <style:table-row-properties style:row-height="3cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CenterCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="GrayCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:background-color="#eeeeee" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HeaderText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PL1"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Right">令和　　年　　月　　日</text:p>
      <text:p>(提出先)</text:p>
      <text:p>　横浜市長</text:p>
      <text:p text:style-name="Title">是　正　報　告　書</text:p>
      <text:p text:style-name="Right">住所</text:p>
      <text:p text:style-name="Right">氏名</text:p>
      <text:p text:style-name="Right">電話</text:p>
      <text:p/>
      <text:p>次のとおり是正しましたので報告します。</text:p>
      <text:p text:style-name="Section">１　所在地</text:p>
      <text:p>　　　―</text:p>
      <text:p text:style-name="Section">２　是正方法等</text:p>
      <table:table table:name="CorrectionMethods" table:style-name="T1">
        <table:table-column table:style-name="C1"/>
        <table:table-column table:style-name="C2"/>
        <table:table-column table:style-name="C3"/>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="CenterCell"><text:p>是正箇所</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p>是正方法</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p>条文</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Small">　※　法：建築基準法、令：建築基準法施行令、市：横浜市建築基準条例、盛：宅地造成及び特定盛土等規制法、都：都市計</text:p>
      <text:p text:style-name="Small">画法</text:p>
      <text:p text:style-name="Section">３　是正年月日</text:p>
      <text:p>　　是正工事完了日　　　：　　　令和　　年　　月　　日</text:p>
      <text:p text:style-name="PageStart">４　是正に係る設計者・施工者</text:p>
      <text:p>　（１）設計者</text:p>
      <text:p>　　　　氏　　名：</text:p>
      <text:p>　　　　所　在　地：</text:p>
      <text:p>　　　　電話番号：</text:p>
      <text:p/>
      <text:p>　（２）工事施工者</text:p>
      <text:p>　　　　氏　　名：</text:p>
      <text:p>　　　　所　在　地：</text:p>
      <text:p>　　　　電話番号：</text:p>
      <text:p text:style-name="Section">５　添付図書</text:p>
      <text:p>□配置図　　□敷地面積求積図　　□床面積求積図　　□各階平面図</text:p>
      <text:p>□立面図　　□断面図　　　　　　□敷地断面図　　　□地盤面算定表</text:p>
      <text:p>□建具詳細図　　□耐火構造等の構造詳細図　　□設備に関する資料</text:p>
      <text:p>□仕上げ表　　□認定書の写し　　□製品カタログ　　□写真　　□工程表</text:p>
      <text:p>□その他（　　　　　　　　　　　　　　　　　　　　　　　　　　　）</text:p>
      <text:p text:style-name="Section">６　特記事項その他</text:p>
      <text:p/>
      <text:p/>
      <text:p/>
      <text:p/>
      <text:p/>
      <text:p/>
      <text:p/>
      <text:p/>
      <table:table table:name="Confirmation" table:style-name="T2">
        <table:table-column table:style-name="C4"/>
        <table:table-column table:style-name="C5"/>
        <table:table-column table:style-name="C6"/>
        <table:table-row table:style-name="ConfirmRow">
          <table:table-cell table:style-name="CenterCell"><text:p>確認欄</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="CenterCell"><text:p>建達対第　　　号　　令和　　年　　月　　日</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="MemoRow">
          <table:table-cell table:number-columns-spanned="3" table:style-name="GrayCell"><text:p>市記入欄</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="MemoSpace">
          <table:table-cell table:number-columns-spanned="3" table:style-name="Cell"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Small">　※　宅地造成及び特定盛土等規制法22条第1項については「是正」を「改善」と読み替</text:p>
      <text:p text:style-name="Small">えます。</text:p>
    </office:text>
  </office:body>
</office:document>