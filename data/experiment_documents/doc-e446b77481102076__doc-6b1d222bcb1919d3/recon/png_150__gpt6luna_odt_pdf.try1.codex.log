     <table:covered-table-cell/>
    </table:table-row>
    <table:table-row>
     <table:covered-table-cell/>
     <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>□ 定置用リチウムイオン蓄電システム</text:p></table:table-cell>
     <table:covered-table-cell/>
    </table:table-row>
    <table:table-row>
