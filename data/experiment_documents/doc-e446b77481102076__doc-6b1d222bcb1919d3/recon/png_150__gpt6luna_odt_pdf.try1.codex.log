     <table:covered-table-cell/>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="LabelCell"><text:p>補　助　金　交　付　予　約　額</text:p></table:table-cell>
     <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">（受付通知書に記載の合計金額）</text:p></table:table-cell>
     <table:covered-table-cell/>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="LabelCell"><text:p>設　置　住　所</text:p></table:table-cell>
     <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>〒　多治見市</text:p></table:table-cell>
     <table:covered-table-cell/>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="LabelCell" table:number-rows-spanned="4"><text:p>補　助　対　象</text:p><text:p>シ　ス　テ　ム</text:p></table:table-cell>
     <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>□ 住宅用太陽光発電システム</text:p></table:table-cell>
     <table:covered-table-cell/>
    </table:table-row>
    <table:table-row>
     <table:covered-table-cell/>
