<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Standard" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-size="12pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="HeadingBlue" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.25cm" fo:margin-bottom="0.22cm"/>
      <style:text-properties fo:font-size="20pt" fo:color="#31599a"/>
    </style:style>
    <style:style style:name="TitleBlue" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.4cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="21pt" fo:color="#4774c9"/>
    </style:style>
    <style:style style:name="TableText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="SmallFooter" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.5cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties fo:width="100%" table:align="margins"/>
    </style:style>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="5.2cm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="10.6cm"/>
    </style:style>
    <style:style style:name="ColHalf" style:family="table-column">
      <style:table-column-properties style:column-width="7.9cm"/>
    </style:style>
    <style:style style:name="ColQ1" style:family="table-column">
      <style:table-column-properties style:column-width="4.6cm"/>
    </style:style>
    <style:style style:name="ColQ2" style:family="table-column">
      <style:table-column-properties style:column-width="3.0cm"/>
    </style:style>
    <style:style style:name="ColQ3" style:family="table-column">
      <style:table-column-properties style:column-width="5.0cm"/>
    </style:style>
    <style:style style:name="ColQ4" style:family="table-column">
      <style:table-column-properties style:column-width="3.2cm"/>
    </style:style>
    <style:style style:name="RowTall" style:family="table-row">
      <style:table-row-properties style:min-row-height="4.5cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RowMedium" style:family="table-row">
      <style:table-row-properties style:min-row-height="2.5cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="RowShort" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.75cm"/>
    </style:style>
    <style:style style:name="RowVeryTall" style:family="table-row">
      <style:table-row-properties style:min-row-height="5cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.12cm" style:vertical-align="top"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="2.5cm" fo:margin-bottom="2.5cm" fo:margin-left="2.5cm" fo:margin-right="2.5cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="Standard">East Sussex</text:p>
      <text:p text:style-name="Standard">County Council</text:p>
      <text:p text:style-name="TitleBlue">The East Sussex Integrated Progress Review Part 2</text:p>
      <text:p text:style-name="TitleBlue">full version.</text:p>
      <text:p text:style-name="Standard">(For settings who are completing a paper-based progress check at age two)</text:p>
      <text:p text:style-name="HeadingBlue">Child and family information</text:p>
      <table:table table:name="ChildFamily" table:style-name="FormTable">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Name of Child</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Date of Birth</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Home Language</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Postcode</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Parents or Carers Names</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="Standard"/>
      <text:p text:style-name="HeadingBlue">Early Education Information</text:p>
      <table:table table:name="EarlyEducation" table:style-name="FormTable">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Name of early years setting</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Any other setting attended</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Name of the person completing the form</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Number of hours per week at each setting.</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="HeadingBlue">Support already in place from other professionals or agencies (if applicable). Add rows if needed.</text:p>
      <table:table table:name="Support" table:style-name="FormTable">
        <table:table-column table:style-name="ColHalf"/>
        <table:table-column table:style-name="ColHalf"/>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Name</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Agency</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="SmallFooter">Page 1 of 4             Version 5, updated July 25       eastsussex.gov.uk</text:p>

      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="HeadingBlue">Child’s learning - key person to complete.</text:p>
      <text:p text:style-name="HeadingBlue">The characteristics of effective learning</text:p>
      <table:table table:name="EffectiveLearning" table:style-name="FormTable">
        <table:table-column table:style-name="ColHalf"/>
        <table:table-row table:style-name="RowVeryTall">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Note to key person - please describe how you see the child using the characteristics of effective learning in their play.</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="HeadingBlue">Child’s voice</text:p>
      <table:table table:name="ChildVoice" table:style-name="FormTable">
        <table:table-column table:style-name="ColHalf"/>
        <table:table-row table:style-name="RowTall">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Note to key person - What sort of learner are they; What makes me happy; What do I enjoy? Direct quotes or examples from the child.</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="HeadingBlue">Personal, Social and Emotional Development</text:p>
      <table:table table:name="PersonalSocialEmotional" table:style-name="FormTable">
        <table:table-column table:style-name="ColHalf"/>
        <table:table-row table:style-name="RowVeryTall"><table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Parent comments:</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowTall"><table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Setting comments:</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="SmallFooter">Page 2 of 4             Version 5, updated July 25       eastsussex.gov.uk</text:p>

      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="HeadingBlue">Communication and Language Development</text:p>
      <table:table table:name="CommunicationLanguage" table:style-name="FormTable">
        <table:table-column table:style-name="ColHalf"/>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Parent comments:</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowTall"><table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Setting comments:</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="HeadingBlue">Physical Development</text:p>
      <table:table table:name="PhysicalDevelopment" table:style-name="FormTable">
        <table:table-column table:style-name="ColHalf"/>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Parent comments:</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowTall"><table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Setting comments:</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="HeadingBlue">Areas for Development</text:p>
      <table:table table:name="AreasDevelopment" table:style-name="FormTable">
        <table:table-column table:style-name="ColHalf"/>
        <table:table-row table:style-name="RowShort"><table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">What can parents or carers do at home:</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowTall"><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowShort"><table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">What the education setting will do:</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowVeryTall"><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="SmallFooter">Page 3 of 4             Version 5, updated July 25       eastsussex.gov.uk</text:p>

      <text:p text:style-name="PageStart"/>
      <table:table table:name="ContinuationArea" table:style-name="FormTable">
        <table:table-column table:style-name="ColHalf"/>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="HeadingBlue">Child’s learning and development summary for the</text:p>
      <text:p text:style-name="HeadingBlue">Health Visiting Team</text:p>
      <table:table table:name="HealthVisitingSummary" table:style-name="FormTable">
        <table:table-column table:style-name="ColQ1"/>
        <table:table-column table:style-name="ColQ2"/>
        <table:table-column table:style-name="ColQ3"/>
        <table:table-column table:style-name="ColQ4"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Is the child ‘on track’ or is additional support in place?</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Brief overview of strategies being used if applicable or specifics of referrals made.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Is further support needed from HV team? Yes/No Please specify support required.</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Personal, social and emotional development</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Communication and language</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Physical development</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="Standard"/>
      <text:p text:style-name="Standard"><text:span text:style-name="BoldText">Please ensure that you have parent/carer permission to share this information with the Health Visiting team – see the document Important Information for Completing Part 2</text:span></text:p>
      <text:p text:style-name="HeadingBlue">Parent or Carer Signatures</text:p>
      <table:table table:name="Signatures" table:style-name="FormTable">
        <table:table-column table:style-name="ColHalf"/>
        <table:table-column table:style-name="ColHalf"/>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Name</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowShort"><table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Signature (or state that this is on the setting’s copy).</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Date</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="SmallFooter">Page 4 of 4             Version 5, updated July 25       eastsussex.gov.uk</text:p>
    </office:text>
  </office:body>
</office:document>