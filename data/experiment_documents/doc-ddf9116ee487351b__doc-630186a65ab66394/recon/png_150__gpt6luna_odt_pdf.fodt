<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.12cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#000000"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.2cm" fo:margin-bottom="0.1cm" fo:line-height="105%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="20pt" fo:color="#3B63A5"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.45cm" fo:line-height="105%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="14pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.55cm" fo:margin-bottom="0.3cm" fo:line-height="105%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="16pt" fo:color="#315A9E"/>
    </style:style>
    <style:style style:name="SectionFirst" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.25cm" fo:margin-bottom="0.3cm" fo:line-height="105%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="16pt" fo:color="#315A9E"/>
    </style:style>
    <style:style style:name="PageSection" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0.25cm" fo:margin-bottom="0.3cm" fo:line-height="105%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="16pt" fo:color="#315A9E"/>
    </style:style>
    <style:style style:name="MainTitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.3cm" fo:margin-bottom="0.08cm" fo:line-height="105%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="20pt" fo:color="#3B63A5"/>
    </style:style>
    <style:style style:name="Prompt" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.1cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.4cm" fo:margin-bottom="0.3cm" fo:line-height="150%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:font-weight="bold" fo:color="#000000"/>
    </style:style>
    <style:style style:name="FooterText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.4cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-top="2.5cm" fo:margin-bottom="2.2cm" fo:margin-left="2.5cm" fo:margin-right="2.5cm"/>
    </style:page-layout>
    <style:style style:name="T1" style:family="table">
      <style:table-properties style:width="16cm" table:align="left" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="T2" style:family="table">
      <style:table-properties style:width="16cm" table:align="left" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="T3" style:family="table">
      <style:table-properties style:width="16cm" table:align="left" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="T4" style:family="table">
      <style:table-properties style:width="16cm" table:align="left" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="FooterTable" style:family="table">
      <style:table-properties style:width="16cm" table:align="left" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ColLabel" style:family="table-column">
      <style:table-column-properties style:column-width="5cm"/>
    </style:style>
    <style:style style:name="ColRest" style:family="table-column">
      <style:table-column-properties style:column-width="11cm"/>
    </style:style>
    <style:style style:name="ColHalf" style:family="table-column">
      <style:table-column-properties style:column-width="8cm"/>
    </style:style>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="4.5cm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="2.8cm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="4.8cm"/>
    </style:style>
    <style:style style:name="ColD" style:family="table-column">
      <style:table-column-properties style:column-width="3.9cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.14cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="CellTight" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.1cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="NoBorderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="RowShort" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.6cm"/>
    </style:style>
    <style:style style:name="RowMedium" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.9cm"/>
    </style:style>
    <style:style style:name="RowLarge" style:family="table-row">
      <style:table-row-properties style:min-row-height="4.4cm"/>
    </style:style>
    <style:style style:name="RowVoice" style:family="table-row">
      <style:table-row-properties style:min-row-height="3cm"/>
    </style:style>
    <style:style style:name="RowComment" style:family="table-row">
      <style:table-row-properties style:min-row-height="6.2cm"/>
    </style:style>
    <style:style style:name="RowArea" style:family="table-row">
      <style:table-row-properties style:min-row-height="3.3cm"/>
    </style:style>
    <style:style style:name="RowCarry" style:family="table-row">
      <style:table-row-properties style:min-row-height="1.5cm"/>
    </style:style>
    <style:style style:name="RowSummary" style:family="table-row">
      <style:table-row-properties style:min-row-height="1.2cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Prompt">East Sussex</text:p>
      <text:p text:style-name="Prompt">County Council</text:p>
      <text:p text:style-name="MainTitle">The East Sussex Integrated Progress Review Part 2<br/>full version.</text:p>
      <text:p text:style-name="Subtitle">(For settings who are completing a paper-based progress check at<br/>age two)</text:p>

      <text:p text:style-name="SectionFirst">Child and family information</text:p>
      <table:table table:name="ChildFamily" table:style-name="T1">
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColRest"/>
        <table:table-row table:style-name="RowShort"><table:table-cell table:style-name="Cell"><text:p>Name of Child</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowShort"><table:table-cell table:style-name="Cell"><text:p>Date of Birth</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowShort"><table:table-cell table:style-name="Cell"><text:p>Home Language</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowShort"><table:table-cell table:style-name="Cell"><text:p>Postcode</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowShort"><table:table-cell table:style-name="Cell"><text:p>Parents or Carers Names</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
      </table:table>

      <text:p text:style-name="Section">Early Education Information</text:p>
      <table:table table:name="EarlyEducation" table:style-name="T1">
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColRest"/>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="Cell"><text:p>Name of early years<br/>setting</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="Cell"><text:p>Any other setting<br/>attended</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="Cell"><text:p>Name of the person<br/>completing the form</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="Cell"><text:p>Number of hours per<br/>week at each setting.</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
      </table:table>

      <text:p text:style-name="Section">Support already in place from other professionals or<br/>agencies (if applicable). Add rows if needed.</text:p>
      <table:table table:name="SupportAgencies" table:style-name="T2">
        <table:table-column table:style-name="ColHalf"/>
        <table:table-column table:style-name="ColHalf"/>
        <table:table-row table:style-name="RowShort"><table:table-cell table:style-name="CellTight"><text:p>Name</text:p></table:table-cell><table:table-cell table:style-name="CellTight"><text:p>Agency</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowShort"><table:table-cell table:style-name="CellTight"><text:p/></table:table-cell><table:table-cell table:style-name="CellTight"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowShort"><table:table-cell table:style-name="CellTight"><text:p/></table:table-cell><table:table-cell table:style-name="CellTight"><text:p/></table:table-cell></table:table-row>
      </table:table>

      <table:table table:name="Footer1" table:style-name="FooterTable">
        <table:table-column table:style-name="ColA"/><table:table-column table:style-name="ColB"/><table:table-column table:style-name="ColC"/><table:table-column table:style-name="ColD"/>
        <table:table-row><table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="FooterText">Page 1 of 4</text:p></table:table-cell><table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="FooterText">Version 5, updated July 25</text:p></table:table-cell><table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="FooterText">east sussex.gov.uk</text:p></table:table-cell><table:table-cell table:style-name="NoBorderCell"><text:p/></table:table-cell></table:table-row>
      </table:table>

      <text:p text:style-name="PageSection">Child’s learning - key person to complete.</text:p>
      <text:p text:style-name="SectionFirst">The characteristics of effective learning</text:p>
      <table:table table:name="EffectiveLearning" table:style-name="T3">
        <table:table-column table:style-name="ColRest"/>
        <table:table-row table:style-name="RowShort"><table:table-cell table:style-name="Cell"><text:p>Note to key person - please describe how you see the child using the<br/>characteristics of effective learning in their play.</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowLarge"><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
      </table:table>

      <text:p text:style-name="Section">Child’s voice</text:p>
      <table:table table:name="ChildVoice" table:style-name="T3">
        <table:table-column table:style-name="ColRest"/>
        <table:table-row table:style-name="RowShort"><table:table-cell table:style-name="Cell"><text:p>Note to key person - What sort of learner are they; What makes me happy; What<br/>do I enjoy? Direct quotes or examples from the child.</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowVoice"><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
      </table:table>

      <text:p text:style-name="Section">Personal, Social and Emotional Development</text:p>
      <table:table table:name="PersonalSocialEmotional" table:style-name="T3">
        <table:table-column table:style-name="ColRest"/>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="Cell"><text:p>Parent comments:</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowComment"><table:table-cell table:style-name="Cell"><text:p>Setting comments:</text:p></table:table-cell></table:table-row>
      </table:table>

      <table:table table:name="Footer2" table:style-name="FooterTable">
        <table:table-column table:style-name="ColA"/><table:table-column table:style-name="ColB"/><table:table-column table:style-name="ColC"/><table:table-column table:style-name="ColD"/>
        <table:table-row><table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="FooterText">Page 2 of 4</text:p></table:table-cell><table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="FooterText">Version 5, updated July 25</text:p></table:table-cell><table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="FooterText">east sussex.gov.uk</text:p></table:table-cell><table:table-cell table:style-name="NoBorderCell"><text:p/></table:table-cell></table:table-row>
      </table:table>

      <text:p text:style-name="PageSection">Communication and Language Development</text:p>
      <table:table table:name="CommunicationLanguage" table:style-name="T3">
        <table:table-column table:style-name="ColRest"/>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="Cell"><text:p>Parent comments:</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowComment"><table:table-cell table:style-name="Cell"><text:p>Setting comments:</text:p></table:table-cell></table:table-row>
      </table:table>

      <text:p text:style-name="Section">Physical Development</text:p>
      <table:table table:name="PhysicalDevelopment" table:style-name="T3">
        <table:table-column table:style-name="ColRest"/>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="Cell"><text:p>Parent comments:</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowComment"><table:table-cell table:style-name="Cell"><text:p>Setting comments:</text:p></table:table-cell></table:table-row>
      </table:table>

      <text:p text:style-name="Section">Areas for Development</text:p>
      <table:table table:name="AreasForDevelopment" table:style-name="T3">
        <table:table-column table:style-name="ColRest"/>
        <table:table-row table:style-name="RowShort"><table:table-cell table:style-name="CellTight"><text:p>What can parents or carers can do at home:</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowArea"><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowShort"><table:table-cell table:style-name="CellTight"><text:p>What the education setting will do:</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowArea"><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
      </table:table>

      <table:table table:name="Footer3" table:style-name="FooterTable">
        <table:table-column table:style-name="ColA"/><table:table-column table:style-name="ColB"/><table:table-column table:style-name="ColC"/><table:table-column table:style-name="ColD"/>
        <table:table-row><table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="FooterText">Page 3 of 4</text:p></table:table-cell><table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="FooterText">Version 5, updated July 25</text:p></table:table-cell><table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="FooterText">east sussex.gov.uk</text:p></table:table-cell><table:table-cell table:style-name="NoBorderCell"><text:p/></table:table-cell></table:table-row>
      </table:table>

      <text:p text:style-name="PageSection"/>
      <table:table table:name="AreasForDevelopmentContinuation" table:style-name="T3">
        <table:table-column table:style-name="ColRest"/>
        <table:table-row table:style-name="RowCarry"><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
      </table:table>

      <text:p text:style-name="Section">Child’s learning and development summary for the<br/>Health Visiting Team</text:p>
      <table:table table:name="HealthVisitingSummary" table:style-name="T4">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColD"/>
        <table:table-row>
          <table:table-cell table:style-name="CellTight"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CellTight"><text:p>Is the child<br/>‘on track’ or<br/>is additional<br/>support in<br/>place?</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTight"><text:p>Brief overview of<br/>strategies being used if<br/>applicable or specifics<br/>of referrals made.</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTight"><text:p>Is further<br/>support needed<br/>from HV team?<br/><text:span text:style-name="SectionFirst">Yes/No</text:span><br/>Please specify<br/>support required.</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowSummary"><table:table-cell table:style-name="CellTight"><text:p>Personal, social and<br/>emotional<br/>development</text:p></table:table-cell><table:table-cell table:style-name="CellTight"><text:p/></table:table-cell><table:table-cell table:style-name="CellTight"><text:p/></table:table-cell><table:table-cell table:style-name="CellTight"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowSummary"><table:table-cell table:style-name="CellTight"><text:p>Communication and<br/>language</text:p></table:table-cell><table:table-cell table:style-name="CellTight"><text:p/></table:table-cell><table:table-cell table:style-name="CellTight"><text:p/></table:table-cell><table:table-cell table:style-name="CellTight"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowSummary"><table:table-cell table:style-name="CellTight"><text:p>Physical<br/>development</text:p></table:table-cell><table:table-cell table:style-name="CellTight"><text:p/></table:table-cell><table:table-cell table:style-name="CellTight"><text:p/></table:table-cell><table:table-cell table:style-name="CellTight"><text:p/></table:table-cell></table:table-row>
      </table:table>

      <text:p text:style-name="Note">Please ensure that you have parent/carer permission to share this information<br/>with the Health Visiting team – see the document Important Information for<br/>Completing Part 2</text:p>
      <text:p text:style-name="Section">Parent or Carer Signatures</text:p>
      <table:table table:name="ParentCarerSignatures" table:style-name="T2">
        <table:table-column table:style-name="ColHalf"/>
        <table:table-column table:style-name="ColHalf"/>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="Cell"><text:p>Name</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="Cell"><text:p>Signature (or state that this is on the<br/>setting’s copy).</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="Cell"><text:p>Date</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
      </table:table>

      <table:table table:name="Footer4" table:style-name="FooterTable">
        <table:table-column table:style-name="ColA"/><table:table-column table:style-name="ColB"/><table:table-column table:style-name="ColC"/><table:table-column table:style-name="ColD"/>
        <table:table-row><table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="FooterText">Page 4 of 4</text:p></table:table-cell><table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="FooterText">Version 5, updated July 25</text:p></table:table-cell><table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="FooterText">east sussex.gov.uk</text:p></table:table-cell><table:table-cell table:style-name="NoBorderCell"><text:p/></table:table-cell></table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>