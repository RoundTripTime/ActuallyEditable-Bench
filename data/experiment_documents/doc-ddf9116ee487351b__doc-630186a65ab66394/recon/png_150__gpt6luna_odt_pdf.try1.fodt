<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.12cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="12pt" fo:color="#000000" style:font-name="Arial"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Logo" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.4cm" fo:margin-bottom="0.7cm"/>
      <style:text-properties fo:font-size="13pt" fo:color="#24546a" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="105%"/>
      <style:text-properties fo:font-size="24pt" fo:color="#4675c9"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.5cm" fo:line-height="105%"/>
      <style:text-properties fo:font-size="18pt"/>
    </style:style>
    <style:style style:name="Heading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.35cm" fo:margin-bottom="0.25cm"/>
      <style:text-properties fo:font-size="19pt" fo:color="#31599d"/>
    </style:style>
    <style:style style:name="Subheading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.15cm" fo:margin-bottom="0.25cm"/>
      <style:text-properties fo:font-size="16pt" fo:color="#31599d"/>
    </style:style>
    <style:style style:name="Prompt" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Footer" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.4cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="1pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-top="2.2cm" fo:margin-bottom="2cm" fo:margin-left="2.5cm" fo:margin-right="2.5cm"/>
    </style:page-layout>
    <style:style style:name="Table" style:family="table">
      <style:table-properties style:width="16cm" table:align="left"/>
    </style:style>
    <style:style style:name="ColNarrow" style:family="table-column">
      <style:table-column-properties style:column-width="5.2cm"/>
    </style:style>
    <style:style style:name="ColWide" style:family="table-column">
      <style:table-column-properties style:column-width="10.8cm"/>
    </style:style>
    <style:style style:name="ColHalf" style:family="table-column">
      <style:table-column-properties style:column-width="8cm"/>
    </style:style>
    <style:style style:name="ColSummary1" style:family="table-column">
      <style:table-column-properties style:column-width="4.4cm"/>
    </style:style>
    <style:style style:name="ColSummary2" style:family="table-column">
      <style:table-column-properties style:column-width="3cm"/>
    </style:style>
    <style:style style:name="ColSummary3" style:family="table-column">
      <style:table-column-properties style:column-width="5cm"/>
    </style:style>
    <style:style style:name="ColSummary4" style:family="table-column">
      <style:table-column-properties style:column-width="3.6cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #333333" fo:padding="0.15cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="CellTall" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #333333" fo:padding="0.15cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="CellLabel" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #333333" fo:padding="0.15cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="RowShort" style:family="table-row">
      <style:table-row-properties style:row-height="0.75cm"/>
    </style:style>
    <style:style style:name="RowMedium" style:family="table-row">
      <style:table-row-properties style:row-height="1.05cm"/>
    </style:style>
    <style:style style:name="RowWrite" style:family="table-row">
      <style:table-row-properties style:row-height="3.5cm"/>
    </style:style>
    <style:style style:name="RowLarge" style:family="table-row">
      <style:table-row-properties style:row-height="5cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Logo">East Sussex<br/>County Council</text:p>
      <text:p text:style-name="Title">The East Sussex Integrated Progress Review Part 2</text:p>
      <text:p text:style-name="Title">full version.</text:p>
      <text:p text:style-name="Subtitle">(For settings who are completing a paper-based progress check at</text:p>
      <text:p text:style-name="Subtitle">age two)</text:p>
      <text:p text:style-name="Heading">Child and family information</text:p>
      <table:table table:name="ChildFamily" table:style-name="Table">
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-column table:style-name="ColWide"/>
        <table:table-row table:style-name="RowShort"><table:table-cell table:style-name="CellLabel"><text:p text:style-name="Prompt">Name of Child</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="RowShort"><table:table-cell table:style-name="CellLabel"><text:p text:style-name="Prompt">Date of Birth</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="RowShort"><table:table-cell table:style-name="CellLabel"><text:p text:style-name="Prompt">Home Language</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="RowShort"><table:table-cell table:style-name="CellLabel"><text:p text:style-name="Prompt">Postcode</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="RowShort"><table:table-cell table:style-name="CellLabel"><text:p text:style-name="Prompt">Parents or Carers Names</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Heading">Early Education Information</text:p>
      <table:table table:name="EarlyEducation" table:style-name="Table">
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-column table:style-name="ColWide"/>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="CellLabel"><text:p text:style-name="Prompt">Name of early years<br/>setting</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="CellLabel"><text:p text:style-name="Prompt">Any other setting<br/>attended</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="CellLabel"><text:p text:style-name="Prompt">Name of the person<br/>completing the form</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="CellLabel"><text:p text:style-name="Prompt">Number of hours per<br/>week at each setting.</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Heading">Support already in place from other professionals or</text:p>
      <text:p text:style-name="Heading">agencies (if applicable). Add rows if needed.</text:p>
      <table:table table:name="ProfessionalSupport" table:style-name="Table">
        <table:table-column table:style-name="ColHalf"/>
        <table:table-column table:style-name="ColHalf"/>
        <table:table-row table:style-name="RowShort"><table:table-cell table:style-name="Cell"><text:p text:style-name="Prompt">Name</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Prompt">Agency</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Footer">Page 1 of 4       Version 5, updated July 25       eastsussex.gov.uk</text:p>
      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="Heading">Child’s learning - key person to complete.</text:p>
      <text:p text:style-name="Subheading">The characteristics of effective learning</text:p>
      <table:table table:name="EffectiveLearning" table:style-name="Table">
        <table:table-column table:style-name="ColWide"/>
        <table:table-row table:style-name="RowShort"><table:table-cell table:style-name="Cell"><text:p text:style-name="Prompt">Note to key person - please describe how you see the child using the</text:p><text:p text:style-name="Prompt">characteristics of effective learning in their play.</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowLarge"><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Subheading">Child’s voice</text:p>
      <table:table table:name="ChildVoice" table:style-name="Table">
        <table:table-column table:style-name="ColWide"/>
        <table:table-row table:style-name="RowShort"><table:table-cell table:style-name="Cell"><text:p text:style-name="Prompt">Note to key person - What sort of learner are they; What makes me happy; What</text:p><text:p text:style-name="Prompt">do I enjoy? Direct quotes or examples from the child.</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowWrite"><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Heading">Personal, Social and Emotional Development</text:p>
      <table:table table:name="PSEDComments" table:style-name="Table">
        <table:table-column table:style-name="ColWide"/>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="Cell"><text:p text:style-name="Prompt">Parent comments:</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowLarge"><table:table-cell table:style-name="Cell"><text:p text:style-name="Prompt">Setting comments:</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="Footer">Page 2 of 4       Version 5, updated July 25       eastsussex.gov.uk</text:p>
      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="Heading">Communication and Language Development</text:p>
      <table:table table:name="CommunicationLanguage" table:style-name="Table">
        <table:table-column table:style-name="ColWide"/>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="Cell"><text:p text:style-name="Prompt">Parent comments:</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowLarge"><table:table-cell table:style-name="Cell"><text:p text:style-name="Prompt">Setting comments:</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="Heading">Physical Development</text:p>
      <table:table table:name="PhysicalDevelopment" table:style-name="Table">
        <table:table-column table:style-name="ColWide"/>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="Cell"><text:p text:style-name="Prompt">Parent comments:</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowLarge"><table:table-cell table:style-name="Cell"><text:p text:style-name="Prompt">Setting comments:</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="Heading">Areas for Development</text:p>
      <table:table table:name="AreasForDevelopment" table:style-name="Table">
        <table:table-column table:style-name="ColWide"/>
        <table:table-row table:style-name="RowShort"><table:table-cell table:style-name="Cell"><text:p text:style-name="Prompt">What can parents or carers do at home:</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowLarge"><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="RowShort"><table:table-cell table:style-name="Cell"><text:p text:style-name="Prompt">What the education setting will do:</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowLarge"><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Footer">Page 3 of 4       Version 5, updated July 25       eastsussex.gov.uk</text:p>
      <text:p text:style-name="PageStart"/>
      <table:table table:name="AreasForDevelopmentContinuation" table:style-name="Table">
        <table:table-column table:style-name="ColWide"/>
        <table:table-row table:style-name="RowWrite"><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Heading">Child’s learning and development summary for the</text:p>
      <text:p text:style-name="Heading">Health Visiting Team</text:p>
      <table:table table:name="HealthVisitingSummary" table:style-name="Table">
        <table:table-column table:style-name="ColSummary1"/>
        <table:table-column table:style-name="ColSummary2"/>
        <table:table-column table:style-name="ColSummary3"/>
        <table:table-column table:style-name="ColSummary4"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Prompt">Is the child</text:p><text:p text:style-name="Prompt">‘on track’ or</text:p><text:p text:style-name="Prompt">is additional</text:p><text:p text:style-name="Prompt">support in</text:p><text:p text:style-name="Prompt">place?</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Prompt">Brief overview of</text:p><text:p text:style-name="Prompt">strategies being used if</text:p><text:p text:style-name="Prompt">applicable or specifics</text:p><text:p text:style-name="Prompt">of referrals made.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Prompt">Is further</text:p><text:p text:style-name="Prompt">support needed</text:p><text:p text:style-name="Prompt">from HV team?</text:p><text:p text:style-name="Prompt">Yes/No</text:p><text:p text:style-name="Prompt">Please specify</text:p><text:p text:style-name="Prompt">support required.</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowLarge"><table:table-cell table:style-name="Cell"><text:p text:style-name="Prompt">Personal, social and</text:p><text:p text:style-name="Prompt">emotional</text:p><text:p text:style-name="Prompt">development</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="RowLarge"><table:table-cell table:style-name="Cell"><text:p text:style-name="Prompt">Communication and</text:p><text:p text:style-name="Prompt">language</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="RowLarge"><table:table-cell table:style-name="Cell"><text:p text:style-name="Prompt">Physical</text:p><text:p text:style-name="Prompt">development</text:p></table:table-cell><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Body"><text:span> </text:span></text:p>
