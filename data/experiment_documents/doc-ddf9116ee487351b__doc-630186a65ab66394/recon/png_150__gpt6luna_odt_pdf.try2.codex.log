    </style:style>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="4.5cm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="2.8cm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="4.8cm"/>
    </style:style>
    <style:style style:name="ColD" style:family="table-column">
      <style:table-column-properties style:column-width="3.9cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.14cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="CellTight" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.1cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="NoBorderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0cm" style:vertical-align="top"/>
