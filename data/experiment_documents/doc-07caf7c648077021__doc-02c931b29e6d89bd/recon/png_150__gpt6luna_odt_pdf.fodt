<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%" fo:margin-top="0cm" fo:margin-bottom="0.34cm"/>
      <style:text-properties style:font-name="Calibri" fo:font-size="11pt" fo:color="#243D36"/>
    </style:style>
    <style:style style:name="Kicker" style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%" fo:margin-top="0cm" fo:margin-bottom="0.55cm"/>
      <style:text-properties style:font-name="Calibri" fo:font-size="11pt" fo:color="#243D36"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%" fo:margin-top="0cm" fo:margin-bottom="0.35cm"/>
      <style:text-properties style:font-name="Liberation Sans" fo:font-size="28pt" fo:color="#243D36"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%" fo:margin-top="0cm" fo:margin-bottom="0.30cm"/>
      <style:text-properties style:font-name="Calibri" fo:font-size="11pt" fo:color="#243D36"/>
    </style:style>
    <style:style style:name="Meta" style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties style:font-name="Calibri" fo:font-size="11pt" fo:color="#243D36"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%" fo:margin-top="0.34cm" fo:margin-bottom="0.27cm"/>
      <style:text-properties style:font-name="Calibri" fo:font-size="12.5pt" fo:font-weight="bold" fo:color="#243D36"/>
    </style:style>
    <style:style style:name="ChecklistTitle" style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%" fo:margin-top="0.34cm" fo:margin-bottom="0.27cm"/>
      <style:text-properties style:font-name="Calibri" fo:font-size="12.5pt" fo:font-weight="bold" fo:color="#243D36"/>
    </style:style>
    <style:style style:name="Bullet" style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%" fo:margin-top="0cm" fo:margin-bottom="0.34cm"/>
      <style:text-properties style:font-name="Calibri" fo:font-size="11pt" fo:color="#243D36"/>
    </style:style>
    <style:style style:name="Footer" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:line-height="120%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties style:font-name="Calibri" fo:font-size="9pt" fo:color="#243D36"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="1.68cm" fo:margin-right="1.68cm" fo:margin-top="1.96cm" fo:margin-bottom="1.3cm" style:print-orientation="portrait"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout">
      <style:footer>
        <text:p text:style-name="Footer">Ostro templates  ·  1</text:p>
      </style:footer>
    </style:master-page>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Kicker">OSTRO / WORKING TEMPLATES</text:p>
      <text:p text:style-name="Title">Branding project brief</text:p>
      <text:p text:style-name="Subtitle">Editable template · replace every bracketed field before use</text:p>
      <text:p text:style-name="Meta">Prepared by: [your name or business]</text:p>
      <text:p text:style-name="Meta">Prepared for: [client name]</text:p>
      <text:p text:style-name="Meta">Date: [date]</text:p>
      <text:p text:style-name="Section">Background and problem</text:p>
      <text:p text:style-name="Body">[Add your background and problem here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="Section">Audience</text:p>
      <text:p text:style-name="Body">[Add your audience here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="Section">Desired outcome</text:p>
      <text:p text:style-name="Body">[Add your desired outcome here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="Section">Required outputs</text:p>
      <text:p text:style-name="Body">[Add your required outputs here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="Section">Available inputs</text:p>
      <text:p text:style-name="Body">[Add your available inputs here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="Section">Constraints and exclusions</text:p>
      <text:p text:style-name="Body">[Add your constraints and exclusions here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="Section">Timing and approvals</text:p>
      <text:p text:style-name="Body">[Add your timing and approvals here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="Section">Open questions</text:p>
      <text:p text:style-name="Body">[Add your open questions here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="ChecklistTitle">Before sending — remove this checklist</text:p>
      <text:p text:style-name="Bullet">• Name the person responsible for decisions and consolidated feedback.</text:p>
      <text:p text:style-name="Bullet">• Separate requirements from preferences and unresolved questions.</text:p>
      <text:p text:style-name="Bullet">• Confirm dates and dependencies before treating them as commitments.</text:p>
      <text:p text:style-name="Body">Template and example: https://tryostro.com/templates/branding-brief/</text:p>
    </office:text>
  </office:body>
</office:document>