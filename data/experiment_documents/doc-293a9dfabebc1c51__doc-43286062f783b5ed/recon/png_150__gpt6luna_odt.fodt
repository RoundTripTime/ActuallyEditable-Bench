<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.08cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Logo" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="12pt" fo:font-weight="bold" fo:color="#24546b"/>
    </style:style>
    <style:style style:name="LogoSub" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.2cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#24546b"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.15cm" fo:margin-bottom="0.05cm" fo:line-height="105%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="23pt" fo:color="#4775c9"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.4cm" fo:line-height="105%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="17pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.32cm" fo:margin-bottom="0.08cm" fo:line-height="105%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="19pt" fo:color="#345c9d"/>
    </style:style>
    <style:style style:name="SectionLargeGap" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.48cm" fo:margin-bottom="0.08cm" fo:line-height="105%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="19pt" fo:color="#345c9d"/>
    </style:style>
    <style:style style:name="Page2Start" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0.22cm" fo:line-height="105%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="19pt" fo:color="#345c9d"/>
    </style:style>
    <style:style style:name="CellText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Footer" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.28cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Instruction" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.42cm" fo:margin-bottom="0.35cm" fo:line-height="150%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:font-weight="bold" fo:color="#000000"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout1">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-top="2.2cm" fo:margin-bottom="1.7cm" fo:margin-left="2.5cm" fo:margin-right="2.5cm"/>
    </style:page-layout>
    <style:style style:name="GridTable" style:family="table">
      <style:table-properties style:width="16cm" table:align="left" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="GridCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #222222" fo:padding="0.12cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="ColumnWideLabel" style:family="table-column">
      <style:table-column-properties style:column-width="5.2cm"/>
    </style:style>
    <style:style style:name="ColumnWideInput" style:family="table-column">
      <style:table-column-properties style:column-width="10.8cm"/>
    </style:style>
    <style:style style:name="ColumnHalf" style:family="table-column">
      <style:table-column-properties style:column-width="8cm"/>
    </style:style>
    <style:style style:name="ColumnDev1" style:family="table-column">
      <style:table-column-properties style:column-width="4.2cm"/>
    </style:style>
    <style:style style:name="ColumnDev2" style:family="table-column">
      <style:table-column-properties style:column-width="2.9cm"/>
    </style:style>
    <style:style style:name="ColumnDev3" style:family="table-column">
      <style:table-column-properties style:column-width="5.2cm"/>
    </style:style>
    <style:style style:name="ColumnDev4" style:family="table-column">
      <style:table-column-properties style:column-width="3.7cm"/>
    </style:style>
    <style:style style:name="RowShort" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.66cm"/>
    </style:style>
    <style:style style:name="RowMedium" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.86cm"/>
    </style:style>
    <style:style style:name="RowTall" style:family="table-row">
      <style:table-row-properties style:min-row-height="1.12cm"/>
    </style:style>
    <style:style style:name="RowDevHeader" style:family="table-row">
      <style:table-row-properties style:min-row-height="3.05cm"/>
    </style:style>
    <style:style style:name="RowDev" style:family="table-row">
      <style:table-row-properties style:min-row-height="1.55cm"/>
    </style:style>
    <style:style style:name="RowSignature" style:family="table-row">
      <style:table-row-properties style:min-row-height="1.45cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout1"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Logo">East Sussex</text:p>
      <text:p text:style-name="LogoSub">County Council</text:p>
      <text:p text:style-name="Title">The East Sussex Integrated Progress Review Part 2 summary.</text:p>
      <text:p text:style-name="Subtitle">(For settings using online learning journeys to complete a progress check at age two)</text:p>

      <text:p text:style-name="Section">Child and family information</text:p>
      <table:table table:name="ChildFamily" table:style-name="GridTable">
        <table:table-column table:style-name="ColumnWideLabel"/>
        <table:table-column table:style-name="ColumnWideInput"/>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">Name of Child</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">Date of Birth</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">Postcode</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">Parents or Carers Names</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">Home language</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
      </table:table>

      <text:p text:style-name="SectionLargeGap">Early Education Information</text:p>
      <table:table table:name="EarlyEducation" table:style-name="GridTable">
        <table:table-column table:style-name="ColumnWideLabel"/>
        <table:table-column table:style-name="ColumnWideInput"/>
        <table:table-row table:style-name="RowMedium">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">Name of early years setting</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row table:style-name="RowMedium">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">Any other setting attended</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row table:style-name="RowMedium">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">Number of hours per week at setting.</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row table:style-name="RowMedium">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">Name of the person completing the form</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
      </table:table>

      <text:p text:style-name="Section">Support already in place from other professionals or agencies/referrals made (if applicable).</text:p>
      <table:table table:name="SupportReferrals" table:style-name="GridTable">
        <table:table-column table:style-name="ColumnHalf"/>
        <table:table-column table:style-name="ColumnHalf"/>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">Name</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">Agency</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowTall"><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/></table:table-row>
        <table:table-row table:style-name="RowTall"><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/></table:table-row>
        <table:table-row table:style-name="RowTall"><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/></table:table-row>
        <table:table-row table:style-name="RowTall"><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Footer">Page 1 of 2        Version 2, updated July25        eastsussex.gov.uk</text:p>

      <text:p text:style-name="Page2Start">Child’s learning and development.</text:p>
      <table:table table:name="LearningDevelopment" table:style-name="GridTable">
        <table:table-column table:style-name="ColumnDev1"/>
        <table:table-column table:style-name="ColumnDev2"/>
        <table:table-column table:style-name="ColumnDev3"/>
        <table:table-column table:style-name="ColumnDev4"/>
        <table:table-row table:style-name="RowDevHeader">
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">Is the child ‘on track’ or is additional support in place?</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">Brief overview of strategies being used if applicable or specifics of referrals made.</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">Is further support needed from HV team?</text:p><text:p text:style-name="CellText"><text:span text:style-name="BlueText">Yes/No</text:span></text:p><text:p text:style-name="CellText">Please specify support required.</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowDev">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">Personal, social and emotional development</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row table:style-name="RowDev">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">Communication and language</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row table:style-name="RowDev">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">Physical development</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/>
        </table:table-row>
      </table:table>

      <text:p text:style-name="Instruction">Please ensure that you have parent/carer permission to share this information with the Health Visiting team – see the document Important Information for Completing Part 2</text:p>
      <text:p text:style-name="Section">Parent or Carer Signatures</text:p>
      <table:table table:name="Signatures" table:style-name="GridTable">
        <table:table-column table:style-name="ColumnHalf"/>
        <table:table-column table:style-name="ColumnHalf"/>
        <table:table-row table:style-name="RowSignature">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">Name</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row table:style-name="RowSignature">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">Signature (or state where this held).</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row table:style-name="RowShort">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">Date</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Footer">Page 2 of 2        Version 2, updated July25        eastsussex.gov.uk</text:p>
    </office:text>
  </office:body>
</office:document>