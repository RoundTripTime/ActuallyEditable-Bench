<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:text-properties fo:font-family="Arial" fo:font-size="12pt"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:default-style>
    <style:style style:name="Logo" style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="14pt" fo:font-weight="bold" fo:color="#1E536D"/>
    </style:style>
    <style:style style:name="LogoSub" style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%" fo:margin-bottom="0.45cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:color="#1E536D"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:line-height="110%" fo:margin-bottom="0.08cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="18pt" fo:color="#4472C4"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:line-height="110%" fo:margin-bottom="0.55cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="16pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:line-height="110%" fo:margin-top="0.45cm" fo:margin-bottom="0.08cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="16pt" fo:color="#2F5597"/>
    </style:style>
    <style:style style:name="SectionTight" style:family="paragraph">
      <style:paragraph-properties fo:line-height="110%" fo:margin-top="0.35cm" fo:margin-bottom="0.08cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="16pt" fo:color="#2F5597"/>
    </style:style>
    <style:style style:name="Page2Title" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:line-height="110%" fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="16pt" fo:color="#2F5597"/>
    </style:style>
    <style:style style:name="Instruction" style:family="paragraph">
      <style:paragraph-properties fo:line-height="180%" fo:margin-top="0.35cm" fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="12pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Footer" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.55cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="2.54cm" fo:margin-right="2.54cm" fo:margin-top="2.54cm" fo:margin-bottom="2.54cm"/>
    </style:page-layout>
    <style:style style:name="InlineBlue" style:family="text">
      <style:text-properties fo:color="#2F5597"/>
    </style:style>
    <style:style style:name="TableWide" style:family="table">
      <style:table-properties style:width="16cm" table:align="left"/>
    </style:style>
    <style:style style:name="TableDevelopment" style:family="table">
      <style:table-properties style:width="16cm" table:align="left"/>
    </style:style>
    <style:style style:name="ColumnA" style:family="table-column">
      <style:table-column-properties style:column-width="5.2cm"/>
    </style:style>
    <style:style style:name="ColumnB" style:family="table-column">
      <style:table-column-properties style:column-width="10.8cm"/>
    </style:style>
    <style:style style:name="ColumnName" style:family="table-column">
      <style:table-column-properties style:column-width="6.8cm"/>
    </style:style>
    <style:style style:name="ColumnAgency" style:family="table-column">
      <style:table-column-properties style:column-width="9.2cm"/>
    </style:style>
    <style:style style:name="ColumnDev1" style:family="table-column">
      <style:table-column-properties style:column-width="4.3cm"/>
    </style:style>
    <style:style style:name="ColumnDev2" style:family="table-column">
      <style:table-column-properties style:column-width="3cm"/>
    </style:style>
    <style:style style:name="ColumnDev3" style:family="table-column">
      <style:table-column-properties style:column-width="5cm"/>
    </style:style>
    <style:style style:name="ColumnDev4" style:family="table-column">
      <style:table-column-properties style:column-width="3.7cm"/>
    </style:style>
    <style:style style:name="ColumnSigA" style:family="table-column">
      <style:table-column-properties style:column-width="8cm"/>
    </style:style>
    <style:style style:name="ColumnSigB" style:family="table-column">
      <style:table-column-properties style:column-width="8cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.16cm" style:vertical-align="top"/>
      <style:paragraph-properties fo:line-height="110%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="12pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Logo">East Sussex</text:p>
      <text:p text:style-name="LogoSub">County Council</text:p>
      <text:p text:style-name="Title">The East Sussex Integrated Progress Review Part 2<text:line-break/>summary.</text:p>
      <text:p text:style-name="Subtitle">(For settings using online learning journeys to complete a progress<text:line-break/>check at age two)</text:p>
      <text:p text:style-name="Section">Child and family information</text:p>
      <table:table table:name="ChildFamily" table:style-name="TableWide">
        <table:table-column table:style-name="ColumnA"/>
        <table:table-column table:style-name="ColumnB"/>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>Name of Child</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>Date of Birth</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>Postcode</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>Parents or Carers Names</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>Home language</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Section">Early Education Information</text:p>
      <table:table table:name="EarlyEducation" table:style-name="TableWide">
        <table:table-column table:style-name="ColumnA"/>
        <table:table-column table:style-name="ColumnB"/>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>Name of early years<text:line-break/>setting</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>Any other setting<text:line-break/>attended</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>Number of hours per<text:line-break/>week at setting.</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>Name of the person<text:line-break/>completing the form</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p text:style-name="SectionTight">Support already in place from other professionals or<text:line-break/>agencies/referrals made (if applicable).</text:p>
      <table:table table:name="SupportReferrals" table:style-name="TableWide">
        <table:table-column table:style-name="ColumnName"/>
        <table:table-column table:style-name="ColumnAgency"/>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>Name</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>Agency</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Footer">Page 1 of 2<text:tab/>Version 2, updated July25<text:tab/>eastsussex.gov.uk</text:p>
      <text:p text:style-name="Page2Title">Child’s learning and development.</text:p>
      <table:table table:name="LearningDevelopment" table:style-name="TableDevelopment">
        <table:table-column table:style-name="ColumnDev1"/>
        <table:table-column table:style-name="ColumnDev2"/>
        <table:table-column table:style-name="ColumnDev3"/>
        <table:table-column table:style-name="ColumnDev4"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p>Is the child<text:line-break/>‘on track’ or<text:line-break/>is additional<text:line-break/>support in<text:line-break/>place?</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>Brief overview of<text:line-break/>strategies being used if<text:line-break/>applicable or specifics<text:line-break/>of referrals made.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>Is further<text:line-break/>support needed<text:line-break/>from HV team?<text:line-break/><text:span text:style-name="InlineBlue">Yes/No</text:span><text:line-break/>Please specify<text:line-break/>support required.</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>Personal, social and<text:line-break/>emotional<text:line-break/>development</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>Communication and<text:line-break/>language</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>Physical<text:line-break/>development</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Instruction">Please ensure that you have parent/carer permission to share this information<text:line-break/>with the Health Visiting team – see the document Important Information for<text:line-break/>Completing Part 2</text:p>
      <text:p text:style-name="SectionTight">Parent or Carer Signatures</text:p>
      <table:table table:name="ParentCarerSignatures" table:style-name="TableWide">
        <table:table-column table:style-name="ColumnSigA"/>
        <table:table-column table:style-name="ColumnSigB"/>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>Name</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>Signature (or state where this held).</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>Date</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Footer">Page 2 of 2<text:tab/>Version 2, updated July25<text:tab/>eastsussex.gov.uk</text:p>
    </office:text>
  </office:body>
</office:document>