<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="0mm" fo:line-height="100%"/>
      <style:text-properties style:font-name="Noto Serif CJK JP" style:font-name-asian="Noto Serif CJK JP" fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Grid" style:family="table">
      <style:table-properties style:width="174mm" table:align="center"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.8mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="PlainCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="DottedCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt dotted #000000" fo:padding="0.2mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="LabelPara" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="RightPara" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="right"/>
    </style:style>
    <style:style style:name="CenterPara" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="TitlePara" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="center" fo:margin-bottom="1mm"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="SmallPara" style:family="paragraph" style:parent-style-name="Body">
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="SectionPara" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:margin-top="5mm" fo:margin-bottom="1mm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="PageBreakPara" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:break-before="page" fo:line-height="100%"/>
    </style:style>
    <style:style style:name="VerticalCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.5mm" style:vertical-align="middle" style:writing-mode="tb-rl"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" fo:margin-top="15mm" fo:margin-bottom="15mm" fo:margin-left="18mm" fo:margin-right="18mm"/>
    </style:page-layout>
    <style:style style:name="IDTable" style:family="table">
      <style:table-properties style:width="174mm" table:align="center"/>
    </style:style>
    <style:style style:name="IncomeTable" style:family="table">
      <style:table-properties style:width="174mm" table:align="center"/>
    </style:style>
    <style:style style:name="AssetTable" style:family="table">
      <style:table-properties style:width="174mm" table:align="center"/>
    </style:style>
    <style:style style:name="BoxTable" style:family="table">
      <style:table-properties style:width="174mm" table:align="center"/>
    </style:style>
    <style:style style:name="DateTable" style:family="table">
      <style:table-properties style:width="174mm" table:align="center"/>
    </style:style>
    <style:style style:name="IDCol1" style:family="table-column">
      <style:table-column-properties style:column-width="43.8mm"/>
    </style:style>
    <style:style style:name="IDCol2" style:family="table-column">
      <style:table-column-properties style:column-width="43.8mm"/>
    </style:style>
    <style:style style:name="IDCol3" style:family="table-column">
      <style:table-column-properties style:column-width="39.7mm"/>
    </style:style>
    <style:style style:name="IDDigit" style:family="table-column">
      <style:table-column-properties style:column-width="4.67mm"/>
    </style:style>
    <style:style style:name="IncomeCol1" style:family="table-column">
      <style:table-column-properties style:column-width="7.5mm"/>
    </style:style>
    <style:style style:name="IncomeCol2" style:family="table-column">
      <style:table-column-properties style:column-width="35mm"/>
    </style:style>
    <style:style style:name="IncomeCol3" style:family="table-column">
      <style:table-column-properties style:column-width="44mm"/>
    </style:style>
    <style:style style:name="IncomeCol4" style:family="table-column">
      <style:table-column-properties style:column-width="43mm"/>
    </style:style>
    <style:style style:name="IncomeCol5" style:family="table-column">
      <style:table-column-properties style:column-width="44.5mm"/>
    </style:style>
    <style:style style:name="AssetCol1" style:family="table-column">
      <style:table-column-properties style:column-width="48mm"/>
    </style:style>
    <style:style style:name="AssetCol2" style:family="table-column">
      <style:table-column-properties style:column-width="126mm"/>
    </style:style>
    <style:style style:name="DateCol1" style:family="table-column">
      <style:table-column-properties style:column-width="105mm"/>
    </style:style>
    <style:style style:name="DateCol2" style:family="table-column">
      <style:table-column-properties style:column-width="69mm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="SmallPara">（条例22条第2項及び第23条第3項による証明する書類）</text:p>
      <text:p text:style-name="TitlePara">現　況　申　告　書</text:p>
      <table:table table:style-name="DateTable">
        <table:table-column table:style-name="DateCol1"/>
        <table:table-column table:style-name="DateCol2"/>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="Body">千代田区長　様</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="RightPara">申請日：　　　　年　　月　　日</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <table:table table:style-name="IDTable">
        <table:table-column table:style-name="IDCol1"/>
        <table:table-column table:style-name="IDCol2"/>
        <table:table-column table:style-name="IDCol3"/>
        <table:table-column table:style-name="IDDigit" table:number-columns-repeated="10"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="LabelPara">被　保　険　者　氏　名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="LabelPara">被　保　険　者　番　号</text:p></table:table-cell>
          <table:table-cell table:style-name="DottedCell"/>
          <table:table-cell table:style-name="DottedCell"/>
          <table:table-cell table:style-name="DottedCell"/>
          <table:table-cell table:style-name="DottedCell"/>
          <table:table-cell table:style-name="DottedCell"/>
          <table:table-cell table:style-name="DottedCell"/>
          <table:table-cell table:style-name="DottedCell"/>
          <table:table-cell table:style-name="DottedCell"/>
          <table:table-cell table:style-name="DottedCell"/>
          <table:table-cell table:style-name="DottedCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="SectionPara">１　世帯の収入の状況</text:p>
      <table:table table:style-name="IncomeTable">
        <table:table-column table:style-name="IncomeCol1"/>
        <table:table-column table:style-name="IncomeCol2"/>
        <table:table-column table:style-name="IncomeCol3"/>
        <table:table-column table:style-name="IncomeCol4"/>
        <table:table-column table:style-name="IncomeCol5"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p/></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="LabelPara">被　保　険　者　本　人</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="LabelPara">世　帯　員　氏　名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="LabelPara">世　帯　員　氏　名</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="VerticalCell" table:number-rows-spanned="5"><text:p text:style-name="LabelPara">直前３ヶ月の平均収入額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>年　金　収　入</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>給与・事業収入等</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>仕　送　り</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>そ　の　他</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="LabelPara">収入合計（Ⅰ）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="VerticalCell" table:number-rows-spanned="5"><text:p text:style-name="LabelPara">直前３ヶ月の必要経費</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>交　通　費</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>介護保険料・健康保険料</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>住民税・所得税・固定資産税等</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="LabelPara">その他</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="LabelPara">経費合計（Ⅱ）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>実収入額（Ⅰ）－（Ⅱ）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="SmallPara">※　年金収入は２ヶ月に１度支給されますので、１回の受給額の１／２の額を記入してください。</text:p>
      <text:p text:style-name="SmallPara">※　収入金額がわかる給与明細書・預金通帳等の写し等を添付してください。</text:p>
      <text:p text:style-name="SmallPara">※　支払った健康保険料・税金等の領収書を添付してください。</text:p>
      <text:p text:style-name="SmallPara">※　領収書等は直近３ヶ月分です。</text:p>
      <text:p text:style-name="SectionPara">２　無収入の申告（上記１で世帯の収入がない場合は、下記の当てはまる番号に○をつけてください。）</text:p>
      <table:table table:style-name="BoxTable">
        <table:table-column table:style-name="AssetCol2"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell">
            <text:p>①　勤務先を失業　　②　事業の休・廃止　　③　長期療養又は入院等</text:p>
            <text:p>④　その他具体的に記入してください。</text:p>
            <text:p/>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="SectionPara">３　活用できる資産等の状況（世帯の資産の保有状況）</text:p>
      <table:table table:style-name="AssetTable">
        <table:table-column table:style-name="AssetCol1"/>
        <table:table-column table:style-name="AssetCol2"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>１　居住用の土地</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>①　保有している　　　・　　②　保有していない</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>２　居住用以外の不動産</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>①　保有している　　　・　　②　保有していない</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>３　現　　金</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>４　世帯の預貯金の額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageBreakPara"/>
      <table:table table:style-name="AssetTable">
        <table:table-column table:style-name="AssetCol1"/>
        <table:table-column table:style-name="AssetCol2"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>５　有価証券・生命保険等</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RightPara">円</text:p></table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>