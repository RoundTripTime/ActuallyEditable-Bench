<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="9pt" style:font-name="serif"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="9pt" style:font-name="serif"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="9pt" style:font-name="serif"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="16pt" style:font-name="serif"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.12cm" fo:margin-bottom="0.08cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="11pt" style:font-name="serif"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="8.5pt" style:font-name="serif"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="0.1cm"/>
      <style:text-properties fo:font-size="1pt" style:font-name="serif"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellTight" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.03cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Col" style:family="table-column">
      <style:table-column-properties style:column-width="1cm"/>
    </style:style>
    <style:style style:name="Grid" style:family="table">
      <style:table-properties style:width="18.7cm" table:align="center"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.5cm" fo:margin-bottom="1.5cm" fo:margin-left="1.7cm" fo:margin-right="1.7cm" style:print-orientation="portrait"/>
    </style:page-layout>
    <style:style style:name="C01" style:family="table-column"><style:table-column-properties style:column-width="1cm"/></style:style>
    <style:style style:name="C02" style:family="table-column"><style:table-column-properties style:column-width="4.2cm"/></style:style>
    <style:style style:name="C03" style:family="table-column"><style:table-column-properties style:column-width="4.5cm"/></style:style>
    <style:style style:name="C04" style:family="table-column"><style:table-column-properties style:column-width="4.5cm"/></style:style>
    <style:style style:name="C05" style:family="table-column"><style:table-column-properties style:column-width="4.5cm"/></style:style>
    <style:style style:name="TopGrid" style:family="table"><style:table-properties style:width="18.7cm" table:align="center"/></style:style>
    <style:style style:name="IncomeGrid" style:family="table"><style:table-properties style:width="18.7cm" table:align="center"/></style:style>
    <style:style style:name="AssetGrid" style:family="table"><style:table-properties style:width="18.7cm" table:align="center"/></style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Body">（条例22条第2項及び第23条第3項による証明する書類）</text:p>
      <text:p text:style-name="Title">現　況　申　告　書</text:p>
      <text:p text:style-name="Body">千代田区長　様　　　　　　　　　　　　　　　　　　　　　　　　　申請日：　　　　　　年　　　月</text:p>
      <text:p text:style-name="Body">日</text:p>
      <table:table table:name="Applicant" table:style-name="TopGrid">
        <table:table-column table:style-name="C02"/>
        <table:table-column table:style-name="C03"/>
        <table:table-column table:style-name="C04"/>
        <table:table-column table:style-name="C05"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">被　保　険　者　氏　名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"></text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">被　保　険　者　番　号</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"></text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Section">１　世帯の収入の状況</text:p>
      <table:table table:name="Income" table:style-name="IncomeGrid">
        <table:table-column table:style-name="C01"/>
        <table:table-column table:style-name="C02"/>
        <table:table-column table:style-name="C03"/>
        <table:table-column table:style-name="C04"/>
        <table:table-column table:style-name="C05"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Body"></text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">被　保　険　者　本　人</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">世　帯　員　氏　名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">世　帯　員　氏　名</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="5"><text:p text:style-name="Center">直<text:line-break/>前<text:line-break/>３<text:line-break/>ヶ<text:line-break/>月<text:line-break/>の<text:line-break/>平<text:line-break/>均<text:line-break/>収<text:line-break/>入<text:line-break/>額</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Center">年　金　収　入</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Center">給与・事業収入等</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Center">仕　　送　　り</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Center">そ　　の　　他</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Center">収入合計（Ⅰ）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="5"><text:p text:style-name="Center">直<text:line-break/>前<text:line-break/>３<text:line-break/>ヶ<text:line-break/>月<text:line-break/>の<text:line-break/>必<text:line-break/>要<text:line-break/>経<text:line-break/>費</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Center">交　　通　　費</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Center">介　護　保　険　料・<text:line-break/>健　康　保　険　料</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Center">住民税・所得税・<text:line-break/>固定資産税等</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Center">その他</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellTight"><text:p text:style-name="Center">経費合計（Ⅱ）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellTight" table:number-columns-spanned="2"><text:p text:style-name="Center">実　収　入　額　（Ⅰ）　－<text:line-break/>（Ⅱ）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">円</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Small">※　年金収入は２ヶ月に１度支給されますので、１回の受給額の１／２の額を記入してください。</text:p>
      <text:p text:style-name="Small">※　収入金額がわかる給与明細書・預金通帳等の写し等を添付してください。</text:p>
      <text:p text:style-name="Small">※　支払った健康保険料・税金等の領収書を添付してください。</text:p>
      <text:p text:style-name="Small">※　領収書等は直近３ヶ月分です。</text:p>
      <text:p text:style-name="Section">２　無収入の申告（上記１で世帯の収入がない場合は、下記の当てはまる番号に○をつけてくださ<text:line-break/>い。）</text:p>
      <table:table table:name="NoIncome" table:style-name="AssetGrid">
        <table:table-column table:style-name="C02"/>
        <table:table-column table:style-name="C03"/>
        <table:table-column table:style-name="C04"/>
        <table:table-column table:style-name="C05"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4">
            <text:p text:style-name="Body">①　勤務先を失業　　②　事業の休・廃止　　③　長期療養又は入院等</text:p>
            <text:p text:style-name="Body">④　その他具体的に記入してください。</text:p>
            <text:p text:style-name="Body">［　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　］</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Section">３　活用できる資産等の状況（世帯の資産の保有状況）</text:p>
      <table:table table:name="Assets" table:style-name="AssetGrid">
        <table:table-column table:style-name="C02"/>
        <table:table-column table:style-name="C03"/>
        <table:table-column table:style-name="C04"/>
        <table:table-column table:style-name="C05"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">１　居住用の土地</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Body">①　保有している　　　・　　　②　保有していない</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">２　居住用以外の不動産</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Body">①　保有している　　　・　　　②　保有していない</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">３　現　　金</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Body">円</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">４　世帯の預貯金の額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Body">円</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageStart"></text:p>
      <table:table table:name="AssetsContinued" table:style-name="AssetGrid">
        <table:table-column table:style-name="C02"/>
        <table:table-column table:style-name="C03"/>
        <table:table-column table:style-name="C04"/>
        <table:table-column table:style-name="C05"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">５　有価証券・生命保険等</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Body">円</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>