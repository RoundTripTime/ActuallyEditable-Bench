        <table:table-column table:style-name="Column1"/>
        <table:table-row>
          <table:table-cell table:style-name="CellBorder">
            <text:p text:style-name="CellLeft">上記内容の公表の可否（公表には、ホームページ等への掲載を含みます。）</text:p>
