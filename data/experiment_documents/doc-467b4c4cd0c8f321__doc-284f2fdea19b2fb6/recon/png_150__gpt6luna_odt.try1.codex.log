          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p style:text-align="center">地　　目</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2"><text:p style:text-align="center">面積（㎡）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p style:text-align="center">所有権以外の使用収益権が設定されている場合</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2"><text:p style:text-align="center">市街化区域・市街化調整区域・その他区域の別</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p style:text-align="center">登記簿</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p style:text-align="center">現況</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p style:text-align="center">権利の種類</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p style:text-align="center">権利者の氏名又は名称</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
