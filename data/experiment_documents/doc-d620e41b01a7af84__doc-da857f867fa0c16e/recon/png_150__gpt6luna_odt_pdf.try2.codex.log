          <table:table-cell table:style-name="Cell"><text:p text:style-name="PLabel">성 명<br/>(Full Name)</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="Cell"/>
          <table:covered-table-cell table:style-name="Cell"/><table:covered-table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="PLabel">연락처<br/>(Phone No.)</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="PLabel">외국인과의 관계<br/>(Relationship)</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="5" table:style-name="Cell"><text:p text:style-name="PLeft">[ ]　친척　(Relative)　　[ ]　고용주　(Employer)　　[ ]　기타 (　　　　　　)</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="Cell"/><table:covered-table-cell table:style-name="Cell"/><table:covered-table-cell table:style-name="Cell"/><table:covered-table-cell table:style-name="Cell"/>
