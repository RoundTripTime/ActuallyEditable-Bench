          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">印</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">電話番号</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
