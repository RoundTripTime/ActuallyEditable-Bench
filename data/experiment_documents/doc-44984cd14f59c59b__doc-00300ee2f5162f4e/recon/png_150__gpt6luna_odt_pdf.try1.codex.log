          <table:table-cell table:style-name="Cell"><text:p>個人番号</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>□　□　□　□　□　□　□　□　□　□　□　□</text:p></table:table-cell>
        </table:table-row>
