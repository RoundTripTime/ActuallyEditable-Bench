          <table:table-cell table:style-name="CenteredCell"><text:p>□本人□委託</text:p></table:table-cell>
          <table:table-cell table:style-name="EntryCell"><text:p>□配偶</text:p><text:p>□有行為能力之直系血親</text:p><text:p>□其他區分所有權人</text:p><text:p>□承租人</text:p></table:table-cell>
