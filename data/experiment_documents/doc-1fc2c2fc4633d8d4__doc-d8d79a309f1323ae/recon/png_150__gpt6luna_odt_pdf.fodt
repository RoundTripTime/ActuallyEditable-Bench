  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="2.8cm" fo:margin-right="2.8cm" fo:margin-top="2.4cm" fo:margin-bottom="2.2cm"/>
    </style:page-layout>
