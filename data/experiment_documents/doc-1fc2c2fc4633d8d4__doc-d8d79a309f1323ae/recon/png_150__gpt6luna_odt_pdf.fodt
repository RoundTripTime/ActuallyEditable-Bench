      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="C1" style:family="table-column"><style:table-column-properties style:column-width="1.06cm"/></style:style>
    <style:style style:name="C2" style:family="table-column"><style:table-column-properties style:column-width="2.01cm"/></style:style>
    <style:style style:name="C3" style:family="table-column"><style:table-column-properties style:column-width="2.01cm"/></style:style>
    <style:style style:name="C4" style:family="table-column"><style:table-column-properties style:column-width="3.01cm"/></style:style>
    <style:style style:name="C5" style:family="table-column"><style:table-column-properties style:column-width="4.27cm"/></style:style>
    <style:style style:name="C6" style:family="table-column"><style:table-column-properties style:column-width="1.75cm"/></style:style>
    <style:style style:name="C7" style:family="table-column"><style:table-column-properties style:column-width="1.10cm"/></style:style>
    <style:style style:name="InstrBox" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0.35cm"/>
    </style:style>
    <style:style style:name="InstrTitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.28cm"/>
      <style:text-properties fo:font-size="14pt" fo:font-weight="bold"/>
