      <table:table table:name="編頁續">
        <table:table-column table:style-name="StripColumn"/>
        <table:table-row>
          <table:table-cell table:style-name="StripCell">
            <text:p text:style-name="BoxLine">　　依序號排列編頁。</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Page3Space"/>
      <text:p text:style-name="Footer">(民)工公寓(區)01-(民)表五-2/2</text:p>
      <text:p text:style-name="Small">申請案編碼：5073009 公告期限：9天</text:p>
