<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="http://www.w3.org/1999/XSL/Format" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="1pt"/>
    </style:style>
    <style:style style:name="AnnexHead" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0.8cm" fo:margin-bottom="0.45cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="MainTitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.15cm" fo:margin-bottom="0.55cm" fo:line-height="105%"/>
      <style:text-properties fo:font-size="19pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Footer" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.35cm" fo:margin-bottom="0.25cm"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="BoxLine" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="108%"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="BoxHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.12cm" fo:margin-bottom="0.15cm"/>
      <style:text-properties fo:font-size="13pt" fo:font-weight="bold"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout" style:page-usage="all">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="1.35cm" fo:margin-bottom="1.3cm" fo:margin-left="1.5cm" fo:margin-right="1.5cm"/>
    </style:page-layout>
    <style:style style:name="HeadCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="105%"/>
      <style:text-properties fo:font-size="10pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="GridCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="9.5pt"/>
    </style:style>
    <style:style style:name="GridCenter" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.05cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="9.5pt"/>
    </style:style>
    <style:style style:name="GridTotal" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="105%"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="MainColumn" style:family="table-column">
      <style:table-column-properties style:column-width="0.95cm"/>
    </style:style>
    <style:style style:name="NameColumn" style:family="table-column">
      <style:table-column-properties style:column-width="2.15cm"/>
    </style:style>
    <style:style style:name="SealColumn" style:family="table-column">
      <style:table-column-properties style:column-width="2.05cm"/>
    </style:style>
    <style:style style:name="ProxyColumn" style:family="table-column">
      <style:table-column-properties style:column-width="3.0cm"/>
    </style:style>
    <style:style style:name="RelationColumn" style:family="table-column">
      <style:table-column-properties style:column-width="5.05cm"/>
    </style:style>
    <style:style style:name="RatioColumn" style:family="table-column">
      <style:table-column-properties style:column-width="1.65cm"/>
    </style:style>
    <style:style style:name="NoteColumn" style:family="table-column">
      <style:table-column-properties style:column-width="1.3cm"/>
    </style:style>
    <style:style style:name="BoxColumn" style:family="table-column">
      <style:table-column-properties style:column-width="17.9cm"/>
    </style:style>
    <style:style style:name="BoxCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.7pt solid #000000" fo:padding="0.35cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="StripCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.7pt solid #000000" fo:padding="0.06cm 0.4cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="StripColumn" style:family="table-column">
      <style:table-column-properties style:column-width="15.8cm"/>
    </style:style>
    <style:style style:name="Page3Space" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="22cm" fo:margin-bottom="0cm" fo:line-height="1pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="AnnexHead">附件三之一：區分所有權人會議出席人員名冊（簽到簿）</text:p>
      <text:p text:style-name="MainTitle">＿＿公寓大廈(社區)區分所有權人會議出席人員名冊（簽到簿）</text:p>
      <text:p text:style-name="Right">會議日期：　年　月　日</text:p>
