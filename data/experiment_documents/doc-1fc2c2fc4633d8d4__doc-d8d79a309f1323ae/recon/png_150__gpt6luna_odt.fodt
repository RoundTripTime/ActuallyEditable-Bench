          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCenter"><text:p>□本人□委託</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p>□配偶</text:p><text:p>□有行為能力之直系血親</text:p><text:p>□其他區分所有權人</text:p><text:p>□承租人</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridTotal" table:number-columns-spanned="2"><text:p>區分所有權人</text:p><text:p>比例合計</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="GridTotal"/>
          <table:table-cell table:style-name="GridTotal"/>
          <table:table-cell table:style-name="GridTotal"><text:p>%</text:p></table:table-cell>
          <table:table-cell table:style-name="GridTotal"><text:p>區分所有權比例合計</text:p></table:table-cell>
