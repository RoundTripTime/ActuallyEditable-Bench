<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Title" style:family="paragraph" style:master-page-name="Default">
      <style:paragraph-properties fo:margin="0cm" fo:margin-bottom="0.4cm" fo:line-height="1.05"/>
      <style:text-properties fo:font-family="Noto Sans CJK TC" style:font-family-asian="Noto Sans CJK TC" fo:font-size="20pt" style:font-size-asian="20pt"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph" style:master-page-name="Default">
      <style:paragraph-properties fo:break-before="page" fo:margin="0cm" fo:line-height="0.01cm"/>
      <style:text-properties fo:font-family="Noto Sans CJK TC" style:font-family-asian="Noto Sans CJK TC" fo:font-size="1pt" style:font-size-asian="1pt"/>
    </style:style>
    <style:style style:name="HeadingCellP" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="1.05"/>
      <style:text-properties fo:font-family="Noto Sans CJK TC" style:font-family-asian="Noto Sans CJK TC" fo:font-size="13pt" style:font-size-asian="13pt"/>
    </style:style>
    <style:style style:name="BodyCellP" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="1.05"/>
      <style:text-properties fo:font-family="Noto Sans CJK TC" style:font-family-asian="Noto Sans CJK TC" fo:font-size="13pt" style:font-size-asian="13pt"/>
    </style:style>
    <style:style style:name="SignP" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="1.05"/>
      <style:text-properties fo:font-family="Noto Sans CJK TC" style:font-family-asian="Noto Sans CJK TC" fo:font-size="14pt" style:font-size-asian="14pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="29.7cm" fo:page-height="21cm" style:print-orientation="landscape" fo:margin-left="1.5cm" fo:margin-right="1.5cm" fo:margin-top="2.3cm" fo:margin-bottom="1.5cm"/>
    </style:page-layout>
    <style:style style:name="Grid" style:family="table">
      <style:table-properties style:width="26.7cm" table:align="left" table:border-model="collapsing" style:may-break-between-rows="false"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="3.25cm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="1.9cm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="3.2cm"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties style:column-width="2.9cm"/>
    </style:style>
    <style:style style:name="Col5" style:family="table-column">
      <style:table-column-properties style:column-width="3.5cm"/>
    </style:style>
    <style:style style:name="Col6" style:family="table-column">
      <style:table-column-properties style:column-width="4.2cm"/>
    </style:style>
    <style:style style:name="Col7" style:family="table-column">
      <style:table-column-properties style:column-width="7.75cm"/>
    </style:style>
    <style:style style:name="HeadRow" style:family="table-row">
      <style:table-row-properties style:row-height="3cm"/>
    </style:style>
    <style:style style:name="DataRow" style:family="table-row">
      <style:table-row-properties style:row-height="13cm"/>
    </style:style>
    <style:style style:name="ShortRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.1cm"/>
    </style:style>
    <style:style style:name="GridCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="GridBottomCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="SignatureCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="SignRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.8cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title" fo:break-before="page">( 機關全銜 ) 107 年度聘僱計畫檢討報告表</text:p>
      <table:table table:name="FormPage1" table:style-name="Grid">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-column table:style-name="Col5"/>
        <table:table-column table:style-name="Col6"/>
        <table:table-column table:style-name="Col7"/>
        <table:table-row table:style-name="HeadRow">
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="HeadingCellP">工作內容</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="HeadingCellP">聘僱計<text:line-break/>畫初次<text:line-break/>日期</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="HeadingCellP">人員姓名及<text:line-break/>初次聘<text:line-break/>（僱）用日<text:line-break/>期</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="HeadingCellP">業務性質</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="HeadingCellP">辦理經常性<text:line-break/>業務原因</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="HeadingCellP">聘僱用人數年限<text:line-break/>超過<text:line-break/>5%5 年原因</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="HeadingCellP">研提改進措施</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="GridBottomCell"/>
          <table:table-cell table:style-name="GridBottomCell"/>
          <table:table-cell table:style-name="GridBottomCell"/>
          <table:table-cell table:style-name="GridBottomCell"><text:p text:style-name="BodyCellP">( ) 經常性</text:p></table:table-cell>
          <table:table-cell table:style-name="GridBottomCell"/>
          <table:table-cell table:style-name="GridBottomCell"/>
          <table:table-cell table:style-name="GridBottomCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageStart"/>
      <table:table table:name="FormPage2Continuation" table:style-name="Grid">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-column table:style-name="Col5"/>
        <table:table-column table:style-name="Col6"/>
        <table:table-column table:style-name="Col7"/>
        <table:table-row table:style-name="ShortRow">
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="BodyCellP">( ) 臨時性</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
      </table:table>
      <table:table table:name="Signatures" table:style-name="Grid">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-column table:style-name="Col5"/>
        <table:table-column table:style-name="Col6"/>
        <table:table-column table:style-name="Col7"/>
        <table:table-row table:style-name="SignRow">
          <table:table-cell table:style-name="SignatureCell"><text:p text:style-name="SignP">承辦人：</text:p></table:table-cell>
          <table:table-cell table:style-name="SignatureCell"><text:p text:style-name="SignP">單位主管：</text:p></table:table-cell>
          <table:table-cell table:style-name="SignatureCell"><text:p text:style-name="SignP">機關首長：</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>