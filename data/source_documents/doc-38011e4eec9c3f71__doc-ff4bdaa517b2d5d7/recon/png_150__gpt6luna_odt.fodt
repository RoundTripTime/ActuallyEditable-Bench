<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.35cm" fo:margin-bottom="1.05cm"/>
      <style:text-properties fo:font-size="17pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="SmallGap" style:family="paragraph">
      <style:paragraph-properties fo:line-height="0.45cm"/>
    </style:style>
    <style:style style:name="CellP" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="1.6cm"/>
    </style:style>
    <style:style style:name="StampP" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="0.65cm" fo:text-align="center"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.8cm" fo:margin-bottom="1.8cm" fo:margin-left="2.1cm" fo:margin-right="2.1cm"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="16.8cm" table:align="center"/>
    </style:style>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="3.5cm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="10cm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="3.3cm"/>
    </style:style>
    <style:style style:name="StampColA" style:family="table-column">
      <style:table-column-properties style:column-width="3.8cm"/>
    </style:style>
    <style:style style:name="StampColB" style:family="table-column">
      <style:table-column-properties style:column-width="13cm"/>
    </style:style>
    <style:style style:name="GridCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="LineCell" style:family="table-cell">
      <style:table-cell-properties fo:border-bottom="0.5pt solid #555555"/>
    </style:style>
    <style:style style:name="StampLeft" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.1cm" style:vertical-align="middle" fo:background-color="#eeeeee"/>
    </style:style>
    <style:style style:name="StampCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.1cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="StampBody" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.1cm" style:vertical-align="top"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Right">令和　　年　　月　　日</text:p>
      <text:p text:style-name="P">（提出先）</text:p>
      <text:p text:style-name="P">横浜市長</text:p>
      <text:p text:style-name="Title">是　正　報　告　書</text:p>
      <text:p text:style-name="Right">住所</text:p>
      <text:p text:style-name="Right">氏名</text:p>
      <text:p text:style-name="Right">電話</text:p>
      <text:p text:style-name="P">次のとおり是正しましたので報告します。</text:p>
      <text:p text:style-name="SmallGap"/>
      <text:p text:style-name="P">１　所在地</text:p>
      <table:table table:name="所在地記入欄" table:style-name="FormTable">
        <table:table-column table:style-name="ColB"/>
        <table:table-row>
          <table:table-cell table:style-name="LineCell"><text:p text:style-name="CellP"/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="SmallGap"/>
      <text:p text:style-name="P">２　是正方法等</text:p>
      <table:table table:name="是正方法等" table:style-name="FormTable">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="Center">是正箇所</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="Center">是正方法</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="Center">条文</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellP"/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellP"/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellP"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellP"/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellP"/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellP"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellP"/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellP"/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellP"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellP"/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellP"/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellP"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellP"/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellP"/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellP"/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="P">※　法：建築基準法、令：建築基準法施行令、市：横浜市建築基準条例、盛：宅地造成及び特定盛土等規制法、都：都市計画法</text:p>
      <text:p text:style-name="SmallGap"/>
      <text:p text:style-name="P">３　是正年月日</text:p>
      <text:p text:style-name="P">是正工事完了日　　：　　令和　　年　　月　　日</text:p>

      <text:p text:style-name="PageStart">４　是正に係る設計者・施工者</text:p>
      <text:p text:style-name="SmallGap"/>
      <text:p text:style-name="P">　（１）設計者</text:p>
      <text:p text:style-name="P">　　　　氏　　名：</text:p>
      <text:p text:style-name="P">　　　　所　在　地：</text:p>
      <text:p text:style-name="P">　　　　電話番号：</text:p>
      <text:p text:style-name="SmallGap"/>
      <text:p text:style-name="P">　（２）工事施工者</text:p>
      <text:p text:style-name="P">　　　　氏　　名：</text:p>
      <text:p text:style-name="P">　　　　所　在　地：</text:p>
      <text:p text:style-name="P">　　　　電話番号：</text:p>
      <text:p text:style-name="SmallGap"/>
      <text:p text:style-name="P">５　添付図書</text:p>
      <text:p text:style-name="P">　□配置図　　□敷地面積求積図　　□床面積求積図　　□各階平面図</text:p>
      <text:p text:style-name="P">　□立面図　　□断面図　　　　　　□敷地断面図　　　□地盤面算定表</text:p>
      <text:p text:style-name="P">　□建具詳細図　　□耐火構造等の構造詳細図　　□設備に関する資料</text:p>
      <text:p text:style-name="P">　□仕上げ表　　□認定書の写し　　□製品カタログ　　□写真　　□工程表</text:p>
      <text:p text:style-name="P">　□その他（　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　）</text:p>
      <text:p text:style-name="SmallGap"/>
      <text:p text:style-name="P">６　特記事項その他</text:p>
      <text:p text:style-name="SmallGap"/>
      <text:p text:style-name="SmallGap"/>
      <text:p text:style-name="SmallGap"/>
      <text:p text:style-name="SmallGap"/>
      <text:p text:style-name="SmallGap"/>
      <table:table table:name="確認欄" table:style-name="FormTable">
        <table:table-column table:style-name="StampColA"/>
        <table:table-column table:style-name="StampColB"/>
        <table:table-row>
          <table:table-cell table:style-name="StampLeft"><text:p text:style-name="StampP">確認欄</text:p></table:table-cell>
          <table:table-cell table:style-name="StampCell"><text:p text:style-name="StampP">建違対第　　号　　令和　　年　　月　　日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:number-columns-spanned="2" table:style-name="StampLeft"><text:p text:style-name="P">市記入欄</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:number-columns-spanned="2" table:style-name="StampBody"><text:p text:style-name="CellP"/></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="P">※　宅地造成及び特定盛土等規制法 22 条第１項については「是正」を「改善」と読み替えます。</text:p>
    </office:text>
  </office:body>
</office:document>