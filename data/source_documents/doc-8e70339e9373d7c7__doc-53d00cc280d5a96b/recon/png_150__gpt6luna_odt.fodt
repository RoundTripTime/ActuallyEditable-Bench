<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:font-size="11pt" fo:margin-top="0mm" fo:margin-bottom="1mm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Centered" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="2mm" fo:margin-bottom="2mm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="SmallNote" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="2mm" fo:margin-top="1mm" fo:margin-bottom="1mm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" fo:margin-left="22mm" fo:margin-right="22mm" fo:margin-top="34mm" fo:margin-bottom="20mm"/>
    </style:page-layout>
    <style:style style:name="OuterTable" style:family="table">
      <style:table-properties style:width="100%"/>
    </style:style>
    <style:style style:name="OuterCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="2mm"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="100%"/>
    </style:style>
    <style:style style:name="BottomTable" style:family="table">
      <style:table-properties style:width="100%"/>
    </style:style>
    <style:style style:name="ColNarrow" style:family="table-column">
      <style:table-column-properties style:column-width="38mm"/>
    </style:style>
    <style:style style:name="ColWide" style:family="table-column">
      <style:table-column-properties style:column-width="122mm"/>
    </style:style>
    <style:style style:name="ColBottomNarrow" style:family="table-column">
      <style:table-column-properties style:column-width="43mm"/>
    </style:style>
    <style:style style:name="ColBottomWide" style:family="table-column">
      <style:table-column-properties style:column-width="117mm"/>
    </style:style>
    <style:style style:name="GridCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="1.5mm"/>
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="GridCellLarge" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="5mm"/>
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="LineCell" style:family="table-cell">
      <style:table-cell-properties fo:border-bottom="0.5pt solid #000000" fo:padding="1mm"/>
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="PlainCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="1mm"/>
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="DottedRule" style:family="paragraph">
      <style:paragraph-properties fo:border-bottom="0.5pt dotted #000000" fo:margin-top="3mm" fo:margin-bottom="3mm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Body">様式第１号（第３条関係）</text:p>
      <table:table table:name="FormFrame" table:style-name="OuterTable">
        <table:table-column table:style-name="ColWide"/>
        <table:table-row>
          <table:table-cell table:style-name="OuterCell">
            <text:p text:style-name="Centered">開　示　請　求　書</text:p>
            <text:p text:style-name="Body" text:align="right">令和　　年　　月　　日</text:p>
            <text:p text:style-name="Body">請求先（実施機関）</text:p>
            <text:p text:style-name="Body">殿</text:p>
            <table:table table:name="ApplicantInfo">
              <table:table-column table:style-name="ColNarrow"/>
              <table:table-column table:style-name="ColWide"/>
              <table:table-row>
                <table:table-cell table:style-name="LineCell"><text:p> </text:p></table:table-cell>
                <table:table-cell table:style-name="LineCell"><text:p>住所</text:p></table:table-cell>
              </table:table-row>
              <table:table-row>
                <table:table-cell table:style-name="PlainCell"><text:p text:style-name="Body">請　求　者</text:p></table:table-cell>
                <table:table-cell table:style-name="LineCell"><text:p>氏　名</text:p></table:table-cell>
              </table:table-row>
              <table:table-row>
                <table:table-cell table:style-name="PlainCell"><text:p> </text:p></table:table-cell>
                <table:table-cell table:style-name="LineCell"><text:p>電話番号</text:p></table:table-cell>
              </table:table-row>
            </table:table>
            <text:p text:style-name="Body">桂川町情報公開条例第６条第１項の規定に基づき、次のとおり行政文書の開示を請求します。</text:p>
            <table:table table:name="RequestDetails" table:style-name="FormTable">
              <table:table-column table:style-name="ColNarrow"/>
              <table:table-column table:style-name="ColWide"/>
              <table:table-row>
                <table:table-cell table:style-name="GridCell"><text:p>開示請求に係る行政文書の名称又は内容</text:p></table:table-cell>
                <table:table-cell table:style-name="GridCellLarge"/>
              </table:table-row>
              <table:table-row>
                <table:table-cell table:style-name="GridCell"><text:p>開示の実施方法</text:p></table:table-cell>
                <table:table-cell table:style-name="GridCell"><text:p>□閲覧　　　　□写しの交付　　　　□視聴</text:p></table:table-cell>
              </table:table-row>
              <table:table-row>
                <table:table-cell table:style-name="GridCell"><text:p>備考</text:p></table:table-cell>
                <table:table-cell table:style-name="GridCellLarge"/>
              </table:table-row>
            </table:table>
            <text:p text:style-name="SmallNote">（注意）</text:p>
            <text:p text:style-name="SmallNote">請求者が法人その他の団体の場合は、備考欄に連絡可能な方の氏名及び電話番号を記入してください。</text:p>
            <text:p text:style-name="DottedRule"/>
            <text:p text:style-name="Body">＊下記の枠内は記入の必要はありません。</text:p>
            <text:p text:style-name="Body"> </text:p>
            <table:table table:name="OfficeProcessing" table:style-name="BottomTable">
              <table:table-column table:style-name="ColBottomNarrow"/>
              <table:table-column table:style-name="ColBottomWide"/>
              <table:table-row>
                <table:table-cell table:style-name="GridCell"><text:p>行政文書の所管課名</text:p></table:table-cell>
                <table:table-cell table:style-name="GridCell"/>
              </table:table-row>
              <table:table-row>
                <table:table-cell table:style-name="GridCell"><text:p>処理状況</text:p></table:table-cell>
                <table:table-cell table:style-name="GridCell">
                  <text:p>１　開示　　２　一部開示　　３　不開示</text:p>
                  <text:p>４　その他（　　　　　　　　　）</text:p>
                </table:table-cell>
              </table:table-row>
              <table:table-row>
                <table:table-cell table:style-name="GridCell"><text:p>条例第１０条第１項ただし書きに規定する書面による通知の省略</text:p></table:table-cell>
                <table:table-cell table:style-name="GridCell"><text:p>１　省略　　２　書面通知</text:p></table:table-cell>
              </table:table-row>
            </table:table>
          </table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>