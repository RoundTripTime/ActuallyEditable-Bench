          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="DataCenter" table:number-rows-spanned="2"><text:p>居　住</text:p><text:p>所　有</text:p></table:table-cell>
          <table:table-cell table:style-name="DataCenter" table:number-rows-spanned="2"><text:p>年　月　日</text:p></table:table-cell>
          <table:table-cell table:style-name="DataCell" table:number-rows-spanned="2"><text:p>面談</text:p><text:p>郵送</text:p><text:p>その他（　）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2"/>
