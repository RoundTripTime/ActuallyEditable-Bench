        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p text:style-name="TableText">施設統括：施設管理者　［氏名］</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">指揮班</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">班長：[役職]　［氏名］</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">班員：[役職]　［氏名］</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">班員：[役職]　［氏名］</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText"/>
          </table:table-cell>
        </table:table-row>
