          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">班員：[役職]　［氏名］</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Center">- 12 -</text:p>

      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="Body">《夜間》</text:p>
      <table:table table:name="NightOrg" table:style-name="Grid">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col1"/>
