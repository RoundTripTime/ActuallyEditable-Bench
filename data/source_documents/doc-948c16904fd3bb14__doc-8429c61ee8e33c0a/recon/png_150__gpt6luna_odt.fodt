  <office:body>
    <office:text>
      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="Title">農地法第18条第6項の規定による通知書</text:p>
      <text:p text:style-name="Default">大宜味村農業委員会会長　殿</text:p>
      <text:p text:style-name="Right">令和　年　月　日</text:p>
      <table:table table:name="通知書当事者" table:style-name="PeopleTable">
        <table:table-column table:style-name="PersonRole"/>
        <table:table-column table:style-name="PersonLabel"/>
        <table:table-column table:style-name="PersonInput"/>
        <table:table-row>
          <table:table-cell table:style-name="TableCell" table:number-rows-spanned="3"><text:p text:style-name="TableCenter">所有者<br/>（貸人）</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableText">氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="TableCenter">印</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableText">住所</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableText">連絡先</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell" table:number-rows-spanned="3"><text:p text:style-name="TableCenter">耕作者<br/>（借人）</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableText">氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="TableCenter">印</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableText">住所</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableText">連絡先</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Default">下記の農地について貸借の解約をしたので、農地法第18条第6項の規定により通知します。</text:p>
      <text:p text:style-name="Center">記</text:p>
      <text:p text:style-name="Default">１．土地の所在・地番・地目・面積及び利用権の内容</text:p>
      <table:table table:name="土地の内容" table:style-name="LandTable">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-column table:style-name="Col5"/>
        <table:table-column table:style-name="Col6"/>
        <table:table-column table:style-name="Col7"/>
        <table:table-column table:style-name="Col8"/>
        <table:table-column table:style-name="Col9"/>
        <table:table-row>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="5"><text:p text:style-name="TableCenter">土地</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="3"><text:p text:style-name="TableCenter">利　　　用　　　権</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="TableCell" table:number-rows-spanned="2"><text:p text:style-name="TableCenter">当事者の法律関係</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableCenter">大　字</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableCenter">小　字</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableCenter">地　番</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableCenter">地　目</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableCenter">面　積<br/>（m²）</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableCenter">種　類</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableCenter">始　期</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableCenter">終　期</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/>
          <table:table-cell table:style-name="InputCell" table:number-rows-spanned="3"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Default">１．解約の理由　：</text:p>
      <text:p text:style-name="Default">２．合意解約の合意が成立した日　　　　　　　　　令和　年　月　日</text:p>
      <text:p text:style-name="Default">３．合意による解約をした日　　　　　　　　　　　令和　年　月　日</text:p>
      <text:p text:style-name="Default">４．土地の引渡の時期　　　　　　　　　　　　　　令和　年　月　日</text:p>
      <text:p text:style-name="Default">５．その他参考となるべき事項　：　無し</text:p>
      <text:p text:style-name="Default">※添付書類：合意解約書の写し、農地利用集積計画の写し</text:p>

      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="Title">合意解約書</text:p>
      <text:p text:style-name="Default">下記表示の農地は　　　　　　　　の所有であり　　　　　　はこれを耕作目的で貸借し農地として供してきたが、この度合意により解約が成立しました。<br/>当事者間とも異議なく承諾し土地の引き渡しを行ない、この解約について紛争等は一切ありません。</text:p>
      <text:p text:style-name="Center">記</text:p>
      <text:p text:style-name="Default">１．土地の所在・地番・地目・面積及び利用権の内容</text:p>
      <table:table table:name="合意解約書の土地" table:style-name="LandTable">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-column table:style-name="Col5"/>
        <table:table-column table:style-name="Col6"/>
        <table:table-column table:style-name="Col7"/>
        <table:table-column table:style-name="Col8"/>
        <table:table-column table:style-name="Col9"/>
        <table:table-row>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="5"><text:p text:style-name="TableCenter">土地</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="3"><text:p text:style-name="TableCenter">利　　　用　　　権</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="TableCell" table:number-rows-spanned="2"><text:p text:style-name="TableCenter">当事者の法律関係</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableCenter">大　字</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableCenter">小　字</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableCenter">地　番</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableCenter">地　目</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableCenter">面　積<br/>（m²）</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableCenter">種　類</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableCenter">始　期</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableCenter">終　期</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/>
          <table:table-cell table:style-name="InputCell" table:number-rows-spanned="3"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/><table:table-cell table:style-name="InputCell"/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Default">２．所有者および耕作者</text:p>
      <table:table table:name="合意解約書の当事者" table:style-name="PeopleTable">
        <table:table-column table:style-name="PersonRole"/>
        <table:table-column table:style-name="PersonLabel"/>
        <table:table-column table:style-name="PersonInput"/>
        <table:table-row>
          <table:table-cell table:style-name="TableCell" table:number-rows-spanned="3"><text:p text:style-name="TableCenter">所有者<br/>（貸人）</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableText">氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="TableCenter">印</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableText">住所</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableText">連絡先</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell" table:number-rows-spanned="3"><text:p text:style-name="TableCenter">耕作者<br/>（借人）</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableText">氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="TableCenter">印</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableText">住所</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableText">連絡先</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Right">令和　年　月　日</text:p>
      <text:p text:style-name="Default">なお、後日の証として本書を２部作成し、賃貸人、賃借人各１部を保持し、その写しを。<br/>農業委員会に提出する。</text:p>

      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="Title">合意解約書</text:p>
      <text:p text:style-name="Default">下記表示の農地は　　　　　　　　の所有であり　　　　　　はこれを耕作目的で貸借し農地として供してきたが、この度合意により解約が成立しました。<br/>当事者間とも異議なく承諾し土地の引き渡しを行ない、この解約について紛争等は一切ありません。</text:p>
      <text:p text:style-name="Center">記</text:p>
      <text:p text:style-name="Default">１．土地の所在・地番・地目・面積及び利用権の内容</text:p>
      <table:table table:name="合意解約書の土地2" table:style-name="LandTable">
        <table:table-column table:style-name="Col1"/><table:table-column table:style-name="Col2"/><table:table-column table:style-name="Col3"/><table:table-column table:style-name="Col4"/><table:table-column table:style-name="Col5"/><table:table-column table:style-name="Col6"/><table:table-column table:style-name="Col7"/><table:table-column table:style-name="Col8"/><table:table-column table:style-name="Col9"/>
        <table:table-row>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="5"><text:p text:style-name="TableCenter">土地</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="3"><text:p text:style-name="TableCenter">利　　　用　　　権</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="TableCell" table:number-rows-spanned="2"><text:p text:style-name="TableCenter">当事者の法律関係</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableCenter">大　字</text:p></table:table-cell><table:table-cell table:style-name="TableCell"><text:p text:style-name="TableCenter">小　字</text:p></table:table-cell><table:table-cell table:style-name="TableCell"><text:p text:style-name="TableCenter">地　番</text:p></table:table-cell><table:table-cell table:style-name="TableCell"><text:p text:style-name="TableCenter">地　目</text:p></table:table-cell><table:table-cell table:style-name="TableCell"><text:p text:style-name="TableCenter">面　積<br/>（m²）</text:p></table:table-cell><table:table-cell table:style-name="TableCell"><text:p text:style-name="TableCenter">種　類</text:p></table:table-cell><table:table-cell table:style-name="TableCell"><text:p text:style-name="TableCenter">始　期</text:p></table:table-cell><table:table-cell table:style-name="TableCell"><text:p text:style-name="TableCenter">終　期</text:p></table:table-cell><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
