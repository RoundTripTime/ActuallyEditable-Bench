          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>휴대전화번호</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p>전자우편주소</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p>주소</text:p></table:table-cell>
          <table:covered-table-cell/>
