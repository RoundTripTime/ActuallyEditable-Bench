<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.08cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="TopNote" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.1cm"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.5cm" fo:margin-bottom="0.4cm"/>
      <style:text-properties fo:font-size="22pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-top="1.5cm" fo:margin-bottom="1.5cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
    </style:page-layout>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="1.8cm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="3.4cm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="3.4cm"/>
    </style:style>
    <style:style style:name="ColD" style:family="table-column">
      <style:table-column-properties style:column-width="3cm"/>
    </style:style>
    <style:style style:name="ColE" style:family="table-column">
      <style:table-column-properties style:column-width="2.4cm"/>
    </style:style>
    <style:style style:name="ColF" style:family="table-column">
      <style:table-column-properties style:column-width="3cm"/>
    </style:style>
    <style:style style:name="ColLabel" style:family="table-column">
      <style:table-column-properties style:column-width="5.2cm"/>
    </style:style>
    <style:style style:name="ColContent" style:family="table-column">
      <style:table-column-properties style:column-width="11.8cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="BoxCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0.12cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="NoBorderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0.03cm" style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="DefaultPage" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="TopNote">第１号様式（第６条関係）</text:p>
      <text:p text:style-name="Title">事業計画概要書</text:p>
      <text:p text:style-name="Right">年　　　月　　　日</text:p>
      <text:p text:style-name="Body">大府市長殿</text:p>
      <text:p text:style-name="Body">住所</text:p>
      <text:p text:style-name="Body">氏名</text:p>
      <text:p text:style-name="Right">（法人その他の団体にあっては、事務所又は事業所の所在地、名称及び代表者の氏名）</text:p>
      <text:p text:style-name="Body">大府市開発等事業の手続及び基準等に関する条例第９条第１項の規定により、事業計画概要書を提出します。</text:p>
      <table:table table:name="事業計画概要書_１">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColD"/>
        <table:table-column table:style-name="ColE"/>
        <table:table-column table:style-name="ColF"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Body">事業区域の位置</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Body">大府市</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Body">事業区域の面積</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"/>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">平方メートル</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Body">都市計画区域及び用途地域</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Body">市街化区域（用途地域　　　　　　　　　）・市街化調整区域</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Body">事業の目的</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Body">予定建築物の用途</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Body">予定区画数・戸数</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Right">区画・　　　戸</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="3"><text:p text:style-name="Body">予定建築物</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">構造</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">造</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Body">建築面積</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">m²</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">高さ</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">m</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Body">延べ床面積</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">m²</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">階数</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">地上　　階・地下　　階</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Body">棟数</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">棟</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Body">付属建築物</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Body">有（倉庫・駐車場・駐輪場・物置・その他（　　　　））・無</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Body">造成計画概要</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Body">切土高さ　　　　m・盛土高さ　　　　m</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Body">排水計画概要</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Body">雨水放流先（側溝・水路・その他（　　　　　　　　　））</text:p><text:p text:style-name="Body">汚水及び雑排水放流先（公共下水・浄化槽・その他（　　　　　　　　　））</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Body">公共施設の設置</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Body">有（公園・道路・水路・調整池・その他（　　　　））・無</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Body">ごみ置場の設置</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Body">有（　　　ヶ所・有効面積　　　　　m²）・無</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Body">設備機器の設置</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Body">有（キュービクル・受水槽・その他（　　　　））・無</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Body">工事予定期間</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Center">　　　年　　　月　　　日　から　　　年　　　月　　　日まで</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Body">工事実施日</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Center">平日・土曜日・日曜日・祝日</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Body">工事時間</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Center">（午前・午後）　　時　　分から（午前・午後）　　時　　分まで</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageBreak"/>
      <table:table table:name="事業計画概要書_２">
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColContent"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">安全対策</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">・事業区域及び周辺の事故防止や近隣住民等への安全対策等について</text:p><text:p text:style-name="Body">・振動、騒音等の防止対策について</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">公害防止対策</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">（予定建築物の用途に住宅が含まれない場合のみ記入）</text:p><text:p text:style-name="Body">・予定建築物からの排水、騒音、振動、火災等の対策について</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">電波障害対応</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">・調査方法や建物完成後に影響があった場合の対応について</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">連絡先</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="Body">（事業者代理人）</text:p>
            <text:p text:style-name="Body">　住所</text:p>
            <text:p text:style-name="Body">　氏名</text:p>
            <text:p text:style-name="Body">　電話（　　　　　　）　―</text:p>
            <text:p text:style-name="Body">（工事施工者担当）</text:p>
            <text:p text:style-name="Body">　住所</text:p>
            <text:p text:style-name="Body">　氏名</text:p>
            <text:p text:style-name="Body">　電話（　　　　　　）　―</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">その他</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body">※事業計画概要書には、以下の図書を添付してください。</text:p>
      <table:table table:name="添付図書と受付印">
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColContent"/>
        <table:table-row>
          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="Body">・事業区域位置図</text:p></table:table-cell>
          <table:table-cell table:style-name="BoxCell" table:number-rows-spanned="7"><text:p text:style-name="Center">受付印</text:p></table:table-cell>
        </table:table-row>
        <table:table-row><table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="Body">・現況図及び現況写真</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="Body">・土地利用計画図、造成計画平面図及び排水施設計画平面図</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="Body">・予定建築物の平面図及び立面図</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="Body">・工事車両の搬出入経路図</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="Body">・建築基準法第５６条の２に規定する日影図（予定建築物の高さが１０メートルを超える場合に限る。）</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="Body">・電波障害調査報告書（予定建築物の高さが１０メートルを超える場合に限る。）</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>