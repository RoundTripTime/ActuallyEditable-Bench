<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt" style:font-size-asian="12pt"/>
    </style:default-style>
    <style:style style:name="Base" style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt" style:font-size-asian="12pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.4cm" fo:margin-bottom="1.8cm" fo:margin-left="3cm" fo:margin-right="3cm"/>
    </style:page-layout>
    <style:style style:name="Header" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="1.35cm"/>
    </style:style>
    <style:style style:name="Date" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="-1.55cm" fo:margin-bottom="0.75cm"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:margin-top="0.35cm" fo:margin-bottom="0.65cm"/>
    </style:style>
    <style:style style:name="Applicant" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:margin-left="8.25cm" fo:line-height="145%" fo:margin-top="0cm" fo:margin-bottom="0.1cm"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="1.05cm" fo:margin-bottom="1.05cm"/>
      <style:text-properties fo:font-size="14pt" style:font-size-asian="14pt"/>
    </style:style>
    <style:style style:name="Body" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:line-height="165%" fo:margin-top="0cm" fo:margin-bottom="0.45cm"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.45cm" fo:margin-bottom="1.05cm"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:margin-top="0.55cm" fo:margin-bottom="0.1cm"/>
    </style:style>
    <style:style style:name="AttachHeading" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:margin-top="0.65cm" fo:margin-bottom="0.05cm"/>
    </style:style>
    <style:style style:name="Attach" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:margin-left="0.15cm" fo:line-height="155%"/>
    </style:style>
    <style:style style:name="InputLine" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0.02cm"/>
    </style:style>
    <style:style style:name="InputUnderline" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:border-bottom="0.5pt solid #000000" fo:padding="0.02cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.12cm" fo:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.12cm" fo:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="CellRight" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.12cm" fo:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="right"/>
    </style:style>
    <style:style style:name="NarrowCol" style:family="table-column">
      <style:table-column-properties style:column-width="0.75cm"/>
    </style:style>
    <style:style style:name="WideCol" style:family="table-column">
      <style:table-column-properties style:column-width="6.75cm"/>
    </style:style>
    <style:style style:name="AmountCol" style:family="table-column">
      <style:table-column-properties style:column-width="5.35cm"/>
    </style:style>
    <style:style style:name="LineLabelCol" style:family="table-column">
      <style:table-column-properties style:column-width="7.2cm"/>
    </style:style>
    <style:style style:name="LineInputCol" style:family="table-column">
      <style:table-column-properties style:column-width="7.2cm"/>
    </style:style>
    <style:style style:name="YenCol" style:family="table-column">
      <style:table-column-properties style:column-width="0.5cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Header">別記様式第１号</text:p>
      <text:p text:style-name="Date">年　　　　月　　　　日</text:p>
      <text:p text:style-name="Recipient">中標津町長　様</text:p>
      <text:p text:style-name="Applicant">住所　　　　　　　　　㊞</text:p>
      <text:p text:style-name="Applicant">氏　　名</text:p>
      <text:p text:style-name="Applicant">生年月日　　　　年　　　　月　　　　日生</text:p>
      <text:p text:style-name="Title">中標津町狩猟免許新規取得等補助金交付申請書</text:p>
      <text:p text:style-name="Body">中標津町狩猟免許新規取得等補助金交付要綱に基づき、下記の金額の補助金を交付され<text:line-break/>るよう同要綱第５条の規定により申請します。</text:p>
      <text:p text:style-name="Center">記</text:p>
      <table:table table:name="ApplicationAmount">
        <table:table-column table:style-name="LineLabelCol"/>
        <table:table-column table:style-name="LineInputCol"/>
        <table:table-column table:style-name="YenCol"/>
        <table:table-row>
          <table:table-cell table:style-name="InputLine"><text:p>１　補助金申請額</text:p></table:table-cell>
          <table:table-cell table:style-name="InputUnderline"><text:p/></table:table-cell>
          <table:table-cell table:style-name="InputLine"><text:p>円</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Section">２　補助対象経費</text:p>
      <table:table table:name="EligibleExpenses">
        <table:table-column table:style-name="NarrowCol"/>
        <table:table-column table:style-name="WideCol"/>
        <table:table-column table:style-name="AmountCol"/>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-rows-spanned="3">
            <text:p>所</text:p>
            <text:p>要</text:p>
            <text:p>経</text:p>
            <text:p>費</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>１）第一種銃猟免許取得費</text:p></table:table-cell>
          <table:table-cell table:style-name="CellRight"><text:p>円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>２）銃砲刀剣類所持許可取得費</text:p></table:table-cell>
          <table:table-cell table:style-name="CellRight"><text:p>円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellCenter"><text:p>合　　計</text:p></table:table-cell>
          <table:table-cell table:style-name="CellRight"><text:p>円</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="AttachHeading">３　添付書類</text:p>
      <text:p text:style-name="Attach">（１）　住民票</text:p>
      <text:p text:style-name="Attach">（２）　町税に滞納が無いことを証するもの</text:p>
      <text:p text:style-name="Attach">（３）　取得した第一種狩猟免状及び銃砲所持許可証の写し</text:p>
      <text:p text:style-name="Attach">（４）　経費に要した領収書の写し</text:p>
      <text:p text:style-name="Attach">（５）　猟友会に入会したことを証する書面</text:p>
      <text:p text:style-name="Attach">（６）　誓約書（別記様式第２号）</text:p>
    </office:text>
  </office:body>
</office:document>