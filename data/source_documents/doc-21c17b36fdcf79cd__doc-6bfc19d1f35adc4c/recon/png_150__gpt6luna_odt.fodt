<?xml version="1.0" encoding="UTF-8"?>
<office:document
    xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
    xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
    xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
    xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
    office:mimetype="application/vnd.oasis.opendocument.text"
    office:version="1.4">
  <office:styles>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0.8cm"/>
      <style:text-properties fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
    <style:style style:name="Col" style:family="table-column">
      <style:table-column-properties style:column-width="1cm"/>
    </style:style>
    <style:style style:name="C" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #333333" fo:padding="0.06cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Entry" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #333333" fo:padding="0.06cm" style:vertical-align="middle" fo:background-color="#ffffdc"/>
    </style:style>
    <style:style style:name="NoBorder" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="RuleCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:border-bottom="0.5pt solid #333333" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="ExpenseCol" style:family="table-column">
      <style:table-column-properties style:column-width="3cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="Page">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.5cm" fo:margin-bottom="1.5cm" fo:margin-left="1.8cm" fo:margin-right="1.8cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="Page"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">ふるさと教室実施報告および補助金交付申請書</text:p>

      <table:table table:name="DateAndGroup">
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-row>
          <table:table-cell table:style-name="NoBorder" table:number-columns-spanned="6"><text:p text:style-name="P"/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="NoBorder" table:number-columns-spanned="3"><text:p text:style-name="Right">令 和　 年　 月　 日</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="NoBorder" table:number-columns-spanned="5"><text:p text:style-name="P">飯綱町青少年育成町民会議会長　様</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="NoBorder" table:number-columns-spanned="2"><text:p text:style-name="P">子ども会･育成会名</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Entry" table:number-columns-spanned="2"><text:p text:style-name="P"/></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="NoBorder" table:number-columns-spanned="5"><text:p text:style-name="P"/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="P">代表者</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Entry" table:number-columns-spanned="2"><text:p text:style-name="P"/></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>

      <text:p text:style-name="P"/>
      <text:p text:style-name="P"/>
      <text:p text:style-name="P">下記のとおりふるさと教室事業実施しましたので、補助金の交付を申請します。</text:p>
      <text:p text:style-name="P"/>
      <text:p text:style-name="P">1．実施した事業の概要</text:p>

      <table:table table:name="Overview">
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-row>
          <table:table-cell table:style-name="C"><text:p text:style-name="P">実 施 内 容</text:p></table:table-cell>
          <table:table-cell table:style-name="C" table:number-columns-spanned="8"><text:p text:style-name="P"/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C"><text:p text:style-name="P">実 施 期 日</text:p></table:table-cell>
          <table:table-cell table:style-name="C"><text:p text:style-name="P">令和</text:p></table:table-cell>
          <table:table-cell table:style-name="Entry"><text:p text:style-name="P"/></table:table-cell>
          <table:table-cell table:style-name="C"><text:p text:style-name="P">年</text:p></table:table-cell>
          <table:table-cell table:style-name="Entry"><text:p text:style-name="P"/></table:table-cell>
          <table:table-cell table:style-name="C"><text:p text:style-name="P">月</text:p></table:table-cell>
          <table:table-cell table:style-name="Entry"><text:p text:style-name="P"/></table:table-cell>
          <table:table-cell table:style-name="C"><text:p text:style-name="P">日　～　令和　　年　　月　　日</text:p></table:table-cell>
          <table:table-cell table:style-name="Entry"><text:p text:style-name="P"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C"><text:p text:style-name="P">実 施 場 所</text:p></table:table-cell>
          <table:table-cell table:style-name="C" table:number-columns-spanned="8"><text:p text:style-name="P"/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C"><text:p text:style-name="P">共 催 団 体</text:p></table:table-cell>
          <table:table-cell table:style-name="C" table:number-columns-spanned="8"><text:p text:style-name="P"/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C" table:number-rows-spanned="2"><text:p text:style-name="P">参 加 者</text:p></table:table-cell>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="Center">子ども</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="Center">保護者</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="Center">育成会</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="Center">高齢者</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Entry"><text:p text:style-name="P"/></table:table-cell>
          <table:table-cell table:style-name="C"><text:p text:style-name="P">人</text:p></table:table-cell>
          <table:table-cell table:style-name="Entry"><text:p text:style-name="P"/></table:table-cell>
          <table:table-cell table:style-name="C"><text:p text:style-name="P">人</text:p></table:table-cell>
          <table:table-cell table:style-name="Entry"><text:p text:style-name="P"/></table:table-cell>
          <table:table-cell table:style-name="C"><text:p text:style-name="P">人</text:p></table:table-cell>
          <table:table-cell table:style-name="Entry"><text:p text:style-name="P"/></table:table-cell>
          <table:table-cell table:style-name="C"><text:p text:style-name="P">人</text:p></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="P"/>
      <text:p text:style-name="P">2．事業に伴う経費</text:p>
      <table:table table:name="Expenses">
        <table:table-column table:style-name="ExpenseCol"/>
        <table:table-column table:style-name="ExpenseCol"/>
        <table:table-column table:style-name="ExpenseCol"/>
        <table:table-column table:style-name="ExpenseCol"/>
        <table:table-column table:style-name="ExpenseCol"/>
        <table:table-column table:style-name="ExpenseCol"/>
        <table:table-row>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="Center">区　分</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="Center">金　額</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="Center">説　明</text:p></table:table-cell><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="P">講師謝礼</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="P"/></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="P"/></table:table-cell><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="P">材　料　費</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="P"/></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="P"/></table:table-cell><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="P">食　糧　費</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="P"/></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="P"/></table:table-cell><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <table:table table:name="ExpenseTotal">
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-row>
          <table:table-cell table:style-name="RuleCell" table:number-columns-spanned="2"><text:p text:style-name="Right">※　経費の合計金額</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Entry"><text:p text:style-name="P"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="NoBorder" table:number-columns-spanned="2"><text:p text:style-name="Right">■　上 限 額　＝　6,000　円</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="NoBorder"><text:p text:style-name="P"/></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="P"/>
      <table:table table:name="Grant">
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-column table:style-name="Col"/>
        <table:table-row>
          <table:table-cell table:style-name="NoBorder" table:number-columns-spanned="2"><text:p text:style-name="P">3．補助金交付申請額</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="Entry"><text:p text:style-name="P"/></table:table-cell>
          <table:table-cell table:style-name="NoBorder"><text:p text:style-name="P">円</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Small">事業に伴う経費の合計金額と</text:p>
      <text:p text:style-name="Small">6,000 円(上限額)との少ない方の額</text:p>
      <text:p text:style-name="P"/>
      <text:p text:style-name="P">4．添付書類</text:p>
      <text:p text:style-name="P">　　① 領収書(写)　　②開催通知等事業の実施がわかるもの</text:p>
      <text:p text:style-name="P">　　③ 写真３枚程度（子どもと講師(高齢者)の活動の様子・作成したもの）</text:p>
      <text:p text:style-name="P"/>
      <text:p text:style-name="Right">ふるさと教室事業補助金実施報告および交付申請書 230310</text:p>
    </office:text>
  </office:body>
</office:document>