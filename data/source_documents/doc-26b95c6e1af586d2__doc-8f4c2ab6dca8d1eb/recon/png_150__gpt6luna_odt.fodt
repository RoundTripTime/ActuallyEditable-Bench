    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" fo:margin-left="16mm" fo:margin-right="16mm" fo:margin-top="10mm" fo:margin-bottom="10mm"/>
    </style:page-layout>
    <style:style style:name="PageStart" style:family="paragraph">
