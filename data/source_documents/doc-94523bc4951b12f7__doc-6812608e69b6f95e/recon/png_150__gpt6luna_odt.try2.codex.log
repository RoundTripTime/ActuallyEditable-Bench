              <table:table-row><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">キ</text:p></table:table-cell><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">G（２Ｐ・４Ｐ）</text:p></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">ク</text:p></table:table-cell><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">H（２Ｐ・４Ｐ）</text:p></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">　</text:p></table:table-cell><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">I</text:p><text:p text:style-name="CellCenter">J</text:p></table:table-cell></table:table-row>
            </table:table>
          </table:table-cell>
          <table:table-cell table:style-name="InputCell">
            <text:p text:style-name="CellCenter">記号に○をお願いします。</text:p>
