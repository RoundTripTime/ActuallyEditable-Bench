              <table:table-row><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">イ</text:p></table:table-cell><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">B</text:p></table:table-cell></table:table-row>
