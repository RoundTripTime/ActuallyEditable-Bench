<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.08cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:text-align="right"/>
    </style:style>
    <style:style style:name="Bold" style:family="paragraph" style:parent-style-name="P">
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.55cm" fo:margin-bottom="0.2cm"/>
      <style:text-properties fo:font-size="19pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Start" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
    <style:style style:name="Cell" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="paragraph" style:parent-style-name="Cell">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="CellBold" style:family="paragraph" style:parent-style-name="Cell">
      <style:text-properties fo:font-size="10pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Table" style:family="table">
      <style:table-properties style:width="18.2cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="6.7cm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="5.75cm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="5.75cm"/>
    </style:style>
    <style:style style:name="BorderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="InputCell" style:family="table-cell" style:parent-style-name="BorderCell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="NoBorder" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0.05cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="NarrowTable" style:family="table">
      <style:table-properties style:width="5.7cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="NarrowCol" style:family="table-column">
      <style:table-column-properties style:column-width="2.85cm"/>
    </style:style>
    <style:style style:name="PageLayout" style:family="page-layout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="0.9cm" fo:margin-bottom="0.9cm" fo:margin-left="1.2cm" fo:margin-right="1.2cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PL1">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-top="0.9cm" fo:margin-bottom="0.9cm" fo:margin-left="1.2cm" fo:margin-right="1.2cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PL1"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Start"/>
      <text:p text:style-name="Right">（様式第４号）</text:p>
      <text:p text:style-name="Right">令和　　年　　月　　日</text:p>
      <text:p text:style-name="P">海田町長　様</text:p>
      <table:table table:name="基本情報" table:style-name="Table">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-row>
          <table:table-cell table:style-name="NoBorder"><text:p text:style-name="Cell">団体名</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="NoBorder"><text:p text:style-name="Cell">　</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="NoBorder"><text:p text:style-name="Cell">スタンプ番号</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="NoBorder"><text:p text:style-name="Cell">　</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="NoBorder"><text:p text:style-name="Cell">代表者住所</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="NoBorder"><text:p text:style-name="Cell">　</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="NoBorder"><text:p text:style-name="Cell">代表者氏名</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="NoBorder"><text:p text:style-name="Cell">　</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="NoBorder"><text:p text:style-name="Cell">連絡先氏名及び電話番号　（　　　）　　　―　　　―</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="NoBorder"><text:p text:style-name="Cell">　</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Title">高齢者いきいき活動ポイント事業活動団体登録内容変更届出書</text:p>
      <text:p text:style-name="P">高齢者いきいき活動ポイント事業の活動団体として届け出た内容に下記のとおり変更がありましたので、</text:p>
      <text:p text:style-name="P">届け出ます。</text:p>
      <text:p text:style-name="Center">記</text:p>
      <text:p text:style-name="Bold">※　変更のあった項目欄にのみ記載してください（変更のない項目欄には記載しないでください）。</text:p>
      <text:p text:style-name="Bold">※　登録内容を追加する場合には、変更後の欄に、追加する内容だけでなく変更前の欄に記載している内容も</text:p>
      <text:p text:style-name="Bold">　　併せて記載してください（記入例を参照）。</text:p>
      <table:table table:name="変更内容" table:style-name="Table">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-row>
          <table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">変更項目</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">変更前</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">変更後</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BorderCell"><text:p text:style-name="Cell">団体名</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="Cell">　</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="Cell">　</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BorderCell"><text:p text:style-name="Cell">代表者の住所又は</text:p><text:p text:style-name="Cell">団体（グループ）の所在地（スタンプ送付先）</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="Cell">　</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="Cell">　</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BorderCell"><text:p text:style-name="Cell">ホームページアドレス</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="Cell">　</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="Cell">　</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BorderCell"><text:p text:style-name="Cell">メールアドレス</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="Cell">　</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="Cell">　</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BorderCell"><text:p text:style-name="Cell">代表者氏名・連絡先電話番号</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="Cell">　</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="Cell">　</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BorderCell"><text:p text:style-name="Cell">スタンプ管理責任者氏名・連絡先電話番号</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="Cell">　</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="Cell">　</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BorderCell"><text:p text:style-name="Cell">スタンプ管理副責任者氏名・連絡先電話番号</text:p><text:p text:style-name="Cell">※　変更する者が多数の場合は別紙を添付してください。</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="Cell">　</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="Cell">　</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BorderCell"><text:p text:style-name="Cell">主な活動場所</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="Cell">　</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="Cell">　</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BorderCell"><text:p text:style-name="Cell">活動内容</text:p><text:p text:style-name="Cell">（該当する記号に○印を付けてください。</text:p><text:p text:style-name="Cell">複数の活動を行っている場合は、複数の記号に○印を付けてください。Ｅ～Ｈに○を付ける場合には、活動のポイント数にも○を付けてください。）</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell">
            <text:p text:style-name="CellCenter">記号に○をお願いします。</text:p>
            <table:table table:name="変更前活動" table:style-name="NarrowTable">
              <table:table-column table:style-name="NarrowCol"/>
              <table:table-column table:style-name="NarrowCol"/>
              <table:table-row><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">ア</text:p></table:table-cell><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">A</text:p></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">イ</text:p></table:table-cell><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">B</text:p></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">ウ</text:p></table:table-cell><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">C</text:p></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">エ</text:p></table:table-cell><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">D</text:p></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">オ</text:p></table:table-cell><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">E（２Ｐ・４Ｐ）</text:p></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">カ</text:p></table:table-cell><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">F（２Ｐ・４Ｐ）</text:p></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">キ</text:p></table:table-cell><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">G（２Ｐ・４Ｐ）</text:p></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">ク</text:p></table:table-cell><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">H（２Ｐ・４Ｐ）</text:p></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">　</text:p></table:table-cell><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">I</text:p><text:p text:style-name="CellCenter">J</text:p></table:table-cell></table:table-row>
            </table:table>
          </table:table-cell>
          <table:table-cell table:style-name="InputCell">
            <text:p text:style-name="CellCenter">記号に○をお願いします。</text:p>
            <table:table table:name="変更後活動" table:style-name="NarrowTable">
              <table:table-column table:style-name="NarrowCol"/>
              <table:table-column table:style-name="NarrowCol"/>
              <table:table-row><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">ア</text:p></table:table-cell><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">A</text:p></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">イ</text:p></table:table-cell><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">B</text:p></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">ウ</text:p></table:table-cell><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">C</text:p></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">エ</text:p></table:table-cell><table:table-cell table:style-name="CellCenter"><text:p text:style-name="CellCenter">D</text:p></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">オ</text:p></table:table-cell><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">E（２Ｐ・４Ｐ）</text:p></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">カ</text:p></table:table-cell><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">F（２Ｐ・４Ｐ）</text:p></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">キ</text:p></table:table-cell><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">G（２Ｐ・４Ｐ）</text:p></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">ク</text:p></table:table-cell><table:table-cell table:style-name="CellCenter"><text:p text:style-name="CellCenter">H（２Ｐ・４Ｐ）</text:p></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">　</text:p></table:table-cell><table:table-cell table:style-name="BorderCell"><text:p text:style-name="CellCenter">I</text:p><text:p text:style-name="CellCenter">J</text:p></table:table-cell></table:table-row>
            </table:table>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="P">【留意事項】</text:p>
      <text:p text:style-name="P">　　変更後の内容でスタンプを押印していただけるのは、町が登録内容変更届出書を受け付けた後になります。</text:p>
      <text:p text:style-name="Bold">　　（町が登録内容変更届出書を受け付ける前に変更後の内容でスタンプを押印することはできません。）</text:p>
    </office:text>
  </office:body>
</office:document>