<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
                 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
                 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
                 xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
                 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
                 office:mimetype="application/vnd.oasis.opendocument.text"
                 office:version="1.4">
  <office:styles>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.15in" fo:margin-bottom="0.55in" fo:break-before="page"/>
      <style:text-properties fo:font-size="24pt"/>
    </style:style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin="0in" fo:line-height="1.35"/>
      <style:text-properties fo:font-size="18pt"/>
    </style:style>
    <style:style style:name="Close" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.7in" fo:margin-bottom="0.15in"/>
      <style:text-properties fo:font-size="18pt"/>
    </style:style>
    <style:style style:name="OfficeName" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0.48in"/>
      <style:text-properties fo:font-size="18pt"/>
    </style:style>
    <style:style style:name="CellText" style:family="paragraph">
      <style:paragraph-properties fo:margin="0in"/>
      <style:text-properties fo:font-size="18pt"/>
    </style:style>
    <style:style style:name="DateCell" style:family="paragraph">
      <style:paragraph-properties fo:margin="0in" fo:text-align="center"/>
      <style:text-properties fo:font-size="18pt"/>
    </style:style>
    <style:style style:name="SerialText" style:family="paragraph">
      <style:paragraph-properties fo:margin="0in"/>
      <style:text-properties fo:font-size="12pt" fo:font-family="serif"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="8.27in" fo:page-height="11.69in" fo:margin-left="0.8in" fo:margin-right="0.8in" fo:margin-top="0.6in" fo:margin-bottom="0.6in" style:print-orientation="portrait"/>
    </style:page-layout>
    <style:style style:name="InputTable" style:family="table">
      <style:table-properties style:width="6.67in" table:align="left" fo:margin-top="0.48in" fo:margin-bottom="0in" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="DateTable" style:family="table">
      <style:table-properties style:width="6.67in" table:align="left" fo:margin-top="0.92in" fo:margin-bottom="0in" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="SerialTable" style:family="table">
      <style:table-properties style:width="6.67in" table:align="left" fo:margin-top="0.38in" fo:margin-bottom="0in" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="InputColA" style:family="table-column">
      <style:table-column-properties style:column-width="2.6in"/>
    </style:style>
    <style:style style:name="InputColB" style:family="table-column">
      <style:table-column-properties style:column-width="4.07in"/>
    </style:style>
    <style:style style:name="DateCol1" style:family="table-column">
      <style:table-column-properties style:column-width="0.65in"/>
    </style:style>
    <style:style style:name="DateCol2" style:family="table-column">
      <style:table-column-properties style:column-width="0.75in"/>
    </style:style>
    <style:style style:name="DateCol3" style:family="table-column">
      <style:table-column-properties style:column-width="0.75in"/>
    </style:style>
    <style:style style:name="DateCol4" style:family="table-column">
      <style:table-column-properties style:column-width="0.85in"/>
    </style:style>
    <style:style style:name="DateCol5" style:family="table-column">
      <style:table-column-properties style:column-width="1.2in"/>
    </style:style>
    <style:style style:name="DateCol6" style:family="table-column">
      <style:table-column-properties style:column-width="1.2in"/>
    </style:style>
    <style:style style:name="DateCol7" style:family="table-column">
      <style:table-column-properties style:column-width="1.27in"/>
    </style:style>
    <style:style style:name="SerialColA" style:family="table-column">
      <style:table-column-properties style:column-width="3.67in"/>
    </style:style>
    <style:style style:name="SerialColB" style:family="table-column">
      <style:table-column-properties style:column-width="3in"/>
    </style:style>
    <style:style style:name="InputRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.5in"/>
    </style:style>
    <style:style style:name="DateRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.3in"/>
    </style:style>
    <style:style style:name="SerialRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.22in"/>
    </style:style>
    <style:style style:name="PlainCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0in" style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">逕「4」不編申請書</text:p>
      <text:p text:style-name="Body">本人　　於 貴轄新建房屋　　戶，建造執照(　)<text:line-break/>建執照字第　　號，懇請貴所於編釘門牌時，將門<text:line-break/>牌尾數號次為「4」者，抽空不編。</text:p>
      <text:p text:style-name="Close">此致</text:p>
      <text:p text:style-name="OfficeName">桃園市平鎮區戶政事務所</text:p>
      <table:table table:name="InputFields" table:style-name="InputTable">
        <table:table-column table:style-name="InputColA"/>
        <table:table-column table:style-name="InputColB"/>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="CellText">申請人姓名:</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="CellText">(簽章)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="CellText">身分證字號:</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"/>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="CellText">戶籍地址:</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"/>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="CellText">電話:</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"/>
        </table:table-row>
      </table:table>
      <table:table table:name="DateLine" table:style-name="DateTable">
        <table:table-column table:style-name="DateCol1"/>
        <table:table-column table:style-name="DateCol2"/>
        <table:table-column table:style-name="DateCol3"/>
        <table:table-column table:style-name="DateCol4"/>
        <table:table-column table:style-name="DateCol5"/>
        <table:table-column table:style-name="DateCol6"/>
        <table:table-column table:style-name="DateCol7"/>
        <table:table-row table:style-name="DateRow">
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="DateCell">中</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="DateCell">華</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="DateCell">民</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="DateCell">國</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="DateCell">年</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="DateCell">月</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="DateCell">日</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <table:table table:name="PrintedNumbers" table:style-name="SerialTable">
        <table:table-column table:style-name="SerialColA"/>
        <table:table-column table:style-name="SerialColB"/>
        <table:table-row table:style-name="SerialRow">
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="SerialText">380022200AC2Z006</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="SerialText">10540101</text:p></table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>