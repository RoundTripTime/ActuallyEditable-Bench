<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:default-style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="12mm" fo:margin-bottom="7mm"/>
    </style:style>
    <style:style style:name="FormText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="0mm"/>
    </style:style>
    <style:style style:name="FormTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="7mm" fo:margin-bottom="13mm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="RightText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0mm" fo:margin-bottom="8mm"/>
    </style:style>
    <style:style style:name="TargetText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="11mm"/>
    </style:style>
    <style:style style:name="CellText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0mm" fo:margin-bottom="0mm"/>
    </style:style>
    <style:style style:name="CellLeft" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0mm" fo:margin-bottom="0mm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" fo:margin-left="18mm" fo:margin-right="18mm" fo:margin-top="15mm" fo:margin-bottom="15mm"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table"/>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties fo:column-width="25mm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties fo:column-width="22mm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties fo:column-width="16mm"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties fo:column-width="30mm"/>
    </style:style>
    <style:style style:name="Col5" style:family="table-column">
      <style:table-column-properties fo:column-width="24mm"/>
    </style:style>
    <style:style style:name="Col6" style:family="table-column">
      <style:table-column-properties fo:column-width="28mm"/>
    </style:style>
    <style:style style:name="Col7" style:family="table-column">
      <style:table-column-properties fo:column-width="29mm"/>
    </style:style>
    <style:style style:name="GridCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.7mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="InputCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.7mm" style:vertical-align="top"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">様式第1号（第4条関係）</text:p>
      <text:p text:style-name="FormTitle">固定資産税減免申請書</text:p>
      <text:p text:style-name="RightText">令和　　年　　月　　日</text:p>
      <text:p text:style-name="TargetText">大 槌 町 長　 様</text:p>
      <table:table table:name="申請書" table:style-name="FormTable">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-column table:style-name="Col5"/>
        <table:table-column table:style-name="Col6"/>
        <table:table-column table:style-name="Col7"/>
        <table:table-row>
          <table:table-cell table:style-name="GridCell" table:number-rows-spanned="2"><text:p text:style-name="CellText">納税義務者</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">住　所<br/>（所在地）</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell" table:number-columns-spanned="5"><text:p text:style-name="CellText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">氏　名<br/>（名　称）</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell" table:number-columns-spanned="5"><text:p text:style-name="CellText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="7"><text:p text:style-name="CellText">固 定 資 産 等 の 内 訳</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">資産の区分</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="2"><text:p text:style-name="CellText">所　在　地　番<br/>（家 屋 番 号）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">地　　目<br/>（種類及び構造）</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">地　　積<br/>（床 面 積）</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">課　　税<br/>標 準 額</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">固定資産<br/>税　　額</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">土　地<br/>家　屋<br/>償却資産</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell" table:number-columns-spanned="2"><text:p text:style-name="CellText"/></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="CellText"/></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="CellText"/></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="CellText"/></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="CellText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">土　地<br/>家　屋<br/>償却資産</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell" table:number-columns-spanned="2"><text:p text:style-name="CellText"/></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="CellText"/></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="CellText"/></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="CellText"/></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="CellText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">土　地<br/>家　屋<br/>償却資産</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell" table:number-columns-spanned="2"><text:p text:style-name="CellText"/></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="CellText"/></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="CellText"/></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="CellText"/></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="CellText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">土　地<br/>家　屋<br/>償却資産</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell" table:number-columns-spanned="2"><text:p text:style-name="CellText"/></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="CellText"/></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="CellText"/></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="CellText"/></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="CellText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellText">土　地<br/>家　屋<br/>償却資産</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell" table:number-columns-spanned="2"><text:p text:style-name="CellText"/></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="CellText"/></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="CellText"/></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="CellText"/></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="CellText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="3"><text:p text:style-name="CellText">減免を受けようとする理由</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="InputCell" table:number-columns-spanned="4"><text:p text:style-name="CellText"/></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="3"><text:p text:style-name="CellText">添　付　書　類</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="4"><text:p text:style-name="CellLeft">1　り災証明書　　　　2　その他事由を証明する書類</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>