<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="10pt"/>
    </style:default-style>
    <style:style style:name="BodyText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="10pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" fo:margin-left="13mm" fo:margin-right="13mm" fo:margin-top="13mm" fo:margin-bottom="13mm"/>
    </style:page-layout>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0mm" fo:margin-bottom="0mm" fo:font-size="1pt"/>
      <style:text-properties fo:font-size="1pt"/>
    </style:style>
    <style:style style:name="OuterTable" style:family="table">
      <style:table-properties style:width="173mm"/>
    </style:style>
    <style:style style:name="InnerTable" style:family="table">
      <style:table-properties style:width="79mm"/>
    </style:style>
    <style:style style:name="ColumnLeft" style:family="table-column">
      <style:table-column-properties style:column-width="79mm"/>
    </style:style>
    <style:style style:name="ColumnEntry" style:family="table-column">
      <style:table-column-properties style:column-width="15mm"/>
    </style:style>
    <style:style style:name="ColumnTitle" style:family="table-column">
      <style:table-column-properties style:column-width="19mm"/>
    </style:style>
    <style:style style:name="InnerCol1" style:family="table-column">
      <style:table-column-properties style:column-width="8mm"/>
    </style:style>
    <style:style style:name="InnerCol2" style:family="table-column">
      <style:table-column-properties style:column-width="10mm"/>
    </style:style>
    <style:style style:name="InnerCol3" style:family="table-column">
      <style:table-column-properties style:column-width="16mm"/>
    </style:style>
    <style:style style:name="InnerCol4" style:family="table-column">
      <style:table-column-properties style:column-width="14mm"/>
    </style:style>
    <style:style style:name="InnerCol5" style:family="table-column">
      <style:table-column-properties style:column-width="14mm"/>
    </style:style>
    <style:style style:name="InnerCol6" style:family="table-column">
      <style:table-column-properties style:column-width="8mm"/>
    </style:style>
    <style:style style:name="InnerCol7" style:family="table-column">
      <style:table-column-properties style:column-width="9mm"/>
    </style:style>
    <style:style style:name="OuterRow1" style:family="table-row">
      <style:table-row-properties style:row-height="57mm"/>
    </style:style>
    <style:style style:name="OuterRow2" style:family="table-row">
      <style:table-row-properties style:row-height="45mm"/>
    </style:style>
    <style:style style:name="OuterRow3" style:family="table-row">
      <style:table-row-properties style:row-height="48mm"/>
    </style:style>
    <style:style style:name="OuterRow4" style:family="table-row">
      <style:table-row-properties style:row-height="66mm"/>
    </style:style>
    <style:style style:name="OuterRow5" style:family="table-row">
      <style:table-row-properties style:row-height="55mm"/>
    </style:style>
    <style:style style:name="InnerRow1" style:family="table-row">
      <style:table-row-properties style:row-height="69mm"/>
    </style:style>
    <style:style style:name="InnerRow2" style:family="table-row">
      <style:table-row-properties style:row-height="31mm"/>
    </style:style>
    <style:style style:name="InnerRow3" style:family="table-row">
      <style:table-row-properties style:row-height="171mm"/>
    </style:style>
    <style:style style:name="GridCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.4pt solid #000000" fo:padding="0.5mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="MergedCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.4pt solid #000000" fo:padding="0mm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="InnerCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0mm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="VerticalText" style:family="paragraph">
      <style:paragraph-properties style:writing-mode="tb-rl" fo:text-align="center" fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="HeaderText" style:family="paragraph">
      <style:paragraph-properties style:writing-mode="tb-rl" fo:text-align="center" fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="SmallVertical" style:family="paragraph">
      <style:paragraph-properties style:writing-mode="tb-rl" fo:text-align="center" fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="FormTitle" style:family="paragraph">
      <style:paragraph-properties style:writing-mode="tb-rl" fo:text-align="center" fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="22pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart"/>
      <table:table table:name="住所変更届出書" table:style-name="OuterTable">
        <table:table-column table:style-name="ColumnLeft"/>
        <table:table-column table:style-name="ColumnEntry"/>
        <table:table-column table:style-name="ColumnEntry"/>
        <table:table-column table:style-name="ColumnEntry"/>
        <table:table-column table:style-name="ColumnEntry"/>
        <table:table-column table:style-name="ColumnEntry"/>
        <table:table-column table:style-name="ColumnTitle"/>
        <table:table-row table:style-name="OuterRow1">
          <table:table-cell table:style-name="MergedCell" table:number-rows-spanned="5">
            <table:table table:name="左欄" table:style-name="InnerTable">
              <table:table-column table:style-name="InnerCol1"/>
              <table:table-column table:style-name="InnerCol2"/>
              <table:table-column table:style-name="InnerCol3"/>
              <table:table-column table:style-name="InnerCol4"/>
              <table:table-column table:style-name="InnerCol5"/>
              <table:table-column table:style-name="InnerCol6"/>
              <table:table-column table:style-name="InnerCol7"/>
              <table:table-row table:style-name="InnerRow1">
                <table:table-cell table:style-name="InnerCell"><text:p text:style-name="VerticalText">栃木県知事　殿</text:p></table:table-cell>
                <table:table-cell table:style-name="InnerCell"><text:p/></table:table-cell>
                <table:table-cell table:style-name="InnerCell"><text:p/></table:table-cell>
                <table:table-cell table:style-name="InnerCell"><text:p/></table:table-cell>
                <table:table-cell table:style-name="InnerCell"><text:p/></table:table-cell>
                <table:table-cell table:style-name="InnerCell"><text:p text:style-name="VerticalText">令和　年　月　日</text:p></table:table-cell>
                <table:table-cell table:style-name="InnerCell"><text:p text:style-name="SmallVertical">左のとおり住所を変更したので届けます。</text:p></table:table-cell>
              </table:table-row>
              <table:table-row table:style-name="InnerRow2">
                <table:table-cell table:style-name="InnerCell"><text:p/></table:table-cell>
                <table:table-cell table:style-name="InnerCell"><text:p/></table:table-cell>
                <table:table-cell table:style-name="InnerCell"><text:p text:style-name="SmallVertical">氏　ふりがな　名</text:p></table:table-cell>
                <table:table-cell table:style-name="InnerCell"><text:p text:style-name="VerticalText">新住所</text:p></table:table-cell>
                <table:table-cell table:style-name="InnerCell"><text:p text:style-name="VerticalText">旧住所</text:p></table:table-cell>
                <table:table-cell table:style-name="InnerCell"><text:p/></table:table-cell>
                <table:table-cell table:style-name="InnerCell"><text:p/></table:table-cell>
              </table:table-row>
              <table:table-row table:style-name="InnerRow3">
                <table:table-cell table:style-name="InnerCell"><text:p/></table:table-cell>
                <table:table-cell table:style-name="InnerCell"><text:p/></table:table-cell>
                <table:table-cell table:style-name="InnerCell"><text:p/></table:table-cell>
                <table:table-cell table:style-name="InnerCell"><text:p/></table:table-cell>
                <table:table-cell table:style-name="InnerCell"><text:p/></table:table-cell>
                <table:table-cell table:style-name="InnerCell"><text:p/></table:table-cell>
                <table:table-cell table:style-name="InnerCell"><text:p/></table:table-cell>
              </table:table-row>
            </table:table>
          </table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="HeaderText">〃第　　　　　　　　　号</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="HeaderText">〃第　　　　　　　　　号</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="HeaderText">〃第　　　　　　　　　号</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="HeaderText">栃木県第　　　　　　　　　号</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="HeaderText">登録記号番号</text:p></table:table-cell>
          <table:table-cell table:style-name="MergedCell" table:number-rows-spanned="5"><text:p text:style-name="FormTitle">住所変更届出書</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="OuterRow2">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="VerticalText">種別</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="OuterRow3">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="VerticalText">長さ（刀剣類）全長（銃砲）</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="OuterRow4">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="VerticalText">銘文</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="OuterRow5">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="VerticalText">住所変更年月日</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>