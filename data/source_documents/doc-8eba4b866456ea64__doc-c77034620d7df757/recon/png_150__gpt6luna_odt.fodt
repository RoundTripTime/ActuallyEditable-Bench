        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="C">(12)所有權人姓名</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">(13)權利範圍</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">(14)權利價值</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="6"><text:p text:style-name="C">（交換前及交換後欄位）</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="6"><text:p text:style-name="C">面積　層　共計　附屬建物面積（平方公尺）</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
