        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">S0700000208</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">(4)所有權</text:p><text:p text:style-name="C">人姓名</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">(5)權利範圍</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">(6)權利價值</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="C">(10)面積</text:p><text:p text:style-name="C">層</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">層</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">共計</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">(11)附屬建物</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">用途</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">面積</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">(平方公尺)</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p>(12)所有權人姓名</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>(13)權利範圍</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>(14)權利價值</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
