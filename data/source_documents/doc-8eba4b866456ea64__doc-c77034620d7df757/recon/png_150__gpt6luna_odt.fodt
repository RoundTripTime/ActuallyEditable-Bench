      <text:p text:style-name="Pg"/>
      <table:table table:name="Page3" table:style-name="T">
        <table:table-column table:style-name="Col" table:number-columns-repeated="12"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">S0700000208</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">(15)</text:p><text:p text:style-name="C">申</text:p><text:p text:style-name="C">請</text:p><text:p text:style-name="C">登</text:p><text:p text:style-name="C">記</text:p><text:p text:style-name="C">以</text:p><text:p text:style-name="C">外</text:p><text:p text:style-name="C">之</text:p><text:p text:style-name="C">約</text:p><text:p text:style-name="C">定</text:p><text:p text:style-name="C">事</text:p><text:p text:style-name="C">項</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p>1.他項權利情形及處理方法：</text:p><text:p/><text:p>2.交換權利差額及補償情形：</text:p><text:p/><text:p>3.</text:p><text:p/><text:p>4.</text:p><text:p/><text:p>5.</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="C">(16)</text:p><text:p text:style-name="C">簽</text:p><text:p text:style-name="C">名</text:p><text:p text:style-name="C">或</text:p><text:p text:style-name="C">簽</text:p><text:p text:style-name="C">證</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="C">訂</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="C">(17)</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p text:style-name="C">(18)</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">(19)</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p text:style-name="C">(20)住所</text:p><text:p text:style-name="C">所</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p text:style-name="C">(21)</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Pg"/>
      <table:table table:name="Page4" table:style-name="T">
        <table:table-column table:style-name="Col" table:number-columns-repeated="12"/>
        <table:table-row>
