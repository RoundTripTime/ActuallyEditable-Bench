<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:default-style>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="C" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="100%" fo:text-align="center"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Pg" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="1pt"/>
    </style:style>
    <style:style style:name="Blue" style:family="text">
      <style:text-properties fo:color="#0000FF"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="Landscape">
      <style:page-layout-properties fo:page-width="29.7cm" fo:page-height="21cm" fo:margin="1.3cm"/>
    </style:page-layout>
    <style:style style:name="T" style:family="table">
      <style:table-properties style:width="27.1cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="Col" style:family="table-column">
      <style:table-column-properties style:column-width="2.258cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CenterCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Head" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="100%" fo:text-align="center"/>
      <style:text-properties fo:font-size="16pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="100%" fo:text-align="center"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="Landscape"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Pg"/>
      <table:table table:name="Page1" table:style-name="T">
        <table:table-column table:style-name="Col" table:number-columns-repeated="12"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="12"><text:p text:style-name="Small">S0700000208</text:p><text:p text:style-name="Head">土　地</text:p><text:p text:style-name="Head">所有權交換移轉契約書</text:p><text:p text:style-name="Head">建築改良物</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>下列</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>土地</text:p><text:p>建物</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="10"><text:p>經所有權人雙方同意所有權交換移轉，特訂立本契約：</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="6"><text:p text:style-name="C">土地　交換前　　　　　　　交換後</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="6"><text:p text:style-name="C">建物　交換前　　　　　　　交換後</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="C">土地</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">(1)</text:p><text:p text:style-name="C">鄉鎮</text:p><text:p text:style-name="C">市區</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">段</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">小段</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">(2)地號</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">(3)面積</text:p><text:p text:style-name="C">(平方公尺)</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="C">(7)建號</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">(8)</text:p><text:p text:style-name="C">鄉鎮市區</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">街路</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">段巷弄</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">號樓</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">(9)段</text:p><text:p text:style-name="C">小段</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="C">標示</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">落</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
