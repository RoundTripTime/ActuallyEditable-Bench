  <office:body>
    <office:text>
      <text:p text:style-name="Heading">臺中市政府地方稅務局</text:p>
      <text:p text:style-name="Title">以電子方式傳送繳款書、轉帳通知及繳納證明申請書</text:p>
      <table:table table:name="ApplicationForm" table:style-name="FormTable">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">申請類別</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">□申請/變更 □取消 以 E-mail 傳送下列稅目文件</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GrayCell"><text:p text:style-name="Center">電子郵件信箱</text:p></table:table-cell>
