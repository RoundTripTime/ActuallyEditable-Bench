<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.12cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="12pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Logo" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="12pt" fo:font-weight="bold" fo:color="#254C5E"/>
    </style:style>
    <style:style style:name="LogoSub" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.32cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#254C5E"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.1cm" fo:margin-bottom="0.04cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="24pt" fo:color="#4776C9"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.46cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="17pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Heading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.42cm" fo:margin-bottom="0.06cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="19pt" fo:color="#315C9F"/>
    </style:style>
    <style:style style:name="LongHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.38cm" fo:margin-bottom="0.06cm" fo:line-height="125%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="19pt" fo:color="#315C9F"/>
    </style:style>
    <style:style style:name="TableText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="12pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Footer" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.65cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="12pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="PageTwoHeading" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0.12cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="19pt" fo:color="#315C9F"/>
    </style:style>
    <style:style style:name="Permission" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.38cm" fo:margin-bottom="0.3cm" fo:line-height="150%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="12pt" fo:font-weight="bold" fo:color="#000000"/>
    </style:style>
    <style:style style:name="BreakPara" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="1pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="2.5cm" fo:margin-bottom="2.5cm" fo:margin-left="2.5cm" fo:margin-right="2.5cm" style:print-orientation="portrait"/>
    </style:page-layout>
    <style:style style:name="Table" style:family="table">
      <style:table-properties style:width="16cm" table:align="left"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="ColLabel" style:family="table-column">
      <style:table-column-properties style:column-width="5.2cm"/>
    </style:style>
    <style:style style:name="ColValue" style:family="table-column">
      <style:table-column-properties style:column-width="10.8cm"/>
    </style:style>
    <style:style style:name="ColSupportA" style:family="table-column">
      <style:table-column-properties style:column-width="6.1cm"/>
    </style:style>
    <style:style style:name="ColSupportB" style:family="table-column">
      <style:table-column-properties style:column-width="9.9cm"/>
    </style:style>
    <style:style style:name="ColLearnA" style:family="table-column">
      <style:table-column-properties style:column-width="4.5cm"/>
    </style:style>
    <style:style style:name="ColLearnB" style:family="table-column">
      <style:table-column-properties style:column-width="3.0cm"/>
    </style:style>
    <style:style style:name="ColLearnC" style:family="table-column">
      <style:table-column-properties style:column-width="5.0cm"/>
    </style:style>
    <style:style style:name="ColLearnD" style:family="table-column">
      <style:table-column-properties style:column-width="3.5cm"/>
    </style:style>
    <style:style style:name="ColSigA" style:family="table-column">
      <style:table-column-properties style:column-width="8cm"/>
    </style:style>
    <style:style style:name="ColSigB" style:family="table-column">
      <style:table-column-properties style:column-width="8cm"/>
    </style:style>
    <style:style style:name="BlueText" style:family="text">
      <style:text-properties fo:color="#315C9F"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Logo">East Sussex</text:p>
      <text:p text:style-name="LogoSub">County Council</text:p>
      <text:p text:style-name="Title">The East Sussex Integrated Progress Review Part 2 summary.</text:p>
      <text:p text:style-name="Subtitle">(For settings using online learning journeys to complete a progress check at age two)</text:p>
      <text:p text:style-name="Heading">Child and family information</text:p>
      <table:table table:name="ChildFamily" table:style-name="Table">
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColValue"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Name of Child</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Date of Birth</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Postcode</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Parents or Carers Names</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Home language</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Heading">Early Education Information</text:p>
      <table:table table:name="EarlyEducation" table:style-name="Table">
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColValue"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Name of early years<text:line-break/>setting</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Any other setting<text:line-break/>attended</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Number of hours per<text:line-break/>week at setting.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Name of the person<text:line-break/>completing the form</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="LongHeading">Support already in place from other professionals or agencies/referrals made (if applicable).</text:p>
      <table:table table:name="SupportReferrals" table:style-name="Table">
        <table:table-column table:style-name="ColSupportA"/>
        <table:table-column table:style-name="ColSupportB"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Name</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Agency</text:p></table:table-cell>
        </table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Footer">Page 1 of 2                Version 2, updated July25        eastsussex.gov.uk</text:p>

      <text:p text:style-name="PageTwoHeading">Child’s learning and development.</text:p>
      <table:table table:name="LearningDevelopment" table:style-name="Table">
        <table:table-column table:style-name="ColLearnA"/>
        <table:table-column table:style-name="ColLearnB"/>
        <table:table-column table:style-name="ColLearnC"/>
        <table:table-column table:style-name="ColLearnD"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Is the child<text:line-break/>‘on track’ or<text:line-break/>is additional<text:line-break/>support in<text:line-break/>place?</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Brief overview of<text:line-break/>strategies being used if<text:line-break/>applicable or specifics<text:line-break/>of referrals made.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Is further<text:line-break/>support needed<text:line-break/>from HV team?<text:line-break/><text:span text:style-name="BlueText">Yes/No</text:span><text:line-break/>Please specify<text:line-break/>support required.</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Personal, social and<text:line-break/>emotional<text:line-break/>development</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Communication and<text:line-break/>language</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Physical<text:line-break/>development</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Permission">Please ensure that you have parent/carer permission to share this information<text:line-break/>with the Health Visiting team – see the document Important Information for<text:line-break/>Completing Part 2</text:p>
      <text:p text:style-name="Heading">Parent or Carer Signatures</text:p>
      <table:table table:name="ParentCarerSignatures" table:style-name="Table">
        <table:table-column table:style-name="ColSigA"/>
        <table:table-column table:style-name="ColSigB"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Name</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Signature (or state where this held).</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">Date</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Footer">Page 2 of 2                Version 2, updated July25        eastsussex.gov.uk</text:p>
    </office:text>
  </office:body>
</office:document>