<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Default" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.12cm" fo:line-height="120%"/>
      <style:text-properties style:font-name="Serif" fo:font-size="11pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="1.7cm" fo:margin-bottom="1.7cm" fo:margin-left="1.9cm" fo:margin-right="1.9cm"/>
    </style:page-layout>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="1pt"/>
    </style:style>
    <style:style style:name="CenterTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.3cm" fo:margin-bottom="0.55cm"/>
      <style:text-properties style:font-name="Serif" fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="RightDate" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0.4cm" fo:margin-bottom="0.8cm"/>
      <style:text-properties style:font-name="Serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="BodyText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.15cm" fo:margin-bottom="0.15cm" fo:line-height="150%"/>
      <style:text-properties style:font-name="Serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="SmallText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties style:font-name="Serif" fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="TableText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="120%"/>
      <style:text-properties style:font-name="Serif" fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Centered" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties style:font-name="Serif" fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.6pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="BoxCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.6pt solid #000000" fo:padding="0.12cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="C1" style:family="table-column">
      <style:table-column-properties style:column-width="0.8cm"/>
    </style:style>
    <style:style style:name="C2" style:family="table-column">
      <style:table-column-properties style:column-width="2.5cm"/>
    </style:style>
    <style:style style:name="C3" style:family="table-column">
      <style:table-column-properties style:column-width="7cm"/>
    </style:style>
    <style:style style:name="C4" style:family="table-column">
      <style:table-column-properties style:column-width="2cm"/>
    </style:style>
    <style:style style:name="C5" style:family="table-column">
      <style:table-column-properties style:column-width="6.5cm"/>
    </style:style>
    <style:style style:name="D1" style:family="table-column">
      <style:table-column-properties style:column-width="3cm"/>
    </style:style>
    <style:style style:name="D2" style:family="table-column">
      <style:table-column-properties style:column-width="4cm"/>
    </style:style>
    <style:style style:name="D3" style:family="table-column">
      <style:table-column-properties style:column-width="4cm"/>
    </style:style>
    <style:style style:name="D4" style:family="table-column">
      <style:table-column-properties style:column-width="5.8cm"/>
    </style:style>
    <style:style style:name="ImageRow" style:family="table-row">
      <style:table-row-properties style:row-height="8.3cm"/>
    </style:style>
    <style:style style:name="LargeRow" style:family="table-row">
      <style:table-row-properties style:row-height="2.8cm"/>
    </style:style>
    <style:style style:name="Page2Break" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="1pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="BodyText">別記第１号様式（第５条関係）</text:p>
      <text:p text:style-name="CenterTitle">北広島市ふるさと納税返礼品登録申請書</text:p>
      <text:p text:style-name="RightDate">年　　　月　　　日</text:p>
      <text:p text:style-name="BodyText">　　　北広島市長　様</text:p>
      <text:p text:style-name="BodyText">北広島市ふるさと納税返礼品登録要領に基づき、下記の品目を返礼品として申請します。</text:p>
      <text:p text:style-name="BodyText">また、申請に当たり、裏面の留意事項を承諾し、市税の納付状況について市が確認するこ</text:p>
      <text:p text:style-name="BodyText">とについて同意します。</text:p>
      <table:table table:name="申請者">
        <table:table-column table:style-name="C1"/>
        <table:table-column table:style-name="C2"/>
        <table:table-column table:style-name="C3"/>
        <table:table-column table:style-name="C4"/>
        <table:table-column table:style-name="C5"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="3"><text:p text:style-name="Centered">申<br/>請<br/>者</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">事業者名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"/>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">所　在　地</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"/>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">代表者名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"/>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <table:table table:name="担当者">
        <table:table-column table:style-name="C1"/>
        <table:table-column table:style-name="C2"/>
        <table:table-column table:style-name="C3"/>
        <table:table-column table:style-name="C4"/>
        <table:table-column table:style-name="C5"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="4"><text:p text:style-name="Centered">担<br/>当<br/>者</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">氏　名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">部署名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">電　話</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">ＦＡＸ</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">メール</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"/>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">ＵＲＬ</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"/>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="BodyText">○返礼品の内容（２セット目以降は、下記のみ記載して提出してください。）</text:p>
      <table:table table:name="返礼品の内容">
        <table:table-column table:style-name="D1"/>
        <table:table-column table:style-name="D2"/>
        <table:table-column table:style-name="D3"/>
        <table:table-column table:style-name="D4"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Centered">名　称</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="ImageRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">返礼品<br/>内　容</text:p></table:table-cell>
          <table:table-cell table:style-name="BoxCell" table:number-columns-spanned="2"><text:p text:style-name="SmallText">（内訳・量・規格等）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">消費期限<br/><br/>※飲食物の場合記入</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">提供可能期間</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="TableText">1　通年　　　　　　　2　期間限定（　　月　～　　月）</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">提供可能数</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="TableText">1　　　個/月　　　　2　　　個/年</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">価　格</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="TableText">返礼品　　　　　　　　　円（税込）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">※配送料　　　　　　　　　円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">配送方法</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="TableText">1　常温　　　　　　　2　冷蔵　　　　　　　3　冷凍</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BoxCell" table:number-columns-spanned="4"><text:p text:style-name="TableText">返礼品のＰＲ（120文字以内）</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="LargeRow">
          <table:table-cell table:style-name="BoxCell" table:number-columns-spanned="4"/>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BoxCell" table:number-columns-spanned="4"><text:p text:style-name="TableText">特記事項</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="LargeRow">
          <table:table-cell table:style-name="BoxCell" table:number-columns-spanned="4"/>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="SmallText">※配送料については、返礼品の送付に係る金額として最も高い金額を記入してください。</text:p>
      <text:p text:style-name="Page2Break"/>
      <table:table table:name="イメージ画像">
        <table:table-column table:style-name="D1"/>
        <table:table-column table:style-name="D2"/>
        <table:table-column table:style-name="D3"/>
        <table:table-column table:style-name="D4"/>
        <table:table-row table:style-name="ImageRow">
          <table:table-cell table:style-name="BoxCell" table:number-columns-spanned="4"><text:p text:style-name="TableText">イメージ画像</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="BodyText">※返礼品の写真については、画像データ（JPG 形式）で提出してください。</text:p>
      <text:p text:style-name="BodyText">　サイズ横650px×縦400px以上の画像の場合は、HP 等できれいに表示されます。</text:p>
      <text:p text:style-name="BodyText">留　意　事　項</text:p>
      <text:p text:style-name="BodyText">１　返礼品に関して寄附者から苦情があったときは、真摯に対応してその解決に努めるものとし、苦情内容について市に報告すること。</text:p>
      <text:p text:style-name="BodyText">２　返礼品の販売中止、内容の変更又は返礼品として提供ができなくなったときは、速やかに市に報告すること。</text:p>
      <text:p text:style-name="BodyText">３　返礼品の提供に係る業務で知り得た情報について、返礼品の発送以外の目的に使用しないこと。ただし、寄附者から事業者に改めて商品の申込み等があり、当該申込み等により把握した情報については、この限りでない。</text:p>
      <text:p text:style-name="BodyText">４　北広島市ふるさと納税返礼品登録要領に定める要件に該当しなくなったとき、申請内容に虚偽若しくは不正があったとき又は市若しくは寄附者に対し損害を与えたときは、返礼品の登録が取り消されることがあること。</text:p>
    </office:text>
  </office:body>
</office:document>