<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
                 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
                 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
                 xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
                 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
                 office:mimetype="application/vnd.oasis.opendocument.text"
                 office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:line-height="1.2"/>
      <style:text-properties fo:font-family="serif" style:font-family-asian="serif" fo:font-size="12pt" style:font-size-asian="12pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-bottom="0.75cm"/>
      <style:text-properties fo:font-family="serif" style:font-family-asian="serif" fo:font-size="14pt" style:font-size-asian="14pt"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.55cm"/>
      <style:text-properties fo:font-family="serif" style:font-family-asian="serif" fo:font-size="12pt" style:font-size-asian="12pt"/>
    </style:style>
    <style:style style:name="Subsection" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.7cm"/>
      <style:text-properties fo:font-family="serif" style:font-family-asian="serif" fo:font-size="12pt" style:font-size-asian="12pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-left="2.5cm" fo:margin-right="2.5cm" fo:margin-top="2.5cm" fo:margin-bottom="2.5cm"/>
    </style:page-layout>
    <style:style style:name="Applicant" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="7.3cm" fo:line-height="1.45"/>
    </style:style>
    <style:style style:name="SectionOne" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.75cm" fo:margin-bottom="3.7cm"/>
    </style:style>
    <style:style style:name="SectionTwo" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.3cm" fo:margin-bottom="0.25cm"/>
    </style:style>
    <style:style style:name="SubArea" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.7cm" fo:margin-top="3.45cm" fo:margin-bottom="0.4cm"/>
    </style:style>
    <style:style style:name="LastSubArea" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.7cm" fo:margin-top="3.45cm" fo:margin-bottom="0.1cm"/>
    </style:style>
    <style:style style:name="PageTwoStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-left="0.7cm" fo:margin-bottom="2.55cm"/>
    </style:style>
    <style:style style:name="PageTwoSection" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.55cm" fo:margin-top="0.15cm" fo:margin-bottom="2.5cm"/>
    </style:style>
    <style:style style:name="FinanceHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.55cm" fo:margin-top="0.15cm" fo:margin-bottom="0.1cm"/>
    </style:style>
    <style:style style:name="FinanceLabel" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.45cm" fo:margin-top="0.05cm" fo:margin-bottom="0.05cm"/>
    </style:style>
    <style:style style:name="FinanceTable" style:family="table">
      <style:table-properties table:align="left" style:width="13.3cm"/>
    </style:style>
    <style:style style:name="FinanceColA" style:family="table-column">
      <style:table-column-properties style:column-width="3.3cm"/>
    </style:style>
    <style:style style:name="FinanceColB" style:family="table-column">
      <style:table-column-properties style:column-width="1.0cm"/>
    </style:style>
    <style:style style:name="FinanceColC" style:family="table-column">
      <style:table-column-properties style:column-width="3.9cm"/>
    </style:style>
    <style:style style:name="FinanceColD" style:family="table-column">
      <style:table-column-properties style:column-width="1.0cm"/>
    </style:style>
    <style:style style:name="FinanceColE" style:family="table-column">
      <style:table-column-properties style:column-width="4.1cm"/>
    </style:style>
    <style:style style:name="FinanceCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="UnderlineCell" style:family="table-cell">
      <style:table-cell-properties fo:border-bottom="0.5pt solid #000000" fo:padding="0cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="FinanceRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.55cm"/>
    </style:style>
    <style:style style:name="FinancePara" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm"/>
      <style:text-properties fo:font-family="serif" style:font-family-asian="serif" fo:font-size="12pt" style:font-size-asian="12pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">事　業　計　画　書（概要書）</text:p>
      <text:p text:style-name="Applicant">申請者（転用事業者）</text:p>
      <text:p text:style-name="Applicant">住所</text:p>
      <text:p text:style-name="Applicant">氏名</text:p>

      <text:p text:style-name="SectionOne">１．転用行為の利用目的・必要性</text:p>
      <text:p text:style-name="SectionTwo">２．土地利用計画</text:p>
      <text:p text:style-name="Subsection">（面積の妥当性）</text:p>
      <text:p text:style-name="SubArea">（進入路）</text:p>
      <text:p text:style-name="SubArea">（取水・排水計画）</text:p>
      <text:p text:style-name="LastSubArea">（造成計画）</text:p>
      <text:p text:style-name="PageTwoStart">（周辺農地等への影響・防除策）</text:p>
      <text:p text:style-name="PageTwoSection">３．転用事業の実施予定時期</text:p>
      <text:p text:style-name="FinanceHeading">４．資金計画（概算）</text:p>
      <text:p text:style-name="FinanceLabel">必要経費</text:p>

      <table:table table:name="FinanceTable" table:style-name="FinanceTable">
        <table:table-column table:style-name="FinanceColA"/>
        <table:table-column table:style-name="FinanceColB"/>
        <table:table-column table:style-name="FinanceColC"/>
        <table:table-column table:style-name="FinanceColD"/>
        <table:table-column table:style-name="FinanceColE"/>
        <table:table-row table:style-name="FinanceRow">
          <table:table-cell table:style-name="FinanceCell"><text:p text:style-name="FinancePara">建築工事費</text:p></table:table-cell>
          <table:table-cell table:style-name="FinanceCell"><text:p text:style-name="FinancePara">円、</text:p></table:table-cell>
          <table:table-cell table:style-name="FinanceCell"><text:p text:style-name="FinancePara">その他経費</text:p></table:table-cell>
          <table:table-cell table:style-name="FinanceCell"><text:p text:style-name="FinancePara">万円</text:p></table:table-cell>
          <table:table-cell table:style-name="FinanceCell"><text:p text:style-name="FinancePara"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="FinanceRow">
          <table:table-cell table:style-name="FinanceCell"><text:p text:style-name="FinancePara">計</text:p></table:table-cell>
          <table:table-cell table:style-name="UnderlineCell"><text:p text:style-name="FinancePara"/></table:table-cell>
          <table:table-cell table:style-name="UnderlineCell"><text:p text:style-name="FinancePara"/></table:table-cell>
          <table:table-cell table:style-name="FinanceCell"><text:p text:style-name="FinancePara"/></table:table-cell>
          <table:table-cell table:style-name="FinanceCell"><text:p text:style-name="FinancePara">万円</text:p></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="FinanceLabel">資金内容</text:p>
      <table:table table:name="FundingTable" table:style-name="FinanceTable">
        <table:table-column table:style-name="FinanceColA"/>
        <table:table-column table:style-name="FinanceColB"/>
        <table:table-column table:style-name="FinanceColC"/>
        <table:table-column table:style-name="FinanceColD"/>
        <table:table-column table:style-name="FinanceColE"/>
        <table:table-row table:style-name="FinanceRow">
          <table:table-cell table:style-name="FinanceCell"><text:p text:style-name="FinancePara">自己資金</text:p></table:table-cell>
          <table:table-cell table:style-name="FinanceCell"><text:p text:style-name="FinancePara"/></table:table-cell>
          <table:table-cell table:style-name="FinanceCell"><text:p text:style-name="FinancePara"/></table:table-cell>
          <table:table-cell table:style-name="FinanceCell"><text:p text:style-name="FinancePara"/></table:table-cell>
          <table:table-cell table:style-name="FinanceCell"><text:p text:style-name="FinancePara">万円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="FinanceRow">
          <table:table-cell table:style-name="FinanceCell"><text:p text:style-name="FinancePara"/></table:table-cell>
          <table:table-cell table:style-name="FinanceCell"><text:p text:style-name="FinancePara"/></table:table-cell>
          <table:table-cell table:style-name="UnderlineCell"><text:p text:style-name="FinancePara">計</text:p></table:table-cell>
          <table:table-cell table:style-name="UnderlineCell"><text:p text:style-name="FinancePara"/></table:table-cell>
          <table:table-cell table:style-name="UnderlineCell"><text:p text:style-name="FinancePara">万円</text:p></table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>