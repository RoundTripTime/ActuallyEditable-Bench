<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Base" style:family="paragraph">
      <style:paragraph-properties fo:font-size="12pt" fo:line-height="150%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:text-align="center" fo:margin-bottom="2cm"/>
      <style:text-properties fo:font-size="14pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:margin-top="0.25cm" fo:margin-bottom="0.45cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="BreakPage" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:font-size="1pt" fo:line-height="1pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="2.2cm" fo:margin-bottom="2.2cm" fo:margin-left="2.1cm" fo:margin-right="2.1cm"/>
    </style:page-layout>
    <style:style style:name="FullTable" style:family="table">
      <style:table-properties style:rel-width="100%" table:align="margins" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="GridTable" style:family="table">
      <style:table-properties style:rel-width="100%" table:align="margins" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.16cm" style:vertical-align="top"/>
      <style:paragraph-properties fo:font-size="12pt" fo:line-height="150%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.12cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center" fo:font-size="11pt"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="NoBorderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0.08cm" style:vertical-align="top"/>
      <style:paragraph-properties fo:font-size="12pt"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="WideCol" style:family="table-column">
      <style:table-column-properties style:column-width="17cm"/>
    </style:style>
    <style:style style:name="C1" style:family="table-column">
      <style:table-column-properties style:column-width="5.5cm"/>
    </style:style>
    <style:style style:name="C2" style:family="table-column">
      <style:table-column-properties style:column-width="1.15cm"/>
    </style:style>
    <style:style style:name="C3" style:family="table-column">
      <style:table-column-properties style:column-width="1.15cm"/>
    </style:style>
    <style:style style:name="C4" style:family="table-column">
      <style:table-column-properties style:column-width="1.15cm"/>
    </style:style>
    <style:style style:name="C5" style:family="table-column">
      <style:table-column-properties style:column-width="1.15cm"/>
    </style:style>
    <style:style style:name="C6" style:family="table-column">
      <style:table-column-properties style:column-width="1.15cm"/>
    </style:style>
    <style:style style:name="C7" style:family="table-column">
      <style:table-column-properties style:column-width="1.15cm"/>
    </style:style>
    <style:style style:name="C8" style:family="table-column">
      <style:table-column-properties style:column-width="1.15cm"/>
    </style:style>
    <style:style style:name="C9" style:family="table-column">
      <style:table-column-properties style:column-width="1.15cm"/>
    </style:style>
    <style:style style:name="C10" style:family="table-column">
      <style:table-column-properties style:column-width="1.15cm"/>
    </style:style>
    <style:style style:name="C11" style:family="table-column">
      <style:table-column-properties style:column-width="1.15cm"/>
    </style:style>
    <style:style style:name="OrgCol" style:family="table-column">
      <style:table-column-properties style:column-width="5.66cm"/>
    </style:style>
    <style:style style:name="Role1" style:family="table-column">
      <style:table-column-properties style:column-width="4cm"/>
    </style:style>
    <style:style style:name="Role2" style:family="table-column">
      <style:table-column-properties style:column-width="2.5cm"/>
    </style:style>
    <style:style style:name="Role3" style:family="table-column">
      <style:table-column-properties style:column-width="10.5cm"/>
    </style:style>
    <style:style style:name="RowHead" style:family="table-row">
      <style:table-row-properties style:row-height="1.55cm"/>
    </style:style>
    <style:style style:name="RowSmall" style:family="table-row">
      <style:table-row-properties style:row-height="0.85cm"/>
    </style:style>
    <style:style style:name="RowMedium" style:family="table-row">
      <style:table-row-properties style:row-height="1.6cm"/>
    </style:style>
    <style:style style:name="RowLarge" style:family="table-row">
      <style:table-row-properties style:row-height="5cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Base">様式１別紙</text:p>
      <text:p text:style-name="Title">大崎町地場産品創出等支援事業補助金　企画提案書</text:p>
      <text:p text:style-name="Section">１．提案者について</text:p>
      <table:table table:name="提案者の事業" table:style-name="FullTable">
        <table:table-column table:style-name="WideCol"/>
        <table:table-row table:style-name="RowHead"><table:table-cell table:style-name="Cell"><text:p>①提案者の事業について</text:p></table:table-cell></table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell">
            <text:p>※提案者が通常行っている事業概要をご記入ください。</text:p>
            <text:p/>
            <text:p>（事業概要が記載されているパンフレット等の添付で可）</text:p>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowHead"><table:table-cell table:style-name="Cell"><text:p>②提案する商品等の実績について</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowLarge"><table:table-cell table:style-name="Cell"><text:p>※売上実績や表彰歴があれば、ご記入ください。（新規商品等の場合は、記入不要）</text:p></table:table-cell></table:table-row>
      </table:table>

      <text:p text:style-name="BreakPage"/>
      <table:table table:name="提案者欄の続き" table:style-name="FullTable">
        <table:table-column table:style-name="WideCol"/>
        <table:table-row table:style-name="RowLarge"><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="Section">２．提案内容について</text:p>
      <table:table table:name="提案する商品等について" table:style-name="FullTable">
        <table:table-column table:style-name="WideCol"/>
        <table:table-row table:style-name="RowHead"><table:table-cell table:style-name="Cell"><text:p>①提案する商品等について</text:p></table:table-cell></table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell">
            <text:p>※どのような事業を行うのか事業の全体像やスキーム図、想定する返礼品をご記入下さい。</text:p>
            <text:p/>
            <text:p>【提案する開発商品や生産性増強事業の概要】</text:p>
            <text:p/>
            <text:p>（具体的にどのようなことを行い、どのような効果が得られるか等）</text:p>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p>【返礼品名】</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="BreakPage"/>
      <table:table table:name="商品へのこだわり" table:style-name="FullTable">
        <table:table-column table:style-name="WideCol"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell">
            <text:p>【商品へのこだわり、開発の目標】</text:p>
            <text:p/>
            <text:p>・独創性、新規性</text:p>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p>・市場性、優位性</text:p>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p>・成長の可能性</text:p>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p>・経済波及効果</text:p>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p>・ふるさと納税返礼品としての可能性</text:p>
            <text:p/>
            <text:p/>
            <text:p/>
          </table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="BreakPage"/>
      <table:table table:name="価格設定と収益性" table:style-name="FullTable">
        <table:table-column table:style-name="WideCol"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell">
            <text:p>【商品の価格設定と収益性】</text:p>
            <text:p/>
            <text:p>・収益性、現実性</text:p>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
            <text:p/>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowHead"><table:table-cell table:style-name="Cell">②事業スケジュール</table:table-cell></table:table-row>
      </table:table>
      <table:table table:name="事業スケジュール" table:style-name="GridTable">
        <table:table-column table:style-name="C1"/>
        <table:table-column table:style-name="C2"/>
        <table:table-column table:style-name="C3"/>
        <table:table-column table:style-name="C4"/>
        <table:table-column table:style-name="C5"/>
        <table:table-column table:style-name="C6"/>
        <table:table-column table:style-name="C7"/>
        <table:table-column table:style-name="C8"/>
        <table:table-column table:style-name="C9"/>
        <table:table-column table:style-name="C10"/>
        <table:table-column table:style-name="C11"/>
        <table:table-row table:style-name="RowMedium">
          <table:table-cell table:style-name="CellCenter"><text:p>実施項目</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>月</text:p></table:table-cell><table:table-cell table:style-name="CellCenter"><text:p>月</text:p></table:table-cell><table:table-cell table:style-name="CellCenter"><text:p>月</text:p></table:table-cell><table:table-cell table:style-name="CellCenter"><text:p>月</text:p></table:table-cell><table:table-cell table:style-name="CellCenter"><text:p>月</text:p></table:table-cell><table:table-cell table:style-name="CellCenter"><text:p>月</text:p></table:table-cell><table:table-cell table:style-name="CellCenter"><text:p>月</text:p></table:table-cell><table:table-cell table:style-name="CellCenter"><text:p>月</text:p></table:table-cell><table:table-cell table:style-name="CellCenter"><text:p>月</text:p></table:table-cell><table:table-cell table:style-name="CellCenter"><text:p>月</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowLarge">
          <table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"><text:p>→</text:p></table:table-cell><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/>
        </table:table-row>
        <table:table-row table:style-name="RowLarge">
          <table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"><text:p>→</text:p></table:table-cell><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/>
        </table:table-row>
        <table:table-row table:style-name="RowLarge">
          <table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"><text:p>→</text:p></table:table-cell><table:table-cell table:style-name="CellCenter"><text:p> </text:p></table:table-cell><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/>
        </table:table-row>
        <table:table-row table:style-name="RowLarge">
          <table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"><text:p>→</text:p></table:table-cell><table:table-cell table:style-name="CellCenter"><text:p> </text:p></table:table-cell><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/>
        </table:table-row>
        <table:table-row table:style-name="RowLarge">
          <table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"><text:p>→</text:p></table:table-cell><table:table-cell table:number-columns-spanned="3" table:style-name="CellCenter"><text:p>→</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowLarge">
          <table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"><text:p>→</text:p></table:table-cell><table:table-cell table:number-columns-spanned="3" table:style-name="CellCenter"><text:p>→</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>

      <text:p text:style-name="BreakPage"/>
      <table:table table:name="スケジュール欄の続き" table:style-name="FullTable">
        <table:table-column table:style-name="WideCol"/>
        <table:table-row table:style-name="RowLarge"><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
      </table:table>
      <table:table table:name="運営体制" table:style-name="FullTable">
        <table:table-column table:style-name="WideCol"/>
        <table:table-row table:style-name="RowHead"><table:table-cell table:style-name="Cell"><text:p>③事業の運営体制・連携機関などについて　※別添可</text:p></table:table-cell></table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell">
            <text:p>【運営・組織体制】</text:p>
            <text:p/>
            <text:p/>
            <table:table table:name="組織図" table:style-name="GridTable">
              <table:table-column table:style-name="OrgCol"/><table:table-column table:style-name="OrgCol"/><table:table-column table:style-name="OrgCol"/>
              <table:table-row table:style-name="RowMedium">
                <table:table-cell table:number-columns-spanned="3" table:style-name="CellCenter"><text:p/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
              </table:table-row>
              <table:table-row table:style-name="RowMedium">
                <table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/>
              </table:table-row>
              <table:table-row table:style-name="RowMedium">
                <table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/><table:table-cell table:style-name="CellCenter"/>
              </table:table-row>
            </table:table>
            <text:p/>
            <text:p>【役割等】</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="BreakPage"/>
      <table:table table:name="役職と役割" table:style-name="GridTable">
        <table:table-column table:style-name="Role1"/><table:table-column table:style-name="Role2"/><table:table-column table:style-name="Role3"/>
        <table:table-row table:style-name="RowHead">
          <table:table-cell table:style-name="CellCenter"><text:p>役職等</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>人数</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>役割</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"><text:p>名</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"><text:p>名</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"><text:p>名</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="RowMedium"><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"><text:p>名</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <table:table table:name="法令規制について" table:style-name="FullTable">
        <table:table-column table:style-name="WideCol"/>
        <table:table-row table:style-name="RowHead"><table:table-cell table:style-name="Cell"><text:p>④事業に関する法律、規制について</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowLarge"><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="Section">３．収支計画について</text:p>
      <table:table table:name="事業の収支計画" table:style-name="FullTable">
        <table:table-column table:style-name="WideCol"/>
        <table:table-row table:style-name="RowHead"><table:table-cell table:style-name="Cell"><text:p>事業の収支計画</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="RowLarge"><table:table-cell table:style-name="Cell"><text:p>※別紙「収支計画書（補助対象経費の概算見積書）」のとおり</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="Base">（注１）必要に応じて記入欄を増やして差し支えありません。</text:p>
    </office:text>
  </office:body>
</office:document>