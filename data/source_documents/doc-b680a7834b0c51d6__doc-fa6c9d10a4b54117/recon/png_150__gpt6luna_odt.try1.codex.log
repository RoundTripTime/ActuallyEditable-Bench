      <style:page-layout-properties fo:page-width="8.27in" fo:page-height="11.69in" fo:margin-top="0.65in" fo:margin-bottom="0.55in" fo:margin-left="0.65in" fo:margin-right="0.65in"/>
    </style:page-layout>
