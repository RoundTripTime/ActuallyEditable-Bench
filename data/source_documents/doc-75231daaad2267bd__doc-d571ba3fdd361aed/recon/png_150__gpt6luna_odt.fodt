<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0mm" fo:margin-bottom="1mm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="PhotoText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="InfoText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0mm" fo:margin-bottom="0mm" fo:line-height="150%"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Footnote" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="1mm" fo:margin-bottom="0mm"/>
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" fo:margin-left="15mm" fo:margin-right="15mm" fo:margin-top="15mm" fo:margin-bottom="15mm" style:print-orientation="portrait"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties table:align="left" table:border-model="separating"/>
    </style:style>
    <style:style style:name="PhotoColumn" style:family="table-column">
      <style:table-column-properties style:column-width="124mm"/>
    </style:style>
    <style:style style:name="GapColumn" style:family="table-column">
      <style:table-column-properties style:column-width="4mm"/>
    </style:style>
    <style:style style:name="InfoColumn" style:family="table-column">
      <style:table-column-properties style:column-width="50mm"/>
    </style:style>
    <style:style style:name="PhotoCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="2mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="GapCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0mm"/>
    </style:style>
    <style:style style:name="InfoCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0mm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="InfoInner" style:family="table">
      <style:table-properties table:align="left" table:border-model="separating"/>
    </style:style>
    <style:style style:name="InfoInnerColumn" style:family="table-column">
      <style:table-column-properties style:column-width="50mm"/>
    </style:style>
    <style:style style:name="InfoLineCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0mm"/>
    </style:style>
    <style:style style:name="InfoLabelCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0mm"/>
    </style:style>
    <style:style style:name="InfoRuleCell" style:family="table-cell">
      <style:table-cell-properties fo:border-bottom="0.5pt solid #000000" fo:padding="0mm"/>
    </style:style>
    <style:style style:name="PhotoRow" style:family="table-row">
      <style:table-row-properties style:row-height="58mm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="DefaultPage" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">工事中写真台帳</text:p>
      <table:table table:name="Form" table:style-name="FormTable">
        <table:table-column table:style-name="PhotoColumn"/>
        <table:table-column table:style-name="GapColumn"/>
        <table:table-column table:style-name="InfoColumn"/>
        <table:table-row table:style-name="PhotoRow">
          <table:table-cell table:style-name="PhotoCell">
            <text:p text:style-name="PhotoText">工事箇所の写真</text:p>
            <text:p text:style-name="PhotoText"/>
            <text:p text:style-name="PhotoText">※工事箇所が広範囲にわたる場合は、主要な</text:p>
            <text:p text:style-name="PhotoText">工事箇所の写真を貼り付けてください。</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="GapCell"/>
          <table:table-cell table:style-name="InfoCell">
            <table:table table:name="Info1" table:style-name="InfoInner">
              <table:table-column table:style-name="InfoInnerColumn"/>
              <table:table-row><table:table-cell table:style-name="InfoLabelCell"><text:p text:style-name="InfoText">（申請者）</text:p></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="InfoRuleCell"><text:p text:style-name="InfoText"/></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="InfoLabelCell"><text:p text:style-name="InfoText">（工事箇所）</text:p></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="InfoRuleCell"><text:p text:style-name="InfoText"/></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="InfoRuleCell"><text:p text:style-name="InfoText"/></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="InfoRuleCell"><text:p text:style-name="InfoText"/></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="InfoLabelCell"><text:p text:style-name="InfoText">（工事内容）</text:p></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="InfoRuleCell"><text:p text:style-name="InfoText"/></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="InfoRuleCell"><text:p text:style-name="InfoText"/></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="InfoRuleCell"><text:p text:style-name="InfoText"/></table:table-cell></table:table-row>
            </table:table>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="PhotoRow">
          <table:table-cell table:style-name="PhotoCell">
            <text:p text:style-name="PhotoText">工事箇所の写真</text:p>
            <text:p text:style-name="PhotoText"/>
            <text:p text:style-name="PhotoText">※工事箇所が広範囲にわたる場合は、主要な</text:p>
            <text:p text:style-name="PhotoText">工事箇所の写真を貼り付けてください。</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="GapCell"/>
          <table:table-cell table:style-name="InfoCell">
            <table:table table:name="Info2" table:style-name="InfoInner">
              <table:table-column table:style-name="InfoInnerColumn"/>
              <table:table-row><table:table-cell table:style-name="InfoLabelCell"><text:p text:style-name="InfoText">（工事箇所）</text:p></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="InfoRuleCell"><text:p text:style-name="InfoText"/></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="InfoRuleCell"><text:p text:style-name="InfoText"/></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="InfoRuleCell"><text:p text:style-name="InfoText"/></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="InfoLabelCell"><text:p text:style-name="InfoText">（工事内容）</text:p></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="InfoRuleCell"><text:p text:style-name="InfoText"/></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="InfoRuleCell"><text:p text:style-name="InfoText"/></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="InfoRuleCell"><text:p text:style-name="InfoText"/></table:table-cell></table:table-row>
            </table:table>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="PhotoRow">
          <table:table-cell table:style-name="PhotoCell">
            <text:p text:style-name="PhotoText">工事箇所の写真</text:p>
            <text:p text:style-name="PhotoText"/>
            <text:p text:style-name="PhotoText">※工事箇所が広範囲にわたる場合は、主要な</text:p>
            <text:p text:style-name="PhotoText">工事箇所の写真を貼り付けてください。</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="GapCell"/>
          <table:table-cell table:style-name="InfoCell">
            <table:table table:name="Info3" table:style-name="InfoInner">
              <table:table-column table:style-name="InfoInnerColumn"/>
              <table:table-row><table:table-cell table:style-name="InfoLabelCell"><text:p text:style-name="InfoText">（工事箇所）</text:p></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="InfoRuleCell"><text:p text:style-name="InfoText"/></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="InfoRuleCell"><text:p text:style-name="InfoText"/></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="InfoRuleCell"><text:p text:style-name="InfoText"/></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="InfoLabelCell"><text:p text:style-name="InfoText">（工事内容）</text:p></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="InfoRuleCell"><text:p text:style-name="InfoText"/></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="InfoRuleCell"><text:p text:style-name="InfoText"/></table:table-cell></table:table-row>
              <table:table-row><table:table-cell table:style-name="InfoRuleCell"><text:p text:style-name="InfoText"/></table:table-cell></table:table-row>
            </table:table>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Footnote">※工事箇所が複数にわたる等、状況に応じて必要な部数を作成してください。</text:p>
    </office:text>
  </office:body>
</office:document>