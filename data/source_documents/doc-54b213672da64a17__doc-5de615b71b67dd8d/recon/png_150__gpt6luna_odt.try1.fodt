<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm"/>
      <style:text-properties fo:font-size="10pt" style:font-name="serif"/>
    </style:default-style>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:text-align="center"/>
      <style:text-properties fo:font-size="15pt" style:font-name="serif"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:text-align="center"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm"/>
      <style:text-properties fo:font-size="9pt" style:font-name="serif"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin="0cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.45cm" fo:margin-bottom="1.25cm" fo:margin-left="1.8cm" fo:margin-right="1.8cm"/>
    </style:page-layout>
    <style:style style:name="T" style:family="table">
      <style:table-properties style:width="17.4cm" table:align="margins"/>
    </style:style>
    <style:style style:name="C" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="C0" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Csmall" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.035cm" style:vertical-align="middle"/>
      <style:text-properties fo:font-size="9pt" style:font-name="serif"/>
    </style:style>
    <style:style style:name="Ccenter" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.04cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="1.3cm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="4.8cm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="3.75cm"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties style:column-width="3.75cm"/>
    </style:style>
    <style:style style:name="Col5" style:family="table-column">
      <style:table-column-properties style:column-width="3.8cm"/>
    </style:style>
    <style:style style:name="ColWide1" style:family="table-column">
      <style:table-column-properties style:column-width="3.8cm"/>
    </style:style>
    <style:style style:name="ColWide2" style:family="table-column">
      <style:table-column-properties style:column-width="13.6cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Small">（条例22 条第２項及び第23 条第３項による証明する書類）</text:p>
      <text:p text:style-name="Title">現　況　申　告　書</text:p>
      <text:p text:style-name="P">千代田区長　様　　　　　　　　　　　　　　　　　　　　　　　　　　　　申請日：　　　　　年　　　月　　　日</text:p>

      <table:table table:name="Applicant" table:style-name="T">
        <table:table-column table:style-name="ColWide1"/>
        <table:table-column table:style-name="ColWide2"/>
        <table:table-column table:style-name="ColWide1"/>
        <table:table-column table:style-name="ColWide1"/>
        <table:table-row>
          <table:table-cell table:style-name="Ccenter"><text:p>被 保 険 者 氏 名</text:p></table:table-cell>
          <table:table-cell table:style-name="C"/>
          <table:table-cell table:style-name="Ccenter"><text:p>被 保 険 者 番 号</text:p></table:table-cell>
          <table:table-cell table:style-name="C"/>
        </table:table-row>
      </table:table>

      <text:p text:style-name="P">1　世帯の収入の状況</text:p>
      <table:table table:name="IncomeExpenses" table:style-name="T">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-column table:style-name="Col5"/>
        <table:table-row>
          <table:table-cell table:style-name="Ccenter" table:number-columns-spanned="2" table:number-rows-spanned="2"><text:p>被 保 険 者 本 人</text:p></table:table-cell>
          <table:table-cell table:style-name="Ccenter" table:number-rows-spanned="1"><text:p>世 帯 員 氏 名</text:p></table:table-cell>
          <table:table-cell table:style-name="Ccenter"><text:p>世 帯 員 氏 名</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="C"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="C"/>
          <table:covered-table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Ccenter" table:number-rows-spanned="5"><text:p>直<br/>前<br/>３<br/>ヶ<br/>月<br/>の<br/>平<br/>均<br/>収<br/>入<br/>額</text:p></table:table-cell>
          <table:table-cell table:style-name="C"><text:p>年　金　収　入</text:p></table:table-cell>
          <table:table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"><text:p>給与・事業収入等</text:p></table:cell>
          <table:table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"><text:p>仕　　送　　り</text:p></table:table-cell>
          <table:table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"><text:p>そ　　の　　他</text:p></table:table-cell>
          <table:table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="C"/>
          <table:table-cell table:style-name="Ccenter"><text:p>収入合計（Ⅰ）</text:p></table:table-cell>
          <table:table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Ccenter" table:number-rows-spanned="5"><text:p>直<br/>前<br/>３<br/>ヶ<br/>月<br/>の<br/>必<br/>要<br/>経<br/>費</text:p></table:table-cell>
          <table:table-cell table:style-name="C"><text:p>交　　通　　費</text:p></table:table-cell>
          <table:table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"><text:p>介 護 保 険 料 ・<br/>健 康 保 険 料</text:p></table:table-cell>
          <table:table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"><text:p>住民税・所得税・固<br/>定 資 産 税 等</text:p></table:table-cell>
          <table:table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="C"/>
          <table:table-cell table:style-name="Ccenter"><text:p>その他</text:p></table:table-cell>
          <table:table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="C"/>
          <table:table-cell table:style-name="Ccenter"><text:p>経費合計（Ⅱ）</text:p></table:table-cell>
          <table:table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Ccenter" table:number-columns-spanned="2"><text:p>実収入額（Ⅰ）－（Ⅱ）</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"/>
          <table:table-cell table:style-name="C"/>
        </table:table-row>
      </table:table>

      <text:p text:style-name="Small">※　年金収入は２ヶ月に１度支給されますので、１回の受給額の１／２の額を記入してください。</text:p>
      <text:p text:style-name="Small">※　収入額がわかる給与明細書・預金通帳等の写し等を添付してください。</text:p>
      <text:p text:style-name="Small">※　支払った健康保険料・税金等の領収書を添付してください。</text:p>
      <text:p text:style-name="Small">※　領収書等は直近３ヶ月分です。</text:p>
      <text:p text:style-name="P">2　無収入の申告（上記１で世帯の収入がない場合は、下記の当てはまる番号に○をつけてください。）</text:p>
      <table:table table:name="NoIncome" table:style-name="T">
        <table:table-column table:style-name="ColWide1"/>
        <table:table-column table:style-name="ColWide2"/>
        <table:table-row>
          <table:table-cell table:style-name="Csmall" table:number-columns-spanned="2"><text:p>①　勤務先を失業　　②　事業の休・廃止　　③　長期療養又は入院等</text:p><text:p>④　その他具体的に記入してください。</text:p><text:p>〔　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　〕</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="Csmall"/>
        </table:table-row>
      </table:table>

      <text:p text:style-name="P">3　活用できる資産等の状況（世帯の資産の保有状況）</text:p>
      <table:table table:name="Assets" table:style-name="T">
        <table:table-column table:style-name="ColWide1"/>
        <table:table-column table:style-name="ColWide2"/>
        <table:table-row>
          <table:table-cell table:style-name="C"><text:p>1　居住用の土地</text:p></table:table-cell>
          <table:table-cell table:style-name="C"><text:p>①　保有している　　　　・　　②　保有していない</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C"><text:p>2　居住用以外の不動産</text:p></table:table-cell>
          <table:table-cell table:style-name="C"><text:p>①　保有している　　　　・　　②　保有していない</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C"><text:p>3　現　　金</text:p></table:table-cell>
          <table:table-cell table:style-name="C"><text:p>　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C"><text:p>4　世帯の預貯金の額</text:p></table:table-cell>
          <table:table-cell table:style-name="C"><text:p>　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="C"><text:p>5　有価証券・生命保険等</text:p></table:table-cell>
          <table:table-cell table:style-name="C"><text:p>　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　円</text:p></table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>