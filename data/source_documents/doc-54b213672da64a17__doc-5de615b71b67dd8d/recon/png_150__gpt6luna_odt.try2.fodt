<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0.08cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:break-before="page" fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0.05cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%" fo:margin-top="0.18cm" fo:margin-bottom="0.08cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end" fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="9pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="Page">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="1.8cm" fo:margin-right="1.8cm" fo:margin-top="1.5cm" fo:margin-bottom="1.5cm"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table"/>
    <style:style style:name="C1" style:family="table-column">
      <style:table-column-properties style:column-width="0.75cm"/>
    </style:style>
    <style:style style:name="C2" style:family="table-column">
      <style:table-column-properties style:column-width="3.7cm"/>
    </style:style>
    <style:style style:name="C3" style:family="table-column">
      <style:table-column-properties style:column-width="4.5cm"/>
    </style:style>
    <style:style style:name="C4" style:family="table-column">
      <style:table-column-properties style:column-width="4.5cm"/>
    </style:style>
    <style:style style:name="C5" style:family="table-column">
      <style:table-column-properties style:column-width="4.5cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.04cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="CenterCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.04cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center" fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="RightCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.04cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="end" fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="DiagonalCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" style:diagonal-bl-tr="0.5pt solid #000000" fo:padding="0.04cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="NarrowCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.02cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center" fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="8pt"/>
    </style:style>
    <style:style style:name="AssetLabel" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:line-height="100%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="9pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="Page"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Small">（条例 22 条第 2 項及び第 23 条第 3 項による証明する書類）</text:p>
      <text:p text:style-name="Title">現　況　申　告　書</text:p>
      <text:p text:style-name="Body">千代田区長　様　　　　　　　　　　　　　　　　　　　　　　　　　　　申請日：　　　　　年　　　月　　　日</text:p>
      <table:table table:name="Applicant" table:style-name="FormTable">
        <table:table-column table:style-name="C2"/>
        <table:table-column table:style-name="C3"/>
        <table:table-column table:style-name="C2"/>
        <table:table-column table:style-name="C3"/>
        <table:table-row>
          <table:table-cell table:style-name="CenterCell"><text:p>被　保　険　者　氏　名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p>被　保　険　者　番　号</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="Section">1　世帯の収入の状況</text:p>
      <table:table table:name="Income" table:style-name="FormTable">
        <table:table-column table:style-name="C1"/>
        <table:table-column table:style-name="C2"/>
        <table:table-column table:style-name="C3"/>
        <table:table-column table:style-name="C4"/>
        <table:table-column table:style-name="C5"/>
        <table:table-row>
          <table:table-cell table:style-name="DiagonalCell" table:number-columns-spanned="2" table:number-rows-spanned="2"><text:p/></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CenterCell" table:number-rows-spanned="2"><text:p>被　保　険　者　本　人</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p>世　帯　員　氏　名</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p>世　帯　員　氏　名</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="NarrowCell" table:number-rows-spanned="5"><text:p>直</text:p><text:p>前</text:p><text:p>３</text:p><text:p>ヶ</text:p><text:p>月</text:p><text:p>の</text:p><text:p>平</text:p><text:p>均</text:p><text:p>収</text:p><text:p>入</text:p><text:p>額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>年　金　収　入</text:p></table:table-cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:table-cell>
          <table:table-cell table:style-name="RightCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>給与・事業収入等</text:p></table:table-cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:table-cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:table-cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>仕　　送　　り</text:p></table:table-cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:table-cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:table-cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>そ　　の　　他</text:p></table:table-cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:table-cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:table-cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>収入合計（Ⅰ）</text:p></table:table-cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:table-cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:table-cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="NarrowCell" table:number-rows-spanned="5"><text:p>直</text:p><text:p>前</text:p><text:p>３</text:p><text:p>ヶ</text:p><text:p>月</text:p><text:p>の</text:p><text:p>必</text:p><text:p>要</text:p><text:p>経</text:p><text:p>費</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>交　　通　　費</text:p></table:table-cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:table-cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:table-cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>介護保険料・</text:p><text:p>健 康 保 険 料</text:p></table:table-cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:table-cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:table-cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>住民税・所得税・固定資産税等</text:p></table:table-cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:table-cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>その他</text:p></table:table-cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:table-cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>経費合計（Ⅱ）</text:p></table:cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>実収入額（Ⅰ）－（Ⅱ）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:table-cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:table-cell>
          <table:table-cell table:style-name="RightCell"><text:p>円</text:p></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="Small">※　年金収入は２ヶ月に１度支給されますので、１回の受給額の１／２の額を記入してください。</text:p>
      <text:p text:style-name="Small">※　収入額がわかる給与明細書・預金通帳等の写し等を添付してください。</text:p>
      <text:p text:style-name="Small">※　支払った健康保険料・税金等の領収書を添付してください。</text:p>
      <text:p text:style-name="Small">※　領収書等は直近３ヶ月分です。</text:p>

      <text:p text:style-name="Section">2　無収入の申告（上記１で世帯の収入がない場合は、下記の当てはまる番号に○をつけてください。）</text:p>
      <table:table table:name="NoIncome" table:style-name="FormTable">
        <table:table-column table:style-name="C1"/>
        <table:table-column table:style-name="C2"/>
        <table:table-column table:style-name="C3"/>
        <table:table-column table:style-name="C4"/>
        <table:table-column table:style-name="C5"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p>①　勤務先を失業　　②　事業の休・廃止　　③　長期療養又は入院等</text:p><text:p>④　その他具体的に記入してください。</text:p><text:p>〔　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　〕</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>

      <text:p text:style-name="Section">3　活用できる資産等の状況（世帯の資産の保有状況）</text:p>
      <table:table table:name="Assets" table:style-name="FormTable">
        <table:table-column table:style-name="C2"/>
        <table:table-column table:style-name="C3"/>
        <table:table-column table:style-name="C3"/>
        <table:table-column table:style-name="C3"/>
        <table:table-column table:style-name="C3"/>
        <table:table-row>
          <table:table-cell table:style-name="AssetLabel"><text:p>1　居住用の土地</text:p></table:table-cell>
          <table:table-cell table:style-name="AssetLabel" table:number-columns-spanned="4"><text:p>①　保有している　　　　　・　　②　保有していない</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="AssetLabel"><text:p>2　居住用以外の不動産</text:p></table:table-cell>
          <table:table-cell table:style-name="AssetLabel" table:number-columns-spanned="4"><text:p>①　保有している　　　　　・　　②　保有していない</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="AssetLabel"><text:p>3　現　　金</text:p></table:table-cell>
          <table:table-cell table:style-name="RightCell" table:number-columns-spanned="4"><text:p>円</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="AssetLabel"><text:p>4　世帯の預貯金の額</text:p></table:table-cell>
          <table:table-cell table:style-name="RightCell" table:number-columns-spanned="4"><text:p>円</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="AssetLabel"><text:p>5　有価証券・生命保険等</text:p></table:table-cell>
          <table:table-cell table:style-name="RightCell" table:number-columns-spanned="4"><text:p>円</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>