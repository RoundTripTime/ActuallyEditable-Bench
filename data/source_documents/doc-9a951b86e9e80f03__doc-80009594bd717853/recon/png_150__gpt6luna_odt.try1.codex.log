    <office:text>
      <text:p text:style-name="Title1">勞工保險、就業保險、勞工職業災害保險</text:p>
      <text:p text:style-name="Title2">爭議事項審議申請書</text:p>
      <text:p text:style-name="Subtitle">（請先詳閱背面填表須知）</text:p>
      <text:p text:style-name="DateLine">填表日期　　　　年　　月　　日</text:p>
      <table:table table:name="申請書表格">
