<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:default-style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-left="1.5cm" fo:margin-right="1.5cm" fo:margin-top="2cm" fo:margin-bottom="2cm"/>
    </style:page-layout>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.35cm" fo:margin-bottom="0.55cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="Date" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end" fo:margin-top="0.1cm" fo:margin-bottom="0.2cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="2.6cm" fo:margin-top="0.1cm" fo:margin-bottom="0.05cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Contact" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="7.7cm" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="140%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="BodyText" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.3cm" fo:margin-right="0.1cm" fo:margin-top="0.55cm" fo:margin-bottom="0cm" fo:line-height="140%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="BodyTextNext" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.3cm" fo:margin-right="0.1cm" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="140%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="TableStyle" style:family="table">
      <style:table-properties style:width="17cm" table:align="center"/>
    </style:style>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="0.55cm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="3.25cm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="6.6cm"/>
    </style:style>
    <style:style style:name="ColD" style:family="table-column">
      <style:table-column-properties style:column-width="6.6cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm"/>
    </style:style>
    <style:style style:name="CenterCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm"/>
    </style:style>
    <style:style style:name="CellPara" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="RedNotes" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.3cm" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="140%"/>
      <style:text-properties fo:color="#FF0000" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Evidence" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.3cm" fo:margin-top="0.45cm" fo:margin-bottom="0cm" fo:line-height="140%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="EvidenceNext" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.5cm" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="140%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="EvidenceArrow" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.8cm" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="140%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">旧ＩＣカード使用届</text:p>
      <text:p text:style-name="Date">年　月　日</text:p>
      <text:p text:style-name="Recipient">殿</text:p>
      <text:p text:style-name="Contact">住所</text:p>
      <text:p text:style-name="Contact">商号</text:p>
      <text:p text:style-name="Contact">代表者（受任者）氏名</text:p>
      <text:p text:style-name="Contact">担当者氏名</text:p>
      <text:p text:style-name="Contact">連絡先</text:p>
      <text:p text:style-name="BodyText">このたび、入札参加資格者名簿の登録内容変更に伴いＩＣカードの登録内容を変更することと</text:p>
      <text:p text:style-name="BodyTextNext">なりました。</text:p>
      <text:p text:style-name="BodyTextNext">現在新ＩＣカード取得の手続き中のため、新ＩＣカード取得までの間、旧ＩＣカードの使用に</text:p>
      <text:p text:style-name="BodyTextNext">ついて下記のとおり届け出ます。</text:p>
      <table:table table:name="FormTable" table:style-name="TableStyle">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColD"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="CellPara">認定番号</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="CellPara"/></table:table-cell>
          <table:covered-table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="CellPara">調達案件番号</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="CellPara"/></table:table-cell>
          <table:covered-table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="CellPara">調達案件名称</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="CellPara"/></table:table-cell>
          <table:covered-table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellPara"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellPara">登録内容の変更項目</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellPara">旧ＩＣカードの情報</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellPara">新ＩＣカードの情報</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="3"><text:p text:style-name="CellPara"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellPara">商　号</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellPara"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellPara"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellPara">代表者<br/>（又は受任者）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellPara"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellPara"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellPara">本店住所</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellPara"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellPara"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="CellPara">旧ＩＣカードを使用する理由</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="CellPara"/></table:table-cell>
          <table:covered-table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="RedNotes">【留意点】</text:p>
      <text:p text:style-name="RedNotes">※本届出には、以下の根拠書類を添付してください。</text:p>
      <text:p text:style-name="RedNotes">※提出期限は、参加を希望する案件の資格申請期限日までです。（原則）</text:p>
      <text:p text:style-name="RedNotes">※資格申請期限日までに根拠書類が提出できない場合は、本届出のみを先に提出し、入札開</text:p>
      <text:p text:style-name="RedNotes">始日前日までに根拠書類を追って提出してください。</text:p>
      <text:p text:style-name="RedNotes">※入札開始日前日までに根拠書類を提出されない場合は、入札を行っても無効とみなします。</text:p>
      <text:p text:style-name="RedNotes">※本届出提出後、入札開始日前日までに根拠書類が提出できない場合は、「紙入札承認願」を</text:p>
      <text:p text:style-name="RedNotes">提出し、紙入札への切り替えをお願いします。</text:p>
      <text:p text:style-name="Evidence">（根拠書類）</text:p>
      <text:p text:style-name="EvidenceNext">法人代表者・法人住所変更の場合</text:p>
      <text:p text:style-name="EvidenceArrow">→　登記事項証明書</text:p>
      <text:p text:style-name="EvidenceNext">受任者変更の場合</text:p>
      <text:p text:style-name="EvidenceArrow">→　ＩＣカードの申し込みの際に、各認証局に提出する書類の写し一式（申請書含む）</text:p>
    </office:text>
  </office:body>
</office:document>