      <text:p text:style-name="PageStart">別記様式第１</text:p>
      <text:p text:style-name="TitleP">消防法令適合通知書交付申請書</text:p>
      <table:table table:name="MainForm" table:style-name="OuterTable">
        <table:table-column table:style-name="OuterColumn"/>
        <table:table-row>
