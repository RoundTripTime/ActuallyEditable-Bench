        <table:table-row>
          <table:table-cell table:style-name="OuterCell">
            <text:p>日置市消防本部　消防長　殿</text:p>
            <text:p>　</text:p>
            <table:table table:name="Applicant" table:style-name="PlainTable">
              <table:table-column table:style-name="TwoColA"/>
              <table:table-column table:style-name="TwoColB"/>
              <table:table-row>
                <table:table-cell table:style-name="PlainCell"><text:p/></table:table-cell>
