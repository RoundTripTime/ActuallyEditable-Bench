<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="PageLabel" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.35cm" fo:text-align="start"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="TopLabels" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:text-align="center"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="TableTitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:text-align="center"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="HeaderText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:text-align="center"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="CellText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:text-align="end"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="TotalLabel" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:text-align="center"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-left="2.4cm" fo:margin-right="2.4cm" fo:margin-top="2.2cm" fo:margin-bottom="2.2cm"/>
    </style:page-layout>
    <style:style style:name="TopTable" style:family="table">
      <style:table-properties style:width="16.2cm" table:align="center"/>
    </style:style>
    <style:style style:name="NoBorderColumn1" style:family="table-column">
      <style:table-column-properties style:column-width="5.5cm"/>
    </style:style>
    <style:style style:name="NoBorderColumn2" style:family="table-column">
      <style:table-column-properties style:column-width="3.3cm"/>
    </style:style>
    <style:style style:name="NoBorderColumn3" style:family="table-column">
      <style:table-column-properties style:column-width="7.4cm"/>
    </style:style>
    <style:style style:name="NoBorderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="MainTable" style:family="table">
      <style:table-properties style:width="16.2cm" table:align="center"/>
    </style:style>
    <style:style style:name="Column1" style:family="table-column">
      <style:table-column-properties style:column-width="3.1cm"/>
    </style:style>
    <style:style style:name="Column2" style:family="table-column">
      <style:table-column-properties style:column-width="3.6cm"/>
    </style:style>
    <style:style style:name="Column3" style:family="table-column">
      <style:table-column-properties style:column-width="3.6cm"/>
    </style:style>
    <style:style style:name="Column4" style:family="table-column">
      <style:table-column-properties style:column-width="3.8cm"/>
    </style:style>
    <style:style style:name="Column5" style:family="table-column">
      <style:table-column-properties style:column-width="2.1cm"/>
    </style:style>
    <style:style style:name="MainCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.05cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="MergedTitleCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.05cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CoveredCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="MainRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.75cm"/>
    </style:style>
    <style:style style:name="TitleRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.75cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageLabel">別紙２</text:p>
      <table:table table:name="TopLabels" table:style-name="TopTable">
        <table:table-column table:style-name="NoBorderColumn1"/>
        <table:table-column table:style-name="NoBorderColumn2"/>
        <table:table-column table:style-name="NoBorderColumn3"/>
        <table:table-row table:style-name="MainRow">
          <table:table-cell table:style-name="NoBorderCell">
            <text:p text:style-name="TopLabels">令和　　</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="NoBorderCell">
            <text:p text:style-name="TopLabels">年度</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="NoBorderCell">
            <text:p text:style-name="TopLabels">老人クラブ歳入予算書</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageLabel"/>
      <table:table table:name="老人クラブ歳入予算書" table:style-name="MainTable">
        <table:table-column table:style-name="Column1"/>
        <table:table-column table:style-name="Column2"/>
        <table:table-column table:style-name="Column3"/>
        <table:table-column table:style-name="Column4"/>
        <table:table-column table:style-name="Column5"/>
        <table:table-row table:style-name="TitleRow">
          <table:table-cell table:style-name="MergedTitleCell" table:number-columns-spanned="5">
            <text:p text:style-name="TableTitle">老　人　ク　ラ　ブ　歳　入　予　算　書</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="CoveredCell"/>
          <table:covered-table-cell table:style-name="CoveredCell"/>
          <table:covered-table-cell table:style-name="CoveredCell"/>
          <table:covered-table-cell table:style-name="CoveredCell"/>
        </table:table-row>
        <table:table-row table:style-name="MainRow">
          <table:table-cell table:style-name="MainCell"><text:p text:style-name="HeaderText">項　目</text:p></table:table-cell>
          <table:table-cell table:style-name="MainCell"><text:p text:style-name="HeaderText">本年度予算額</text:p></table:table-cell>
          <table:table-cell table:style-name="MainCell"><text:p text:style-name="HeaderText">前年度予算額</text:p></table:table-cell>
          <table:table-cell table:style-name="MainCell"><text:p text:style-name="HeaderText">比較増減額（△）</text:p></table:table-cell>
          <table:table-cell table:style-name="MainCell"><text:p text:style-name="HeaderText">備　考</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="MainRow">
          <table:table-cell table:style-name="MainCell"/>
          <table:table-cell table:style-name="MainCell"><text:p text:style-name="CellText">円</text:p></table:table-cell>
          <table:table-cell table:style-name="MainCell"><text:p text:style-name="CellText">円</text:p></table:table-cell>
          <table:table-cell table:style-name="MainCell"><text:p text:style-name="CellText">円</text:p></table:table-cell>
          <table:table-cell table:style-name="MainCell"/>
        </table:table-row>
        <table:table-row table:style-name="MainRow"><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/></table:table-row>
        <table:table-row table:style-name="MainRow"><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/></table:table-row>
        <table:table-row table:style-name="MainRow"><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/></table:table-row>
        <table:table-row table:style-name="MainRow"><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/></table:table-row>
        <table:table-row table:style-name="MainRow"><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/></table:table-row>
        <table:table-row table:style-name="MainRow"><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/></table:table-row>
        <table:table-row table:style-name="MainRow"><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/></table:table-row>
        <table:table-row table:style-name="MainRow"><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/></table:table-row>
        <table:table-row table:style-name="MainRow"><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/></table:table-row>
        <table:table-row table:style-name="MainRow"><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/></table:table-row>
        <table:table-row table:style-name="MainRow"><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/></table:table-row>
        <table:table-row table:style-name="MainRow"><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/></table:table-row>
        <table:table-row table:style-name="MainRow"><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/></table:table-row>
        <table:table-row table:style-name="MainRow"><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/></table:table-row>
        <table:table-row table:style-name="MainRow"><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/></table:table-row>
        <table:table-row table:style-name="MainRow"><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/></table:table-row>
        <table:table-row table:style-name="MainRow"><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/></table:table-row>
        <table:table-row table:style-name="MainRow"><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/></table:table-row>
        <table:table-row table:style-name="MainRow"><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/></table:table-row>
        <table:table-row table:style-name="MainRow"><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/></table:table-row>
        <table:table-row table:style-name="MainRow"><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/></table:table-row>
        <table:table-row table:style-name="MainRow"><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/></table:table-row>
        <table:table-row table:style-name="MainRow"><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/></table:table-row>
        <table:table-row table:style-name="MainRow"><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/></table:table-row>
        <table:table-row table:style-name="MainRow"><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/><table:table-cell table:style-name="MainCell"/></table:table-row>
        <table:table-row table:style-name="MainRow">
          <table:table-cell table:style-name="MainCell"><text:p text:style-name="TotalLabel">計</text:p></table:table-cell>
          <table:table-cell table:style-name="MainCell"><text:p text:style-name="CellText">円</text:p></table:table-cell>
          <table:table-cell table:style-name="MainCell"><text:p text:style-name="CellText">円</text:p></table:table-cell>
          <table:table-cell table:style-name="MainCell"><text:p text:style-name="CellText">円</text:p></table:table-cell>
          <table:table-cell table:style-name="MainCell"/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>