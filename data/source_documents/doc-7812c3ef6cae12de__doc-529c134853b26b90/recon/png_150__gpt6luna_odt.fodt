<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:line-height="150%"/>
      <style:text-properties fo:font-size="12pt" style:font-size-asian="12pt" style:font-size-complex="12pt"/>
    </style:default-style>
    <style:style style:name="DefaultParagraph" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:text-align="center" fo:margin-top="25mm" fo:margin-bottom="6mm"/>
      <style:text-properties fo:font-size="16pt" style:font-size-asian="16pt"/>
    </style:style>
    <style:style style:name="RightDate" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end" fo:margin-top="0cm" fo:margin-bottom="7mm" fo:margin-right="8mm"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="6mm" fo:margin-left="0cm"/>
    </style:style>
    <style:style style:name="SectionHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="5mm" fo:margin-bottom="5mm"/>
    </style:style>
    <style:style style:name="ContentLabel" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="5mm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="BlankSpace" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="52mm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="2mm" fo:margin-right="2mm" fo:line-height="150%"/>
      <style:text-properties fo:font-size="11pt" style:font-size-asian="11pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="20mm" fo:margin-bottom="20mm" fo:margin-left="30mm" fo:margin-right="30mm"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table"/>
    <style:style style:name="HalfColumn" style:family="table-column">
      <style:table-column-properties style:column-width="75mm"/>
    </style:style>
    <style:style style:name="PlainCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellParagraph" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">て　ん　末　書</text:p>
      <text:p text:style-name="RightDate">令和　　年　　月　　日</text:p>
      <text:p text:style-name="Recipient">佐渡市長様</text:p>
      <table:table table:name="Applicant" table:style-name="FormTable">
        <table:table-column table:style-name="HalfColumn"/>
        <table:table-column table:style-name="HalfColumn"/>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell"/>
          <table:table-cell table:style-name="PlainCell">
            <text:p text:style-name="CellParagraph">申請者　住所　佐渡市</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell"/>
          <table:table-cell table:style-name="PlainCell">
            <text:p text:style-name="CellParagraph">氏名</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="SectionHeading">下記自動車の登録番号紛失のてん末</text:p>
      <table:table table:name="VehicleDetails" table:style-name="FormTable">
        <table:table-column table:style-name="HalfColumn"/>
        <table:table-column table:style-name="HalfColumn"/>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell">
            <text:p text:style-name="CellParagraph">登録番号</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="PlainCell">
            <text:p text:style-name="CellParagraph">車体番号</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell">
            <text:p text:style-name="CellParagraph">車　　名</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="PlainCell">
            <text:p text:style-name="CellParagraph">エンジン番号</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell">
            <text:p text:style-name="CellParagraph">型　　式</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="PlainCell">
            <text:p text:style-name="CellParagraph">認定番号</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell">
            <text:p text:style-name="CellParagraph">取得日　　　年　　月　　日</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="PlainCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="ContentLabel">内　　容</text:p>
      <text:p text:style-name="BlankSpace"/>
      <text:p text:style-name="Note">(注)紛失日時、紛失区間、届出警察署又は駐在所を明記の上詳細にてん末を記入すること。</text:p>
    </office:text>
  </office:body>
</office:document>