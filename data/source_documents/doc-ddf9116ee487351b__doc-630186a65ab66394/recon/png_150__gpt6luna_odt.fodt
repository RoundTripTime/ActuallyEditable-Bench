<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="12pt" fo:color="#000000"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="12pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Logo" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#284C5E" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="24pt" fo:color="#4772C6"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="18pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="HeadingBlue" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="20pt" fo:color="#31599A"/>
    </style:style>
    <style:style style:name="HeadingBlueSmall" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="17pt" fo:color="#31599A"/>
    </style:style>
    <style:style style:name="BoldBody" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="150%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="12pt" fo:font-weight="bold" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Footer" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="PageBreakHeading" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="20pt" fo:color="#31599A"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="12pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Grid" style:family="table">
      <style:table-properties style:width="16cm" table:align="left"/>
    </style:style>
    <style:style style:name="Column4" style:family="table-column">
      <style:table-column-properties style:column-width="4cm"/>
    </style:style>
    <style:style style:name="Column6" style:family="table-column">
      <style:table-column-properties style:column-width="6cm"/>
    </style:style>
    <style:style style:name="Column10" style:family="table-column">
      <style:table-column-properties style:column-width="10cm"/>
    </style:style>
    <style:style style:name="Column3" style:family="table-column">
      <style:table-column-properties style:column-width="3cm"/>
    </style:style>
    <style:style style:name="Column5" style:family="table-column">
      <style:table-column-properties style:column-width="5cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #222222" fo:padding="0.15cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="TightCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #222222" fo:padding="0.08cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="ShortRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.75cm"/>
    </style:style>
    <style:style style:name="MediumRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.05cm"/>
    </style:style>
    <style:style style:name="LargeRow" style:family="table-row">
      <style:table-row-properties style:row-height="4.3cm"/>
    </style:style>
    <style:style style:name="XLRow" style:family="table-row">
      <style:table-row-properties style:row-height="5.3cm"/>
    </style:style>
    <style:style style:name="XXLRow" style:family="table-row">
      <style:table-row-properties style:row-height="6.2cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="2.5cm" fo:margin-right="2.5cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Logo">East Sussex</text:p>
      <text:p text:style-name="Logo">County Council</text:p>
      <text:p text:style-name="Title">The East Sussex Integrated Progress Review Part 2 full version.</text:p>
      <text:p text:style-name="Subtitle">(For settings who are completing a paper-based progress check at age two)</text:p>
      <text:p text:style-name="HeadingBlue">Child and family information</text:p>
      <table:table table:name="Child and family information" table:style-name="Grid">
        <table:table-column table:style-name="Column5"/>
        <table:table-column table:style-name="Column10"/>
        <table:table-row table:style-name="MediumRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Name of Child</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="MediumRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Date of Birth</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="MediumRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Home Language</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="MediumRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Postcode</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="MediumRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Parents or Carers Names</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="HeadingBlue">Early Education Information</text:p>
      <table:table table:name="Early Education Information" table:style-name="Grid">
        <table:table-column table:style-name="Column5"/>
        <table:table-column table:style-name="Column10"/>
        <table:table-row table:style-name="MediumRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Name of early years setting</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="MediumRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Any other setting attended</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="MediumRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Name of the person completing the form</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="MediumRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Number of hours per week at each setting.</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="HeadingBlue">Support already in place from other professionals or agencies (if applicable). Add rows if needed.</text:p>
      <table:table table:name="Support already in place" table:style-name="Grid">
        <table:table-column table:style-name="Column8"/>
        <table:table-column table:style-name="Column8"/>
        <table:table-row table:style-name="ShortRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Name</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Agency</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="MediumRow"><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="MediumRow"><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Footer">Page 1 of 4                     Version 5, updated July 25      eastsussex.gov.uk</text:p>

      <text:p text:style-name="PageBreakHeading">Child’s learning - key person to complete.</text:p>
      <text:p text:style-name="HeadingBlueSmall">The characteristics of effective learning</text:p>
      <table:table table:name="The characteristics of effective learning" table:style-name="Grid">
        <table:table-column table:style-name="Column16"/>
        <table:table-row table:style-name="ShortRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Note to key person - please describe how you see the child using the characteristics of effective learning in their play.</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="XXLRow"><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="HeadingBlueSmall">Child’s voice</text:p>
      <table:table table:name="Child’s voice" table:style-name="Grid">
        <table:table-column table:style-name="Column16"/>
        <table:table-row table:style-name="MediumRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Note to key person - What sort of learner are they; What makes me happy; What do I enjoy? Direct quotes or examples from the child.</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="LargeRow"><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="HeadingBlueSmall">Personal, Social and Emotional Development</text:p>
      <table:table table:name="Personal, Social and Emotional Development" table:style-name="Grid">
        <table:table-column table:style-name="Column16"/>
        <table:table-row table:style-name="ShortRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Parent comments:</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="LargeRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Setting comments:</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="Footer">Page 2 of 4                     Version 5, updated July 25      eastsussex.gov.uk</text:p>

      <text:p text:style-name="PageBreakHeading">Communication and Language Development</text:p>
      <table:table table:name="Communication and Language Development" table:style-name="Grid">
        <table:table-column table:style-name="Column16"/>
        <table:table-row table:style-name="MediumRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Parent comments:</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="XLRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Setting comments:</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="HeadingBlue">Physical Development</text:p>
      <table:table table:name="Physical Development" table:style-name="Grid">
        <table:table-column table:style-name="Column16"/>
        <table:table-row table:style-name="MediumRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Parent comments:</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="XLRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Setting comments:</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="HeadingBlue">Areas for Development</text:p>
      <table:table table:name="Areas for Development" table:style-name="Grid">
        <table:table-column table:style-name="Column16"/>
        <table:table-row table:style-name="ShortRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">What can parents or carers can do at home:</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="LargeRow"><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="ShortRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">What the education setting will do:</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="XLRow"><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Footer">Page 3 of 4                     Version 5, updated July 25      eastsussex.gov.uk</text:p>

      <text:p text:style-name="PageBreak"/>
      <table:table table:name="Continued writing area" table:style-name="Grid">
        <table:table-column table:style-name="Column16"/>
        <table:table-row table:style-name="LargeRow"><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="HeadingBlue">Child’s learning and development summary for the Health Visiting Team</text:p>
      <table:table table:name="Child’s learning and development summary for the Health Visiting Team" table:style-name="Grid">
        <table:table-column table:style-name="Column4"/>
        <table:table-column table:style-name="Column3"/>
        <table:table-column table:style-name="Column5"/>
        <table:table-column table:style-name="Column4"/>
        <table:table-row table:style-name="XXLRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Is the child ‘on track’ or is additional support in place?</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Brief overview of strategies being used if applicable or specifics of referrals made.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Is further support needed from HV team? Yes/No Please specify support required.</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="XLRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Personal, social and emotional development</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="XLRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Communication and language</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="XLRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Physical development</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="BoldBody">Please ensure that you have parent/carer permission to share this information with the Health Visiting team – see the document Important Information for Completing Part 2</text:p>
      <text:p text:style-name="HeadingBlue">Parent or Carer Signatures</text:p>
      <table:table table:name="Parent or Carer Signatures" table:style-name="Grid">
        <table:table-column table:style-name="Column8"/>
        <table:table-column table:style-name="Column8"/>
        <table:table-row table:style-name="LargeRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Name</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="MediumRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Signature (or state that this is on the setting’s copy).</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="LargeRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Date</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Footer">Page 4 of 4                     Version 5, updated July 25      eastsussex.gov.uk</text:p>
    </office:text>
  </office:body>
</office:document>