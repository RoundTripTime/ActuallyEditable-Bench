        <table:table-row table:style-name="MediumRow"><table:table-cell table:style-name="Cell"/><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Footer">Page 1 of 4                     Version 5, updated July 25      eastsussex.gov.uk</text:p>

      <text:p text:style-name="PageBreakHeading">Child’s learning - key person to complete.</text:p>
      <text:p text:style-name="HeadingBlueSmall">The characteristics of effective learning</text:p>
      <table:table table:name="The characteristics of effective learning" table:style-name="Grid">
        <table:table-column table:style-name="Column16"/>
        <table:table-row table:style-name="ShortRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Note to key person - please describe how you see the child using the characteristics of effective learning in their play.</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="XXLRow"><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Body"/>
