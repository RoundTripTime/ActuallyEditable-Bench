      <text:p text:style-name="Logo">East Sussex</text:p>
      <text:p text:style-name="Logo">County Council</text:p>
      <text:p text:style-name="Title">The East Sussex Integrated Progress Review Part 2 full version.</text:p>
      <text:p text:style-name="Subtitle">(For settings who are completing a paper-based progress check at age two)</text:p>
      <text:p text:style-name="HeadingBlue">Child and family information</text:p>
      <table:table table:name="Child and family information" table:style-name="Grid">
        <table:table-column table:style-name="Column5"/>
        <table:table-column table:style-name="Column10"/>
        <table:table-row table:style-name="MediumRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Name of Child</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="MediumRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Date of Birth</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="MediumRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Home Language</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="MediumRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Postcode</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="MediumRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Parents or Carers Names</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="HeadingBlue">Early Education Information</text:p>
      <table:table table:name="Early Education Information" table:style-name="Grid">
        <table:table-column table:style-name="Column5"/>
        <table:table-column table:style-name="Column10"/>
        <table:table-row table:style-name="MediumRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Name of early years setting</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="MediumRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Any other setting attended</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="MediumRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Name of the person completing the form</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="MediumRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Number of hours per week at each setting.</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="HeadingBlue">Support already in place from other professionals or agencies (if applicable). Add rows if needed.</text:p>
