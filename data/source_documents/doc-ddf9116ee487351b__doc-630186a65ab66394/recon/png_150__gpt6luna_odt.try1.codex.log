      <table:table table:name="Child’s voice" table:style-name="Grid">
        <table:table-column table:style-name="Column16"/>
        <table:table-row table:style-name="MediumRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Note to key person - What sort of learner are they; What makes me happy; What do I enjoy? Direct quotes or examples from the child.</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="LargeRow"><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="HeadingBlueSmall">Personal, Social and Emotional Development</text:p>
