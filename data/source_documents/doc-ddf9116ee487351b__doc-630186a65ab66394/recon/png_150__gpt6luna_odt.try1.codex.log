        <table:table-column table:style-name="Column16"/>
        <table:table-row table:style-name="ShortRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">What can parents or carers can do at home:</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="LargeRow"><table:table-cell table:style-name="Cell"/></table:table-row>
        <table:table-row table:style-name="ShortRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">What the education setting will do:</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="XLRow"><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Footer">Page 3 of 4                     Version 5, updated July 25      eastsussex.gov.uk</text:p>

      <text:p text:style-name="PageBreak"/>
      <table:table table:name="Continued writing area" table:style-name="Grid">
        <table:table-column table:style-name="Column16"/>
        <table:table-row table:style-name="LargeRow"><table:table-cell table:style-name="Cell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="HeadingBlue">Child’s learning and development summary for the Health Visiting Team</text:p>
      <table:table table:name="Child’s learning and development summary for the Health Visiting Team" table:style-name="Grid">
        <table:table-column table:style-name="Column4"/>
        <table:table-column table:style-name="Column3"/>
        <table:table-column table:style-name="Column5"/>
        <table:table-column table:style-name="Column4"/>
        <table:table-row table:style-name="XXLRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Is the child ‘on track’ or is additional support in place?</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Brief overview of strategies being used if applicable or specifics of referrals made.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Is further support needed from HV team? Yes/No Please specify support required.</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="XLRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Personal, social and emotional development</text:p></table:table-cell>
