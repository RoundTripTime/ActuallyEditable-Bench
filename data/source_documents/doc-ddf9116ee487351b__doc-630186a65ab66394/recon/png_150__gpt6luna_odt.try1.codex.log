        <table:table-row table:style-name="MediumRow"><table:table-cell table:style-name="Cell"><text:p text:style-name="Body">Signature (or state that this is on the setting’s copy).</text:p></table:table-cell><table:table-cell table:style-name="Cell"/></table:table-row>
