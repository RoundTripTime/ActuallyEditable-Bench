<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0.25cm"/>
      <style:text-properties fo:font-family="Noto Serif CJK TC" style:font-family-asian="Noto Serif CJK TC" fo:font-size="20pt" style:font-size-asian="20pt"/>
    </style:style>
    <style:style style:name="InfoLine" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.18cm" fo:margin-bottom="0.18cm"/>
      <style:text-properties fo:font-family="Noto Serif CJK TC" style:font-family-asian="Noto Serif CJK TC" fo:font-size="16pt" style:font-size-asian="16pt"/>
    </style:style>
    <style:style style:name="TableHeading" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Noto Serif CJK TC" style:font-family-asian="Noto Serif CJK TC" fo:font-size="16pt" style:font-size-asian="16pt"/>
    </style:style>
    <style:style style:name="TableEntry" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Noto Serif CJK TC" style:font-family-asian="Noto Serif CJK TC" fo:font-size="14pt" style:font-size-asian="14pt"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="17cm"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="1.65cm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="3.3cm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="4cm"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties style:column-width="8.05cm"/>
    </style:style>
    <style:style style:name="InfoRow" style:family="table-row">
      <style:table-row-properties style:row-height="4.2cm"/>
    </style:style>
    <style:style style:name="HeadingRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.95cm"/>
    </style:style>
    <style:style style:name="EntryRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.5cm"/>
    </style:style>
    <style:style style:name="FormCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #777777" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="InfoCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #777777" fo:padding="0.12cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="HeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #777777" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0.3cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Noto Sans CJK TC" style:font-family-asian="Noto Sans CJK TC" fo:font-size="12pt" style:font-size-asian="12pt"/>
    </style:style>
    <style:style style:name="PageNumber" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.8cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Noto Serif CJK TC" style:font-family-asian="Noto Serif CJK TC" fo:font-size="11pt" style:font-size-asian="11pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="2cm" fo:margin-right="2cm" fo:margin-top="2cm" fo:margin-bottom="1.2cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title" fo:break-before="page">營業人資料表</text:p>
      <table:table table:name="營業人資料表" table:style-name="FormTable">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-row table:style-name="InfoRow">
          <table:table-cell table:style-name="InfoCell" table:number-columns-spanned="4">
            <text:p text:style-name="InfoLine">代理人名稱：</text:p>
            <text:p text:style-name="InfoLine">統一編號：</text:p>
            <text:p text:style-name="InfoLine">負責人：</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="HeadingRow">
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="TableHeading">序號</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="TableHeading">統一編號</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="TableHeading">稅籍編號</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="TableHeading">營業人名稱</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="EntryRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="TableEntry">1</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="EntryRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="TableEntry">2</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="EntryRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="TableEntry">3</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="EntryRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="TableEntry">4</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="EntryRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="TableEntry">5</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="EntryRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="TableEntry">6</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="EntryRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="TableEntry">7</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="EntryRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="TableEntry">8</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="EntryRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="TableEntry">9</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="EntryRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="TableEntry">10</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Note">每次申辦僅以代理同一局所轄營業人為限，如涉及跨局營業人，請按局分別申辦。</text:p>
      <text:p text:style-name="PageNumber">第1頁 / 共1頁</text:p>
    </office:text>
  </office:body>
</office:document>