<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Default" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="8pt" style:font-name="Noto Sans CJK JP"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="8pt" style:font-name="Noto Sans CJK JP"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0.1cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="20pt" fo:font-weight="bold" style:font-name="Noto Sans CJK JP"/>
    </style:style>
    <style:style style:name="HeaderText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="9pt" fo:font-weight="bold" style:font-name="Noto Sans CJK JP"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="7pt" style:font-name="Noto Sans CJK JP"/>
    </style:style>
    <style:style style:name="Vertical" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="8pt" fo:font-weight="bold" style:font-name="Noto Sans CJK JP"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="8pt" style:font-name="Noto Sans CJK JP"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-top="0.8cm" fo:margin-bottom="0.8cm" fo:margin-left="1.8cm" fo:margin-right="1.8cm"/>
    </style:page-layout>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.05cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="95%"/>
      <style:text-properties fo:font-size="8pt" style:font-name="Noto Sans CJK JP"/>
    </style:style>
    <style:style style:name="ThinCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.35pt solid #000000" fo:padding="0.04cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="95%"/>
      <style:text-properties fo:font-size="7.5pt" style:font-name="Noto Sans CJK JP"/>
    </style:style>
    <style:style style:name="GrayCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.05cm" style:vertical-align="middle" fo:background-color="#d9d9d9"/>
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="8pt" fo:font-weight="bold" style:font-name="Noto Sans CJK JP"/>
    </style:style>
    <style:style style:name="GrayVertical" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.04cm" style:vertical-align="middle" fo:background-color="#d9d9d9" style:writing-mode="tb-rl"/>
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="8pt" fo:font-weight="bold" style:font-name="Noto Sans CJK JP"/>
    </style:style>
    <style:style style:name="CenterCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.04cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="8pt" style:font-name="Noto Sans CJK JP"/>
    </style:style>
    <style:style style:name="TableFull" style:family="table">
      <style:table-properties style:width="17.4cm" table:align="margins"/>
    </style:style>
    <style:style style:name="ColNarrow" style:family="table-column">
      <style:table-column-properties style:column-width="0.85cm"/>
    </style:style>
    <style:style style:name="ColWide" style:family="table-column">
      <style:table-column-properties style:column-width="2.4cm"/>
    </style:style>
    <style:style style:name="ColMedium" style:family="table-column">
      <style:table-column-properties style:column-width="1.7cm"/>
    </style:style>
    <style:style style:name="ColRest" style:family="table-column">
      <style:table-column-properties style:rel-column-width="1*"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="DefaultPage" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">別記様式第２５号その１</text:p>
      <text:p text:style-name="Title">税 証 明 書 交 付 請 求 書</text:p>
      <table:table table:name="Header" table:style-name="TableFull">
        <table:table-column table:style-name="ColRest"/>
        <table:table-column table:style-name="ColRest"/>
        <table:table-column table:style-name="ColRest"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>毛呂山町長　あて</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p>年</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p>月　　日</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <table:table table:name="Applicants" table:style-name="TableFull">
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-column table:style-name="ColWide"/>
        <table:table-column table:style-name="ColRest"/>
        <table:table-column table:style-name="ColMedium"/>
        <table:table-column table:style-name="ColRest"/>
        <table:table-row>
          <table:table-cell table:style-name="GrayCell" table:number-rows-spanned="4"><text:p text:style-name="HeaderText">①</text:p><text:p text:style-name="Vertical">窓口に</text:p><text:p text:style-name="Vertical">来た人</text:p><text:p text:style-name="Vertical">（請 求 者）</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p>現　住　所</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CenterCell"><text:p>フリガナ</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CenterCell" table:number-rows-spanned="2"><text:p>生年月日</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p>年　　月　　日</text:p></table:cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CenterCell"><text:p>氏　　名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CenterCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CenterCell"><text:p>証明して</text:p><text:p>ほしい人</text:p><text:p>との関係</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>□ 本　人　　　□ 同一世帯の親族</text:p><text:p>□ 代理人　　　□ 他（　　　　　　　　　）</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p>電　話</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GrayCell" table:number-rows-spanned="3"><text:p text:style-name="HeaderText">②</text:p><text:p text:style-name="Vertical">証明して</text:p><text:p text:style-name="Vertical">ほしい人</text:p><text:p text:style-name="Vertical">（証 明</text:p><text:p text:style-name="Vertical">対象者）</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p>住　　所</text:p><text:p text:style-name="Small">（１月１日時点）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p>□①と同じ</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CenterCell"><text:p>フリガナ</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="CenterCell" table:number-rows-spanned="2"><text:p>生年月日</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p>年　　月　　日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CenterCell"><text:p>氏　　名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>□①と同じ</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CenterCell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Small">※請求者の身分証明書等を提示してください。</text:p>
      <text:p text:style-name="Small">※請求者が本人、同一世帯の親族以外の場合は、委任状が必要です。</text:p>
      <text:p text:style-name="Small">（継続検査用納税証明書および営業証明書［法人用・車庫証明用］は除く。）</text:p>
      <text:p text:style-name="HeaderText">③ 必要な証明書等に○をつけて、「年度」、「通数」等を記入してください。</text:p>
      <table:table table:name="ResidentTax" table:style-name="TableFull">
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-column table:style-name="ColRest"/>
        <table:table-column table:style-name="ColWide"/>
        <table:table-row>
          <table:table-cell table:style-name="GrayVertical" table:number-rows-spanned="3"><text:p>住民税</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>１　所得（非）課税証明書</text:p><text:p>　　※課税決定前の請求・発行の場合は、【所得証明】となります。</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>年度（　　　年分所得）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>２　住民税申告書の写し</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>通</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>３　営業証明書（法人用・車庫証明用・開業届出済の個人事業用）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>通</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <table:table table:name="FixedAssets" table:style-name="TableFull">
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-column table:style-name="ColRest"/>
        <table:table-column table:style-name="ColRest"/>
        <table:table-row>
          <table:table-cell table:style-name="GrayVertical" table:number-rows-spanned="7"><text:p>固定資産税</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>１　評価証明書（ 全部 ・ 一部 ）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>年度</text:p></table:table-cell>
        </table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>２　公課証明書（ 全部 ・ 一部 ）</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>通</text:p></table:table-cell></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>３　資産証明書（ 全部 ・ 一部 ）</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>４　名寄証明書</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>通</text:p></table:table-cell></table:row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>※名寄せの閲覧・コピー（公印なし）については別の申請書をご使用ください。</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="GrayCell" table:number-columns-spanned="2"><text:p>不動産の所在地（評価、公課、資産証明で一部に○をした場合のみ記入）</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="CenterCell"><text:p>物件区分　　　大字　　　番地</text:p><text:p>土地・家屋</text:p><text:p/></table:table-cell><table:table-cell table:style-name="CenterCell"><text:p>物件区分　　　大字　　　番地</text:p><text:p>土地・家屋</text:p><text:p/></table:table-cell></table:table-row>
      </table:table>
      <table:table table:name="TaxCertificates" table:style-name="TableFull">
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-column table:style-name="ColRest"/>
        <table:table-column table:style-name="ColWide"/>
        <table:table-row>
          <table:table-cell table:style-name="GrayVertical" table:number-rows-spanned="4"><text:p>納税証明書</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>１　個人の町税　　全ての税目　・　町県民税　・　固定資産税</text:p><text:p>　※必要な税目に○を</text:p><text:p>　　つけてください。</text:p><text:p>　その他の税（　　　　　　　　　　　　　　　）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>年度</text:p><text:p>通</text:p></table:table-cell>
        </table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>２　法人町民税　（事業年度：</text:p><text:p>　　年　月　日～　　年　月　日）</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>通</text:p></table:table-cell></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>３　軽自動車税　（継続検査用）　　※ナンバーを記入してください。</text:p></table:cell><table:table-cell table:style-name="Cell"><text:p>年度</text:p><text:p>通</text:p></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p>所沢・川越　　　　　［　　　　］　　　　　　　　　－</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
      </table:table>
      <table:table table:name="OfficeUse" table:style-name="TableFull">
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-column table:style-name="ColWide"/>
        <table:table-column table:style-name="ColWide"/>
        <table:table-column table:style-name="ColWide"/>
        <table:table-column table:style-name="ColRest"/>
        <table:table-row>
          <table:table-cell table:style-name="CenterCell" table:number-rows-spanned="2"><text:p>町職員</text:p><text:p>確認欄</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p>交付番号</text:p><text:p>No</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p>住　・　固　・　納</text:p><text:p>通　数</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p>取扱者</text:p><text:p>手　数　料　　　円</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell" table:number-rows-spanned="2"><text:p>本人確認</text:p><text:p>免・マ・在・保・診・会・銀</text:p><text:p>他（　　　　　　　　　）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p>通</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:covered-table-cell/></table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>