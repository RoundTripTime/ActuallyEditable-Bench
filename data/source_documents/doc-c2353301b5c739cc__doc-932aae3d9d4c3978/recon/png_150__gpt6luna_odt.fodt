<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:text-align="center" fo:margin-top="0.1in" fo:margin-bottom="0.05in"/>
      <style:text-properties fo:font-size="16pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="SmallText" style:family="paragraph">
      <style:paragraph-properties fo:margin="0in" fo:line-height="100%"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="FormText" style:family="paragraph">
      <style:paragraph-properties fo:margin="0in" fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:margin="0in" fo:text-align="center" fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="BoldCenter" style:family="paragraph">
      <style:paragraph-properties fo:margin="0in" fo:text-align="center" fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="LabelCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0.04in" style:vertical-align="middle"/>
      <style:paragraph-properties fo:margin="0in" fo:line-height="100%" fo:text-align="center"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="InputCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0.04in" style:vertical-align="middle"/>
      <style:paragraph-properties fo:margin="0in" fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="CenterCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0.04in" style:vertical-align="middle"/>
      <style:paragraph-properties fo:margin="0in" fo:line-height="100%" fo:text-align="center"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="GrayCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0.04in" style:vertical-align="middle" fo:background-color="#d9d9d9"/>
      <style:paragraph-properties fo:margin="0in" fo:line-height="100%" fo:text-align="center"/>
      <style:text-properties fo:font-size="10pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="NoBorderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0.01in" style:vertical-align="middle"/>
      <style:paragraph-properties fo:margin="0in" fo:line-height="100%"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PL1">
      <style:page-layout-properties fo:page-width="8.27in" fo:page-height="11.69in" fo:margin-left="0.55in" fo:margin-right="0.45in" fo:margin-top="0.35in" fo:margin-bottom="0.35in"/>
    </style:page-layout>
    <style:style style:name="MainTable" style:family="table"/>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties fo:width="0.8in"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties fo:width="1.1in"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties fo:width="2.15in"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties fo:width="1.1in"/>
    </style:style>
    <style:style style:name="Col5" style:family="table-column">
      <style:table-column-properties fo:width="1.1in"/>
    </style:style>
    <style:style style:name="Col6" style:family="table-column">
      <style:table-column-properties fo:width="1.1in"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PL1"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="SmallText">別記様式第２５号その１</text:p>
      <text:p text:style-name="PageStart">税 証 明 書 交 付 請 求 書</text:p>
      <text:p text:style-name="FormText">毛呂山町長　あて　　　　　　　　　　　　　　　　　　　　　　　　　　　　年　　月　　日</text:p>
      <table:table table:name="Applicant">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-column table:style-name="Col5"/>
        <table:table-column table:style-name="Col6"/>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell" table:number-rows-spanned="4"><text:p text:style-name="BoldCenter">①&#10;窓口に&#10;来た人&#10;（請 求 者）</text:p></table:table-cell>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Center">現　住　所</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell" table:number-columns-spanned="4"><text:p text:style-name="FormText"/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Center">フリガナ</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell" table:number-columns-spanned="2"><text:p text:style-name="FormText"/></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="LabelCell" table:number-rows-spanned="2"><text:p text:style-name="Center">生年月日</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell" table:number-rows-spanned="2"><text:p text:style-name="Center">年　　月　　日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Center">氏　　名</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell" table:number-columns-spanned="2"><text:p text:style-name="FormText"/></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Center">証明して&#10;ほしい人&#10;との関係</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell" table:number-columns-spanned="2"><text:p text:style-name="FormText">□ 本　人　　　□ 同一世帯の親族</text:p><text:p text:style-name="FormText">□ 代理人　　　□ 他（　　　　　　　　　）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Center">電　話</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="FormText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell" table:number-rows-spanned="3"><text:p text:style-name="BoldCenter">②&#10;証明して&#10;ほしい人&#10;（証　明&#10; 対象者）</text:p></table:table-cell>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Center">住　　所&#10;（１月１日時点）</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell" table:number-columns-spanned="4"><text:p text:style-name="FormText">□①と同じ</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Center">フリガナ</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell" table:number-columns-spanned="2"><text:p text:style-name="FormText"/></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="LabelCell" table:number-rows-spanned="2"><text:p text:style-name="Center">生年月日</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell" table:number-rows-spanned="2"><text:p text:style-name="Center">年　　月　　日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Center">氏　　名</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell" table:number-columns-spanned="2"><text:p text:style-name="FormText">□①と同じ</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="SmallText">※請求者の身分証明書等を提示してください。</text:p>
      <text:p text:style-name="SmallText">※請求者が本人、同一世帯の親族以外の場合は、委任状が必要です。</text:p>
      <text:p text:style-name="SmallText">　（継続検査用納税証明書および営業証明書［法人用・車庫証明用］は除く。）</text:p>
      <text:p text:style-name="FormText">③ 必要な証明書等に○をつけて、「年度」、「通数」等を記入してください。</text:p>
      <table:table table:name="ResidentTax">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-column table:style-name="Col5"/>
        <table:table-column table:style-name="Col6"/>
        <table:table-row>
          <table:table-cell table:style-name="GrayCell" table:number-rows-spanned="3"><text:p text:style-name="BoldCenter">住&#10;民&#10;税</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell" table:number-columns-spanned="3"><text:p text:style-name="FormText">1　所得（非）課税証明書</text:p><text:p text:style-name="SmallText">　　※課税決定前の請求・発行の場合は、【所得証明】となります。</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="InputCell" table:number-columns-spanned="2" table:number-rows-spanned="3"><text:p text:style-name="FormText">年度（　　年分所得）</text:p><text:p text:style-name="FormText">　　　　　　　　　　通</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="InputCell" table:number-columns-spanned="3"><text:p text:style-name="FormText">2　住民税申告書の写し</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="InputCell" table:number-columns-spanned="3"><text:p text:style-name="FormText">3　営業証明書（法人用・車庫証明用・開業届出済の個人事業用）</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <table:table table:name="FixedAssetTax">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-column table:style-name="Col5"/>
        <table:table-column table:style-name="Col6"/>
        <table:table-row>
          <table:table-cell table:style-name="GrayCell" table:number-rows-spanned="6"><text:p text:style-name="BoldCenter">固&#10;定&#10;資&#10;産&#10;税</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell" table:number-columns-spanned="2"><text:p text:style-name="FormText">1　評価証明書（ 全部 ・ 一部 ）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="InputCell" table:number-rows-spanned="4"><text:p text:style-name="FormText">※名寄せの閲覧・コピー（公印なし）については別の申請書をご使用ください。</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell" table:number-columns-spanned="2"><text:p text:style-name="FormText">年度</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="InputCell" table:number-columns-spanned="2"><text:p text:style-name="FormText">2　公課証明書（ 全部 ・ 一部 ）</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="CenterCell" table:number-columns-spanned="2"><text:p text:style-name="FormText">通</text:p></table:table-cell><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="InputCell" table:number-columns-spanned="2"><text:p text:style-name="FormText">3　資産証明書（ 全部 ・ 一部 ）</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="CenterCell" table:number-columns-spanned="2"><text:p text:style-name="FormText"/></table:table-cell><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="InputCell" table:number-columns-spanned="2"><text:p text:style-name="FormText">4　名寄証明書</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="CenterCell" table:number-columns-spanned="2"><text:p text:style-name="FormText">通</text:p></table:table-cell><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GrayCell" table:number-columns-spanned="5"><text:p text:style-name="Center">不動産の所在地（評価、公課、資産証明で一部に○をした場合のみ記入）</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CenterCell"><text:p text:style-name="Center">物件区分</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p text:style-name="Center">大字</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p text:style-name="Center">番地</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p text:style-name="Center">物件区分</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p text:style-name="Center">大字　　　番地</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CenterCell"><text:p text:style-name="Center">土地・家屋</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="FormText"/></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="FormText"/></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p text:style-name="Center">土地・家屋</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="FormText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CenterCell"><text:p text:style-name="Center">土地・家屋</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="FormText"/></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="FormText"/></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p text:style-name="Center">土地・家屋</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="FormText"/></table:table-cell>
        </table:table-row>
      </table:table>
      <table:table table:name="TaxCertificates">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-column table:style-name="Col5"/>
        <table:table-column table:style-name="Col6"/>
        <table:table-row>
          <table:table-cell table:style-name="GrayCell" table:number-rows-spanned="4"><text:p text:style-name="BoldCenter">納&#10;税&#10;証&#10;明&#10;書</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell" table:number-columns-spanned="4"><text:p text:style-name="FormText">1　個人の町税　　全ての税目　・　町県民税　・　固定資産税</text:p><text:p text:style-name="SmallText">　※必要な税目に○を&#10;　　つけてください。</text:p><text:p text:style-name="FormText">　　　　　　　　 その他の税（　　　　　　　　　　　　　　）</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="CenterCell" table:number-columns-spanned="1"><text:p text:style-name="FormText">年度</text:p><text:p text:style-name="FormText">通</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="InputCell" table:number-columns-spanned="4"><text:p text:style-name="FormText">2　法人町民税　（事業年度：　　年　月　日～　　年　月　日）</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="CenterCell"><text:p text:style-name="FormText">通</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="InputCell" table:number-columns-spanned="4"><text:p text:style-name="FormText">3　軽自動車税（継続検査用）　　※ナンバーを記入してください。</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="CenterCell"><text:p text:style-name="FormText">年度&#10;通</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CenterCell"><text:p text:style-name="Center">所沢・川越</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="FormText"/></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="FormText"/></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="FormText">［　　］</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="FormText">　　－　　</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p text:style-name="FormText">年度&#10;通</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <table:table table:name="StaffSection">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-column table:style-name="Col5"/>
        <table:table-column table:style-name="Col6"/>
        <table:table-row>
          <table:table-cell table:style-name="CenterCell" table:number-rows-spanned="2"><text:p text:style-name="Center">町職員&#10;確認欄</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p text:style-name="Center">交付番号</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell" table:number-columns-spanned="2"><text:p text:style-name="BoldCenter">住　・　固　・　納</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CenterCell"><text:p text:style-name="Center">取扱者</text:p></table:table-cell>
          <table:table-cell table:style-name="CenterCell"><text:p text:style-name="Center">本人確認</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="FormText">No</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="FormText">通　数</text:p><text:p text:style-name="FormText">手　数　料</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="FormText">通</text:p><text:p text:style-name="FormText">円</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="FormText"/></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="FormText">免・マ・在・保・診・会・銀</text:p><text:p text:style-name="FormText">他（　　　　　　　　　　　）</text:p></table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>