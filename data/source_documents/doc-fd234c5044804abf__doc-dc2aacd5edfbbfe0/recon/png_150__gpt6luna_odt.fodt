<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="9pt"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.8cm" fo:margin-bottom="1.1cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="19pt"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-bottom="0.15cm"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="LabelCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="GridTable" style:family="table">
      <style:table-properties table:align="margins" style:width="18.8cm"/>
    </style:style>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="5.6cm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="3.3cm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="1.5cm"/>
    </style:style>
    <style:style style:name="ColD" style:family="table-column">
      <style:table-column-properties style:column-width="4.4cm"/>
    </style:style>
    <style:style style:name="ColE" style:family="table-column">
      <style:table-column-properties style:column-width="4cm"/>
    </style:style>
    <style:style style:name="TopA" style:family="table-column">
      <style:table-column-properties style:column-width="2cm"/>
    </style:style>
    <style:style style:name="TopB" style:family="table-column">
      <style:table-column-properties style:column-width="6cm"/>
    </style:style>
    <style:style style:name="TopC" style:family="table-column">
      <style:table-column-properties style:column-width="2cm"/>
    </style:style>
    <style:style style:name="TopD" style:family="table-column">
      <style:table-column-properties style:column-width="8.8cm"/>
    </style:style>
    <style:style style:name="BottomA" style:family="table-column">
      <style:table-column-properties style:column-width="4.3cm"/>
    </style:style>
    <style:style style:name="BottomB" style:family="table-column">
      <style:table-column-properties style:column-width="14.5cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-top="0.7cm" fo:margin-bottom="0.7cm" fo:margin-left="1.1cm" fo:margin-right="1.1cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">令和　年　ふるさと納税寄附申出書</text:p>
      <text:p text:style-name="Right">令和　　年　　月　　日</text:p>
      <text:p>大　熊　町　長　あて</text:p>
      <table:table table:name="Applicant" table:style-name="GridTable">
        <table:table-column table:style-name="TopA"/>
        <table:table-column table:style-name="TopB"/>
        <table:table-column table:style-name="TopC"/>
        <table:table-column table:style-name="TopD"/>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Center">ご　住　所</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="Cell"><text:p>〒</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:number-rows-spanned="2" table:style-name="LabelCell"><text:p text:style-name="Center"><text:span text:style-name="Small">（ふりがな）</text:span></text:p><text:p text:style-name="Center">お　名　前</text:p></table:table-cell>
          <table:table-cell table:number-rows-spanned="2" table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Center">電話番号</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Center">mail</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p>次のとおり寄附をしたいので申し出ます。</text:p>
      <table:table table:name="DonationItems" table:style-name="GridTable">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-column table:style-name="ColD"/>
        <table:table-column table:style-name="ColE"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">返礼品の有無</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">寄　附　金　額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">申込<br/>口数</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">合　計　金　額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">配達希望</text:p><text:p text:style-name="Center">（※１）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>□返礼品を希望しない</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>□おおくまベリー２トレー</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">１口　10,000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">月</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>□おおくまベリー４トレー</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">１口　20,000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">月</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>□おおくまベリー６トレー</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">１口　25,000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">月</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>□飲む蒟蒻ゼリーセット</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">１口　10,000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>□セミドライフルーツセット</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">１口　15,000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>□ミニトマト　1kg</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">１口　15,000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>□日本酒（帰忘郷）１本</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">１口　15,000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>□日本酒（帰忘郷）２本</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">１口　25,000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>□甘酒（帰忘郷）８本セット</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">１口　15,000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>□ストロベリーシープ 280 g</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">１口　20,000 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">口</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:number-columns-spanned="3" table:style-name="Cell"><text:p text:style-name="Center">寄　附　総　額</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Small">（※1）配達希望につきましては、商品ごとに異なりますので、公式 HP をご確認ください。</text:p>
      <text:p text:style-name="Small">「寄附金の使途の希望」、「寄附の方法」については該当する□欄を黒く（■）塗りつぶしてください。</text:p>
      <table:table table:name="Options" table:style-name="GridTable">
        <table:table-column table:style-name="BottomA"/>
        <table:table-column table:style-name="BottomB"/>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Center">寄附金の使途の希望</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>□　町に任せる</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Center">寄附の方法</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>□　現金書留払い</text:p><text:p>□　町役場へ直接持参</text:p><text:p>□　口座振込（手数料は自己負担となります）</text:p><text:p>□　郵便振替（手数料がかからない専用の払込票を送付いたします）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Center">ワンストップ特例</text:p><text:p text:style-name="Center">（利用する場合のみ）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>□　利用する</text:p><text:p>利用するにチェックした方は、必ず下記もご記入ください。</text:p><text:p>性　別　　□ 男性　　　□ 女性</text:p><text:p>生年月日（　昭和・平成　　　年　　　月　　　日　）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Center">備考</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p>お問い合わせ先　　〒979-1306　福島県双葉郡大熊町大字大川原字南平 1717</text:p>
      <text:p>　　　　　　　　　大熊町役場　総務課　財政係　（TEL：0240-23-7582　FAX：0240-23-7845）</text:p>
    </office:text>
  </office:body>
</office:document>