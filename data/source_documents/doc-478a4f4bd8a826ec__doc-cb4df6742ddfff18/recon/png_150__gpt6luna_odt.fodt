<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:line-height="30pt"/>
      <style:text-properties fo:font-family="Liberation Serif" fo:font-size="18pt"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph" style:master-page-name="Page">
      <style:paragraph-properties fo:line-height="30pt" fo:margin-top="0pt" fo:margin-bottom="0pt"/>
    </style:style>
    <style:style style:name="Attachment" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:line-height="30pt" fo:margin-bottom="18pt"/>
      <style:text-properties fo:font-family="sans-serif" fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="center" fo:line-height="30pt" fo:margin-bottom="52pt"/>
      <style:text-properties fo:font-size="20pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="BodyLine" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:line-height="30pt"/>
    </style:style>
    <style:style style:name="Witness" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:margin-top="56pt" fo:margin-bottom="30pt"/>
    </style:style>
    <style:style style:name="DateLine" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:margin-bottom="74pt"/>
    </style:style>
    <style:style style:name="SignatureLine" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:line-height="30pt"/>
      <style:text-properties fo:font-weight="bold" style:text-underline-style="solid"/>
    </style:style>
    <style:style style:name="PageNumber" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="160pt"/>
      <style:text-properties fo:font-family="sans-serif" fo:font-size="12pt" fo:color="#777777"/>
    </style:style>
    <style:style style:name="Emphasis" style:family="text">
      <style:text-properties fo:font-weight="bold" style:text-underline-style="solid"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="8.27in" fo:page-height="11.69in" style:print-orientation="portrait" fo:margin-top="0.49in" fo:margin-bottom="0.49in" fo:margin-left="1.18in" fo:margin-right="1.18in"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Page" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Attachment">附件一</text:p>
      <text:p text:style-name="Title">POWER OF ATTORNEY</text:p>
      <text:p text:style-name="BodyLine">We, <text:span text:style-name="Emphasis">name of the company</text:span>, a company organized and existing under the laws</text:p>
      <text:p text:style-name="BodyLine">of <text:span text:style-name="Emphasis">name of the country or area</text:span>, having its head office at <text:span text:style-name="Emphasis">address of the</text:span></text:p>
      <text:p text:style-name="BodyLine"><text:span text:style-name="Emphasis">company</text:span>, and has no fixed place of business in the Republic of China, hereby</text:p>
      <text:p text:style-name="BodyLine">appoint <text:span text:style-name="Emphasis">name of the agent</text:span>, Taiwan, Republic of China, to act jointly and/or</text:p>
      <text:p text:style-name="BodyLine">severally, as our attorney-in-fact in the Republic of China, to file and</text:p>
      <text:p text:style-name="BodyLine">prosecute on our behalf all applications for the deemed profit basis which is</text:p>
      <text:p text:style-name="BodyLine">based on Article 25 of the Income Tax Law for <text:span text:style-name="Emphasis">name of the project or kinds</text:span></text:p>
      <text:p text:style-name="BodyLine"><text:span text:style-name="Emphasis">of activities</text:span> provided to <text:span text:style-name="Emphasis">name of Taiwan customer.</text:span></text:p>
      <text:p text:style-name="Witness">IN WITNESS WHEREOF,</text:p>
      <text:p text:style-name="DateLine">We have executed this power-of-attorney on <text:span text:style-name="Emphasis">date/month/year.</text:span></text:p>
      <text:p text:style-name="SignatureLine">Name of the company<text:tab/>(type)</text:p>
      <text:p text:style-name="SignatureLine">____________________________________________(signature)</text:p>
      <text:p text:style-name="SignatureLine">Name of the authorized signature<text:tab/>(type)</text:p>
      <text:p text:style-name="SignatureLine">Job title<text:tab/>(type)</text:p>
      <text:p text:style-name="PageNumber">第1頁</text:p>
    </office:text>
  </office:body>
</office:document>