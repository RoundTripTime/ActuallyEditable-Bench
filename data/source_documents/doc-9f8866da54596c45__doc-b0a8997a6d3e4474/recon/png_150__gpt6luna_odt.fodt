<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:text-properties fo:font-size="12pt"/>
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="0mm" fo:line-height="150%"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="right"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
    <style:style style:name="Page1Table" style:family="table">
      <style:table-properties style:width="154mm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="Page2Table" style:family="table">
      <style:table-properties style:width="154mm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="LabelCol" style:family="table-column">
      <style:table-column-properties style:column-width="35mm"/>
    </style:style>
    <style:style style:name="InputCol" style:family="table-column">
      <style:table-column-properties style:column-width="119mm"/>
    </style:style>
    <style:style style:name="LabelCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="3mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="InputCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="2mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="DashedCell" style:family="table-cell">
      <style:table-cell-properties fo:border-left="0.5pt solid #000000" fo:border-right="0.5pt solid #000000" fo:border-top="0.5pt solid #000000" fo:border-bottom="0.5pt dashed #000000" fo:padding="2mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="TableText" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="1mm" fo:line-height="150%"/>
    </style:style>
    <style:style style:name="TableCenter" style:family="paragraph" style:parent-style-name="TableText">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" style:print-orientation="portrait" fo:margin-top="15mm" fo:margin-bottom="15mm" fo:margin-left="28mm" fo:margin-right="28mm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Right">年　　月　　日</text:p>
      <text:p text:style-name="Body" fo:margin-top="14mm">一戸町長　様</text:p>
      <text:p text:style-name="Body" fo:margin-top="22mm">申請者　住　所</text:p>
      <text:p text:style-name="Body" fo:margin-left="72mm">団体等名称</text:p>
      <text:p text:style-name="Body" fo:margin-left="72mm">代表者氏名</text:p>
      <text:p text:style-name="Body" fo:margin-left="72mm">電話番号</text:p>
      <text:p text:style-name="Center" fo:margin-top="22mm">御所野遺跡世界遺産PRキャラクターデザイン使用申請書</text:p>
      <text:p text:style-name="Body" fo:margin-top="22mm" fo:margin-left="4mm">次のとおり、御所野遺跡世界遺産PRキャラクターデザインを使用したいので</text:p>
      <text:p text:style-name="Body" fo:margin-left="0mm">申請します。</text:p>
      <text:p text:style-name="Body" fo:margin-top="12mm"/>
      <table:table table:name="ApplicationDetails" table:style-name="Page1Table">
        <table:table-column table:style-name="LabelCol"/>
        <table:table-column table:style-name="InputCol"/>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="TableCenter">申　請　区　分</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell">
            <text:p text:style-name="TableText">□新規　　□継続（前回承認番号：令和　年　月　日第</text:p>
            <text:p text:style-name="TableText">号）</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="TableCenter">使用対象物件</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="TableCenter">使　用　目　的</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell">
            <text:p text:style-name="TableText">・広報活動用　 ・キャラクター商品製作販売使用</text:p>
            <text:p text:style-name="TableText">・商品等パッケージ使用</text:p>
            <text:p text:style-name="TableText">・その他（　　　　　　　　　　　　　　　　　　　　　　　　　）</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="TableCenter">使　用　内　容</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="TableCenter">使　用　方　法</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="TableCenter">使　用　期　間</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="TableCenter">年　　月　　日　～　　年　　月　　日</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="Body" fo:margin-top="18mm"/>
      <table:table table:name="DesignAndAttachments" table:style-name="Page2Table">
        <table:table-column table:style-name="LabelCol"/>
        <table:table-column table:style-name="InputCol"/>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="TableCenter">使用デザイン</text:p>
            <text:p text:style-name="TableCenter">（○で囲む）</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InputCell">
            <text:p text:style-name="TableText">・基本形　 ・A　 ・B　 ・C　 ・D　 ・E　 ・F　 ・G</text:p>
            <text:p text:style-name="TableText">・H　 ・I　 ・J　 ・K　 ・L　 ・M　 ・N　 ・O　 ・P</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="TableCenter">　</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="DashedCell">
            <text:p text:style-name="TableText">・S1　 ・S2　 ・S3　 ・S4　 ・S5　 ・S6　 ・S7　 ・S8　 ・S9</text:p>
            <text:p text:style-name="TableText">・S10　 ・S11　 ・S12　 ・S13　 ・S14</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="TableCenter">担当者連絡先</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell">
            <text:p text:style-name="TableText">住所：　　　　　　　　電話番号：　　　―　　　―</text:p>
            <text:p text:style-name="TableText">※申請者と同一の場合、記入不要</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="TableCenter">添　付　書　類</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell">
            <text:p text:style-name="TableText">1　企画書、見本等（レイアウト、スケッチ、原稿等）</text:p>
            <text:p text:style-name="TableText">2　申請者の概要書</text:p>
            <text:p text:style-name="TableText">3　その他（　　　　　　　　　　　　　　　　　　　　　　　　　）</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>