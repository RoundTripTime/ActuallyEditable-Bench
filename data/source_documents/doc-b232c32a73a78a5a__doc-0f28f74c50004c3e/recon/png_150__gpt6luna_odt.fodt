<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.12cm" fo:line-height="115%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.04cm" fo:line-height="110%"/>
      <style:text-properties fo:font-size="9.5pt"/>
    </style:style>
    <style:style style:name="Page" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="LabelCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="InputCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="LabelPara" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="130%"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="InputPara" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="130%"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-left="2.5cm" fo:margin-right="2.5cm" fo:margin-top="1.8cm" fo:margin-bottom="1.8cm"/>
    </style:page-layout>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.55cm" fo:margin-bottom="0.65cm"/>
      <style:text-properties fo:font-size="14pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="RightLine" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0.12cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.45cm" fo:margin-bottom="0.55cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Statement" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.42cm" fo:margin-bottom="0.34cm" fo:text-align="center"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.05cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="9.5pt"/>
    </style:style>
    <style:style style:name="ColLabel" style:family="table-column">
      <style:table-column-properties style:column-width="3.1cm"/>
    </style:style>
    <style:style style:name="ColInput" style:family="table-column">
      <style:table-column-properties style:column-width="13.9cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Body">様式第１号（第３条関係）</text:p>
      <text:p text:style-name="Title">鳥羽市鳥獣害対策事業補助金交付申請書</text:p>
      <text:p text:style-name="RightLine">令和　　　　年　　　　月　　　　日</text:p>
      <text:p text:style-name="Recipient">鳥羽市長　小竹　篤　様</text:p>
      <text:p text:style-name="RightLine">申請者　住所　：　＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿</text:p>
      <text:p text:style-name="RightLine">氏名　：　＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿　㊞</text:p>
      <text:p text:style-name="RightLine">（本人自署の場合は、押印は不要です）</text:p>
      <text:p text:style-name="RightLine">電話　：　＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿</text:p>
      <text:p text:style-name="Statement">鳥羽市鳥獣害対策事業補助金交付要綱第６条の規定により、次のとおり申請します。</text:p>
      <table:table table:name="ApplicationForm">
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColInput"/>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="LabelPara">設置場所<br/>（町字名地<br/>番）</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InputCell">
            <text:p text:style-name="InputPara">鳥羽市　　　　　　　　　町字　　　　　　　　　番地内</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="LabelPara">事業の目的</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InputCell">
            <text:p text:style-name="InputPara"/>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="LabelPara">総事業費</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InputCell">
            <text:p text:style-name="InputPara">　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="LabelPara">補助金交付<br/>申請額</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InputCell">
            <text:p text:style-name="InputPara">　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="LabelPara">添付資料</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InputCell">
            <text:p text:style-name="InputPara">１．　事業を実施しようとする位置図</text:p>
            <text:p text:style-name="InputPara">　　　（縮尺 1/3,000 以上の位置図）</text:p>
            <text:p text:style-name="InputPara">２．　収支予算書</text:p>
            <text:p text:style-name="InputPara">３．　防護柵用資材費の見積書（購入業者等からの）</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="LabelPara">備考</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InputCell">
            <text:p text:style-name="InputPara"/>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Note">※氏名が自署でない場合は、記名押印をお願いします。</text:p>
      <text:p text:style-name="Note">※補助金の対象となる経費は、防護柵用資材の購入に係る経費とし、設置に係る工事費等は含まないものとする。</text:p>
      <text:p text:style-name="Note">※補助金の額は 50,000 円を上限とし、防護柵用資材の購入額の２分の１を乗じた額とする。</text:p>
    </office:text>
  </office:body>
</office:document>