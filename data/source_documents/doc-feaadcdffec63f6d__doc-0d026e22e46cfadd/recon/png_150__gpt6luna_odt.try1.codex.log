          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell">
            <text:p>□生活保護の受給者（助成割合　10／10）</text:p>
            <text:p>□就学援助の受給者（助成割合　3／4）</text:p>
            <text:p>□上記以外の者　　　（助成割合　1／2）</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Centered">フリースクール等の授業料</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered">月額・日額　　　　　　　円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Centered">１月あたりの助成対象経費</text:p><text:p text:style-name="Centered">（見込み）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Date">円（上限40，000円）</text:p></table:table-cell>
