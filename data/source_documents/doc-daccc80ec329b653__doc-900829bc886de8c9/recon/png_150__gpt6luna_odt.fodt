<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin="0in" fo:line-height="100%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:default-style>
    <style:style style:name="DocumentTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="5mm" fo:margin-bottom="9mm"/>
      <style:text-properties fo:font-size="18pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="ClubName" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end" fo:margin-bottom="10mm" fo:border-bottom="0.5pt solid #333333" fo:padding-bottom="1mm"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="SectionHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="4mm" fo:margin-bottom="1mm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:line-height="0pt" fo:margin="0pt"/>
    </style:style>
    <style:style style:name="CellText" style:family="paragraph">
      <style:paragraph-properties fo:margin="0pt" fo:line-height="120%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="CellTextCentered" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin="0pt" fo:line-height="120%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="DueDate" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="1mm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" style:print-orientation="portrait" fo:margin-left="17mm" fo:margin-right="17mm" fo:margin-top="17mm" fo:margin-bottom="17mm"/>
    </style:page-layout>
    <style:style style:name="PageTable" style:family="table">
      <style:table-properties style:rel-width="100%"/>
    </style:style>
    <style:style style:name="LabelColumn" style:family="table-column">
      <style:table-column-properties style:column-width="145mm"/>
    </style:style>
    <style:style style:name="CountColumn" style:family="table-column">
      <style:table-column-properties style:column-width="31mm"/>
    </style:style>
    <style:style style:name="FormCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #555555" fo:padding="1.5mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="FormInputCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #555555" fo:padding="1.5mm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="LabelHeaderRow" style:family="table-row">
      <style:table-row-properties style:row-height="13mm"/>
    </style:style>
    <style:style style:name="FirstLabelHeaderRow" style:family="table-row">
      <style:table-row-properties style:row-height="15mm"/>
    </style:style>
    <style:style style:name="InputRow" style:family="table-row">
      <style:table-row-properties style:row-height="40mm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="DefaultPage" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="DocumentTitle">老人クラブ地域活動状況等調査票</text:p>
      <text:p text:style-name="ClubName">老人クラブ</text:p>
      <text:p text:style-name="SectionHeading">１　今年度の活動について</text:p>
      <table:table table:name="ActivitiesPage1" table:style-name="PageTable">
        <table:table-column table:style-name="LabelColumn"/>
        <table:table-column table:style-name="CountColumn"/>
        <table:table-row table:style-name="FirstLabelHeaderRow">
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellText">①友愛活動 ・・・ 地区内のひとり暮らしやねたきりの高齢者宅を訪問し</text:p>
            <text:p text:style-name="CellText">　　話し相手となるなど</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellTextCentered">回数・参加者</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="FormInputCell"/>
          <table:table-cell table:style-name="FormInputCell"/>
        </table:table-row>
        <table:table-row table:style-name="LabelHeaderRow">
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellText">②生活支援活動 ・・・ 近隣の高齢者に対する家事の手助け等</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellTextCentered">回数・参加者</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="FormInputCell"/>
          <table:table-cell table:style-name="FormInputCell"/>
        </table:table-row>
        <table:table-row table:style-name="LabelHeaderRow">
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellText">③清掃・奉仕・環境活動 ・・・ リサイクルの実施、歩道などの花壇の整備等</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellTextCentered">回数・参加者</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="FormInputCell"/>
          <table:table-cell table:style-name="FormInputCell"/>
        </table:table-row>
        <table:table-row table:style-name="LabelHeaderRow">
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellText">④文化・学習サークル活動 ・・・ 短歌、書道、詩吟、陶芸などの活動</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellTextCentered">回数・参加者</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="FormInputCell"/>
          <table:table-cell table:style-name="FormInputCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageStart"/>
      <table:table table:name="ActivitiesPage2" table:style-name="PageTable">
        <table:table-column table:style-name="LabelColumn"/>
        <table:table-column table:style-name="CountColumn"/>
        <table:table-row table:style-name="LabelHeaderRow">
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellText">⑤スポーツサークル活動 ・・・ ゲートボール、グラウンドゴルフ、歩こう会など</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellTextCentered">回数・参加者</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="FormInputCell"/>
          <table:table-cell table:style-name="FormInputCell"/>
        </table:table-row>
        <table:table-row table:style-name="LabelHeaderRow">
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellText">⑥安全活動 ・・・ 交差点での交通安全運動など</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellTextCentered">回数・参加者</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="FormInputCell"/>
          <table:table-cell table:style-name="FormInputCell"/>
        </table:table-row>
        <table:table-row table:style-name="LabelHeaderRow">
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellText">⑦世代間の交流 ・・・ 地域の子ども会と昔の遊びをするなど</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellTextCentered">回数・参加者</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="FormInputCell"/>
          <table:table-cell table:style-name="FormInputCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="DueDate">年　 月　 日（　）までに高齢者支援課へ提出してください。</text:p>
    </office:text>
  </office:body>
</office:document>