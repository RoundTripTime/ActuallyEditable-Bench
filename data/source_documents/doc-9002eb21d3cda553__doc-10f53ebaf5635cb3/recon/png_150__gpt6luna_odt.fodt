<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.08cm"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0.08cm"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.35cm" fo:margin-bottom="0.3cm"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0cm" fo:margin-bottom="0.08cm"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="Centered" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0.08cm"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="CellP" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="9.5pt"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="9.5pt"/>
    </style:style>
    <style:style style:name="CellRight" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="9.5pt"/>
    </style:style>
    <style:style style:name="TableCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #666666" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="TableCellTop" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #666666" fo:padding="0.04cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="DashedCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #666666" fo:border-bottom="0.5pt dashed #666666" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="3.35cm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="10.5cm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="3.45cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="1.7cm" fo:margin-bottom="1.7cm" fo:margin-left="1.8cm" fo:margin-right="1.8cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">別記様式第１号（第４条関係）</text:p>
      <text:p text:style-name="Title">浦幌町まち・ひと・しごと創生寄附活用事業寄附申出書</text:p>
      <text:p text:style-name="Right">年　　月　　日</text:p>
      <text:p text:style-name="P">浦幌町長　様</text:p>
      <text:p text:style-name="Right">法　　人　　名</text:p>
      <text:p text:style-name="Right">法　人　番　号</text:p>
      <text:p text:style-name="Right">代表者職・氏名</text:p>
      <text:p text:style-name="Right">本　社　住　所　〒</text:p>
      <text:p text:style-name="P">浦幌町で実施する浦幌町まち・ひと・しごと創生寄附活用事業に対し、下記のとおり寄附することを申し出ます。</text:p>
      <text:p text:style-name="Centered">記</text:p>
      <table:table table:name="申出書">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-row>
          <table:table-cell table:style-name="TableCell">
            <text:p text:style-name="CellCenter">寄　附　申　出　額</text:p>
            <text:p text:style-name="CellCenter">（ 総 額 ） 等</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="2">
            <text:p text:style-name="CellP">金　　　　　　　　　円　（寄附予定年月 ：　　年　　月）</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="TableCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell" table:number-rows-spanned="6">
            <text:p text:style-name="CellCenter">寄附の対象事業</text:p>
            <text:p text:style-name="CellCenter">及 び 寄 附 金 額</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="TableCell">
            <text:p text:style-name="CellCenter">事業名</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="TableCell">
            <text:p text:style-name="CellCenter">寄附金額</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="TableCell"/>
          <table:table-cell table:style-name="DashedCell">
            <text:p text:style-name="CellP">□　安心して暮らせる持続可能なまちづくり事業</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="DashedCell">
            <text:p text:style-name="CellRight">円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="TableCell"/>
          <table:table-cell table:style-name="DashedCell">
            <text:p text:style-name="CellP">□　地域資源を生かした稼ぐ力の創出事業</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="DashedCell">
            <text:p text:style-name="CellRight">円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="TableCell"/>
          <table:table-cell table:style-name="DashedCell">
            <text:p text:style-name="CellP">□　多様な人が集い、学び、活躍できる地域社会事業</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="DashedCell">
            <text:p text:style-name="CellRight">円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="TableCell"/>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="2">
            <text:p text:style-name="CellP">○具体的な支援事業（上記より具体的な支援希望があればご記入ください）</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="TableCell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="TableCell"/>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="2">
            <text:p text:style-name="CellP">事業名：　＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="TableCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell" table:number-rows-spanned="3">
            <text:p text:style-name="CellCenter">寄附情報の公表</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="DashedCell" table:number-columns-spanned="2">
            <text:p text:style-name="CellP">□　企業概要（法人名・本社所在地など）、寄附活用事業・年月日・金額</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="DashedCell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="TableCell"/>
          <table:table-cell table:style-name="DashedCell" table:number-columns-spanned="2">
            <text:p text:style-name="CellP">□　企業概要（法人名・本社所在地など）、寄附活用事業・年月日</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="DashedCell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="TableCell"/>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="2">
            <text:p text:style-name="CellP">□　公表を希望しない（理由：　　　　　　　　　　　　　　　　　）</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="TableCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell" table:number-rows-spanned="4">
            <text:p text:style-name="CellCenter">入　金　方　法</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="DashedCell" table:number-columns-spanned="2">
            <text:p text:style-name="CellP">□　町が発行する納付書</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="DashedCell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="TableCell"/>
          <table:table-cell table:style-name="DashedCell" table:number-columns-spanned="2">
            <text:p text:style-name="CellP">□　町長が指定する口座への振込み</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="DashedCell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="TableCell"/>
          <table:table-cell table:style-name="DashedCell" table:number-columns-spanned="2">
            <text:p text:style-name="CellP">□　現金書留郵便</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="DashedCell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="TableCell"/>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="2">
            <text:p text:style-name="CellP">□　現金・小切手の持参</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="TableCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell" table:number-rows-spanned="2">
            <text:p text:style-name="CellCenter">感 謝 状 贈 呈 式</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="DashedCell" table:number-columns-spanned="2">
            <text:p text:style-name="CellP">□　希望する</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="DashedCell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="TableCell"/>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="2">
            <text:p text:style-name="CellP">□　希望しない（郵送等による贈呈）</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="TableCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell" table:number-rows-spanned="4">
            <text:p text:style-name="CellCenter">担 当 者 連 絡 先</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="DashedCell">
            <text:p text:style-name="CellP">所属・職・氏名</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="DashedCell">
            <text:p text:style-name="CellP"/>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="TableCell"/>
          <table:table-cell table:style-name="DashedCell">
            <text:p text:style-name="CellP">住　　　所　〒</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="DashedCell">
            <text:p text:style-name="CellP"/>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="TableCell"/>
          <table:table-cell table:style-name="DashedCell">
            <text:p text:style-name="CellP">電　話　番　号</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="DashedCell">
            <text:p text:style-name="CellP"/>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="TableCell"/>
          <table:table-cell table:style-name="TableCell">
            <text:p text:style-name="CellP">メールアドレス</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="TableCell">
            <text:p text:style-name="CellP"/>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell" table:number-rows-spanned="2">
            <text:p text:style-name="CellCenter">寄附の契機とな</text:p>
            <text:p text:style-name="CellCenter">った仲介事業者</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="DashedCell" table:number-columns-spanned="2">
            <text:p text:style-name="CellP">□　有（仲介事業者名：　　　　）</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="DashedCell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="TableCell"/>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="2">
            <text:p text:style-name="CellP">□　無</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="TableCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell">
            <text:p text:style-name="CellCenter">備　　　考</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="TableCellTop" table:number-columns-spanned="2">
            <text:p text:style-name="CellP"/>
          </table:table-cell>
          <table:covered-table-cell table:style-name="TableCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="P">※寄附申出額（総額）が100万円以上の場合、感謝状贈呈式の希望項目にチェック☑を入れてください。</text:p>
    </office:text>
  </office:body>
</office:document>