            <text:p text:style-name="CellP"/>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell" table:number-rows-spanned="2">
            <text:p text:style-name="CellCenter">寄附の契機とな</text:p>
            <text:p text:style-name="CellCenter">った仲介事業者</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="DashedCell" table:number-columns-spanned="2">
            <text:p text:style-name="CellP">□　有（仲介事業者名：　　　　）</text:p>
