      <text:p text:style-name="PageStart">別記様式第１号（第４条関係）</text:p>
      <text:p text:style-name="Title">浦幌町まち・ひと・しごと創生寄附活用事業寄附申出書</text:p>
      <text:p text:style-name="Right">年　　月　　日</text:p>
      <text:p text:style-name="P">浦幌町長　様</text:p>
      <text:p text:style-name="Right">法　　人　　名</text:p>
      <text:p text:style-name="Right">法　人　番　号</text:p>
      <text:p text:style-name="Right">代表者職・氏名</text:p>
      <text:p text:style-name="Right">本　社　住　所　〒</text:p>
      <text:p text:style-name="P">浦幌町で実施する浦幌町まち・ひと・しごと創生寄附活用事業に対し、下記のとおり寄附することを申し出ます。</text:p>
      <text:p text:style-name="Centered">記</text:p>
      <table:table table:name="申出書">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-row>
          <table:table-cell table:style-name="TableCell">
            <text:p text:style-name="CellCenter">寄　附　申　出　額</text:p>
            <text:p text:style-name="CellCenter">（ 総 額 ） 等</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="2">
            <text:p text:style-name="CellP">金　　　　　　　　　円　（寄附予定年月 ：　　年　　月）</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="TableCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell" table:number-rows-spanned="6">
            <text:p text:style-name="CellCenter">寄附の対象事業</text:p>
            <text:p text:style-name="CellCenter">及 び 寄 附 金 額</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="TableCell">
            <text:p text:style-name="CellCenter">事業名</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="TableCell">
            <text:p text:style-name="CellCenter">寄附金額</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="TableCell"/>
          <table:table-cell table:style-name="DashedCell">
            <text:p text:style-name="CellP">□　安心して暮らせる持続可能なまちづくり事業</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="DashedCell">
            <text:p text:style-name="CellRight">円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="TableCell"/>
          <table:table-cell table:style-name="DashedCell">
            <text:p text:style-name="CellP">□　地域資源を生かした稼ぐ力の創出事業</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="DashedCell">
            <text:p text:style-name="CellRight">円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="TableCell"/>
          <table:table-cell table:style-name="DashedCell">
            <text:p text:style-name="CellP">□　多様な人が集い、学び、活躍できる地域社会事業</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="DashedCell">
            <text:p text:style-name="CellRight">円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="TableCell"/>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="2">
            <text:p text:style-name="CellP">○具体的な支援事業（上記より具体的な支援希望があればご記入ください）</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="TableCell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="TableCell"/>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="2">
            <text:p text:style-name="CellP">事業名：　＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="TableCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell" table:number-rows-spanned="3">
            <text:p text:style-name="CellCenter">寄附情報の公表</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="DashedCell" table:number-columns-spanned="2">
            <text:p text:style-name="CellP">□　企業概要（法人名・本社所在地など）、寄附活用事業・年月日・金額</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="DashedCell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="TableCell"/>
          <table:table-cell table:style-name="DashedCell" table:number-columns-spanned="2">
            <text:p text:style-name="CellP">□　企業概要（法人名・本社所在地など）、寄附活用事業・年月日</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="DashedCell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="TableCell"/>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="2">
            <text:p text:style-name="CellP">□　公表を希望しない（理由：　　　　　　　　　　　　　　　　　）</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="TableCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell" table:number-rows-spanned="4">
            <text:p text:style-name="CellCenter">入　金　方　法</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="DashedCell" table:number-columns-spanned="2">
            <text:p text:style-name="CellP">□　町が発行する納付書</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="DashedCell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="TableCell"/>
          <table:table-cell table:style-name="DashedCell" table:number-columns-spanned="2">
