      <table:table table:name="OtherInformation" table:style-name="FormTable">
        <table:table-column table:style-name="BottomA"/>
        <table:table-column table:style-name="BottomB"/>
        <table:table-row table:style-name="RowMedium">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="L">丸亀市における徴収金の滞納の有無</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowMedium">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="L">やむを得ず滞納している場合はその理由</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="RowMedium">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="L">過去１年間の同承認申請の取消の有無</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
