<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Default" style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="CellText" style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="100%" fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="StartPage" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:text-align="center" fo:line-height="100%"/>
      <style:text-properties fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%"/>
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
    <style:style style:name="TableBase" style:family="table">
      <style:table-properties style:width="18cm" table:align="center"/>
    </style:style>
    <style:style style:name="ColLabel" style:family="table-column">
      <style:table-column-properties style:column-width="4.2cm"/>
    </style:style>
    <style:style style:name="ColField" style:family="table-column">
      <style:table-column-properties style:column-width="13.8cm"/>
    </style:style>
    <style:style style:name="ApplicantLabel" style:family="table-column">
      <style:table-column-properties style:column-width="4.1cm"/>
    </style:style>
    <style:style style:name="ApplicantField" style:family="table-column">
      <style:table-column-properties style:column-width="4.5cm"/>
    </style:style>
    <style:style style:name="ApplicantLabel2" style:family="table-column">
      <style:table-column-properties style:column-width="2.6cm"/>
    </style:style>
    <style:style style:name="ApplicantField2" style:family="table-column">
      <style:table-column-properties style:column-width="6.8cm"/>
    </style:style>
    <style:style style:name="GridCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="LabelCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center" fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="18cm" table:align="center"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.2cm" fo:margin-bottom="1.2cm" fo:margin-left="1.5cm" fo:margin-right="1.5cm" style:print-orientation="portrait"/>
    </style:page-layout>
    <style:style style:name="ColNarrow" style:family="table-column">
      <style:table-column-properties style:column-width="4.1cm"/>
    </style:style>
    <style:style style:name="ColMid" style:family="table-column">
      <style:table-column-properties style:column-width="4.5cm"/>
    </style:style>
    <style:style style:name="ColSmall" style:family="table-column">
      <style:table-column-properties style:column-width="2.6cm"/>
    </style:style>
    <style:style style:name="ColWide" style:family="table-column">
      <style:table-column-properties style:column-width="6.8cm"/>
    </style:style>
    <style:style style:name="EventLabel" style:family="table-column">
      <style:table-column-properties style:column-width="4.2cm"/>
    </style:style>
    <style:style style:name="EventField" style:family="table-column">
      <style:table-column-properties style:column-width="13.8cm"/>
    </style:style>
    <style:style style:name="FooterCell" style:family="table-cell">
      <style:table-cell-properties fo:border="1.5pt solid #000000" fo:padding="0.15cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="SectionHead" style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%" fo:margin-top="0.15cm" fo:margin-bottom="0.08cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="FooterText" style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="FooterStrong" style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt" fo:font-weight="bold"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="StartPage">春日部市民の日協賛事業申込書</text:p>
      <text:p text:style-name="CellText">別紙１　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　申込日　令和　　年　　月　　日</text:p>
      <text:p text:style-name="SectionHead">＜春日部市民の日協賛事業　開催内容＞<text:span text:style-name="Small">※ご記入いただいた内容をもとに市ホームページ掲載情報を作成します。</text:span></text:p>
      <table:table table:name="開催内容" table:style-name="FormTable">
        <table:table-column table:style-name="EventLabel"/>
        <table:table-column table:style-name="EventField"/>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Center">フリガナ</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Center">企業・団体等名称</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="Center">事業名</text:p>
            <text:p text:style-name="Small">例）春日部市民の日記念</text:p>
            <text:p text:style-name="Center">○○○セール</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="GridCell">
            <text:p text:style-name="Center">※事業名に必ず「春日部市民の日記念」を入れてください</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="Center">事業内容</text:p>
            <text:p text:style-name="CellText">※留意事項（先着○○名様</text:p>
            <text:p text:style-name="CellText">　限り、なくなり次第終了</text:p>
            <text:p text:style-name="CellText">　等）を記載してください</text:p>
            <text:p text:style-name="CellText">。</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Center">開催日</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="Center">月　　　日（　）～　　　月　　　日（　）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Center">開催時間</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="Center">時　　　分　　～　　時　　　分</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Center">開催場所</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="Center">市民からの問合せ先</text:p>
            <text:p text:style-name="Center">（電話番号）</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="SectionHead">＜申込者情報＞</text:p>
      <table:table table:name="申込者情報" table:style-name="FormTable">
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-column table:style-name="ColMid"/>
        <table:table-column table:style-name="ColSmall"/>
        <table:table-column table:style-name="ColWide"/>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Center">担当者（フリガナ）</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="3">
            <text:p text:style-name="Center">（</text:p>
            <text:p text:style-name="Center">）</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Center">電話番号</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Center">FAX 番号</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Center">メールアドレス</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="3"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Center">所在地</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="3"><text:p text:style-name="CellText">〒</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="Center">内容等確認方法</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="3">
            <text:p text:style-name="Center">市のHP等掲載内容の確認方法について、ご希望の方法に○をつけてください</text:p>
            <text:p text:style-name="Center">メール　・　FAX</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="Center">事業 PR の方法</text:p>
            <text:p text:style-name="Small">※現段階でお考えの PR 方法を教えてください。</text:p>
            <text:p text:style-name="Small">※市の HP 等は除く。</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="3"><text:p text:style-name="CellText">PR 方法と時期</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="4">
            <text:p text:style-name="CellText">チェックを入れてください。</text:p>
            <text:p text:style-name="CellText">□ 「春日部市民の日協賛事業募集要項」の内容を確認の上、協賛事業に申込みます</text:p>
            <text:p text:style-name="CellText">。</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <table:table table:name="お問い合わせ先" table:style-name="FormTable">
        <table:table-column table:style-name="EventField"/>
        <table:table-row>
          <table:table-cell table:style-name="FooterCell">
            <text:p text:style-name="FooterStrong">お問い合わせ先：春日部市役所　シティセールス広報課　シティセールス推進担当</text:p>
            <text:p text:style-name="FooterText">郵送先：〒344-8577 春日部市中央7-2-1　春日部市役所シティセールス広報課</text:p>
            <text:p text:style-name="FooterText">電話番号：048-796-5985（直通）　※平日の8:30～17:15</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>