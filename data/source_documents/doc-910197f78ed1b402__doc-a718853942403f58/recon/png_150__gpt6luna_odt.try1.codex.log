    </style:style>
    <style:style style:name="Input" style:family="table-cell" style:parent-style-name="Cell">
      <style:table-cell-properties fo:background-color="#FCE9DA" fo:border="0.5pt solid #000000" fo:padding="0.05cm"/>
    </style:style>
    <style:style style:name="HeadCell" style:family="table-cell" style:parent-style-name="Cell">
      <style:table-cell-properties fo:background-color="#FCE9DA" fo:border="0.5pt solid #000000" fo:padding="0.05cm"/>
    </style:style>
    <style:style style:name="Col" style:family="table-column">
