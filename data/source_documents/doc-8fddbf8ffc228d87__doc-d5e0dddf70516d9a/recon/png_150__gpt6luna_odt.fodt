<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="TitleStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="1.1cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="16pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.3cm" fo:margin-top="0.2cm" fo:margin-bottom="0.55cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="RightDate" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0.15cm" fo:margin-bottom="0.65cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Issuer" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="6cm" fo:margin-top="0cm" fo:margin-bottom="0.08cm" fo:line-height="125%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Seal" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="-0.55cm" fo:margin-bottom="0.7cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="BodyText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="justify" fo:line-height="150%" fo:margin-top="0.2cm" fo:margin-bottom="0.65cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="CellText" style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="120%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="CellRight" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:line-height="120%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="EquipmentText" style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="9.5pt"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.45cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="2.5cm" fo:margin-bottom="2.5cm" fo:margin-left="2.5cm" fo:margin-right="2.5cm"/>
    </style:page-layout>
    <style:style style:name="BorderedTable" style:family="table"/>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="2.15cm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="3.7cm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="10.15cm"/>
    </style:style>
    <style:style style:name="AmountColA" style:family="table-column">
      <style:table-column-properties style:column-width="2.15cm"/>
    </style:style>
    <style:style style:name="AmountColB" style:family="table-column">
      <style:table-column-properties style:column-width="3.7cm"/>
    </style:style>
    <style:style style:name="AmountColC" style:family="table-column">
      <style:table-column-properties style:column-width="5cm"/>
    </style:style>
    <style:style style:name="AmountColD" style:family="table-column">
      <style:table-column-properties style:column-width="5.15cm"/>
    </style:style>
    <style:style style:name="EquipColA" style:family="table-column">
      <style:table-column-properties style:column-width="2.15cm"/>
    </style:style>
    <style:style style:name="EquipColB" style:family="table-column">
      <style:table-column-properties style:column-width="6.35cm"/>
    </style:style>
    <style:style style:name="EquipColC" style:family="table-column">
      <style:table-column-properties style:column-width="7.5cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #555555" fo:padding="0.12cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="EquipCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #555555" fo:padding="0.07cm" style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="TitleStart">領収証明書</text:p>
      <text:p text:style-name="Recipient">（あて先）千葉市長</text:p>
      <text:p text:style-name="RightDate">年　　月　　日</text:p>
      <text:p text:style-name="Issuer">住　所</text:p>
      <text:p text:style-name="Issuer">名　称</text:p>
      <text:p text:style-name="Issuer">代表者職氏名</text:p>
      <text:p text:style-name="Seal">印</text:p>
      <text:p text:style-name="BodyText">次の顧客の千葉市住宅用設備等脱炭素化促進事業補助金に関し、下記内容で代金を</text:p>
      <text:p text:style-name="BodyText">受領いたしました。なお、本書は顧客のクレジット（ローン）返済金の受領を証する</text:p>
      <text:p text:style-name="BodyText">ものではありません。</text:p>

      <table:table table:name="Payer" table:style-name="BorderedTable">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2">
            <text:p text:style-name="CellCenter">支払者</text:p>
            <text:p text:style-name="CellCenter">（申請者）</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellText">氏　　名</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellText">住　　所</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>

      <table:table table:name="Payment" table:style-name="BorderedTable">
        <table:table-column table:style-name="AmountColA"/>
        <table:table-column table:style-name="AmountColB"/>
        <table:table-column table:style-name="AmountColC"/>
        <table:table-column table:style-name="AmountColD"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="4">
            <text:p text:style-name="CellCenter">支払額</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellCenter">費　　用</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellCenter">金　　額</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellCenter">入金（受領）日</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellCenter">現　　金</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellRight">円</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellCenter">年　月　日</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellCenter">クレジット</text:p>
            <text:p text:style-name="CellCenter">（ローン）</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellRight">円</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellCenter">年　月　日</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="CellCenter">合　　計</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2">
            <text:p text:style-name="CellRight">円</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>

      <table:table table:name="Equipment" table:style-name="BorderedTable">
        <table:table-column table:style-name="EquipColA"/>
        <table:table-column table:style-name="EquipColB"/>
        <table:table-column table:style-name="EquipColC"/>
        <table:table-row>
          <table:table-cell table:style-name="EquipCell" table:number-rows-spanned="5">
            <text:p text:style-name="CellCenter">支払対象</text:p>
            <text:p text:style-name="CellCenter">設備</text:p>
            <text:p text:style-name="CellCenter">（該当する</text:p>
            <text:p text:style-name="CellCenter">設備に</text:p>
            <text:p text:style-name="CellCenter">チェック）</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="EquipCell">
            <text:p text:style-name="EquipmentText">□太陽光発電システム</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="EquipCell">
            <text:p text:style-name="EquipmentText">□電気自動車</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="EquipCell">
            <text:p text:style-name="EquipmentText">□ZEH＋</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="EquipCell">
            <text:p text:style-name="EquipmentText">□プラグインハイブリッド</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="EquipCell">
            <text:p text:style-name="EquipmentText">□家庭用燃料電池システム(エネファーム)</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="EquipCell">
            <text:p text:style-name="EquipmentText">□V2H 充放電設備</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="EquipCell">
            <text:p text:style-name="EquipmentText">□定置用リチウムイオン蓄電システム</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="EquipCell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="EquipCell">
            <text:p text:style-name="EquipmentText">□窓の断熱改修</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="EquipCell"/>
        </table:table-row>
      </table:table>

      <text:p text:style-name="Note">※原本でのご提出をお願いします</text:p>
    </office:text>
  </office:body>
</office:document>