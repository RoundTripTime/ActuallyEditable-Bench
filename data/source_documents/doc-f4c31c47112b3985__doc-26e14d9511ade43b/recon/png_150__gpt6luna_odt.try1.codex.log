<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="120%"/>
      <style:text-properties fo:font-family="Noto Serif CJK JP" fo:font-size="11pt"/>
    </style:default-style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="CenterText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="RightText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="SmallText" style:family="paragraph">
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="2cm" fo:margin-right="2cm" fo:margin-top="2cm" fo:margin-bottom="2cm" style:print-orientation="portrait"/>
    </style:page-layout>
    <style:style style:name="OuterTable" style:family="table">
      <style:table-properties style:width="17cm" table:align="margins"/>
    </style:style>
    <style:style style:name="PlainTable" style:family="table">
      <style:table-properties style:width="17cm"/>
    </style:style>
    <style:style style:name="ColOuter" style:family="table-column">
      <style:table-column-properties style:column-width="17cm"/>
    </style:style>
    <style:style style:name="ColDate" style:family="table-column">
      <style:table-column-properties style:column-width="17cm"/>
    </style:style>
    <style:style style:name="ColMainLeft" style:family="table-column">
      <style:table-column-properties style:column-width="8.5cm"/>
    </style:style>
    <style:style style:name="ColMainRight" style:family="table-column">
      <style:table-column-properties style:column-width="8.5cm"/>
    </style:style>
    <style:style style:name="ColLabel" style:family="table-column">
      <style:table-column-properties style:column-width="2.3cm"/>
    </style:style>
    <style:style style:name="ColNewOld" style:family="table-column">
      <style:table-column-properties style:column-width="0.7cm"/>
    </style:style>
    <style:style style:name="ColInfo" style:family="table-column">
      <style:table-column-properties style:column-width="14cm"/>
    </style:style>
    <style:style style:name="BorderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.12cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="MainCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.16cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="InnerCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0.08cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="InputCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.14cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="NoBorderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0.1cm" style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">様式第３２号（第１９条関係）</text:p>
      <table:table table:name="Form" table:style-name="OuterTable">
        <table:table-column table:style-name="ColOuter"/>
        <table:table-row>
          <table:table-cell table:style-name="BorderCell">
            <text:p text:style-name="CenterText">市・県民税納税管理人(変更)申告書</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MainCell">
            <table:table table:name="MainLayout" table:style-name="PlainTable">
              <table:table-column table:style-name="ColMainLeft"/>
              <table:table-column table:style-name="ColMainRight"/>
              <table:table-row>
                <table:table-cell table:number-columns-spanned="2" table:style-name="InnerCell">
                  <text:p text:style-name="RightText">年　　月　　日</text:p>
                </table:table-cell>
              </table:table-row>
              <table:table-row>
                <table:table-cell table:style-name="InnerCell">
                  <text:p>結城市長　　　　様</text:p>
                </table:table-cell>
                <table:table-cell table:style-name="InnerCell">
                  <text:p>納税義務者</text:p>
                  <text:p>（特別徴収義務者）</text:p>
                  <text:p>住（居）所</text:p>
                  <text:p>氏　　　名</text:p>
                  <text:p>（電話　　　　　　　　　）</text:p>
                  <text:p>個人番号又</text:p>
                  <text:p>は法人番号</text:p>
                </table:table-cell>
              </table:table-row>
              <table:table-row>
                <table:table-cell table:number-columns-spanned="2" table:style-name="InnerCell">
                  <text:p>下記の者を市・県民税の納税管理人として定めました(変更します)から申告いたしま</text:p>
                  <text:p>す。</text:p>
                </table:table-cell>
              </table:table-row>
            </table:table>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="InputCell">
            <table:table table:name="Administrator" table:style-name="PlainTable">
              <table:table-column table:style-name="ColLabel"/>
              <table:table-column table:style-name="ColNewOld"/>
              <table:table-column table:style-name="ColInfo"/>
              <table:table-row>
                <table:table-cell table:number-rows-spanned="2" table:style-name="InputCell">
                  <text:p text:style-name="CenterText">納税管理人</text:p>
                </table:table-cell>
                <table:table-cell table:style-name="InputCell">
                  <text:p text:style-name="CenterText">新</text:p>
                </table:table-cell>
                <table:table-cell table:style-name="InputCell">
                  <text:p>住（居）所</text:p>
                  <text:p>氏　　　名</text:p>
                  <text:p text:style-name="RightText">（電話　　　　　　　　　）</text:p>
                </table:table-cell>
              </table:table-row>
              <table:table-row>
                <table:covered-table-cell/>
                <table:table-cell table:style-name="InputCell">
                  <text:p text:style-name="CenterText">旧</text:p>
                </table:table-cell>
                <table:table-cell table:style-name="InputCell">
                  <text:p>住（居）所</text:p>
                  <text:p>氏　　　名</text:p>
                  <text:p text:style-name="RightText">（電話　　　　　　　　　）</text:p>
                </table:table-cell>
              </table:table-row>
            </table:table>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="BorderCell">
            <text:p text:style-name="CenterText">承　　諾　　書</text:p>
            <text:p text:style-name="RightText">年　　月　　日</text:p>
            <text:p>結城市長　　　　様</text:p>
            <text:p text:style-name="RightText">氏名</text:p>
            <text:p>納税義務者(特別徴収義務者)　　　　の納税管理人を承諾しました。</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="SmallText">（注）市・県民税の納税義務者は、納税義務を負う市内に住所、居所、事務所又は事業</text:p>
      <text:p text:style-name="SmallText">　　　所を有しない場合には、納税に関する一切の事項を処理させるため、市の区域内に</text:p>
      <text:p text:style-name="SmallText">　　　居住する者のうちから納税管理人を定め、これを市長に申告しなければなりませ</text:p>
      <text:p text:style-name="SmallText">　　　ん。納税管理人を変更した場合においても、また同様です。</text:p>
    </office:text>
  </office:body>
</office:document>
