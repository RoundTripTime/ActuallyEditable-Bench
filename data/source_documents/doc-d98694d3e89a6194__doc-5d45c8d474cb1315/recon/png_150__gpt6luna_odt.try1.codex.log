        <table:table-row>
          <table:table-cell table:style-name="LabelCell" table:number-columns-spanned="2"><text:p text:style-name="BodyText">主たる事務所又は事業所の所在地</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="AnswerCell"><text:p text:style-name="BodyText">〒</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell" table:number-rows-spanned="4"><text:p text:style-name="BodyText">連絡先</text:p></table:table-cell>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="BodyText">担当者　役職・氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="AnswerCell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="BodyText">電話番号</text:p></table:table-cell>
