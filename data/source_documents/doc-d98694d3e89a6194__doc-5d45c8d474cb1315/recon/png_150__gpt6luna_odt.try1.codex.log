        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="BodyText">受領証等送付先</text:p></table:table-cell>
          <table:table-cell table:style-name="AnswerCell">
            <text:p text:style-name="BodyText">〒</text:p>
            <text:p text:style-name="BodyText">□　主たる事務所又は事業所の所在地に同じ</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell" table:number-columns-spanned="2">
            <text:p text:style-name="BodyText">寄附申出額</text:p>
            <text:p text:style-name="SmallText">※１０万円以上かつ事業の実施に要する</text:p>
            <text:p text:style-name="SmallText">　経費の範囲内の額となります。</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="AnswerCell"><text:p text:style-name="CenterText">________________________円</text:p></table:table-cell>
