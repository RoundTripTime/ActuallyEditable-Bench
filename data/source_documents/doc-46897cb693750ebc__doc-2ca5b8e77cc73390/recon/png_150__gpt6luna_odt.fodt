<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
                 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
                 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
                 xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
                 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
                 office:mimetype="application/vnd.oasis.opendocument.text"
                 office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:orphans="0" fo:widows="0"/>
      <style:text-properties fo:font-size="12pt" style:font-name="serif"/>
    </style:default-style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm"
                                    fo:margin-left="1.7cm" fo:margin-right="1.7cm"
                                    fo:margin-top="1.7cm" fo:margin-bottom="1.7cm"
                                    style:print-orientation="portrait"
                                    fo:border="0.5pt solid #000000"
                                    fo:padding="0.2cm"/>
    </style:page-layout>
    <style:style style:name="Header" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:margin-bottom="0.9cm"/>
    </style:style>
    <style:style style:name="Stamp" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end" fo:margin="0cm" fo:margin-bottom="0.25cm"/>
      <style:text-properties fo:font-size="16pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin="0cm" fo:margin-bottom="0.95cm"/>
      <style:text-properties fo:font-size="18pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.12cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellTop" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.12cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="ColumnNumber" style:family="table-column">
      <style:table-column-properties style:column-width="0.95cm"/>
    </style:style>
    <style:style style:name="ColumnLabel" style:family="table-column">
      <style:table-column-properties style:column-width="3cm"/>
    </style:style>
    <style:style style:name="ColumnInput" style:family="table-column">
      <style:table-column-properties style:column-width="13.65cm"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties table:align="center"/>
    </style:style>
    <style:style style:name="PageTwo" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin="0cm" fo:margin-top="0.8cm"/>
    </style:style>
    <style:style style:name="Agenda" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:margin-bottom="0.55cm"/>
    </style:style>
    <style:style style:name="AgendaItem" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:margin-left="0.15cm" fo:margin-bottom="0.55cm"/>
    </style:style>
    <style:style style:name="Section10" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:margin-top="0.25cm" fo:margin-bottom="0.95cm"/>
    </style:style>
    <style:style style:name="Attestation" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:margin-bottom="1.55cm"/>
    </style:style>
    <style:style style:name="Signature" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:margin-left="4.4cm" fo:margin-bottom="0.7cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Header">書式第７号（法第１０条関係）</text:p>
      <text:p text:style-name="Stamp">設　立　用</text:p>
      <text:p text:style-name="Title">設立総会議事録</text:p>
      <table:table table:name="設立総会議事録" table:style-name="FormTable">
        <table:table-column table:style-name="ColumnNumber"/>
        <table:table-column table:style-name="ColumnLabel"/>
        <table:table-column table:style-name="ColumnInput"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">1</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">法人名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">特定非営利活動法人＿＿＿＿＿＿＿＿＿＿＿＿</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">2</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">日付</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">3</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">時間</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">4</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">場所</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">5</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">出席者数</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">6</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">出席者氏名</text:p><text:p text:style-name="Body">以下、敬称略</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">7</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">審議事項</text:p></table:table-cell>
          <table:table-cell table:style-name="CellTop">
            <text:p text:style-name="AgendaItem">(1)</text:p>
            <text:p text:style-name="AgendaItem">(2)</text:p>
            <text:p text:style-name="AgendaItem">(3)</text:p>
            <text:p text:style-name="AgendaItem">(4)</text:p>
            <text:p text:style-name="AgendaItem">(5)</text:p>
            <text:p text:style-name="AgendaItem">(6)</text:p>
            <text:p text:style-name="AgendaItem">(7)</text:p>
            <text:p text:style-name="AgendaItem">(8)</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">8</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">議長選任</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="PageTwo">9　議事の経過の概要及び議決の結果</text:p>
      <text:p text:style-name="Agenda">(1)</text:p>
      <text:p text:style-name="Agenda">(2)</text:p>
      <text:p text:style-name="Agenda">(3)</text:p>
      <text:p text:style-name="Agenda">(4)</text:p>
      <text:p text:style-name="Agenda">(5)</text:p>
      <text:p text:style-name="Agenda">(6)</text:p>
      <text:p text:style-name="Agenda">(7)</text:p>
      <text:p text:style-name="Agenda" fo:margin-bottom="0.7cm">(8)</text:p>
      <text:p text:style-name="Section10">１０　議事録署名人の選任に関する事項</text:p>
      <text:p text:style-name="Attestation">以上、この議事録が正確であることを証します。</text:p>
      <text:p text:style-name="Signature">確　認　　　日　　　　　　　年　　　　　月　　　　　日</text:p>
      <text:p text:style-name="Signature">議　　　　　長</text:p>
      <text:p text:style-name="Signature">議　事　録　署　名　人</text:p>
      <text:p text:style-name="Signature">議　事　録　署　名　人</text:p>
    </office:text>
  </office:body>
</office:document>