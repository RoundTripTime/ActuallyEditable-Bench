<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="120%"/>
      <style:text-properties fo:font-family="Noto Sans CJK KR" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Heading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.15cm" fo:margin-bottom="0.55cm"/>
      <style:text-properties fo:font-family="Noto Sans CJK KR" fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="Subitem" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.35cm" fo:margin-top="0.25cm" fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-family="Noto Sans CJK KR" fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="TableText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="140%"/>
      <style:text-properties fo:font-family="Noto Sans CJK KR" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="TitleLabel" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#1D3B5A" fo:border="0.75pt solid #000000" fo:padding="0.15cm" style:vertical-align="middle"/>
      <style:text-properties fo:font-family="Noto Sans CJK KR" fo:font-size="17pt" fo:font-weight="bold" fo:color="#FFFFFF"/>
    </style:style>
    <style:style style:name="TitleCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0.2cm" style:vertical-align="middle"/>
      <style:text-properties fo:font-family="Noto Sans CJK KR" fo:font-size="17pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="LabelCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #555555" fo:padding="0.12cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="InputCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #555555" fo:padding="0.12cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="BoxCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #555555" fo:padding="0.1cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="2.5cm" fo:margin-bottom="2.5cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
    </style:page-layout>
    <style:style style:name="TitleTable" style:family="table">
      <style:table-properties style:width="17cm" table:align="left" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="TitleCol1" style:family="table-column">
      <style:table-column-properties style:column-width="2cm"/>
    </style:style>
    <style:style style:name="TitleCol2" style:family="table-column">
      <style:table-column-properties style:column-width="15cm"/>
    </style:style>
    <style:style style:name="InfoTable" style:family="table">
      <style:table-properties style:width="17cm" table:align="left" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="InfoCol1" style:family="table-column">
      <style:table-column-properties style:column-width="2.75cm"/>
    </style:style>
    <style:style style:name="InfoCol2" style:family="table-column">
      <style:table-column-properties style:column-width="6.25cm"/>
    </style:style>
    <style:style style:name="InfoCol3" style:family="table-column">
      <style:table-column-properties style:column-width="3.25cm"/>
    </style:style>
    <style:style style:name="InfoCol4" style:family="table-column">
      <style:table-column-properties style:column-width="4.75cm"/>
    </style:style>
    <style:style style:name="InfoRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="1.7cm"/>
    </style:style>
    <style:style style:name="PlanTable" style:family="table">
      <style:table-properties style:width="16.8cm" table:align="left" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="PlanCol" style:family="table-column">
      <style:table-column-properties style:column-width="16.8cm"/>
    </style:style>
    <style:style style:name="PlanRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="5.8cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <table:table table:name="Title" table:style-name="TitleTable">
        <table:table-column table:style-name="TitleCol1"/>
        <table:table-column table:style-name="TitleCol2"/>
        <table:table-row>
          <table:table-cell table:style-name="TitleLabel">
            <text:p text:style-name="TableText">참고1</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="TitleCell">
            <text:p text:style-name="Body">폭염중대경보 발령 시 작업중지 이행계획</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Heading">□ 현장 개요</text:p>
      <table:table table:name="현장개요" table:style-name="InfoTable">
        <table:table-column table:style-name="InfoCol1"/>
        <table:table-column table:style-name="InfoCol2"/>
        <table:table-column table:style-name="InfoCol3"/>
        <table:table-column table:style-name="InfoCol4"/>
        <table:table-row table:style-name="InfoRow">
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="TableText">현 장 명</text:p>
            <text:p text:style-name="TableText">(건설업체명)</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="TableText">현장소장</text:p>
            <text:p text:style-name="TableText">안전보건관리자</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
        </table:table-row>
        <table:table-row table:style-name="InfoRow">
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="TableText">소 재 지</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="TableText">공사기간</text:p>
            <text:p text:style-name="TableText">공정률</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
        </table:table-row>
        <table:table-row table:style-name="InfoRow">
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="TableText">공사금액</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="TableText">전 화 번 호</text:p>
            <text:p text:style-name="TableText">(팩 스 번 호)</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="InputCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Heading">□ 폭염 대응 체계(조직) 현황 및 역할</text:p>
      <text:p text:style-name="Subitem">ㅇ (폭염 대응 체계)</text:p>
      <text:p text:style-name="Subitem">ㅇ (담당자별 역할)</text:p>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Heading">□ 폭염중대경보 발령 당일 작업현황(’  .  .  .(  :  ))</text:p>
      <text:p text:style-name="Subitem">ㅇ (옥내작업)</text:p>
      <text:p text:style-name="Subitem">ㅇ (옥외작업)</text:p>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Heading">□ 폭염중대경보 발령 시 작업중지 이행 계획</text:p>
      <table:table table:name="작업중지이행계획" table:style-name="PlanTable">
        <table:table-column table:style-name="PlanCol"/>
        <table:table-row table:style-name="PlanRow">
          <table:table-cell table:style-name="BoxCell"/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>