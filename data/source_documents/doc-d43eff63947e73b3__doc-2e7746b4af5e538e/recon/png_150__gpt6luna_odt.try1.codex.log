      <text:p text:style-name="Body">　　　　　　　　　　　　　　　　　　　　　　　　　　　　氏　　名</text:p>
      <text:p text:style-name="FormTitle">寄　附　金　申　込　書</text:p>
      <text:p text:style-name="Body">下記のとおり、寄附します。</text:p>
      <text:p text:style-name="Center">記</text:p>
