      <text:p text:style-name="Right">令和　　年　　月　　日</text:p>
      <text:p text:style-name="Body">国立大学法人</text:p>
      <text:p text:style-name="Body">香川大学長　殿</text:p>
      <text:p text:style-name="Body">　　　　　　　　　　　　　　　　　　　　　　　　　寄附者　〒</text:p>
      <text:p text:style-name="Body">　　　　　　　　　　　　　　　　　　　　　　　　　　　　住　　所</text:p>
