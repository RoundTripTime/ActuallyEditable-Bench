<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.12cm" fo:line-height="120%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#000000"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.1cm" fo:margin-bottom="0.2cm" fo:padding-bottom="0.12cm" fo:border-bottom="0.04cm solid #4F81BD"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="28pt" fo:color="#17365D"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.35cm" fo:margin-bottom="0.22cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Label" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:padding-left="0.2cm"/>
      <style:text-properties fo:font-size="11pt" fo:font-weight="bold" fo:color="#366092"/>
    </style:style>
    <style:style style:name="Field" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:padding-left="0.2cm"/>
      <style:text-properties fo:font-size="10pt" fo:color="#366092"/>
    </style:style>
    <style:style style:name="ColumnHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:padding-left="0.18cm"/>
      <style:text-properties fo:font-size="10.5pt" fo:font-weight="bold" fo:color="#366092"/>
    </style:style>
    <style:style style:name="Total" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.22cm" fo:padding-left="0.2cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.22cm" fo:padding-left="0.2cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="FooterText" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.2cm" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="1.4cm" fo:margin-right="1.4cm" fo:margin-top="1.4cm" fo:margin-bottom="1.4cm"/>
    </style:page-layout>
    <style:style style:name="FieldsTable" style:family="table">
      <style:table-properties style:width="18.2cm" table:align="margins"/>
    </style:style>
    <style:style style:name="ItemsTable" style:family="table">
      <style:table-properties style:width="18.2cm" table:align="margins"/>
    </style:style>
    <style:style style:name="FieldLeft" style:family="table-column">
      <style:table-column-properties style:column-width="8.9cm"/>
    </style:style>
    <style:style style:name="FieldRight" style:family="table-column">
      <style:table-column-properties style:column-width="9.3cm"/>
    </style:style>
    <style:style style:name="ItemDescription" style:family="table-column">
      <style:table-column-properties style:column-width="7.65cm"/>
    </style:style>
    <style:style style:name="ItemQuantity" style:family="table-column">
      <style:table-column-properties style:column-width="2.5cm"/>
    </style:style>
    <style:style style:name="ItemRate" style:family="table-column">
      <style:table-column-properties style:column-width="3.8cm"/>
    </style:style>
    <style:style style:name="ItemAmount" style:family="table-column">
      <style:table-column-properties style:column-width="4.25cm"/>
    </style:style>
    <style:style style:name="FieldCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.04cm" fo:border-bottom="0.025cm solid #4F81BD" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="FieldCellBlue" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#D2DEED" fo:padding="0.04cm" fo:border-bottom="0.025cm solid #D2DEED" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="FieldCellRule" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.04cm" fo:border-top="0.025cm solid #4F81BD" fo:border-bottom="0.025cm solid #4F81BD" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="FieldCellBlueRule" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#D2DEED" fo:padding="0.04cm" fo:border-top="0.025cm solid #4F81BD" fo:border-bottom="0.025cm solid #4F81BD" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="ItemHeadCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.05cm" fo:border-top="0.035cm solid #4F81BD" fo:border-bottom="0.035cm solid #4F81BD" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="ItemBlueCell" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#D2DEED" fo:padding="0.03cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="ItemSpacerCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0cm" style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout">
      <style:footer>
        <text:p text:style-name="FooterText">OnlineBiller | Original English resource | Blank template</text:p>
      </style:footer>
    </style:master-page>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">Freelance Invoice</text:p>
      <text:p text:style-name="Subtitle">BLANK TEMPLATE | Currency: INR</text:p>
      <table:table table:name="InvoiceDetails" table:style-name="FieldsTable">
        <table:table-column table:style-name="FieldLeft"/>
        <table:table-column table:style-name="FieldRight"/>
        <table:table-row>
          <table:table-cell table:style-name="FieldCellRule"><text:p text:style-name="Label">Freelancer</text:p></table:table-cell>
          <table:table-cell table:style-name="FieldCellRule"><text:p text:style-name="Field">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FieldCellBlue"><text:p text:style-name="Label">Client</text:p></table:table-cell>
          <table:table-cell table:style-name="FieldCellBlue"><text:p text:style-name="Field">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FieldCell"><text:p text:style-name="Label">Invoice / date</text:p></table:table-cell>
          <table:table-cell table:style-name="FieldCell"><text:p text:style-name="Field">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FieldCellBlue"><text:p text:style-name="Label">Work reference</text:p></table:table-cell>
          <table:table-cell table:style-name="FieldCellBlue"><text:p text:style-name="Field">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FieldCell"><text:p text:style-name="Label">Billing period</text:p></table:table-cell>
          <table:table-cell table:style-name="FieldCell"><text:p text:style-name="Field">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FieldCellBlue"><text:p text:style-name="Label">Due date</text:p></table:table-cell>
          <table:table-cell table:style-name="FieldCellBlue"><text:p text:style-name="Field">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FieldCell"><text:p text:style-name="Label">Payment instructions</text:p></table:table-cell>
          <table:table-cell table:style-name="FieldCell"><text:p text:style-name="Field">________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FieldCellBlueRule"><text:p text:style-name="Label">Tax basis</text:p></table:table-cell>
          <table:table-cell table:style-name="FieldCellBlueRule"><text:p text:style-name="Field">________________________________________</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p/>
      <table:table table:name="InvoiceItems" table:style-name="ItemsTable">
        <table:table-column table:style-name="ItemDescription"/>
        <table:table-column table:style-name="ItemQuantity"/>
        <table:table-column table:style-name="ItemRate"/>
        <table:table-column table:style-name="ItemAmount"/>
        <table:table-row>
          <table:table-cell table:style-name="ItemHeadCell"><text:p text:style-name="ColumnHeading">Description</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHeadCell"><text:p text:style-name="ColumnHeading">Quantity</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHeadCell"><text:p text:style-name="ColumnHeading">Rate (INR)</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHeadCell"><text:p text:style-name="ColumnHeading">Amount (INR)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ItemBlueCell"/>
          <table:table-cell table:style-name="ItemBlueCell"/>
          <table:table-cell table:style-name="ItemBlueCell"/>
          <table:table-cell table:style-name="ItemBlueCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ItemSpacerCell"/>
          <table:table-cell table:style-name="ItemSpacerCell"/>
          <table:table-cell table:style-name="ItemSpacerCell"/>
          <table:table-cell table:style-name="ItemSpacerCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ItemBlueCell"/>
          <table:table-cell table:style-name="ItemBlueCell"/>
          <table:table-cell table:style-name="ItemBlueCell"/>
          <table:table-cell table:style-name="ItemBlueCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ItemSpacerCell"/>
          <table:table-cell table:style-name="ItemSpacerCell"/>
          <table:table-cell table:style-name="ItemSpacerCell"/>
          <table:table-cell table:style-name="ItemSpacerCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ItemBlueCell"/>
          <table:table-cell table:style-name="ItemBlueCell"/>
          <table:table-cell table:style-name="ItemBlueCell"/>
          <table:table-cell table:style-name="ItemBlueCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ItemSpacerCell"/>
          <table:table-cell table:style-name="ItemSpacerCell"/>
          <table:table-cell table:style-name="ItemSpacerCell"/>
          <table:table-cell table:style-name="ItemSpacerCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ItemBlueCell"/>
          <table:table-cell table:style-name="ItemBlueCell"/>
          <table:table-cell table:style-name="ItemBlueCell"/>
          <table:table-cell table:style-name="ItemBlueCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Total"><text:span text:style-name="TotalBold">Subtotal:</text:span> INR __________</text:p>
      <text:p text:style-name="Total"><text:span text:style-name="TotalBold">Amount due:</text:span> INR __________</text:p>
      <text:p text:style-name="Note">Fixed-fee and hourly units are explicitly labeled. Enter recorded, agreed work only.</text:p>
      <text:p text:style-name="Note">No time tracking, tax classification or payment collection is performed.</text:p>
      <text:p text:style-name="Note">Word amounts are manual. Check line amounts and totals after every edit.</text:p>
    </office:text>
  </office:body>
</office:document>