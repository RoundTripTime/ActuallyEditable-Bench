        <table:table-row table:style-name="BudgetBodyRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">サル追い払い資</text:p><text:p text:style-name="CenterText">機材整備事業</text:p></table:table-cell>
