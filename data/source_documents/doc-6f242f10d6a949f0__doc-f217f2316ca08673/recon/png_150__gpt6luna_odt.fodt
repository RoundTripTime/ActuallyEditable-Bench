<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:orphans="2" fo:widows="2"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt" style:font-family-asian="serif" style:font-size-asian="11pt"/>
    </style:default-style>
    <style:style style:name="PageText" style:family="paragraph" style:master-page-name="Standard">
      <style:paragraph-properties fo:margin-top="0.12cm" fo:margin-bottom="0.12cm"/>
    </style:style>
    <style:style style:name="RightText" style:family="paragraph" style:parent-style-name="PageText">
      <style:paragraph-properties fo:text-align="right"/>
    </style:style>
    <style:style style:name="CenterText" style:family="paragraph" style:parent-style-name="PageText">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="PageTitle" style:family="paragraph" style:parent-style-name="CenterText">
      <style:paragraph-properties fo:margin-top="0.5cm" fo:margin-bottom="1.0cm"/>
    </style:style>
    <style:style style:name="NewPageTitle" style:family="paragraph" style:parent-style-name="PageTitle">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
    <style:style style:name="FormText" style:family="paragraph" style:parent-style-name="PageText">
      <style:paragraph-properties fo:margin-left="0.3cm"/>
    </style:style>
    <style:style style:name="FormGap" style:family="paragraph" style:parent-style-name="PageText">
      <style:paragraph-properties fo:margin-top="0.35cm" fo:margin-bottom="0.35cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
    </style:page-layout>
    <style:style style:name="ScheduleTable" style:family="table">
      <style:table-properties style:width="16.5cm" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ScheduleCol1" style:family="table-column">
      <style:table-column-properties style:column-width="4.4cm"/>
    </style:style>
    <style:style style:name="ScheduleCol2" style:family="table-column">
      <style:table-column-properties style:column-width="4.5cm"/>
    </style:style>
    <style:style style:name="ScheduleCol3" style:family="table-column">
      <style:table-column-properties style:column-width="7.6cm"/>
    </style:style>
    <style:style style:name="GridTable" style:family="table">
      <style:table-properties style:width="16.5cm" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="BudgetCol1" style:family="table-column">
      <style:table-column-properties style:column-width="3.1cm"/>
    </style:style>
    <style:style style:name="BudgetCol2" style:family="table-column">
      <style:table-column-properties style:column-width="3.2cm"/>
    </style:style>
    <style:style style:name="BudgetCol3" style:family="table-column">
      <style:table-column-properties style:column-width="3.2cm"/>
    </style:style>
    <style:style style:name="BudgetCol4" style:family="table-column">
      <style:table-column-properties style:column-width="3.2cm"/>
    </style:style>
    <style:style style:name="BudgetCol5" style:family="table-column">
      <style:table-column-properties style:column-width="3.8cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="DiagonalCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" style:diagonal-tl-br="0.5pt solid #000000" fo:padding="0.08cm"/>
    </style:style>
    <style:style style:name="ScheduleHeaderRow" style:family="table-row">
      <style:table-row-properties style:row-height="2.6cm"/>
    </style:style>
    <style:style style:name="ScheduleBodyRow" style:family="table-row">
      <style:table-row-properties style:row-height="2.5cm"/>
    </style:style>
    <style:style style:name="BudgetHeaderRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.65cm"/>
    </style:style>
    <style:style style:name="BudgetBodyRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.6cm"/>
    </style:style>
    <style:style style:name="BudgetTotalRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.3cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="RightText">区第　　　　号</text:p>
      <text:p text:style-name="RightText">令和　　年　　月　　日</text:p>
      <text:p text:style-name="FormGap"/>
      <text:p text:style-name="PageText">おおい町長　中塚　寛　様</text:p>
      <text:p text:style-name="FormGap"/>
      <text:p text:style-name="RightText">申請者　　区長　　　　印</text:p>
      <text:p text:style-name="FormGap"/>
      <text:p text:style-name="PageTitle">令和　　年度サル被害緊急対策事業補助金交付申請書</text:p>
      <text:p text:style-name="FormText">令和　　年度においてサル被害緊急対策事業補助金の交付を受けたいので、おおい町補</text:p>
      <text:p text:style-name="PageText">助金等交付規則第３条の規定により関係書類を添えて申請します。</text:p>
      <text:p text:style-name="CenterText">記</text:p>
      <text:p text:style-name="FormGap"/>
      <text:p text:style-name="PageText">１　補助事業等の名称</text:p>
      <text:p text:style-name="FormText">サル被害緊急対策事業</text:p>
      <text:p text:style-name="FormGap"/>
      <text:p text:style-name="PageText">２　補助事業等の目的及び内容</text:p>
      <text:p text:style-name="FormText">区内のサル追い払い活動を行うことにより、農作物の被害軽減及び農地の保全を図</text:p>
      <text:p text:style-name="FormText">ることを目的とする。</text:p>
      <text:p text:style-name="FormGap"/>
      <text:p text:style-name="PageText">３　補助事業等の完了の予定期日及び実施計画</text:p>
      <text:p text:style-name="FormText">別紙実施計画書のとおり</text:p>
      <text:p text:style-name="FormGap"/>
      <text:p text:style-name="PageText">４　交付申請額</text:p>
      <text:p text:style-name="FormText">金　　　　円</text:p>
      <text:p text:style-name="FormGap"/>
      <text:p text:style-name="PageText">５　交付申請額の算出方法</text:p>
      <text:p text:style-name="FormText">定額（サル追い払い隊設立事業　　　　　円、サル追い払い資機材整備事業　　　　　円、</text:p>
      <text:p text:style-name="FormText">　　　サル追い払い活動支援事業　　　　　円）</text:p>
      <text:p text:style-name="FormGap"/>
      <text:p text:style-name="PageText">６　補助事業等の経費の配分及び経費の使用方法</text:p>
      <text:p text:style-name="FormText">別紙収支予算書のとおり</text:p>
      <text:p text:style-name="FormGap"/>
      <text:p text:style-name="PageText">７　添付書類</text:p>
      <text:p text:style-name="FormText">実施計画書</text:p>
      <text:p text:style-name="FormText">収支予算書</text:p>
      <text:p text:style-name="NewPageTitle">令和　　年度 サル被害緊急対策事業 実施計画書</text:p>
      <table:table table:name="実施計画書" table:style-name="ScheduleTable">
        <table:table-column table:style-name="ScheduleCol1"/>
        <table:table-column table:style-name="ScheduleCol2"/>
        <table:table-column table:style-name="ScheduleCol3"/>
        <table:table-row table:style-name="ScheduleHeaderRow">
          <table:table-cell table:style-name="DiagonalCell">
            <text:p text:style-name="CenterText">項目</text:p>
            <text:p text:style-name="PageText">時期</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">事業及び会議</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">説明</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ScheduleBodyRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="ScheduleBodyRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="ScheduleBodyRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="NewPageTitle">令和　　年度 サル被害緊急対策事業収支予算書</text:p>
      <text:p text:style-name="PageText">【収入】　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　単位：円</text:p>
      <table:table table:name="収入" table:style-name="GridTable">
        <table:table-column table:style-name="BudgetCol1"/>
        <table:table-column table:style-name="BudgetCol2"/>
        <table:table-column table:style-name="BudgetCol3"/>
        <table:table-column table:style-name="BudgetCol4"/>
        <table:table-column table:style-name="BudgetCol5"/>
        <table:table-row table:style-name="BudgetHeaderRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">項目</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">本年度予算額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">前年度予算額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">比較増減</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">備考</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="BudgetBodyRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">補助金</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="BudgetBodyRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">一般財源</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="BudgetTotalRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">合　計</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="FormGap"/>
      <text:p text:style-name="PageText">【支出】　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　単位：円</text:p>
      <table:table table:name="支出" table:style-name="GridTable">
        <table:table-column table:style-name="BudgetCol1"/>
        <table:table-column table:style-name="BudgetCol2"/>
        <table:table-column table:style-name="BudgetCol3"/>
        <table:table-column table:style-name="BudgetCol4"/>
        <table:table-column table:style-name="BudgetCol5"/>
        <table:table-row table:style-name="BudgetHeaderRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">項目</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">本年度予算額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">前年度予算額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">比較増減</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">備考</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="BudgetBodyRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">サル追い払い隊</text:p><text:p text:style-name="CenterText">設立事業</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="BudgetBodyRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">サル追い払い資</text:p><text:p text:style-name="CenterText">機材整備事業</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="BudgetBodyRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">サル追い払い活</text:p><text:p text:style-name="CenterText">動支援事業</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="BudgetTotalRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">合　計</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="FormGap"/>
      <text:p text:style-name="PageText">上記のとおり相違ありません。</text:p>
      <text:p text:style-name="FormGap"/>
      <text:p text:style-name="PageText">令和　　年　　月　　日</text:p>
      <text:p text:style-name="RightText">区長　　　　　　　　　印</text:p>
    </office:text>
  </office:body>
</office:document>