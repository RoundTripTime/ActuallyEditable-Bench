<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0.2cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="FormText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.15cm" fo:margin-bottom="0.15cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="TopText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.1cm" fo:margin-bottom="0.2cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Centered" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.15cm" fo:margin-bottom="0.15cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="TableText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.03cm" fo:margin-bottom="0.03cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="CellLabel" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.03cm" fo:margin-bottom="0.03cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="SmallLabel" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.03cm" fo:margin-bottom="0.03cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="7pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin="1.7cm"/>
    </style:page-layout>
    <style:style style:name="ColLabel" style:family="table-column">
      <style:table-column-properties style:column-width="3.5cm"/>
    </style:style>
    <style:style style:name="ColInput" style:family="table-column">
      <style:table-column-properties style:column-width="5.0cm"/>
    </style:style>
    <style:style style:name="ColPhone" style:family="table-column">
      <style:table-column-properties style:column-width="1.5cm"/>
    </style:style>
    <style:style style:name="ColWide" style:family="table-column">
      <style:table-column-properties style:column-width="8.1cm"/>
    </style:style>
    <style:style style:name="GridCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="GridCellTop" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="top"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">別紙２</text:p>
      <text:p text:style-name="TopText">様式第１号（第４条関係）</text:p>
      <text:p text:style-name="Centered">表彰内申書</text:p>
      <text:p text:style-name="TopText">　　　　　　　　　　　　　　　　年　　　月　　　日</text:p>
      <text:p text:style-name="TopText">（宛先）白岡市長</text:p>
      <text:p text:style-name="TopText">　　　　　　　　　　　　　　　　　　　　　　内申者 ____________________________</text:p>
      <text:p text:style-name="FormText">次のものは、白岡市表彰規則に規定する表彰の種類に該当し、表彰する<br/>ことが適当と認められるので内申いたします。</text:p>
      <table:table table:name="表彰内申書">
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColInput"/>
        <table:table-column table:style-name="ColPhone"/>
        <table:table-column table:style-name="ColWide"/>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellLabel">ふ　り　が　な</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="GridCell"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellLabel">氏　名　又　は</text:p><text:p text:style-name="CellLabel">団　体　名</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="GridCell"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellLabel">住所又は</text:p><text:p text:style-name="CellLabel">所　在　地</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="GridCell"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellLabel">生年月日又は</text:p><text:p text:style-name="CellLabel">設　立　年　月　日</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="GridCell"><text:p text:style-name="Centered">年　　　　　月　　　　　日</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellLabel">職業又は業種</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellLabel">電話</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellLabel">表　彰　の　種　類</text:p><text:p text:style-name="SmallLabel">(番号を○で囲み、号数を記入)</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="GridCell">
            <text:p text:style-name="TableText">① 功労表彰（第　　　号）　　　② 善行表彰（第　　　号）</text:p>
            <text:p text:style-name="TableText">③ 特別表彰（第　　　号）</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellLabel">経　歴　の　概　要</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="GridCellTop"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellLabel">功　績　の　概　要</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="GridCellTop"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellLabel">賞　　　　罰</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="GridCell"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellLabel">申　請　理　由</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="GridCell"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="FormText">注　各欄が長文にわたるときは、別紙によること。</text:p>
    </office:text>
  </office:body>
</office:document>