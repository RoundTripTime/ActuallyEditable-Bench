<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
                 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
                 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
                 xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
                 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
                 office:mimetype="application/vnd.oasis.opendocument.text"
                 office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph" style:master-page-name="Default">
      <style:paragraph-properties fo:font-size="11pt" fo:line-height="120%"/>
      <style:text-properties fo:font-size="11pt" fo:color="#000000" fo:font-family="Arial"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:font-size="28pt" fo:line-height="120%" fo:margin-bottom="0.18cm" fo:border-bottom="0.04cm solid #4F81BD"/>
      <style:text-properties fo:font-size="28pt" fo:color="#1F3F68" fo:font-family="Arial"/>
    </style:style>
    <style:style style:name="BlueBold" style:family="paragraph" style:parent-style-name="Body">
      <style:text-properties fo:font-size="11pt" fo:color="#376092" fo:font-weight="bold" fo:font-family="Arial"/>
    </style:style>
    <style:style style:name="TableHeader" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:font-size="10pt" fo:line-height="110%"/>
      <style:text-properties fo:font-size="10pt" fo:color="#376092" fo:font-weight="bold" fo:font-family="Arial"/>
    </style:style>
    <style:style style:name="Footnote" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:margin-top="0.1cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-size="10pt" fo:font-family="Arial"/>
    </style:style>
    <style:style style:name="FooterText" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:margin-top="2.1cm"/>
      <style:text-properties fo:font-size="9pt" fo:font-family="Arial"/>
    </style:style>
    <style:style style:name="DetailsTable" style:family="table">
      <style:table-properties style:width="26.5cm" table:align="margins"/>
    </style:style>
    <style:style style:name="ItemsTable" style:family="table">
      <style:table-properties style:width="26.5cm" table:align="margins"/>
    </style:style>
    <style:style style:name="DetailsLabelCol" style:family="table-column">
      <style:table-column-properties style:column-width="13.25cm"/>
    </style:style>
    <style:style style:name="DetailsInputCol" style:family="table-column">
      <style:table-column-properties style:column-width="13.25cm"/>
    </style:style>
    <style:style style:name="ItemCol1" style:family="table-column">
      <style:table-column-properties style:column-width="6.6cm"/>
    </style:style>
    <style:style style:name="ItemCol2" style:family="table-column">
      <style:table-column-properties style:column-width="4cm"/>
    </style:style>
    <style:style style:name="ItemCol3" style:family="table-column">
      <style:table-column-properties style:column-width="4.1cm"/>
    </style:style>
    <style:style style:name="ItemCol4" style:family="table-column">
      <style:table-column-properties style:column-width="5.2cm"/>
    </style:style>
    <style:style style:name="ItemCol5" style:family="table-column">
      <style:table-column-properties style:column-width="6.6cm"/>
    </style:style>
    <style:style style:name="LabelCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.16cm" fo:border-bottom="0.02cm solid #4F81BD"/>
    </style:style>
    <style:style style:name="LabelShade" style:family="table-cell" style:parent-style-name="LabelCell">
      <style:table-cell-properties fo:background-color="#D2DEED"/>
    </style:style>
    <style:style style:name="InputCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.16cm" fo:border-bottom="0.02cm solid #4F81BD"/>
    </style:style>
    <style:style style:name="InputShade" style:family="table-cell" style:parent-style-name="InputCell">
      <style:table-cell-properties fo:background-color="#D2DEED"/>
    </style:style>
    <style:style style:name="ItemHeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.14cm" fo:border-top="0.03cm solid #4F81BD" fo:border-bottom="0.03cm solid #4F81BD"/>
    </style:style>
    <style:style style:name="ItemCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.16cm" fo:background-color="#D2DEED"/>
    </style:style>
    <style:style style:name="ItemRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.62cm"/>
    </style:style>
  </office:styles>

  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="29.7cm" fo:page-height="21cm" style:print-orientation="landscape" fo:margin-top="1.35cm" fo:margin-bottom="1.35cm" fo:margin-left="1.4cm" fo:margin-right="1.4cm"/>
    </style:page-layout>
  </office:automatic-styles>

  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>

  <office:body>
    <office:text>
      <text:p text:style-name="Title">Delivery Challan</text:p>
      <text:p text:style-name="Body">BLANK TEMPLATE | Currency: INR</text:p>

      <table:table table:name="Details" table:style-name="DetailsTable">
        <table:table-column table:style-name="DetailsLabelCol"/>
        <table:table-column table:style-name="DetailsInputCol"/>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="BlueBold">Consignor / GSTIN</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelShade"><text:p text:style-name="BlueBold">Consignee / GSTIN or UIN</text:p></table:table-cell>
          <table:table-cell table:style-name="InputShade"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="BlueBold">Challan / date</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelShade"><text:p text:style-name="BlueBold">Dispatch / delivery addresses</text:p></table:table-cell>
          <table:table-cell table:style-name="InputShade"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="BlueBold">Purpose / transport</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelShade"><text:p text:style-name="BlueBold">Place of supply</text:p></table:table-cell>
          <table:table-cell table:style-name="InputShade"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="BlueBold">Signature</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelShade"><text:p text:style-name="BlueBold">Receipt acknowledgment</text:p></table:table-cell>
          <table:table-cell table:style-name="InputShade"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="Body"/>
      <table:table table:name="Items" table:style-name="ItemsTable">
        <table:table-column table:style-name="ItemCol1"/>
        <table:table-column table:style-name="ItemCol2"/>
        <table:table-column table:style-name="ItemCol3"/>
        <table:table-column table:style-name="ItemCol4"/>
        <table:table-column table:style-name="ItemCol5"/>
        <table:table-row>
          <table:table-cell table:style-name="ItemHeaderCell"><text:p text:style-name="TableHeader">HSN / description</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHeaderCell"><text:p text:style-name="TableHeader">Quantity / unit</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHeaderCell"><text:p text:style-name="TableHeader">Taxable value (INR)</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHeaderCell"><text:p text:style-name="TableHeader">Applicable tax rates</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHeaderCell"><text:p text:style-name="TableHeader">Component amounts (INR)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ItemRow">
          <table:table-cell table:style-name="ItemCell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="ItemCell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="ItemCell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="ItemCell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="ItemCell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ItemRow">
          <table:table-cell table:style-name="ItemCell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="ItemCell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="ItemCell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="ItemCell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="ItemCell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ItemRow">
          <table:table-cell table:style-name="ItemCell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="ItemCell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="ItemCell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="ItemCell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="ItemCell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ItemRow">
          <table:table-cell table:style-name="ItemCell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="ItemCell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="ItemCell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="ItemCell"><text:p text:style-name="Body"/></table:table-cell>
          <table:table-cell table:style-name="ItemCell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="Footnote">Hypothetical inspection-and-return dispatch, not a sale. Confirm the actual movement and applicable tax treatment.</text:p>
      <text:p text:style-name="Footnote">For movement that is a supply, enter the applicable component rates and amounts; these manual files do not calculate them.</text:p>
      <text:p text:style-name="Footnote">Review applicable copy labels and movement authorization separately.</text:p>
      <text:p text:style-name="Footnote">Word amounts are manual. Check line amounts and totals after every edit.</text:p>
      <text:p text:style-name="FooterText">OnlineBiller | Original English resource | Blank template</text:p>
    </office:text>
  </office:body>
</office:document>