<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt" fo:font-family="Arial"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="8pt" fo:font-family="Arial"/>
    </style:style>
    <style:style style:name="Bold" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt" fo:font-family="Arial" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:text-align="center" fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt" fo:font-family="Arial" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:text-align="center" fo:line-height="100%"/>
      <style:text-properties fo:font-size="18pt" fo:font-family="Arial" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="PgBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Tbl" style:family="table">
      <style:table-properties table:align="margins" style:width="18.0cm"/>
    </style:style>
    <style:style style:name="Col" style:family="table-column">
      <style:table-column-properties style:column-width="4.5cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.15cm" style:vertical-align="top"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt" fo:font-family="Arial"/>
    </style:style>
    <style:style style:name="HeadCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.15cm" style:vertical-align="middle" fo:background-color="#e6e6e6"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt" fo:font-family="Arial" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="GreenTitle" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.15cm" style:vertical-align="middle" fo:background-color="#00b050"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:text-align="center"/>
      <style:text-properties fo:font-size="18pt" fo:font-family="Arial" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Yellow" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.1cm" style:vertical-align="middle" fo:background-color="#ffff99"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:text-align="center"/>
      <style:text-properties fo:font-size="10pt" fo:font-family="Arial" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Blue" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.1cm" style:vertical-align="middle" fo:background-color="#b4c7e7"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:text-align="center"/>
      <style:text-properties fo:font-size="10pt" fo:font-family="Arial" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="LightGreen" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.1cm" style:vertical-align="middle" fo:background-color="#99ff99"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:text-align="center"/>
      <style:text-properties fo:font-size="10pt" fo:font-family="Arial" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Pink" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.1cm" style:vertical-align="middle" fo:background-color="#ffccff"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:text-align="center"/>
      <style:text-properties fo:font-size="10pt" fo:font-family="Arial" fo:font-weight="bold"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.4cm" fo:margin-bottom="1.4cm" fo:margin-left="1.5cm" fo:margin-right="1.5cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="P" fo:text-align="end"><text:span>Gloucestershire</text:span></text:p>
      <text:p text:style-name="Small" fo:text-align="end"><text:span>COUNTY COUNCIL</text:span></text:p>
      <table:table table:name="FormPage1" table:style-name="Tbl">
        <table:table-column table:style-name="Col" table:number-columns-repeated="4"/>
        <table:table-row>
          <table:table-cell table:style-name="GreenTitle" table:number-columns-spanned="4"><text:p text:style-name="Title">Ready for Reception Transition Record</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>Child’s Name:</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>Child’s Date of Birth:</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>EY Setting:</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>Practitioner’s Name:</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>Funded Hours Entitlement:</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>□15</text:p><text:p>□30</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>Accessing Full Entitlement:</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>□Yes</text:p><text:p>□No</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>Child’s Ethnicity:</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>Child’s Gender:</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>□ Male</text:p><text:p>□ Female</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>Home language:</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>Spoken Language:</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>Child with SEND:</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>□Yes</text:p><text:p>□No</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>Additional Information:</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>LAC □  CIN □  MP □</text:p><text:p>CP □  IHCP □  MP+ □</text:p><text:p>EHCP □</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <table:table table:name="ReadinessScores" table:style-name="Tbl">
        <table:table-column table:style-name="Col" table:number-columns-repeated="4"/>
        <table:table-row><table:table-cell table:style-name="HeadCell" table:number-columns-spanned="4"><text:p>Ready for Learning – April score (please delete as appropriate below and attach RFL questionnaire)</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Yellow"><text:p>Emotional Resilience</text:p></table:table-cell><table:table-cell table:style-name="Blue"><text:p>Language &amp; Cognition</text:p></table:table-cell><table:table-cell table:style-name="LightGreen"><text:p>Daily Living Skills</text:p></table:table-cell><table:table-cell table:style-name="Pink"><text:p>Family Support</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>No concerns</text:p><text:p>Some concerns</text:p><text:p>High concerns</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>No concerns</text:p><text:p>Some concerns</text:p><text:p>High concerns</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>No concerns</text:p><text:p>Some concerns</text:p><text:p>High concerns</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>No concerns</text:p><text:p>Some concerns</text:p><text:p>High concerns</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <table:table table:name="EYFSSummary" table:style-name="Tbl">
        <table:table-column table:style-name="Col" table:number-columns-repeated="18"/>
        <table:table-row><table:table-cell table:style-name="HeadCell" table:number-columns-spanned="18"><text:p>Summary of EYFS attainment</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeadCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="HeadCell" table:number-columns-spanned="2"><text:p>Communication and Language</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="HeadCell" table:number-columns-spanned="3"><text:p>Personal, Social and Emotional development</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="HeadCell" table:number-columns-spanned="2"><text:p>Physical Development</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="HeadCell" table:number-columns-spanned="3"><text:p>Literacy</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="HeadCell" table:number-columns-spanned="2"><text:p>Maths</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="HeadCell" table:number-columns-spanned="3"><text:p>Understanding the World</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="HeadCell" table:number-columns-spanned="2"><text:p>Expressive Arts and Design</text:p></table:table-cell><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeadCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>Listening, Attention and Understanding</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>Speaking</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>Self-Regulation</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>Managing Self</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>Building Relationships</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>Gross Motor Skills</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>Fine Motor Skills</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>Comprehension</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>Exploring Words</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>Mark-Making</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>Number</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>Shape, Space &amp; Measure</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>Past and Present</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>People, Culture and Communities</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>The Natural World</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>Creating with Materials</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>Being Imaginative and Expressive</text:p></table:table-cell>
        </table:table-row>
        <table:table-row><table:table-cell table:style-name="HeadCell"><text:p>On track</text:p></table:table-cell><table:table-cell table:number-columns-repeated="17" table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="HeadCell"><text:p>Working towards</text:p></table:table-cell><table:table-cell table:number-columns-repeated="17" table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="HeadCell"><text:p>Below</text:p></table:table-cell><table:table-cell table:number-columns-repeated="17" table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
      </table:table>
      <table:table table:name="PractitionerInformation" table:style-name="Tbl">
        <table:table-column table:style-name="Col"/>
        <table:table-row><table:table-cell table:style-name="HeadCell"><text:p>Additional Information to be completed by practitioner</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>My strengths and talents:</text:p><text:p/><text:p/><text:p>I need support/help to:</text:p><text:p/><text:p/><text:p>What helps me be ready for learning/feel settled:</text:p><text:p/><text:p/></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="P">TD/18/02/2026</text:p>
      <text:p text:style-name="PgBreak"/>
      <text:p text:style-name="P" fo:text-align="end"><text:span>Gloucestershire</text:span></text:p>
      <text:p text:style-name="Small" fo:text-align="end"><text:span>COUNTY COUNCIL</text:span></text:p>
      <table:table table:name="Continuation" table:style-name="Tbl">
        <table:table-column table:style-name="Col"/>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>Barriers to learning for me:</text:p><text:p/><text:p>My likes and dislikes:</text:p><text:p/><text:p>My family and home life:</text:p><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>Practitioner signature:</text:p><text:p/><text:p>Practitioner name:</text:p><text:p/><text:p>Date:</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p>Parent/Carer comments:</text:p><text:p/><text:p>Parent/Carer signature:</text:p><text:p/><text:p>Date:</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="P"/>
      <text:p text:style-name="Bold">Please share this document with the child’s receiving school and highlight any other relevant information attached:</text:p>
      <text:p text:style-name="Bold">My Profile / My Plan and Reviews / My Assessment, My Plan+ and Reviews</text:p>
      <text:p text:style-name="P"/>
      <text:p text:style-name="P">TD/18/02/2026</text:p>
    </office:text>
  </office:body>
</office:document>