<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="11pt" style:font-size-asian="11pt"/>
    </style:style>
    <style:style style:name="Left" style:family="paragraph">
      <style:paragraph-properties fo:text-align="left" fo:line-height="120%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="11pt" style:font-size-asian="11pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="120%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="11pt" style:font-size-asian="11pt"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:line-height="120%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="11pt" style:font-size-asian="11pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-left="2.5cm" fo:margin-right="2.5cm" fo:margin-top="2cm" fo:margin-bottom="2cm"/>
    </style:page-layout>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="120%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="14pt" style:font-size-asian="14pt"/>
    </style:style>
    <style:style style:name="Table" style:family="table">
      <style:table-properties style:width="16cm" table:align="center" style:may-break-between-rows="false"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="2.55cm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="4.95cm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="8.5cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.12cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:line-height="130%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10.5pt" style:font-size-asian="10.5pt"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.12cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center" fo:line-height="130%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10.5pt" style:font-size-asian="10.5pt"/>
    </style:style>
    <style:style style:name="CellLeft" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.12cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="left" fo:line-height="130%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10.5pt" style:font-size-asian="10.5pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">様式第１（第４条関係）</text:p>
      <text:p text:style-name="P"><text:s text:c="42"/>年　　　月　　　日</text:p>
      <text:p text:style-name="P"><text:s text:c="2"/></text:p>
      <text:p text:style-name="P"><text:s text:c="2"/>東　郷　町　長　　殿</text:p>
      <text:p text:style-name="P"><text:s text:c="30"/>住　所</text:p>
      <text:p text:style-name="P"><text:s text:c="30"/>団体名</text:p>
      <text:p text:style-name="P"><text:s text:c="30"/>代表者氏名</text:p>
      <text:p text:style-name="P"><text:s text:c="2"/></text:p>
      <text:p text:style-name="Title">東郷町老人クラブ助成事業補助金交付申請書</text:p>
      <text:p text:style-name="P"><text:s text:c="2"/></text:p>
      <text:p text:style-name="Left"><text:s text:c="11"/>年度において下記のとおり<text:s text:c="12"/>老人クラブの事業を実施した</text:p>
      <text:p text:style-name="Left">いので、東郷町補助金等交付規則第３条の規定により補助金の交付を申請します。</text:p>
      <text:p text:style-name="P"><text:s text:c="2"/></text:p>
      <text:p text:style-name="Center">記</text:p>
      <text:p text:style-name="P"><text:s text:c="2"/></text:p>
      <table:table table:name="Application" table:style-name="Table">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-columns-spanned="2"><text:p text:style-name="Center">申請補助事業内容</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="CellCenter"/>
          <table:table-cell table:style-name="CellLeft">
            <text:p text:style-name="Left">□　老人クラブ活動事業</text:p>
            <text:p text:style-name="Left">□　花壇管理事業</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-rows-spanned="3"><text:p text:style-name="Center">申請金額</text:p></table:table-cell>
          <table:table-cell table:style-name="CellLeft"><text:p text:style-name="Left">老人クラブ活動事業①</text:p></table:table-cell>
          <table:table-cell table:style-name="CellLeft">
            <text:p text:style-name="Center">（単位数＿＿＿＿・会員数＿＿＿＿）</text:p>
            <text:p text:style-name="Left">金<text:s text:c="25"/>円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="CellCenter"/>
          <table:table-cell table:style-name="CellLeft"><text:p text:style-name="Left">花壇管理事業②</text:p></table:table-cell>
          <table:table-cell table:style-name="CellLeft">
            <text:p text:style-name="Center">（花壇管理面積　計＿＿＿＿m²）</text:p>
            <text:p text:style-name="Left">金<text:s text:c="25"/>円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="CellCenter"/>
          <table:table-cell table:style-name="CellLeft"><text:p text:style-name="Left">合計（①＋②）</text:p></table:table-cell>
          <table:table-cell table:style-name="CellLeft"><text:p text:style-name="Left">金<text:s text:c="25"/>円</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="P"><text:s text:c="2"/></text:p>
      <table:table table:name="Attachments" table:style-name="Table">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-rows-spanned="2"><text:p text:style-name="Center">添付書類</text:p></table:table-cell>
          <table:table-cell table:style-name="CellLeft"><text:p text:style-name="Left">老人クラブ活動事業</text:p></table:table-cell>
          <table:table-cell table:style-name="CellLeft"><text:p text:style-name="Left">(1)事業計画(2)歳入歳出予算書(3)会員名簿</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="CellCenter"/>
          <table:table-cell table:style-name="CellLeft"><text:p text:style-name="Left">花壇管理事業</text:p></table:table-cell>
          <table:table-cell table:style-name="CellLeft"><text:p text:style-name="Left">(1)花壇事業計画(2)花壇位置図(3)求積図</text:p></table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>