        <table:table-row><table:table-cell table:style-name="C2"><text:p>住　所　〒</text:p></table:table-cell><table:table-cell table:style-name="C2" table:number-columns-spanned="3"><text:p/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="C2"><text:p>電話番号　①（　　　　　）　　－　　②（　　　　　）　　－</text:p></table:table-cell><table:table-cell table:style-name="C2" table:number-columns-spanned="3"><text:p/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
      </table:table>
      <text:p>※市記入欄</text:p>
      <table:table table:name="OfficeSection" table:style-name="T2">
        <table:table-column table:style-name="ColA"/><table:table-column table:style-name="ColB"/><table:table-column table:style-name="ColC"/><table:table-column table:style-name="ColD"/>
        <table:table-row><table:table-cell table:style-name="C2" table:number-rows-spanned="3"><text:p>受　付</text:p></table:table-cell><table:table-cell table:style-name="C2"><text:p>該　当　要　件</text:p></table:table-cell><table:table-cell table:style-name="C2" table:number-columns-spanned="2"><text:p>支　援　方　法</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="C2"><text:p>□要介護者</text:p><text:p>□障がい者</text:p><text:p>□その他</text:p></table:table-cell><table:table-cell table:style-name="C2" table:number-columns-spanned="2"><text:p>□戸別収集</text:p><text:p>□地域の協力団体</text:p><text:p>（　　　　　　　　　　　　　　　　　）</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="C2"><text:p>審　査　結　果</text:p></table:table-cell><table:table-cell table:style-name="C2" table:number-columns-spanned="2"><text:p>□該当</text:p><text:p>□非該当（理由：　　　　　　　　　　）</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
