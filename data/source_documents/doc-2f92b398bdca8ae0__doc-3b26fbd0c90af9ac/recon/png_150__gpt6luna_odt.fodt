<?xml version="1.0" encoding="UTF-8"?>
<office:document
    xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
    xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
    xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
    xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
    office:mimetype="application/vnd.oasis.opendocument.text"
    office:version="1.4">
  <office:styles>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-size="16pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="TitleNote" style:family="text">
      <style:text-properties fo:font-size="11.5pt" fo:font-weight="normal"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-left="1.9cm" fo:margin-right="1.9cm" fo:margin-top="1.7cm" fo:margin-bottom="1.7cm"/>
    </style:page-layout>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Table" style:family="table">
      <style:table-properties style:width="17.2cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="3.04cm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="2.27cm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="6.59cm"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties style:column-width="5.30cm"/>
    </style:style>
    <style:style style:name="HeaderRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.6cm"/>
    </style:style>
    <style:style style:name="BodyRow" style:family="table-row">
      <style:table-row-properties style:row-height="2.25cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.16cm" style:vertical-align="top"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="HeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="LeftHeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="BodyText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="CenterText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="Title">別紙－１　製法分類区分別菓子製品一覧表　<text:span text:style-name="TitleNote">（無包装品は簡易包装に含める）</text:span></text:p>
      <table:table table:name="FormTable" table:style-name="Table">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="LeftHeaderCell" table:number-rows-spanned="2">
            <text:p text:style-name="CenterText">製法分類区分</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="LeftHeaderCell" table:number-rows-spanned="2">
            <text:p text:style-name="CenterText">包装区分</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="HeaderCell" table:number-columns-spanned="2">
            <text:p text:style-name="CenterText">製　品　名</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="HeaderRow">
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="HeaderCell">
            <text:p text:style-name="CenterText">通年製造</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="HeaderCell">
            <text:p text:style-name="CenterText">季節製造（　月～　月）</text:p>
          </table:table-cell>
        </table:table-row>

        <table:table-row table:style-name="BodyRow">
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2">
            <text:p text:style-name="BodyText">①生地調整で<text:line-break/>加熱する菓子</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="BodyText">密封包装</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="BodyRow">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="BodyText">簡易包装</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>

        <table:table-row table:style-name="BodyRow">
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2">
            <text:p text:style-name="BodyText">②生地調整後<text:line-break/>加熱する菓子</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="BodyText">密封包装</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="BodyRow">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="BodyText">簡易包装</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>

        <table:table-row table:style-name="BodyRow">
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2">
            <text:p text:style-name="BodyText">③加熱後手細<text:line-break/>工加工等が入<text:line-break/>る菓子</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="BodyText">密封包装</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="BodyRow">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="BodyText">簡易包装</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>

        <table:table-row table:style-name="BodyRow">
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2">
            <text:p text:style-name="BodyText">④仕上げ（充<text:line-break/>填・巻き締め）<text:line-break/>工程後加熱す<text:line-break/>る菓子</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="BodyText">密封包装</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="BodyRow">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="BodyText">簡易包装</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>

        <table:table-row table:style-name="BodyRow">
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2">
            <text:p text:style-name="BodyText">⑤加熱加工し<text:line-break/>ない或いは低<text:line-break/>加熱加工の菓<text:line-break/>子</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="BodyText">密封包装</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="BodyRow">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="BodyText">簡易包装</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>