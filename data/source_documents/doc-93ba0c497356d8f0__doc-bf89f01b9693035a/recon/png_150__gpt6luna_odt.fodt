<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="120%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="12pt"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="120%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="HeadingLabel" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.1cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="DocumentTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.55cm" fo:margin-bottom="0.65cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="DateLine" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end" fo:margin-top="0.3cm" fo:margin-bottom="0.75cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.55cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Issuer" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="6.8cm" fo:line-height="150%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Submission" style:family="paragraph">
      <style:paragraph-properties fo:text-indent="0.5cm" fo:margin-top="0.7cm" fo:margin-bottom="0.3cm" fo:line-height="150%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="CellText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="120%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="CellLeft" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:line-height="120%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="AttachmentText" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.4cm" fo:line-height="150%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="3cm" fo:margin-right="3cm" fo:margin-top="2.2cm" fo:margin-bottom="2cm"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="15cm" table:align="left" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ColumnA" style:family="table-column">
      <style:table-column-properties style:column-width="4.53cm"/>
    </style:style>
    <style:style style:name="ColumnB" style:family="table-column">
      <style:table-column-properties style:column-width="2.58cm"/>
    </style:style>
    <style:style style:name="ColumnC" style:family="table-column">
      <style:table-column-properties style:column-width="7.89cm"/>
    </style:style>
    <style:style style:name="FormCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0.16cm" style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="HeadingLabel">様式第６号（第１０条関係）</text:p>
      <text:p text:style-name="DocumentTitle">尾道市生産性向上等促進事業補助金実績報告書</text:p>
      <text:p text:style-name="DateLine">年　　　月　　　日</text:p>
      <text:p text:style-name="Recipient">尾道市長　　様</text:p>
      <text:p text:style-name="Issuer">住所及び所在地</text:p>
      <text:p text:style-name="Issuer">名　　　　　称</text:p>
      <text:p text:style-name="Issuer">代表者職・氏名</text:p>
      <text:p text:style-name="Submission">次のとおり事業を完了したので、尾道市生産性向上等促進事業補助金交付要<text:line-break/>綱第１０条の規定により、関係書類を添えて提出します。</text:p>
      <table:table table:name="Form" table:style-name="FormTable">
        <table:table-column table:style-name="ColumnA"/>
        <table:table-column table:style-name="ColumnB"/>
        <table:table-column table:style-name="ColumnC"/>
        <table:table-row>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellText">補 助 金 交 付 決 定 番 号</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="2">
            <text:p text:style-name="CellText">年　　　月　　　日　　第　　　号</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellText">補 助 事 業 等 の 名 称</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="2">
            <text:p text:style-name="CellText">□　生産性向上枠　　□　ＤＸ推進枠</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellLeft">補助事業等の実施場所</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="2">
            <text:p text:style-name="CellLeft"/>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellText">事 業 実 施 期 間</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="2">
            <text:p text:style-name="CellText">年　　　月　　　日　～　　年　　　月　　　日</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="2">
            <text:p text:style-name="CellText">補 助 事 業 に 要 し た 経 費</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellLeft">円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="2">
            <text:p text:style-name="CellText">補 助 対 象 事 業 費</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellLeft">円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="2">
            <text:p text:style-name="CellText">補 助 金 交 付 決 定 額</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="FormCell">
            <text:p text:style-name="CellLeft">円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="3">
            <text:p text:style-name="CellLeft">添付書類</text:p>
            <text:p text:style-name="AttachmentText">１　事業収支決算書（別紙）</text:p>
            <text:p text:style-name="AttachmentText">２　補助対象事業を実施したことを証明する書類</text:p>
            <text:p text:style-name="AttachmentText">３　支払を証明する書類の写し</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>