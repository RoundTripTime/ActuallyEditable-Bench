    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:font-size="12pt" fo:line-height="150%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt" style:font-name="serif"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:font-size="12pt" fo:line-height="150%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
