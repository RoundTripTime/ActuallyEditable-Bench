    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:font-size="20pt" fo:line-height="180%" fo:margin-top="0cm" fo:margin-bottom="0.4cm"/>
      <style:text-properties fo:font-size="20pt" style:font-name="serif"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:font-size="12pt" fo:line-height="150%" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt" style:font-name="serif"/>
    </style:style>
