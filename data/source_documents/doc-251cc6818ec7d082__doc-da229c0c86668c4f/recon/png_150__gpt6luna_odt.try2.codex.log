    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="2cm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="4.7cm"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties style:column-width="3.8cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.12cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.12cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellText" style:family="paragraph">
