<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.08cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="17pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph" style:parent-style-name="P">
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="middle"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="Label" style:family="table-cell" style:parent-style-name="Cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" fo:background-color="#d9d9d9" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Box" style:family="table-cell" style:parent-style-name="Cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="AmountLabel" style:family="table-cell" style:parent-style-name="Label">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.07cm" fo:background-color="#d9d9d9"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.2cm" fo:margin-bottom="1.2cm" fo:margin-left="1.3cm" fo:margin-right="1.3cm" style:print-orientation="portrait"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="100%" table:align="margins" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="HalfTable" style:family="table">
      <style:table-properties style:width="48%" table:align="left" table:border-model="collapsing"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">寄附申出書</text:p>
      <text:p text:style-name="P">世田谷区長あて</text:p>
      <text:p text:style-name="P">以下のとおり、寄附いたします。</text:p>
      <text:p text:style-name="P">１．　寄附者　　　　　　　　　　　　　　　　　　　　　　　　　寄附申出日　　　年　　　月　　　日</text:p>
      <table:table table:name="寄附者" table:style-name="FormTable">
        <table:table-column table:number-columns-repeated="8"/>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p text:style-name="P">フリガナ※</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="7" table:style-name="Box"><text:p text:style-name="P"/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p text:style-name="P">漢字氏名</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="7" table:style-name="Box"><text:p text:style-name="P"/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p text:style-name="P">郵便番号</text:p></table:table-cell>
          <table:table-cell table:style-name="Box"><text:p text:style-name="P"/></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P"/></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P"/></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P">―</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P"/></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P"/></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p text:style-name="P">住所</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="7" table:style-name="Box"><text:p text:style-name="P">　　　　　　　　　　　　　　　都　道</text:p><text:p text:style-name="P">　　　　　　　　　　　　　　　府　県</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row><table:table-cell table:style-name="Label"><text:p text:style-name="P"/></table:table-cell><table:table-cell table:number-columns-spanned="7" table:style-name="Box"><text:p text:style-name="P"/></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p text:style-name="P">電話番号</text:p><text:p text:style-name="P">(ハイフンあり)</text:p></table:table-cell>
          <table:table-cell table:style-name="Box"><text:p text:style-name="P"/></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P"/></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P"/></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P"/></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P"/></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P"/></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P"/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Small">※住所に建物名や方書がある場合は、そちらもご記入ください。</text:p>
      <text:p text:style-name="P">２．　寄附金支払い方法（いずれかに✔をつけてください）</text:p>
      <text:p text:style-name="P">□　郵便振替　　　　　　　　　□　銀行振込　　　　　　　　　　　　　□現金持参</text:p>
      <text:p text:style-name="P">　（ふるさと納税サポート室から　　　（以下振込先口座へお振込ください）</text:p>
      <text:p text:style-name="P">　用紙をお送りします）</text:p>
      <text:p text:style-name="P">　　　　　　世田谷区寄附金受入口座（セタガヤクキフキンウケイレコウザ）</text:p>
      <text:p text:style-name="P">　　　　　　みずほ銀行　世田谷支店　普通　1516694</text:p>
      <text:p text:style-name="P">３．　氏名・寄附金額の区広報紙やホームページ等での公表の可否（いずれかに✔をつけてください）</text:p>
      <text:p text:style-name="P">□　氏名・金額ともに可　　□　氏名のみ可　　□　金額のみ可　　□　氏名・金額ともに不可</text:p>
      <text:p text:style-name="P">４．　ワンストップ特例申請書の要否※</text:p>
      <text:p text:style-name="P">□　必要　　　　　　　　　□　不要　　　　　　　　　※確定申告をされる方や法人・団体の方は</text:p>
      <text:p text:style-name="P">　　　　　　　　　　　　　　　　　　　　　　　　　　　“不 要”をお選びください。</text:p>
      <text:p text:style-name="P">　　　　　　　　　　　　　　アンケートにご協力お願いします</text:p>
      <text:p text:style-name="P">●世田谷区へのご寄附のきっかけを教えてください（✔を入れてください）</text:p>
      <text:p text:style-name="P">□　ふるさとまたはゆかりのある自治体だから　　□　寄附金の使い道に共感したから</text:p>
      <text:p text:style-name="P">□　節税対策になるから　　□　返礼品が魅力的だったから　　□　その他（　　　　　　　　　）</text:p>
      <text:p text:style-name="P">●世田谷区のふるさと納税の取組みを何でお知りになりましたか（✔を入れてください）</text:p>
      <text:p text:style-name="P">□　区のホームページ　　□　区のおしらせ　　□　ポータルサイト（ふるさとチョイス、さとふる等）</text:p>
      <text:p text:style-name="P">□　ちらし・ポスター　　□　テレビや新聞、雑誌　　□　家族・知人などの紹介　　□　その他</text:p>
      <text:p text:style-name="P">●あなたの年代を教えてください（✔をいれてください）</text:p>
      <text:p text:style-name="P">□　20代以下　□　30代　□　40代　□　50代　□　60代　□　70代　□　80代以上　□　無回答</text:p>
      <text:p text:style-name="Center">ありがとうございました</text:p>
      <text:p text:style-name="Center">1　　　　　　　　　　　　　　　　　　　　　　　　　2ページ以降もご記入ください</text:p>
      <text:p text:style-name="PageStart">5－１．希望使途及び寄附金額</text:p>
      <text:p text:style-name="P">（ご希望の使い道（P2～P3）に金額をご記入ください（複数選択可））。</text:p>
      <text:p text:style-name="P">【医療･福祉】</text:p>
      <table:table table:name="希望使途と金額" table:style-name="FormTable">
        <table:table-column table:number-columns-repeated="2"/>
        <table:table-row><table:table-cell table:style-name="AmountLabel"><text:p text:style-name="P">地域保健福祉等推進基金【福祉のために】</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P">　　　　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="AmountLabel"><text:p text:style-name="P">地域保健福祉等推進基金【市民活動のために】</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P">　　　　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="AmountLabel"><text:p text:style-name="P">犯罪被害者等支援等基金</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P">　　　　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="AmountLabel"><text:p text:style-name="P">医療的ケア児の笑顔を支える基金</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P">　　　　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="AmountLabel"><text:p text:style-name="P">児童養護施設退所者等奨学･自立支援基金</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P">　　　　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="AmountLabel"><text:p text:style-name="P">せたがや　動物とともにいきるまちプロジェクト</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P">　　　　　　　　　　　　円</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="P">【子ども･子育て】</text:p>
      <table:table table:name="子ども子育て" table:style-name="FormTable">
        <table:table-column table:number-columns-repeated="2"/>
        <table:table-row><table:table-cell table:style-name="AmountLabel"><text:p text:style-name="P">子ども･若者基金【外遊びの場と機会の充実のために】</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P">　　　　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="AmountLabel"><text:p text:style-name="P">子ども･若者基金【子どもの学びの支援のために】</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P">　　　　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="AmountLabel"><text:p text:style-name="P">子ども･若者基金【子どもを育む地域活動支援のために】</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P">　　　　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="AmountLabel"><text:p text:style-name="P">子ども･若者基金【多様な子ども･若者の活動を支えるために】</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P">　　　　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="AmountLabel"><text:p text:style-name="P">子ども･若者基金【子ども･子育て支援のために】</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P">　　　　　　　　　　　　円</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="P">児童館の整備のために（奥沢地区児童館）　　児童館の整備のために（九品仏地区児童館･保育園複合施設）</text:p>
      <text:p text:style-name="P">船橋児童館　陶芸活動再開応援プロジェクト　　喜多見児童館　陶芸窯応援プロジェクト</text:p>
      <text:p text:style-name="P">【文化･国際･教育･スポーツ】</text:p>
      <table:table table:name="文化国際教育スポーツ" table:style-name="FormTable">
        <table:table-column table:number-columns-repeated="2"/>
        <table:table-row><table:table-cell table:style-name="AmountLabel"><text:p text:style-name="P">世田谷遊びと学びの教育基金</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P">　　　　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="AmountLabel"><text:p text:style-name="P">文化振興基金</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P">　　　　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="AmountLabel"><text:p text:style-name="P">国際平和交流基金</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P">　　　　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="AmountLabel"><text:p text:style-name="P">スポーツ推進基金</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P">　　　　　　　　　　　　円</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="PageStart">【みどり･環境】</text:p>
      <table:table table:name="みどり環境" table:style-name="FormTable">
        <table:table-column table:number-columns-repeated="2"/>
        <table:table-row><table:table-cell table:style-name="AmountLabel"><text:p text:style-name="P">みどりのトラスト基金【みどりを守るために】</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P">　　　　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="AmountLabel"><text:p text:style-name="P">みどりのトラスト基金【羽根木公園の梅林を守るために】</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P">　　　　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="AmountLabel"><text:p text:style-name="P">等々力渓谷などの崖線樹林地保全</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P">　　　　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="AmountLabel"><text:p text:style-name="P">みどりのトラスト基金【寄附ベンチ】</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P">　　　　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="AmountLabel"><text:p text:style-name="P">みどりのトラスト基金【世田谷の樹林地を育もう！】</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P">　　　　　　　　　　　　円</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="P">【その他】</text:p>
      <table:table table:name="その他" table:style-name="FormTable">
        <table:table-column table:number-columns-repeated="2"/>
        <table:table-row><table:table-cell table:style-name="AmountLabel"><text:p text:style-name="P">災害対策基金</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P">　　　　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="AmountLabel"><text:p text:style-name="P">世田谷区本庁舎等整備プロジェクト</text:p><text:p text:style-name="Small">※個人の方は３万円以上、法人･団体の方は１０万円以上</text:p><text:p text:style-name="Small">の寄附をいただいた方に「区民会館エントランスホール」裏</text:p><text:p text:style-name="Small">銘板への氏名等掲載希望確認のご案内を送付いたします。</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P">　　　　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="AmountLabel"><text:p text:style-name="P">気候危機対策基金</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P">　　　　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="AmountLabel"><text:p text:style-name="P">交通不便地域解消プロジェクト</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P">　　　　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="AmountLabel"><text:p text:style-name="P">旧玉電･江ノ電車両　再塗装プロジェクト</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P">　　　　　　　　　　　　円</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="AmountLabel"><text:p text:style-name="P">区政全般のために</text:p></table:table-cell><table:table-cell table:style-name="Box"><text:p text:style-name="P">　　　　　　　　　　　　円</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="PageStart">５－２．　区立小･中学校への寄附を希望される方へ</text:p>
      <text:p text:style-name="P">区立小･中学校の施設整備（改築等）事業への寄附を希望される方は、こちらに金額をご記入ください。</text:p>
      <text:p text:style-name="P">①　学校を指定される方は、希望する学校を選択してください。</text:p>
      <text:p text:style-name="P">②　学校を指定されない方は、「義務教育施設整備基金」を選択してください。</text:p>
      <text:p text:style-name="P">【学校指定寄附：小学校】　　　　　　　　　　　　　　　【学校指定寄附：中学校】</text:p>
      <text:p text:style-name="Small">※こちらの使い道については、返礼品をお贈りすることはできません。　　　　※こちらの使い道については、返礼品をお贈りすることはできません。</text:p>
