<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#000000"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.1cm" fo:margin-bottom="0.38cm" fo:padding-bottom="0.22cm" fo:border-bottom="0.8pt solid #4f81bd"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="28pt" fo:color="#17365d"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.2cm" fo:margin-bottom="0.22cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.2cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="MetaLabel" style:family="paragraph">
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:font-weight="bold" fo:color="#376092"/>
    </style:style>
    <style:style style:name="MetaValue" style:family="paragraph">
      <style:text-properties fo:font-family="Arial" fo:font-size="10pt" fo:color="#376092"/>
    </style:style>
    <style:style style:name="GridHead" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:font-weight="bold" fo:color="#376092"/>
    </style:style>
    <style:style style:name="Totals" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.22cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.2cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="FooterText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Arial" fo:font-size="8pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Strong" style:family="text">
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="1.4cm" fo:margin-right="1.4cm" fo:margin-top="1.5cm" fo:margin-bottom="1.5cm"/>
    </style:page-layout>
    <style:style style:name="MetaTable" style:family="table"/>
    <style:style style:name="MetaCol1" style:family="table-column">
      <style:table-column-properties style:column-width="9.1cm"/>
    </style:style>
    <style:style style:name="MetaCol2" style:family="table-column">
      <style:table-column-properties style:column-width="9.1cm"/>
    </style:style>
    <style:style style:name="MetaCell" style:family="table-cell">
      <style:table-cell-properties fo:padding-left="0.2cm" fo:padding-right="0.2cm" fo:padding-top="0.06cm" fo:padding-bottom="0.06cm"/>
    </style:style>
    <style:style style:name="MetaBand" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#d2dfed" fo:padding-left="0.2cm" fo:padding-right="0.2cm" fo:padding-top="0.06cm" fo:padding-bottom="0.06cm"/>
    </style:style>
    <style:style style:name="MetaTop" style:family="table-cell">
      <style:table-cell-properties fo:border-top="1pt solid #4f81bd" fo:padding-left="0.2cm" fo:padding-right="0.2cm" fo:padding-top="0.06cm" fo:padding-bottom="0.06cm"/>
    </style:style>
    <style:style style:name="MetaTopBand" style:family="table-cell">
      <style:table-cell-properties fo:border-top="1pt solid #4f81bd" fo:background-color="#d2dfed" fo:padding-left="0.2cm" fo:padding-right="0.2cm" fo:padding-top="0.06cm" fo:padding-bottom="0.06cm"/>
    </style:style>
    <style:style style:name="MetaBottom" style:family="table-cell">
      <style:table-cell-properties fo:border-bottom="1pt solid #4f81bd" fo:padding-left="0.2cm" fo:padding-right="0.2cm" fo:padding-top="0.06cm" fo:padding-bottom="0.06cm"/>
    </style:style>
    <style:style style:name="MetaBottomBand" style:family="table-cell">
      <style:table-cell-properties fo:border-bottom="1pt solid #4f81bd" fo:background-color="#d2dfed" fo:padding-left="0.2cm" fo:padding-right="0.2cm" fo:padding-top="0.06cm" fo:padding-bottom="0.06cm"/>
    </style:style>
    <style:style style:name="GridTable" style:family="table"/>
    <style:style style:name="GridCol1" style:family="table-column">
      <style:table-column-properties style:column-width="8.3cm"/>
    </style:style>
    <style:style style:name="GridCol2" style:family="table-column">
      <style:table-column-properties style:column-width="2.6cm"/>
    </style:style>
    <style:style style:name="GridCol3" style:family="table-column">
      <style:table-column-properties style:column-width="3.8cm"/>
    </style:style>
    <style:style style:name="GridCol4" style:family="table-column">
      <style:table-column-properties style:column-width="3.5cm"/>
    </style:style>
    <style:style style:name="GridHeadCell" style:family="table-cell">
      <style:table-cell-properties fo:border-top="1pt solid #4f81bd" fo:border-bottom="1pt solid #4f81bd" fo:padding-left="0.2cm" fo:padding-right="0.15cm" fo:padding-top="0.08cm" fo:padding-bottom="0.08cm"/>
    </style:style>
    <style:style style:name="GridBand" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#d2dfed" fo:padding-left="0.15cm" fo:padding-right="0.15cm" fo:padding-top="0.06cm" fo:padding-bottom="0.06cm"/>
    </style:style>
    <style:style style:name="GridBlank" style:family="table-cell">
      <style:table-cell-properties fo:padding-left="0.15cm" fo:padding-right="0.15cm" fo:padding-top="0.06cm" fo:padding-bottom="0.06cm"/>
    </style:style>
    <style:style style:name="BandRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.62cm"/>
    </style:style>
    <style:style style:name="BlankRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.58cm"/>
    </style:style>
    <style:style style:name="TotalsTableCell" style:family="table-cell">
      <style:table-cell-properties fo:border-top="1pt solid #4f81bd" fo:padding-top="0.05cm" fo:padding-left="0.2cm" fo:padding-right="0.2cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout">
      <style:footer>
        <text:p text:style-name="FooterText">OnlineBiller | Original English resource | Blank template</text:p>
      </style:footer>
    </style:master-page>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">Restaurant Bill</text:p>
      <text:p text:style-name="Subtitle">BLANK TEMPLATE | Currency: INR</text:p>
      <table:table table:name="BillDetails" table:style-name="MetaTable">
        <table:table-column table:style-name="MetaCol1"/>
        <table:table-column table:style-name="MetaCol2"/>
        <table:table-row>
          <table:table-cell table:style-name="MetaTop"><text:p text:style-name="MetaLabel">Restaurant</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaTop"><text:p text:style-name="MetaValue">__________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaBand"><text:p text:style-name="MetaLabel">Bill / date</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaBand"><text:p text:style-name="MetaValue">__________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="MetaLabel">Table / order</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="MetaValue">__________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaBand"><text:p text:style-name="MetaLabel">Service</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaBand"><text:p text:style-name="MetaValue">__________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="MetaLabel">Guest reference</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="MetaValue">__________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaBand"><text:p text:style-name="MetaLabel">Price basis</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaBand"><text:p text:style-name="MetaValue">__________________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaBottom"><text:p text:style-name="MetaLabel">Payment reference</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaBottom"><text:p text:style-name="MetaValue">__________________________________________</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body"/>
      <table:table table:name="Items" table:style-name="GridTable">
        <table:table-column table:style-name="GridCol1"/>
        <table:table-column table:style-name="GridCol2"/>
        <table:table-column table:style-name="GridCol3"/>
        <table:table-column table:style-name="GridCol4"/>
        <table:table-row>
          <table:table-cell table:style-name="GridHeadCell"><text:p text:style-name="GridHead">Description</text:p></table:table-cell>
          <table:table-cell table:style-name="GridHeadCell"><text:p text:style-name="GridHead">Quantity</text:p></table:table-cell>
          <table:table-cell table:style-name="GridHeadCell"><text:p text:style-name="GridHead">Rate (INR)</text:p></table:table-cell>
          <table:table-cell table:style-name="GridHeadCell"><text:p text:style-name="GridHead">Amount (INR)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="BandRow">
          <table:table-cell table:style-name="GridBand"/>
          <table:table-cell table:style-name="GridBand"/>
          <table:table-cell table:style-name="GridBand"/>
          <table:table-cell table:style-name="GridBand"/>
        </table:table-row>
        <table:table-row table:style-name="BlankRow">
          <table:table-cell table:style-name="GridBlank"/>
          <table:table-cell table:style-name="GridBlank"/>
          <table:table-cell table:style-name="GridBlank"/>
          <table:table-cell table:style-name="GridBlank"/>
        </table:table-row>
        <table:table-row table:style-name="BandRow">
          <table:table-cell table:style-name="GridBand"/>
          <table:table-cell table:style-name="GridBand"/>
          <table:table-cell table:style-name="GridBand"/>
          <table:table-cell table:style-name="GridBand"/>
        </table:table-row>
        <table:table-row table:style-name="BlankRow">
          <table:table-cell table:style-name="GridBlank"/>
          <table:table-cell table:style-name="GridBlank"/>
          <table:table-cell table:style-name="GridBlank"/>
          <table:table-cell table:style-name="GridBlank"/>
        </table:table-row>
        <table:table-row table:style-name="BandRow">
          <table:table-cell table:style-name="GridBand"/>
          <table:table-cell table:style-name="GridBand"/>
          <table:table-cell table:style-name="GridBand"/>
          <table:table-cell table:style-name="GridBand"/>
        </table:table-row>
        <table:table-row table:style-name="BlankRow">
          <table:table-cell table:style-name="GridBlank"/>
          <table:table-cell table:style-name="GridBlank"/>
          <table:table-cell table:style-name="GridBlank"/>
          <table:table-cell table:style-name="GridBlank"/>
        </table:table-row>
        <table:table-row table:style-name="BandRow">
          <table:table-cell table:style-name="GridBand"/>
          <table:table-cell table:style-name="GridBand"/>
          <table:table-cell table:style-name="GridBand"/>
          <table:table-cell table:style-name="GridBand"/>
        </table:table-row>
      </table:table>
      <table:table table:name="Totals" table:style-name="MetaTable">
        <table:table-column table:style-name="MetaCol1"/>
        <table:table-column table:style-name="MetaCol2"/>
        <table:table-row>
          <table:table-cell table:style-name="TotalsTableCell" table:number-columns-spanned="2"><text:p text:style-name="Totals"><text:span text:style-name="Strong">Subtotal:</text:span> INR __________</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaCell" table:number-columns-spanned="2"><text:p text:style-name="Totals"><text:span text:style-name="Strong">Agreed discount (deduct):</text:span> INR __________</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaCell" table:number-columns-spanned="2"><text:p text:style-name="Totals"><text:span text:style-name="Strong">Amount due:</text:span> INR __________</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Note">The example demonstrates item totals and an agreed discount; it does not calculate tax.</text:p>
      <text:p text:style-name="Note">Payment status must match the actual payment record.</text:p>
      <text:p text:style-name="Note">Word amounts are manual. Check line amounts and totals after every edit.</text:p>
    </office:text>
  </office:body>
</office:document>