<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.18cm"/>
      <style:text-properties fo:font-family="Liberation Sans" fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.25cm" fo:border-bottom="1pt solid #4F81BD"/>
      <style:text-properties fo:font-family="Liberation Sans" fo:font-size="27pt" fo:color="#17365D"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.45cm" fo:margin-bottom="0.2cm"/>
      <style:text-properties fo:font-family="Liberation Sans" fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="FieldLabel" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Liberation Sans" fo:font-size="11pt" fo:font-weight="bold" fo:color="#376092"/>
    </style:style>
    <style:style style:name="FieldValue" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Liberation Sans" fo:font-size="10pt" fo:color="#376092"/>
    </style:style>
    <style:style style:name="ItemHeader" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Liberation Sans" fo:font-size="10pt" fo:font-weight="bold" fo:color="#376092"/>
    </style:style>
    <style:style style:name="Total" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.18cm"/>
      <style:text-properties fo:font-family="Liberation Sans" fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="FooterText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Liberation Sans" fo:font-size="8pt" fo:color="#000000"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-top="1.6cm" fo:margin-bottom="1.6cm" fo:margin-left="1.4cm" fo:margin-right="1.4cm"/>
    </style:page-layout>
    <style:style style:name="FieldTable" style:family="table">
      <style:table-properties style:width="18.2cm"/>
    </style:style>
    <style:style style:name="ItemTable" style:family="table">
      <style:table-properties style:width="18.2cm"/>
    </style:style>
    <style:style style:name="FieldColumnA" style:family="table-column">
      <style:table-column-properties style:column-width="9.1cm"/>
    </style:style>
    <style:style style:name="FieldColumnB" style:family="table-column">
      <style:table-column-properties style:column-width="9.1cm"/>
    </style:style>
    <style:style style:name="ItemColumnA" style:family="table-column">
      <style:table-column-properties style:column-width="8cm"/>
    </style:style>
    <style:style style:name="ItemColumnB" style:family="table-column">
      <style:table-column-properties style:column-width="2.5cm"/>
    </style:style>
    <style:style style:name="ItemColumnC" style:family="table-column">
      <style:table-column-properties style:column-width="3.8cm"/>
    </style:style>
    <style:style style:name="ItemColumnD" style:family="table-column">
      <style:table-column-properties style:column-width="3.9cm"/>
    </style:style>
    <style:style style:name="FieldCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #4F81BD" fo:padding="0.18cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="FieldCellBlue" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#D6E2F0" fo:border="0.5pt solid #4F81BD" fo:padding="0.18cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="ItemHeadCell" style:family="table-cell">
      <style:table-cell-properties fo:border-top="0.75pt solid #4F81BD" fo:border-bottom="0.75pt solid #4F81BD" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="ItemCellBlue" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#D6E2F0" fo:padding="0.16cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="GapRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.48cm"/>
    </style:style>
    <style:style style:name="ItemRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.48cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout">
      <style:footer>
        <text:p text:style-name="FooterText">OnlineBiller | Original English resource | Blank template</text:p>
      </style:footer>
    </style:master-page>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">Restaurant Bill</text:p>
      <text:p text:style-name="Subtitle">BLANK TEMPLATE | Currency: INR</text:p>
      <table:table table:name="BillDetails" table:style-name="FieldTable">
        <table:table-column table:style-name="FieldColumnA"/>
        <table:table-column table:style-name="FieldColumnB"/>
        <table:table-row>
          <table:table-cell table:style-name="FieldCell"><text:p text:style-name="FieldLabel">Restaurant</text:p></table:table-cell>
          <table:table-cell table:style-name="FieldCell"><text:p text:style-name="FieldValue">_______________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FieldCellBlue"><text:p text:style-name="FieldLabel">Bill / date</text:p></table:table-cell>
          <table:table-cell table:style-name="FieldCellBlue"><text:p text:style-name="FieldValue">_______________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FieldCell"><text:p text:style-name="FieldLabel">Table / order</text:p></table:table-cell>
          <table:table-cell table:style-name="FieldCell"><text:p text:style-name="FieldValue">_______________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FieldCellBlue"><text:p text:style-name="FieldLabel">Service</text:p></table:table-cell>
          <table:table-cell table:style-name="FieldCellBlue"><text:p text:style-name="FieldValue">_______________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FieldCell"><text:p text:style-name="FieldLabel">Guest reference</text:p></table:table-cell>
          <table:table-cell table:style-name="FieldCell"><text:p text:style-name="FieldValue">_______________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FieldCellBlue"><text:p text:style-name="FieldLabel">Price basis</text:p></table:table-cell>
          <table:table-cell table:style-name="FieldCellBlue"><text:p text:style-name="FieldValue">_______________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FieldCell"><text:p text:style-name="FieldLabel">Payment reference</text:p></table:table-cell>
          <table:table-cell table:style-name="FieldCell"><text:p text:style-name="FieldValue">_______________________________________</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body"/>
      <table:table table:name="Items" table:style-name="ItemTable">
        <table:table-column table:style-name="ItemColumnA"/>
        <table:table-column table:style-name="ItemColumnB"/>
        <table:table-column table:style-name="ItemColumnC"/>
        <table:table-column table:style-name="ItemColumnD"/>
        <table:table-row>
          <table:table-cell table:style-name="ItemHeadCell"><text:p text:style-name="ItemHeader">Description</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHeadCell"><text:p text:style-name="ItemHeader">Quantity</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHeadCell"><text:p text:style-name="ItemHeader">Rate (INR)</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHeadCell"><text:p text:style-name="ItemHeader">Amount (INR)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ItemRow">
          <table:table-cell table:style-name="ItemCellBlue"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemCellBlue"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemCellBlue"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemCellBlue"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="GapRow">
          <table:table-cell><text:p/></table:table-cell><table:table-cell><text:p/></table:table-cell><table:table-cell><text:p/></table:table-cell><table:table-cell><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ItemRow">
          <table:table-cell table:style-name="ItemCellBlue"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemCellBlue"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemCellBlue"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemCellBlue"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="GapRow">
          <table:table-cell><text:p/></table:table-cell><table:table-cell><text:p/></table:table-cell><table:table-cell><text:p/></table:table-cell><table:table-cell><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ItemRow">
          <table:table-cell table:style-name="ItemCellBlue"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemCellBlue"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemCellBlue"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemCellBlue"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="GapRow">
          <table:table-cell><text:p/></table:table-cell><table:table-cell><text:p/></table:table-cell><table:table-cell><text:p/></table:cell><table:table-cell><text:p/></table:cell>
        </table:table-row>
        <table:table-row table:style-name="ItemRow">
          <table:table-cell table:style-name="ItemCellBlue"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemCellBlue"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemCellBlue"><text:p/></table:table-cell>
          <table:table-cell table:style-name="ItemCellBlue"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Total"><text:span text:style-name="FieldLabel">Subtotal:</text:span> INR __________</text:p>
      <text:p text:style-name="Total"><text:span text:style-name="FieldLabel">Agreed discount (deduct):</text:span> INR __________</text:p>
      <text:p text:style-name="Total"><text:span text:style-name="FieldLabel">Amount due:</text:span> INR __________</text:p>
      <text:p text:style-name="Body">The example demonstrates item totals and an agreed discount; it does not calculate tax.</text:p>
      <text:p text:style-name="Body">Payment status must match the actual payment record.</text:p>
      <text:p text:style-name="Body">Word amounts are manual. Check line amounts and totals after every edit.</text:p>
    </office:text>
  </office:body>
</office:document>