<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%" fo:margin-top="0cm" fo:margin-bottom="0.08cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.15cm" fo:margin-bottom="0.4cm"/>
      <style:text-properties fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="150%"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
    </style:style>
    <style:style style:name="GridTable" style:family="table">
      <style:table-properties style:width="17.2cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ColWide" style:family="table-column">
      <style:table-column-properties style:column-width="10cm"/>
    </style:style>
    <style:style style:name="ColNarrow" style:family="table-column">
      <style:table-column-properties style:column-width="7.2cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:padding="0.12cm" fo:border="0.5pt solid #000000"/>
    </style:style>
    <style:style style:name="CellLeft" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:padding="0.12cm" fo:border="0.5pt solid #000000"/>
    </style:style>
    <style:style style:name="CellBlank" style:family="table-cell">
      <style:table-cell-properties style:vertical-align="middle" fo:padding="0.12cm" fo:border="0.5pt solid #000000"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-left="2.5cm" fo:margin-right="2.5cm" fo:margin-top="2cm" fo:margin-bottom="2cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">道　路　占　用　届　出　書</text:p>
      <table:table table:name="FormMain" table:style-name="GridTable">
        <table:table-column table:style-name="ColWide"/>
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-row>
          <table:table-cell table:style-name="CellBlank"><text:p text:style-name="Body"></text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Right">届出日：　　　年　　月　　日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">高知土木事務所長　様</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">住　所</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellBlank"><text:p text:style-name="Body"></text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">氏　名</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellBlank"><text:p text:style-name="Body"></text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">担当者（連絡先）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellBlank"><text:p text:style-name="Body"></text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">氏　名</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellBlank"><text:p text:style-name="Body"></text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">電　話</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellBlank"><text:p text:style-name="Body"></text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">工　事　を　完　了　し　た</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellBlank"><text:p text:style-name="Body"></text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">工　事　を　中　止　し　た</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">道路の占用について、</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">軽易な事項を変更※した　ので、届け出ます。</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellBlank"><text:p text:style-name="Body"></text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">（※住所等の変更を含む）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellBlank"><text:p text:style-name="Body"></text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">廃　止　し　た</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellBlank"><text:p text:style-name="Body"></text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">※該当するものを○で囲むか又は不要な文言を削除すること。</text:p><text:p text:style-name="Body">※占用許可者(申請者)の交代は、占用許可申請書を提出すること。</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <table:table table:name="DateAndReason" table:style-name="GridTable">
        <table:table-column table:style-name="ColWide"/>
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">完了（中止）・変更・廃止した日</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">年　　　月　　　日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">届出内容及び理由等</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body">※「工事の中止」の場合は理由を、「軽易な事項の変更」「住所（氏名）の変更」の場合は内容（変更前後の事項、住所等）及び理由を記入のこと。</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageStart"></text:p>
      <table:table table:name="Continuation" table:style-name="GridTable">
        <table:table-column table:style-name="ColWide"/>
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-row>
          <table:table-cell table:style-name="CellBlank"><text:p text:style-name="Body"></text:p></table:table-cell>
          <table:table-cell table:style-name="CellBlank"><text:p text:style-name="Body"></text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <table:table table:name="ExistingPermission" table:style-name="GridTable">
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-column table:style-name="ColWide"/>
        <table:table-row>
          <table:table-cell table:style-name="CellBlank"><text:p text:style-name="Body"></text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">占用許可番号及び許可年月日</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="1"><text:p text:style-name="Center">高知県指令　　　第　　号　・　　年　　月　　日</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="5"><text:p text:style-name="Center">既</text:p><text:p text:style-name="Center">許</text:p><text:p text:style-name="Center">可</text:p><text:p text:style-name="Center">事</text:p><text:p text:style-name="Center">項</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">占　用　目　的</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"></text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">占用物件の種類及び数量</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"></text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">占用場所及び路線名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"></text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">占　用　期　間</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">年　　月　　日から　　　年　　月　　日まで</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">工　事　期　間</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">年　　月　　日から　　　年　　月　　日まで</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body">※許可書の写しを添付した場合は、上記「既許可事項」は省略できます。</text:p>
      <text:p text:style-name="Body">※工事の完了届には、状況（施工前、施工中、施工後）写真を添付してください。</text:p>
    </office:text>
  </office:body>
</office:document>