<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="2.5cm" fo:margin-right="2.5cm"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties table:align="margins"/>
    </style:style>
    <style:style style:name="ColItem" style:family="table-column">
      <style:table-column-properties style:column-width="4.45cm"/>
    </style:style>
    <style:style style:name="ColAmount" style:family="table-column">
      <style:table-column-properties style:column-width="3cm"/>
    </style:style>
    <style:style style:name="ColDetails" style:family="table-column">
      <style:table-column-properties style:column-width="9.05cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #444444" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="TotalCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #444444" fo:border-top="double 0.75pt #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HeaderRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.95cm"/>
    </style:style>
    <style:style style:name="IncomeRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.95cm"/>
    </style:style>
    <style:style style:name="ExpenseRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.8cm"/>
    </style:style>
    <style:style style:name="ExpenseHeader" style:family="table-row">
      <style:table-row-properties style:row-height="0.85cm"/>
    </style:style>
    <style:style style:name="ExpenseTotal" style:family="table-row">
      <style:table-row-properties style:row-height="0.9cm"/>
    </style:style>
  </office:automatic-styles>
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="11pt" style:font-size-asian="11pt"/>
    </style:default-style>
    <style:style style:name="TitleLine" style:family="paragraph">
      <style:paragraph-properties fo:text-align="left" fo:margin-bottom="0.3cm"/>
      <style:text-properties fo:font-size="12pt" style:font-size-asian="12pt"/>
    </style:style>
    <style:style style:name="DocTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-size="14pt" style:font-size-asian="14pt"/>
    </style:style>
    <style:style style:name="SectionLine" style:family="paragraph">
      <style:paragraph-properties fo:text-align="left" fo:margin-top="0.1cm" fo:margin-bottom="0.12cm">
        <style:tab-stops>
          <style:tab-stop style:position="16cm" style:type="right"/>
        </style:tab-stops>
      </style:paragraph-properties>
      <style:text-properties fo:font-size="12pt" style:font-size-asian="12pt"/>
    </style:style>
    <style:style style:name="CenterText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="RightText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right"/>
    </style:style>
    <style:style style:name="LeftText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="left"/>
    </style:style>
    <style:style style:name="RedText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right"/>
      <style:text-properties fo:color="#ff3333"/>
    </style:style>
    <style:style style:name="RedLeftText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="left"/>
      <style:text-properties fo:color="#ff3333"/>
    </style:style>
    <style:style style:name="NoteLine" style:family="paragraph">
      <style:paragraph-properties fo:text-align="left" fo:margin-left="0.15cm" fo:margin-bottom="0.55cm"/>
      <style:text-properties fo:font-size="11pt" style:font-size-asian="11pt"/>
    </style:style>
  </office:styles>
  <office:master-styles>
    <style:master-page style:name="DefaultPage" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="TitleLine">様式第３号（第８条関係）</text:p>
      <text:p text:style-name="DocTitle">収支予算書</text:p>
      <text:p text:style-name="SectionLine">1　収入予算<text:tab/>（単位：円）</text:p>
      <table:table table:name="IncomeBudget" table:style-name="FormTable">
        <table:table-column table:style-name="ColItem"/>
        <table:table-column table:style-name="ColAmount"/>
        <table:table-column table:style-name="ColDetails"/>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">項　目</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">金　額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">内　容</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="IncomeRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">市補助金</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RedText">200,000</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="IncomeRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">自己資金</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RedText">100,000</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="IncomeRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">その他</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="IncomeRow">
          <table:table-cell table:style-name="TotalCell"><text:p text:style-name="CenterText">合　計</text:p></table:table-cell>
          <table:table-cell table:style-name="TotalCell"><text:p text:style-name="RedText">300,000</text:p></table:table-cell>
          <table:table-cell table:style-name="TotalCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="NoteLine">（注）　補助率及び補助上限は、別表第４を参照すること。</text:p>
      <text:p text:style-name="SectionLine">2　支出予算<text:tab/>（単位：円）</text:p>
      <table:table table:name="ExpenseBudget" table:style-name="FormTable">
        <table:table-column table:style-name="ColItem"/>
        <table:table-column table:style-name="ColAmount"/>
        <table:table-column table:style-name="ColDetails"/>
        <table:table-row table:style-name="ExpenseHeader">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">項　目</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">金　額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CenterText">内　容</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ExpenseRow">
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RedLeftText">システム導入費</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RedText">300,000</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="RedLeftText">オンラインストレージ導入に係る費用</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ExpenseRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="ExpenseRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="ExpenseRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="ExpenseRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="ExpenseRow">
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row table:style-name="ExpenseTotal">
          <table:table-cell table:style-name="TotalCell"><text:p text:style-name="CenterText">合　計</text:p></table:table-cell>
          <table:table-cell table:style-name="TotalCell"><text:p text:style-name="RedText">300,000</text:p></table:table-cell>
          <table:table-cell table:style-name="TotalCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="NoteLine">（注）　「項目」は、別表第４の項目名を記入すること。</text:p>
    </office:text>
  </office:body>
</office:document>