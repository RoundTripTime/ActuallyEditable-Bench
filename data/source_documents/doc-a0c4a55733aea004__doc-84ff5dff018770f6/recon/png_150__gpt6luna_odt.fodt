<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Default" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0.08in" fo:line-height="100%"/>
      <style:text-properties fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.35in" fo:margin-bottom="0.10in"/>
      <style:text-properties fo:font-size="30pt" fo:color="#1D3B60"/>
    </style:style>
    <style:style style:name="Footer" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0in"/>
      <style:text-properties fo:font-size="9pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="Bold" style:family="text">
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="8.27in" fo:page-height="11.69in" style:print-orientation="portrait" fo:margin-left="0.55in" fo:margin-right="0.55in" fo:margin-top="0.55in" fo:margin-bottom="0.60in"/>
    </style:page-layout>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.12in" fo:margin-bottom="0.09in"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0.10in"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0.08in"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="TableHead" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0in"/>
      <style:text-properties fo:font-size="11pt" fo:font-weight="bold" fo:color="#356399"/>
    </style:style>
    <style:style style:name="FieldLabel" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0in"/>
      <style:text-properties fo:font-size="12pt" fo:font-weight="bold" fo:color="#356399"/>
    </style:style>
    <style:style style:name="FieldLine" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0in"/>
      <style:text-properties fo:font-size="10pt" fo:color="#356399"/>
    </style:style>
    <style:style style:name="SpaceAfterInfo" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0.22in"/>
      <style:text-properties fo:font-size="3pt"/>
    </style:style>
    <style:style style:name="Total" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0.08in"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="InfoTable" style:family="table">
      <style:table-properties style:width="100%" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="InfoColA" style:family="table-column">
      <style:table-column-properties style:column-width="3.50in"/>
    </style:style>
    <style:style style:name="InfoColB" style:family="table-column">
      <style:table-column-properties style:column-width="3.67in"/>
    </style:style>
    <style:style style:name="InfoRowBlue" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.24in" fo:background-color="#D2DFEF"/>
    </style:style>
    <style:style style:name="InfoRowWhite" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.24in"/>
    </style:style>
    <style:style style:name="InfoCell" style:family="table-cell">
      <style:table-cell-properties fo:padding-left="0.08in" fo:padding-right="0.08in" fo:padding-top="0.02in" fo:padding-bottom="0.02in" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="LineTable" style:family="table">
      <style:table-properties style:width="100%" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="LineCol1" style:family="table-column">
      <style:table-column-properties style:column-width="3.05in"/>
    </style:style>
    <style:style style:name="LineCol2" style:family="table-column">
      <style:table-column-properties style:column-width="1.05in"/>
    </style:style>
    <style:style style:name="LineCol3" style:family="table-column">
      <style:table-column-properties style:column-width="1.50in"/>
    </style:style>
    <style:style style:name="LineCol4" style:family="table-column">
      <style:table-column-properties style:column-width="1.57in"/>
    </style:style>
    <style:style style:name="LineHeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:border-top="0.8pt solid #4C84C5" fo:border-bottom="0.8pt solid #4C84C5" fo:padding-left="0.08in" fo:padding-right="0.05in" fo:padding-top="0.02in" fo:padding-bottom="0.04in" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="LineBlueCell" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#D2DFEF" fo:padding-left="0.08in" fo:padding-right="0.05in" fo:padding-top="0.03in" fo:padding-bottom="0.03in"/>
    </style:style>
    <style:style style:name="LineWhiteCell" style:family="table-cell">
      <style:table-cell-properties fo:padding-left="0.08in" fo:padding-right="0.05in" fo:padding-top="0.03in" fo:padding-bottom="0.03in"/>
    </style:style>
    <style:style style:name="LineRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.34in"/>
    </style:style>
    <style:style style:name="GapRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.23in"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout">
      <style:footer>
        <text:p text:style-name="Footer">OnlineBiller | Original English resource | Blank template</text:p>
      </style:footer>
    </style:master-page>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">Purchase Order</text:p>
      <text:p text:style-name="Subtitle">BLANK TEMPLATE | Currency: INR</text:p>
      <table:table table:name="OrderDetails" table:style-name="InfoTable">
        <table:table-column table:style-name="InfoColA"/>
        <table:table-column table:style-name="InfoColB"/>
        <table:table-row table:style-name="InfoRowWhite">
          <table:table-cell table:style-name="InfoCell"><text:p text:style-name="FieldLabel">Buyer</text:p></table:table-cell>
          <table:table-cell table:style-name="InfoCell"><text:p text:style-name="FieldLine">____________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InfoRowBlue">
          <table:table-cell table:style-name="InfoCell"><text:p text:style-name="FieldLabel">Supplier</text:p></table:table-cell>
          <table:table-cell table:style-name="InfoCell"><text:p text:style-name="FieldLine">____________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InfoRowWhite">
          <table:table-cell table:style-name="InfoCell"><text:p text:style-name="FieldLabel">PO / date</text:p></table:table-cell>
          <table:table-cell table:style-name="InfoCell"><text:p text:style-name="FieldLine">____________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InfoRowBlue">
          <table:table-cell table:style-name="InfoCell"><text:p text:style-name="FieldLabel">Quote reference</text:p></table:table-cell>
          <table:table-cell table:style-name="InfoCell"><text:p text:style-name="FieldLine">____________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InfoRowWhite">
          <table:table-cell table:style-name="InfoCell"><text:p text:style-name="FieldLabel">Requested delivery</text:p></table:table-cell>
          <table:table-cell table:style-name="InfoCell"><text:p text:style-name="FieldLine">____________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InfoRowBlue">
          <table:table-cell table:style-name="InfoCell"><text:p text:style-name="FieldLabel">Ship to</text:p></table:table-cell>
          <table:table-cell table:style-name="InfoCell"><text:p text:style-name="FieldLine">____________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InfoRowWhite">
          <table:table-cell table:style-name="InfoCell"><text:p text:style-name="FieldLabel">Payment terms</text:p></table:table-cell>
          <table:table-cell table:style-name="InfoCell"><text:p text:style-name="FieldLine">____________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InfoRowBlue">
          <table:table-cell table:style-name="InfoCell"><text:p text:style-name="FieldLabel">Authorized buyer</text:p></table:table-cell>
          <table:table-cell table:style-name="InfoCell"><text:p text:style-name="FieldLine">____________________________________</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="SpaceAfterInfo"/>
      <table:table table:name="OrderLines" table:style-name="LineTable">
        <table:table-column table:style-name="LineCol1"/>
        <table:table-column table:style-name="LineCol2"/>
        <table:table-column table:style-name="LineCol3"/>
        <table:table-column table:style-name="LineCol4"/>
        <table:table-row>
          <table:table-cell table:style-name="LineHeaderCell"><text:p text:style-name="TableHead">Description</text:p></table:table-cell>
          <table:table-cell table:style-name="LineHeaderCell"><text:p text:style-name="TableHead">Quantity</text:p></table:table-cell>
          <table:table-cell table:style-name="LineHeaderCell"><text:p text:style-name="TableHead">Rate (INR)</text:p></table:table-cell>
          <table:table-cell table:style-name="LineHeaderCell"><text:p text:style-name="TableHead">Amount (INR)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="LineRow">
          <table:table-cell table:style-name="LineBlueCell"/>
          <table:table-cell table:style-name="LineBlueCell"/>
          <table:table-cell table:style-name="LineBlueCell"/>
          <table:table-cell table:style-name="LineBlueCell"/>
        </table:table-row>
        <table:table-row table:style-name="GapRow">
          <table:table-cell table:style-name="LineWhiteCell"/>
          <table:table-cell table:style-name="LineWhiteCell"/>
          <table:table-cell table:style-name="LineWhiteCell"/>
          <table:table-cell table:style-name="LineWhiteCell"/>
        </table:table-row>
        <table:table-row table:style-name="LineRow">
          <table:table-cell table:style-name="LineBlueCell"/>
          <table:table-cell table:style-name="LineBlueCell"/>
          <table:table-cell table:style-name="LineBlueCell"/>
          <table:table-cell table:style-name="LineBlueCell"/>
        </table:table-row>
        <table:table-row table:style-name="GapRow">
          <table:table-cell table:style-name="LineWhiteCell"/>
          <table:table-cell table:style-name="LineWhiteCell"/>
          <table:table-cell table:style-name="LineWhiteCell"/>
          <table:table-cell table:style-name="LineWhiteCell"/>
        </table:table-row>
        <table:table-row table:style-name="LineRow">
          <table:table-cell table:style-name="LineBlueCell"/>
          <table:table-cell table:style-name="LineBlueCell"/>
          <table:table-cell table:style-name="LineBlueCell"/>
          <table:table-cell table:style-name="LineBlueCell"/>
        </table:table-row>
        <table:table-row table:style-name="GapRow">
          <table:table-cell table:style-name="LineWhiteCell"/>
          <table:table-cell table:style-name="LineWhiteCell"/>
          <table:table-cell table:style-name="LineWhiteCell"/>
          <table:table-cell table:style-name="LineWhiteCell"/>
        </table:table-row>
        <table:table-row table:style-name="LineRow">
          <table:table-cell table:style-name="LineBlueCell"/>
          <table:table-cell table:style-name="LineBlueCell"/>
          <table:table-cell table:style-name="LineBlueCell"/>
          <table:table-cell table:style-name="LineBlueCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LineHeaderCell" table:number-columns-spanned="4"><text:p/></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Total"><text:span text:style-name="Bold">Subtotal:</text:span> INR __________</text:p>
      <text:p text:style-name="Total"><text:span text:style-name="Bold">Order value:</text:span> INR __________</text:p>
      <text:p text:style-name="Note">Buyer-issued order example; not a supplier invoice or payment receipt.</text:p>
      <text:p text:style-name="Note">No inventory, supplier approval or tax classification is performed.</text:p>
      <text:p text:style-name="Note">Word amounts are manual. Check line amounts and totals after every edit.</text:p>
    </office:text>
  </office:body>
</office:document>