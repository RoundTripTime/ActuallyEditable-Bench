          <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered"><text:span fo:color="#999999">(　　　)</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCell"><text:p text:style-name="Centered">③　법정모자가정</text:p></table:table-cell>
