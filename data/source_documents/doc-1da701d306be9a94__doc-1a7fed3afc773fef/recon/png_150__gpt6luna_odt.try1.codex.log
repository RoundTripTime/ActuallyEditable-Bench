          <table:table-cell table:style-name="Cell"><text:p text:style-name="Centered"><text:span fo:color="#999999">(　　　)</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="SmallCell" table:number-columns-spanned="2"><text:p text:style-name="Centered">②　1958년　이전　출생자</text:p></table:table-cell>
