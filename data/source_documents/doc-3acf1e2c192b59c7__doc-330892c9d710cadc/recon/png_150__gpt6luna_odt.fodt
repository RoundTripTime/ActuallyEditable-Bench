<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
    </style:default-style>
  </office:styles>
  <office:automatic-styles>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="CellText" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.08cm" fo:margin-right="0.08cm"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="TableTop" style:family="table">
      <style:table-properties style:width="15.4cm" table:align="center"/>
    </style:style>
    <style:style style:name="TableBudget" style:family="table">
      <style:table-properties style:width="17.2cm" table:align="center"/>
    </style:style>
    <style:style style:name="TableMap" style:family="table">
      <style:table-properties style:width="17.2cm" table:align="center"/>
    </style:style>
    <style:style style:name="TopC1" style:family="table-column">
      <style:table-column-properties style:column-width="2.6cm"/>
    </style:style>
    <style:style style:name="TopC2" style:family="table-column">
      <style:table-column-properties style:column-width="7.3cm"/>
    </style:style>
    <style:style style:name="TopC3" style:family="table-column">
      <style:table-column-properties style:column-width="2.1cm"/>
    </style:style>
    <style:style style:name="TopC4" style:family="table-column">
      <style:table-column-properties style:column-width="3.4cm"/>
    </style:style>
    <style:style style:name="BudgetC1" style:family="table-column">
      <style:table-column-properties style:column-width="1.25cm"/>
    </style:style>
    <style:style style:name="BudgetC2" style:family="table-column">
      <style:table-column-properties style:column-width="4.55cm"/>
    </style:style>
    <style:style style:name="BudgetC3" style:family="table-column">
      <style:table-column-properties style:column-width="1.9cm"/>
    </style:style>
    <style:style style:name="BudgetC4" style:family="table-column">
      <style:table-column-properties style:column-width="2.8cm"/>
    </style:style>
    <style:style style:name="BudgetC5" style:family="table-column">
      <style:table-column-properties style:column-width="2.8cm"/>
    </style:style>
    <style:style style:name="BudgetC6" style:family="table-column">
      <style:table-column-properties style:column-width="3.9cm"/>
    </style:style>
    <style:style style:name="MapC1" style:family="table-column">
      <style:table-column-properties style:column-width="17.2cm"/>
    </style:style>
    <style:style style:name="BorderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.05cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="MapCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0.12cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="DiagCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.05cm" style:vertical-align="middle" style:diagonal-tl-br="0.5pt solid #000000"/>
    </style:style>
    <style:style style:name="TopTitle" style:family="table-row">
      <style:table-row-properties style:row-height="0.65cm"/>
    </style:style>
    <style:style style:name="TopIdentity" style:family="table-row">
      <style:table-row-properties style:row-height="1.55cm"/>
    </style:style>
    <style:style style:name="TopPurpose" style:family="table-row">
      <style:table-row-properties style:row-height="2.55cm"/>
    </style:style>
    <style:style style:name="TopLocation" style:family="table-row">
      <style:table-row-properties style:row-height="0.8cm"/>
    </style:style>
    <style:style style:name="TopSchedule" style:family="table-row">
      <style:table-row-properties style:row-height="0.8cm"/>
    </style:style>
    <style:style style:name="BudgetHeader" style:family="table-row">
      <style:table-row-properties style:row-height="0.65cm"/>
    </style:style>
    <style:style style:name="BudgetTree" style:family="table-row">
      <style:table-row-properties style:row-height="0.65cm"/>
    </style:style>
    <style:style style:name="BudgetMaterial" style:family="table-row">
      <style:table-row-properties style:row-height="0.65cm"/>
    </style:style>
    <style:style style:name="BudgetOther" style:family="table-row">
      <style:table-row-properties style:row-height="0.65cm"/>
    </style:style>
    <style:style style:name="BudgetTotal" style:family="table-row">
      <style:table-row-properties style:row-height="0.65cm"/>
    </style:style>
    <style:style style:name="MapRow" style:family="table-row">
      <style:table-row-properties style:row-height="5.0cm"/>
    </style:style>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="1.8cm" fo:margin-bottom="1.8cm" fo:margin-left="1.4cm" fo:margin-right="1.4cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p style-name="Right">令和　　年　　月　日提出</text:p>
      <text:p/>
      <table:table table:name="Application" table:style-name="TableTop">
        <table:table-column table:style-name="TopC1"/>
        <table:table-column table:style-name="TopC2"/>
        <table:table-column table:style-name="TopC3"/>
        <table:table-column table:style-name="TopC4"/>
        <table:table-row table:style-name="TopTitle">
          <table:table-cell table:style-name="BorderCell"><text:p style-name="CellText">令和</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell" table:number-columns-spanned="3"><text:p style-name="CellText">年度みやき町緑の郷土づくり運動事業実施要望申請書</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="TopIdentity">
          <table:table-cell table:style-name="BorderCell"><text:p style-name="CellText">地区名</text:p><text:p style-name="CellText">代表者名</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell" table:number-columns-spanned="3"><text:p style-name="Right">印</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="TopPurpose">
          <table:table-cell table:style-name="BorderCell"><text:p style-name="CellText">事業内容</text:p><text:p style-name="CellText">及び目的</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell" table:number-columns-spanned="3"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="TopLocation">
          <table:table-cell table:style-name="BorderCell"><text:p style-name="CellText">実施場所</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"><text:p style-name="CellText">面積</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p style-name="Right">m²</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="TopSchedule">
          <table:table-cell table:style-name="BorderCell"><text:p style-name="CellText">実施予定時期</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell" table:number-columns-spanned="3"><text:p style-name="Center">令和　　年　　月頃</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p>【植樹予定樹種及び支出見込額】</text:p>
      <table:table table:name="CostEstimate" table:style-name="TableBudget">
        <table:table-column table:style-name="BudgetC1"/>
        <table:table-column table:style-name="BudgetC2"/>
        <table:table-column table:style-name="BudgetC3"/>
        <table:table-column table:style-name="BudgetC4"/>
        <table:table-column table:style-name="BudgetC5"/>
        <table:table-column table:style-name="BudgetC6"/>
        <table:table-row table:style-name="BudgetHeader">
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"><text:p style-name="CellText">名　称（種類）</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p style-name="CellText">数量</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p style-name="CellText">単価</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p style-name="CellText">予算額</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell"><text:p style-name="CellText">備考</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="BudgetTree">
          <table:table-cell table:style-name="BorderCell" table:number-rows-spanned="3"><text:p style-name="CellCenter">樹<text:line-break/>種<text:line-break/>名</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"><text:p style-name="Right">本</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"><text:p style-name="CellText">高さ＝　　　　m</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="BudgetTree">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"><text:p style-name="Right">本</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"><text:p style-name="CellText">高さ＝　　　　m</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="BudgetTree">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"><text:p style-name="Right">本</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"><text:p style-name="CellText">高さ＝　　　　m</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="BudgetMaterial">
          <table:table-cell table:style-name="BorderCell" table:number-rows-spanned="5"><text:p style-name="CellCenter">原<text:line-break/>材<text:line-break/>料<text:line-break/>費</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
        </table:table-row>
        <table:table-row table:style-name="BudgetMaterial">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
        </table:table-row>
        <table:table-row table:style-name="BudgetMaterial">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
        </table:table-row>
        <table:table-row table:style-name="BudgetMaterial">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
        </table:table-row>
        <table:table-row table:style-name="BudgetMaterial">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
        </table:table-row>
        <table:table-row table:style-name="BudgetOther">
          <table:table-cell table:style-name="BorderCell" table:number-rows-spanned="3"><text:p style-name="CellCenter">そ<text:line-break/>の<text:line-break/>他</text:p></table:table-cell>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
        </table:table-row>
        <table:table-row table:style-name="BudgetOther">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
        </table:table-row>
        <table:table-row table:style-name="BudgetOther">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
          <table:table-cell table:style-name="BorderCell"/>
        </table:table-row>
        <table:table-row table:style-name="BudgetTotal">
          <table:table-cell table:style-name="BorderCell" table:number-columns-spanned="2"><text:p style-name="CellText">計</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="DiagCell"/>
          <table:table-cell table:style-name="DiagCell"/>
          <table:table-cell table:style-name="BorderCell"><text:p style-name="Right">円</text:p></table:table-cell>
          <table:table-cell table:style-name="DiagCell"/>
        </table:table-row>
      </table:table>
      <table:table table:name="LocationMap" table:style-name="TableMap">
        <table:table-column table:style-name="MapC1"/>
        <table:table-row table:style-name="MapRow">
          <table:table-cell table:style-name="MapCell"><text:p style-name="CellText">【実施場所位置図】</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p>【必要書類】</text:p>
      <text:p>　　樹種及び原材料費等の見積書</text:p>
    </office:text>
  </office:body>
</office:document>