<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="0.55cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt" fo:color="#000000"/>
    </style:default-style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="0.55cm"/>
    </style:style>
    <style:style style:name="BodyText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="0.62cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="CenterTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="0.8cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="16pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="SpacerShort" style:family="paragraph">
      <style:paragraph-properties fo:line-height="0.65cm" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="SpacerMedium" style:family="paragraph">
      <style:paragraph-properties fo:line-height="1.0cm" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="SpacerLarge" style:family="paragraph">
      <style:paragraph-properties fo:line-height="1.5cm" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-left="2.5cm" fo:margin-right="2.5cm" fo:margin-top="1.4cm" fo:margin-bottom="2cm"/>
    </style:page-layout>
    <style:style style:name="FullTable" style:family="table">
      <style:table-properties style:width="16cm" table:align="margins"/>
    </style:style>
    <style:style style:name="ColWide" style:family="table-column">
      <style:table-column-properties style:column-width="5.5cm"/>
    </style:style>
    <style:style style:name="ColBodyIndent" style:family="table-column">
      <style:table-column-properties style:column-width="1.1cm"/>
    </style:style>
    <style:style style:name="ColBodyText" style:family="table-column">
      <style:table-column-properties style:column-width="14.9cm"/>
    </style:style>
    <style:style style:name="SigCol1" style:family="table-column">
      <style:table-column-properties style:column-width="9cm"/>
    </style:style>
    <style:style style:name="SigCol2" style:family="table-column">
      <style:table-column-properties style:column-width="1.4cm"/>
    </style:style>
    <style:style style:name="SigCol3" style:family="table-column">
      <style:table-column-properties style:column-width="2.3cm"/>
    </style:style>
    <style:style style:name="SigCol4" style:family="table-column">
      <style:table-column-properties style:column-width="3.3cm"/>
    </style:style>
    <style:style style:name="PlainCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="LeftPara" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="0.55cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="RightPara" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="0.55cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="CenterPara" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="0.55cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
    <style:style style:name="BodyCellPara" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="0.62cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt" fo:color="#000000"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <table:table table:name="Header" table:style-name="FullTable">
        <table:table-column table:style-name="ColWide"/>
        <table:table-column table:style-name="ColWide"/>
        <table:table-column table:style-name="ColWide"/>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell">
            <text:p text:style-name="PageStart">別記様式第２号</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="PlainCell">
            <text:p text:style-name="LeftPara"/>
          </table:table-cell>
          <table:table-cell table:style-name="PlainCell" table:number-columns-spanned="2">
            <text:p text:style-name="RightPara">年　　月　　日</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="SpacerShort"/>
      <text:p text:style-name="LeftPara">中標津町長　様</text:p>
      <text:p text:style-name="SpacerLarge"/>
      <text:p text:style-name="CenterTitle">誓　約　書</text:p>
      <text:p text:style-name="SpacerLarge"/>
      <text:p text:style-name="SpacerMedium"/>
      <table:table table:name="Declaration" table:style-name="FullTable">
        <table:table-column table:style-name="ColBodyIndent"/>
        <table:table-column table:style-name="ColBodyText"/>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell"/>
          <table:table-cell table:style-name="PlainCell">
            <text:p text:style-name="BodyCellPara">年度、中標津町狩猟免許新規取得等補助金の交付を受けるにあたり、狩猟者登録を</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell" table:number-columns-spanned="2">
            <text:p text:style-name="BodyCellPara">受けた年度の翌年度から３年間、中標津町鳥獣被害対策実施隊に所属し、有害鳥獣の捕獲</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell" table:number-columns-spanned="2">
            <text:p text:style-name="BodyCellPara">対策事業に関する業務に従事することを誓約します。</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="SpacerLarge"/>
      <text:p text:style-name="SpacerMedium"/>
      <table:table table:name="Signature" table:style-name="FullTable">
        <table:table-column table:style-name="SigCol1"/>
        <table:table-column table:style-name="SigCol2"/>
        <table:table-column table:style-name="SigCol3"/>
        <table:table-column table:style-name="SigCol4"/>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell" table:number-columns-spanned="3">
            <text:p text:style-name="LeftPara"/>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="PlainCell">
            <text:p text:style-name="CenterPara">住　所</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell">
            <text:p text:style-name="LeftPara"/>
          </table:table-cell>
          <table:table-cell table:style-name="PlainCell" table:number-columns-spanned="2">
            <text:p text:style-name="CenterPara">氏　名</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="PlainCell">
            <text:p text:style-name="CenterPara">㊞</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>