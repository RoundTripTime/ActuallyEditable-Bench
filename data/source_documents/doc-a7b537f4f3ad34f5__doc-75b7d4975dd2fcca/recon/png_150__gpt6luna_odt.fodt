<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.42cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="11pt" style:font-name="Liberation Sans"/>
    </style:default-style>
    <style:style style:name="InvoiceTitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.42cm"/>
      <style:text-properties fo:font-size="11pt" style:font-name="Liberation Sans"/>
    </style:style>
    <style:style style:name="InvoiceSubtitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.55cm"/>
      <style:text-properties fo:font-size="11pt" style:font-name="Liberation Sans"/>
    </style:style>
    <style:style style:name="InvoiceBody" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.48cm"/>
      <style:text-properties fo:font-size="11pt" style:font-name="Liberation Sans"/>
    </style:style>
    <style:style style:name="InvoiceInstructions" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-size="11pt" style:font-name="Liberation Sans"/>
    </style:style>
    <style:style style:name="InvoiceTableHeader" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt" style:font-name="Liberation Sans"/>
    </style:style>
    <style:style style:name="InvoiceTableText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt" style:font-name="Liberation Sans"/>
    </style:style>
    <style:style style:name="InvoiceFootnote" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.48cm"/>
      <style:text-properties fo:font-size="11pt" style:font-name="Liberation Sans"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="InvoicePageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.7cm" fo:margin-bottom="1.7cm" fo:margin-left="1.25cm" fo:margin-right="1.25cm"/>
    </style:page-layout>
    <style:style style:name="InvoiceTable" style:family="table">
      <style:table-properties style:width="12.2cm" table:align="left" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="InvoiceColumn1" style:family="table-column">
      <style:table-column-properties style:column-width="1.95cm"/>
    </style:style>
    <style:style style:name="InvoiceColumn2" style:family="table-column">
      <style:table-column-properties style:column-width="1.4cm"/>
    </style:style>
    <style:style style:name="InvoiceColumn3" style:family="table-column">
      <style:table-column-properties style:column-width="2.3cm"/>
    </style:style>
    <style:style style:name="InvoiceColumn4" style:family="table-column">
      <style:table-column-properties style:column-width="1.3cm"/>
    </style:style>
    <style:style style:name="InvoiceColumn5" style:family="table-column">
      <style:table-column-properties style:column-width="1.65cm"/>
    </style:style>
    <style:style style:name="InvoiceColumn6" style:family="table-column">
      <style:table-column-properties style:column-width="1.8cm"/>
    </style:style>
    <style:style style:name="InvoiceColumn7" style:family="table-column">
      <style:table-column-properties style:column-width="1.8cm"/>
    </style:style>
    <style:style style:name="InvoiceTableRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.96cm"/>
    </style:style>
    <style:style style:name="InvoiceTableCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #c8d3e0" fo:padding="0.03cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="InvoiceTableHeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #c8d3e0" fo:padding="0.03cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="InvoiceTotalsCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #c8d3e0" fo:padding="0.03cm" style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="InvoiceMasterPage" style:page-layout-name="InvoicePageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="InvoiceTitle">FACTURE</text:p>
      <text:p text:style-name="InvoiceSubtitle">MODÈLE VIERGE — À COMPLÉTER</text:p>
      <text:p text:style-name="InvoiceBody">Émetteur : À compléter</text:p>
      <text:p text:style-name="InvoiceBody">Adresse émetteur : À compléter</text:p>
      <text:p text:style-name="InvoiceBody">ICE / IF / RC (selon situation) : À compléter</text:p>
      <text:p text:style-name="InvoiceBody">Client : À compléter</text:p>
      <text:p text:style-name="InvoiceBody">Adresse et ICE client : À compléter</text:p>
      <text:p text:style-name="InvoiceBody">Numéro / Date : À compléter dans votre série</text:p>
      <text:p text:style-name="InvoiceBody">Référence devis / commande : À compléter si applicable</text:p>
      <text:p text:style-name="InvoiceInstructions">Instructions : Remplacez les exemples, choisissez la TVA applicable et vérifiez la numérotation.</text:p>
      <table:table table:name="InvoiceItems" table:style-name="InvoiceTable">
        <table:table-column table:style-name="InvoiceColumn1"/>
        <table:table-column table:style-name="InvoiceColumn2"/>
        <table:table-column table:style-name="InvoiceColumn3"/>
        <table:table-column table:style-name="InvoiceColumn4"/>
        <table:table-column table:style-name="InvoiceColumn5"/>
        <table:table-column table:style-name="InvoiceColumn6"/>
        <table:table-column table:style-name="InvoiceColumn7"/>
        <table:table-row table:style-name="InvoiceTableRow">
          <table:table-cell table:style-name="InvoiceTableHeaderCell"><text:p text:style-name="InvoiceTableHeader">Désignation</text:p></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableHeaderCell"><text:p text:style-name="InvoiceTableHeader">Quantité</text:p></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableHeaderCell"><text:p text:style-name="InvoiceTableHeader">P.U. HT (MAD)</text:p></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableHeaderCell"><text:p text:style-name="InvoiceTableHeader">TVA (%)</text:p></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableHeaderCell"><text:p text:style-name="InvoiceTableHeader">HT (MAD)</text:p></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableHeaderCell"><text:p text:style-name="InvoiceTableHeader">TVA (MAD)</text:p></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableHeaderCell"><text:p text:style-name="InvoiceTableHeader">TTC (MAD)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InvoiceTableRow">
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InvoiceTableRow">
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InvoiceTableRow">
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InvoiceTableRow">
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InvoiceTableRow">
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTableCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InvoiceTableRow">
          <table:table-cell table:style-name="InvoiceTotalsCell"><text:p text:style-name="InvoiceTableText">TOTAUX</text:p></table:table-cell>
          <table:table-cell table:style-name="InvoiceTotalsCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTotalsCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTotalsCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTotalsCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTotalsCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
          <table:table-cell table:style-name="InvoiceTotalsCell"><text:p text:style-name="InvoiceTableText"/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="InvoiceFootnote">Conditions / mentions complémentaires : À compléter selon votre activité et l’opération.</text:p>
      <text:p text:style-name="InvoiceFootnote">TVA de 20 % utilisée uniquement pour illustrer le calcul ; aucun taux n’est présumé applicable.</text:p>
      <text:p text:style-name="InvoiceFootnote">Vérifiez les mentions applicables avant utilisation.</text:p>
      <text:p text:style-name="InvoiceFootnote">Modèle gratuit FactureGo — https://facturego.ma/modele-facture-ice-gratuit</text:p>
    </office:text>
  </office:body>
</office:document>