<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
 xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
 office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
 <office:styles>
  <style:default-style style:family="paragraph">
   <style:paragraph-properties fo:margin="0cm" fo:line-height="100%"/>
   <style:text-properties fo:font-size="12pt"/>
  </style:default-style>
  <style:style style:name="Body" style:family="paragraph">
   <style:paragraph-properties fo:margin="0cm" fo:line-height="100%"/>
   <style:text-properties fo:font-size="12pt"/>
  </style:style>
 </office:styles>
 <office:automatic-styles>
  <style:page-layout style:name="PageLayout">
   <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="1.8cm" fo:margin-bottom="1.8cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
  </style:page-layout>
  <style:style style:name="Title" style:family="paragraph">
   <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="1.25cm" fo:break-before="page"/>
   <style:text-properties fo:font-size="20pt"/>
  </style:style>
  <style:style style:name="Small" style:family="paragraph">
   <style:paragraph-properties fo:margin="0cm" fo:line-height="100%"/>
   <style:text-properties fo:font-size="11pt"/>
  </style:style>
  <style:style style:name="Centered" style:family="paragraph">
   <style:paragraph-properties fo:text-align="center" fo:margin="0cm"/>
   <style:text-properties fo:font-size="11pt"/>
  </style:style>
  <style:style style:name="Notice" style:family="paragraph">
   <style:paragraph-properties fo:margin-top="1.05cm" fo:margin-bottom="0.7cm" fo:line-height="140%"/>
   <style:text-properties fo:font-size="11pt"/>
  </style:style>
  <style:style style:name="Blue" style:family="text">
   <style:text-properties fo:color="#0000ff"/>
  </style:style>
  <style:style style:name="Red" style:family="text">
   <style:text-properties fo:color="#ff0000"/>
  </style:style>
  <style:style style:name="FamCol1" style:family="table-column">
   <style:table-column-properties fo:column-width="6.7cm"/>
  </style:style>
  <style:style style:name="FamCol2" style:family="table-column">
   <style:table-column-properties fo:column-width="1.6cm"/>
  </style:style>
  <style:style style:name="FamCol3" style:family="table-column">
   <style:table-column-properties fo:column-width="8.7cm"/>
  </style:style>
  <style:style style:name="FamRow" style:family="table-row">
   <style:table-row-properties style:min-row-height="1.2cm"/>
  </style:style>
  <style:style style:name="PlainCell" style:family="table-cell">
   <style:table-cell-properties style:vertical-align="middle" fo:padding="0.04cm"/>
  </style:style>
  <style:style style:name="TreeBranch" style:family="table-cell">
   <style:table-cell-properties style:vertical-align="middle" fo:border-left="0.5pt solid #000000" fo:border-top="0.5pt solid #000000"/>
  </style:style>
  <style:style style:name="OpenCell" style:family="table-cell">
   <style:table-cell-properties style:vertical-align="middle" fo:padding="0.08cm" fo:border="none"/>
  </style:style>
  <style:style style:name="SealCell" style:family="table-cell">
   <style:table-cell-properties style:vertical-align="middle" fo:border="0.75pt solid #000000" fo:padding="0.1cm"/>
  </style:style>
  <style:style style:name="BottomColA" style:family="table-column">
   <style:table-column-properties fo:column-width="7.6cm"/>
  </style:style>
  <style:style style:name="BottomColB" style:family="table-column">
   <style:table-column-properties fo:column-width="3.2cm"/>
  </style:style>
  <style:style style:name="BottomColC" style:family="table-column">
   <style:table-column-properties fo:column-width="3.5cm"/>
  </style:style>
  <style:style style:name="BottomColD" style:family="table-column">
   <style:table-column-properties fo:column-width="2.7cm"/>
  </style:style>
  <style:style style:name="BottomColE" style:family="table-column">
   <style:table-column-properties fo:column-width="0.9cm"/>
  </style:style>
  <style:style style:name="DateColA" style:family="table-column">
   <style:table-column-properties fo:column-width="2.8cm"/>
  </style:style>
  <style:style style:name="DateColB" style:family="table-column">
   <style:table-column-properties fo:column-width="4.1cm"/>
  </style:style>
  <style:style style:name="DateColC" style:family="table-column">
   <style:table-column-properties fo:column-width="5.2cm"/>
  </style:style>
  <style:style style:name="DateColD" style:family="table-column">
   <style:table-column-properties fo:column-width="3cm"/>
  </style:style>
  <style:style style:name="FootColA" style:family="table-column">
   <style:table-column-properties fo:column-width="5.1cm"/>
  </style:style>
  <style:style style:name="FootColB" style:family="table-column">
   <style:table-column-properties fo:column-width="5.1cm"/>
  </style:style>
  <style:style style:name="FootColC" style:family="table-column">
   <style:table-column-properties fo:column-width="4.9cm"/>
  </style:style>
 </office:automatic-styles>
 <office:master-styles>
  <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
 </office:master-styles>
 <office:body>
  <office:text>
   <text:p text:style-name="Title">繼承系統表</text:p>
   <table:table table:name="Family">
    <table:table-column table:style-name="FamCol1"/>
    <table:table-column table:style-name="FamCol2"/>
    <table:table-column table:style-name="FamCol3"/>
    <table:table-row table:style-name="FamRow">
     <table:table-cell table:style-name="PlainCell" table:number-rows-spanned="4">
      <text:p text:style-name="Body">被繼承人：</text:p>
      <text:p text:style-name="Body">民國　年　月　日死亡</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="TreeBranch"><text:p text:style-name="Body"/></table:table-cell>
     <table:table-cell table:style-name="PlainCell">
      <text:p text:style-name="Body"><text:span text:style-name="Blue">長子</text:span></text:p>
      <text:p text:style-name="Body">民國　年　月　日出生</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="FamRow">
     <table:covered-table-cell/>
     <table:table-cell table:style-name="TreeBranch"><text:p text:style-name="Body"/></table:table-cell>
     <table:table-cell table:style-name="PlainCell">
      <text:p text:style-name="Body"><text:span text:style-name="Blue">次子</text:span></text:p>
      <text:p text:style-name="Body">民國　年　月　日出生</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="FamRow">
     <table:covered-table-cell/>
     <table:table-cell table:style-name="TreeBranch"><text:p text:style-name="Body"/></table:table-cell>
     <table:table-cell table:style-name="PlainCell">
      <text:p text:style-name="Body"><text:span text:style-name="Blue">三子</text:span></text:p>
      <text:p text:style-name="Body">民國　年　月　日出生</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="FamRow">
     <table:covered-table-cell/>
     <table:table-cell table:style-name="TreeBranch"><text:p text:style-name="Body"/></table:table-cell>
     <table:table-cell table:style-name="PlainCell">
      <text:p text:style-name="Body"><text:span text:style-name="Blue">四子</text:span></text:p>
      <text:p text:style-name="Body">民國　年　月　日出生</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="FamRow">
     <table:table-cell table:style-name="PlainCell" table:number-rows-spanned="6">
      <text:p text:style-name="Body">配偶：</text:p>
      <text:p text:style-name="Body">民國　年　月　日出生</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="TreeBranch"><text:p text:style-name="Body"/></table:table-cell>
     <table:table-cell table:style-name="PlainCell">
      <text:p text:style-name="Body"><text:span text:style-name="Blue">五子</text:span></text:p>
      <text:p text:style-name="Body">民國　年　月　日出生</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="FamRow">
     <table:covered-table-cell/>
     <table:table-cell table:style-name="TreeBranch"><text:p text:style-name="Body"/></table:table-cell>
     <table:table-cell table:style-name="PlainCell">
      <text:p text:style-name="Body"><text:span text:style-name="Red">長女</text:span></text:p>
      <text:p text:style-name="Body">民國　年　月　日出生</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="FamRow">
     <table:covered-table-cell/>
     <table:table-cell table:style-name="TreeBranch"><text:p text:style-name="Body"/></table:table-cell>
     <table:table-cell table:style-name="PlainCell">
      <text:p text:style-name="Body"><text:span text:style-name="Red">次女</text:span></text:p>
      <text:p text:style-name="Body">民國　年　月　日出生</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="FamRow">
     <table:covered-table-cell/>
     <table:table-cell table:style-name="TreeBranch"><text:p text:style-name="Body"/></table:table-cell>
     <table:table-cell table:style-name="PlainCell">
      <text:p text:style-name="Body"><text:span text:style-name="Red">三女</text:span></text:p>
      <text:p text:style-name="Body">民國　年　月　日出生</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="FamRow">
     <table:covered-table-cell/>
     <table:table-cell table:style-name="TreeBranch"><text:p text:style-name="Body"/></table:table-cell>
     <table:table-cell table:style-name="PlainCell">
      <text:p text:style-name="Body"><text:span text:style-name="Red">四女</text:span></text:p>
      <text:p text:style-name="Body">民國　年　月　日出生</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="FamRow">
     <table:covered-table-cell/>
     <table:table-cell table:style-name="TreeBranch"><text:p text:style-name="Body"/></table:table-cell>
     <table:table-cell table:style-name="PlainCell">
      <text:p text:style-name="Body"><text:span text:style-name="Red">五女</text:span></text:p>
      <text:p text:style-name="Body">民國　年　月　日出生</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="Notice">上繼承系統表係依民法第一一三八條至第一一四○條規定訂立，如有遺漏或錯誤，致他人受損害者，申請人願負法律責任。</text:p>
   <table:table table:name="Applicant">
    <table:table-column table:style-name="BottomColA"/>
    <table:table-column table:style-name="BottomColB"/>
    <table:table-column table:style-name="BottomColC"/>
    <table:table-column table:style-name="BottomColD"/>
    <table:table-column table:style-name="BottomColE"/>
    <table:table-row>
     <table:table-cell table:style-name="OpenCell"><text:p text:style-name="Body"/></table:table-cell>
     <table:table-cell table:style-name="OpenCell"><text:p text:style-name="Body">申請人（繼承人）：</text:p></table:table-cell>
     <table:table-cell table:style-name="OpenCell"><text:p text:style-name="Body">蓋章</text:p></table:table-cell>
     <table:table-cell table:style-name="SealCell"><text:p text:style-name="Body"/></table:table-cell>
     <table:table-cell table:style-name="OpenCell"><text:p text:style-name="Body"/></table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="Body"/>
   <text:p text:style-name="Body"/>
   <table:table table:name="DateLine">
    <table:table-column table:style-name="DateColA"/>
    <table:table-column table:style-name="DateColB"/>
    <table:table-column table:style-name="DateColC"/>
    <table:table-column table:style-name="DateColD"/>
    <table:table-row>
     <table:table-cell table:style-name="OpenCell"><text:p text:style-name="Body">中　華　民　國</text:p></table:table-cell>
     <table:table-cell table:style-name="OpenCell"><text:p text:style-name="Body">年</text:p></table:table-cell>
     <table:table-cell table:style-name="OpenCell"><text:p text:style-name="Body">月</text:p></table:table-cell>
     <table:table-cell table:style-name="OpenCell"><text:p text:style-name="Body">日</text:p></table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="Centered">（民）財非公 03-（民）表四</text:p>
  </office:text>
 </office:body>
</office:document>