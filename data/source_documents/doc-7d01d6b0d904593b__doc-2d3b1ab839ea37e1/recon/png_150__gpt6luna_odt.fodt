<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="8pt" style:font-size-asian="8pt"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="8pt" style:font-size-asian="8pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="8pt" style:font-size-asian="8pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-size="18pt" style:font-size-asian="18pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="7pt" style:font-size-asian="7pt"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HeavyCell" style:family="table-cell">
      <style:table-cell-properties fo:border="1.2pt solid #000000" fo:padding="0.05cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Column" style:family="table-column">
      <style:table-column-properties style:use-optimal-column-width="true"/>
    </style:style>
    <style:style style:name="Table" style:family="table">
      <style:table-properties style:width="100%" table:border-model="collapsing"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="0.8cm" fo:margin-bottom="0.8cm" fo:margin-left="1cm" fo:margin-right="1cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">罹災証明申請書</text:p>
      <text:p text:style-name="Body">（あて先）富里市長　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　年　　　月　　　日</text:p>

      <table:table table:name="申請者情報" table:style-name="Table">
        <table:table-column table:style-name="Column" table:number-columns-repeated="6"/>
        <table:table-row>
          <table:table-cell table:style-name="HeavyCell" table:number-rows-spanned="2"><text:p text:style-name="Center">申請者情報</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">住 所</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Body"/></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">氏 名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">世帯主との関係</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Body">□ 本人　 □同一世帯の親族　 □その他※（　　　　）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeavyCell"><text:p text:style-name="Center">世帯主情報</text:p><text:p text:style-name="Small">（申請者と同じ場合記載不要）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">住 所</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Body"/></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">氏 名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeavyCell"><text:p text:style-name="Center">受取方法</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">受取方法</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Body">□ 郵送（申請者住所）</text:p><text:p text:style-name="Body">□ 市役所窓口</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">連絡先</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell>
        </table:table-row>
      </table:table>

      <table:table table:name="世帯構成員" table:style-name="Table">
        <table:table-column table:style-name="Column" table:number-columns-repeated="4"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="5"><text:p text:style-name="Center">世帯構成員</text:p><text:p text:style-name="Center">（世帯主以外）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">氏 名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">続 柄</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">備 考</text:p></table:table-cell>
        </table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Center">世帯主</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell></table:table-row>
        <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Body"/></table:table-cell></table:table-row>
      </table:table>

      <text:p text:style-name="Body">※その他の場合、委任状（任意様式）が必要</text:p>

      <table:table table:name="罹災原因" table:style-name="Table">
        <table:table-column table:style-name="Column" table:number-columns-repeated="3"/>
        <table:table-row>
          <table:table-cell table:style-name="HeavyCell"><text:p text:style-name="Center">罹 災 原 因</text:p></table:table-cell>
          <table:table-cell table:style-name="HeavyCell" table:number-columns-spanned="2"><text:p text:style-name="Center">年　　月　　日　の　　　　　　　　　　　　　　による</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>

      <table:table table:name="被災住家所在地" table:style-name="Table">
        <table:table-column table:style-name="Column" table:number-columns-repeated="4"/>
        <table:table-row>
          <table:table-cell table:style-name="HeavyCell"><text:p text:style-name="Center">被災住家※の所在地</text:p><text:p text:style-name="Small">(申請者住所と同じ</text:p><text:p text:style-name="Small">場合は記入不要)</text:p></table:table-cell>
          <table:table-cell table:style-name="HeavyCell" table:number-columns-spanned="2"><text:p text:style-name="Body"/></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="HeavyCell"><text:p text:style-name="Center">証 明 書</text:p><text:p text:style-name="Center">必 要 数</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Small">※住家とは、現実に居住（世帯が生活の本拠として日常的に使用していることをいう。）</text:p>
      <text:p text:style-name="Small">のために使用している建物のことをいいます（被災者生活再建支援金や災害救助法</text:p>
      <text:p text:style-name="Small">による住宅の応急修理等の対象となる住家）。</text:p>

      <table:table table:name="判定方式選択" table:style-name="Table">
        <table:table-column table:style-name="Column" table:number-columns-repeated="4"/>
        <table:table-row>
          <table:table-cell table:style-name="HeavyCell" table:number-rows-spanned="2"><text:p text:style-name="Center">判定方式選択</text:p><text:p text:style-name="Center">（同意欄）</text:p></table:table-cell>
          <table:table-cell table:style-name="HeavyCell" table:number-columns-spanned="3"><text:p text:style-name="Body">□ 現地確認による判定を希望します。</text:p><text:p text:style-name="Body">　なお、被害認定調査を迅速に行うため、固定資産税課税台帳等に</text:p><text:p text:style-name="Body">　記載された建物の所在地・地番、床面積、構造、図面といった情報を</text:p><text:p text:style-name="Body">　利用することについて所有者等の同意を得ています。</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="HeavyCell" table:number-columns-spanned="3"><text:p text:style-name="Body">□ 自 己 判 定 方 式 ※ を 希 望 し ま す 。</text:p><text:p text:style-name="Body">　かつ、「準半壊に至らない（一部損壊）」という調査結果に同意します。</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Small">※自己判定方式では、家屋全体に対する損害割合が10％未満となるような軽微な被害の</text:p>
      <text:p text:style-name="Small">場合、申請者が「準半壊に至らない（一部損壊）」であることについて、同意していただいた</text:p>
      <text:p text:style-name="Small">うえで、被害箇所を撮影した写真のみで判定する方式です。そのため短期間で証明書</text:p>
      <text:p text:style-name="Small">を交付することが可能です。</text:p>

      <table:table table:name="注意事項" table:style-name="Table">
        <table:table-column table:style-name="Column" table:number-columns-repeated="2"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">注 意 事 項</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="Small">●本人確認できる書類等（運転免許証やマイナンバーカードなど）を</text:p>
            <text:p text:style-name="Small">　お持ちで無い場合、証明書を発行できない場合があります。</text:p>
            <text:p text:style-name="Small">●申請者が同一世帯の親族以外で委任状をお持ちで無い場合、</text:p>
            <text:p text:style-name="Small">　証明書を発行できない場合があります。</text:p>
            <text:p text:style-name="Small">●申請書に記載された内容は、適切に管理し、罹災状況の調査及び</text:p>
            <text:p text:style-name="Small">　被災者支援に係る事務に限り、本市関係各課等において使用します。</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>