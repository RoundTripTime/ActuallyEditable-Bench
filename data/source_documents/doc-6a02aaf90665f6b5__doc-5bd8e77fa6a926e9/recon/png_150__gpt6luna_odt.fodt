<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:line-height="115%" fo:margin-top="0cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-size="13pt"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="1.05cm" fo:margin-bottom="0.75cm"/>
      <style:text-properties fo:font-size="15pt"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end" fo:margin-top="0.1cm" fo:margin-bottom="0.15cm"/>
      <style:text-properties fo:font-size="13pt"/>
    </style:style>
    <style:style style:name="Applicant" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="8.5cm" fo:margin-top="0.15cm" fo:margin-bottom="0.1cm"/>
      <style:text-properties fo:font-size="13pt"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.8cm" fo:margin-top="0.15cm" fo:margin-bottom="0.25cm"/>
      <style:text-properties fo:font-size="13pt"/>
    </style:style>
    <style:style style:name="Intro" style:family="paragraph">
      <style:paragraph-properties fo:line-height="115%" fo:margin-top="0.65cm" fo:margin-bottom="0.05cm"/>
      <style:text-properties fo:font-size="13pt"/>
    </style:style>
    <style:style style:name="Attachment" style:family="paragraph">
      <style:paragraph-properties fo:line-height="115%" fo:margin-top="0cm" fo:margin-bottom="0.1cm"/>
      <style:text-properties fo:font-size="11.5pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.4cm" fo:margin-bottom="2.1cm" fo:margin-left="3cm" fo:margin-right="3cm"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="15cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ColLabel" style:family="table-column">
      <style:table-column-properties style:column-width="4.25cm"/>
    </style:style>
    <style:style style:name="ColInput" style:family="table-column">
      <style:table-column-properties style:column-width="10.75cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0.12cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="LabelCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0.12cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="start"/>
      <style:text-properties fo:font-size="11.5pt"/>
    </style:style>
    <style:style style:name="CenteredCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0.12cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="11.5pt"/>
    </style:style>
    <style:style style:name="AmountCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0.12cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="end"/>
      <style:text-properties fo:font-size="11.5pt"/>
    </style:style>
    <style:style style:name="AttachmentCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0.2cm" style:vertical-align="top"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">様式第１号（第６条関係）</text:p>
      <text:p text:style-name="Title">尾道市生産性向上等促進事業補助金交付申請書</text:p>
      <text:p text:style-name="Right">年　月　日</text:p>
      <text:p text:style-name="Recipient">尾道市長　様</text:p>
      <text:p text:style-name="Applicant">住所及び所在地</text:p>
      <text:p text:style-name="Applicant">名　称</text:p>
      <text:p text:style-name="Applicant">代表者職・氏名</text:p>
      <text:p text:style-name="Intro">尾道市生産性向上等促進事業補助金の交付を受けたいので、尾道市生産性向<text:line-break/>上等促進事業補助金交付要綱第６条の規定により、関係書類を添えて申請しま<text:line-break/>す。</text:p>
      <table:table table:name="申請書" table:style-name="FormTable">
        <table:table-column table:style-name="ColLabel"/>
        <table:table-column table:style-name="ColInput"/>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p>補 助 事 業 の 名 称</text:p></table:table-cell>
          <table:table-cell table:style-name="CenteredCell"><text:p>□　生産性向上枠　　□　ＤＸ推進枠</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p>補助事業等の目的及び内容</text:p></table:table-cell>
          <table:table-cell table:style-name="CenteredCell"><text:p>別紙事業計画書のとおり</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p>補助事業等に要する経費</text:p></table:table-cell>
          <table:table-cell table:style-name="AmountCell"><text:p>円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p>補 助 対 象 経 費</text:p></table:table-cell>
          <table:table-cell table:style-name="AmountCell"><text:p>円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell"><text:p>補 助 金 交 付 申 請 額</text:p></table:table-cell>
          <table:table-cell table:style-name="AmountCell"><text:p>円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="AttachmentCell" table:number-columns-spanned="2">
            <text:p text:style-name="Attachment">添付書類</text:p>
            <text:p text:style-name="Attachment">1　　事業計画書（別紙１）</text:p>
            <text:p text:style-name="Attachment">2　　事業収支予算書（別紙２）</text:p>
            <text:p text:style-name="Attachment">3　　法人登記簿謄本又は履歴事項証明書の写し（個人事業主にあっては、開業届又<text:line-break/>　　　は許認可証の写し）</text:p>
            <text:p text:style-name="Attachment">4　　事業所配置図及び位置図</text:p>
            <text:p text:style-name="Attachment">5　　補助対象経費に係る見積書の写し</text:p>
            <text:p text:style-name="Attachment">6　　導入する設備の概要を示したパンフレット等の写し</text:p>
            <text:p text:style-name="Attachment">7　　設備を導入する事業所に常駐する従業員等の名簿の写し（別紙３）</text:p>
            <text:p text:style-name="Attachment">8　　前期分の決算書の写し（個人事業主にあっては、前年分の所得税青色申告書又<text:line-break/>　　　は収支内訳書の写し）</text:p>
            <text:p text:style-name="Attachment">9　　市税の完納証明書（原本）</text:p>
            <text:p text:style-name="Attachment">10　 誓約書兼同意書（別紙４）</text:p>
            <text:p text:style-name="Attachment">11　 その他市長が必要と認める書類</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>