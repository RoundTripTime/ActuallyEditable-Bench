<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="C" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="B" style:family="paragraph" style:parent-style-name="P">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
    <style:style style:name="T" style:family="paragraph" style:parent-style-name="C">
      <style:text-properties fo:font-size="16pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Col" style:family="table-column">
      <style:table-column-properties style:column-width="4.2cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout" style:page-usage="all">
      <style:page-layout-properties fo:page-width="29.7cm" fo:page-height="21cm" style:print-orientation="landscape" fo:margin-top="1cm" fo:margin-bottom="1cm" fo:margin-left="1.2cm" fo:margin-right="1.2cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="P">S0700000213</text:p>
      <text:p text:style-name="T">不 動 產 役 權 設 定 契 約 書</text:p>
      <text:p text:style-name="P">下列　土地　權利人　經　建物　義務人　雙方同意設定不動產役權，特訂立本契約：</text:p>
      <table:table table:name="Page1">
        <table:table-column table:style-name="Col" table:number-columns-repeated="4"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="C">供地役不動產標示</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="C">（１）坐落</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="C">鄉鎮市區　段</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="C">小段</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="C">（２）地號</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="C">（３）面積（平方公尺）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="C">（４）設定權利範圍</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell>
        </table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="C">（５）建號　　（６）門牌　鄉鎮市區　街路　段巷弄　號樓　　（７）建物坐落　段　小段　地號　　（８）總面積（平方公尺）　　（９）設定權利範圍</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="C">需役不動產標示　（１０）坐落　鄉鎮市區　段　小段　　（１１）地號　　（１２）面積（平方公尺）　　（１３）使用需役不動產權利關係</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell></table:table-row>
      </table:table>

      <text:p text:style-name="B"/>
      <table:table table:name="Page2">
        <table:table-column table:style-name="Col" table:number-columns-repeated="4"/>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="C">（１４）建號</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">（１５）門牌　鄉鎮市區　街路　段巷弄　號樓</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">（１６）建物坐落　段　小段　地號</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">（１７）總面積（平方公尺）</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="C">（１８）使用需役不動產權利關係</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell></table:table-row>
      </table:table>

      <text:p text:style-name="B"/>
      <table:table table:name="Page3">
        <table:table-column table:style-name="Col" table:number-columns-repeated="4"/>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="P">（１９）權利價值</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="P"> </text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="P">（２０）存續期間</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="P"> </text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="P">（２１）設定目的</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="P"> </text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="P">（２２）地租</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="P"> </text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="P">（２３）預付地租情形</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="P"> </text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="P">（２４）使用方法</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="P"> </text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="P">（２５）申請登記以外之約定事項</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P">1.</text:p><text:p text:style-name="P">2.</text:p><text:p text:style-name="P">3.</text:p><text:p text:style-name="P">4.</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">（２６）簽名或簽證</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="C">訂　（２７）　（２８）　（２９）　（３０）　（３１）　（３２）住所　（３３）</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell></table:table-row>
      </table:table>

      <text:p text:style-name="B"/>
      <table:table table:name="Page4">
        <table:table-column table:style-name="Col" table:number-columns-repeated="4"/>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="C">立契約人</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">權利人或義務人　姓名或名稱</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">權利範圍　出生年月日　統一編號</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="C">縣市　鄉鎮市區　村里　鄰　街路　段　巷弄　號　樓　蓋章</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="P"> </text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="P">（３４）立約日期　中華民國　　年　　月　　日</text:p></table:table-cell><table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="P"> </text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>