<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Default" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="9pt" fo:font-weight="normal"/>
    </style:style>
    <style:style style:name="Body" style:family="paragraph" style:parent-style-name="Default">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="Cell" style:family="paragraph" style:parent-style-name="Default">
      <style:paragraph-properties fo:margin="0cm" fo:text-align="center" fo:line-height="100%"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="LeftCell" style:family="paragraph" style:parent-style-name="Default">
      <style:paragraph-properties fo:margin="0cm" fo:text-align="start" fo:line-height="100%"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="Default">
      <style:paragraph-properties fo:margin="0cm" fo:text-align="center" fo:line-height="100%" fo:break-before="page"/>
      <style:text-properties fo:font-size="14pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph" style:parent-style-name="Default">
      <style:paragraph-properties fo:margin="0cm" fo:text-align="center" fo:line-height="100%"/>
      <style:text-properties fo:font-size="11pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="BoldCell" style:family="paragraph" style:parent-style-name="Default">
      <style:paragraph-properties fo:margin="0cm" fo:text-align="center" fo:line-height="100%"/>
      <style:text-properties fo:font-size="9pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Notes" style:family="paragraph" style:parent-style-name="Default">
      <style:paragraph-properties fo:margin="0cm" fo:text-align="start" fo:line-height="100%"/>
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
    <style:style style:name="Centered" style:family="paragraph" style:parent-style-name="Default">
      <style:paragraph-properties fo:margin="0cm" fo:text-align="center" fo:line-height="100%"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="Grid" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HeavyGrid" style:family="table-cell">
      <style:table-cell-properties fo:border="1pt solid #000000" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="GrayGrid" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:background-color="#E6E6E6" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Borderless" style:family="table-cell">
      <style:table-cell-properties fo:border="none" style:vertical-align="middle"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout" style:page-usage="all">
      <style:page-layout-properties fo:page-width="29.7cm" fo:page-height="21cm" style:print-orientation="landscape" fo:margin="0.8cm"/>
    </style:page-layout>
