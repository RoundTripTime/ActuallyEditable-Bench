<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="1.2cm" fo:margin-bottom="1.5cm"/>
      <style:text-properties fo:font-size="22pt"/>
    </style:style>
    <style:style style:name="Page2Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.4cm" fo:margin-bottom="1.1cm" fo:break-before="page"/>
      <style:text-properties fo:font-size="20pt"/>
    </style:style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.12cm" fo:margin-bottom="0.12cm"/>
    </style:style>
    <style:style style:name="Centered" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="RightLabels" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="8.3cm" fo:margin-top="0.25cm" fo:margin-bottom="0.25cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="WorkLine" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="1.2cm" fo:margin-bottom="1.8cm" fo:border-bottom="0.5pt solid #000000"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="CalcHead" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.2cm" fo:margin-bottom="0.7cm"/>
      <style:text-properties fo:font-size="12pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="CalcLine" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.2cm" fo:margin-top="0.2cm" fo:margin-bottom="0.2cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Footnote" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.4cm" fo:margin-bottom="0.5cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Receipt" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="1.6cm"/>
      <style:text-properties fo:font-size="15pt"/>
    </style:style>
    <style:style style:name="ReceiptNote" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="1.2cm"/>
      <style:text-properties fo:font-size="12pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Example" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.1cm" fo:margin-bottom="0.1cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="TableTitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.2cm" fo:margin-bottom="0.05cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Grid" style:family="table">
      <style:table-properties style:rel-width="100%" table:align="margins" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="CalcGrid" style:family="table">
      <style:table-properties style:rel-width="100%" table:align="margins" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="C1" style:family="table-column">
      <style:table-column-properties style:column-width="4.2cm"/>
    </style:style>
    <style:style style:name="C2" style:family="table-column">
      <style:table-column-properties style:column-width="2.46cm"/>
    </style:style>
    <style:style style:name="C2b" style:family="table-column">
      <style:table-column-properties style:column-width="3.7cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #777777" fo:padding="0.08cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="Header" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #777777" fo:padding="0.08cm" fo:background-color="#B7DDF2" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="SubHeader" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #777777" fo:padding="0.08cm" fo:background-color="#DDEEF8" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="RowLabel" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #777777" fo:padding="0.08cm" fo:background-color="#EEEEEE" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="ReceiptCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt dashed #555555" fo:padding="0.2cm" style:vertical-align="middle"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="1.5cm" fo:margin-bottom="1.5cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">建設業退職金共済掛金収納書</text:p>
      <text:p text:style-name="RightLabels">受注者</text:p>
      <text:p text:style-name="RightLabels">住所</text:p>
      <text:p text:style-name="RightLabels">商号又は名称</text:p>
      <text:p text:style-name="RightLabels">代表者氏名　　　　　　　　　　　　　　　　印</text:p>
      <text:p text:style-name="WorkLine">工事名</text:p>
      <text:p text:style-name="CalcHead">　　　　　　　　　（共済掛金の目安）</text:p>
      <text:p text:style-name="CalcLine">....................円 × .................... ／1,000 × .................... ％ ／ 70％　＝　............................ 円</text:p>
      <text:p text:style-name="Centered">　　　　　　　　　①　　　　　　　　　　　②　　　　　　　　③</text:p>
      <text:p text:style-name="Footnote">※上記計算式中、①＝請負金額、②＝次ページ掲載「共済証紙購入の考え方」の表を参照、<text:line-break/>③＝労働者の建退共制度加入率とする。</text:p>
      <table:table table:name="収納書貼付欄" table:style-name="Grid">
        <table:table-column table:style-name="C1"/>
        <table:table-column table:style-name="C2" table:number-columns-repeated="6"/>
        <table:table-row>
          <table:table-cell table:style-name="ReceiptCell" table:number-columns-spanned="7" table:number-rows-spanned="1">
            <text:p text:style-name="Receipt"/>
            <text:p text:style-name="Receipt"/>
            <text:p text:style-name="Receipt">収納書貼付箇所</text:p>
            <text:p text:style-name="ReceiptNote">※契約者記入欄は必ず記入して下さい</text:p>
            <text:p text:style-name="Receipt"/>
            <text:p text:style-name="Receipt"/>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Page2Title">建設業退職金共済掛金収納書（計算例）</text:p>
      <text:p text:style-name="Example">◆計算例１　（その他の土木）</text:p>
      <text:p text:style-name="Example">請負額：9,000,000 円　　建退共制度加入率：50%　の場合</text:p>
      <text:p text:style-name="CalcLine">（掛金計算式）　9,000,000 円 ×　4.1／1000 ×　50% ／ 70% ＝　26,357 円</text:p>
      <text:p text:style-name="Centered">　　　　　　　　　請負金額　　　　　　　　下記の表より　　　加入率</text:p>
      <text:p text:style-name="Example">◆計算例２　（その他の土木）</text:p>
      <text:p text:style-name="Example">請負額：20,000,000 円　　建退共制度加入率：70%　の場合</text:p>
      <text:p text:style-name="CalcLine">（掛金計算式）　20,000,000 円 ×　3.6／1000 ×　70% ／ 70% ＝　72,000 円</text:p>
      <text:p text:style-name="Centered">　　　　　　　　　請負金額　　　　　　　　下記の表より　　　加入率</text:p>
      <text:p text:style-name="Footnote">※詳細については建退共ホームページ（http://www.kentaikyo.taisyokukin.go.jp/）を参照</text:p>
      <text:p text:style-name="TableTitle">「共済証紙購入の考え方」の表　（建退共ホームページより抜粋）</text:p>
      <table:table table:name="土木の掛金率" table:style-name="Grid">
        <table:table-column table:style-name="C1"/>
        <table:table-column table:style-name="C2" table:number-columns-repeated="6"/>
        <table:table-row>
          <table:table-cell table:style-name="Header" table:number-columns-spanned="1" table:number-rows-spanned="2"/>
          <table:table-cell table:style-name="Header" table:number-columns-spanned="6"><text:p>土　木</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="SubHeader"><text:p>舗装</text:p></table:table-cell>
          <table:table-cell table:style-name="SubHeader"><text:p>橋梁等</text:p></table:table-cell>
          <table:table-cell table:style-name="SubHeader"><text:p>隧道</text:p></table:table-cell>
          <table:table-cell table:style-name="SubHeader"><text:p>堰堤</text:p></table:table-cell>
          <table:table-cell table:style-name="SubHeader"><text:p>浚渫･埋立</text:p></table:table-cell>
          <table:table-cell table:style-name="SubHeader"><text:p>その他の土木</text:p></table:table-cell>
        </table:table-row>
        <table:table-row><table:table-cell table:style-name="RowLabel"><text:p>1,000 ～9,999 千円</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>3.5/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>3.5/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>4.5/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>4.1/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>3.7/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>4.1/1000</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="RowLabel"><text:p>10,000 ～49,999 千円</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>3.3/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>3.2/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>3.6/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>3.8/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>2.8/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>3.6/1000</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="RowLabel"><text:p>50,000～99,999 千円</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>2.9/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>2.8/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>2.8/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>3.1/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>2.7/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>3.1/1000</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="RowLabel"><text:p>100,000～499,999 千円</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>2.3/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>2.1/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>2.1/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>2.5/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>1.9/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>2.3/1000</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="RowLabel"><text:p>500,000 千円以上</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>1.7/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>1.6/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>1.9/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>1.8/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>1.7/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>1.8/1000</text:p></table:table-cell></table:table-row>
      </table:table>
      <table:table table:name="建築設備の掛金率" table:style-name="Grid">
        <table:table-column table:style-name="C1"/>
        <table:table-column table:style-name="C2b" table:number-columns-repeated="4"/>
        <table:table-row>
          <table:table-cell table:style-name="Header" table:number-columns-spanned="1" table:number-rows-spanned="2"/>
          <table:table-cell table:style-name="Header" table:number-columns-spanned="2"><text:p>建　築</text:p></table:table-cell>
          <table:table-cell table:style-name="Header" table:number-columns-spanned="2"><text:p>設　備</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="SubHeader"><text:p>住宅･同設備</text:p></table:table-cell>
          <table:table-cell table:style-name="SubHeader"><text:p>非住宅･同設備</text:p></table:table-cell>
          <table:table-cell table:style-name="SubHeader"><text:p>屋外の電気等</text:p></table:table-cell>
          <table:table-cell table:style-name="SubHeader"><text:p>機械器具設置</text:p></table:table-cell>
        </table:table-row>
        <table:table-row><table:table-cell table:style-name="RowLabel"><text:p>1,000 ～9,999 千円</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>4.8/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>3.2/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>2.9/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>2.2/1000</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="RowLabel"><text:p>10,000 ～49,999 千円</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>2.9/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>3.0/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>2.1/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>1.7/1000</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="RowLabel"><text:p>50,000～99,999 千円</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>2.7/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>2.5/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>1.8/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>1.4/1000</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="RowLabel"><text:p>100,000～499,999 千円</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>2.2/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>2.1/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>1.4/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>1.1/1000</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="RowLabel"><text:p>500,000 千円以上</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>2.0/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>1.8/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>1.1/1000</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p>1.1/1000</text:p></table:table-cell></table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>