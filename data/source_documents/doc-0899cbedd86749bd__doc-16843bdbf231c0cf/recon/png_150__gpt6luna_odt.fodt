<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Default" style:family="paragraph">
      <style:paragraph-properties fo:line-height="100%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Date" style:family="paragraph" style:parent-style-name="Default">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="2cm" fo:margin-bottom="0.8cm"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph" style:parent-style-name="Default">
      <style:paragraph-properties fo:margin-left="0.7cm" fo:margin-top="0.5cm" fo:margin-bottom="0.8cm"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="Default">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="1.5cm" fo:margin-bottom="0.2cm"/>
    </style:style>
    <style:style style:name="BodyLine" style:family="paragraph" style:parent-style-name="Default">
      <style:paragraph-properties fo:text-align="center" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Attachments" style:family="paragraph" style:parent-style-name="Default">
      <style:paragraph-properties fo:margin-top="0.8cm" fo:margin-bottom="0.1cm"/>
    </style:style>
    <style:style style:name="AttachmentLine" style:family="paragraph" style:parent-style-name="Default">
      <style:paragraph-properties fo:margin-left="0.45cm" fo:margin-bottom="0cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="17cm" table:align="left"/>
    </style:style>
    <style:style style:name="FormCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="5.2cm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="2.5cm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="1.8cm"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties style:column-width="7.5cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Date">年　　月　　日</text:p>
      <text:p text:style-name="Recipient">（宛先）野田市長</text:p>
      <table:table table:name="交付決定者情報" table:style-name="FormTable">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p>交付決定者</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p>住所</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p>氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p>電話番号</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="2"><text:p>（法人その他の団体にあっては、事務所の所在地又は代表者の住所、名称及び代表者の氏名）</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="FormCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Title">野田市えんがわ支援事業補助金実績報告書</text:p>
      <text:p text:style-name="BodyLine">年　　月　　日付け野福高第　　号により交付の決定のあった野</text:p>
      <text:p text:style-name="BodyLine">田市えんがわ支援事業補助金について、次のとおり実績報告します。</text:p>
      <text:p text:style-name="Attachments">添付書類</text:p>
      <text:p text:style-name="AttachmentLine">（1）　事業実績報告書（年次）</text:p>
      <text:p text:style-name="AttachmentLine">（2）　収支決算書</text:p>
      <text:p text:style-name="AttachmentLine">（3）　補助対象経費に掛かる支出を証する書類</text:p>
    </office:text>
  </office:body>
</office:document>