        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="Req">■　해석 대상 법령이 특정될 것</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
