<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:text-properties fo:font-size="12pt" style:font-name="serif"/>
    </style:default-style>
    <style:style style:name="TopNote" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="1cm" fo:margin-bottom="2.1cm"/>
      <style:text-properties fo:font-size="12pt" style:font-name="serif"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0.7cm"/>
      <style:text-properties fo:font-size="16pt" style:font-name="serif"/>
    </style:style>
    <style:style style:name="OrgLabel" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt" style:font-name="serif"/>
    </style:style>
    <style:style style:name="CenteredCell" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt" style:font-name="serif"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="15.4cm" table:align="left" fo:margin-top="0.6cm" fo:margin-bottom="0cm" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="OrgTable" style:family="table">
      <style:table-properties style:width="15.4cm" table:align="left" fo:margin-top="0cm" fo:margin-bottom="0.6cm" table:border-model="collapsing"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="2.5cm" fo:margin-bottom="2cm" fo:margin-left="3cm" fo:margin-right="2.6cm"/>
    </style:page-layout>
    <style:style style:name="FormColumnLeft" style:family="table-column">
      <style:table-column-properties style:column-width="4.3cm"/>
    </style:style>
    <style:style style:name="FormColumnRight" style:family="table-column">
      <style:table-column-properties style:column-width="11.1cm"/>
    </style:style>
    <style:style style:name="OrgColumnLeft" style:family="table-column">
      <style:table-column-properties style:column-width="9cm"/>
    </style:style>
    <style:style style:name="OrgColumnRight" style:family="table-column">
      <style:table-column-properties style:column-width="6.4cm"/>
    </style:style>
    <style:style style:name="FormRowOne" style:family="table-row">
      <style:table-row-properties style:row-height="5.1cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="FormRowTwo" style:family="table-row">
      <style:table-row-properties style:row-height="5.1cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="FormRowThree" style:family="table-row">
      <style:table-row-properties style:row-height="5.6cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="LabelCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #333333" fo:padding="0.12cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="InputCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #333333" fo:padding="0.12cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="OrgBlankCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0cm"/>
    </style:style>
    <style:style style:name="OrgRuleCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:border-bottom="0.5pt solid #000000" fo:padding="0cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="TopNote">〔様式第６号〕</text:p>
      <text:p text:style-name="Title">規約変更の内容及び理由</text:p>
      <table:table table:name="OrganizationName" table:style-name="OrgTable">
        <table:table-column table:style-name="OrgColumnLeft"/>
        <table:table-column table:style-name="OrgColumnRight"/>
        <table:table-row>
          <table:table-cell table:style-name="OrgBlankCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="OrgRuleCell"><text:p text:style-name="OrgLabel">団体名</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <table:table table:name="AmendmentDetails" table:style-name="FormTable">
        <table:table-column table:style-name="FormColumnLeft"/>
        <table:table-column table:style-name="FormColumnRight"/>
        <table:table-row table:style-name="FormRowOne">
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CenteredCell">変更前の内容</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="FormRowTwo">
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CenteredCell">変更後の内容</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="FormRowThree">
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="CenteredCell">変更理由</text:p></table:table-cell>
          <table:table-cell table:style-name="InputCell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>