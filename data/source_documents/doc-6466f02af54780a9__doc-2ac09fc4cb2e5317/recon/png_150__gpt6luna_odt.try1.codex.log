      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties style:font-name="Noto Sans CJK TC" fo:font-size="8.5pt" fo:font-weight="bold" fo:language="zh" fo:country="TW"/>
