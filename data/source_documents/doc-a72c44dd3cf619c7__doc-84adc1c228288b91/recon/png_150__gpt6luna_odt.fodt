<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:text-properties fo:font-size="12pt" style:font-name-asian="Noto Serif CJK JP"/>
      <style:paragraph-properties fo:line-height="120%"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="2.5cm" fo:margin-right="2.5cm" fo:line-height="120%"/>
    </style:style>
    <style:style style:name="Date" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="2.5cm" fo:margin-right="2.5cm" fo:text-align="right"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="2.5cm" fo:margin-right="2.5cm" fo:margin-top="0.8cm"/>
    </style:style>
    <style:style style:name="ApplicantTable" style:family="table">
      <style:table-properties fo:margin-left="9.5cm" fo:margin-right="2.5cm"/>
    </style:style>
    <style:style style:name="SigTable" style:family="table">
      <style:table-properties fo:margin-left="2.5cm" fo:margin-right="2.5cm"/>
    </style:style>
    <style:style style:name="PlainCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="LineCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:border-bottom="0.5pt solid #000000" fo:padding="0cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="LabelCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0cm" style:vertical-align="middle"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="2.5cm" fo:margin-right="2.5cm"/>
    </style:page-layout>
    <style:style style:name="ApplicantCol1" style:family="table-column">
      <style:table-column-properties style:column-width="10cm"/>
    </style:style>
    <style:style style:name="ApplicantCol2" style:family="table-column">
      <style:table-column-properties style:column-width="2cm"/>
    </style:style>
    <style:style style:name="ApplicantCol3" style:family="table-column">
      <style:table-column-properties style:column-width="4cm"/>
    </style:style>
    <style:style style:name="SigCol1" style:family="table-column">
      <style:table-column-properties style:column-width="3.5cm"/>
    </style:style>
    <style:style style:name="SigCol2" style:family="table-column">
      <style:table-column-properties style:column-width="1cm"/>
    </style:style>
    <style:style style:name="SigCol3" style:family="table-column">
      <style:table-column-properties style:column-width="7.8cm"/>
    </style:style>
    <style:style style:name="SigCol4" style:family="table-column">
      <style:table-column-properties style:column-width="1.5cm"/>
    </style:style>
    <style:style style:name="GapSmall" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:margin-top="0.15cm" fo:margin-bottom="0.15cm"/>
    </style:style>
    <style:style style:name="ApplicantPara" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="120%"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="1.4cm" fo:margin-bottom="0.55cm"/>
    </style:style>
    <style:style style:name="Intro" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:margin-bottom="0.55cm" fo:line-height="140%"/>
    </style:style>
    <style:style style:name="Record" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.2cm" fo:margin-bottom="0.9cm"/>
    </style:style>
    <style:style style:name="Consent" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:line-height="140%" fo:margin-bottom="0.9cm"/>
    </style:style>
    <style:style style:name="OwnerDate" style:family="paragraph" style:parent-style-name="Date">
      <style:paragraph-properties fo:margin-top="0.4cm" fo:margin-bottom="0.6cm"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:margin-top="1cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Date">年　月　日</text:p>
      <text:p text:style-name="Recipient">豊見城市長　殿</text:p>
      <table:table table:name="Applicant" table:style-name="ApplicantTable">
        <table:table-column table:style-name="ApplicantCol1"/>
        <table:table-column table:style-name="ApplicantCol2"/>
        <table:table-column table:style-name="ApplicantCol3"/>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="ApplicantPara"/></table:table-cell>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="ApplicantPara">(申請者)</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="ApplicantPara"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="ApplicantPara"/></table:table-cell>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="ApplicantPara">住　所</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="ApplicantPara"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="ApplicantPara"/></table:table-cell>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="ApplicantPara">氏　名</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="ApplicantPara"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="ApplicantPara"/></table:table-cell>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="ApplicantPara">電話番号</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p text:style-name="ApplicantPara"/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Title">豊見城市住宅リフォーム支援事業工事承諾書</text:p>
      <text:p text:style-name="Intro">豊見城市住宅リフォーム支援事業補助金の申請に当たり、下記のとおり住宅等の所有者からリフォーム工事及び当該補助金の交付申請をすることへの承諾を得ましたので提出します。</text:p>
      <text:p text:style-name="Record">記</text:p>
      <text:p text:style-name="Consent">豊見城市住宅リフォーム支援事業に係る補助金の申請に当たり、当該住宅の所有者である私は、リフォーム工事及び補助金の交付申請をすることについて承諾します。</text:p>
      <text:p text:style-name="OwnerDate">年　月　日</text:p>
      <table:table table:name="Owner" table:style-name="SigTable">
        <table:table-column table:style-name="SigCol1"/>
        <table:table-column table:style-name="SigCol2"/>
        <table:table-column table:style-name="SigCol3"/>
        <table:table-column table:style-name="SigCol4"/>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell"><text:p>(住宅等の所有者)</text:p></table:table-cell>
          <table:table-cell table:style-name="LabelCell"><text:p>住所</text:p></table:table-cell>
          <table:table-cell table:style-name="LineCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="PlainCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="LabelCell"><text:p>氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="LineCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p>印</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Note">(注) 補助の対象は同一人・同住宅に対し１回限りですので、御注意ください。</text:p>
    </office:text>
  </office:body>
</office:document>