<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0mm" fo:margin-bottom="0mm" fo:line-height="1.2"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:default-style>
    <style:style style:name="PStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-left="3mm" fo:margin-top="22mm" fo:margin-bottom="11mm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="PTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0mm" fo:margin-bottom="3mm"/>
      <style:text-properties fo:font-size="15pt"/>
    </style:style>
    <style:style style:name="PClub" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="18mm" fo:margin-bottom="9mm"/>
      <style:text-properties fo:font-size="15pt" style:text-underline-style="solid"/>
    </style:style>
    <style:style style:name="PNote" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="9mm" fo:margin-top="17mm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="PHeader" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" fo:print-orientation="portrait" fo:margin-left="22mm" fo:margin-right="22mm" fo:margin-top="15mm" fo:margin-bottom="15mm"/>
    </style:page-layout>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="33mm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="55mm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="24mm"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties style:column-width="54mm"/>
    </style:style>
    <style:style style:name="HeaderRow" style:family="table-row">
      <style:table-row-properties style:row-height="13mm"/>
    </style:style>
    <style:style style:name="InputRow" style:family="table-row">
      <style:table-row-properties style:row-height="51mm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0mm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="1mm" style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PStart">別紙</text:p>
      <text:p text:style-name="PTitle">令和　　年度東郷町高齢者花壇管理事業</text:p>
      <text:p text:style-name="PTitle">（花いっぱい活動事業）計画書</text:p>
      <text:p text:style-name="PClub">老人クラブ</text:p>
      <table:table table:name="計画表">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="HeaderCell">
            <text:p text:style-name="PHeader">実　施　日</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="HeaderCell">
            <text:p text:style-name="PHeader">実　施　場　所</text:p>
            <text:p text:style-name="PHeader">（花壇設置場所）</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="HeaderCell">
            <text:p text:style-name="PHeader">面　積</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="HeaderCell">
            <text:p text:style-name="PHeader">事　業　内　容</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InputRow">
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PNote">※　花壇設置場所一覧表を参考に記入してください。</text:p>
    </office:text>
  </office:body>
</office:document>