        <rng:ref name="common-num-format-attlist"/>
      </rng:optional>
      <rng:ref name="common-num-format-prefix-suffix-attlist"/>
      <rng:optional>
        <rng:attribute name="style:paper-tray-name">
          <rng:choice>
            <rng:value>default</rng:value>
            <rng:ref name="string"/>
          </rng:choice>
        </rng:attribute>
      </rng:optional>
        </rng:attribute>
      </rng:optional>
    </rng:interleave>
  </rng:define>
