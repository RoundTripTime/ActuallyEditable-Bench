      <rng:optional>
        <rng:ref name="office-forms"/>
      </rng:optional>
      <rng:zeroOrMore>
        <rng:ref name="shape"/>
      </rng:zeroOrMore>
      <rng:optional>
        <rng:ref name="animation-element"/>
      </rng:optional>
      <rng:optional>
        <rng:ref name="presentation-notes"/>
      </rng:optional>
    </rng:element>
