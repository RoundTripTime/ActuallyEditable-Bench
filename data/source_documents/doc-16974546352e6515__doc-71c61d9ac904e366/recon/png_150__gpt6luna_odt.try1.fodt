    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:text-align="center"/>
      <style:text-properties fo:font-size="21pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin="0cm"/>
    </style:style>
    <style:style style:name="BoldLarge" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm"/>
      <style:text-properties fo:font-size="14pt" fo:font-weight="bold"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.7cm" fo:margin-bottom="1.7cm" fo:margin-left="2.1cm" fo:margin-right="2.1cm"/>
    </style:page-layout>
