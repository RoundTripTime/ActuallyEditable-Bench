        <table:table-column table:style-name="TableCol5"/>
        <table:table-column table:style-name="TableCol6"/>
        <table:table-row>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="1"><text:p>신청 내용</text:p></table:table-cell>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="2"><text:p>전입세대확인서 열람　　[　　]</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="3"><text:p>전입세대확인서 교부　　[　　]</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>

