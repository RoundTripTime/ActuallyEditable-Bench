          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Grid" table:number-columns-spanned="2"><text:p>연락처</text:p></table:cell>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>

