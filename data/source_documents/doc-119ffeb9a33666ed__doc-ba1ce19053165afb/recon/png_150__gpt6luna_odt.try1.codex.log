      <text:p text:style-name="Centered">記</text:p>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Body">１．委任する権限</text:p>
      <text:p text:style-name="Body">　　令和８年１１月１１日に実施する次の物件の一般競争入札に関する一切の権限</text:p>
      <table:table table:name="PropertyNumber" table:style-name="PropertyTable">
