<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:line-height="1.35"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph" style:master-page-name="Standard">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="1.0cm" fo:margin-bottom="0.25cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="RightLine" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-bottom="0.75cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.4cm" fo:margin-bottom="0.75cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Applicant" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="7.8cm" fo:line-height="1.45"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="FormTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="1.0cm" fo:margin-bottom="0.65cm"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="Statement" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0cm" fo:margin-right="0cm" fo:margin-bottom="0.55cm" fo:line-height="1.5"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.55cm" fo:margin-left="0cm" fo:line-height="1.5"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="2.8cm" fo:margin-right="2.8cm"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="14.3cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="2.9cm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="2.9cm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="8.5cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.12cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:line-height="1.25"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.12cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center" fo:line-height="1.3"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="DocsCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.12cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:margin-left="0.15cm" fo:line-height="1.5"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">様式第１号（第５条関係）</text:p>
      <text:p text:style-name="RightLine">令和　　年　　月　　日</text:p>
      <text:p text:style-name="Recipient">塙町長　宮田秀利　様</text:p>
      <text:p text:style-name="Applicant">申請者　住所</text:p>
      <text:p text:style-name="Applicant">　　　　団体名</text:p>
      <text:p text:style-name="Applicant">　　　　代表者氏名　　　　　　　　　　　　　　　　㊞</text:p>
      <text:p text:style-name="Applicant">　　　　電　話</text:p>
      <text:p text:style-name="FormTitle">塙町除雪機械購入費補助金交付申請書</text:p>
      <text:p text:style-name="Statement">塙町除雪機械購入費補助金交付要綱第５条の規定により、下記のとおり補助金の交<text:line-break/>付を申請します。</text:p>
      <table:table table:name="ApplicationForm" table:style-name="FormTable">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-rows-spanned="3">
            <text:p>購入予定の</text:p>
            <text:p>除雪機械</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="CellCenter">
            <text:p>メーカー名</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="CellCenter"/>
          <table:table-cell table:style-name="CellCenter">
            <text:p>機種名</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:style-name="CellCenter"/>
          <table:table-cell table:style-name="CellCenter">
            <text:p>型　式</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-columns-spanned="2">
            <text:p>購入予定金額（見積額）</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="CellCenter"/>
          <table:table-cell table:style-name="CellCenter">
            <text:p>円（消費税込み）</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-columns-spanned="2">
            <text:p>補助金申請額</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="CellCenter"/>
          <table:table-cell table:style-name="CellCenter">
            <text:p>円</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-columns-spanned="2">
            <text:p>添付書類</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="CellCenter"/>
          <table:table-cell table:style-name="DocsCell">
            <text:p>１　カタログ等</text:p>
            <text:p>２　販売店の見積書</text:p>
            <text:p>３　その他（　組合規約　　　　）</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Note">※ 補助金申請額は、購入予定金額の３分の２の額です。</text:p>
      <text:p text:style-name="Note">（　１，０００円未満の端数切り捨て。上限５００，０００円）</text:p>
    </office:text>
  </office:body>
</office:document>