<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="0.38cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="PC" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="0.38cm" fo:text-align="center"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="PL" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="0.38cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin="0cm" fo:line-height="0cm"/>
    </style:style>
    <style:style style:name="C" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.03cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CB" style:family="table-cell">
      <style:table-cell-properties fo:border="1.25pt solid #000000" fo:padding="0.03cm" style:vertical-align="middle"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="1.75cm" fo:margin-right="1.75cm" fo:margin-top="1.4cm" fo:margin-bottom="4.8cm"/>
    </style:page-layout>
