          <table:covered-table-cell table:number-columns-repeated="10"/>
        </table:table-row>
        <table:table-row table:style-name="NormalRow">
          <table:table-cell table:style-name="C" table:number-columns-spanned="3"><text:p text:style-name="PC">工　事　着　手　年　月　日</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="PC">年　月　日</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="C" table:number-columns-spanned="4" table:number-rows-spanned="2"><text:p text:style-name="PC">事　業　の　操　業　期　間　又</text:p><text:p text:style-name="PC">は　施　設　の　利　用　期　間</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2" table:number-rows-spanned="2"><text:p text:style-name="PC">年　月　日</text:p><text:p text:style-name="PC">から　年間</text:p></table:table-cell><table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="NormalRow">
          <table:table-cell table:style-name="C" table:number-columns-spanned="3"><text:p text:style-name="PC">工　事　完　成　年　月　日</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="PC">年　月　日</text:p></table:table-cell><table:covered-table-cell/>
          <table:covered-table-cell table:number-columns-repeated="4"/><table:covered-table-cell table:number-columns-repeated="2"/>
        </table:table-row>
        <table:table-row table:style-name="SectionRow">
          <table:table-cell table:style-name="CB" table:number-columns-spanned="11"><text:p text:style-name="PL">転　用　目　的　に　係　る　事　業　又　は　施　設　の　概　要</text:p></table:table-cell>
          <table:covered-table-cell table:number-columns-repeated="10"/>
        </table:table-row>
        <table:table-row table:style-name="NormalRow">
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p/></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="PC">名　称</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="PC">棟　数</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="PC">建　築　面　積</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="PC">所　要　面　積</text:p></table:table-cell><table:covered-table-cell/>
