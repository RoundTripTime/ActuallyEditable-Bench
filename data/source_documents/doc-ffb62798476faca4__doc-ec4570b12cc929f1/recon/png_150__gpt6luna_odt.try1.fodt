          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p/></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p/></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p/></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p/></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="C"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DataRow">
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="PC">小　計</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p/></table:table-cell><table:covered-table-cell/>
