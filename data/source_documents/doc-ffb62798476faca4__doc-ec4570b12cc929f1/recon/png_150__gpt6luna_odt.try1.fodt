          <table:table-cell table:style-name="C" table:number-columns-spanned="3"><text:p text:style-name="PC">費</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="2"/>
          <table:table-cell table:style-name="C"><text:p text:style-name="PC">円</text:p></table:table-cell>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="PC">合　計</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="C"><text:p text:style-name="PC">円</text:p></table:table-cell>
