          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="PC">から借入</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="C"><text:p text:style-name="PC">円</text:p></table:table-cell>
