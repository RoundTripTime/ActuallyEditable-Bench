          <table:table-cell table:style-name="C"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="NormalRow">
          <table:table-cell table:style-name="C" table:number-columns-spanned="3"><text:p text:style-name="PC">地下資源採取の場合</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="PC">掘削深</text:p></table:table-cell><table:covered-table-cell/>
