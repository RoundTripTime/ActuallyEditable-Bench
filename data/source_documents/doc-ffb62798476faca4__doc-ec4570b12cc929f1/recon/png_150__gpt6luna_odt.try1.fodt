        <table:table-row table:style-name="SectionRow">
          <table:table-cell table:style-name="CB" table:number-columns-spanned="11"><text:p text:style-name="PL">転用することによって生ずる付近の農地、作物等の被害の防除施設の概要</text:p></table:table-cell>
          <table:covered-table-cell table:number-columns-repeated="10"/>
