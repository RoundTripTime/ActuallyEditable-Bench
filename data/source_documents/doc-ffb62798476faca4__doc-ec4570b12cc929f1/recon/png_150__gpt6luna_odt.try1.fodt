          <table:table-cell table:style-name="C" table:number-columns-spanned="2"><text:p text:style-name="PL">関係法令の許認</text:p><text:p text:style-name="PL">可申請届等手続</text:p><text:p text:style-name="PL">状況</text:p></table:table-cell><table:covered-table-cell/>
