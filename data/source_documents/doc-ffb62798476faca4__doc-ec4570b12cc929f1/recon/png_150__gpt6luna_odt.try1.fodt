          <table:covered-table-cell table:number-columns-repeated="10"/>
        </table:table-row>
        <table:table-row table:style-name="NormalRow">
          <table:table-cell table:style-name="C" table:number-columns-spanned="6"><text:p text:style-name="PL">（必要経費内訳）</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="5"/>
