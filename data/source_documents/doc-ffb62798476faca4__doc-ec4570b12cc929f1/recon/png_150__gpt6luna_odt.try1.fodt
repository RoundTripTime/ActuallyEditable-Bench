    <style:style style:name="Col3" style:family="table-column"><style:table-column-properties style:column-width="0.673cm"/></style:style>
    <style:style style:name="Col4" style:family="table-column"><style:table-column-properties style:column-width="2.356cm"/></style:style>
    <style:style style:name="Col5" style:family="table-column"><style:table-column-properties style:column-width="1.683cm"/></style:style>
    <style:style style:name="Col6" style:family="table-column"><style:table-column-properties style:column-width="1.346cm"/></style:style>
    <style:style style:name="Col7" style:family="table-column"><style:table-column-properties style:column-width="1.178cm"/></style:style>
    <style:style style:name="Col8" style:family="table-column"><style:table-column-properties style:column-width="1.851cm"/></style:style>
    <style:style style:name="Col9" style:family="table-column"><style:table-column-properties style:column-width="0.353cm"/></style:style>
    <style:style style:name="Col10" style:family="table-column"><style:table-column-properties style:column-width="2.675cm"/></style:style>
    <style:style style:name="Col11" style:family="table-column"><style:table-column-properties style:column-width="2.019cm"/></style:style>
    <style:style style:name="BlankRow" style:family="table-row"><style:table-row-properties style:row-height="0.70cm"/></style:style>
    <style:style style:name="NormalRow" style:family="table-row"><style:table-row-properties style:min-row-height="0.52cm"/></style:style>
    <style:style style:name="SectionRow" style:family="table-row"><style:table-row-properties style:min-row-height="0.60cm"/></style:style>
    <style:style style:name="DataRow" style:family="table-row"><style:table-row-properties style:min-row-height="0.61cm"/></style:style>
    <style:style style:name="TallRow" style:family="table-row"><style:table-row-properties style:row-height="0.95cm"/></style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="PL">様式３－３</text:p>
      <table:table table:name="FormTable">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-column table:style-name="Col5"/>
        <table:table-column table:style-name="Col6"/>
        <table:table-column table:style-name="Col7"/>
        <table:table-column table:style-name="Col8"/>
        <table:table-column table:style-name="Col9"/>
        <table:table-column table:style-name="Col10"/>
        <table:table-column table:style-name="Col11"/>
        <table:table-row table:style-name="SectionRow">
          <table:table-cell table:style-name="CB" table:number-columns-spanned="11"><text:p text:style-name="PL">転　用　事　由　の　詳　細</text:p></table:table-cell>
          <table:covered-table-cell table:number-columns-repeated="10"/>
        </table:table-row>
        <table:table-row table:style-name="BlankRow"><table:table-cell table:style-name="C" table:number-columns-repeated="11"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="BlankRow"><table:table-cell table:style-name="C" table:number-columns-repeated="11"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="BlankRow"><table:table-cell table:style-name="C" table:number-columns-repeated="11"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="BlankRow"><table:table-cell table:style-name="C" table:number-columns-repeated="11"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="BlankRow"><table:table-cell table:style-name="C" table:number-columns-repeated="11"><text:p/></table:table-cell></table:table-row>
