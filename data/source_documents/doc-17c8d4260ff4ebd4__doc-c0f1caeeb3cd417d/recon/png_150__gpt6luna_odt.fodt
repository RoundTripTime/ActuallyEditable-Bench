<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:line-height="0.7cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:default-style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:line-height="0.7cm"/>
    </style:style>
    <style:style style:name="CenteredTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="0.7cm"/>
    </style:style>
    <style:style style:name="RightFields" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:line-height="0.7cm"/>
    </style:style>
    <style:style style:name="CenteredCellText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="0.7cm"/>
    </style:style>
    <style:style style:name="NoteText" style:family="paragraph">
      <style:paragraph-properties fo:line-height="0.7cm"/>
    </style:style>
    <style:style style:name="SpaceLine" style:family="paragraph">
      <style:paragraph-properties fo:line-height="0.7cm"/>
    </style:style>
    <style:style style:name="UnderlinedBlank" style:family="text">
      <style:text-properties style:text-underline-type="single" style:text-underline-style="solid"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="16cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="FormColumnWide" style:family="table-column">
      <style:table-column-properties style:column-width="12.25cm"/>
    </style:style>
    <style:style style:name="FormColumnNarrow" style:family="table-column">
      <style:table-column-properties style:column-width="3.75cm"/>
    </style:style>
    <style:style style:name="FormHeaderRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.75cm"/>
    </style:style>
    <style:style style:name="FormBodyRow" style:family="table-row">
      <style:table-row-properties style:row-height="2.3cm"/>
    </style:style>
    <style:style style:name="FormCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout" style:page-usage="all">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-left="2.5cm" fo:margin-right="2.5cm" fo:margin-top="2.5cm" fo:margin-bottom="2.5cm" style:print-orientation="portrait"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">様式第４号（第２条関係）</text:p>
      <text:p text:style-name="CenteredTitle">協　議　書</text:p>
      <text:p>霧島市長　殿</text:p>
      <text:p><text:span text:style-name="UnderlinedBlank">　　　　</text:span>地区の伐採については、次のとおり協議しました。</text:p>
      <text:p text:style-name="SpaceLine"/>
      <text:p text:style-name="RightFields">協議日　　　年　　月　　日</text:p>
      <text:p text:style-name="RightFields">団体名</text:p>
      <text:p text:style-name="RightFields">代表者名　　　　　　　　　㊞</text:p>
      <table:table table:name="協議内容1" table:style-name="FormTable">
        <table:table-column table:style-name="FormColumnWide"/>
        <table:table-column table:style-name="FormColumnNarrow"/>
        <table:table-row table:style-name="FormHeaderRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="CenteredCellText">協　議　内　容</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="CenteredCellText">協　議　結　果</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="FormBodyRow">
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="CenteredCellText">承認　・　否認</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="SpaceLine"/>
      <text:p text:style-name="RightFields">協議日　　　年　　月　　日</text:p>
      <text:p text:style-name="RightFields">団体名</text:p>
      <text:p text:style-name="RightFields">代表者名　　　　　　　　　㊞</text:p>
      <table:table table:name="協議内容2" table:style-name="FormTable">
        <table:table-column table:style-name="FormColumnWide"/>
        <table:table-column table:style-name="FormColumnNarrow"/>
        <table:table-row table:style-name="FormHeaderRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="CenteredCellText">協　議　内　容</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="CenteredCellText">協　議　結　果</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="FormBodyRow">
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="CenteredCellText">承認　・　否認</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="SpaceLine"/>
      <text:p text:style-name="RightFields">協議日　　　年　　月　　日</text:p>
      <text:p text:style-name="RightFields">団体名</text:p>
      <text:p text:style-name="RightFields">代表者名　　　　　　　　　㊞</text:p>
      <table:table table:name="協議内容3" table:style-name="FormTable">
        <table:table-column table:style-name="FormColumnWide"/>
        <table:table-column table:style-name="FormColumnNarrow"/>
        <table:table-row table:style-name="FormHeaderRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="CenteredCellText">協　議　内　容</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="CenteredCellText">協　議　結　果</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="FormBodyRow">
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="CenteredCellText">承認　・　否認</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="SpaceLine"/>
      <text:p text:style-name="RightFields"><text:span text:style-name="UnderlinedBlank">協　議　者　　　　　　　　　　　　　印</text:span></text:p>
      <text:p text:style-name="SpaceLine"/>
      <text:p text:style-name="NoteText">※この協議書は、団体及び代表者に責任を問うものではありません。</text:p>
    </office:text>
  </office:body>
</office:document>