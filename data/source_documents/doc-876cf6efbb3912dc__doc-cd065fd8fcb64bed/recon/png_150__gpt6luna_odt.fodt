<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="Noto Sans CJK TC" fo:font-size="12pt"/>
    </style:default-style>
    <style:style style:name="TitleLeft" style:family="paragraph">
      <style:paragraph-properties fo:text-align="left"/>
      <style:text-properties fo:font-family="Noto Sans CJK TC" fo:font-size="20pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="TitleRight" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right"/>
      <style:text-properties fo:font-family="Noto Sans CJK TC" fo:font-size="20pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="FirstHeading" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:text-align="left"/>
      <style:text-properties fo:font-family="Noto Sans CJK TC" fo:font-size="20pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-family="Noto Sans CJK TC" fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="DateLine" style:family="paragraph">
      <style:paragraph-properties fo:text-align="left"/>
      <style:text-properties fo:font-family="Noto Sans CJK TC" fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="TableText" style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%"/>
      <style:text-properties fo:font-family="Noto Sans CJK TC" fo:font-size="13pt"/>
    </style:style>
    <style:style style:name="SectionTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-family="Noto Sans CJK TC" fo:font-size="13pt"/>
    </style:style>
    <style:style style:name="NotesText" style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%"/>
      <style:text-properties fo:font-family="Noto Sans CJK TC" fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="StampText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.25cm"/>
      <style:text-properties fo:font-family="Noto Sans CJK TC" fo:font-size="13pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="1.7cm" fo:margin-bottom="1.7cm" fo:margin-left="1.9cm" fo:margin-right="1.9cm"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties table:align="margins"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="3.6cm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="5.2cm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="3.2cm"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties style:column-width="5.2cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="TopCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="top"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="FirstHeading">財政部北區國稅局</text:p>
      <text:p text:style-name="TitleRight">分局(稽徵所、服務處)</text:p>
      <text:p text:style-name="Subtitle">代理營業人辦理集中購買、撤銷、變更案件申請書及回復表</text:p>
      <text:p text:style-name="DateLine">申請日期：<text:s text:c="4"/>年<text:s text:c="3"/>月<text:s text:c="3"/>日<text:s text:c="5"/>案件編號：</text:p>
      <table:table table:name="Form" table:style-name="FormTable">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-row>
          <table:table-cell table:style-name="TopCell"><text:p text:style-name="TableText">代理人名稱（事務所或核准總繳之總機構）</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText"/></table:table-cell>
          <table:table-cell table:style-name="TopCell"><text:p text:style-name="TableText">負責人姓名</text:p><text:p text:style-name="TableText">身分證字號</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">統一編號</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">聯絡人</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">營業地址</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">聯絡電話</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="SectionTitle">申<text:s text:c="10"/>請<text:s text:c="10"/>事<text:s text:c="10"/>項</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TopCell" table:number-columns-spanned="4">
            <text:p text:style-name="TableText">本代理人（事務所或核准總繳之總機構）因</text:p>
            <text:p text:style-name="TableText">□代理各營業人(附營業人資料表)購買統一發票</text:p>
            <text:p text:style-name="TableText">□變更代理記帳人員</text:p>
            <text:p text:style-name="TableText">□其他（原因：<text:s text:c="12"/>）</text:p>
            <text:p text:style-name="TableText">請惠予同意 □申請(增加)</text:p>
            <text:p text:style-name="TableText"><text:s text:c="15"/>於<text:s text:c="12"/>集中購買統一發票。</text:p>
            <text:p text:style-name="TableText"><text:s text:c="13"/>□撤銷(減少)</text:p>
          </table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="SectionTitle">回<text:s text:c="10"/>復<text:s text:c="10"/>情<text:s text:c="10"/>形</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TopCell" table:number-columns-spanned="4">
            <text:p text:style-name="TableText">貴代理人（事務所或核准總繳之總機構）</text:p>
            <text:p text:style-name="TableText">□申請(增加)<text:s text:c="4"/>集中購買統一發票之節，准予辦理，請查照。</text:p>
            <text:p text:style-name="TableText">□撤銷(減少)</text:p>
          </table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TopCell" table:number-columns-spanned="4">
            <text:p text:style-name="TableText">備註：</text:p>
            <text:p text:style-name="NotesText"><text:s text:c="3"/>一、本申請書及回復表一式 2 聯，第 1 聯交營業人收執，第 2 聯依公文程序</text:p>
            <text:p text:style-name="NotesText"><text:s text:c="8"/>留存歸檔或存稅籍資料袋。</text:p>
            <text:p text:style-name="NotesText"><text:s text:c="3"/>二、未加蓋核發單位戳章或經塗改者無效。</text:p>
          </table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="StampText">核發單位服務台收件戳章：</text:p>
    </office:text>
  </office:body>
</office:document>