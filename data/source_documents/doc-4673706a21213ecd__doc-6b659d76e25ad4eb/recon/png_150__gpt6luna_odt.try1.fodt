      <style:table-cell-properties fo:border="0.5pt solid #999999" fo:background-color="#b7b7b7" fo:padding="0.08cm" fo:wrap-option="wrap" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="NoBorderCell" style:family="table-cell">
