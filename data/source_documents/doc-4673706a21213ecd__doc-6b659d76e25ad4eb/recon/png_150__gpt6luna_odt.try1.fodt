      <style:table-cell-properties fo:border-top="1.5pt solid #666666" fo:border-bottom="0.5pt solid #888888" fo:background-color="#b7b7b7" fo:padding="0.18cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="BreakCell" style:family="table-cell">
