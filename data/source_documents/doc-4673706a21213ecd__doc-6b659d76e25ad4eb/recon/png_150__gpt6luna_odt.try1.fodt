      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="BoldCenter" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:text-align="center" fo:line-height="100%"/>
