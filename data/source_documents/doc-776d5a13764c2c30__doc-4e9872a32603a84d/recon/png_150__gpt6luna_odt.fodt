<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:font-size="12pt" fo:line-height="150%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="2.3cm" fo:margin-bottom="1cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="18pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="PageTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="2.3cm" fo:margin-bottom="0.6cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="18pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:text-align="center" fo:margin-top="2.3cm" fo:margin-bottom="0.6cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="18pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:line-height="140%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="CellText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:line-height="140%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="RedText" style:family="text">
      <style:text-properties fo:color="#ff4b22"/>
    </style:style>
    <style:style style:name="TableStyle" style:family="table">
      <style:table-properties style:width="17.2cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="Column1" style:family="table-column">
      <style:table-column-properties style:column-width="3.3cm"/>
    </style:style>
    <style:style style:name="Column2" style:family="table-column">
      <style:table-column-properties style:column-width="5.8cm"/>
    </style:style>
    <style:style style:name="Column3" style:family="table-column">
      <style:table-column-properties style:column-width="2.5cm"/>
    </style:style>
    <style:style style:name="Column4" style:family="table-column">
      <style:table-column-properties style:column-width="5.6cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0.06cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="DoubleCell" style:family="table-cell">
      <style:table-cell-properties fo:border="1.5pt double #000000" fo:padding="0.06cm" style:vertical-align="middle"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="1.5cm" fo:margin-bottom="1.5cm" fo:margin-left="2.2cm" fo:margin-right="2.2cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">新北市政府辦理原住民創業及所營事業信用保證融資貸款</text:p>
      <text:p text:style-name="Title">申請書</text:p>
      <table:table table:name="ApplicationForm" table:style-name="TableStyle">
        <table:table-column table:style-name="Column1"/>
        <table:table-column table:style-name="Column2"/>
        <table:table-column table:style-name="Column3"/>
        <table:table-column table:style-name="Column4"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">申請人</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">公司/商號</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p text:style-name="CellText"/></table:table-cell>
          <table:covered-table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">負責人</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="2" table:style-name="Cell"><text:p text:style-name="CellText"/></table:table-cell>
          <table:covered-table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">族別</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">申請類型</text:p><text:p text:style-name="CellCenter">( 擇一申請 )</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="Cell">
            <text:p text:style-name="CellText">□創業資金(創業初期需準備資本性之開辦費及營運之週轉性支出)。</text:p>
            <text:p text:style-name="CellText">□營運周轉 ( 購置或租用營運、生產設備或支應場地租用、營運周轉金等事業經營所需 )。</text:p>
            <text:p text:style-name="CellText">□升級轉型 ( 產品改良與創新開發，或升級生產技術、擴大企業規模等項目 )。</text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="Cell"/>
          <table:covered-table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">通訊地址</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="Cell"><text:p text:style-name="CellText"/></table:table-cell>
          <table:covered-table-cell table:style-name="Cell"/>
          <table:covered-table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">聯絡人</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">市內電話</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">電子郵件</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">手機</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">申請資格</text:p></table:table-cell>
          <table:table-cell table:number-columns-spanned="3" table:style-name="Cell">
            <text:p text:style-name="CellText"><text:span text:style-name="RedText">申請本貸款，應符合下列規定：</text:span></text:p>
            <text:p text:style-name="CellText"><text:span text:style-name="RedText">1.□事業負責人已成年。</text:span></text:p>
            <text:p text:style-name="CellText"><text:span text:style-name="RedText">2.所營事業設於本市滿三個月，且符合下列條件之一者：</text:span></text:p>
            <text:p text:style-name="CellText"><text:span text:style-name="RedText">　□符合中小企業認定標準第二條，且於本市辦理公司登記、有限公司登記或商業登記之事業，惟不含金融及保險業、特殊娛樂業。</text:span></text:p>
            <text:p text:style-name="CellText"><text:span text:style-name="RedText">　□於本市辦理合作社登記之公司。</text:span></text:p>
            <text:p text:style-name="CellText"><text:span text:style-name="RedText">　□依商業登記法第五條規定得免辦理登記之小規模商業，且有稅籍登記者。</text:span></text:p>
            <text:p text:style-name="CellText"><text:span text:style-name="RedText">3.□已接受本府原住民個人、機構、法人或團體所營事業諮詢服務。</text:span></text:p>
            <text:p text:style-name="CellText"><text:span text:style-name="RedText">4.□已取得原住民機構、法人或團體證明者。</text:span></text:p>
          </table:table-cell>
          <table:covered-table-cell table:style-name="Cell"/>
          <table:covered-table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body">檢附以下書件：</text:p>
      <text:p text:style-name="Body">□貸款計畫書 1 份。</text:p>
      <text:p text:style-name="Body">□申請人身分證正反面影本及戶籍謄本各 1 份。</text:p>
      <text:p text:style-name="Body">□稅籍登記證明或公司登記、商業登記或合作社登記證明文件 1 份。</text:p>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="PageStart">新北市政府辦理原住民創業及所營事業信用保證融資貸款</text:p>
      <text:p text:style-name="PageTitle">申請書</text:p>
      <text:p text:style-name="Body">□原住民機構、法人或團體證明書 1 份。</text:p>
      <text:p text:style-name="Body">□切結書 1 份。</text:p>
      <text:p text:style-name="Body">□聯徵查詢同意書-法人或負責人 1 份。</text:p>
      <text:p text:style-name="Body">□委託書-國稅無欠稅證明、委託書-地方稅無欠稅證明各 1 份。</text:p>
      <text:p text:style-name="Body">□貸款計畫諮詢服務報告書 1 份。</text:p>
      <text:p text:style-name="Body">□財團法人金融聯合徵信中心綜合信用報告 1 份 ( <text:span text:style-name="RedText">事業體及負責人各 1 份</text:span> )。</text:p>
      <text:p text:style-name="Body">　　本府代為調查，申請人免自行檢附之文件：</text:p>
      <text:p text:style-name="Body">　　※　　戶籍謄本。</text:p>
      <text:p text:style-name="Body">　　※　　最近三年內之納稅記錄。</text:p>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Body" fo:text-align="center">以上各項資料及所檢附之文件均屬實際發生</text:p>
      <text:p text:style-name="Body">　　※　　承貸銀行得參考貸款審查會議結論並依承貸銀行相關核貸規範</text:p>
      <text:p text:style-name="Body">　　　　　有授信案之最終核決權。</text:p>
      <text:p text:style-name="Body"><text:span text:style-name="Body">申 請 人（公司/商號）：</text:span></text:p>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Body"/>
      <text:p text:style-name="Body" fo:text-align="end">（請加蓋公司/商業大小章）</text:p>
      <text:p text:style-name="Body">中　華　民　國　　　　年　　　　月　　　　日</text:p>
    </office:text>
  </office:body>
</office:document>