<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0in" fo:line-height="120%"/>
      <style:text-properties style:font-name="Batang" fo:font-size="11pt"/>
    </style:default-style>
    <style:style style:name="Body" style:family="paragraph" style:master-page-name="Standard"/>
    <style:style style:name="TopLabel" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:margin-top="0.35in" fo:margin-bottom="0.08in"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="center" fo:margin-bottom="0.38in"/>
      <style:text-properties fo:font-size="18pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:margin-top="0.12in" fo:margin-bottom="0.10in"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="CenterSmall" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Declaration" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:margin-top="0.22in" fo:line-height="155%"/>
    </style:style>
    <style:style style:name="Attach" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:margin-top="0.20in"/>
    </style:style>
    <style:style style:name="Date" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.22in" fo:margin-bottom="0.20in"/>
    </style:style>
    <style:style style:name="Sign" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="center" fo:margin-bottom="0.22in"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:margin-top="0.20in"/>
      <style:text-properties fo:font-size="14pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="CellLeft" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="left"/>
    </style:style>
    <style:style style:name="GridCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08in" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="GridCellTight" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.04in" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="GridColumn" style:family="table-column">
      <style:table-column-properties style:column-width="1in"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="8.27in" fo:page-height="11.69in" fo:margin-left="0.72in" fo:margin-right="0.72in" fo:margin-top="1.28in" fo:margin-bottom="1.05in"/>
    </style:page-layout>
    <style:style style:name="C1" style:family="table-column">
      <style:table-column-properties style:column-width="0.90in"/>
    </style:style>
    <style:style style:name="C2" style:family="table-column">
      <style:table-column-properties style:column-width="1.50in"/>
    </style:style>
    <style:style style:name="C3" style:family="table-column">
      <style:table-column-properties style:column-width="0.95in"/>
    </style:style>
    <style:style style:name="C4" style:family="table-column">
      <style:table-column-properties style:column-width="1.50in"/>
    </style:style>
    <style:style style:name="C5" style:family="table-column">
      <style:table-column-properties style:column-width="0.80in"/>
    </style:style>
    <style:style style:name="C6" style:family="table-column">
      <style:table-column-properties style:column-width="1.16in"/>
    </style:style>
    <style:style style:name="D1" style:family="table-column">
      <style:table-column-properties style:column-width="1.90in"/>
    </style:style>
    <style:style style:name="D2" style:family="table-column">
      <style:table-column-properties style:column-width="1.25in"/>
    </style:style>
    <style:style style:name="D3" style:family="table-column">
      <style:table-column-properties style:column-width="2.20in"/>
    </style:style>
    <style:style style:name="D4" style:family="table-column">
      <style:table-column-properties style:column-width="1.46in"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="TopLabel">[별지 제1호 서식]</text:p>
      <text:p text:style-name="Title">학습경험 학점인정 신청서</text:p>
      <text:p text:style-name="Section">1. 신청인</text:p>
      <table:table table:name="Applicant">
        <table:table-column table:style-name="C1"/>
        <table:table-column table:style-name="C2"/>
        <table:table-column table:style-name="C3"/>
        <table:table-column table:style-name="C4"/>
        <table:table-column table:style-name="C5"/>
        <table:table-column table:style-name="C6"/>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">대학</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">학과</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">학번</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">학년</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">성명</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">연락처</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Section">2. 신청 대상 및 학점</text:p>
      <table:table table:name="CreditApplication">
        <table:table-column table:style-name="D1"/>
        <table:table-column table:style-name="D2"/>
        <table:table-column table:style-name="D3"/>
        <table:table-column table:style-name="D4"/>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">인정 대상</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">신청 여부</text:p><text:p text:style-name="CellCenter">(해당 사항 체크)</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">신청학점</text:p><text:p text:style-name="CellCenter">(신청학점 기재 / 최대학점)</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">이수 구분</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCellTight" table:number-rows-spanned="2"><text:p text:style-name="CellCenter">국내·외 타 대학 및</text:p><text:p text:style-name="CellCenter">기관학습·연구·실습</text:p><text:p text:style-name="CellCenter">*대학 간 학점교류 포함</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCellTight" table:number-rows-spanned="2"/>
          <table:table-cell table:style-name="GridCellTight"><text:p text:style-name="CellCenter">2023학번 이전</text:p><text:p text:style-name="CellCenter">(　　　학점 / 26학점)</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCellTight" table:number-rows-spanned="2"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridCellTight"><text:p text:style-name="CellCenter">2024학번 이후</text:p><text:p text:style-name="CellCenter">(　　　학점 / 24학점)</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCellTight"><text:p text:style-name="CellCenter">지정된 외부 기관 온라인</text:p><text:p text:style-name="CellCenter">교육(K-MOOC)</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCellTight"/>
          <table:table-cell table:style-name="GridCellTight"><text:p text:style-name="CellCenter">(　　　학점 / 4학점)</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCellTight"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="GridCellTight"><text:p text:style-name="CellCenter">대학이 승인한 특별교육</text:p><text:p text:style-name="CellCenter">프로그램</text:p><text:p text:style-name="CellCenter">* APICS 프로그램 등 포함</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCellTight"/>
          <table:table-cell table:style-name="GridCellTight"><text:p text:style-name="CellCenter">(　　　학점 / 3학점)</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCellTight"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Declaration">위 본인은 추계예술대학교 학습경험 학점인정에 관한 규정에 따라 학습경험 학점인정을 신청합니다. 제출한 증빙자료는 모두 사실이며, 만약 사실과 다르면 학습경험 학점인정 취소 등을 포함한 모든 불이익을 감수할 것을 서약합니다.</text:p>
      <text:p text:style-name="Attach">붙임　인정대상별 증빙자료 각 1부.</text:p>
      <text:p text:style-name="Date">20　　년　　월　　일</text:p>
      <text:p text:style-name="Sign">신청인 성명　　　　(서명 또는 날인)</text:p>
      <text:p text:style-name="Recipient">추계예술대학교 총장 귀하</text:p>
    </office:text>
  </office:body>
</office:document>