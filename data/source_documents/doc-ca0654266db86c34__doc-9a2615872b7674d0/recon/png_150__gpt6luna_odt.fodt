<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:font-size="12pt" fo:line-height="150%" fo:margin="0cm"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end" fo:font-size="12pt" fo:line-height="150%" fo:margin="0cm"/>
    </style:style>
    <style:style style:name="Centered" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:font-size="12pt" fo:line-height="150%" fo:margin="0cm"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:font-size="18pt" fo:font-weight="bold" fo:line-height="150%" fo:margin="0cm"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:font-size="12pt" fo:line-height="100%" fo:margin="0cm"/>
    </style:style>
    <style:style style:name="SecondPageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:font-size="12pt" fo:line-height="100%" fo:margin-top="3.1cm" fo:margin-bottom="0cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-top="2.5cm" fo:margin-bottom="2.5cm" fo:margin-left="2.5cm" fo:margin-right="2.5cm"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="16cm" table:align="center"/>
    </style:style>
    <style:style style:name="LabelCol" style:family="table-column">
      <style:table-column-properties style:column-width="3.45cm"/>
    </style:style>
    <style:style style:name="InputCol" style:family="table-column">
      <style:table-column-properties style:column-width="12.55cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0.12cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="LabelCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.75pt solid #000000" fo:padding="0.12cm" style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart"/>
      <text:p text:style-name="Right">令和　　年　　月　　日</text:p>
      <text:p text:style-name="Body" fo:margin-top="1.35cm">相馬市長</text:p>
      <text:p text:style-name="Right" fo:margin-top="1.1cm">住　　所</text:p>
      <text:p text:style-name="Right" fo:margin-top="1.1cm">氏　　名</text:p>
      <text:p text:style-name="Right" fo:margin-top="1.1cm">担 当 者</text:p>
      <text:p text:style-name="Right" fo:margin-top="0.35cm">電話番号</text:p>
      <text:p text:style-name="Title" fo:margin-top="1.65cm">道　路　使　用　届</text:p>
      <text:p text:style-name="Body" fo:margin-top="0.65cm">下記のとおり道路の使用をしたいので、届出いたします。</text:p>
      <text:p text:style-name="Centered" fo:margin-top="1.15cm" fo:margin-bottom="0.35cm">記</text:p>
      <table:table table:name="FormPageOne" table:style-name="FormTable">
        <table:table-column table:style-name="LabelCol"/>
        <table:table-column table:style-name="InputCol"/>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="Centered">道路の場所</text:p>
            <text:p text:style-name="Centered">（路　線　名）</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="Centered">使　用　目　的</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="Centered">使　用　期</text:p>
            <text:p text:style-name="Centered">間（時 間）</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="Body">令和　　年　　月　　日</text:p>
            <text:p text:style-name="Body">令和　　年　　月　　日</text:p>
            <text:p text:style-name="Centered">（　　　　日間）</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="Centered">実　施　方　法</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="SecondPageStart"/>
      <table:table table:name="FormPageTwo" table:style-name="FormTable">
        <table:table-column table:style-name="LabelCol"/>
        <table:table-column table:style-name="InputCol"/>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="Body">現場責任者及び</text:p>
            <text:p text:style-name="Body">連絡先</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="Centered">添　付　書　類</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell">
            <text:p text:style-name="Body">①位置図　②交通規制図　③作業形態図　④現地写真</text:p>
            <text:p text:style-name="Body">⑤緊急連絡網</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell">
            <text:p text:style-name="Centered">そ　　の　　他</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>