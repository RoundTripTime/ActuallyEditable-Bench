        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">출연,진행자</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">배역,담당</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">연 령</text:p></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">주요경력사항</text:p></table:table-cell></table:table-row>
