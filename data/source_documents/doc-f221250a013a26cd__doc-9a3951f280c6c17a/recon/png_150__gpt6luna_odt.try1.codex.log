        <table:table-row>
          <table:table-cell table:style-name="CellBold"><text:p>Thú cưng</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p>Có　▪　Không　　※Nếu “Có”, điền vào phiếu đăng ký con vật nuôi.</text:p></table:table-cell>
          <table:covered-table-cell/>
