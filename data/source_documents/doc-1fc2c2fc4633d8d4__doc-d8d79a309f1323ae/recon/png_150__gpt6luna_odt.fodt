    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout" style:page-usage="all">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="2cm" fo:margin-bottom="1.6cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
