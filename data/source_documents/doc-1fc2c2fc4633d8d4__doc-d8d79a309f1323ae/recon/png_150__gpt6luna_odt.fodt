        </table:table-row>
        <table:table-row table:style-name="SummaryRowHeight">
          <table:table-cell table:style-name="SummaryCell" table:number-columns-spanned="2"><text:p>區分所有權人比例合計</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="SummaryCell"/>
          <table:table-cell table:style-name="SummaryCell"/>
          <table:table-cell table:style-name="SummaryCell"><text:p>%</text:p></table:table-cell>
