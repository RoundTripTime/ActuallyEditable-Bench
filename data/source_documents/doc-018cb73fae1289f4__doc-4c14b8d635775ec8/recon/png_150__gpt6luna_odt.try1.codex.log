        <table:table-column table:style-name="SignCol"/>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p text:style-name="Right">년　　　월　　　일</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p/></table:table-cell><table:table-cell table:style-name="CenterCell"><text:p>신청인　　　　　　　　(서명 또는 인)</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="Sign">부평구보건소장　귀하</text:p>

