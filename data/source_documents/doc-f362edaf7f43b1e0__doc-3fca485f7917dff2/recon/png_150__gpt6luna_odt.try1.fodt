<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="8pt"/>
    </style:default-style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #999999" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HeadCell" style:family="table-cell" style:parent-style-name="Cell">
      <style:table-cell-properties fo:background-color="#d6e6fb" fo:border="0.5pt solid #999999" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin="0cm" fo:line-height="100%"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin="0cm" fo:line-height="100%"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="14pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="1pt"/>
    </style:style>
    <style:style style:name="MainTable" style:family="table">
      <style:table-properties style:width="16cm" table:align="margins"/>
    </style:style>
    <style:style style:name="WriterTable" style:family="table">
      <style:table-properties style:width="16cm" table:align="margins"/>
    </style:style>
    <style:style style:name="Col" style:family="table-column">
      <style:table-column-properties style:column-width="1.6cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.5cm" fo:margin-bottom="1.5cm" fo:margin-left="2.5cm" fo:margin-right="2.5cm"/>
    </style:page-layout>
    <style:style style:name="PageStartAuto" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="1pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStartAuto"/>
      <table:table table:name="통계기반정책실질평가 요청서" table:style-name="MainTable">
        <table:table-column table:style-name="Col" table:number-columns-repeated="10"/>
        <table:table-row>
          <table:table-cell table:style-name="HeadCell" table:number-columns-spanned="10"><text:p text:style-name="Title">통계기반정책실질평가 요청서</text:p></table:table-cell>
          <table:covered-table-cell table:number-columns-repeated="9"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">법령명</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="8"/>
          <table:covered-table-cell table:number-columns-repeated="7"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">정책명</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="8"><text:p>도입·변경되는 정책이 복수일 경우 각각 기재</text:p></table:table-cell>
          <table:covered-table-cell table:number-columns-repeated="7"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">관련 법령</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="8"><text:p>제·개정되는 정책과 관련된 타 법령 기재</text:p></table:table-cell>
          <table:covered-table-cell table:number-columns-repeated="7"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">국정과제</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="8"><text:p>제·개정되는 정책과 관련된 국정과제 명(번호) 기재</text:p></table:table-cell>
          <table:covered-table-cell table:number-columns-repeated="7"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2" table:number-rows-spanned="3"><text:p text:style-name="Center">구　　분</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Center">제　　정</text:p></table:table-cell>
          <table:covered-table-cell table:number-columns-repeated="3"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Center">개　　정</text:p></table:table-cell>
          <table:covered-table-cell table:number-columns-repeated="3"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:number-columns-repeated="2"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">법률</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">대통령령</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">총리령</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">부령</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">법률</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">대통령령</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">총리령</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">부령</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:number-columns-repeated="2"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2" table:number-rows-spanned="7"><text:p text:style-name="Center">법령(정책)<text:line-break/>소관기관</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">기관명</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="6"/>
          <table:covered-table-cell table:number-columns-repeated="5"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:number-columns-repeated="2"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2" table:number-rows-spanned="3"><text:p text:style-name="Center">총괄부서<text:line-break"/>(검토부서)</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">부서명</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/>
          <table:covered-table-cell table:number-columns-repeated="3"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:number-columns-repeated="4"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">담당자</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/>
          <table:covered-table-cell table:number-columns-repeated="3"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:number-columns-repeated="4"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">직·성명/전화번호</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/>
          <table:covered-table-cell table:number-columns-repeated="3"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:number-columns-repeated="2"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2" table:number-rows-spanned="3"><text:p text:style-name="Center">사업부서<text:line-break"/>(집행부서)</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">부서명</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/>
          <table:covered-table-cell table:number-columns-repeated="3"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:number-columns-repeated="4"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">담당자</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/>
          <table:covered-table-cell table:number-columns-repeated="3"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:number-columns-repeated="4"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">직·성명/전화번호</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/>
          <table:covered-table-cell table:number-columns-repeated="3"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2" table:number-rows-spanned="2"><text:p text:style-name="Center">입법일정(예정)</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">관계기관<text:line-break/>협의기간</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="6"><text:p text:style-name="Center">20　.　.　.부터　20　.　.　.까지(　　일간)</text:p></table:table-cell>
          <table:covered-table-cell table:number-columns-repeated="5"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:number-columns-repeated="4"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">입법예고기간</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="6"><text:p text:style-name="Center">20　.　.　.부터　20　.　.　.까지(　　일간)</text:p></table:table-cell>
          <table:covered-table-cell table:number-columns-repeated="5"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2" table:number-rows-spanned="2"><text:p text:style-name="Center">첨부자료</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">법령자료</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="6"><text:p>법령안 전문 및 제·개정내용, 신·구조문 대비표, 법령안 설명자료</text:p></table:table-cell>
          <table:covered-table-cell table:number-columns-repeated="5"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:number-columns-repeated="4"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">정책자료</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="6"><text:p>정책 관련 참고자료, 관련 통계(승인통계, 행정자료, 내부 보유자료 등)</text:p></table:table-cell>
          <table:covered-table-cell table:number-columns-repeated="5"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">실질평가에 대한<text:line-break/>소관기관 의견</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="8"><text:p>◦ 정책에 필요한 통계지표 구비, 통계개발·개선계획 필요성 여부를 기재</text:p></table:table-cell>
          <table:covered-table-cell table:number-columns-repeated="7"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2" table:number-rows-spanned="3"><text:p text:style-name="Center">정<text:line-break/>책<text:line-break/>1</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">도입/변경되<text:line-break"/>는 정책의<text:line-break"/>주요내용</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="6">
            <text:p>▪ 정책명</text:p><text:p>▪ 정책 목적 및 필요성</text:p><text:p>▪ 정책의 주요내용</text:p><text:p>　- 도입근거</text:p><text:p>　- 추진방향</text:p><text:p>　- 세부내용(현행/변경)</text:p><text:p>▪ 기대효과</text:p>
          </table:table-cell>
          <table:covered-table-cell table:number-columns-repeated="5"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:number-columns-repeated="4"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">집행/평가<text:line-break/>단계별<text:line-break/>통계지표</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="6">
            <text:p>▪ 통계지표</text:p><text:p>　- 지표구분(집행/평가 지표)</text:p><text:p>　- 유용성</text:p><text:p>　- 정보출처</text:p><text:p>　- 작성방식</text:p>
          </table:table-cell>
          <table:covered-table-cell table:number-columns-repeated="5"/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:number-columns-repeated="4"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">통계개발·<text:line-break/>개선계획</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="6">
            <text:p>▪ 통계지표명</text:p><text:p>▪ 통계작성 및 자료수집방법: □ 조사　□ 보고　□ 가공</text:p><text:p>▪ 통계작성 목적</text:p><text:p>▪ 법적근거</text:p><text:p>▪ 통계작성 대상</text:p><text:p>▪ 통계작성 사항</text:p><text:p>▪ 통계작성 주기</text:p><text:p>▪ 통계작성 체계</text:p><text:p>▪ 추진일정(계획수립, 조사시기, 공표시기 등)</text:p>
          </table:table-cell>
          <table:covered-table-cell table:number-columns-repeated="5"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">2</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">⋮</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <table:table table:name="작성자" table:style-name="WriterTable">
        <table:table-column table:style-name="Col" table:number-columns-repeated="10"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2" table:number-rows-spanned="2"><text:p text:style-name="Center">작성자</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">기관명</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">부서명</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">직위(직급)</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">성 명</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">전화번호</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell table:number-columns-repeated="2"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>