          <table:table-cell table:style-name="HeadCell" table:number-columns-spanned="2" table:number-rows-spanned="2"><text:p text:style-name="Center">사업부서<text:line-break/>(집행부서)</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="HeadCell" table:number-columns-spanned="3"><text:p text:style-name="Center">부서명</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
