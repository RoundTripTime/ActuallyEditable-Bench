        <table:table-row>
          <table:table-cell table:style-name="HeadCell"><text:p text:style-name="Center">작성자</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell" table:number-columns-spanned="2"><text:p text:style-name="Center">기관명</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="HeadCell" table:number-columns-spanned="2"><text:p text:style-name="Center">부서명</text:p></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="HeadCell" table:number-columns-spanned="2"><text:p text:style-name="Center">직위(직급)</text:p></table:table-cell><table:covered-table-cell/>
