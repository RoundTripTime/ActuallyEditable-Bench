          <table:table-cell table:style-name="HeadCell" table:number-columns-spanned="3"><text:p text:style-name="Center">담당자<text:line-break/>직·성명/전화번호</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/>
