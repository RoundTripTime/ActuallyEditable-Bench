<?xml version="1.0" encoding="UTF-8"?>
<office:document
    xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
    xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
    xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
    xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
    office:mimetype="application/vnd.oasis.opendocument.text"
    office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="sans-serif" fo:font-size="10pt"/>
    </style:default-style>
    <style:style style:name="FormText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="sans-serif" fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="FormCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="LabelCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:background-color="#E2F0D9" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="GridTable" style:family="table">
      <style:table-properties style:width="17.6cm" table:align="left" table:border-model="collapsing"/>
    </style:style>
  </office:styles>

  <office:automatic-styles>
    <style:page-layout style:name="PageLayout" style:page-usage="all">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.5cm" fo:margin-bottom="1.5cm" fo:margin-left="1.7cm" fo:margin-right="1.7cm"/>
    </style:page-layout>

    <style:style style:name="StartPage" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0.08cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="SmallLine" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.08cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="TitleParagraph" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="22pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="MetaParagraph" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="SectionHeading" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.28cm" fo:margin-bottom="0.16cm"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="CenteredCell" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="BoldCell" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="LeftCell" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-left="0.1cm" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="BlueNote" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt" fo:font-style="italic" fo:color="#0000FF"/>
    </style:style>
    <style:style style:name="FooterDate" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.45cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="FooterSign" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.45cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0.35cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="18pt"/>
    </style:style>

    <style:style style:name="TopTable" style:family="table">
      <style:table-properties style:width="17.6cm" table:align="left" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="TopWide" style:family="table-column">
      <style:table-column-properties style:column-width="14.4cm"/>
    </style:style>
    <style:style style:name="TopNarrow" style:family="table-column">
      <style:table-column-properties style:column-width="3.2cm"/>
    </style:style>
    <style:style style:name="TopCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.03cm" style:vertical-align="middle"/>
    </style:style>

    <style:style style:name="PCol1" style:family="table-column">
      <style:table-column-properties style:column-width="1.55cm"/>
    </style:style>
    <style:style style:name="PCol2" style:family="table-column">
      <style:table-column-properties style:column-width="2.45cm"/>
    </style:style>
    <style:style style:name="PCol3" style:family="table-column">
      <style:table-column-properties style:column-width="3.15cm"/>
    </style:style>
    <style:style style:name="PCol4" style:family="table-column">
      <style:table-column-properties style:column-width="1.85cm"/>
    </style:style>
    <style:style style:name="PCol5" style:family="table-column">
      <style:table-column-properties style:column-width="8.6cm"/>
    </style:style>
    <style:style style:name="OpLabelCol" style:family="table-column">
      <style:table-column-properties style:column-width="3.1cm"/>
    </style:style>
    <style:style style:name="OpDataCol" style:family="table-column">
      <style:table-column-properties style:column-width="14.5cm"/>
    </style:style>
    <style:style style:name="ContentLabelCol" style:family="table-column">
      <style:table-column-properties style:column-width="2.2cm"/>
    </style:style>
    <style:style style:name="ContentDataCol" style:family="table-column">
      <style:table-column-properties style:column-width="15.4cm"/>
    </style:style>
    <style:style style:name="RowCompact" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.75cm"/>
    </style:style>
    <style:style style:name="RowTall" style:family="table-row">
      <style:table-row-properties style:min-row-height="1cm"/>
    </style:style>
    <style:style style:name="ContentRowShort" style:family="table-row">
      <style:table-row-properties style:min-row-height="1.9cm"/>
    </style:style>
    <style:style style:name="ContentRowLong" style:family="table-row">
      <style:table-row-properties style:min-row-height="4.9cm"/>
    </style:style>
    <style:style style:name="ContentRowFinal" style:family="table-row">
      <style:table-row-properties style:min-row-height="1.8cm"/>
    </style:style>
    <style:style style:name="FooterTable" style:family="table">
      <style:table-properties style:width="17.6cm" table:align="left" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="FooterLeftCol" style:family="table-column">
      <style:table-column-properties style:column-width="11.8cm"/>
    </style:style>
    <style:style style:name="FooterRightCol" style:family="table-column">
      <style:table-column-properties style:column-width="5.8cm"/>
    </style:style>
    <style:style style:name="NoBorderCell" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0cm" style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>

  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>

  <office:body>
    <office:text>
      <text:p text:style-name="StartPage">[별지 제8호서식]</text:p>

      <table:table table:name="서식 제목" table:style-name="TopTable">
        <table:table-column table:style-name="TopWide"/>
        <table:table-column table:style-name="TopNarrow"/>
        <table:table-row>
          <table:table-cell table:style-name="TopCell" table:number-rows-spanned="2">
            <text:p text:style-name="TitleParagraph">개척학기제 제안 과제 신청서</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="TopCell">
            <text:p text:style-name="MetaParagraph">(          ) 학년도</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="TopCell">
            <text:p text:style-name="MetaParagraph">(          ) 학기</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>

      <text:p text:style-name="SectionHeading">1. 제안사항</text:p>
      <table:table table:name="제안사항" table:style-name="GridTable">
        <table:table-column table:style-name="PCol1"/>
        <table:table-column table:style-name="PCol2"/>
        <table:table-column table:style-name="PCol3"/>
        <table:table-column table:style-name="PCol4"/>
        <table:table-column table:style-name="PCol5"/>
        <table:table-row table:style-name="RowCompact">
          <table:table-cell table:style-name="LabelCell" table:number-columns-spanned="2"><text:p text:style-name="BoldCell">과제명</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="3"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowCompact">
          <table:table-cell table:style-name="LabelCell" table:number-rows-spanned="2"><text:p text:style-name="BoldCell">제안자</text:p></table:table-cell>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="BoldCell">성명</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="BoldCell">소속/직위</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="RowCompact">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="BoldCell">연락처</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="3">
            <text:p text:style-name="LeftCell">- 연락처(사무실) :<text:line-break/>- 이메일 :</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="RowCompact">
          <table:table-cell table:style-name="LabelCell" table:number-rows-spanned="2"><text:p text:style-name="BoldCell">지도교수</text:p></table:table-cell>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="BoldCell">성명</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="BoldCell">소속/직위</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="RowCompact">
          <table:covered-table-cell/>
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="BoldCell">연락처</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell" table:number-columns-spanned="3">
            <text:p text:style-name="LeftCell">- 연락처(사무실) :<text:line-break/>- 이메일 :</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>

      <text:p text:style-name="SectionHeading">2. 운영</text:p>
      <table:table table:name="운영" table:style-name="GridTable">
        <table:table-column table:style-name="OpLabelCol"/>
        <table:table-column table:style-name="OpDataCol"/>
        <table:table-row table:style-name="RowTall">
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="BoldCell">인원(최소/최대)</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="RowTall">
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="BoldCell">외부 연계</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="RowTall">
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="BoldCell">이수학점</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
        <table:table-row table:style-name="RowTall">
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="BoldCell">요구역량</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"/>
        </table:table-row>
      </table:table>

      <text:p text:style-name="SectionHeading">3. 내용</text:p>
      <table:table table:name="내용" table:style-name="GridTable">
        <table:table-column table:style-name="ContentLabelCol"/>
        <table:table-column table:style-name="ContentDataCol"/>
        <table:table-row table:style-name="ContentRowShort">
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="BoldCell">제안 배경</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="BlueNote">※ 개척학기제 신청사유</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ContentRowShort">
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="BoldCell">과제 목표</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="BlueNote">※ 필요 시 사진 또는 도표 삽입 가능</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ContentRowLong">
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="BoldCell">과제 내용<text:line-break/>및<text:line-break/>주요 활동</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="BlueNote">※ 필요 시 사진 또는 도표 삽입 가능</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="ContentRowFinal">
          <table:table-cell table:style-name="LabelCell"><text:p text:style-name="BoldCell">예상<text:line-break/>결과물</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="BlueNote">※ 필요 시 사진 또는 도표 삽입 가능</text:p></table:table-cell>
        </table:table-row>
      </table:table>

      <table:table table:name="서명" table:style-name="FooterTable">
        <table:table-column table:style-name="FooterLeftCol"/>
        <table:table-column table:style-name="FooterRightCol"/>
        <table:table-row>
          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="FooterDate">년　　 월　　 일</text:p></table:table-cell>
          <table:table-cell table:style-name="NoBorderCell"><text:p text:style-name="FooterSign">제안자:　　　　　 (인)</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Recipient">경상국립대학교총장 귀하</text:p>
    </office:text>
  </office:body>
</office:document>