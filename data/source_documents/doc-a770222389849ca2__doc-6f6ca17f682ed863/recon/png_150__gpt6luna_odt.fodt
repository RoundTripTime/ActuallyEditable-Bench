<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.35cm" fo:margin-bottom="0.45cm"/>
      <style:text-properties fo:font-size="18pt"/>
    </style:style>
    <style:style style:name="TableP" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="TableCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.6pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="17cm" table:align="center"/>
    </style:style>
    <style:style style:name="C1" style:family="table-column">
      <style:table-column-properties style:column-width="1.7cm"/>
    </style:style>
    <style:style style:name="C2" style:family="table-column">
      <style:table-column-properties style:column-width="2.4cm"/>
    </style:style>
    <style:style style:name="C3" style:family="table-column">
      <style:table-column-properties style:column-width="2.2cm"/>
    </style:style>
    <style:style style:name="C4" style:family="table-column">
      <style:table-column-properties style:column-width="3.6cm"/>
    </style:style>
    <style:style style:name="C5" style:family="table-column">
      <style:table-column-properties style:column-width="2.2cm"/>
    </style:style>
    <style:style style:name="C6" style:family="table-column">
      <style:table-column-properties style:column-width="4.9cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="P">別記様式第２号（第９条関係）</text:p>
      <text:p text:style-name="Title">解体工事事前周知報告書</text:p>
      <text:p text:style-name="Right">年　　　月　　　日</text:p>
      <text:p text:style-name="P">文 京 区 長 殿</text:p>
      <text:p text:style-name="Center">発注者等　住所</text:p>
      <text:p text:style-name="Center">氏名</text:p>
      <text:p text:style-name="Center">（法人にあっては、名称及び代表者の氏名）</text:p>
      <text:p text:style-name="Center">電話</text:p>
      <text:p text:style-name="P">文京区建築物の解体工事の事前周知等に関する指導要綱第９条の規定により、下記のとお</text:p>
      <text:p text:style-name="P">り報告します。</text:p>
      <table:table table:name="解体工事事前周知報告書" table:style-name="FormTable">
        <table:table-column table:style-name="C1"/>
        <table:table-column table:style-name="C2"/>
        <table:table-column table:style-name="C3"/>
        <table:table-column table:style-name="C4"/>
        <table:table-column table:style-name="C5"/>
        <table:table-column table:style-name="C6"/>
        <table:table-row>
          <table:table-cell table:style-name="TableCell" table:number-rows-spanned="5"><text:p text:style-name="TableP">解 体</text:p><text:p text:style-name="TableP">建 築 物</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableP">工事の名称</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="4"/>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableP">敷地の位置</text:p><text:p text:style-name="TableP">（住居表示）</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="4"><text:p text:style-name="TableP">文京区</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableP">建 築 物 の 概 要</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableP">構　造</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"/>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableP">階　数</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableP">地上　　　　　　　階</text:p><text:p text:style-name="TableP">地下　　　　　　　階</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableP">高　さ</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"/>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="Right">ｍ</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableP">延べ面積</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="Right">㎡</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableP">工 事 期 間</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="4"><text:p text:style-name="Center">年　　　月　　　日から　　　年　　　月　　　日まで</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="2" table:number-rows-spanned="3"><text:p text:style-name="TableP">解 体 工 事 施 工 者</text:p><text:p text:style-name="TableP">（元請業者又は自主施工者</text:p><text:p text:style-name="TableP">（法人にあっては、名称及</text:p><text:p text:style-name="TableP">び代表者の氏名））</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="4"><text:p text:style-name="TableP">住所</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="4"><text:p text:style-name="TableP">氏名</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="4"><text:p text:style-name="TableP">電話</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="2"><text:p text:style-name="TableP">現　場　責　任　者</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="2"><text:p text:style-name="TableP">氏名</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableP">電　話</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableP">標　識</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableP">設置年月日</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="2"><text:p text:style-name="Center">年　　　月　　　日</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableP">設置場所</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableP">別紙のとおり</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="TableCell" table:number-rows-spanned="3"><text:p text:style-name="TableP">近 隣</text:p><text:p text:style-name="TableP">説 明</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableP">説 明 時 期</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="4"/>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableP">実 施 方 法</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="4"><text:p text:style-name="TableP">説明会　・　個別訪問　・　その他（　　　　　　　　　　　　　　　　）</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="TableCell"><text:p text:style-name="TableP">説 明 内 容</text:p></table:table-cell>
          <table:table-cell table:style-name="TableCell" table:number-columns-spanned="4"><text:p text:style-name="TableP">別紙のとおり</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="P">【添付書類】</text:p>
      <text:p text:style-name="P">□標識設置場所の写真（遠景及び近景）</text:p>
      <text:p text:style-name="P">□標識の掲示内容</text:p>
      <text:p text:style-name="P">□石綿の分析調査結果書の写し</text:p>
      <text:p text:style-name="P">□標識の設置場所と近隣説明の範囲を案内図に記入したもの</text:p>
      <text:p text:style-name="P">□近隣説明で配布した資料</text:p>
    </office:text>
  </office:body>
</office:document>