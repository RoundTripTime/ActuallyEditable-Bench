<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.2cm" fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-size="20pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.14cm" fo:margin-bottom="0.14cm" fo:line-height="125%"/>
      <style:text-properties fo:font-size="15pt"/>
    </style:style>
    <style:style style:name="BodyIndent" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.8cm" fo:margin-top="0.12cm" fo:margin-bottom="0.12cm" fo:line-height="125%"/>
      <style:text-properties fo:font-size="15pt"/>
    </style:style>
    <style:style style:name="ReminderTitle" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.16cm" fo:margin-bottom="0.08cm"/>
      <style:text-properties fo:font-size="14pt" fo:font-weight="bold" style:text-underline-style="solid"/>
    </style:style>
    <style:style style:name="Reminder" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.06cm" fo:margin-bottom="0.06cm" fo:line-height="125%"/>
      <style:text-properties fo:font-size="13pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Applicant" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.8cm" fo:line-height="125%"/>
      <style:text-properties fo:font-size="15pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-top="2cm" fo:margin-bottom="1.8cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
    </style:page-layout>
    <style:style style:name="Attachments" style:family="table">
      <style:table-properties style:width="100%" table:align="margins"/>
    </style:style>
    <style:style style:name="AttachmentColumn" style:family="table-column">
      <style:table-column-properties style:column-width="8.45cm"/>
    </style:style>
    <style:style style:name="AttachmentCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #333333" fo:padding="0.18cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:margin-top="0.12cm" fo:margin-bottom="0.12cm" fo:line-height="125%"/>
      <style:text-properties fo:font-size="14pt"/>
    </style:style>
    <style:style style:name="AttachmentCellSmall" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #333333" fo:padding="0.18cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:margin-top="0.08cm" fo:margin-bottom="0.08cm" fo:line-height="120%"/>
      <style:text-properties fo:font-size="13pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">徵收繼承案審查申請書</text:p>
      <text:p text:style-name="Body">受理機關：新北市政府地政局</text:p>
      <text:p text:style-name="Body">主旨：為領取　　　　　　　　　　　工程徵收被繼承人__________所有土</text:p>
      <text:p text:style-name="BodyIndent">地、建築改良物、農林作物徵收補償費，申請徵收繼承案件審查。</text:p>
      <text:p text:style-name="Body">說明：</text:p>
      <text:p text:style-name="BodyIndent">一、土地坐落：　　區　　段　　小段　　　　　地號。</text:p>
      <text:p text:style-name="BodyIndent">二、建物坐落：　　區　　　路/街　　段　　巷　　弄</text:p>
      <text:p text:style-name="BodyIndent">　　　　　　　　　號　樓。</text:p>
      <text:p text:style-name="BodyIndent">三、檢附下列文件：</text:p>
      <table:table table:name="Attachments" table:style-name="Attachments">
        <table:table-column table:style-name="AttachmentColumn"/>
        <table:table-column table:style-name="AttachmentColumn"/>
        <table:table-row>
          <table:table-cell table:style-name="AttachmentCell"><text:p>1. 繼承系統表　份。</text:p></table:table-cell>
          <table:table-cell table:style-name="AttachmentCell"><text:p>2. 除戶謄本　份。</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="AttachmentCell"><text:p>3. 繼承人現戶戶籍謄本　份。</text:p></table:table-cell>
          <table:table-cell table:style-name="AttachmentCellSmall"><text:p>4. 印鑑證明　份。（以一年內核發者為限，遺產分割協議者須檢附）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="AttachmentCell"><text:p>5. 新北市政府函通知影本　份。</text:p></table:table-cell>
          <table:table-cell table:style-name="AttachmentCell"><text:p>6. 切結書　份。</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="AttachmentCell"><text:p>7. 委託書　份。</text:p></table:table-cell>
          <table:table-cell table:style-name="AttachmentCell"><text:p>8. 遺產分割協議書　份。</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="AttachmentCell"><text:p>9. 其他。</text:p></table:table-cell>
          <table:table-cell table:style-name="AttachmentCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="ReminderTitle">貼心提醒您</text:p>
      <text:p text:style-name="Reminder">徵收補償費之領取，無論男女均得依民法第1138條規定之遺產繼承人相關順序繼承之；</text:p>
      <text:p text:style-name="Reminder">同性配偶亦有相互繼承之權利，互為法定繼承人，準用民法繼承編相關規定。</text:p>
      <text:p text:style-name="Applicant">申　請　人：</text:p>
      <text:p text:style-name="Applicant">身分證字號：</text:p>
      <text:p text:style-name="Applicant">住　址：</text:p>
      <text:p text:style-name="Applicant">通　訊　處：</text:p>
      <text:p text:style-name="Applicant">聯絡電話：</text:p>
      <text:p text:style-name="Body">中華民國　年　月　日</text:p>
    </office:text>
  </office:body>
</office:document>