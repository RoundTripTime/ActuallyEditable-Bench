          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">□동의함</text:p><text:p text:style-name="Small">□동의하지 않음</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">□동의함</text:p><text:p text:style-name="Small">□동의하지 않음</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">□동의함</text:p><text:p text:style-name="Small">□동의하지 않음</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">□동의함</text:p><text:p text:style-name="Small">□동의하지 않음</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">□동의함</text:p><text:p text:style-name="Small">□동의하지 않음</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">□동의함</text:p><text:p text:style-name="Small">□동의하지 않음</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">□동의함</text:p><text:p text:style-name="Small">□동의하지 않음</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">□동의함</text:p><text:p text:style-name="Small">□동의하지 않음</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">□동의함</text:p><text:p text:style-name="Small">□동의하지 않음</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">□동의함</text:p><text:p text:style-name="Small">□동의하지 않음</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">□동의함</text:p><text:p text:style-name="Small">□동의하지 않음</text:p></table:table-cell>
