      <text:p text:style-name="Start">（ 様式 第 2 号 ）</text:p>
      <text:p text:style-name="Title">育 成(子ども)会</text:p>
      <text:p text:style-name="Subtitle">令和　　年度 予算書・令和　　年度(前年度) 決算書</text:p>
      <text:p text:style-name="Section">［ 収　入 ］</text:p>
      <text:p text:style-name="Unit">単位：円</text:p>
      <table:table table:name="収入" table:style-name="IncomeTable">
        <table:table-column table:style-name="ICol1"/>
        <table:table-column table:style-name="ICol2"/>
        <table:table-column table:style-name="ICol3"/>
        <table:table-column table:style-name="ICol4"/>
        <table:table-row table:style-name="IncomeHeaderRow">
          <table:table-cell table:style-name="HeadCell"><text:p text:style-name="CellCenter">科　目</text:p></table:table-cell>
          <table:table-cell table:style-name="HeadCell">
            <text:p text:style-name="CellCenter">令和　年度</text:p>
            <text:p text:style-name="CellCenter">予　算　額</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="HeadCell">
            <text:p text:style-name="CellCenter">令和　年度</text:p>
            <text:p text:style-name="CellCenter">（前年度）</text:p>
            <text:p text:style-name="CellCenter">決　算　額</text:p>
