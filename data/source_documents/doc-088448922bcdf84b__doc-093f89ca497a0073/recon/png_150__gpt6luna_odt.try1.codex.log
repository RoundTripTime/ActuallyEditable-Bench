        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">航　　　空　　　機</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">車　両　及　び　運　搬　具</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText">工具、器具及び備品</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText"/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="TableText"/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="TableText">合　計</text:p></table:table-cell>
          <table:covered-table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="TableText"/></table:table-cell>
          <table:covered-table-cell table:style-name="Cell"/>
          <table:covered-table-cell table:style-name="Cell"/>
          <table:covered-table-cell table:style-name="Cell"/>
