<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:default-style>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Start" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="1.1cm" fo:margin-bottom="1cm"/>
      <style:text-properties fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="Amount" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="1.7cm" fo:margin-bottom="0.5cm"/>
      <style:text-properties fo:font-size="22pt"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Col" style:family="table-column">
      <style:table-column-properties style:column-width="2.25cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout" style:page-usage="all">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.8cm" fo:margin-bottom="1.8cm" fo:margin-left="1.9cm" fo:margin-right="1.9cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Start">様式２号</text:p>
      <text:p text:style-name="P"><text:tab/>美作市長　　　様　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　年　　　月　　　日</text:p>
      <text:p text:style-name="P"><text:tab/><text:tab/><text:tab/><text:tab/><text:tab/>請求者　住所　____________________________________</text:p>
      <text:p text:style-name="P"><text:tab/><text:tab/><text:tab/><text:tab/><text:tab/>　　　　氏名　____________________________________　印</text:p>
      <text:p text:style-name="P"><text:tab/><text:tab/><text:tab/><text:tab/><text:tab/>　　　　電話番号____________________________________</text:p>
      <text:p text:style-name="Title">美作市がん患者医療用補整具（アピアランスケア）助成金請求書</text:p>
      <text:p text:style-name="P">　　美作市がん患者医療用補整具（アピアランスケア）助成金交付要綱第９条の規定により助成金を</text:p>
      <text:p text:style-name="P">請求します。</text:p>
      <text:p text:style-name="Amount">請求額</text:p>
      <text:p text:style-name="P"><text:tab/><text:tab/>￥____________________________________________________________________円</text:p>
      <table:table table:name="対象者購入額">
        <table:table-column table:style-name="Col" table:number-columns-repeated="8"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2"><text:p text:style-name="Center">助成対象者</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">フリガナ</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">生年月日</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">氏名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Center">□請求者に同じ</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">年　　　月　　　日</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">住所</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="6"><text:p>美作市　　　　　　　　　　　　　　　　　　　　　　　　　□請求者に同じ</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2"><text:p text:style-name="Center">購入額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p>医療用ウィッグ等</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p>補整具等</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Right">円</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Small">口座振込先</text:p>
      <table:table table:name="口座振込先">
        <table:table-column table:style-name="Col" table:number-columns-repeated="8"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="6"><text:p text:style-name="Center">指定口座</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2"><text:p text:style-name="Center">銀行等</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2"><text:p text:style-name="Center">金融機関名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Center">銀行　農協<br/>金庫　組合</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">本・店・支</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p/></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2"><text:p text:style-name="Center">口座番号</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">預金種別</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Center">普通　・　当座</text:p></table:cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="6"><text:p>　　　　　　　　　　　</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Center">郵便局（ゆうちょ銀行）</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">記号<br/>（５ケタ）</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p text:style-name="Center">番号<br/>（８ケタ）</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Center">金融機関コード</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p text:style-name="Center">店舗コード</text:p></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2"><text:p text:style-name="Center">口座名義</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">カ　ナ</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">名　義　人</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>