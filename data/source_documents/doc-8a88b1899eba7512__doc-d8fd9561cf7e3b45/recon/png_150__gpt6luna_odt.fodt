<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%" fo:margin-top="0cm" fo:margin-bottom="0.12cm"/>
      <style:text-properties fo:font-family="sans-serif" fo:font-size="12pt" fo:color="#263f39"/>
    </style:default-style>
    <style:style style:name="Kicker" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.32cm"/>
      <style:text-properties fo:font-size="32pt" fo:font-weight="normal"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.32cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="BodyLine" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="BlockEnd" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.32cm"/>
    </style:style>
    <style:style style:name="SectionHead" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.27cm" fo:margin-bottom="0.28cm"/>
      <style:text-properties fo:font-size="12pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="GuideHead" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.25cm" fo:margin-bottom="0.24cm"/>
      <style:text-properties fo:font-size="12pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="ListLine" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.27cm"/>
    </style:style>
    <style:style style:name="FooterText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin="1.7cm"/>
    </style:page-layout>
    <style:style style:name="InvoiceTable" style:family="table">
      <style:table-properties table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ColDescription" style:family="table-column">
      <style:table-column-properties style:column-width="8.9cm"/>
    </style:style>
    <style:style style:name="ColQuantity" style:family="table-column">
      <style:table-column-properties style:column-width="2.95cm"/>
    </style:style>
    <style:style style:name="ColPrice" style:family="table-column">
      <style:table-column-properties style:column-width="2.9cm"/>
    </style:style>
    <style:style style:name="ColTotal" style:family="table-column">
      <style:table-column-properties style:column-width="2.85cm"/>
    </style:style>
    <style:style style:name="HeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#e9eeea" fo:border="0.5pt solid #222222" fo:padding="0.18cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="DataCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #222222" fo:padding="0.18cm" style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout">
      <style:footer>
        <text:p text:style-name="FooterText">Ostro templates  ·  1</text:p>
      </style:footer>
    </style:master-page>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Kicker">OSTRO / WORKING TEMPLATES</text:p>
      <text:p text:style-name="Title">Agency invoice</text:p>
      <text:p text:style-name="Subtitle">Editable template · replace every bracketed field before use</text:p>
      <text:p text:style-name="BodyLine">From: [your billing name and address]</text:p>
      <text:p text:style-name="BodyLine">Bill to: [client billing name and address]</text:p>
      <text:p text:style-name="BlockEnd">Business / tax identifiers: [add where required]</text:p>
      <text:p text:style-name="BodyLine">Invoice: [unique reference]</text:p>
      <text:p text:style-name="BodyLine">Issued: [date]</text:p>
      <text:p text:style-name="BodyLine">Due: [agreed due date]</text:p>
      <text:p text:style-name="BlockEnd">Currency: [currency code]</text:p>
      <table:table table:name="InvoiceLines" table:style-name="InvoiceTable">
        <table:table-column table:style-name="ColDescription"/>
        <table:table-column table:style-name="ColQuantity"/>
        <table:table-column table:style-name="ColPrice"/>
        <table:table-column table:style-name="ColTotal"/>
        <table:table-row>
          <table:table-cell table:style-name="HeaderCell"><text:p>Description</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p>Quantity</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p>Unit price</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p>Line total</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="DataCell"><text:p>Campaign creative and design</text:p></table:table-cell>
          <table:table-cell table:style-name="DataCell"><text:p>[quantity]</text:p></table:table-cell>
          <table:table-cell table:style-name="DataCell"><text:p>[price]</text:p></table:table-cell>
          <table:table-cell table:style-name="DataCell"><text:p>[amount]</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="DataCell"><text:p>Landing-page copywriting</text:p></table:table-cell>
          <table:table-cell table:style-name="DataCell"><text:p>[quantity]</text:p></table:table-cell>
          <table:table-cell table:style-name="DataCell"><text:p>[price]</text:p></table:table-cell>
          <table:table-cell table:style-name="DataCell"><text:p>[amount]</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="DataCell"><text:p>Approved external illustration cost</text:p></table:table-cell>
          <table:table-cell table:style-name="DataCell"><text:p>[quantity]</text:p></table:table-cell>
          <table:table-cell table:style-name="DataCell"><text:p>[price]</text:p></table:table-cell>
          <table:table-cell table:style-name="DataCell"><text:p>[amount]</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="BodyLine">Subtotal: [amount]</text:p>
      <text:p text:style-name="BodyLine">Discount, if agreed: [amount]</text:p>
      <text:p text:style-name="BodyLine">Tax, if applicable: [rate and amount]</text:p>
      <text:p text:style-name="BodyLine">Total: [amount]</text:p>
      <text:p text:style-name="BodyLine">Paid: [amount]</text:p>
      <text:p text:style-name="BlockEnd">Balance due: [amount]</text:p>
      <text:p text:style-name="SectionHead">Payment instructions</text:p>
      <text:p text:style-name="BlockEnd">[Enter the exact receiving instructions and payment reference for your agreed route.]</text:p>
      <text:p text:style-name="SectionHead">Notes and terms</text:p>
      <text:p text:style-name="BlockEnd">[Add your agreed payment terms and any invoice notes.]</text:p>
      <text:p text:style-name="GuideHead">Editing guidance — remove before sending</text:p>
      <text:p text:style-name="BodyLine">Word totals are entered manually. Check all arithmetic, applicable tax details and the agreed payment terms.</text:p>
      <text:p text:style-name="BlockEnd">For automatic calculations, use the Ostro invoice generator.</text:p>
      <text:p text:style-name="GuideHead">Before sending — remove this checklist</text:p>
      <text:p text:style-name="ListLine">• Check each workstream against the approved quote.</text:p>
      <text:p text:style-name="ListLine">• Avoid double-counting costs already included in a project fee.</text:p>
      <text:p text:style-name="ListLine">• Include the billing contact and any required supplier reference.</text:p>
      <text:p text:style-name="BlockEnd">Template and example: https://tryostro.com/templates/agency-invoice/</text:p>
    </office:text>
  </office:body>
</office:document>