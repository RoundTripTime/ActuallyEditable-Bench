<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="P" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.25cm" fo:margin-bottom="0.2cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="15pt"/>
    </style:style>
    <style:style style:name="Page2Start" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0.15cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.15cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.12cm" fo:line-height="120%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.06cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-family="serif" fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="ColA" style:family="table-column">
      <style:table-column-properties style:column-width="3cm"/>
    </style:style>
    <style:style style:name="ColB" style:family="table-column">
      <style:table-column-properties style:column-width="5.3cm"/>
    </style:style>
    <style:style style:name="ColC" style:family="table-column">
      <style:table-column-properties style:column-width="9.2cm"/>
    </style:style>
    <style:style style:name="ColLand" style:family="table-column">
      <style:table-column-properties style:column-width="6.5cm"/>
    </style:style>
    <style:style style:name="ColNarrow" style:family="table-column">
      <style:table-column-properties style:column-width="1.3cm"/>
    </style:style>
    <style:style style:name="ColArea" style:family="table-column">
      <style:table-column-properties style:column-width="4.2cm"/>
    </style:style>
    <style:style style:name="ColRemarks" style:family="table-column">
      <style:table-column-properties style:column-width="4.2cm"/>
    </style:style>
    <style:style style:name="T" style:family="table">
      <style:table-properties table:border-model="collapsing"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-left="1.5cm" fo:margin-right="1.5cm" fo:margin-top="1.4cm" fo:margin-bottom="1.4cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="P">様式第９号の６</text:p>
      <text:p text:style-name="Title">農地法第１８条第６項の規定による通知書</text:p>
      <text:p text:style-name="P">
        <text:s text:c="22"/>令和<text:s text:c="5"/>年<text:s text:c="5"/>月<text:s text:c="5"/>日
      </text:p>
      <text:p text:style-name="P">
        <text:s text:c="2"/>東近江市農業委員会会長　殿
        <text:s text:c="8"/>通知者　（賃貸人）　住所
      </text:p>
      <text:p text:style-name="P">
        <text:s text:c="37"/>氏名
        <text:s text:c="25"/>印
      </text:p>
      <text:p text:style-name="P">
        <text:s text:c="41"/>（賃借人）　住所
      </text:p>
      <text:p text:style-name="P">
        <text:s text:c="37"/>氏名
        <text:s text:c="25"/>印
      </text:p>
      <text:p text:style-name="P">下記土地について賃貸借の合意解約をしたので、農地法第１８条第６項の規定により通知します。</text:p>
      <text:p text:style-name="Center">記</text:p>
      <text:p text:style-name="Section">１　賃貸借の当事者の氏名等</text:p>
      <table:table table:name="当事者" table:style-name="T">
        <table:table-column table:style-name="ColA"/>
        <table:table-column table:style-name="ColB"/>
        <table:table-column table:style-name="ColC"/>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter"><text:p>当事者の別</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>氏　名</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>住　所</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter"><text:p>賃　貸　人</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter"><text:p>賃　借　人</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Section">２　土地の所在等</text:p>
      <table:table table:name="土地" table:style-name="T">
        <table:table-column table:style-name="ColLand"/>
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-column table:style-name="ColNarrow"/>
        <table:table-column table:style-name="ColArea"/>
        <table:table-column table:style-name="ColRemarks"/>
        <table:table-row>
          <table:table-cell table:style-name="CellCenter" table:number-rows-spanned="2"><text:p>所在・地番</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter" table:number-columns-spanned="2"><text:p>地　目</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter" table:number-rows-spanned="2"><text:p>面積（㎡）</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter" table:number-rows-spanned="2"><text:p>備　考</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellCenter"><text:p>台　帳</text:p></table:table-cell>
          <table:table-cell table:style-name="CellCenter"><text:p>現　況</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Section">３　賃貸借契約の内容</text:p>
      <text:p text:style-name="P">（１）農地法第３条　（２）農業経営基盤強化促進法　（３）農地中間管理事業の推進に関する法律</text:p>
      <text:p text:style-name="Section">４　農地法第１８条第１項ただし書に該当する事由の詳細</text:p>
      <text:p text:style-name="P"><text:s text:c="5"/>土地を引渡すこととなる期限前６ヶ月以内に成立した合意解約</text:p>
      <text:p text:style-name="Section">５　賃貸借の解約の申入れ等をした日</text:p>
      <text:p text:style-name="P"><text:s text:c="4"/>①賃貸借の解約の申入れをした日<text:s text:c="14"/>令和<text:s text:c="3"/>年<text:s text:c="3"/>月<text:s text:c="3"/>日</text:p>
      <text:p text:style-name="P"><text:s text:c="4"/>②賃貸借の更新拒絶の通知をした日<text:s text:c="14"/>令和<text:s text:c="3"/>年<text:s text:c="3"/>月<text:s text:c="3"/>日</text:p>
      <text:p text:style-name="P"><text:s text:c="4"/>③賃貸借の合意解約の合意が成立した日<text:s text:c="11"/>令和<text:s text:c="3"/>年<text:s text:c="3"/>月<text:s text:c="3"/>日</text:p>
      <text:p text:style-name="P"><text:s text:c="4"/>④賃貸借の合意による解約をした日<text:s text:c="14"/>令和<text:s text:c="3"/>年<text:s text:c="3"/>月<text:s text:c="3"/>日</text:p>
      <text:p text:style-name="Section">６　土地の引渡しの時期<text:s text:c="20"/>令和<text:s text:c="3"/>年<text:s text:c="3"/>月<text:s text:c="3"/>日</text:p>
      <text:p text:style-name="Section">７　その他参考となるべき事項</text:p>
      <text:p text:style-name="P"><text:s text:c="5"/>解約後の農地の利用計画（該当するものに○を付して下さい）</text:p>
      <text:p text:style-name="P"><text:s text:c="5"/>①貸し替え　②貸し替え（中間管理機構）　③自作　④売買　⑤転用　⑥利用予定なし</text:p>
      <text:p text:style-name="Page2Start">（記載要領）</text:p>
      <text:p text:style-name="Note">１　本⽂には解約の申入れ、更新拒絶の通知、合意解約等該当する用語を記載してください。（合意解約の場合は「通知者氏名」のところに当事者双方が連署してください。）</text:p>
      <text:p text:style-name="Note">２　通知者の氏名（法人にあってはその代表者の氏名）の記載を自署する場合においては、押印を省略することができます。</text:p>
      <text:p text:style-name="Note">３　法人である場合は、住所は主たる事務所の所在地を、氏名は法人の名称及び代表者の氏名をそれぞれ記載してください。</text:p>
      <text:p text:style-name="Note">４　記の３の「賃貸借契約の内容」については、別紙賃貸借契約書の写しのとおり記載し、賃貸借契約書の写しを添付してください。</text:p>
      <text:p text:style-name="Note">５　記の５の「賃貸借の解約の申入れ等をした日」については、該当事項にその年月日を記入しますが、合意解約の場合にあっては、その合意が成立した日及びその合意による解約をした日の双方に記載してください。</text:p>
    </office:text>
  </office:body>
</office:document>