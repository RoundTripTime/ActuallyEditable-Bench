<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:line-height="150%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:default-style>
    <style:style style:name="Seal" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="3cm" fo:margin-top="0.4cm" fo:margin-bottom="2.7cm"/>
      <style:text-properties fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.2cm" fo:margin-bottom="0.7cm"/>
      <style:text-properties fo:font-size="15pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="7.2cm" fo:margin-bottom="1.7cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="NameLine" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="10.2cm" fo:margin-bottom="0.2cm"/>
    </style:style>
    <style:style style:name="RightSeal" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end" fo:margin-bottom="0.6cm"/>
      <style:text-properties fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.4cm" fo:margin-bottom="0.2cm"/>
    </style:style>
    <style:style style:name="Subsection" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.5cm" fo:margin-bottom="0.2cm"/>
    </style:style>
    <style:style style:name="SpacedSubsection" style:family="paragraph">
      <style:paragraph-properties fo:margin-left="0.5cm" fo:margin-top="3cm" fo:margin-bottom="0.2cm"/>
    </style:style>
    <style:style style:name="WideGap" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="5cm" fo:margin-bottom="0.2cm"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-left="2cm" fo:margin-top="0.4cm" fo:margin-bottom="1.2cm"/>
      <style:text-properties fo:font-size="16pt"/>
    </style:style>
    <style:style style:name="TableColumnLabel" style:family="table-column">
      <style:table-column-properties style:column-width="8cm"/>
    </style:style>
    <style:style style:name="TableColumnInput" style:family="table-column">
      <style:table-column-properties style:column-width="2.5cm"/>
    </style:style>
    <style:style style:name="TableColumnUnit" style:family="table-column">
      <style:table-column-properties style:column-width="1.5cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="1.5cm" fo:margin-bottom="1.5cm" fo:margin-left="3cm" fo:margin-right="2cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Seal">◯印</text:p>
      <text:p text:style-name="Title">営農計画書</text:p>
      <text:p text:style-name="Recipient">譲受人（借人）　住所</text:p>
      <text:p text:style-name="NameLine">氏名</text:p>
      <text:p text:style-name="RightSeal">◯印</text:p>
      <table:table table:name="構成人数">
        <table:table-column table:style-name="TableColumnLabel"/>
        <table:table-column table:style-name="TableColumnInput"/>
        <table:table-column table:style-name="TableColumnUnit"/>
        <table:table-row>
          <table:table-cell>
            <text:p>1．構成人数（同一世帯人数）</text:p>
          </table:table-cell>
          <table:table-cell/>
          <table:table-cell>
            <text:p>人</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell>
            <text:p>うち、必要な農作業に常時従事する者</text:p>
          </table:table-cell>
          <table:table-cell/>
          <table:table-cell>
            <text:p>人</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Section">2．経営面積</text:p>
      <table:table table:name="経営面積">
        <table:table-column table:style-name="TableColumnLabel"/>
        <table:table-column table:style-name="TableColumnInput"/>
        <table:table-column table:style-name="TableColumnUnit"/>
        <table:table-column table:style-name="TableColumnInput"/>
        <table:table-column table:style-name="TableColumnInput"/>
        <table:table-column table:style-name="TableColumnUnit"/>
        <table:table-row>
          <table:table-cell>
            <text:p>畑</text:p>
          </table:table-cell>
          <table:table-cell/>
          <table:table-cell>
            <text:p>a,</text:p>
          </table:table-cell>
          <table:table-cell>
            <text:p>計</text:p>
          </table:table-cell>
          <table:table-cell/>
          <table:table-cell>
            <text:p>a</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Subsection">うち、借入地</text:p>
      <table:table table:name="借入地">
        <table:table-column table:style-name="TableColumnLabel"/>
        <table:table-column table:style-name="TableColumnInput"/>
        <table:table-column table:style-name="TableColumnUnit"/>
        <table:table-column table:style-name="TableColumnInput"/>
        <table:table-column table:style-name="TableColumnInput"/>
        <table:table-column table:style-name="TableColumnUnit"/>
        <table:table-row>
          <table:table-cell>
            <text:p>畑</text:p>
          </table:table-cell>
          <table:table-cell/>
          <table:table-cell>
            <text:p>a,</text:p>
          </table:table-cell>
          <table:table-cell>
            <text:p>計</text:p>
          </table:table-cell>
          <table:table-cell/>
          <table:table-cell>
            <text:p>a</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Section">3．営農経営の概要等</text:p>
      <text:p text:style-name="Subsection">（１）現在の経営状況及び年間販売高等</text:p>
      <text:p text:style-name="SpacedSubsection">（２）申請地を取得した後の具体的な営農計画及び年間販売高等</text:p>
      <text:p text:style-name="WideGap">4．農業以外の事業を行っている場合は、その概要</text:p>
      <text:p text:style-name="WideGap">5．取得しようとする農地に必要とする所要労働力及び重要な作業方法等</text:p>
      <text:p text:style-name="Subsection">（１）播種及び植付の方法</text:p>
      <text:p text:style-name="PageBreak">◯印</text:p>
      <text:p text:style-name="Subsection">（２）水利見廻り等一般管理の方法</text:p>
      <text:p text:style-name="SpacedSubsection">（３）施肥、除草等の方法</text:p>
      <text:p text:style-name="SpacedSubsection">（４）病害虫発生等に係る薬剤散布の方法</text:p>
      <text:p text:style-name="SpacedSubsection">（５）収穫の方法</text:p>
      <text:p text:style-name="WideGap">6．他の農地における作業と競合の有無及び対策</text:p>
      <text:p text:style-name="WideGap">7．取得する農地の付近に現に耕作する農地があれば、その表示</text:p>
    </office:text>
  </office:body>
</office:document>