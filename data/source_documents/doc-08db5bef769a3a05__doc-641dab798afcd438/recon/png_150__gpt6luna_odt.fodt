<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#111111"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.15cm"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph">
      <style:text-properties fo:font-family="Arial" fo:font-size="28pt" fo:color="#18375F"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.2cm" fo:border-bottom="1pt solid #5D8CC8" fo:padding-bottom="0.18cm"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#111111"/>
      <style:paragraph-properties fo:margin-top="0.35cm" fo:margin-bottom="0.2cm"/>
    </style:style>
    <style:style style:name="BlueLabel" style:family="paragraph">
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:font-weight="bold" fo:color="#37649A"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="Totals" style:family="paragraph">
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#111111"/>
      <style:paragraph-properties fo:margin-top="0.2cm" fo:margin-bottom="0.18cm"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:color="#111111"/>
      <style:paragraph-properties fo:margin-top="0.12cm" fo:margin-bottom="0.16cm"/>
    </style:style>
    <style:style style:name="Footer" style:family="paragraph">
      <style:text-properties fo:font-family="Arial" fo:font-size="9pt" fo:color="#111111"/>
      <style:paragraph-properties fo:margin-top="9.3cm" fo:margin-bottom="0cm"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.2cm" fo:margin-bottom="1.2cm" fo:margin-left="1.4cm" fo:margin-right="1.4cm"/>
    </style:page-layout>
    <style:style style:name="MetaTable" style:family="table">
      <style:table-properties style:width="18.2cm"/>
    </style:style>
    <style:style style:name="ItemsTable" style:family="table">
      <style:table-properties style:width="18.2cm"/>
    </style:style>
    <style:style style:name="MetaCol" style:family="table-column">
      <style:table-column-properties style:column-width="9.1cm"/>
    </style:style>
    <style:style style:name="ItemCol1" style:family="table-column">
      <style:table-column-properties style:column-width="7.4cm"/>
    </style:style>
    <style:style style:name="ItemCol2" style:family="table-column">
      <style:table-column-properties style:column-width="2.8cm"/>
    </style:style>
    <style:style style:name="ItemCol3" style:family="table-column">
      <style:table-column-properties style:column-width="3.4cm"/>
    </style:style>
    <style:style style:name="ItemCol4" style:family="table-column">
      <style:table-column-properties style:column-width="4.6cm"/>
    </style:style>
    <style:style style:name="MetaCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.06cm 0.18cm" fo:border-bottom="0.5pt solid #5D8CC8"/>
    </style:style>
    <style:style style:name="MetaShade" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#D4E0EF" fo:padding="0.06cm 0.18cm" fo:border-bottom="0.5pt solid #5D8CC8"/>
    </style:style>
    <style:style style:name="MetaValue" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.06cm 0.18cm" fo:border-bottom="0.5pt solid #5D8CC8"/>
    </style:style>
    <style:style style:name="MetaValueShade" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#D4E0EF" fo:padding="0.06cm 0.18cm" fo:border-bottom="0.5pt solid #5D8CC8"/>
    </style:style>
    <style:style style:name="ItemHeadCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.05cm 0.18cm" fo:border-top="1pt solid #5D8CC8" fo:border-bottom="1pt solid #5D8CC8"/>
    </style:style>
    <style:style style:name="ItemFill" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#D4E0EF" fo:padding="0.12cm 0.18cm"/>
    </style:style>
    <style:style style:name="ItemGap" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.16cm 0.18cm"/>
    </style:style>
    <style:style style:name="ItemHeader" style:family="paragraph">
      <style:text-properties fo:font-family="Arial" fo:font-size="11pt" fo:font-weight="bold" fo:color="#37649A"/>
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
    <style:style style:name="SmallPad" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.25cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">Hotel bill</text:p>
      <text:p text:style-name="Subtitle">BLANK TEMPLATE | Currency: INR</text:p>
      <table:table table:name="BillDetails" table:style-name="MetaTable">
        <table:table-column table:style-name="MetaCol"/>
        <table:table-column table:style-name="MetaCol"/>
        <table:table-row>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="BlueLabel">Property</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaValue"><text:p>______________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaShade"><text:p text:style-name="BlueLabel">Guest</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaValueShade"><text:p>______________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="BlueLabel">Invoice / date</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaValue"><text:p>______________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaShade"><text:p text:style-name="BlueLabel">Room</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaValueShade"><text:p>______________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="BlueLabel">Check-in</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaValue"><text:p>______________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaShade"><text:p text:style-name="BlueLabel">Check-out</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaValueShade"><text:p>______________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaCell"><text:p text:style-name="BlueLabel">Payment reference</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaValue"><text:p>______________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="MetaShade"><text:p text:style-name="BlueLabel">Billing basis</text:p></table:table-cell>
          <table:table-cell table:style-name="MetaValueShade"><text:p>______________________________________</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="SmallPad"/>
      <table:table table:name="BillItems" table:style-name="ItemsTable">
        <table:table-column table:style-name="ItemCol1"/>
        <table:table-column table:style-name="ItemCol2"/>
        <table:table-column table:style-name="ItemCol3"/>
        <table:table-column table:style-name="ItemCol4"/>
        <table:table-row>
          <table:table-cell table:style-name="ItemHeadCell"><text:p text:style-name="ItemHeader">Room / service</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHeadCell"><text:p text:style-name="ItemHeader">Quantity</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHeadCell"><text:p text:style-name="ItemHeader">Rate (INR)</text:p></table:table-cell>
          <table:table-cell table:style-name="ItemHeadCell"><text:p text:style-name="ItemHeader">Amount (INR)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ItemFill"/>
          <table:table-cell table:style-name="ItemFill"/>
          <table:table-cell table:style-name="ItemFill"/>
          <table:table-cell table:style-name="ItemFill"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ItemGap"/>
          <table:table-cell table:style-name="ItemGap"/>
          <table:table-cell table:style-name="ItemGap"/>
          <table:table-cell table:style-name="ItemGap"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ItemFill"/>
          <table:table-cell table:style-name="ItemFill"/>
          <table:table-cell table:style-name="ItemFill"/>
          <table:table-cell table:style-name="ItemFill"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ItemGap"/>
          <table:table-cell table:style-name="ItemGap"/>
          <table:table-cell table:style-name="ItemGap"/>
          <table:table-cell table:style-name="ItemGap"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ItemFill"/>
          <table:table-cell table:style-name="ItemFill"/>
          <table:table-cell table:style-name="ItemFill"/>
          <table:table-cell table:style-name="ItemFill"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ItemGap"/>
          <table:table-cell table:style-name="ItemGap"/>
          <table:table-cell table:style-name="ItemGap"/>
          <table:table-cell table:style-name="ItemGap"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="ItemFill"/>
          <table:table-cell table:style-name="ItemFill"/>
          <table:table-cell table:style-name="ItemFill"/>
          <table:table-cell table:style-name="ItemFill"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Totals"><text:span text:style-name="BlueLabel">Subtotal:</text:span> INR __________</text:p>
      <text:p text:style-name="Totals"><text:span text:style-name="BlueLabel">Advance received (deduct):</text:span> INR __________</text:p>
      <text:p text:style-name="Totals"><text:span text:style-name="BlueLabel">Balance due:</text:span> INR __________</text:p>
      <text:p text:style-name="Note">Nights are entered manually from the agreed stay. The example does not calculate tax.</text:p>
      <text:p text:style-name="Note">Confirm actual charges and payments before issuing a bill.</text:p>
      <text:p text:style-name="Note">Word amounts are manual. Check line amounts and totals after every edit.</text:p>
      <text:p text:style-name="Footer">OnlineBiller | Original English resource | Blank template</text:p>
    </office:text>
  </office:body>
</office:document>