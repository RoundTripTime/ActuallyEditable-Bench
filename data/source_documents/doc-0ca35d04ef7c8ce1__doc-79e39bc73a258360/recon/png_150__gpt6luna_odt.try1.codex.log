        <table:table-row>
          <table:table-cell table:style-name="CellSmall"><text:p>□第 3 款</text:p></table:table-cell>
          <table:table-cell table:style-name="CellSmall" table:number-columns-spanned="2"><text:p>公職人員或其配偶信託財產之受託人</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="CellSmall"><text:p>受託人名稱：</text:p></table:table-cell>
