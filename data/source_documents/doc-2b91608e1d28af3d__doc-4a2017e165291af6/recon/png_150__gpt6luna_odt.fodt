<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin="0cm" fo:line-height="120%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="10.5pt" style:font-family-asian="serif" style:font-size-asian="10.5pt"/>
    </style:style>
    <style:style style:name="Attach" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:margin-top="0.4cm" fo:margin-bottom="0.45cm" fo:text-align="start"/>
      <style:text-properties fo:font-size="12pt" style:font-size-asian="12pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:margin-top="0.15cm" fo:margin-bottom="1.15cm" fo:text-align="center" fo:line-height="120%"/>
      <style:text-properties fo:font-family="sans-serif" fo:font-size="22pt" fo:font-weight="bold" style:font-family-asian="sans-serif" style:font-size-asian="22pt" style:font-weight-asian="bold" style:text-underline-style="solid" style:text-underline-type="single"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="center" fo:margin="0cm"/>
    </style:style>
    <style:style style:name="Justify" style:family="paragraph" style:parent-style-name="Body">
      <style:paragraph-properties fo:text-align="justify" fo:margin="0cm" fo:line-height="135%"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.05cm" style:vertical-align="middle"/>
      <style:paragraph-properties fo:margin="0cm" fo:line-height="115%"/>
      <style:text-properties fo:font-family="serif" fo:font-size="10.5pt" style:font-family-asian="serif" style:font-size-asian="10.5pt"/>
    </style:style>
    <style:style style:name="CenterCell" style:family="table-cell" style:parent-style-name="Cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.05cm" style:vertical-align="middle" fo:background-color="#E6E6E6"/>
      <style:paragraph-properties fo:text-align="center" fo:margin="0cm" fo:line-height="115%"/>
    </style:style>
    <style:style style:name="SectionCell" style:family="table-cell" style:parent-style-name="Cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding-left="0.18cm" fo:padding-right="0.08cm" fo:padding-top="0.06cm" fo:padding-bottom="0.06cm" style:vertical-align="middle" fo:background-color="#E6E6E6"/>
      <style:paragraph-properties fo:margin="0cm" fo:line-height="115%"/>
      <style:text-properties fo:font-size="14pt" fo:font-weight="bold" style:font-size-asian="14pt" style:font-weight-asian="bold"/>
    </style:style>
    <style:style style:name="LabelCell" style:family="table-cell" style:parent-style-name="Cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.05cm" style:vertical-align="middle" fo:background-color="#E6E6E6"/>
      <style:paragraph-properties fo:text-align="center" fo:margin="0cm" fo:line-height="140%"/>
      <style:text-properties fo:font-size="12pt" style:font-size-asian="12pt"/>
    </style:style>
    <style:style style:name="Blue" style:family="text">
      <style:text-properties fo:color="#0000FF" style:text-underline-style="solid" style:text-underline-type="single"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-top="1.5cm" fo:margin-bottom="1.5cm" fo:margin-left="1.5cm" fo:margin-right="1.5cm"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="18cm" table:align="center" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="2.3cm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="6.4cm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="2.05cm"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties style:column-width="1.3cm"/>
    </style:style>
    <style:style style:name="Col5" style:family="table-column">
      <style:table-column-properties style:column-width="5.95cm"/>
    </style:style>
    <style:style style:name="SectionRow" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.75cm"/>
    </style:style>
    <style:style style:name="DetailRow" style:family="table-row">
      <style:table-row-properties style:row-height="5.4cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Attach">[붙임1-2]</text:p>
      <text:p text:style-name="Title">공공심야약국 운영계획서</text:p>
      <table:table table:name="운영계획서" table:style-name="FormTable">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-column table:style-name="Col5"/>
        <table:table-row table:style-name="SectionRow">
          <table:table-cell table:style-name="SectionCell" table:number-columns-spanned="5"><text:p>1. 일반 현황</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell" table:number-rows-spanned="4"><text:p>현재</text:p><text:p>근무인력</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>약국개설자:</text:p></table:table-cell>
          <table:table-cell table:style-name="LabelCell" table:number-rows-spanned="4"><text:p>주변환경</text:p><text:p>(주거지역,</text:p><text:p>의료기관)</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>1층 위치 여부: □ 예 □ 아니오</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>상근약사 :</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>5km 이내 주거단지 규모:</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>비상근(시간제)약사 :</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>월평균 처방조제건수 :</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>보조인력 :</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>월평균 일반약매출액 :</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell" table:number-rows-spanned="4"><text:p>현재</text:p><text:p>운영시간</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>평일:</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p>現휴일지킴이 약국 여부 : □ 예 □ 아니오</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>토요일:</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p>現 달빛어린이병원 협력약국 여부: □ 예 □ 아니오</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>일·공휴일:</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p>前 공공심야약국 운영 경험 여부: □ 예 □ 아니오</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>휴무일:</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="3"><text:p>前 공공심야약국 운영 기간:</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="SectionRow">
          <table:table-cell table:style-name="SectionCell" table:number-columns-spanned="5"><text:p>2. 운영 계획</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell" table:number-rows-spanned="7"><text:p>심야시간</text:p><text:p>근무인력</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>약국개설자: 해당없음</text:p></table:table-cell>
          <table:table-cell table:style-name="LabelCell" table:number-rows-spanned="7"><text:p>심야시간</text:p><text:p>운영계획</text:p></table:table-cell>
          <table:table-cell table:style-name="LabelCell" table:number-rows-spanned="3"><text:p>단일</text:p><text:p>기관</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>□ 매일 22시 ~ 익일 1시</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>상근약사: 해당없음</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>□ 매일 21시 ~ 24시</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>비상근(시간제)약사: 2명(교대)</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>□ 매일 20시 ~ 23시</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>보조인력:</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>□ 월 □ 화 □ 수 □ 목 □ 금 □ 토 □ 일·공휴일</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>※비고사항: 채용계획 등</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="LabelCell" table:number-rows-spanned="3"><text:p>연합</text:p><text:p>기관</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>□ 운영일 22시 ~ 일일 1시</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>□ 운영일 21시 ~ 24시</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>□ 운영일 20시 ~ 23시</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="DetailRow">
          <table:table-cell table:style-name="LabelCell"><text:p>세부</text:p><text:p>운영계획</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="LabelCell" table:number-rows-spanned="2"><text:p>사업참여</text:p><text:p>의지계획</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Justify">본인은 약사법 제21조의3(공공심야약국 지정·운영 등)에 따른 공공심야약국을 지정받기를 희망하며, 상기 운영 계획에 따라 사업에 참여하여, 정해진 운영시간과 준수사항을 이행하여 지역주민의 의약품 접근성을 높이는 데 사회적 역할과 책임을 다하고, 정부의 공공심야약국 지정·운영 사업의 효과적 수행을 위해 최선의 노력과 협조를 다하겠습니다.</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="4"><text:p text:style-name="Center">년<text:tab/>월<text:tab/>일<text:tab/><text:tab/>약국 개설자<text:tab/><text:span text:style-name="Blue">(서명)</text:span></text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>