<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Base" style:family="paragraph">
      <style:paragraph-properties fo:font-size="12pt" fo:line-height="120%"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:break-before="page" fo:margin-left="4mm" fo:margin-top="0mm" fo:margin-bottom="5mm"/>
    </style:style>
    <style:style style:name="TitleLine" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0mm" fo:margin-bottom="2mm"/>
    </style:style>
    <style:style style:name="TitleSecond" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:text-align="center" fo:margin-bottom="12mm"/>
    </style:style>
    <style:style style:name="Club" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:text-align="right" fo:margin-right="35mm" fo:margin-bottom="4mm"/>
      <style:text-properties style:text-underline-style="solid"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:margin-left="4mm" fo:margin-bottom="3mm"/>
    </style:style>
    <style:style style:name="Subsection" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:margin-left="6mm" fo:margin-bottom="1mm"/>
    </style:style>
    <style:style style:name="CellText" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0mm" fo:margin-bottom="0mm" fo:line-height="100%"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="2.5cm" fo:margin-bottom="2cm" fo:margin-left="2.5cm" fo:margin-right="2.5cm"/>
    </style:page-layout>
    <style:style style:name="TableOne" style:family="table">
      <style:table-properties style:width="143mm" table:align="left" fo:margin-left="15mm" fo:margin-top="0mm" fo:margin-bottom="3mm" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="TableTwo" style:family="table">
      <style:table-properties style:width="145mm" table:align="left" fo:margin-left="14mm" fo:margin-top="0mm" fo:margin-bottom="0mm" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="Col1A" style:family="table-column">
      <style:table-column-properties style:column-width="107mm"/>
    </style:style>
    <style:style style:name="Col2A" style:family="table-column">
      <style:table-column-properties style:column-width="36mm"/>
    </style:style>
    <style:style style:name="Col1B" style:family="table-column">
      <style:table-column-properties style:column-width="37mm"/>
    </style:style>
    <style:style style:name="Col2B" style:family="table-column">
      <style:table-column-properties style:column-width="73mm"/>
    </style:style>
    <style:style style:name="Col3B" style:family="table-column">
      <style:table-column-properties style:column-width="35mm"/>
    </style:style>
    <style:style style:name="HeaderRow" style:family="table-row">
      <style:table-row-properties style:row-height="6.5mm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="BodyRowA" style:family="table-row">
      <style:table-row-properties style:row-height="30.5mm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="BodyRowB" style:family="table-row">
      <style:table-row-properties style:row-height="104mm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="HeaderCell" style:family="table-cell" style:parent-style-name="Cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="PageStart">別紙</text:p>
      <text:p text:style-name="TitleLine">令和　年度東郷町高齢者花壇管理事業</text:p>
      <text:p text:style-name="TitleSecond">（花いっぱい活動事業）実績報告</text:p>
      <text:p text:style-name="Club">老人クラブ</text:p>
      <text:p text:style-name="Section">1　実績報告</text:p>
      <text:p text:style-name="Subsection">(1)　補助対象花壇設置場所</text:p>
      <table:table table:name="花壇設置場所" table:style-name="TableOne">
        <table:table-column table:style-name="Col1A"/>
        <table:table-column table:style-name="Col2A"/>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="CellText">補　助　対　象　花　壇　設　置　場　所</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="CellText">面　積</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="BodyRowA">
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Subsection">(2)　補助事業実施内容</text:p>
      <table:table table:name="補助事業実施内容" table:style-name="TableTwo">
        <table:table-column table:style-name="Col1B"/>
        <table:table-column table:style-name="Col2B"/>
        <table:table-column table:style-name="Col3B"/>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="CellText">実　施　日</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="CellText">実施内容</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="CellText">参加人数</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="BodyRowB">
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>