<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.12cm" fo:font-size="10pt"/>
      <style:text-properties fo:font-size="10pt" style:font-name="Arial"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="8pt" style:font-name="Arial"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt" style:font-name="Arial"/>
    </style:style>
    <style:style style:name="Bold" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-weight="bold" fo:font-size="10pt" style:font-name="Arial"/>
    </style:style>
    <style:style style:name="Header" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-weight="bold" fo:font-size="12pt" style:font-name="Arial"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.8cm"/>
      <style:text-properties fo:font-size="22pt" style:font-name="Arial"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #777777" fo:padding="0.12cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Label" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #777777" fo:padding="0.12cm" fo:background-color="#eeeeee" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Pink" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #777777" fo:padding="0.1cm" fo:background-color="#f8dddd" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="RedText" style:family="text">
      <style:text-properties fo:color="#cc0000" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="LogoText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="7pt" style:font-name="Arial"/>
    </style:style>
    <style:style style:name="TitleCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #777777" fo:padding="0.12cm" style:vertical-align="middle"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout" style:page-usage="all">
      <style:page-layout-properties fo:page-width="29.7cm" fo:page-height="21cm" fo:margin="1.5cm"/>
    </style:page-layout>
    <style:style style:name="SummaryTable" style:family="table">
      <style:table-properties style:width="26.7cm" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="MetaTable" style:family="table">
      <style:table-properties style:width="26.7cm" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="RiskTable" style:family="table">
      <style:table-properties style:width="26.7cm" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="RiskCol1" style:family="table-column">
      <style:table-column-properties style:column-width="1cm"/>
    </style:style>
    <style:style style:name="RiskCol2" style:family="table-column">
      <style:table-column-properties style:column-width="4.2cm"/>
    </style:style>
    <style:style style:name="RiskCol3" style:family="table-column">
      <style:table-column-properties style:column-width="2.2cm"/>
    </style:style>
    <style:style style:name="RiskCol4" style:family="table-column">
      <style:table-column-properties style:column-width="8.1cm"/>
    </style:style>
    <style:style style:name="RiskCol5" style:family="table-column">
      <style:table-column-properties style:column-width="7.8cm"/>
    </style:style>
    <style:style style:name="RiskCol6" style:family="table-column">
      <style:table-column-properties style:column-width="2.1cm"/>
    </style:style>
    <style:style style:name="RiskCol7" style:family="table-column">
      <style:table-column-properties style:column-width="2.1cm"/>
    </style:style>
    <style:style style:name="RiskHead" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #777777" fo:padding="0.1cm" fo:background-color="#eeeeee" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="RiskCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #777777" fo:padding="0.08cm" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Body"><text:span>Prifysgol </text:span><text:span text:style-name="Bold">BANGOR</text:span><text:span> University</text:span></text:p>
      <text:p text:style-name="Title">RISK ASSESSMENT FORM</text:p>
      <table:table table:name="AssessmentDetails" table:style-name="SummaryTable">
        <table:table-column table:style-name="RiskCol4"/>
        <table:table-column table:style-name="RiskCol4"/>
        <table:table-column table:style-name="RiskCol2"/>
        <table:table-column table:style-name="RiskCol2"/>
        <table:table-column table:style-name="RiskCol1"/>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p text:style-name="Header">Risk Assessment (RA) Title</text:p><text:p text:style-name="Small"><text:span text:style-name="RedText">Remember to complete Footer details</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Label"><text:p text:style-name="Header">Date RA Created and/or Reviewed</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Label"><text:p text:style-name="Header">Version Number</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body"/>
      <table:table table:name="ActivitySummary" table:style-name="SummaryTable">
        <table:table-column table:style-name="RiskCol4"/>
        <table:table-row><table:table-cell table:style-name="Label"><text:p text:style-name="Header">Summary of Activity RA Covers</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p/></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="Body"/>
      <table:table table:name="CoverageDetails" table:style-name="MetaTable">
        <table:table-column table:style-name="RiskCol4"/>
        <table:table-column table:style-name="RiskCol4"/>
        <table:table-column table:style-name="RiskCol4"/>
        <table:table-column table:style-name="RiskCol4"/>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p text:style-name="Header">Location(s) RA Covers</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Label"><text:p text:style-name="Header">Person(s) RA Covers</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p text:style-name="Header">College / Service</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Label"><text:p text:style-name="Header">School / Section</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p text:style-name="Header">RA Assessor(s)</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Label"><text:p text:style-name="Header">Contact Details</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body"/>
      <table:table table:name="ReviewDetails" table:style-name="MetaTable">
        <table:table-column table:style-name="RiskCol4"/>
        <table:table-column table:style-name="RiskCol4"/>
        <table:table-column table:style-name="RiskCol4"/>
        <table:table-column table:style-name="RiskCol4"/>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p text:style-name="Header">Actions to be Reviewed By</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Label"><text:p text:style-name="Header">Next RA Review Date</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Body"/>
      <table:table table:name="Notice" table:style-name="SummaryTable">
        <table:table-column table:style-name="RiskCol4"/>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Center"><text:span text:style-name="Bold">NOTE: Arrangements must be in place to communicate new and / or revised Risk Assessments to relevant persons.</text:span></text:p><text:p text:style-name="Center"><text:span text:style-name="Bold">Older versions must be removed from use (e.g. Folders, Website, My Bangor, Blackboard, Notice Boards) and filed for future reference/archive.</text:span></text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="Body"/>
      <table:table table:name="Footer" table:style-name="MetaTable">
        <table:table-column table:style-name="RiskCol2"/>
        <table:table-column table:style-name="RiskCol4"/>
        <table:table-column table:style-name="RiskCol2"/>
        <table:table-column table:style-name="RiskCol2"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">RA Title</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Small">Version Number</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Small"><text:span>Page 1 of 2</text:span></text:p>
      <text:p text:style-name="LogoText">PRIFYSGOL</text:p>
      <text:p text:style-name="LogoText">BANGOR</text:p>
      <text:p text:style-name="LogoText">UNIVERSITY</text:p>
      <text:p text:style-name="PageBreak"/>
      <table:table table:name="RiskAssessment" table:style-name="RiskTable">
        <table:table-column table:style-name="RiskCol1"/>
        <table:table-column table:style-name="RiskCol2"/>
        <table:table-column table:style-name="RiskCol3"/>
        <table:table-column table:style-name="RiskCol4"/>
        <table:table-column table:style-name="RiskCol5"/>
        <table:table-column table:style-name="RiskCol6"/>
        <table:table-column table:style-name="RiskCol7"/>
        <table:table-row>
          <table:table-cell table:style-name="RiskHead"><text:p text:style-name="Center"><text:span text:style-name="Bold">Ref</text:span></text:p><text:p text:style-name="Center"><text:span text:style-name="Bold">No</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="RiskHead"><text:p text:style-name="Center"><text:span text:style-name="Bold">What are the</text:span></text:p><text:p text:style-name="Center"><text:span text:style-name="Bold">Hazards?</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="RiskHead"><text:p text:style-name="Center"><text:span text:style-name="Bold">Who/What</text:span></text:p><text:p text:style-name="Center"><text:span text:style-name="Bold">is at Risk?</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="RiskHead"><text:p text:style-name="Center"><text:span text:style-name="Bold">Existing</text:span></text:p><text:p text:style-name="Center"><text:span text:style-name="Bold">Controls</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="RiskHead"><text:p text:style-name="Center"><text:span text:style-name="Bold">Further</text:span></text:p><text:p text:style-name="Center"><text:span text:style-name="Bold">Controls</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="RiskHead"><text:p text:style-name="Center"><text:span text:style-name="Bold">Action</text:span></text:p><text:p text:style-name="Center"><text:span text:style-name="Bold">By</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="RiskHead"><text:p text:style-name="Center"><text:span text:style-name="Bold">Action</text:span></text:p><text:p text:style-name="Center"><text:span text:style-name="Bold">Complete</text:span></text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:number-columns-spanned="5" table:style-name="RiskHead"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="RiskHead"><text:p/></table:table-cell>
          <table:table-cell table:style-name="RiskHead"><text:p text:style-name="Center"><text:span text:style-name="Bold">As Applicable</text:span></text:p></table:table-cell>
        </table:table-row>
        <table:table-row><table:table-cell table:style-name="RiskCell"><text:p text:style-name="Bold">1.</text:p></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p>•</text:p><text:p>•</text:p></table:table-cell><table:table-cell table:style-name="Pink"><text:p>a.</text:p><text:p>b.</text:p></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="RiskCell"><text:p text:style-name="Bold">2.</text:p></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p>•</text:p><text:p>•</text:p></table:table-cell><table:table-cell table:style-name="Pink"><text:p>a.</text:p><text:p>b.</text:p></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="RiskCell"><text:p text:style-name="Bold">3.</text:p></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p>•</text:p><text:p>•</text:p></table:table-cell><table:table-cell table:style-name="Pink"><text:p>a.</text:p><text:p>b.</text:p></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="RiskCell"><text:p text:style-name="Bold">4.</text:p></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p>•</text:p><text:p>•</text:p></table:table-cell><table:table-cell table:style-name="Pink"><text:p>a.</text:p><text:p>b.</text:p></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="RiskCell"><text:p text:style-name="Bold">5.</text:p></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p>•</text:p><text:p>•</text:p></table:table-cell><table:table-cell table:style-name="Pink"><text:p>a.</text:p><text:p>b.</text:p></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="RiskCell"><text:p text:style-name="Bold">6.</text:p></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p>•</text:p><text:p>•</text:p></table:table-cell><table:table-cell table:style-name="Pink"><text:p>a.</text:p><text:p>b.</text:p></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="RiskCell"><text:p text:style-name="Bold">7.</text:p></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p>•</text:p><text:p>•</text:p></table:table-cell><table:table-cell table:style-name="Pink"><text:p>a.</text:p><text:p>b.</text:p></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="RiskCell"><text:p text:style-name="Bold">8.</text:p></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p>•</text:p><text:p>•</text:p></table:table-cell><table:table-cell table:style-name="Pink"><text:p>a.</text:p><text:p>b.</text:p></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="RiskCell"><text:p text:style-name="Bold">9.</text:p></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p>•</text:p><text:p>•</text:p></table:table-cell><table:table-cell table:style-name="Pink"><text:p>a.</text:p><text:p>b.</text:p></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="RiskCell"><text:p text:style-name="Bold">10.</text:p></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p>•</text:p></table:table-cell><table:table-cell table:style-name="Pink"><text:p>a.</text:p></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell><table:table-cell table:style-name="RiskCell"><text:p/></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="Body"/>
      <table:table table:name="Reminder" table:style-name="SummaryTable">
        <table:table-column table:style-name="RiskCol4"/>
        <table:table-row><table:table-cell table:style-name="Cell"><text:p text:style-name="Center"><text:span text:style-name="Bold">REMEMBER: Arrangements must be in place to communicate new and / or revised Risk Assessments to relevant persons.</text:span></text:p><text:p text:style-name="Center"><text:span text:style-name="Bold">Older versions must be removed from use (e.g. Folders, Website, My Bangor, Blackboard, Notice Boards) and filed for future reference/archive.</text:span></text:p></table:table-row>
      </table:table>
      <text:p text:style-name="Small">RA Title</text:p>
      <text:p text:style-name="Small">Version Number</text:p>
      <text:p text:style-name="Small">Page 2 of 2</text:p>
    </office:text>
  </office:body>
</office:document>