          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Label"><text:p>School / Section</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p>RA Assessor(s)</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Label"><text:p>Contact Details</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <table:table table:name="ReviewDetails">
        <table:table-column table:style-name="ColAction1"/>
        <table:table-column table:style-name="ColAction2"/>
        <table:table-column table:style-name="ColAction3"/>
        <table:table-column table:style-name="ColAction4"/>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p>Actions to be Reviewed By</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Label"><text:p>Next RA Review Date</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <table:table table:name="Reminder">
        <table:table-column table:style-name="ColTop1"/>
        <table:table-column table:style-name="ColTop2"/>
        <table:table-column table:style-name="ColTop3"/>
        <table:table-column table:style-name="ColTop4"/>
        <table:table-column table:style-name="ColTop5"/>
        <table:table-column table:style-name="ColTop6"/>
        <table:table-row>
          <table:table-cell table:style-name="NoteCell" table:number-columns-spanned="6">
            <text:p text:style-name="CenterBold">NOTE: Arrangements must be in place to communicate new and / or revised Risk Assessments to relevant persons.</text:p>
            <text:p text:style-name="CenterBold">Older versions must be removed from use (e.g. Folders, Website, My Bangor, Blackboard, Notice Boards) and filed for future reference/archive.</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <table:table table:name="PageOneFooter">
