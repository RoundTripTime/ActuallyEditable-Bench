  <office:body>
    <office:text>
      <text:p text:style-name="OrgLine">Prifysgol <text:span text:style-name="Bold">BANGOR</text:span> University</text:p>
      <text:p text:style-name="Title">RISK ASSESSMENT FORM</text:p>
      <table:table table:name="AssessmentDetails">
        <table:table-column table:style-name="ColTop1"/>
        <table:table-column table:style-name="ColTop2"/>
        <table:table-column table:style-name="ColTop3"/>
        <table:table-column table:style-name="ColTop4"/>
        <table:table-column table:style-name="ColTop5"/>
        <table:table-column table:style-name="ColTop6"/>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p>Risk Assessment (RA) Title<text:line-break/><text:span text:style-name="Bold">Remember to complete Footer details</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Label"><text:p>Date RA Created<text:line-break/>and/or Reviewed</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Label"><text:p>Version Number</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
      </table:table>
      <table:table table:name="ActivitySummary">
        <table:table-column table:style-name="ColTop1"/>
        <table:table-column table:style-name="ColTop2"/>
        <table:table-column table:style-name="ColTop3"/>
        <table:table-column table:style-name="ColTop4"/>
        <table:table-column table:style-name="ColTop5"/>
        <table:table-column table:style-name="ColTop6"/>
        <table:table-row>
          <table:table-cell table:style-name="Label" table:number-columns-spanned="6"><text:p>Summary of Activity RA Covers</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="6"><text:p/></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <table:table table:name="CoverageDetails">
        <table:table-column table:style-name="ColMeta1"/>
        <table:table-column table:style-name="ColMeta2"/>
        <table:table-column table:style-name="ColMeta3"/>
        <table:table-column table:style-name="ColMeta4"/>
        <table:table-row>
          <table:table-cell table:style-name="Label"><text:p>Location(s) RA Covers</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Label"><text:p>Person(s) RA Covers</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
