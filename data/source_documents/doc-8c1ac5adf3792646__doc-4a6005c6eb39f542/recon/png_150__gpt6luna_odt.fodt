          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="HeadCell" table:number-columns-spanned="2"><text:p>As Applicable</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p><text:span text:style-name="Bold">1.</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p>•</text:p><text:p>•</text:p></table:table-cell>
          <table:table-cell table:style-name="PinkCell"><text:p>a.</text:p><text:p>b.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p><text:span text:style-name="Bold">2.</text:span></text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"><text:p>•</text:p><text:p>•</text:p></table:table-cell>
          <table:table-cell table:style-name="PinkCell"><text:p>a.</text:p><text:p>b.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"/>
          <table:table-cell table:style-name="Cell"/>
