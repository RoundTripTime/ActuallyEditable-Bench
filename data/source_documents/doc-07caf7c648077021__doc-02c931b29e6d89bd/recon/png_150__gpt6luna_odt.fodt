<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%" fo:margin-top="0cm" fo:margin-bottom="0.18cm"/>
      <style:text-properties fo:font-size="12pt" fo:color="#263f3a"/>
    </style:default-style>
    <style:style style:name="Kicker" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.45cm"/>
      <style:text-properties fo:font-size="10.5pt" fo:color="#263f3a"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:line-height="110%" fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-size="28pt" fo:color="#263f3a"/>
    </style:style>
    <style:style style:name="Subtitle" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-size="12pt" fo:color="#263f3a"/>
    </style:style>
    <style:style style:name="Metadata" style:family="paragraph">
      <style:paragraph-properties fo:line-height="120%" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="12pt" fo:color="#263f3a"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.22cm" fo:margin-bottom="0.1cm"/>
      <style:text-properties fo:font-size="14pt" fo:font-weight="bold" fo:color="#263f3a"/>
    </style:style>
    <style:style style:name="BodyCopy" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.2cm"/>
      <style:text-properties fo:font-size="12pt" fo:color="#263f3a"/>
    </style:style>
    <style:style style:name="Checklist" style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.2cm"/>
      <style:text-properties fo:font-size="12pt" fo:color="#263f3a"/>
    </style:style>
    <style:style style:name="Source" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.05cm"/>
      <style:text-properties fo:font-size="12pt" fo:color="#263f3a"/>
    </style:style>
    <style:style style:name="Footer" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start"/>
      <style:text-properties fo:font-size="10.5pt" fo:color="#263f3a"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.7cm" fo:margin-bottom="1.7cm" fo:margin-left="1.7cm" fo:margin-right="1.7cm" style:print-orientation="portrait"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout">
      <style:footer>
        <text:p text:style-name="Footer">Ostro templates  ·  <text:page-number>1</text:page-number></text:p>
      </style:footer>
    </style:master-page>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Kicker">OSTRO / WORKING TEMPLATES</text:p>
      <text:p text:style-name="Title">Branding project brief</text:p>
      <text:p text:style-name="Subtitle">Editable template · replace every bracketed field before use</text:p>
      <text:p text:style-name="Metadata">Prepared by: [your name or business]</text:p>
      <text:p text:style-name="Metadata">Prepared for: [client name]</text:p>
      <text:p text:style-name="Metadata">Date: [date]</text:p>
      <text:p text:style-name="Section">Background and problem</text:p>
      <text:p text:style-name="BodyCopy">[Add your background and problem here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="Section">Audience</text:p>
      <text:p text:style-name="BodyCopy">[Add your audience here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="Section">Desired outcome</text:p>
      <text:p text:style-name="BodyCopy">[Add your desired outcome here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="Section">Required outputs</text:p>
      <text:p text:style-name="BodyCopy">[Add your required outputs here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="Section">Available inputs</text:p>
      <text:p text:style-name="BodyCopy">[Add your available inputs here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="Section">Constraints and exclusions</text:p>
      <text:p text:style-name="BodyCopy">[Add your constraints and exclusions here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="Section">Timing and approvals</text:p>
      <text:p text:style-name="BodyCopy">[Add your timing and approvals here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="Section">Open questions</text:p>
      <text:p text:style-name="BodyCopy">[Add your open questions here. Use the completed example as a guide.]</text:p>
      <text:p text:style-name="Section">Before sending — remove this checklist</text:p>
      <text:p text:style-name="Checklist">• Name the person responsible for decisions and consolidated feedback.</text:p>
      <text:p text:style-name="Checklist">• Separate requirements from preferences and unresolved questions.</text:p>
      <text:p text:style-name="Checklist">• Confirm dates and dependencies before treating them as commitments.</text:p>
      <text:p text:style-name="Source">Template and example: https://tryostro.com/templates/branding-brief/</text:p>
    </office:text>
  </office:body>
</office:document>