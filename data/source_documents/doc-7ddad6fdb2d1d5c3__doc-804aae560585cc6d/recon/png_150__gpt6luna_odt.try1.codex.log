        <table:table-column table:style-name="Col3" table:number-columns-repeated="3"/>
        <table:table-row>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">収入内容</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">年金番号等</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="CellCenter">年額（円）</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
