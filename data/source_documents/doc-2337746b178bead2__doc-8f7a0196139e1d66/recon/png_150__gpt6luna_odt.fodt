<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.15cm"/>
      <style:text-properties fo:font-size="11pt" fo:color="#111111"/>
    </style:default-style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:margin-top="0cm" fo:margin-bottom="0.28cm"/>
      <style:text-properties fo:font-size="28pt" fo:color="#1b3b65"/>
    </style:style>
    <style:style style:name="Subhead" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.45cm" fo:margin-bottom="0.22cm"/>
    </style:style>
    <style:style style:name="Label" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="11pt" fo:font-weight="bold" fo:color="#37649a"/>
    </style:style>
    <style:style style:name="TableHead" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="11pt" fo:font-weight="bold" fo:color="#37649a"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.22cm"/>
      <style:text-properties fo:font-size="10.5pt"/>
    </style:style>
    <style:style style:name="FooterText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.5cm" fo:margin-bottom="1.5cm" fo:margin-left="1.4cm" fo:margin-right="1.4cm" style:print-orientation="portrait"/>
    </style:page-layout>
    <style:style style:name="TitleRule" style:family="paragraph">
      <style:paragraph-properties fo:border-bottom="0.04cm solid #4b83c3" fo:padding-bottom="0.22cm" fo:margin-bottom="0.45cm"/>
    </style:style>
    <style:style style:name="InfoTable" style:family="table">
      <style:table-properties style:width="18.2cm"/>
    </style:style>
    <style:style style:name="InfoLeft" style:family="table-column">
      <style:table-column-properties style:column-width="9.1cm"/>
    </style:style>
    <style:style style:name="InfoRight" style:family="table-column">
      <style:table-column-properties style:column-width="9.1cm"/>
    </style:style>
    <style:style style:name="InfoCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.08cm 0.2cm" fo:border-top="0.02cm solid #5a8dcc" fo:border-bottom="0.02cm solid #5a8dcc" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="InfoBlueCell" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#d2dfed" fo:padding="0.08cm 0.2cm" fo:border-top="0.02cm solid #5a8dcc" fo:border-bottom="0.02cm solid #5a8dcc" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="PayTable" style:family="table">
      <style:table-properties style:width="18.2cm"/>
    </style:style>
    <style:style style:name="PayCol1" style:family="table-column">
      <style:table-column-properties style:column-width="6.5cm"/>
    </style:style>
    <style:style style:name="PayCol2" style:family="table-column">
      <style:table-column-properties style:column-width="3.2cm"/>
    </style:style>
    <style:style style:name="PayCol3" style:family="table-column">
      <style:table-column-properties style:column-width="4.5cm"/>
    </style:style>
    <style:style style:name="PayCol4" style:family="table-column">
      <style:table-column-properties style:column-width="4cm"/>
    </style:style>
    <style:style style:name="PayHeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.05cm 0.18cm" fo:border-top="0.04cm solid #4b83c3" fo:border-bottom="0.04cm solid #4b83c3" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="PayBlueCell" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#d2dfed" fo:padding="0.18cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="PayWhiteCell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.18cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="BottomRule" style:family="paragraph">
      <style:paragraph-properties fo:border-top="0.04cm solid #4b83c3" fo:padding-top="0.05cm" fo:margin-top="0.45cm" fo:margin-bottom="0.12cm"/>
    </style:style>
    <style:style style:name="InfoRow" style:family="table-row"/>
    <style:style style:name="PayRow" style:family="table-row"/>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout">
      <style:footer>
        <text:p text:style-name="FooterText">OnlineBiller | Original English resource | Blank template</text:p>
      </style:footer>
    </style:master-page>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">Money Receipt — partial payment</text:p>
      <text:p text:style-name="TitleRule"/>
      <text:p text:style-name="Subhead">BLANK TEMPLATE | Currency: INR</text:p>
      <table:table table:name="ReceiptDetails" table:style-name="InfoTable">
        <table:table-column table:style-name="InfoLeft"/>
        <table:table-column table:style-name="InfoRight"/>
        <table:table-row table:style-name="InfoRow">
          <table:table-cell table:style-name="InfoCell"><text:p text:style-name="Label">Recipient</text:p></table:table-cell>
          <table:table-cell table:style-name="InfoCell"><text:p>________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InfoRow">
          <table:table-cell table:style-name="InfoBlueCell"><text:p text:style-name="Label">Received from</text:p></table:table-cell>
          <table:table-cell table:style-name="InfoBlueCell"><text:p>________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InfoRow">
          <table:table-cell table:style-name="InfoCell"><text:p text:style-name="Label">Receipt / date</text:p></table:table-cell>
          <table:table-cell table:style-name="InfoCell"><text:p>________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InfoRow">
          <table:table-cell table:style-name="InfoBlueCell"><text:p text:style-name="Label">Underlying reference</text:p></table:table-cell>
          <table:table-cell table:style-name="InfoBlueCell"><text:p>________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InfoRow">
          <table:table-cell table:style-name="InfoCell"><text:p text:style-name="Label">Agreed total (context)</text:p></table:table-cell>
          <table:table-cell table:style-name="InfoCell"><text:p>________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InfoRow">
          <table:table-cell table:style-name="InfoBlueCell"><text:p text:style-name="Label">Amount in words</text:p></table:table-cell>
          <table:table-cell table:style-name="InfoBlueCell"><text:p>________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InfoRow">
          <table:table-cell table:style-name="InfoCell"><text:p text:style-name="Label">Remaining balance (context)</text:p></table:table-cell>
          <table:table-cell table:style-name="InfoCell"><text:p>________________________________</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InfoRow">
          <table:table-cell table:style-name="InfoBlueCell"><text:p text:style-name="Label">Acknowledged by</text:p></table:table-cell>
          <table:table-cell table:style-name="InfoBlueCell"><text:p>________________________________</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p/>
      <table:table table:name="PaymentLines" table:style-name="PayTable">
        <table:table-column table:style-name="PayCol1"/>
        <table:table-column table:style-name="PayCol2"/>
        <table:table-column table:style-name="PayCol3"/>
        <table:table-column table:style-name="PayCol4"/>
        <table:table-row table:style-name="PayRow">
          <table:table-cell table:style-name="PayHeaderCell"><text:p text:style-name="TableHead">Purpose</text:p></table:table-cell>
          <table:table-cell table:style-name="PayHeaderCell"><text:p text:style-name="TableHead">Method</text:p></table:table-cell>
          <table:table-cell table:style-name="PayHeaderCell"><text:p text:style-name="TableHead">Payment reference</text:p></table:table-cell>
          <table:table-cell table:style-name="PayHeaderCell"><text:p text:style-name="TableHead">Received (INR)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="PayRow">
          <table:table-cell table:style-name="PayBlueCell"/>
          <table:table-cell table:style-name="PayBlueCell"/>
          <table:table-cell table:style-name="PayBlueCell"/>
          <table:table-cell table:style-name="PayBlueCell"/>
        </table:table-row>
        <table:table-row table:style-name="PayRow">
          <table:table-cell table:style-name="PayWhiteCell"/>
          <table:table-cell table:style-name="PayWhiteCell"/>
          <table:table-cell table:style-name="PayWhiteCell"/>
          <table:table-cell table:style-name="PayWhiteCell"/>
        </table:table-row>
        <table:table-row table:style-name="PayRow">
          <table:table-cell table:style-name="PayBlueCell"/>
          <table:table-cell table:style-name="PayBlueCell"/>
          <table:table-cell table:style-name="PayBlueCell"/>
          <table:table-cell table:style-name="PayBlueCell"/>
        </table:table-row>
        <table:table-row table:style-name="PayRow">
          <table:table-cell table:style-name="PayWhiteCell"/>
          <table:table-cell table:style-name="PayWhiteCell"/>
          <table:table-cell table:style-name="PayWhiteCell"/>
          <table:table-cell table:style-name="PayWhiteCell"/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="BottomRule">Ordinary incoming-payment acknowledgment. Verify receipt of funds independently.</text:p>
      <text:p text:style-name="Note">The agreed total and remaining balance are manual context, not an automated ledger.</text:p>
      <text:p text:style-name="Note">Word amounts are manual. Check line amounts and totals after every edit.</text:p>
    </office:text>
  </office:body>
</office:document>