<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:default-style>
    <style:style style:name="FormLabel" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.45cm" fo:margin-bottom="0.25cm"/>
      <style:text-properties fo:font-size="18pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Recipient" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0.15cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Intro" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0.55cm" fo:margin-bottom="0.15cm"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
    <style:style style:name="HeadingCell" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="Footer" style:family="paragraph">
      <style:paragraph-properties fo:text-align="end" fo:margin-top="0.75cm"/>
      <style:text-properties fo:font-size="8pt"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="29.7cm" fo:page-height="21cm" fo:margin-left="1.18cm" fo:margin-right="1.18cm" fo:margin-top="0.8cm" fo:margin-bottom="0.8cm"/>
    </style:page-layout>
    <style:style style:name="MasterTable" style:family="table">
      <style:table-properties style:width="27.34cm" table:align="margins" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="SignatureTable" style:family="table">
      <style:table-properties style:width="27.34cm" table:align="margins" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="MainTable" style:family="table">
      <style:table-properties style:width="27.34cm" table:align="margins" table:border-model="collapsing"/>
    </style:style>
    <style:style style:name="ColDateA" style:family="table-column">
      <style:table-column-properties style:column-width="0.82cm"/>
    </style:style>
    <style:style style:name="ColDateB" style:family="table-column">
      <style:table-column-properties style:column-width="0.82cm"/>
    </style:style>
    <style:style style:name="ColDateC" style:family="table-column">
      <style:table-column-properties style:column-width="0.82cm"/>
    </style:style>
    <style:style style:name="ColPlace" style:family="table-column">
      <style:table-column-properties style:column-width="3.82cm"/>
    </style:style>
    <style:style style:name="ColName" style:family="table-column">
      <style:table-column-properties style:column-width="4.85cm"/>
    </style:style>
    <style:style style:name="ColCount" style:family="table-column">
      <style:table-column-properties style:column-width="1.89cm"/>
    </style:style>
    <style:style style:name="ColContent" style:family="table-column">
      <style:table-column-properties style:column-width="14.32cm"/>
    </style:style>
    <style:style style:name="SigColBlank" style:family="table-column">
      <style:table-column-properties style:column-width="12.1cm"/>
    </style:style>
    <style:style style:name="SigColLabel" style:family="table-column">
      <style:table-column-properties style:column-width="6.5cm"/>
    </style:style>
    <style:style style:name="SigColGap" style:family="table-column">
      <style:table-column-properties style:column-width="0.8cm"/>
    </style:style>
    <style:style style:name="SigColRep" style:family="table-column">
      <style:table-column-properties style:column-width="7.94cm"/>
    </style:style>
    <style:style style:name="HeaderRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.66cm"/>
    </style:style>
    <style:style style:name="InputRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.85cm"/>
    </style:style>
    <style:style style:name="SignatureRow" style:family="table-row">
      <style:table-row-properties style:row-height="0.55cm"/>
    </style:style>
    <style:style style:name="GridCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="DashedRight" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:border-right="0.5pt dashed #000000" fo:padding="0cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="DashedBoth" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:border-left="0.5pt dashed #000000" fo:border-right="0.5pt dashed #000000" fo:padding="0cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="DashedLeft" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:border-left="0.5pt dashed #000000" fo:padding="0cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="SignatureLine" style:family="table-cell">
      <style:table-cell-properties fo:border-bottom="0.5pt solid #000000" fo:padding="0cm" style:vertical-align="middle"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="FormLabel">（ 様式 第 ３ 号 ）</text:p>
      <text:p text:style-name="Title">令和　年度　地区育成（子ども）会　事業実施報告書</text:p>
      <text:p text:style-name="Recipient">飯綱町教育委員会 御中</text:p>
      <table:table table:name="SignatureFields" table:style-name="SignatureTable">
        <table:table-column table:style-name="SigColBlank"/>
        <table:table-column table:style-name="SigColLabel"/>
        <table:table-column table:style-name="SigColGap"/>
        <table:table-column table:style-name="SigColRep"/>
        <table:table-row table:style-name="SignatureRow">
          <table:table-cell/>
          <table:table-cell table:style-name="SignatureLine"><text:p>育成会名称</text:p></table:table-cell>
          <table:table-cell/>
          <table:table-cell table:style-name="SignatureLine"><text:p>代表者氏名</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Intro">令和　年度に実施した育成会事業は次のとおりです。</text:p>
      <table:table table:name="事業実施報告" table:style-name="MainTable">
        <table:table-column table:style-name="ColDateA"/>
        <table:table-column table:style-name="ColDateB"/>
        <table:table-column table:style-name="ColDateC"/>
        <table:table-column table:style-name="ColPlace"/>
        <table:table-column table:style-name="ColName"/>
        <table:table-column table:style-name="ColCount"/>
        <table:table-column table:style-name="ColContent"/>
        <table:table-row table:style-name="HeaderRow">
          <table:table-cell table:style-name="GridCell" table:number-columns-spanned="3"><text:p text:style-name="HeadingCell">開催期日</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="HeadingCell">開催場所など</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="HeadingCell">事 業 名 称</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="HeadingCell">参加者数</text:p></table:table-cell>
          <table:table-cell table:style-name="GridCell"><text:p text:style-name="HeadingCell">事 業 内 容　　　　※行った内容を記入してください</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="InputRow"><table:table-cell table:style-name="DashedRight"/><table:table-cell table:style-name="DashedBoth"/><table:table-cell table:style-name="DashedLeft"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/></table:table-row>
        <table:table-row table:style-name="InputRow"><table:table-cell table:style-name="DashedRight"/><table:table-cell table:style-name="DashedBoth"/><table:table-cell table:style-name="DashedLeft"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/></table:table-row>
        <table:table-row table:style-name="InputRow"><table:table-cell table:style-name="DashedRight"/><table:table-cell table:style-name="DashedBoth"/><table:table-cell table:style-name="DashedLeft"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/></table:table-row>
        <table:table-row table:style-name="InputRow"><table:table-cell table:style-name="DashedRight"/><table:table-cell table:style-name="DashedBoth"/><table:table-cell table:style-name="DashedLeft"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/></table:table-row>
        <table:table-row table:style-name="InputRow"><table:table-cell table:style-name="DashedRight"/><table:table-cell table:style-name="DashedBoth"/><table:table-cell table:style-name="DashedLeft"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/></table:table-row>
        <table:table-row table:style-name="InputRow"><table:table-cell table:style-name="DashedRight"/><table:table-cell table:style-name="DashedBoth"/><table:table-cell table:style-name="DashedLeft"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/></table:table-row>
        <table:table-row table:style-name="InputRow"><table:table-cell table:style-name="DashedRight"/><table:table-cell table:style-name="DashedBoth"/><table:table-cell table:style-name="DashedLeft"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/></table:table-row>
        <table:table-row table:style-name="InputRow"><table:table-cell table:style-name="DashedRight"/><table:table-cell table:style-name="DashedBoth"/><table:table-cell table:style-name="DashedLeft"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/></table:table-row>
        <table:table-row table:style-name="InputRow"><table:table-cell table:style-name="DashedRight"/><table:table-cell table:style-name="DashedBoth"/><table:table-cell table:style-name="DashedLeft"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/></table:table-row>
        <table:table-row table:style-name="InputRow"><table:table-cell table:style-name="DashedRight"/><table:table-cell table:style-name="DashedBoth"/><table:table-cell table:style-name="DashedLeft"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/></table:table-row>
        <table:table-row table:style-name="InputRow"><table:table-cell table:style-name="DashedRight"/><table:table-cell table:style-name="DashedBoth"/><table:table-cell table:style-name="DashedLeft"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/></table:table-row>
        <table:table-row table:style-name="InputRow"><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/></table:table-row>
        <table:table-row table:style-name="InputRow"><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/></table:table-row>
        <table:table-row table:style-name="InputRow"><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/></table:table-row>
        <table:table-row table:style-name="InputRow"><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/><table:table-cell table:style-name="GridCell"/></table:table-row>
      </table:table>
      <text:p text:style-name="Footer">地区育成会 事業実施報告書 230310</text:p>
    </office:text>
  </office:body>
</office:document>