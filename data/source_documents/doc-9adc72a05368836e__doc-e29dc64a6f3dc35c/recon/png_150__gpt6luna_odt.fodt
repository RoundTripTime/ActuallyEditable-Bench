<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.55cm" fo:margin-bottom="0.45cm"/>
      <style:text-properties fo:font-size="16pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="RightSmall" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-bottom="0.15cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>
    <style:style style:name="PageStart" style:family="paragraph">
      <style:paragraph-properties fo:break-before="page" fo:text-align="right" fo:margin-bottom="0.55cm"/>
      <style:text-properties fo:font-size="12pt"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="CellCenter" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="CellLeft" style:family="paragraph">
      <style:paragraph-properties fo:text-align="left"/>
    </style:style>
    <style:style style:name="CellRight" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PL1">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.5cm" fo:margin-bottom="1.5cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
    </style:page-layout>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="2.45cm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="2.8cm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="2.1cm"/>
    </style:style>
    <style:style style:name="Col4" style:family="table-column">
      <style:table-column-properties style:column-width="3.75cm"/>
    </style:style>
    <style:style style:name="Col5" style:family="table-column">
      <style:table-column-properties style:column-width="2.5cm"/>
    </style:style>
    <style:style style:name="Col6" style:family="table-column">
      <style:table-column-properties style:column-width="3.4cm"/>
    </style:style>
    <style:style style:name="StampCol1" style:family="table-column">
      <style:table-column-properties style:column-width="2.45cm"/>
    </style:style>
    <style:style style:name="StampCol2" style:family="table-column">
      <style:table-column-properties style:column-width="2.95cm"/>
    </style:style>
    <style:style style:name="StampCol3" style:family="table-column">
      <style:table-column-properties style:column-width="4.1cm"/>
    </style:style>
    <style:style style:name="StampCol4" style:family="table-column">
      <style:table-column-properties style:column-width="2.1cm"/>
    </style:style>
    <style:style style:name="StampCol5" style:family="table-column">
      <style:table-column-properties style:column-width="5.4cm"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" fo:vertical-align="middle"/>
      <style:text-properties fo:font-size="11pt"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PL1"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="RightSmall">附件二</text:p>
      <text:p text:style-name="Title">新北市政府徵收補償費預約到府服務申請書</text:p>
      <text:p text:style-name="RightSmall">114.8 版本</text:p>
      <table:table table:name="申請表">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-column table:style-name="Col4"/>
        <table:table-column table:style-name="Col5"/>
        <table:table-column table:style-name="Col6"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">應受補償人</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">出生日期</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">身分證字號</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">申請人</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">與應受補償人關係</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellLeft">□本人</text:p><text:p text:style-name="CellLeft">□___</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">連絡電話</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">申請到府服務原因</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5">
            <text:p text:style-name="CellLeft">□ 65 歲以上。</text:p>
            <text:p text:style-name="CellLeft">□ 領有「中華民國身心障礙手冊」且屬視覺障礙、聽覺機能障礙、平衡機能障礙、下肢肢體障礙、重要器官失去功能或其他障礙等確為行動不便者。</text:p>
            <text:p text:style-name="CellLeft">□ 持醫院開立之「醫療證明」確為行動不便者。</text:p>
            <text:p text:style-name="CellLeft">□ 5 人以上並於同一地點受理（無資格條件限制）。</text:p>
            <text:p text:style-name="CellLeft">□ 領有孕婦健康手冊。</text:p>
            <text:p text:style-name="CellLeft">□ 其他特殊狀況者________________。</text:p>
            <text:p/>
            <text:p text:style-name="CellLeft">* 應受補償人須意識清楚。</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">適宜到府時間</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p text:style-name="CellRight">(以週一至週五 9:00~19:00 為限)</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">到府地址</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p/></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">應附證明文件</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5">
            <text:p text:style-name="CellLeft">1. 應受補償人身分證明文件影本(如申請人與應受補償人非同一人，請一併檢附申請人身分證明文件影本)</text:p>
            <text:p/>
            <text:p text:style-name="CellLeft">2. 證明文件(請擇一檢附)：</text:p>
            <text:p/>
            <text:p text:style-name="CellLeft">□身心障礙手冊□醫療證明□孕婦健康手冊□其他____________</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">徵收不動產資訊</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5">
            <text:p text:style-name="CellLeft">工程名稱：</text:p>
            <text:p text:style-name="CellLeft">新北市____區____段____小段____地/建號</text:p>
            <text:p text:style-name="CellLeft">保管字號：___年保管字第____號</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">備註</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="5"><text:p/></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <table:table table:name="蓋章">
        <table:table-column table:style-name="StampCol1"/>
        <table:table-column table:style-name="StampCol2"/>
        <table:table-column table:style-name="StampCol3"/>
        <table:table-column table:style-name="StampCol4"/>
        <table:table-column table:style-name="StampCol5"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">蓋章</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">應受補償人</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="CellCenter">申請人</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="PageStart">附件二</text:p>
      <table:table table:name="蓋章續頁">
        <table:table-column table:style-name="StampCol1"/>
        <table:table-column table:style-name="StampCol2"/>
        <table:table-column table:style-name="StampCol3"/>
        <table:table-column table:style-name="StampCol4"/>
        <table:table-column table:style-name="StampCol5"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Center">中華民國　年　月　日</text:p>
    </office:text>
  </office:body>
</office:document>