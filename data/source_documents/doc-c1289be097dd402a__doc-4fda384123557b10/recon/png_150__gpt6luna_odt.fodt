<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.text" office:version="1.4">
  <office:styles>
    <style:style style:name="Title" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0.45cm" fo:margin-bottom="1.15cm"/>
      <style:text-properties fo:font-size="16pt" fo:font-family="serif"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.35cm" fo:margin-bottom="0.18cm"/>
      <style:text-properties fo:font-size="13pt" fo:font-family="serif"/>
    </style:style>
    <style:style style:name="FieldRight" style:family="paragraph">
      <style:paragraph-properties fo:text-align="right" fo:margin-top="0.2cm" fo:margin-bottom="0.35cm"/>
      <style:text-properties fo:font-size="12pt" fo:font-family="serif"/>
    </style:style>
    <style:style style:name="TableText" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="13pt" fo:font-family="serif"/>
    </style:style>
    <style:style style:name="TableCenter" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center" fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="13pt" fo:font-family="serif"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0.35cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="11pt" fo:font-family="serif"/>
    </style:style>
    <style:style style:name="NoteContinuation" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"/>
      <style:text-properties fo:font-size="11pt" fo:font-family="serif"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-left="2.1cm" fo:margin-right="2.1cm" fo:margin-top="2cm" fo:margin-bottom="2cm"/>
    </style:page-layout>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties style:width="16.8cm" table:align="center"/>
    </style:style>
    <style:style style:name="FieldTable" style:family="table">
      <style:table-properties style:width="5cm" table:align="right"/>
    </style:style>
    <style:style style:name="Col1" style:family="table-column">
      <style:table-column-properties style:column-width="4.45cm"/>
    </style:style>
    <style:style style:name="Col2" style:family="table-column">
      <style:table-column-properties style:column-width="4.95cm"/>
    </style:style>
    <style:style style:name="Col3" style:family="table-column">
      <style:table-column-properties style:column-width="7.4cm"/>
    </style:style>
    <style:style style:name="FieldCol1" style:family="table-column">
      <style:table-column-properties style:column-width="4.2cm"/>
    </style:style>
    <style:style style:name="FieldCol2" style:family="table-column">
      <style:table-column-properties style:column-width="0.8cm"/>
    </style:style>
    <style:style style:name="FormRow" style:family="table-row">
      <style:table-row-properties style:row-height="1.18cm"/>
    </style:style>
    <style:style style:name="FormCell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #000000" fo:padding="0.08cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="FieldLine" style:family="table-cell">
      <style:table-cell-properties fo:border-bottom="0.5pt solid #000000" fo:padding="0cm"/>
    </style:style>
    <style:style style:name="FieldLabel" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Title">区誌（史）編さん事業　収支予算書</text:p>
      <table:table table:name="区欄" table:style-name="FieldTable">
        <table:table-column table:style-name="FieldCol1"/>
        <table:table-column table:style-name="FieldCol2"/>
        <table:table-row>
          <table:table-cell table:style-name="FieldLine"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FieldLabel"><text:p text:style-name="TableCenter">区</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Section">＜収入の部＞</text:p>
      <table:table table:name="収入の部" table:style-name="FormTable">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-row table:style-name="FormRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="TableCenter">項　目</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="TableCenter">金　額（円）</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="TableCenter">備　考</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="TableText">市補助金</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="TableCenter">合　計</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Section">＜支出の部＞</text:p>
      <table:table table:name="支出の部" table:style-name="FormTable">
        <table:table-column table:style-name="Col1"/>
        <table:table-column table:style-name="Col2"/>
        <table:table-column table:style-name="Col3"/>
        <table:table-row table:style-name="FormRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="TableCenter">項　目</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="TableCenter">金　額（円）</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="TableCenter">備　考</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="TableText">印刷製本費</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="FormRow">
          <table:table-cell table:style-name="FormCell"><text:p text:style-name="TableCenter">合　計</text:p></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
          <table:table-cell table:style-name="FormCell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Note">※収入の部は、この補助金のほか収入の種類ごとに分け、支出の部は、</text:p>
      <text:p text:style-name="NoteContinuation">事業費、事務費、会議費等必要な科目を設定し記入すること。</text:p>
    </office:text>
  </office:body>
</office:document>