<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
                 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
                 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
                 xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
                 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
                 office:mimetype="application/vnd.oasis.opendocument.text"
                 office:version="1.4">
  <office:styles>
    <style:style style:name="Base" style:family="paragraph">
      <style:paragraph-properties fo:font-size="11pt" fo:line-height="115%"/>
    </style:style>
    <style:style style:name="Start" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:break-before="page" fo:text-align="center" fo:font-size="17pt" fo:line-height="150%" fo:margin-bottom="0.55cm"/>
    </style:style>
    <style:style style:name="Right" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:text-align="right"/>
    </style:style>
    <style:style style:name="Center" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="Section" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:font-size="12pt" fo:margin-top="0.32cm" fo:margin-bottom="0.08cm"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:font-size="9pt" fo:line-height="100%"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:border="0.5pt solid #333333" fo:padding="0.06cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Input" style:family="table-cell" style:parent-style-name="Cell">
      <style:table-cell-properties fo:border="0.5pt solid #333333" fo:padding="0.06cm" fo:background-color="#ffffe0" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="NoBorder" style:family="table-cell">
      <style:table-cell-properties fo:border="none" fo:padding="0.04cm" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="Col" style:family="table-column">
      <style:table-column-properties style:rel-column-width="1*"/>
    </style:style>
    <style:style style:name="FormTable" style:family="table">
      <style:table-properties/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PageLayout">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:print-orientation="portrait" fo:margin-top="1.5cm" fo:margin-bottom="1.2cm" fo:margin-left="2.2cm" fo:margin-right="2.2cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="PageLayout"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Start">環境美化運動実施報告および補助金交付申請書</text:p>
      <text:p text:style-name="Right">令　和　　年　　月　　日</text:p>
      <text:p>飯　綱　町　長　　様</text:p>
      <table:table table:name="Applicant" table:style-name="FormTable">
        <table:table-column table:style-name="Col" table:number-columns-repeated="4"/>
        <table:table-row>
          <table:table-cell table:style-name="NoBorder" table:number-columns-spanned="2"><text:p/></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="NoBorder"><text:p>子ども会・育成会名</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="NoBorder" table:number-columns-spanned="2"><text:p/></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell"><text:p>代表者</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">印</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p/>
      <text:p>下記のとおり環境美化運動事業実施しましたので、補助金の交付を申請します。</text:p>
      <text:p text:style-name="Section">1.　実施した事業の概要</text:p>
      <table:table table:name="Activity" table:style-name="FormTable">
        <table:table-column table:style-name="Col" table:number-columns-repeated="12"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>実施内容</text:p></table:table-cell>
          <table:table-cell table:style-name="Input" table:number-columns-spanned="11"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>実施期日</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>令和</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>年</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>月</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>日</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>～</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>令和</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>年</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>実施場所</text:p></table:table-cell>
          <table:table-cell table:style-name="Input" table:number-columns-spanned="11"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>参　加　者</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>子ども</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>指導員</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>育成会</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>名</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>合　計</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>協力団体</text:p></table:table-cell>
          <table:table-cell table:style-name="Input" table:number-columns-spanned="11"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <table:table table:name="Waste" table:style-name="FormTable">
        <table:table-column table:style-name="Col" table:number-columns-repeated="13"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell" table:number-rows-spanned="2"><text:p>ゴミなどの収集量</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>可燃ゴミ</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>空き缶</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>空きビン</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>ペットボトル</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>プラスチック</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Cell" table:number-columns-spanned="2"><text:p>金　属　類</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:covered-table-cell/>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p>袋</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p>袋</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p>袋</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p>袋</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p>袋</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell><table:table-cell table:style-name="Cell"><text:p>袋</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Section">2.　事業に伴う経費</text:p>
      <table:table table:name="Expenses" table:style-name="FormTable">
        <table:table-column table:style-name="Col" table:number-columns-repeated="6"/>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">区　分</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">金　額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">説　明</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">区　分</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">金　額</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p text:style-name="Center">説　明</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>材　料　費</text:p></table:table-cell><table:table-cell table:style-name="Input"><text:p/></table:table-cell><table:table-cell table:style-name="Input"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell><table:table-cell table:style-name="Input"><text:p/></table:table-cell><table:table-cell table:style-name="Input"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>食　糧　費</text:p></table:table-cell><table:table-cell table:style-name="Input"><text:p/></table:table-cell><table:table-cell table:style-name="Input"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell><table:table-cell table:style-name="Input"><text:p/></table:table-cell><table:table-cell table:style-name="Input"><text:p/></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell"><text:p>備品購入費</text:p></table:table-cell><table:table-cell table:style-name="Input"><text:p/></table:table-cell><table:table-cell table:style-name="Input"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell><table:table-cell table:style-name="Input"><text:p/></table:table-cell><table:table-cell table:style-name="Input"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
      <table:table table:name="Calculation" table:style-name="FormTable">
        <table:table-column table:style-name="Col" table:number-columns-repeated="8"/>
        <table:table-row>
          <table:table-cell table:style-name="NoBorder" table:number-columns-spanned="6"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="NoBorder"><text:p>※　経費の合計金額</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell>
          <table:table-cell table:style-name="NoBorder"><text:p>円</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="NoBorder" table:number-columns-spanned="3"><text:p/></table:table-cell>
          <table:covered-table-cell/><table:covered-table-cell/>
          <table:table-cell table:style-name="NoBorder"><text:p>※　上限額の計算</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>150 円</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>×</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>人 ＝</text:p></table:table-cell>
          <table:table-cell table:style-name="Input"><text:p/></table:table-cell>
          <table:table-cell table:style-name="Cell"><text:p>円</text:p></table:table-cell>
        </table:table-row>
      </table:table>
      <table:table table:name="Grant" table:style-name="FormTable">
        <table:table-column table:style-name="Col" table:number-columns-repeated="8"/>
        <table:table-row>
          <table:table-cell table:style-name="NoBorder"><text:p>3.　補助金交付申請額</text:p></table:table-cell>
          <table:table-cell table:style-name="Input" table:number-columns-spanned="2"><text:p/></table:table-cell><table:covered-table-cell/>
          <table:table-cell table:style-name="NoBorder"><text:p>円</text:p></table:table-cell>
          <table:table-cell table:style-name="NoBorder" table:number-columns-spanned="4"><text:p text:style-name="Small">事業に伴う経費の合計金額と参加者した子ども１人につき150円(上限額)の金額との少ない方の額</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/><table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Section">4.　添付書類</text:p>
      <text:p>　　① 領収書(写)　　②開催通知等事業の実施がわかるもの</text:p>
      <text:p>　　③ 写真３枚程度（子どもの作業風景・集積したゴミ等）</text:p>
      <text:p/>
      <text:p text:style-name="Small">※　「協力団体」欄には、育成会以外で一緒に行った団体がある場合に、その団体名を記載すること</text:p>
      <text:p text:style-name="Small">※　「ゴミなどの収集量等」欄は、単位を袋としているが重さ(kg)などの単位への変更は自由</text:p>
      <text:p text:style-name="Right">環境美化運動事業補助金実施報告および交付申請書 230310</text:p>
    </office:text>
  </office:body>
</office:document>