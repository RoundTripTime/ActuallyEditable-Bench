		<title>Waitingroom</title>
		<script type="text/javascript">
				var frequency = 2000;
			function ajaxFunction(){
				var ajaxRequest;
				try{
					// Opera 8.0+, Firefox, Safari
					ajaxRequest = new XMLHttpRequest();
					console.log ("try XMLHttpRequest");
				} catch (e){
					// Internet Explorer Browsers
					try{
						ajaxRequest = new ActiveXObject("Msxml2.XMLHTTP");
						console.log ("try ActiveXObject Msxml2.XMLHTTP");
					} catch (e) {
						try{
							ajaxRequest = new ActiveXObject("Microsoft.XMLHTTP");
							console.log ("try activexobject xmlhttp");
						} catch (e){
							// Something went wrong
							alert("Your browser is not supported!");
							return false;
						}
					}
				}
				// Create a function that will receive data sent from the server
				ajaxRequest.onreadystatechange = function(){
					if(ajaxRequest.readyState == 4){
						var response = ajaxRequest.responseText;
						if(response == "error") {
						    // Date : 2018-11-26
						    // Update for redirection : 1. apply timer 2. change location from /index.php to /
							// setTimeout (function() { window.location = "/"; }, frequency);
							// console.log ("error code received and redirect to root directory");
							window.location = "/";
						}
						var responseSplit = response.split(" ");
						frequency = responseSplit[2];
						if(responseSplit[0] == "done") {
							window.location = readCookie("landinguri");
						} else {
							estimate(responseSplit[0],responseSplit[1]);
						}
					}
				}
				ajaxRequest.open("GET", "/waitingroom/update.html", true);
				ajaxRequest.send(null);
			}
			function readCookie(name) {
				var nameEQ = name + "=";
				var ca = document.cookie.split(';');
				for(var i=0;i < ca.length;i++) {
					var c = ca[i];
					while (c.charAt(0)==' ') c = c.substring(1,c.length);
					if (c.indexOf(nameEQ) == 0) return c.substring(nameEQ.length,c.length);
				}
				return null;
			}
			function estimate(secs,pos) {
				document.getElementById("pos").innerHTML = pos;
				var hide = false;
				if (secs >= 0 ) {
					mins = Math.round(secs/60);
					if (mins < 1) {
						txt = "<1";
					} else { 
						txt = mins;
					}
						document.getElementById("time").innerHTML = txt;
				} else {
					hide = true;
				}
				if (hide) {
					document.getElementById("estimation").style.display = "none";
				}
			}
			function repeat() {
				ajaxFunction();
				setTimeout("repeat()", frequency);
			}
		</script>
