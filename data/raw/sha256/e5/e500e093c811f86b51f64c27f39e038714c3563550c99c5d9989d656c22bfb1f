document.addEventListener('DOMContentLoaded', function() {
    var collapseButton = document.getElementById('collapsesections');

    var section1Header = document.querySelector(
        '#section-1 .course-section-header .d-flex.align-items-center.justify-content-between'
    );

    if (collapseButton && section1Header) {
        section1Header.appendChild(collapseButton);

        var collapseElements = document.querySelectorAll(
            '[id^="collapssesection"][data-number]:not([data-number="0"])'
        );

        var controls = Array.from(collapseElements)
            .map(function(element) {
                return element.getAttribute('id');
            })
            .join(' ');

        collapseButton.setAttribute('aria-controls', controls);

        collapseButton.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();

            var isExpanded =
                collapseButton.classList.contains('collapsed') === false;

            var targetElements = document.querySelectorAll(
                collapseButton
                    .getAttribute('aria-controls')
                    .split(' ')
                    .map(function(id) {
                        return '#' + id.replace(
                            'collapssesection',
                            'coursecontentcollapse'
                        );
                    })
                    .join(',')
            );

            targetElements.forEach(function(target) {
                var targetCollapse = new bootstrap.Collapse(target, {
                    toggle: false
                });

                if (isExpanded) {
                    targetCollapse.hide();
                } else {
                    targetCollapse.show();
                }
            });

            var section0Collapse =
                document.getElementById('coursecontentcollapse0');

            if (section0Collapse) {
                section0Collapse.style.display = 'block';
            }

            collapseButton.classList.toggle('collapsed');
            collapseButton.setAttribute(
                'aria-expanded',
                !isExpanded
            );
        });
    }
});
